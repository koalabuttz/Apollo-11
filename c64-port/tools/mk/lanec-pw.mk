# SPDX-License-Identifier: MIT
# Milestone lanec-pw (lane C): the earlier Pinball modules through the Lane C
# harness (tests/lanec_pw.h), for the Pinball full-file certificates. Each
# tools/mk/lanec-pw-*.mk adds its sources to LANEC_SUITE_SRC and its suites
# to LANEC_PW_SUITES.
LANEC_SUITE_SRC += tests/lanec_pw.c tests/lanec_pw_blanksub_cases.c src/agc_multiword.c src/dsky_pinball.c \
  src/dsky_blank.c src/dsky_blanksub.c tests/p66_bias_cases.c tests/dsky_blanksub_cases.c
LANEC_SUITE_SRC += src/lanec_pw_runs.c src/lanec_pw_a_runs.c src/lanec_pw_b_runs.c src/lanec_pw_c_runs.c \
  src/lanec_pw_e_runs.c src/lanec_pw_f_runs.c src/lanec_pw_g_runs.c
LANEC_SUITE_HDR += tests/lanec_pw.h include/lanec_pw_runs.h include/lanec_pw_run.h include/lanec_pw_a_run.h \
  include/lanec_pw_b_run.h include/lanec_pw_c_run.h include/lanec_pw_e_run.h include/lanec_pw_f_run.h include/lanec_pw_g_run.h
LANEC_PW_SUITES += pw-blanksub
# Each suite's native and oracle runs, in parts of consecutive suites
# (tools/mk/_ci-split.mk); test-lanec-pw and sanitize-lanec-pw run them all.
LANEC_PW_TEST_PART = for s in $(call ci_split_part,$(LANEC_PW_SUITES),$(2),$(1)); do \
  python3 tools/lanec/diff.py $$s --refusals || exit 1; done
LANEC_PW_SANITIZE_PART = for s in $(call ci_split_part,$(LANEC_PW_SUITES),$(2),$(1)); do ASAN_OPTIONS=detect_leaks=0 \
  python3 tools/lanec/diff.py $$s --refusals --native build/lanec-native-sanitize || exit 1; done
$(eval $(call CI_HOST_SPLIT_RULE,test-lanec-pw,5,build/lanec-native build/lanec-oracle tools/lanec/diff.py \
  tools/mk/lanec-pw.mk,LANEC_PW_TEST_PART))
$(eval $(call CI_HOST_SPLIT_RULE,sanitize-lanec-pw,4,build/lanec-native-sanitize build/lanec-oracle tools/lanec/diff.py \
  tools/mk/lanec-pw.mk,LANEC_PW_SANITIZE_PART))
# Every pw-* suite on the C64. One program per
# suite runs its frozen rows (tests/lanec_pw_<suite>_c64.h, picked by
# tools/lanec/cover.py so that together they take every branch arc the host
# cases take) through the module and compares each result with the oracle's.
# All programs link the same sources; LTO keeps the one suite's module.
LANEC_PW_C64_SRC = src/agc_word.c src/lanec.c tests/lanec_case.c tests/lanec_pw.c src/lanec_pw_runs.c \
  src/lanec_pw_a_runs.c src/lanec_pw_b_runs.c src/lanec_pw_c_runs.c src/lanec_pw_e_runs.c src/lanec_pw_f_runs.c \
  src/lanec_pw_g_runs.c tools/lanec/c64_diag.c \
  $(sort $(filter src/dsky_% src/cm_% src/agc_% src/fixed_% src/noun_% src/guidance_% src/executive% src/lm_basic_% \
  src/p66_% src/lanec_pin_gaps% src/lm_admission% src/lm_interbank.c src/lm_waitlist% src/lm_fixed% src/lm_pinball% src/gimbal% \
  src/matrix% src/waitlist% tests/dsky_% tests/p66_% tests/cm_%_cases.c tests/lm_busy_cases.c tests/matrix_cases.c \
  tests/throttle_bridge_cases.c tests/lanec_p66_dispatch.c,$(LANEC_SUITE_SRC)))
# These modules do not fit one program with the harness. fixed-display runs
# on the C64 through the Pinball flight modules loaded from the REU store
# (vice-lanec-pin-flight, tools/mk/lanec-pin-heads.mk); the others no longer
# run in the program (routines.py pin `dropped`, docs/LANEC-PIN-HEADS.md):
# their suites stay as host tests and are not in the Pinball certificates.
LANEC_PW_C64_TOO_BIG = pw-cm-dynamic-display pw-cm-normal-display pw-cm-nv85 pw-decimal-time-consumer pw-fixed-display \
  pw-lamp-lifecycle pw-monitor-consumer
LANEC_PW_PRGS = $(foreach s,$(filter-out $(LANEC_PW_C64_TOO_BIG),$(LANEC_PW_SUITES)),build/lanec-$(s).prg)
define LANEC_PW_C64_RULE
build/lanec-$(1).prg: $$(LANEC_PW_C64_SRC) tests/lanec_$(subst -,_,$(1))_cases.c tests/lanec_$(subst -,_,$(1))_c64.h $$(LANEC_HDR) | build
	$$(MOS_CC) -std=c99 -Os -fno-static-stack -mlto-zp=0 -Wall -Wextra -Werror -Iinclude -Itests \
	  -DLANEC_SUITE=lanec_suite_$(subst -,_,$(1)) -DLANEC_FROZEN='"lanec_$(subst -,_,$(1))_c64.h"' \
	  $$(LANEC_PW_C64_SRC) tests/lanec_$(subst -,_,$(1))_cases.c -Wl,-Map,$$@.map -o $$@
	python3 -c "import re,sys;m=open('$$@.map').read();e=max(int(x,16) for x in re.findall(r'^\s*([0-9a-f]+)\s+[0-9a-f]+\s+[0-9a-f]+\s+\d+\s+__heap_start',m,re.M));sys.exit(0 if e<=0xc000 else '$$@: code and BSS reach the mailbox page: '+hex(e))" || { rm -f $$@; exit 1; }
endef
$(foreach s,$(filter-out $(LANEC_PW_C64_TOO_BIG),$(LANEC_PW_SUITES)),$(eval $(call LANEC_PW_C64_RULE,$(s))))
.PHONY: c64-lanec-pw vice-lanec-pw
c64-lanec-pw: $(LANEC_PW_PRGS)
vice-lanec-pw: $(LANEC_PW_PRGS)
	python3 tools/lanec/vice_many.py lanec-pw $(LANEC_PW_PRGS)
# The Pinball round trips on the C64 (milestone lanec-pin-transfer). Every
# module does not fit one program, so one program per module and mission
# that has frozen rows of pin-transfer-c64 (tests/lanec_pin_transfer_c64_rows.h,
# generated by tools/lanec/routines.py pin; <suite>_lm, <suite>_cm) registers
# that mission's INTER-BANK and the module's points and runs those rows.
LANEC_PIN_C64_SRC = $(LANEC_PW_C64_SRC) src/lanec_pin_routines.c src/lanec_pin_trampoline.c src/agc_transfer.c src/lm_interbank_routines.c src/lm_interbank_idle.c \
  src/lm_interbank.c src/cm_interbank_routines.c src/cm_interbank_idle.c src/cm_interbank_complete.c tests/lanec_pin_transfer_cases.c
# These modules' programs do not build or fit below the mailbox page with
# INTER-BANK and the harness: the head families (their cases chain through
# every Pinball routine), the keypress modules and eleven modules over $C000;
# and the fixed display, whose rows read the rope (DSPFMEM), which a
# program without the REU store does not carry.
# Their rows do not run (tools/lanec/cover.py record --not-run); their
# modules run on the C64 in their own pw-* programs and through the flight
# store (vice-lanec-pin-flight, module-test-lanec-pin-keys), and the record
# pools those programs' arcs (--pool, evidence/lanec-pin-cert/lanec-pin-c64-cover.json).
LANEC_PIN_C64_TOO_BIG = $(foreach h,decount_lm dpout_cm lamp_cm lamp_lm load_cm load_lm minsec_lm nvsub_cm nvsub_lm \
  proceed_cm proceed_lm release_cm release_lm request_cm request_lm twoint_lm,pin_head_$(h)) pin_key_labels_cm pin_key_labels_lm pin_keys_cm \
  pin_keys_lm pw_address_request_cm pw_address_request_lm pw_fixed_display_cm pw_fixed_display_lm \
  pw_hours_output_cm pw_hours_output_lm pw_jam_control_cm \
  pw_jam_control_lm pw_lamp_release_lm pw_operator_release_cm pw_operator_release_lm pw_operator_response_cm \
  pw_operator_response_lm pw_response_recall_cm pw_response_recall_lm
LANEC_PIN_C64_MODULES := $(filter-out $(LANEC_PIN_C64_TOO_BIG),$(shell sed -n 's/^\#ifdef LANEC_PIN_C64_MOD_//p' \
  tests/lanec_pin_transfer_c64_rows.h 2>/dev/null))
LANEC_PIN_C64_PRGS = $(foreach m,$(LANEC_PIN_C64_MODULES),build/lanec-pin-transfer-$(m).prg)
define LANEC_PIN_C64_RULE
build/lanec-pin-transfer-$(1).prg: $$(sort $$(LANEC_PIN_C64_SRC) tests/lanec_$(2)_cases.c) tests/lanec_pin_transfer_cases.inc \
  src/lanec_pin_routines.inc tests/lanec_pin_transfer_c64_rows.h $$(LANEC_HDR) | build
	$$(MOS_CC) -std=c99 -Os -fno-inline -mlto-zp=0 -Wall -Wextra -Werror -Iinclude -Itests -DLANEC_PIN_C64 \
	  -DLANEC_PIN_TRANSFER_C64 -DLANEC_PIN_C64_MOD_$(1) $(if $(filter %_cm,$(1)),-DLANEC_PIN_C64_CM) \
	  -DLANEC_PIN_C64_SUITE=lanec_suite_$(2) -DLANEC_PIN_C64_RUN=$(if $(filter pin_gaps,$(2)),lanec_pin_gaps_dispatch,lanec_$(2)_run) \
	  -DLANEC_SUITE=lanec_suite_pin_transfer_c64 -DLANEC_FROZEN='"lanec_pin_transfer_c64_rows.h"' \
	  -DLANEC_C64_SKIP=lanec_pin_c64_skip $$(sort $$(LANEC_PIN_C64_SRC) tests/lanec_$(2)_cases.c) -Wl,-Map,$$@.map -o $$@
	python3 -c "import re,sys;m=open('$$@.map').read();e=max(int(x,16) for x in re.findall(r'^\s*([0-9a-f]+)\s+[0-9a-f]+\s+[0-9a-f]+\s+\d+\s+__heap_start',m,re.M));sys.exit(0 if e<=0xc000 else '$$@: code and BSS reach the mailbox page: '+hex(e))" || { rm -f $$@; exit 1; }
endef
$(foreach m,$(LANEC_PIN_C64_MODULES),$(eval $(call LANEC_PIN_C64_RULE,$(m),$(patsubst %_lm,%,$(patsubst %_cm,%,$(m))))))
.PHONY: c64-lanec-pin-transfer vice-lanec-pin-transfer
c64-lanec-pin-transfer: $(LANEC_PIN_C64_PRGS)
vice-lanec-pin-transfer: $(LANEC_PIN_C64_PRGS)
	python3 tools/lanec/vice_many.py lanec-pin-transfer $(LANEC_PIN_C64_PRGS)

007427,001089:                                                                                          	# PROGRAM NAME_  RRAUTCHK
007428,001090: 
007429,001091:                                                                                          	# FUNCTIONAL DESCRIPTION_
007430,001092:                                                                                          	# RRAUTCHK IS THE RENDEZVOUS RADAR INBIT MONITOR.  INITIALLY THE RR
007431,001093:                                                                                          	# POWER ON AUTO (CHAN 33 BIT 2) INBIT IS CHECKED.  IF NO CHANGE, THE
007432,001094:                                                                                          	# PROGRAM EXITS TO RRCDUCHK.  IF A CHANGE, RADMODES IS UPDATED
007433,001095:                                                                                          	# AND A CHECK MADE IF RR POWER HAS JUST COME ON.  IF JUST OFF, A CHECK
007434,001096:                                                                                          	# IS MADE TO SEE IF A PROGRAM WAS USING THE RR (STATE BIT 7).  IF NO,
007435,001097:                                                                                          	# THE PROGRAM EXITS TO RRCDUCHK.  IF YES, PROGRAM ALARM 00514
007436,001098:                                                                                          	# IS REQUESTED BEFORE EXITING TO RRCDUCHK.  IF RR POWER HAS JUST COME
007437,001099:                                                                                          	# ON, A CHECK IS MADE TO SEE IF A PROGRAM WAS USING THE RR (STATE BIT 7).
007438,001100:                                                                                          	# IF YES, THE PROGRAM EXITS TO RRCDUCHK WITHOUT REQUESTING THE TURN-ON
007439,001101:                                                                                          	# SEQUENCE.  IF NO, RADMODES IS UPDATED TO INDICATE RR CDU ZERO AND
007440,001102:                                                                                          	# RR TURN-ON SEQUENCE (BITS 13, 1).  A 10 MILLISECOND WAITLIST CALL
007441,001103:                                                                                          	# IS THEN SET FOR RRTURNON BEFORE THE PROGRAM EXITS TO NORRGMON.
007442,001104: 

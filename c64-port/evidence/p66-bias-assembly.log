058901,000047: 10,3553           16737                           TCF      Q+1                           	#
058902,000048: 
058903,000049: 10,3554           00004        DOWNENT2           INHINT                                 	#
058904,000050: 10,3555           75660                           MASK     OCT77770                      	#
058905,000051: 10,3556           40000                           COM                                    	#
058906,000052: 10,3557           70100                           MASK     FLAGWRD4                      	#
058907,000053: 10,3560           54100                           TS       FLAGWRD4                      	#
058908,000054: 10,3561           13552                           TCF      JOIN                          	#
058909,000055: 
058910,000056: 10,3562     4757               OCT7               EQUALS   SEVEN                         	#
058911,000057: 
058913,000059:                                                                                          	# UPFLAG AND DOWNFLAG ARE ENTIRELY GENERAL FLAG SETTING AND CLEARING SUBROUTINES.  USING THEM, WHETHER OR
058914,000060:                                                                                          	# NOT IN INTERRUPT, ONE MAY SET OR CLEAR ANY SINGLE, NAMED BIT IN ANY ERASABLE REGISTER, SUBJECT OF COURSE TO
058915,000061:                                                                                          	# EBANK SETTING.  A "NAMED" BIT, AS THE WORD IS USED HERE, IS ANY BIT WITH A NAME FORMALLY ASSIGNED BY THE YUL
058916,000062:                                                                                          	# ASSEMBLER.
058917,000063: 
058918,000064:                                                                                          	# AT PRESENT THE ONLY NAMED BITS ARE THOSE IN THE FLAGWORDS.  ASSEMBLER CHANGES WILL MAKE IT POSSIBLE TO
058919,000065:                                                                                          	# NAME ANY BIT IN ERASABLE MEMORY.
058920,000066: 
058921,000067:                                                                                          	# CALLING SEQUENCES ARE AS FOLLOWS :-
058922,000068:                                                                                          	#               TC      UPFLAG                  TC      DOWNFLAG
058923,000069:                                                                                          	#               ADRES   NAME OF FLAG            ADRES   NAME OF FLAG
058924,000070: 
058925,000071:                                                                                          	# RETURN IS TO THE LOCATION FOLLOWING THE "ADRES" ABOUT .58 MS AFTER THE "TC".
058926,000072:                                                                                          	# UPON RETURN A CONTAINS THE CURRENT FLAGWRD SETTING.
058927,000073: 
058928,000074:    5504                                           BLOCK    02                            	#
058929,000075:    4000                                           SETLOC   FFTAG1                        	#
058930,000076:    4000                                           BANK                                   	#
058931,000077:    5504                                           COUNT*   $$/FLAG                       	#
058932,000078: 
058933,000079:    5504           30002        UPFLAG             CA       Q                             	#
058934,000080:    5505           05522                           TC       DEBIT                         	#
058935,000081:    5506           40000                           COM                                    	# +(15 - BIT)
058936,000082:    5507           00006                           EXTEND                                 	#
058937,000083:    5510           04001                           ROR      LCHAN                         	# SET BIT
058938,000084:    5511           50061        COMFLAG            INDEX    ITEMP1                        	#
058939,000085:    5512           54074                           TS       FLAGWRD0                      	#
058940,000086:    5513           22063                           LXCH     ITEMP3                        	#
058941,000087:    5514           00003                           RELINT                                 	#
058942,000088:    5515           00001                           TC       L                             	#
058943,000089: 
058944,000090:    5516           30002        DOWNFLAG           CA       Q                             	#
058945,000091:    5517           05522                           TC       DEBIT                         	#
058946,000092:    5520           70001                           MASK     L                             	# RESET BIT
058947,000093:    5521           15511                           TCF      COMFLAG                       	#
058948,000094: 
058949,000095:    5522           64753        DEBIT              AD       ONE                           	# GET DE BITS
058950,000096:    5523           00004                           INHINT                                 	#
058951,000097:    5524           54063                           TS       ITEMP3                        	#
058952,000098:    5525           34762                           CA       LOW4                          	# DEC15
058953,000099:    5526           54061                           TS       ITEMP1                        	#
058954,000100:    5527           50063                           INDEX    ITEMP3                        	#
058955,000101:    5530           27777                           CA       0          -1                 	# ADRES
058956,000102:    5531           54001                           TS       L                             	#
058957,000103:    5532           34755                           CA       ZERO                          	#
058959,000105:    5533           00006                           EXTEND                                 	#
058960,000106:    5534           10061                           DV       ITEMP1                        	# A = FLAGWRD, L = (15 - BIT)
058961,000107:    5535           52062                           DXCH     ITEMP1                        	#
058962,000108:    5536           50061                           INDEX    ITEMP1                        	#
058963,000109:    5537           30074                           CA       FLAGWRD0                      	#
058964,000110:    5540           54001                           TS       L                             	# CURRENT STATE
058965,000111:    5541           50062                           INDEX    ITEMP2                        	#
058966,000112:    5542           44735                           CS       BIT15                         	# -(15 - BIT)
058967,000113:    5543           00002                           TC       Q                             	#
058968,000114: 
058970,000116:                                                                                          	# DELAYJOB - A GENERAL ROUTINE TO DELAY A JOB A SPECIFIC AMOUNT OF TIME BEFORE PICKING UP AGAIN.
058971,000117: 
058972,000118:                                                                                          	# ENTRANCE REQUIREMENTS ...
058973,000119:                                                                                          	#               CAF     DT              DELAY JOB FOR DT CENTISECS
058974,000120:                                                                                          	#               TC      BANKCALL
058975,000121:                                                                                          	#               CADR    DELAYJOB
058976,000122: 
058977,000123: 06,3764                                           BANK     06                            	#
058978,000124: 00,2000                                           SETLOC   DLAYJOB                       	#
058979,000125: 00,2000                                           BANK                                   	#
058980,000126: 
058981,000127:                                                                                          	# THIS MUST REMAIN IN BANK 0 *****************************************
058982,000128: 
058983,000129: 00,3735                                           COUNT*   $$/DELAY                      	#
058984,000130: 00,3735           00004        DELAYJOB           INHINT                                 	#
058985,000131: 00,3736           54002                           TS       Q                             	# STORE DELAY DT IN Q FOR DLY -1 IN
058986,000132: 00,3737           34752                           CAF      DELAYNUM                      	# WAITLIST
058987,000133: 00,3740           54070        DELLOOP            TS       RUPTREG1                      	#
058988,000134: 00,3741           50000                           INDEX    A                             	#
058989,000135: 00,3742           31326                           CA       DELAYLOC                      	# IS THIS DELAYLOC AVAILABLE
058990,000136: 00,3743           00006                           EXTEND                                 	#
058991,000137: 00,3744           13752                           BZF      OK2DELAY                      	# YES
058992,000138: 
058993,000139: 00,3745           10070                           CCS      RUPTREG1                      	# NO, TRY NEXT DELAYLOC
058994,000140: 00,3746           13740                           TCF      DELLOOP                       	#
058995,000141: 
058996,000142: 00,3747           52134                           DXCH     BUF2                          	#
058997,000143: 00,3750           05716                           TC       BAILOUT1                      	# NO AVAILABLE LOCS.
058998,000144: 00,3751           01104                           OCT      1104                          	#
058999,000145: 
059000,000146: 00,3752           33772        OK2DELAY           CA       TCSLEEP                       	# SET WAITLIST IMMEDIATE RETURN
059001,000147: 00,3753           54061                           TS       WAITEXIT                      	#
059002,000148: 
059003,000149: 00,3754           30004                           CA       FBANK                         	#
059004,000150: 00,3755           60070                           AD       RUPTREG1                      	# STORE BBANK FOR TASK CALL
059005,000151: 00,3756           54001                           TS       L                             	#
059006,000152: 
059007,000153: 00,3757           33773                           CAF      WAKECAD                       	# STORE CADR FOR TASK CALL
059008,000154: 00,3760           15211                           TCF      DLY2       -1                 	# DLY IS IN WAITLIST ROUTINE
059009,000155: 
059010,000156: 00,3761           04645        TCGETCAD           TC       MAKECADR                      	# GET CALLERS FCADR
059011,000157: 
059012,000158: 00,3762           50070                           INDEX    RUPTREG1                      	#
059013,000159: 00,3763           55326                           TS       DELAYLOC                      	# SAVE DELAY CADRS
059014,000160: 
059015,000161: 00,3764           05133                           TC       JOBSLEEP                      	#
059016,000162: 
059017,000163: 00,3765           34755        WAKER              CAF      ZERO                          	#
059018,000164: 00,3766           50006                           INDEX    BBANK                         	#
059019,000165: 00,3767           57326                           XCH      DELAYLOC                      	# MAKE DELAYLOC AVAILABLE
059021,000167: 00,3770           05137                           TC       JOBWAKE                       	#
059022,000168: 
059023,000169: 00,3771           05261                           TC       TASKOVER                      	#
059024,000170: 
059025,000171: 00,3772           03757        TCSLEEP            GENADR   TCGETCAD   -2                 	#
059026,000172: 00,3773           03765        WAKECAD            GENADR   WAKER                         	#
059027,000173: 
059029,000175:                                                                                          	# GENTRAN, A BLOCK TRANSFER ROUTINE.
059030,000176:                                                                                          	# WRITTEN BY D. EYLES
059031,000177:                                                                                          	# MOD 1 BY KERNAN                               UTILITYM REV 17 11/18/67
059032,000178:                                                                                          	# MOD 2 BY SCHULENBERG (REMOVE RELINT) SKIPPER REV 4 2/28/68
059033,000179: 
059034,000180:                                                                                          	# THIS ROUTINE IS USEFULL FOR TRANSFERING N CONSECUTIVE ERASABLE OR FIXED QUANTITIES TO SOME OTHER N
059035,000181:                                                                                          	# CONSECUTIVE ERASABLE LOCATIONS.  IF BOTH BLOCKS OF DATA ARE IN SWITCHABLE EBANKS, THEY MUST BE IN THE SAME ONE.
059036,000182: 
059037,000183:                                                                                          	# GENTRAN IS CALLABLE IN A JOB AS WELL AS A RUPT.  THE CALLING SEQUENCE IS:
059038,000184:                                                                                          	#       I       CA      N-1             # OF QUANTITIES MINUS ONE.
059039,000185:                                                                                          	#       I +1    TC      GENTRAN         IN FIXED-FIXED.
059040,000186:                                                                                          	#       I +2    ADRES   L               STARTING ADRES OF DATA TO BE MOVED.
059041,000187:                                                                                          	#       I +3    ADRES   M               STARTING ADRES OF DUPLICATION BLOCK.
059042,000188:                                                                                          	#       I +4                            RETURNS HERE.
059043,000189: 
059044,000190:                                                                                          	# GENTRAN TAKES 25 MCT'S (300 MICROSECONDS) PER ITEM + 5 MCT'S (60 MICS) FOR ENTERING AND EXITING.
059045,000191:                                                                                          	# A, L AND ITEMP1 ARE NOT PRESERVED.
059046,000192: 
059047,000193:    5544                                           BLOCK    02                            	#
059048,000194:    4000                                           SETLOC   FFTAG4                        	#
059049,000195:    4000                                           BANK                                   	#
059050,000196: 
059051,000197:    5544     0061                                  EBANK=   ITEMP1                        	#
059052,000198: 
059053,000199:    5544                                           COUNT*   $$/TRAN                       	#
059054,000200: 
059055,000201:    5544           00004        GENTRAN            INHINT                                 	#
059056,000202:    5545           54061                           TS       ITEMP1                        	# SAVE N-1.
059057,000203:    5546           50002                           INDEX    Q                             	# C(Q) = ADRES L.
059058,000204:    5547           60000                           AD       0                             	# ADRES (L + N - 1).
059059,000205:    5550           50000                           INDEX    A                             	#
059060,000206:    5551           30000                           CA       0                             	# C(ABOVE).
059061,000207:    5552           54001                           TS       L                             	# SAVE DATA.
059062,000208:    5553           30061                           CA       ITEMP1                        	#
059063,000209:    5554           50002                           INDEX    Q                             	#
059064,000210:    5555           60001                           AD       1                             	# ADRES (M + N - 1).
059065,000211:    5556           50000                           INDEX    A                             	#
059066,000212:    5557           22000                           LXCH     0                             	# STUFF IT.
059067,000213:    5560           10061                           CCS      ITEMP1                        	# LOOP UNTIL N-1 = 0.
059068,000214:    5561           15545                           TCF      GENTRAN    +1                 	#
059069,000215:    5562           16741                           TCF      Q+2                           	# RETURN TO CALLER.
059070,000216: 
059072,000218:                                                                                          	# B5OFF         ZERO BIT 5 OF EXTVBACT, WHICH IS SET BY TESTXACT.
059073,000219:                                                                                          	# MAY BE USED AS NEEDED BY ANY EXTENDED VERB WHICH HAS DONE TESTXACT
059074,000220: 
059075,000221:    5563                                           COUNT*   $$/EXTVB                      	#
059076,000222: 
059077,000223:    5563           44747        B5OFF              CS       BIT5                          	#
059078,000224:    5564           71044                           MASK     EXTVBACT                      	#
059079,000225:    5565           55044                           TS       EXTVBACT                      	#
059080,000226:    5566           05155                           TC       ENDOFJOB                      	#
059081,000227: 
059082,000228: 
059083,000229: 
(End of include-file SERVICE_ROUTINES.agc, resuming MAIN.agc)

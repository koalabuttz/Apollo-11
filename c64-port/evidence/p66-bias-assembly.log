019615,003136: 
019616,003137:                                                                                          	# LOADSTAT      +0      INACTIVE (WAITING FOR DATA). SET BY NVSUB
019617,003138:                                                                                          	#               +1      PROCEED NO DATA. SET BY SPECIAL VERB
019618,003139:                                                                                          	#               -1      TERMINATE  SET BY SPECIAL VERB
019619,003140:                                                                                          	#               -0              DATA IN         SET BY END OF LOAD ROUTINE
019620,003141:                                                                                          	#                       OR      RESEQUENCE      SET BY VERB 32
019621,003142: 
019622,003143:                                                                                          	# L TC ENDIDLE (FIXED FIXED)
019623,003144:                                                                                          	# ROUTINES THAT REQUEST LOADS THROUGH NVSUB SHOULD USE ENDIDLE WHILE
019624,003145:                                                                                          	# WAITING FOR THE DATA TO BE LOADED. ENDIDLE PUTS CURRENT JOB TO SLEEP.
019625,003146:                                                                                          	# ENDIDLE CANNOT BE CALLED FROM ERASABLE OR F/F MEMORY,
019626,003147:                                                                                          	# SINCE JOB SLEEP AND JOBWAKE CAN HANDLE ONLY FIXED BANKS.
019627,003148:                                                                                          	# RECALTST TESTS LOADSTAT AND WAKES JOB UP TO,
019628,003149:                                                                                          	#       L+1     FOR TERMINATE
019629,003150:                                                                                          	#       L+2     FOR PROCEED WITHOUT DATA
019630,003151:                                                                                          	#       L+3     FOR DATA IN, OR RESEQUENCE
019631,003152:                                                                                          	# IT DOES NOTHING IF LOADSTAT INDICATES WAITING FOR DATA.
019632,003153: 
019633,003154:                                                                                          	# ENDIDLE ABORTS (WITH CODE 01206) IF A SECOND JOB ATTEMPTS TO GO TO SLEEP
019635,003156:                                                                                          	# IN PINBALL. IN PARTICULAR, IF AN ATTEMPT IS MADE TO GO TO ENDIDLE WHEN
019636,003157:                                                                                          	# 1)    CADRSTOR NOT= +0. THIS IS THE CASE WHERE THE CAPACITY OF ENDIDLE IS
019637,003158:                                                                                          	#       EXCEEDED. (+-NZ INDICATE A JOB IS ALREADY ASLEEP DUE TO ENDIDLE.)
019638,003159:                                                                                          	# 2)    DSPLIST NOT= +0. THIS INDICATES A JOB IS ALREADY ASLEEP DUE TO
019639,003160:                                                                                          	#       NVSUBUSY.
019640,003161: 

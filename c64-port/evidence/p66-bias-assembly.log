033471,000873:                                                                                          	# SUBROUTINE S40.8
033472,000874:                                                                                          	# MODIFIED APRIL 3, 1968 BY PETER ADLER   MIT/IL
033473,000875: 
033474,000876:                                                                                          	# DESCRIPTION
033475,000877:                                                                                          	#       S40.8 UPDATES THE VELOCITY-TO-BE-GAINED VECTOR, VG, (AND FOR LAMBERT TARGETTED BURNS ALSO EXTRAPOLATES VG
033476,000878:                                                                                          	#       USING THE BDT VECTOR) COMPUTES THE TIME FOR ISSUING THE ENGINE OFF COMMAND, TGO, AND CALLS THE ROUTINE
033477,000879:                                                                                          	#       "FINDCDUW", WHICH GENERATES STEERING COMMANDS FOR THE DAP.
033478,000880: 
033479,000881:                                                                                          	# CALLING SEQUENCE
033480,000882:                                                                                          	#       L-1     CALL
033481,000883:                                                                                          	#       L               S40.8
033482,000884:                                                                                          	#       L+1                     INTERPRETIVE RETURN
033483,000885: 
033484,000886:                                                                                          	# ALARM
033485,000887:                                                                                          	#       IF VG . DELVREF IS NEGATIVE (VG AND DELVREF OVER 90 DEGREES APART), BYPASS TGO AND STEERING COMPUTATIONS
033486,000888:                                                                                          	#       AND SET ALARM 1407.  RETURN TO CALLER NORMALLY.
033487,000889: 
033488,000890:                                                                                          	# INPUT AND INITIALIZATION
033489,000891:                                                                                          	#       VGPREV          REFERENCE       2(7) M/CS
033490,000892:                                                                                          	#       DELVREF         REFERENCE       2(7) M/CS
033491,000893:                                                                                          	#       BDT             REFERENCE       2(7) M/CS
033492,000894:                                                                                          	#       TDECAY          TAIL-OFF TIME   2(28) CS
033493,000895:                                                                                          	#       XDELVFLG        1 = EXTERNAL DELTA-V; 0 = LAMBERT (AIMPOINT)
033494,000896:                                                                                          	#       STEERSW         1 = DO STEERING AND TGO COMPUTATIONS; 0 = VG UPDATE ONLY
033495,000897:                                                                                          	#       FIRSTFLG        1 = GONE TO LAMBERT AT LEAST ONCE; 0 = HAVEN'T GONE TO LAMBERT YET
033496,000898: 
033497,000899:                                                                                          	# NOTE:  VGTIG EQUALS VGPREV
033498,000900: 
033499,000901:                                                                                          	# OUTPUT
033500,000902:                                                                                          	#       STEERSW         SEE INPUT
033501,000903:                                                                                          	#       IMPULSW         1 = ENGINE OFF IN TGO CENTISECONDS; 0 = CONTINUE BURN
033502,000904:                                                                                          	#       TGO             TIME TO CUT-OFF 2(28) CS
033503,000905:                                                                                          	#       SEE FINDCDUW FOR STEERING OUTPUTS.
033504,000906: 

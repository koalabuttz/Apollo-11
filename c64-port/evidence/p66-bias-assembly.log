053793,000034:                                                                                          	##
053794,000035:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
053795,000036:                                                                                          	##      16:27 JULY 14, 1969 
053796,000037: 
053798,000039: 14,3774                                           BANK     14                            	# SAME FBANK AS THE FINDCDUD SUB-PROGRAM

034936,000282:                                                                                          	#                       ____               ____   ____                   __
034937,000283:                                                                                          	#                       LAND = /LAND/ UNIT(LAND - LAND(TPIP - TPIPOLD) * WM)
034938,000284:                                                                                          	#               SLANT RANGE TO LANDING SITE, FOR DISPLAY:
034939,000285:                                                                                          	#                                        ____   _
034940,000286:                                                                                          	#                       RANGEDSP = ABVAL(LAND - R)

018795,002316: 
018797,002318:                                                                                          	# MONITOR ALLOWS OTHER KEYBOARD ACTIVITY. IT IS ENDED BY VERB TERMINATE,
018798,002319:                                                                                          	# VERB PROCEED WITHOUT DATA, VERB RESEQUENCE,
018799,002320:                                                                                          	# ANOTHER MONITOR, OR ANY NVSUB CALL THAT PASSES THE DSPLOCK (PROVIDED
018800,002321:                                                                                          	# THAT THE OPERATOR HAS SOMEHOW ALLOWED THE ENDING OF A MONITOR WHICH
018801,002322:                                                                                          	# HE HAS INITIATED THROUGH THE KEYBOARD).
018802,002323: 
018803,002324:                                                                                          	# MONITOR ACTION IS SUSPENDED, BUT NOT ENDED, BY ANY KEYBOARD ACTION,
018804,002325:                                                                                          	# EXCEPT ERROR LIGHT RESET. IT BEGINS AGAIN WHEN KEY RELEASE IS PERFORMED.
018805,002326:                                                                                          	# MONITOR SAVES THE NOUN AND APPROPRIATE DISPLAY VERB IN MONSAVE. IT SAVES
018806,002327:                                                                                          	# NOUNCADR IN MONSAVE1, IF NOUN = MACHINE CADR TO BE SPECIFIED. BIT 15 OF
018807,002328:                                                                                          	# MONSAVE1 IS THE KILL MONITOR SIGNAL (KILLER BIT). BIT 14 OF MONSAVE1
018808,002329:                                                                                          	# INDICATES THE CURRENT MONITOR WAS EXTERNALLY INITIATED (EXTERNAL
018809,002330:                                                                                          	# MONITOR BIT). IT IS TURNED OFF BY RELDSP AND KILMONON.
018810,002331: 
018811,002332:                                                                                          	# MONSAVE INDICATES IF MONITOR IS ON (+=ON, +0=OFF)
018812,002333:                                                                                          	# IF MONSAVE IS +, MONITOR ENTERS NO REQUEST, BUT TURNS KILLER BIT OFF.
018813,002334:                                                                                          	# IF MONSAVE IS +0, MONITOR ENTERS REQUEST AND TURNS KILLER BIT OFF.
018814,002335: 
018815,002336:                                                                                          	# NVSUB (IF EXTERNAL MONITOR BIT IS OFF), VB=PROCEED WITHOUT DATA,
018816,002337:                                                                                          	# VB=RESEQUENCE, AND VB=TERMINATE TURN KILL MONITOR BIT ON.
018817,002338: 
018818,002339:                                                                                          	# IF KILLER BIT IS ON, MONREQ ENTERS NO FURTHER REQUESTS, ZEROS MONSAVE
018819,002340:                                                                                          	# AND MONSAVE1 (TURNING OFF KILLER BIT AND EXTERNAL MONITOR BIT).

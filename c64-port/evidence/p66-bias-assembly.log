040943,000448:                                                                                          	# PROGRAM NAME - R56            DATE  DEC 20 66
040944,000449:                                                                                          	# MOD 1                         LOG SECTION P51-P53
040945,000450:                                                                                          	#                               ASSEMBLY   SUNDISK REV40
040946,000451:                                                                                          	# BY KEN VINCENT
040947,000452: 
040948,000453:                                                                                          	# FUNCTION
040949,000454:                                                                                          	#       THIS PROGRAM READ THE IMU-CDUS AND COMPUTES THE VEHICLE ORIENTATION
040950,000455:                                                                                          	#       WITH RESPECT TO INERTIAL SPACE.  IT THEN COMPUTES THE SHAFT AXIS (SAX)
040951,000456:                                                                                          	#       WITH RESPECT TO REFERENCE INERTIAL.  EACH STAR IN THE CATALOG IS TESTED
040952,000457:                                                                                          	#       TO DETERMINE IF IT IS OCCULTED BY EITHER THE EARTH, SUN OR MOON.  IF A
040953,000458:                                                                                          	#       STAR IS NOT OCCULTED THEN IT IS PAIRED WITH ALL STAR OF LOWER INDEX.
040954,000459:                                                                                          	#       THE PAIRED STAR IS TESTED FOR OCCULTATION.  PAIRS OF STARS THAT PASS
040955,000460:                                                                                          	#       THE OCCULTATION TESTS ARE TESTED FOR GOOD SEPARATION.  A PAIR OF STARS
040956,000461:                                                                                          	#       HAVE GOOD SEPERATION IF THE ANGLE BETWEEN THEM IS LESS THAN 100 DEGREES
040957,000462:                                                                                          	#       AND MORE THAN 50 DEGREES.  THOSE PAIRS WITH GOOD SEPARATION
040958,000463:                                                                                          	#       ARE THEN TESTED TO SEE IF THEY LIE IN CURRENT FIELD OF VIEW.  (WITHIN
040959,000464:                                                                                          	#       50 DEGREES OF SAX).  THE PAIR WITH MAX SEPARATION IS CHOSEN FROM
040960,000465:                                                                                          	#       THOSE WITH GOOD SEPARATION, AND IN FIELD OF VIEW.
040961,000466: 
040962,000467:                                                                                          	# CALLING SEQUENCE
040963,000468:                                                                                          	#       L       TC      BANKCALL
040964,000469:                                                                                          	#       L+1     CADR    R56
040965,000470:                                                                                          	#       L+2     ERROR RETURN - NO STARS IN FIELD OF VIEW
040966,000471:                                                                                          	#       L+3     NORMAL RETURN
040967,000472: 
040968,000473:                                                                                          	# OUTPUT
040969,000474:                                                                                          	#       BESTI, BESTJ - SINGLE PREC, INTEGERS, STAR NUMBERS TIMES 6
040970,000475:                                                                                          	#       VFLAG - FLAG BIT SET IMPLIES NO STARS IN FIELD OF VIEW
040971,000476: 

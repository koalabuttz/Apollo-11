012680,000191: 42,2136           32652                           DCA      IDADDTAB   +1                 	# LOAD IDAD3TEM WITH 3RD IDADDTAB ENTRY.
012681,000192: 42,2137           52152        LODNLV             DXCH     IDAD2TEM                      	# PUT RETURN INFO INTO A, L.
012682,000193: 42,2140           52006                           DXCH     Z                             	#
012683,000194: 

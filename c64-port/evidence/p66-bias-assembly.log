002541,000245: 26,2022                                           =        000D                          	#
002542,000246: 26,2022                                           =        BIT15                         	#
002543,000247: 
002544,000248:                                                                                          	# BIT 14 FLAG 0 (S)
002545,000249: 26,2022                        JSWITCH            =        001D                          	#       INTEGRATION OF W        INTEGRATION OF STATE
002546,000250: 26,2022     4736               JSWCHBIT           =        BIT14                         	#       MATRIX                  VECTOR
002547,000251: 

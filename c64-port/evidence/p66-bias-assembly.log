048092,000391: 01,3421           57403                           XCH      LST1       +3                 	#    A VALUE OF 1/2 +1 AT THE BOTTOM
048093,000392: 01,3422           57402                           XCH      LST1       +2                 	#    FOR T6-T5, CORRESPONDING TO THE
048094,000393: 01,3423           57401                           XCH      LST1       +1                 	#    INTERVAL 81.91 SEC FOR ENDTASK.
048095,000394: 01,3424           57400                           XCH      LST1                          	#
048096,000395: 01,3425           64733                           AD       POSMAX                        	# 2. SET T3 = 1.0 - T2 - T USING LIST 1.
048097,000396: 01,3426           26026                           ADS      TIME3                         	#    SO T3 WON'T TICK DURING UPDATE.
048098,000397: 01,3427           54734                           TS       RUPTAGN                       	#
048099,000398: 01,3430           44755                           CS       ZERO                          	#
048100,000399: 01,3431           54734                           TS       RUPTAGN                       	# SETS RUPTAGN TO +1 ON OVERFLOW.
048101,000400: 
048102,000401: 01,3432           00006                           EXTEND                                 	# DISPATCH TASK.
048103,000402: 01,3433           45237                           DCS      ENDTASK                       	#
048104,000403: 01,3434           53431                           DXCH     LST2       +16D               	#
048105,000404: 01,3435           53427                           DXCH     LST2       +14D               	#
048106,000405: 01,3436           53425                           DXCH     LST2       +12D               	#
048107,000406: 01,3437           53423                           DXCH     LST2       +10D               	#
048108,000407: 01,3440           53421                           DXCH     LST2       +8D                	#
048109,000408: 01,3441           53417                           DXCH     LST2       +6                 	#
048110,000409: 01,3442           53415                           DXCH     LST2       +4                 	#
048111,000410: 01,3443           53413                           DXCH     LST2       +2                 	#
048112,000411: 01,3444           53411                           DXCH     LST2                          	#
048113,000412: 
048114,000413: 01,3445           56001                           XCH      L                             	#
048115,000414: 01,3446           00006                           EXTEND                                 	#
048116,000415: 01,3447           01007                           WRITE    SUPERBNK                      	# SET SUPERBANK FROM BBCON OF 2CADR
048117,000416: 01,3450           56001                           XCH      L                             	# RESTORE TO L FOR DXCH Z.
048118,000417: 01,3451           52006                           DTCB                                   	#
048119,000418: 
048120,000419:                                                                                          	# Page 1129
048121,000420:                                                                                          	# RETURN, AFTER EXECUTION OF T3 OVERFLOW TASK:
048122,000421: 
048123,000422:    5261                                           BLOCK    02                            	#
048124,000423:    5261                                           COUNT*   $$/WAIT                       	#
048125,000424:    5261           10734        TASKOVER           CCS      RUPTAGN                       	# IF +1 RETURN TO T3RUPT, IF -0 RESUME.
048126,000425:    5262           35220                           CAF      WAITBB                        	#
048127,000426:    5263           54006                           TS       BBANK                         	#
048128,000427:    5264           13414                           TCF      T3RUPT2                       	# DISPATCH NEXT TASK IF IT WAS DUE.
048129,000428: 
048130,000429:    5265           30016                           CA       BANKRUPT                      	#
048131,000430:    5266           00006                           EXTEND                                 	#
048132,000431:    5267           01007                           WRITE    SUPERBNK                      	# RESTORE SUPERBANK BEFORE RESUME IS DONE
048133,000432: 
048134,000433:    5270           00006        RESUME             EXTEND                                 	#
048135,000434:    5271           22012                           QXCH     QRUPT                         	#
048136,000435:    5272           30016        NOQRSM             CA       BANKRUPT                      	#
048137,000436:    5273           56006                           XCH      BBANK                         	#
048138,000437:    5274           52011        NOQBRSM            DXCH     ARUPT                         	#
048139,000438:    5275           00003                           RELINT                                 	#
048140,000439:    5276           50017                           RESUME                                 	#
048141,000440: 
048142,000441:                                                                                          	# Page 1130
048143,000442:                                                                                          	# LONGCALL
048144,000443:                                                                                          	# PROGRAM DESCRIPTION                           DATE -- 17 MARCH 1967
048145,000444:                                                                                          	# PROGRAM WRITTEN BY W.H.VANDEVER               LOG SECTION WAITLIST
048146,000445:                                                                                          	# MOD BY -- R. MELANSON TO ADD DOCUMENTATION    ASSEMBLY SUNDISK REV. 100
048147,000446: 
048148,000447:                                                                                          	# FUNCTIONAL DESCRIPTION --
048149,000448:                                                                                          	#       LONGCALL IS CALLED WITH THE DELTA TIME ARRIVING IN A,L SCALED AS TIME2,TIME1 WITH THE 2CADR OF THE TASK
048150,000449:                                                                                          	#       IMMEDIATELY FOLLOWING THE TC LONGCALL.  FOR EXAMPLE, IT MIGHT BE DONE AS FOLLOWS WHERE TIMELOC IS THE NAME OF
048151,000450:                                                                                          	#       A DP REGISTER CONTAINING A DELTA TIME AND WHERE TASKTODO IS THE NAME OF THE LOCATION AT WHICH LONGCALL IS TO
048152,000451:                                                                                          	#       START.
048153,000452:                                                                                          	# CALLING SEQUENCE --
048154,000453:                                                                                          	#               EXTEND
048155,000454:                                                                                          	#               DCA     TIMELOC
048156,000455:                                                                                          	#               TC      LONGCALL
048157,000456:                                                                                          	#               2CADR   TASKTODO
048158,000457:                                                                                          	# NORMAL EXIT MODE --
048159,000458:                                                                                          	#       1)      TC      WAITLIST
048160,000459:                                                                                          	#       2)      DTCB    (TC L+3 OF CALLING ROUTINE 1ST PASS THRU LONGCYCL)
048161,000460:                                                                                          	#       3)      DTCB    (TO TASKOVER ON SUBSEQUENT PASSES THRU LONGCYCL)
048162,000461:                                                                                          	# ALARM OR ABORT EXIT MODE --
048163,000462:                                                                                          	#       NONE
048164,000463:                                                                                          	# OUTPUT --
048165,000464:                                                                                          	#       LONGTIME AND LONGTIME+1 = DELTA TIME
048166,000465:                                                                                          	#       LONGEXIT AND LONGEXIT+1 = RETURN 2CADR
048167,000466:                                                                                          	#       LONGCADR AND LONGCADR+1 = TASK 2CADR
048168,000467:                                                                                          	#       A = SINGLE PRECISION TIME FOR WAITLIST
048169,000468:                                                                                          	# ERASABLE INITIALIZATION --
048170,000469:                                                                                          	#       A = MOST SIGNIFICANT PART OF DELTA TIME
048171,000470:                                                                                          	#       L = LEAST SIGNIFICANT PART OF DELTA TIME
048172,000471:                                                                                          	#       Q = ADDRESS OF 2CADR TASK VALUE
048173,000472:                                                                                          	# DEBRIS --
048174,000473:                                                                                          	#       A,Q,L
048175,000474:                                                                                          	#       LONGCADR AND LONGCADR+1
048176,000475:                                                                                          	#       LONGEXIT AND LONGEXIT+1
048177,000476:                                                                                          	#       LONGTIME AND LONGTIME+1
048178,000477:                                                                                          	# *** THE FOLLOWING IS TO BE IN FIXED-FIXED AND UNSWITCHED ERRASIBLE **
048179,000478: 
048180,000479:    5277                                           BLOCK    02                            	#
048181,000480:    5277  E3,1400                                  EBANK=   LST1                          	#
048182,000481:    5277           53154        LONGCALL           DXCH     LONGTIME                      	# OBTAIN THE DELTA TIME
048183,000482: 
048184,000483:    5300           00006                           EXTEND                                 	# OBTAIN THE 2CADR
048185,000484:                                                                                          	# Page 1131
048186,000485:    5301           50002                           NDX      Q                             	#
048187,000486:    5302           30001                           DCA      0                             	#
048188,000487:    5303           53150                           DXCH     LONGCADR                      	#
048189,000488: 
048190,000489:    5304           00006                           EXTEND                                 	# NOW GO TO THE APPROPRIATE SWITCHED BANK
048191,000490:    5305           35310                           DCA      LGCL2CDR                      	# FOR THE REST OF LONGCALL
048192,000491:    5306           52006                           DTCB                                   	#
048193,000492: 
048194,000493:    5307  E3,1400                                  EBANK=   LST1                          	#
048195,000494:    5307           03452 02063  LGCL2CDR           2CADR    LNGCALL2                      	#
048196,000495: 
048197,000496:                                                                                          	# *** THE FOLLOWING MAY BE IN A SWITCHED BANK, INCLUDING ITS ERASABLE ***
048198,000497: 
048199,000498: 01,3452                                           BANK     01                            	#
048200,000499: 01,3452                                           COUNT*   $$/WAIT                       	#
048201,000500: 01,3452           23435        LNGCALL2           LXCH     LONGEXIT   +1                 	# SAVE THE CORRECT BB FOR RETURN
048202,000501: 01,3453           34752                           CA       TWO                           	# OBTAIN THE RETURN ADDRESS
048203,000502: 01,3454           26002                           ADS      Q                             	#
048204,000503: 01,3455           55434                           TS       LONGEXIT                      	#
048205,000504: 
048206,000505: 01,3456           31153                           CA       LONGTIME                      	# CHECK FOR LEGITIMATE DELTA-TIME
048207,000506: 01,3457           10000                           CCS      A                             	#
048208,000507: 01,3460           13466                           TCF      LONGCYCL                      	# HI-ORDER OK --> ALL IS OK.
048209,000508: 01,3461           13463                           TCF      +2                            	# HI-ORDER ZERO --> CHECK LO-ORDER.
048210,000509: 01,3462           13521                           TCF      LONGPOOH                      	# HI-ORDER NEG. --> NEG. DT
048211,000510: 01,3463           31154                 +2        CA       LONGTIME   +1                 	# CHECK LO-ORDER FOR ZERO OR NEGATIVE.
048212,000511: 01,3464           00006                           EXTEND                                 	#
048213,000512: 01,3465           63521                           BZMF     LONGPOOH                      	# BAD DELTA-TIME.  ABORT
048214,000513: 
048215,000514:                                                                                          	# *** WAITLIST TASK LONGCYCL ***
048216,000515: 
048217,000516: 01,3466           00006        LONGCYCL           EXTEND                                 	# CAN WE SUCCESFULLY TAKE ABOUT 1.25
048218,000517: 01,3467           43500                           DCS      DPBIT14                       	# MINUTES OFF OF LONGTIME
048219,000518: 01,3470           21154                           DAS      LONGTIME                      	#
048220,000519: 
048221,000520: 01,3471           11154                           CCS      LONGTIME   +1                 	# THE REASONING BEHIND THIS PART IS
048222,000521: 01,3472           13511                           TCF      MUCHTIME                      	# INVOLVED, TAKING INTO ACCOUNT THAT THE
048223,000522:                                                                                          	# WORDS MAY NOT BE SIGNED CORRECTED (DP
048224,000523:                                                                                          	# BASIC INSTRUCTIONS
048225,000524:                                                                                          	# DO NOT SIGN CORRECT) AND THAT WE SUBTRAC-
048226,000525:                                                                                          	# TED BIT14 (1 OVER HALF THE POS. VALUE
048227,000526:                                                                                          	# REPRESENTABLE IN SINGLE WORD)
048228,000527: 01,3473           13474                           NOOP                                   	# CAN'T GET HERE *************
048229,000528: 01,3474           13475                           TCF      +1                            	#
048230,000529: 01,3475           11153                           CCS      LONGTIME                      	#
048231,000530: 01,3476           13511                           TCF      MUCHTIME                      	#
048232,000531: 01,3477           00000        DPBIT14            OCT      00000                         	#
048233,000532: 01,3500           20000                           OCT      20000                         	#
048234,000533: 
048235,000534:                                                                                          	# LONGCALL
048236,000535:                                                                                          	# Page 1132
048237,000536: 01,3501           34736        LASTTIME           CA       BIT14                         	# GET BACK THE CORRECT DELTA T FOR WAITLIST
048238,000537: 01,3502           27154                           ADS      LONGTIME   +1                 	#
048239,000538: 01,3503           05203                           TC       WAITLIST                      	#
048240,000539: 01,3504  E3,1400                                  EBANK=   LST1                          	#
048241,000540: 01,3504           03516 02063                     2CADR    GETCADR                       	# THE ENTRY TO OUR LONGCADR
048242,000541: 
048243,000542: 01,3506           33520        LONGRTRN           CA       TSKOVCDR                      	# SET IT UP SO THAT ONLY THE FIRST EXIT IS
048244,000543: 01,3507           53435                           DXCH     LONGEXIT                      	# TO THE CALLER OF LONGCALL
048245,000544: 01,3510           52006                           DTCB                                   	# THE REST ARE TO TASKOVER
048246,000545: 
048247,000546: 01,3511           34736        MUCHTIME           CA       BIT14                         	# WE HAVE OVER OUR ABOUT 1.25 MINUTES
048248,000547: 01,3512           05203                           TC       WAITLIST                      	# SO SET UP FOR ANOTHER CYCLE THROUGH HERE
048249,000548: 01,3513  E3,1400                                  EBANK=   LST1                          	#
048250,000549: 01,3513           03466 02063                     2CADR    LONGCYCL                      	#
048251,000550: 
048252,000551: 01,3515           13506                           TCF      LONGRTRN                      	# NOW EXIT PROPERLY
048253,000552: 
048254,000553:                                                                                          	# *** WAITLIST TASK GETCADR ***
048255,000554: 
048256,000555: 01,3516           53150        GETCADR            DXCH     LONGCADR                      	# GET THE LONGCALL THAT WE WISHED TO START
048257,000556: 01,3517           52006                           DTCB                                   	# AND TRANSFER CONTROL TO IT
048258,000557: 
048259,000558: 01,3520           05261        TSKOVCDR           GENADR   TASKOVER                      	#
048260,000559: 01,3521           53435        LONGPOOH           DXCH     LONGEXIT                      	#
048261,000560: 01,3522           13524                           TCF      +2                            	#
048262,000561: 01,3523           52062        WAITPOOH           DXCH     WAITEXIT                      	#
048263,000562: 01,3524           05726                 +2        TC       POODOO1                       	#
048264,000563: 01,3525           01204                           OCT      01204                         	#
048265,000564: 
(End of include-file WAITLIST.agc, resuming MAIN.agc)

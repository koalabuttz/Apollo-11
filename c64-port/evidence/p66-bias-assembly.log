045807,002110: 
045808,002111: 00,2725           00006        /NORM2             EXTEND                                 	# IF LESS THAN .5, AUGMENT DVNORMCT AND
045809,002112: 00,2726           24137                           AUG      DVNORMCT                      	# DOUBLE DIVISOR.
045810,002113: 00,2727           00006                           EXTEND                                 	#
045811,002114: 00,2730           30131                           DCA      BUF                           	#
045812,002115: 00,2731           20131                           DAS      BUF                           	#
045813,002116: 
045814,002117: 00,2732           30130        /NORM              CA       BUF                           	# SEE IF DIVISOR NORMALIZED.
045815,002118: 00,2733           60000                           DOUBLE                                 	#
045816,002119: 00,2734           54000                           OVSK                                   	#
045817,002120: 00,2735           12725                           TCF      /NORM2                        	# DOUBLE AND TRY AGAIN IF NOT.
045818,002121: 

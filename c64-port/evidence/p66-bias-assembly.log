057051,000881:                                                                                          	# PROGRAM DESCRIPTION
057052,000882:                                                                                          	# IMU STATUS CHECK ROUTINE R02 (SUBROUTINE UTILITY)
057053,000883:                                                                                          	# MOD NO - 1

065396,000143: 21,3710           55745                           TS       OLDSENSE                      	#
065397,000144: 21,3711           31427                           CA       EDOT                          	#
065398,000145: 21,3712           13716                           TCF      +4                            	#
065399,000146: 21,3713           34753        PLUSFIRE           CA       ONE                           	#
065400,000147: 21,3714           55745                           TS       OLDSENSE                      	#

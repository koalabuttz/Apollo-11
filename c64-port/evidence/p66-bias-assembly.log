045153,001456:                                                                                          	# THE FOLLOWING SHORT SHIFT CODES REQUIRE NO ADDRESS WORD:
045154,001457:                                                                                          	#       1.      SR1 TO SR4      SCALAR SHIFT RIGHT.
045155,001458:                                                                                          	#       2.      SR1R TO SR4R    SCALAR SHIFT RIGHT AND ROUND.
045156,001459:                                                                                          	#       3.      SL1 TO SL4      SCALAR SHIFT LEFT.
045157,001460:                                                                                          	#       4.      SL1R TO SL4R    SCALAR SHIFT LEFT AND ROUND.
045158,001461:                                                                                          	#       5.      VSR1 TO VSR8    VECTOR SHIFT RIGHT (ALWAYS ROUNDS).
045159,001462:                                                                                          	#       6.      VSL1 TO VSL8    VECTOR SHIFT LEFT (NEVER ROUNDS).
045160,001463:                                                                                          	# THE FOLLOWING CODES REQUIRE AND ADDRESS WHICH MAY BE INDEXED:*
045161,001464:                                                                                          	#       1.      SR              SCALAR SHIFT RIGHT.
045162,001465:                                                                                          	#       2.      SRR             SCALAR SHIFT RIGHT AND ROUND.
045163,001466:                                                                                          	#       3.      SL              SCALAR SHIFT LEFT.
045164,001467:                                                                                          	#       4.      SLR             SCALAR SHIFT LEFT AND ROUND.
045165,001468:                                                                                          	#       5.      VSR             VECTOR SHIFT RIGHT.
045166,001469:                                                                                          	#       6.      VSL             VECTOR SHIFT LEFT.
045167,001470:                                                                                          	# * IF THE ADDRESS IS INDEXED, AND THE INDEX MODIFICATION RESULTS IN A NEGATIVE SHIFT COUNT, A SHIFT OF THE
045168,001471:                                                                                          	# ABSOLUTE VALUE OF THE COUNT IS DONE IN THE OPPOSITE DIRECTION.

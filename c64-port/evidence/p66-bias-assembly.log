007042,000704:                                                                                          	# PROGRAM NAME:  ITURNON.
007043,000705: 
007044,000706:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM IS CALLED BY IMUMON WHEN A CHANGE OF BIT 14 OF CHANNEL 30 (ISS TURN-ON
007045,000707:                                                                                          	# REQUEST) IS DETECTED.  UPON ENTRY, ITURNON CHECKS IF A TURN-ON DELAY SEQUENCE HAS FAILED, AND IF SO, IT EXITS.
007046,000708:                                                                                          	# IF NOT, IT CHECKS WHETHER THE TURN-ON REQUEST CHANGE IS TO ON OR OFF.  IF ON, IT SETS BIT7 OF IMODES30 TO 1 SO
007047,000709:                                                                                          	# THAT TNONTEST WILL INITIATE THE ISS INITIALIZATION SEQUENCE.  IF OFF, THE TURN-ON DELAY SIGNAL, CHANNEL 12 BIT
007048,000710:                                                                                          	# 15, IS CHECKED AND IF IT IS ON, ITURNON EXITS.  IF THE DELAY SIGNAL IS OFF, PROGRAM ALARM 00207 IS ISSUED, BIT 2
007049,000711:                                                                                          	# OF IMODES30 IS SET TO 1 AND THE PROGRAM EXITS.
007050,000712: 
007051,000713:                                                                                          	# THE SETTING OF BIT 2 OF IMODES30 (ISS DELAY SEQUENCE FAIL) INHIBITS THIS ROUTINE AND IMUOP FROM
007052,000714:                                                                                          	# PROCESSING ANY CHANGES.  THIS BIT WILL BE RESET BY THE ENDTNON ROUTINE WHEN THE CURRENT 90 SECOND DELAY PERIOD
007053,000715:                                                                                          	# ENDS.
007054,000716: 
007055,000717:                                                                                          	# CALLING SEQUENCE:  FROM IMUMOM WHEN ISS TURN-ON REQUEST CHANGES STATE.
007056,000718: 
007057,000719:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
007058,000720: 
007059,000721:                                                                                          	# SUBROUTINES CALLED:  ALARM, IF THE ISS TURN-ON REQUEST IS NOT PRESENT FOR 90 SECONDS.
007060,000722: 
007061,000723:                                                                                          	# ERASABLE INITIALIZATION:  FRESH START AND RESTART SET BIT 15 OF CHANNEL 12 AND BITS 2 AND 7 OF IMODES30 TO 0,
007062,000724:                                                                                          	# AND BIT 14 OF IMODES30 TO 1.
007063,000725: 
007064,000726:                                                                                          	# ALARMS: PROGRAM ALARM 00207 IS ISSUED IF THE ISS TURN-ON REQUEST SIGNAL IS NOT PRESENT FOR 90 SECONDS.
007065,000727: 
007066,000728:                                                                                          	# EXIT:  NXTIFAIL.
007067,000729: 
007068,000730:                                                                                          	# OUTPUT:  BIT 7 OF IMODES30 TO START ISS INITIALIZATION, OR BIT 2 OF IMODES30 AND PROGRAM ALARM 00207 TO INDICATE
007069,000731:                                                                                          	# A FAILED TURN-ON SEQUENCE.
007070,000732: 
007071,000733: 06,2533           34752        ITURNON            CAF      BIT2                          	# IF DELAY REQUEST HAS GONE OFF
007072,000734: 06,2534           71302                           MASK     IMODES30                      	# PREMATURELY, DO NOT PROCESS ANY CHANGES
007073,000735: 06,2535           10000                           CCS      A                             	# UNTIL THE CURRENT 90 SEC WAIT EXPIRES.
007074,000736: 06,2536           12225                           TCF      NXTIFAIL                      	#
007075,000737: 
007076,000738: 06,2537           34736                           CAF      BIT14                         	# SEE IF JUST ON OR OFF.
007077,000739: 06,2540           71302                           MASK     IMODES30                      	#
007078,000740: 06,2541           00006                           EXTEND                                 	#
007079,000741: 06,2542           12556                           BZF      ITURNON2                      	# IF JUST ON.
007080,000742: 
007081,000743: 06,2543           34735                           CAF      BIT15                         	#
007082,000744: 06,2544           00006                           EXTEND                                 	# SEE IF DELAY PRESENT DISCRETE HAS BEEN
007083,000745: 06,2545           02012                           RAND     CHAN12                        	# SENT.  IF SO, ACTION COMPLETE
007084,000746: 06,2546           00006                           EXTEND                                 	#
007085,000747: 06,2547           12551                           BZF      +2                            	#
007086,000748: 06,2550           12225                           TCF      NXTIFAIL                      	#
007087,000749: 
007088,000750: 06,2551           34752                           CAF      BIT2                          	# IF NOT, SET BIT TO INDICATE REQUEST NOT
007089,000751: 06,2552           27302                           ADS      IMODES30                      	# PRESENT FOR FULL DURATION.
007090,000752: 06,2553           05567                           TC       ALARM                         	#
007091,000753: 06,2554           00207                           OCT      207                           	#
007092,000754: 06,2555           12225                           TCF      NXTIFAIL                      	#
007093,000755: 
007095,000757: 06,2556           41302        ITURNON2           CS       IMODES30                      	# SET BIT7 TO INDICATE WAIT OF 1 SAMPLE
007096,000758: 06,2557           74745                           MASK     BIT7                          	#
007097,000759: 06,2560           27302                           ADS      IMODES30                      	#
007098,000760: 06,2561           32564                           CAF      RRINIT                        	#
007099,000761: 06,2562           54110                           TS       RADMODES                      	#
007100,000762: 06,2563           12225                           TCF      NXTIFAIL                      	#

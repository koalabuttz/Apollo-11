063366,000452: 17,3645           00006                           EXTEND                                 	#
063367,000453: 17,3646           13465                           BZF      FULLTIME                      	#
063368,000454: 17,3647           64740                           AD       BIT12                         	# RESTORE COMPUTED TJET TO ACCUMULATOR.
063369,000455: 17,3650           20001                           DAS      A                             	#

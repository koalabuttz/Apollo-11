055704,000270:    5415           04007                           ROR      SUPERBNK                      	#
055705,000271:    5416           54064                           TS       TEMPBB                        	#
055706,000272: 
055707,000273:    5417           35422        TOCON2             CA       CON2ADR                       	# BACK TO SWITCHED BANK
055708,000274:    5420           22073                           LXCH     TEMPBBCN                      	#
055709,000275:    5421           52006                           DTCB                                   	#
055710,000276: 
055711,000277:    5422           02312        CON2ADR            GENADR   CON2                          	#
055712,000278: 
055713,000279:    5423           50002        GETPRIO            NDX      Q                             	# DON'T CARE IF DIRECT OR INDIRECT
055714,000280:    5424           30000                           CA       0                             	# LEAVE THAT DECISION TO RESTARTS
055715,000281:    5425           24002                           INCR     Q                             	# OBTAIN RETURN ADDRESS
055716,000282:                                                                                          	# Page 1300
055717,000283:    5426           15404                           TCF      CON1       -1                 	#
055718,000284: 
055719,000285:    5427           00006        GETNEWNM           EXTEND                                 	#
055720,000286:    5430           50002                           INDEX    Q                             	#
055721,000287:    5431           30001                           DCA      0                             	#
055722,000288:    5432           52064                           DXCH     TEMPNM                        	#
055723,000289:    5433           34752                           CA       TWO                           	#
055724,000290:    5434           26002                           ADS      Q                             	# OBTAIN RETURN ADDRESS
055725,000291: 
055726,000292:    5435           15417                           TCF      TOCON2                        	#
055727,000293: 
055728,000294:    5436     5024               OCT14000           EQUALS   PRIO14                        	#
055729,000295:    5436     0061               TEMPG              EQUALS   ITEMP1                        	#
055730,000296:    5436     0062               TEMPP              EQUALS   ITEMP2                        	#
055731,000297:    5436     0063               TEMPNM             EQUALS   ITEMP3                        	#
055732,000298:    5436     0064               TEMPBB             EQUALS   ITEMP4                        	#
055733,000299:    5436     0065               TEMPSW             EQUALS   ITEMP5                        	#
055734,000300:    5436     0066               TEMPSW2            EQUALS   ITEMP6                        	#
055735,000301:    5436     0070               TEMPPR             EQUALS   RUPTREG1                      	#
055736,000302:    5436     0071               TEMPG2             EQUALS   RUPTREG2                      	#
055737,000303:    5436     0072               TEMPP2             EQUALS   RUPTREG3                      	#

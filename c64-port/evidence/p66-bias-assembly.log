031022,000422: 22,3573           64414                           BOFF     SR2R                          	# NEED HAPO AT (-29)M FOR DISPLAY.
031023,000423:                                                                                          	# IF MOON CENTERED, RESCALE FROM (-27)M.
031024,000424:                                                                                          	# IF EARTH CENTERED ALREADY AT (-29)M.
031025,000425: 22,3574           03755                                    V82EMFLG                      	# OFF FOR EARTH, ON FOR MOON.
031026,000426: 22,3575           45576                                    +1                            	#
031027,000427: 22,3576           77624                           CALL                                   	# IF HAPO > MAXNM, SET HAPO =9999.9 NM.
031028,000428: 22,3577           45636                                    MAXCHK                        	# OTHERWISE STORE (RAPO-RPADTEM) IN HAPO.
031029,000429: 22,3600           16120        STORHAPO           STODL    HAPOX                         	#
031030,000430: 22,3601           00017                                    RPER                          	#
031031,000431: 22,3602           77625                           DSU                                    	#
031032,000432: 22,3603           02203                                    RPADTEM                       	# GIVES HPER AT (-29)M EARTH, (-27)M MOON.
031033,000433: 22,3604           00161                           STORE    MPAC       +4                 	# SAVE THIS FOR COMPARISON TO HPERMIN.
031034,000434: 22,3605           64414                           BOFF     SR2R                          	# NEED HPER AT (-29)M FOR DISPLAY.
031035,000435:                                                                                          	# IF MOON CENTERED, RESCALE FROM (-27)M.
031036,000436:                                                                                          	# IF EARTH CENTERED ALREADY AT (-29)M.
031037,000437: 22,3606           03755                                    V82EMFLG                      	# OFF FOR EARTH, ON FOR MOON.
031038,000438: 22,3607           45610                                    +1                            	#
031039,000439: 22,3610           77624                           CALL                                   	# IF HPER > MAXNM, SET HPER = 9999.9 NM.
031040,000440: 22,3611           45636                                    MAXCHK                        	#
031042,000442: 22,3612           16122        STORHPER           STODL    HPERX                         	# STORE (RPER - RPADTEM) INTO HPERX.
031043,000443: 22,3613           00161                                    MPAC       +4                 	#
031044,000444: 22,3614           51025                           DSU      BPL                           	# HPERMIN AT (-29)M FOR EARTH, (-27)M MOON
031045,000445: 22,3615           02201                                    HPERMIN                       	# IF HPER L/ HPERMIN (300 OR 35) KFT,
031046,000446: 22,3616           45622                                    DOTPER                        	# THEN ZERO INTO -TPER.
031047,000447: 22,3617           52145                           DLOAD    GOTO                          	# OTHERWISE CALCULATE TPER.
031048,000448: 22,3620           06522                                    HI6ZEROS                      	#
031049,000449: 22,3621           45626                                    SKIPTPER                      	#
031050,000450: 22,3622           45145        DOTPER             DLOAD    CALL                          	#
031051,000451: 22,3623           00017                                    RPER                          	#
031052,000452: 22,3624           57465                                    CALCTPER                      	#
031053,000453: 22,3625           77676                           DCOMP                                  	# TPER IS PUT NEG INTO -TPER.
031054,000454: 22,3626           16143        SKIPTPER           STODL    -TPER                         	#
031055,000455: 22,3627           02201                                    HPERMIN                       	# HPERMIN AT (-29)M FOR EARTH, (-27)M MOON
031056,000456: 22,3630           45015                           DAD      CALL                          	#
031057,000457: 22,3631           02203                                    RPADTEM                       	# RPADTEM AT (-29)M FOR EARTH, (-27)M MOON
031058,000458: 22,3632           57470                                    CALCTFF                       	# GIVES 59M59S FOR TFF IF RPER G/
031059,000459: 22,3633           77676                           DCOMP                                  	# HPERMIN + RPADTEM.  (TPER WAS NON ZERO)
031060,000460: 22,3634           36141                           STCALL   TFF                           	# OTHERWISE COMPUTES TFF.       (GOTO)
031061,000461: 22,3635           00051                                    S2                            	#

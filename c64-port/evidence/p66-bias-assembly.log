021713,000517: 
021714,000518:                                                                                          	#       PREFERRED TRACKING ATTITUDE PROGRAM P25
021715,000519:                                                                                          	#       MOD NO - 3
021716,000520:                                                                                          	#       BY P. VOLANTE
021717,000521: 
021718,000522:                                                                                          	# FUNCTIONAL DESCRIPTION
021719,000523: 
021720,000524:                                                                                          	#       THE PURPOSE OF THIS PROGRAM IS TO COMPUTE THE PREFERRED TRACKING
021721,000525:                                                                                          	#       ATTITUDE OF THE LM TO CONTINUOUSLY POINT THE LM TRACKING BEACON AT THE
021722,000526:                                                                                          	#       CSM AND TO PERFORM THE MANEUVER TO THE PREFERRED TRACKING ATTITUDE AND
021723,000527:                                                                                          	#       CONTINUOUSLY MAINTAIN THIS ATTITUDE WITHIN PRESCRIBED LIMITS
021724,000528: 

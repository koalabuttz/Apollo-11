028026,000033: 
028028,000035: 
028029,000036:                                                                                          	# GENERAL LAMBERT AIMPOINT GUIDANCE **
028030,000037:                                                                                          	# WRITTEN BY RAMA M AIYAWAR
028031,000038: 
028032,000039:                                                                                          	# PROGRAM P-31 DESCRIPTION **
028033,000040: 
028034,000041:                                                                                          	# 1.    TO ACCEPT TARGETING PARAMETERS OBTAINED FROM A SOURCE EXTERNAL
028035,000042:                                                                                          	#       TO THE LEM AND COMPUTE THERE FROM THE REQUIRED-VELOCITY AND
028036,000043:                                                                                          	#       OTHER INITIAL CONDITIONS REQUIRED BY LM FOR DESIRED MANEUVER.
028037,000044:                                                                                          	#       THE TARGETING PARAMETERS ARE TIG (TIME OF IGNITION), TARGET 
028038,000045:                                                                                          	#       VECTOR (RTARG), AND THE TIME FROM TIG UNTIL THE TARGET IS
028039,000046:                                                                                          	#       REACHED (DELLT4), DESIRED TIME OF FLIGHT FROM RINIT TO RTARG..
028040,000047: 
028041,000048:                                                                                          	# ASSUMPTIONS **
028042,000049: 
028043,000050:                                                                                          	# 1.    THE TARGET PARAMETERS MAY HAVE BEEN LOADED PRIOR TO THE
028044,000051:                                                                                          	#       EXECUTION OF THIS PROGRAM.
028045,000052:                                                                                          	# 2.    THIS PROGRAM IS APPLICABLE IN EITHER EARTH OR LUNAR ORBIT.
028046,000053:                                                                                          	# 3.    THIS PROGRAM IS DESIGNED FOR ONE-MAN OPERATION, AND SHOULD
028047,000054:                                                                                          	#       BE SELECTED BY THE ASTRONAUT BY DSKY ENTRY V37 E31.
028048,000055: 
028049,000056:                                                                                          	# SUBROUTINES USED **
028050,000057:                                                                                          	# 
028051,000058:                                                                                          	# MANUPARM, TTG/N35, R02BOTH, MIDGIM, DISPMGA, FLAGDOWN, BANKCALL,
028052,000059:                                                                                          	# GOTOPOOH, ENDOFJOB, PHASCHNG, GOFLASHR, GOFLASH.
028053,000060: 
028054,000061:                                                                                          	# MANUPARM      CALCULATES APOGEE, PERIGEE ALTITUDES AND DELTAV DESIRED
028055,000062:                                                                                          	#               FOR THE MANEUVER.
028056,000063: 
028057,000064:                                                                                          	# TTG/N35       CLOCKTASK - UPDATES CLOCK.
028058,000065: 
028059,000066:                                                                                          	# MIDGIM        CALCULATES MIDDLE GIMBAL ANGLE FOR DISPLAY.
028060,000067: 
028061,000068:                                                                                          	# R02BOTH       IMU - STATUS CHECK ROUTINE.
028062,000069: 
028063,000070:                                                                                          	# DISPLAYS USED IN P-31LM **
028064,000071: 
028065,000072:                                                                                          	# V06N33        DISPLAY SOTRED TIG (IN HRS. MINS. SECS)
028066,000073:                                                                                          	# V06N42        DISPLAY APOGEE, PERIGEE, DELTAV.
028067,000074:                                                                                          	# V16N35        DISPLAY TIME FROM TIG.
028068,000075:                                                                                          	# V06N45        TIME FROM IGNITION AND MIDDLE GIMBAL ANGLE.
028069,000076: 
028070,000077:                                                                                          	# ERASABLE INITIALIZATION REQUIRED **
028071,000078: 
028072,000079:                                                                                          	# TIG           TIME OF IGNITION                DP      (B+28) CS.
028073,000080: 
028074,000081:                                                                                          	# DELLT4        DESIRED TIME OF FLIGHT          DP      (B+28) CS
028075,000082:                                                                                          	#               FROM RINIT TO RTARG.
028076,000083: 
028077,000084:                                                                                          	# RTARG         RADIUS VECTOR OF TARGET POSITION VECTOR
028078,000085:                                                                                          	#               RADIUS VECTOR SCALED TO (B+29)METERS IF EARTH ORBIT
028080,000087:                                                                                          	#               RADIUS VECTOR SCALED TO (B+27)METERS IF MOON ORBIT
028081,000088: 
028082,000089:                                                                                          	# OUTPUT **
028083,000090: 
028084,000091:                                                                                          	# HAPO          APOGEE ALTITUDE
028085,000092:                                                                                          	# HPER          PERIGEE ALTITUDE
028086,000093:                                                                                          	# VGDISP        MAG. OF DELTAV FOR DISPLAY, SCALING     B+7 M/CS EARTH
028087,000094:                                                                                          	#               MAG. OF DELTAV FOR DISPLAY, SCALING     B+5 M/CS MOON
028088,000095:                                                                                          	# MIDGIM        MIDDLE GIMBAL ANGLE
028089,000096:                                                                                          	# XDELVFLG      RESETS XDELVFLG FOR LAMBERT VG COMPUTATIONS
028090,000097: 
028091,000098:                                                                                          	# ALARMS OR ABORTS      NONE **
028092,000099: 
028093,000100:                                                                                          	# RESTARTS ARE VIA GROUP 4 **
028094,000101: 
028095,000102: 35,2000                                           SETLOC   GLM                           	#
028096,000103: 35,2000                                           BANK                                   	#
028097,000104: 

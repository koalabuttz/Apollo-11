048704,000124: 24,3675           61375                           VLOAD    VXM                           	#
048705,000125: 24,3676           02013                                    504LM                         	# LP=LM
048706,000126: 24,3677           00025                                    MMATRIX                       	#
048707,000127: 24,3700           77772                           VSL1                                   	# L = MT(T)*LP          RADIANS B0
048708,000128: 24,3701           51235        RTORPB             VXV      BVSU                          	#
048709,000129: 24,3702           00001                                    504RPR                        	#
048710,000130: 24,3703           00001                                    504RPR                        	#

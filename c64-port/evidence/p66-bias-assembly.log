043079,000032:                                                                                          	##
043080,000033:                                                                                          	## Notations on the hardcopy document read, in part:
043081,000034:                                                                                          	##
043082,000035:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
043083,000036:                                                                                          	##      16:27 JULY 14, 1969 
043084,000037: 
043086,000039:                                                                                          	# PROGRAM NAME - DOWN TELEMETRY PROGRAM
043087,000040:                                                                                          	# MOD NO. - 0           TO COMPLETELY REWRITE THE DOWN TELEMETRY PROGRAM AND DOWNLINK ERASABLE DUMP PROGRAM FOR THE
043088,000041:                                                                                          	#                       PURPOSE OF SAVING APPROXIMATELY 150 WORDS OF CORE STORAGE.
043089,000042:                                                                                          	#                       THIS CHANGE REQUIRES AN ENTIRELY NEW METHOD OF SPECIFYING DOWNLINK LISTS.  REFER TO DOWNLINK
043090,000043:                                                                                          	#                       LISTS LOG SECTION FOR MORE DETAILS.  HOWEVER THIS CHANGE WILL NOT AFFECT THE GROUND PROCESSING
043091,000044:                                                                                          	#                       OF DOWN TELEMETRY DATA.
043092,000045:                                                                                          	# MOD BY - KILROY, SMITH, DEWITT
043093,000046:                                                                                          	# DATE - 02 OCT 67
043094,000047:                                                                                          	# AUTHORS - KILROY, SMITH, DEWITT, DEWOLF, FAGIN
043095,000048:                                                                                          	# LOG SECTION - DOWN-TELEMETRY PROGRAM
043096,000049: 
043097,000050:                                                                                          	# FUNCTIONAL DESCRIPTION - THIS ROUTINE IS INITIATED BY TELEMETRY END
043098,000051:                                                                                          	#       PULSE FROM THE DOWNLINK TELEMETRY CONVERTER.  THIS PULSE OCCURS
043099,000052:                                                                                          	#       AT 50 TIMES PER SEC (EVERY 20 MS) THEREFORE DODOWNTM IS
043100,000053:                                                                                          	#       EXECUTED AT THESE RATES.  THIS ROUTINE SELECTS THE APPROPRIATE
043101,000054:                                                                                          	#       AGC DATA TO BE TRANSMITTED DOWNLINK AND LOADS IT INTO OUTPUT
043102,000055:                                                                                          	#       CHANNELS 34 AND 35.  THE INFORMATION IS THEN GATED OUT FROM THE
043103,000056:                                                                                          	#       LGC IN SERIAL FASHION.
043104,000057: 
043105,000058:                                                                                          	#       THIS PROGRAM IS CODED FOR A 2 SECOND DOWNLIST.  SINCE DOWNRUPTS
043106,000059:                                                                                          	#       OCCUR EVERY 20 MS AND 2 AGC COMPUTER WORDS CAN BE PLACED IN
043107,000060:                                                                                          	#       CHANNELS 34 AND 35 DURING EACH DOWNRUPT THE PROGRAM IS CAPABLE
043108,000061:                                                                                          	#       OF SENDING 200 AGC WORDS EVERY 2 SECONDS.
043109,000062: 
043110,000063:                                                                                          	# CALLING SEQUENCE - NONE
043111,000064:                                                                                          	#       PROGRAM IS ENTERED VIA TCF DODOWNTM WHICH IS EXECUTED AS A
043112,000065:                                                                                          	#       RESULT OF A DOWNRUPT.  CONTROL IS RETURNED VIA TCF RESUME WHICH
043113,000066:                                                                                          	#       IN EFFECT IS A RESUME.
043114,000067: 
043115,000068:                                                                                          	# SUBROUTINES CALLED - NONE
043116,000069: 
043117,000070:                                                                                          	# NORMAL EXIT MODE - TCF RESUME
043118,000071: 
043119,000072:                                                                                          	# ALARM OR ABORT EXIT MODE - NONE
043120,000073: 
043121,000074:                                                                                          	# RESTART PROTECTION:
043122,000075:                                                                                          	#       ON A FRESH START AND RESTART THE 'STARTSUB' SUBROUTINE WILL INITIALIZE THE DOWNLIST POINTER (ACTUALLY
043123,000076:                                                                                          	#       DNTMGOTO) TO THE BEGINNING OF THE CURRENT DOWNLIST (I.E. CURRENT CONTENTS OF DNLSTADR).  THIS HAS THE
043124,000077:                                                                                          	#       EFFECT OF IGNORING THE REMAINDER OF THE DOWNLIST WHICH THE DOWN-TELEMETRY PROGRAM WAS WORKING ON WHEN
043125,000078:                                                                                          	#       THE RESTART (OR FRESH START) OCCURRED AND RESUME DOWN TELEMETRY FROM THE BEGINNING OF THE CURRENT
043126,000079:                                                                                          	#       DOWNLIST.
043127,000080: 
043128,000081:                                                                                          	#       ALSO OF INTEREST IS THE FACT THAT ON A RESTART THE AGC WILL ZERO DOWNLINK CHANNELS 13, 34 AND 35.
043129,000082: 
043130,000083:                                                                                          	# DOWNLINK LIST SELECTION:
043131,000084:                                                                                          	#       THE APPROPRIATE DOWNLINK LISTS ARE SELECTED BY THE FOLLOWING:
043132,000085:                                                                                          	#       1.      FRESH START
043133,000086:                                                                                          	#       2.      V37EXXE WHERE XX = THE MAJOR MODE BEING SELECTED.
043134,000087:                                                                                          	#       3.      UPDATE PROGRAM (P27)
043135,000088:                                                                                          	#       4.      NON-V37 SELECTABLE TYPE PROGRAMS (E.G. AGS INITIALIZATION (SUNDANCE, LUMINARY) AND P61-P62
043136,000089:                                                                                          	#               TRANSITION (COLOSSUS) ETC.).
043137,000090: 
043138,000091:                                                                                          	# DOWNLINK LIST RULES AND LIMITATIONS:
043139,000092:                                                                                          	#       READ SECTION(S) WHICH FOLLOW 'DEBRIS' WRITEUP.
043140,000093: 
043141,000094:                                                                                          	# OUTPUT - EVERY 2 SECONDS 100 DOUBLE PRECISION WORDS (I.E. 200 LGC
043142,000095:                                                                                          	#       COMPUTER WORDS) ARE TRANSMITTED VIA DOWNLINK.
043143,000096: 
043144,000097:                                                                                          	# ERASABLE INITIALIZATION REQUIRED - NONE
043145,000098:                                                                                          	#       'DNTMGOTO' AND 'DNLSTADR' ARE INITIALIZED BY THE FRESH START PROGRAM.
043146,000099: 
043147,000100:                                                                                          	# DEBRIS (ERASABLE LOCATIONS DESTROYED BY THIS PROGRAM) -
043148,000101:                                                                                          	#       LDATALST, DNTMBUFF TO DNTMBUFF +21D, TMINDEX, DNQ.
043149,000102: 
043152,000105: 
043154,000107:                                                                                          	# DODOWNTM IS ENTERED EVERY 20 MS BY AN INTERRUPT TRIGGERED BY THE
043155,000108:                                                                                          	# RECEIPT OF AN ENDPULSE FROM THE SPACECRAFT TELEMETRY PROGRAMMER.
043156,000109: 
043157,000110:                                                                                          	# NOTES REGARDING DOWNLINK LISTS ASSOCIATED WITH THIS PROGRAM:
043158,000111:                                                                                          	# 1.    DOWNLISTS. - DOWNLISTS MUST BE COMPILED IN THE SAME BANK AS THE
043159,000112:                                                                                          	#       DOWN-TELEMETRY PROGRAM.  THIS IS DONE FOR EASE OF CODING, FASTER
043160,000113:                                                                                          	#       EXECUTION.
043161,000114:                                                                                          	# 2.    EACH DOWNLINK LIST CONSISTS OF A CONTROL LIST AND A NUMBER OF
043162,000115:                                                                                          	#       SUBLISTS.
043163,000116:                                                                                          	# 3.    A SUBLIST REFERS TO A SNAPSHOT OR DATA COMMON TO THE SAME OR OTHER
043164,000117:                                                                                          	#       DOWNLINK LISTS.  ANY SUBLIST CONTAINING COMMON DATA NEEDS TO BE
043165,000118:                                                                                          	#       CODED ONLY ONCE FOR THE APPLICABLE DOWNLINK LISTS.
043166,000119:                                                                                          	# 4.    SNAPSHOT SUBLISTS REFER SPECIFICALLY TO HOMOGENOUS DATA WHICH MUST BE
043167,000120:                                                                                          	#       SAVED IN A BUFFER DURING ONE DOWNRUPT.
043168,000121:                                                                                          	# 5.    THE 1DNADR FOR THE 1ST WORD OF SNAPSHOT DATA IS FOUND AT THE END
043169,000122:                                                                                          	#       OF EACH SNAPSHOT SUBLIST, SINCE THE PROGRAM CODING SENDS THIS DP WORD
043170,000123:                                                                                          	#       IMMEDIATELY AFTER STORING THE OTHERS IN THE SNAPSHOT BUFFER.
043171,000124:                                                                                          	# 6.    ALL LISTS ARE COMBINATIONS OF CODED ERASABLE ADDRESS CONSTANTS
043172,000125:                                                                                          	#       CREATED FOR THE DOWNLIST PROGRAM.
043173,000126:                                                                                          	#       A.      1DNADR                  1-WORD DOWNLIST ADDRESS.
043174,000127:                                                                                          	#               SAME AS ECADR, BUT USED WHEN THE WORD ADDRESSED IS THE LEFT
043175,000128:                                                                                          	#               HALF OF A DOUBLE-PRECISION WORD FOR DOWN TELEMETRY.
043176,000129:                                                                                          	#       B.      2DNADR - 6DNADR         N-WORD DOWNLIST ADDRESS, N = 2 - 6.
043177,000130:                                                                                          	#               SAME AS 1DNADR, BUT WITH THE 4 UNUSED BITS OF THE ECADR FORMAT
043178,000131:                                                                                          	#               FILLED IN WITH 0001-0101.  USED TO POINT TO A LIST OF N DOUBLE-
043179,000132:                                                                                          	#               PRECISION WORDS, STORED CONSECUTIVELY, FOR DOWN TELEMETRY.
043180,000133:                                                                                          	#       C.      DNCHAN                  DOWNLIST CHANNEL ADDRESS.
043181,000134:                                                                                          	#               SAME AS 1DNADR, BUT WITH PREFIX BITS 0111.  USED TO POINT TO
043182,000135:                                                                                          	#               A PAIR OF CHANNELS FOR DOWN TELEMETRY.
043183,000136:                                                                                          	#       D.      DNPTR                   DOWN TELEMETRY SUBLIST POINTER.
043184,000137:                                                                                          	#               SAME AS CAF BUT TAGGED AS A CONSTANT.  USED IN CONTROL LIST TO POINT TO A SUBLIST.
043185,000138:                                                                                          	#               CAUTION --- A DNPTR CANNOT BE USED IN A SUBLIST.
043186,000139:                                                                                          	# 7.    THE WORD ORDER CODE IS SET TO ZERO AT THE BEGINNING OF EACH DOWNLIST (I.E. CONTROL LIST) AND WHEN
043187,000140:                                                                                          	#       A '1DNADR TIME2' IS DETECTED IN THE CONTROL LIST (ONLY).
043188,000141:                                                                                          	# 8.    IN THE SNAPSHOT SUBLIST ONLY, THE DNADR'S CANNOT POINT TO THE FIRST WORD OF ANY EBANK.
043189,000142: 
043190,000143:                                                                                          	# DOWNLINK LIST RESTRICTIONS:
043191,000144:                                                                                          	# (THE FOLLOWING POINTS MAY BE LISTED ELSEWHERE BUT ARE LISTED HERE SO IT IS CLEAR THAT THESE THINGS CANNOT BE
043192,000145:                                                                                          	# DONE)
043193,000146:                                                                                          	# 1.    SNAPSHOT DOWNLIST:
043194,000147:                                                                                          	#       (A) CANNOT CONTAIN THE FOLLOWING ECADRS (I.E. 1DNADR'S): 0, 400, 1000, 1400, 2000, 2400, 3000, 3400.
043195,000148:                                                                                          	#       (B) CAN CONTAIN ONLY 1DNADR'S
043196,000149:                                                                                          	# 2.    ALL DOWNLINKED DATA (EXCEPT CHANNELS) IS PICKED UP BY A <DCA<SO DOWNLINK LISTS CANNOT CONTAIN THE
043197,000150:                                                                                          	#       EQUIVALENT OF THE FOLLOWING ECADRS (I.E. IDNADRS): 377, 777, 1377, 1777, 2377, 27777, 3377, 3777.
043198,000151:                                                                                          	#       (NOTE: THE TERM EQUIVALENT ' MEANT THAT THE IDNADR TO 6DNADR WILL BE PROCESSED LIKE 1 TO 6 ECADRS)
043199,000152:                                                                                          	# 3.    CONTROL LISTS AND SUBLISTS CANNOT HAVE ENTRIES = OCTAL 00000 OR OCTAL 77777
043201,000154:                                                                                          	# 4.    THE '1DNADR TIME2' WHICH WILL CAUSE THE DOWNLINK PROGRAM TO SET THE WORDER CODE TO 3 MUST APPEAR IN THE
043202,000155:                                                                                          	#       CONTROL SECTION OF THE DOWNLIST.
043203,000156:                                                                                          	# 5.    'DNCHAN 0' CANNOT BE USED.
043204,000157:                                                                                          	# 6.    'DNPTR 0' CANNOT BE USED.
043205,000158:                                                                                          	# 7.    DNPTR CANNOT APPEAR IN A SUBLIST.
043206,000159: 
043207,000160:                                                                                          	# EBANK SETTINGS
043208,000161:                                                                                          	#       IN THE PROCESS OF SETTING THE EBANK (WHEN PICKING UP DOWNLINK DATA) THE DOWN TELEMETRY PROGRAM PUTS
043209,000162:                                                                                          	#       'GARBAGE' INTO BITS15-12 OF EBANK.  HUGH BLAIR-SMITH WARNS US THAT BITS15-12 OF EBANK MAY BECOME
043210,000163:                                                                                          	#       SIGNIFICANT SOMEDAY IN THE FUTURE.  IF/WHEN THAT HAPPENS, THE PROGRAM SHOULD INSURE (BY MASKING ETC.)
043211,000164:                                                                                          	#       THAT BITS 15-12 OF EBANK ARE ZERO.
043212,000165: 
043213,000166:                                                                                          	# INITIALIZATION REQUIRED - TO INTERRUPT CURRENT LIST AND START A NEW ONE..
043214,000167:                                                                                          	#       1. ADRES OF DOWNLINK LIST INTO DNLSTADR
043215,000168:                                                                                          	#       2. NEGONE INTO SUBLIST
043216,000169:                                                                                          	#       3. NEGONE INTO DNECADR
043217,000170: 
043218,000171: 22,3711                                           BANK     22                            	#
043219,000172: 05,2000                                           SETLOC   DOWNTELM                      	#
043220,000173: 05,2000                                           BANK                                   	#
043221,000174: 
043222,000175: 05,3506     0340                                  EBANK=   DNTMBUFF                      	#
043223,000176: 
043224,000177: 05,3506                                           COUNT*   $$/DPROG                      	#
043225,000178: 05,3506           54016        DODOWNTM           TS       BANKRUPT                      	#
043226,000179: 05,3507           00006                           EXTEND                                 	#
043227,000180: 05,3510           22012                           QXCH     QRUPT                         	# SAVE Q
043228,000181: 05,3511           13763                           TCF      WOTEST                        	#
043229,000182: 05,3512           00006        WO1                EXTEND                                 	# SET WORD ORDER BIT TO 1 ONLY IF IT
043230,000183: 05,3513           05013                           WOR      CHAN13                        	# ALREADY ISN'T.
043231,000184: 05,3514           00335                           TC       DNTMGOTO                      	# GOTO APPROPRIATE PHASE OF PROGRAM
043232,000185: 
043233,000186: 05,3515           37747        DNPHASE1           CA       NEGONE                        	# INITIALIZE ALL CONTROL WORDS
043234,000187: 05,3516           54337                           TS       SUBLIST                       	# WORDS TO MINUS ONE
043235,000188: 05,3517           54336                           TS       DNECADR                       	#
043236,000189: 05,3520           33640                           CA       LDNPHAS2                      	# SET DNTMGOTO =O ALL SUBSEQUENT DOWNRUPTS
043237,000190: 05,3521           54335                           TS       DNTMGOTO                      	# GO TO DNPHASE2
043238,000191: 05,3522           13536                           TCF      NEWLIST                       	#
043239,000192: 05,3523           10336        DNPHASE2           CCS      DNECADR                       	# SENDING OF DATA IN PROGRESS
043240,000193: 05,3524           03653        DODNADR            TC       FETCH2WD                      	# YES - THEN FETCH THE NEXT 2 SP WORDS
043241,000194: 05,3525           77753        MINTIME2           -1DNADR  TIME2                         	# NEGATIVE OF TIME2 1DNADR
043242,000195: 05,3526           13527                           TCF      +1                            	# (ECADR OF 3776 + 74001 = 77777)
043243,000196: 
043244,000197: 05,3527           10337                           CCS      SUBLIST                       	# IS THE SUBLIST IN CONTROL
043245,000198: 05,3530           13666                           TCF      NEXTINSL                      	# YES
043247,000200: 05,3531           74001        DNADRDCR           OCT      74001                         	# DNADR COUNT AND ECADR DECREMENTER
043248,000201: 
043249,000202: 05,3532           30334        CHKLIST            CA       CTLIST                        	#
043250,000203: 05,3533           00006                           EXTEND                                 	#
043251,000204: 05,3534           63536                           BZMF     NEWLIST                       	# IT WILL BE NEGATIVE AT END OF LIST
043252,000205: 05,3535           13543                           TCF      NEXTINCL                      	#
043253,000206: 05,3536           50332        NEWLIST            INDEX    DNLSTCOD                      	#
043254,000207: 05,3537           32441                           CA       DNTABLE                       	# INITIALIZE CTLIST WITH
043255,000208: 05,3540           54334                           TS       CTLIST                        	#       STARTING ADDRESS OF NEW LIST
043256,000209: 05,3541           40332                           CS       DNLSTCOD                      	#
043257,000210: 05,3542           13756                           TCF      SENDID     +3                 	#
043258,000211: 05,3543           50334        NEXTINCL           INDEX    CTLIST                        	#
043259,000212: 05,3544           30000                           CA       0                             	#
043260,000213: 05,3545           10000                           CCS      A                             	#
043261,000214: 05,3546           24334                           INCR     CTLIST                        	# SET POINTER TO PICK UP NEXT CTLIST WORD
043262,000215: 05,3547           13553                           TCF      +4                            	# ON NEXT ENTRY TO PROG.  (A SHOULD NOT =0)
043263,000216: 05,3550           56334                           XCH      CTLIST                        	# SET CTLIST TO NEGATIVE AND PLACE(CODING)
043264,000217: 05,3551           40000                           COM                                    	# UNCOMPLEMENTED DNADR INTO A.    (FOR LA)
043265,000218: 05,3552           56334                           XCH      CTLIST                        	#                                 (ST IN )
043266,000219: 05,3553           24000                 +4        INCR     A                             	#                                 (CTLIST)
043267,000220: 05,3554           54336                           TS       DNECADR                       	# SAVE DNADR
043268,000221: 05,3555           63525                           AD       MINTIME2                      	# TEST FOR TIME2 (NEG. OF ECADR)
043269,000222: 05,3556           10000                           CCS      A                             	#
043270,000223: 05,3557           13563                           TCF      SETWO      +1                 	# DON'T SET WORD ORDER CODE
043271,000224: 05,3560           47777        MINB1314           OCT      47777                         	# MINUS BIT 13 AND 14 (CAN'T GET HERE)
043272,000225: 05,3561           13563                           TCF      SETWO      +1                 	# DON'T SET WORD ORDER CODE
043273,000226: 05,3562           03605        SETWO              TC       WOZERO                        	# GO SET WORD ORDER CODE TO ZERO.
043274,000227: 05,3563           30336                 +1        CA       DNECADR                       	# RELOAD A WITH THE DNADR.
043275,000228: 05,3564           63560                 +2        AD       MINB1314                      	# IS THIS A REGULAR DNADR?
043276,000229: 05,3565           00006                           EXTEND                                 	#
043277,000230: 05,3566           63653                           BZMF     FETCH2WD                      	# YES.  (A MUST NEVER BE ZERO)
043278,000231: 05,3567           67741                           AD       MINB12                        	# NO- IS IT A POINTER (DNPTR) OR A
043279,000232: 05,3570           00006                           EXTEND                                 	#     CHANNEL(DNCHAN)
043280,000233: 05,3571           63611                           BZMF     DODNPTR                       	# IT'S A POINTER.  (A MUST NEVER BE ZERO)
043281,000234: 
043282,000235: 05,3572           00006        DODNCHAN           TC       6                             	# (EXECUTED AS EXTEND)  IT S A CHANNEL
043283,000236: 05,3573           50336                           INDEX    DNECADR                       	#
043284,000237: 05,3574           44000                           INDEX    0          -4000              	# (EXECUTED AS READ)
043285,000238: 05,3575           54001                           TS       L                             	#
043286,000239: 05,3576           00006                           TC       6                             	# (EXECUTED AS EXTEND)
043287,000240: 05,3577           50336                           INDEX    DNECADR                       	#
043288,000241: 05,3600           43777                           INDEX    0          -4001              	# (EXECUTED AS READ)
043289,000242: 05,3601           54336                           TS       DNECADR                       	# SET DNECADR
043290,000243: 05,3602           37747                           CA       NEGONE                        	#       TO MINUS
043291,000244: 05,3603           56336                           XCH      DNECADR                       	#               WHILE PRESERVING A.
043292,000245: 05,3604           13701                           TCF      DNTMEXIT                      	# GO SEND CHANNELS
043293,000246: 
043294,000247: 05,3605           44745        WOZERO             CS       BIT7                          	#
043295,000248: 05,3606           00006                           EXTEND                                 	#
043296,000249: 05,3607           03013                           WAND     CHAN13                        	# SET WORD ORDER CODE TO ZERO
043298,000251: 05,3610           00002                           TC       Q                             	# RETURN TO CALLER
043299,000252: 
043300,000253: 05,3611           50336        DODNPTR            INDEX    DNECADR                       	# DNECADR CONTAINS ADRES OF SUBLIST
043301,000254: 05,3612           00000                           0        0                             	# CLEAR AND ADD LIST ENTRY INTO A.
043302,000255: 05,3613           10000                           CCS      A                             	# IS THIS A SNAPSHOT SUBLIST
043303,000256: 05,3614           30336                           CA       DNECADR                       	# NO, IT IS A REGULAR SUBLIST.
043304,000257: 05,3615           13665                           TCF      DOSUBLST                      	# A MUST NOT BE ZERO.
043305,000258: 
043306,000259: 05,3616           56336                           XCH      DNECADR                       	# YES, IT IS A SNAPSHOT SUBLIST.
043307,000260: 05,3617           54337                           TS       SUBLIST                       	# C(DNECADR) INTO SUBLIST
043308,000261: 05,3620           34755                           CAF      ZERO                          	#       A    INTO     A
043309,000262: 05,3621           56336                           XCH      TMINDEX                       	# (NOTE..  TMINDEX = DNECADR)
043310,000263: 
043311,000264:                                                                                          	# THE FOLLOWING CODING (FROM SNAPLOOP TO SNAPEND) IS FOR THE PURPOSE OF TAKING A SNAPSHOT OF 12 DP REGISTERS.
043312,000265:                                                                                          	# THIS IS DONE BY SAVING 11 DP REGISTERS IN DNTMBUFF AND SENDING THE FIRST DP WORD IMMEDIATELY.
043313,000266:                                                                                          	# THE SNAPSHOT PROCESSING IS THE MOST TIME CONSUMING AND THEREFORE THE CODING AND LIST STRUCTURE WERE DESIGNED
043314,000267:                                                                                          	# TO MINIMIZE TIME.  THE TIME OPTIMIZATION RESULTS IN RULES UNIQUE TO THE SNAPSHOT PORTION OF THE DOWNLIST.
043315,000268:                                                                                          	# THESE RULES ARE ......
043316,000269:                                                                                          	#       1.      ONLY 1DNADR'S CAN APPEAR IN THE SNAPSHOT SUBLIST
043317,000270:                                                                                          	#       2.      THE 1DNADR'S CANNOT REFER TO THE FIRST LOCATION IN ANY BANK.
043318,000271: 
043319,000272: 05,3622           54003        SNAPLOOP           TS       EBANK                         	# SET EBANK
043320,000273: 05,3623           74357                           MASK     LOW8                          	# ISOLATE RELATIVE ADDRESS
043321,000274: 05,3624           00006                           EXTEND                                 	#
043322,000275: 05,3625           50000                           INDEX    A                             	#
043323,000276: 05,3626  E3,1401                                  EBANK=   1401                          	#
043324,000277: 05,3626           31402                           DCA      1401                          	# PICK UP 2 SNAPSHOT WORDS.
043325,000278: 05,3627     0340                                  EBANK=   DNTMBUFF                      	#
043326,000279: 05,3627           50336                           INDEX    TMINDEX                       	#
043327,000280: 05,3630           52341                           DXCH     DNTMBUFF                      	# STORE 2 SNAPSHOT WORDS IN BUFFER
043328,000281: 05,3631           24336                           INCR     TMINDEX                       	# SET BUFFER INDEX FOR NEXT 2 WORDS.
043329,000282: 05,3632           24336                           INCR     TMINDEX                       	#
043330,000283: 05,3633           24337        SNAPAGN            INCR     SUBLIST                       	# SET POINTER TO NEXT 2 WORDS OF SNAPSHOT
043331,000284: 05,3634           50337                           INDEX    SUBLIST                       	#
043332,000285: 05,3635           00000                           0        0                             	# = CA SSSS (SSSS = NEXT ENTRY IN SUBLIST)
043333,000286: 05,3636           10000                           CCS      A                             	# TEST FOR LAST TWO WORDS OF SNAPSHOT.
043334,000287: 05,3637           13622                           TCF      SNAPLOOP                      	# NOT LAST TWO.
043335,000288: 05,3640           03523        LDNPHAS2           GENADR   DNPHASE2                      	#
043336,000289: 05,3641           54337                           TS       SUBLIST                       	# YES, LAST.  SAVE A.
043337,000290: 05,3642           37747                           CA       NEGONE                        	# SET DNECADR AND
043338,000291: 05,3643           54336                           TS       DNECADR                       	#       SUBLIST POINTERS
043339,000292: 05,3644           56337                           XCH      SUBLIST                       	#               TO NEGATIVE VALUES.
043340,000293: 05,3645           54003                           TS       EBANK                         	#
043341,000294: 05,3646           74357                           MASK     LOW8                          	#
043342,000295: 05,3647           00006                           EXTEND                                 	#
043343,000296: 05,3650           50000                           INDEX    A                             	#
043344,000297: 05,3651  E3,1401                                  EBANK=   1401                          	#
043345,000298: 05,3651           31402                           DCA      1401                          	# PICK UP FIRST 2 WORDS OF SNAPSHOT.
043347,000300: 05,3652     0340                                  EBANK=   DNTMBUFF                      	#
043348,000301: 05,3652           13701        SNAPEND            TCF      DNTMEXIT                      	# NOW GO SEND THEM.
043349,000302: 
043350,000303: 05,3653           30336        FETCH2WD           CA       DNECADR                       	#
043351,000304: 05,3654           54003                           TS       EBANK                         	# SET EBANK
043352,000305: 05,3655           74357                           MASK     LOW8                          	# ISOLATE RELATIVE ADDRESS
043353,000306: 05,3656           54001                           TS       L                             	#
043354,000307: 05,3657           33531                           CA       DNADRDCR                      	# DECREMENT COUNT AND ECADR
043355,000308: 05,3660           26336                           ADS      DNECADR                       	#
043356,000309: 05,3661           00006                           EXTEND                                 	#
043357,000310: 05,3662           50001                           INDEX    L                             	#
043358,000311: 05,3663  E3,1400                                  EBANK=   1400                          	#
043359,000312: 05,3663           31401                           DCA      1400                          	# PICK UP 2 DATA WORDS
043360,000313: 05,3664     0340                                  EBANK=   DNTMBUFF                      	#
043361,000314: 05,3664           13701                           TCF      DNTMEXIT                      	# NOW GO SEND THEM.
043362,000315: 
043363,000316: 05,3665           54337        DOSUBLST           TS       SUBLIST                       	# SET SUBLIST POINTER
043364,000317: 05,3666           50337        NEXTINSL           INDEX    SUBLIST                       	#
043365,000318: 05,3667           00000                           0        0                             	# = CA SSSS (SSSS = NEXT ENTRY IN SUBLIST)
043366,000319: 05,3670           10000                           CCS      A                             	# IS IT THE END OF THE SUBLIST
043367,000320: 05,3671           24337                           INCR     SUBLIST                       	# NO -
043368,000321: 05,3672           13676                           TCF      +4                            	#
043369,000322: 05,3673           54337                           TS       SUBLIST                       	# SAVE A.
043370,000323: 05,3674           37747                           CA       NEGONE                        	# SET SUBLIST TO MINUS
043371,000324: 05,3675           56337                           XCH      SUBLIST                       	# RETRIEVE A.
043372,000325: 05,3676           24000                 +4        INCR     A                             	#
043373,000326: 05,3677           54336                           TS       DNECADR                       	# SAVE DNADR
043374,000327: 05,3700           13564                           TCF      SETWO      +2                 	# GO USE COMMON CODING (PROBLEMS WOULD
043375,000328:                                                                                          	# OCCUR IF THE PROGRAM ENCOUNTERED A
043376,000329:                                                                                          	# DNPTR NOW)
043377,000330: 
043378,000331: 05,3701           00006        DNTMEXIT           EXTEND                                 	# DOWN-TELEMETRY EXIT
043379,000332: 05,3702           01034                           WRITE    DNTM1                         	# TO SEND A + L TO CHANNELS 34 + 35
043380,000333: 05,3703           30001                           CA       L                             	# RESPECTIVELY
043381,000334: 05,3704           00006        TMEXITL            EXTEND                                 	#
043382,000335: 05,3705           01035                           WRITE    DNTM2                         	#
043383,000336: 05,3706           15270        TMRESUME           TCF      RESUME                        	# EXIT TELEMETRY PROGRAM VIA RESUME.
043384,000337: 
043385,000338: 05,3707     7741               MINB12             EQUALS   -1/8                          	#
043386,000339: 05,3707     0336               DNECADR            EQUALS   TMINDEX                       	#
043387,000340: 05,3707     0334               CTLIST             EQUALS   LDATALST                      	#
043388,000341: 05,3707     0337               SUBLIST            EQUALS   DNQ                           	#
043389,000342: 
043391,000344:                                                                                          	# SUBROUTINE NAME - DNDUMP
043392,000345: 
043393,000346:                                                                                          	# FUNCTIONAL DESCRIPTION - TO SEND (DUMP) ALL ERASABLE STORAGE 'N' TIMES. (N=1 TO 4).  BANKS ARE SENT ONE AT A TIME
043394,000347:                                                                                          	#       EACH BANK IS PRECEEDED BY AN ID WORD, SYNCH BITS, ECADR AND TIME1 FOLLOWED BY THE 256D WORDS OF EACH
043395,000348:                                                                                          	#       EBANK.  EBANKS ARE DUMPED IN ORDER (I.E. EBANK 0 FIRST, THEN EBANK1 ETC.)
043396,000349: 
043397,000350:                                                                                          	# CALLING SEQUENCE - THE GROUND OR ASTRONAUT BY KEYING V74E CAN INITIALIZE THE DUMP.
043398,000351:                                                                                          	#       AFTER KEYING IN V74E THE CURRENT DOWNLIST WILL BE IMMEDIATELY TERMINATED AND THE DOWNLINK ERASABLE DUMP
043399,000352:                                                                                          	#       WILL BEGIN.
043400,000353: 
043401,000354:                                                                                          	#       ONCE INITIATED THE DOWNLINK ERASABLE DUMP CAN BE TERMINATED (AND INTERRUPTED DOWNLIST REINSTATED) ONLY
043402,000355:                                                                                          	#       BY THE FOLLOWING:
043403,000356: 
043404,000357:                                                                                          	#       1.      A FRESH START
043405,000358:                                                                                          	#       2.      COMPLETION OF ALL DOWNLINK DUMPS REQUESTED (ACCORDING TO BITS SET IN DUMPCNT).  NOTE THAT DUMPCNT
043406,000359:                                                                                          	#               CAN BE ALTERED BY A V21N01.
043407,000360:                                                                                          	#       3.      AND INVOLUNTARILY BY A RESTART.
043408,000361: 
043409,000362:                                                                                          	# NORMAL EXIT MODE - TCF DNPHASE1
043410,000363: 
043411,000364:                                                                                          	# ALARM OR ABORT MODE - NONE
043412,000365: 
043413,000366:                                                                                          	# *SUBROUTINES CALLED - NONE.
043414,000367: 
043415,000368:                                                                                          	# ERASABLE INITIALIZATION REQUIRED -
043416,000369:                                                                                          	#       DUMPCNT         OCT 20000       IF 4 COMPLETE ERASABLE DUMPS ARE DESIRED
043417,000370:                                                                                          	#       DUMPCNT         OCT 10000       IF 2 COMPLETE ERASABLE DUMPS ARE DESIRED
043418,000371:                                                                                          	#       DUMPCNT         OCT 04000       IF 1 COMPLETE ERASABLE DUMP  IS  DESIRED
043419,000372: 
043420,000373:                                                                                          	# DEBRIS - DUMPLOC, DUMPSW, DNTMGOTO, EBANK AND CENTRAL REGISTERS
043421,000374: 
043422,000375:                                                                                          	# TIMING -      TIME (IN SECS) = ((NO.DUMPS)*(NO.EBANKS)*(WDSPEREBANK + NO.IDWDS)) / NO.WDSPERSEC
043423,000376:                                                                                          	#               TIME (IN SECS) =  (   4    )*(    8    )*(    256     +     4   )  /     100
043424,000377:                                                                                          	#               THUS TIME (IN SECS TO SEND DUMP OF ERASABLE 4 TIMES VIA DOWNLINK) = 83.2 SECONDS
043425,000378: 
043426,000379:                                                                                          	# STRUCTURE OF ONE EBANK AS IT IS SENT BY DOWNLINK PROGRAM -
043427,000380:                                                                                          	#       (REMINDER - THIS ONLY DESCRIBES ONE OF THE 8 EBANKS X 4 (DUMPS) = 32 EBANKS WHICH WILL BE SENT BY DNDUMP)
043428,000381:                                                                                          	#       DOWNLIST                                W
043429,000382:                                                                                          	#         WORD  TAKEN FROM CONTENTS OF  EXAMPLE O       COMMENTS
043430,000383:                                                                                          	#           1   ERASID                   0177X  0       DOWNLIST I.D. FOR DOWNLINK ERASABLE DUMP (X=7 CSM, 6 LM)
043431,000384:                                                                                          	#           2   LOWIDCOD                 77340  1       DOWNLINK SYNCH BITS.  (SAME ONE USED IN ALL OTHER DOWNLISTS)
043432,000385:                                                                                          	#           3   DUMPLOC                  13400  1       (SEE NOTES ON DUMPLOC) 1 = 3RD ERAS DUMP, 3400=ECADR OF 5TH WD
043433,000386:                                                                                          	#           4   TIME1                    14120  1       TIME IN CENTISECONDS
043434,000387:                                                                                          	#           5   FIRST WORD OF EBANK X    03400  1       IN THIS EXAMPLE THIS WORD = CONTENTS OF E7,1400 (ECADR 3400)
043435,000388:                                                                                          	#           6   2ND   WORD OF EBANK X    00142  1       IN THIS EXAMPLE THIS WORD = CONTENTS OF E7,1401 (ECADR 3401)
043436,000389:                                                                                          	#           7   3RD   WORD OF EBANK X    00142  1       IN THIS EXAMPLE THIS WORD = CONTENTS OF E7,1402 (ECADR 3402)
043437,000390:                                                                                          	#           .                                   1
043438,000391:                                                                                          	#           .                                   1
043439,000392:                                                                                          	#           .                                   1
043440,000393:                                                                                          	#        260D   256TH WORD OF EBANK X    03777  1       IN THIS EXAMPLE THIS WORD = CONTENTS OF E7,1777 (ECADR 3777)
043441,000394: 
043442,000395:                                                                                          	# NOTE -        DUMPLOC CONTAINS THE COUNTER AND ECADR FOR EACH WORD BEING SENT.
043443,000396:                                                                                          	#               THE BIT STRUCTURE OF DUMPLOC IS FOLLOWS---
043444,000397:                                                                                          	#                                               X = NOT USED
043445,000398:                                                                                          	#               X ABC EEE RRRRRRRR            ABC = ERASABLE DUMP COUNTER (I.E. ABC = 0,1,2 OR 3 WHICH MEANS THAT
043446,000399:                                                                                          	#                                                   COMPLETE ERASABLE DUMP NUMBER 1,2,3 OR 4 RESPECTIVELY IS IN PROGRESS)
043447,000400:                                                                                          	#                                             EEE = EBANK BITS
043448,000401:                                                                                          	#                                        RRRRRRRR = RELATIVE ADDRESS WITHIN AN EBANK.
043449,000402: 
043451,000404: 05,3707           34755        DNDUMPI            CA       ZERO                          	# INITIALIZE DOWNLINK
043452,000405: 05,3710           54336                           TS       DUMPLOC                       	# ERASABLE DUMP
043453,000406: 05,3711           03753                 +2        TC       SENDID                        	# GO SEND ID AND SYNCH BITS
043454,000407: 05,3712           33721                           CA       LDNDUMP1                      	# SET DNTMGOTO
043455,000408: 05,3713           54335                           TS       DNTMGOTO                      	# TO LOCATION FOR NEXT PASS
043456,000409: 05,3714           30025                           CA       TIME1                         	# PLACE TIME1
043457,000410: 05,3715           56001                           XCH      L                             	# INTO L
043458,000411: 05,3716           30336                           CA       DUMPLOC                       	# AND ECADR OF THIS EBANK INTO A
043459,000412: 05,3717           13701                           TCF      DNTMEXIT                      	# SEND DUMPLOC AND TIME1
043460,000413: 
043461,000414: 05,3720           03722        LDNDUMP            ADRES    DNDUMP                        	#
043462,000415: 05,3721           03735        LDNDUMP1           ADRES    DNDUMP1                       	#
043463,000416: 
043464,000417: 05,3722           34752        DNDUMP             CA       TWO                           	# INCREMENT ECADR IN DUMPLOC
043465,000418: 05,3723           26336                           ADS      DUMPLOC                       	# TO NEXT DP WORD TO BE
043466,000419: 05,3724           74357                           MASK     LOW8                          	# DUMPED AND SAVE IT.
043467,000420: 05,3725           10000                           CCS      A                             	# IS THIS THE BEGINNING OF A NEW EBANK
043468,000421: 05,3726           13737                           TCF      DNDUMP2                       	# NO - THEN CONTINUE DUMPING
043469,000422: 05,3727           30336                           CA       DUMPLOC                       	# YES - IS THIS THE END OF THE
043470,000423: 05,3730           70333                           MASK     DUMPCNT                       	# N TH (N = 1 TO 4) COMPLETE ERASABLE
043471,000424: 05,3731           77722                           MASK     PRIO34                        	# DUMP (BIT14 FOR 4, BIT13 FOR 2 OR BIT12
043472,000425: 05,3732           10000                           CCS      A                             	# FOR 1 COMPLETE ERASABLE DUMP(S)).
043473,000426: 05,3733           13515                           TCF      DNPHASE1                      	# YES - START SENDING INTERRUPTED DOWNLIST
043474,000427:                                                                                          	# AGAIN
043475,000428: 05,3734           13711                           TCF      DNDUMPI    +2                 	# NO - GO BACK AND INITIALIZE NEXT BANK
043476,000429: 
043477,000430: 05,3735           33720        DNDUMP1            CA       LDNDUMP                       	# SET DNTMGOTO
043478,000431: 05,3736           54335                           TS       DNTMGOTO                      	# FOR WORDS 3 TO 256D OF CURRENT EBANK
043479,000432: 
043480,000433: 05,3737           30336        DNDUMP2            CA       DUMPLOC                       	#
043481,000434: 05,3740           54003                           TS       EBANK                         	# SET EBANK
043482,000435: 05,3741           74357                           MASK     LOW8                          	# ISOLATE RELATIVE ADDRESS.
043483,000436: 05,3742           54002                           TS       Q                             	# (NOTE: MASK INSTRUCTION IS USED TO PICK
043484,000437: 05,3743           34754                           CA       NEG0                          	# UP ERASABLE REGISTERS SO THAT EDITING
043485,000438: 05,3744           54001                           TS       L                             	# REGISTERS 20-23 WILL NOT BE ALTERED.)
043486,000439: 05,3745           50002                           INDEX    Q                             	#
043487,000440: 05,3746  E3,1400                                  EBANK=   1400                          	# PICK UP LOW ORDER REGISTER OF PAIR
043488,000441: 05,3746           71401                           MASK     1401                          	# OF ERASABLE REGISTERS.
043489,000442: 05,3747           56001                           XCH      L                             	#
043490,000443: 05,3750           50002                           INDEX    Q                             	# PICK UP HIGH ORDER REGISTER OF PAIR
043491,000444: 05,3751           71400                           MASK     1400                          	# OF ERASABLE REGISTERS.
043492,000445: 05,3752     0340                                  EBANK=   DNTMBUFF                      	#
043493,000446: 05,3752           13701                           TCF      DNTMEXIT                      	# GO SEND THEM
043494,000447: 
043495,000448: 05,3753           00006        SENDID             EXTEND                                 	# ** ENTRANCE USED BY ERASABLE DUMP PROG.**
043496,000449: 05,3754           22335                           QXCH     DNTMGOTO                      	# SET DNTMGOTO SO NEXT TIME PROG WILL GO
043497,000450: 05,3755           35011                           CAF      ERASID                        	# TO LOCATION FOLLOWING :TC SENDID:
043498,000451: 
043499,000452: 05,3756           54001                           TS       L                             	# ** ENTRANCE USED BY REGULAR DOWNLINK PG **
043501,000454: 05,3757           03605                           TC       WOZERO                        	# GO SET WORD ORDER CODE TO ZERO
043502,000455: 05,3760           32065                           CAF      LOWIDCOD                      	# PLACE SPECIAL ID CODE INTO L
043503,000456: 05,3761           56001                           XCH      L                             	# AND ID BACK INTO A
043504,000457: 05,3762           13701                           TCF      DNTMEXIT                      	# SEND DOWNLIST ID CODE(S).
043505,000458: 
043506,000459: 05,3763           34745        WOTEST             CA       BIT7                          	# AT THE BEGINNING OF THE LIST THE WORD
043507,000460: 05,3764           00006                           EXTEND                                 	# ORDER BIT WILL BE SET BACK TO ZERO
043508,000461: 05,3765           02013                           RAND     CHAN13                        	#
043509,000462: 05,3766           10000                           CCS      A                             	#
043510,000463: 05,3767           00335                           TC       DNTMGOTO                      	#
043511,000464: 05,3770           34745                           CA       BIT7                          	#
043512,000465: 05,3771           13512                           TCF      WO1                           	#
043513,000466: 
(End of include-file DOWN-TELEMETRY_PROGRAM.agc, resuming MAIN.agc)

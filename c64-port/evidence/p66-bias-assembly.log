022734,001538:                                                                                          	# PROGRAM NAME_ SETTRKF                                                         . IF EITHER:
022735,001539: 
022736,001540:                                                                                          	# FUNCTIONAL DESCRIPTION_
022737,001541:                                                                                          	#       SETTRKF UPDATES THE TRACKER FAIL LAMP ON THE DSKY.                      HER THE ALT OR VEL INFORMATION.
022738,001542:                                                                                          	#       INITIALLY THE LAMP TEST FLAG (IMODES33 BIT 1) IS CHECKED.
022739,001543:                                                                                          	#       IF A LAMP TEST IS IN PROGRESS, THE PROGRAM EXITS TO L +1.
022740,001544:                                                                                          	#       IF NO LAMP TEST THE FOLLOWING IS CHECKED SEQUENTIALLY_
022741,001545:                                                                                          	#               1) RR CDU:S BEING ZEROED, RR CDU OK, AND RR NOT IN
022742,001546:                                                                                          	#                  AUTO MODE (RADMODES BITS 13, 7, 2).
022743,001547:                                                                                          	#               2) LR VEL DATA FAIL AND NO LR POS DATA (RADMODES BITS
022744,001548:                                                                                          	#                  8,5)
022745,001549:                                                                                          	#               3) NO RR DATA (RADMODES BIT 4)
022746,001550:                                                                                          	#       THE ABSENCE OF ALL THREE SIMULTANEOUSLY IN (1), THE PRESENCE OF BOTH
022747,001551:                                                                                          	#       IN (2), AND THE PRESENCE OF (3) RESULTS IN EITHER THE TRACKER FAIL
022748,001552:                                                                                          	#       LAMP (DSPTAB +11D BIT 8) BEING TURNED ON OR LEFT ON. OTHERWISE,
022749,001553:                                                                                          	#       THE TRACKER FAIL LAMP IS TURNED OFF OR IS LEFT OFF. THEREFORE, THE
022750,001554:                                                                                          	#       TRACKER FAIL LAMP IS TURNED ON IF_
022751,001555:                                                                                          	#               A) RR CDU FAILED WITH RR IN AUTO MODE AND RR CDU:S NOT BEING ZEROED.
022752,001556:                                                                                          	#               B) N SAMPLES OF LR DATA COULD NOT BE TAKEN IN 2N TRIES WITH
022753,001557:                                                                                          	#                  EITHER THE ALT OR VEL INFORMATION
022754,001558:                                                                                          	#               C) N SAMPLES OF RR DATA COULD NOT BE OBTAINED FROM 2N TRIES
022755,001559:                                                                                          	#                  WITH EITHER THE AL
022756,001560: 

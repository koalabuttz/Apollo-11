063854,000308:                                                                                          	# SUBROUTINE TIMEGMBL:  MOD 0, OCTOBER 1967, CRAIG WORK
063855,000309: 
063856,000310:                                                                                          	# TIMEGMBL COMPUTES THE DRIVE TIME NEEDED FOR THE TRIM GIMBAL TO POSITION THE DESCENT ENGINE NOZZLE SO AS TO NULL
063857,000311:                                                                                          	# THE OFFSET ANGULAR ACCELERATION ABOUT THE Q (OR R) AXIS.  INSTEAD OF USING AOSQ(R), TIMEGMBL USES .4*AOSQ(R),
063858,000312:                                                                                          	# SCALED AT PI/8.  FOR EACH AXIS, THE DRIVE TIME IS COMPUTED AS ABS(ALPHA/ACCDOT).  A ZERO
063859,000313:                                                                                          	# ALPHA OR ACCDOT OR A ZERO QUOTIENT TURNS OFF THE GIMBAL DRIVE IMMEDIATELY.  OTHERWISE, THE GIMBAL IS TURNED ON
063860,000314:                                                                                          	# DRIVING IN THE CORRECT DIRECTION.  THE Q(R)GIMTIMR IS SET TO TERMINATE THE DRIVE AND Q(R)ACCDOT
063861,000315:                                                                                          	# IS STORED TO REFLECT THE NEW ACCELERATION DERIVATIVE.  NEGUQ(R) WILL CONTAIN +1,+0,-1 FOR A Q(R)ACCDOT VALUE
063862,000316:                                                                                          	# WHICH IS NEGATIVE, ZERO, OR POSITIVE.
063863,000317: 
063864,000318:                                                                                          	# INPUTS:       AOSQ,AOSR, SCALED AT P1/2, AND ACCDOTQ, ACCDOTR AT PI/2(7).     PI/2(7).
063865,000319: 
063866,000320:                                                                                          	# OUTPUTS:      NEW GIMBAL DRIVE BITS IN CHANNEL 12, NEGUQ, NEGUR, QACCDOT AND RACCDOT, THE LAST SCALED AT PI/2(7).
063867,000321:                                                                                          	#               Q(R)GIMTIMR WILL BE SET TO TIME AND TERMINATE GIMBAL DRIVE(S)
063868,000322: 
063869,000323:                                                                                          	# DEBRIS:       A, L, Q, ITEMPS 2, 3, 6, RUPTREG2 AND ACDT+C12 DEBRIS.
063870,000324: 
063871,000325:                                                                                          	# EXITS:        VIA TC Q.
063872,000326: 
063873,000327:                                                                                          	# ALARMS, ABORTS, :  NONE
063874,000328: 
063875,000329:                                                                                          	# SUBROUTINES:  ACDT+C12, IBNKCALL
063876,000330: 
063877,000331:                                                                                          	# WARNING:      THIS SUBROUTINE WRITES INTO CHANNEL 12 AND USES THE ITEMPS.  THEREFORE IT MAY ONLY BE CALLED WITH
063878,000332:                                                                                          	#               INTERRUPT INHIBITED.
063879,000333: 
063880,000334:                                                                                          	# ERASABLE STORAGE CONFIGURATION (NEEDED BY THE INDEXING METHODS):
063881,000335:                                                                                          	#       NEGUQ           ERASE   +2              NEGATIVE OF Q-AXIS GIMBAL DRIVE
063882,000336:                                                                                          	#       (SPWORD)        EQUALS  NEGUQ +1        ANY S.P. ERASABLE NUMBER, NOW THRSTCMD
063883,000337:                                                                                          	#       NEGUR           EQUALS  NEGUQ +2        NEGATIVE OF R-AXIS GIMBAL DRIVE
063884,000338:                                                                                          	#       ACCDOTQ         ERASE   +2              Q-JERK TERM SCALED AT PI/2(7) RAD/SEC(3)
063885,000339:                                                                                          	#       (SPWORD)        EQUALS  ACCDOTQ +1      ANY S.P. ERASABLE NUMBER NOW QACCDOT
063886,000340:                                                                                          	#       ACCDOTR         EQUALS  ACCDOTQ +2      R-JERK TERM SCALED AT PI/2(7) RAD/SEC(3)
063887,000341:                                                                                          	#                                               ACCDOTQ, ACCDOTR ARE MAGNITUDES.
063888,000342:                                                                                          	#       AOSQ            ERASE   +4              Q-AXIS ACC., D.P. AT PI/2 R/SEC(2)
063889,000343:                                                                                          	#       AOSR            EQUALS  AOSQ +2         R-AXIS ACCELERATION SCALED AT PI/2 R/S2
063890,000344: 
063891,000345: 21,3327     0066               QRNDXER            EQUALS   ITEMP6                        	#

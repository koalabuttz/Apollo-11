062946,000032:                                                                                          	##
062947,000033:                                                                                          	## Notations on the hardcopy document read, in part:
062948,000034:                                                                                          	##
062949,000035:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
062950,000036:                                                                                          	##      16:27 JULY 14, 1969 
062951,000037: 
062953,000039:                                                                                          	# PROGRAM DESCRIPTION
062954,000040:                                                                                          	# DESIGNED BY:  R. D. GOSS AND P. S. WEISSMAN
062955,000041:                                                                                          	# CODED BY:  P. S. WEISSMAN 28 FEBRUARY 1968
062956,000042: 
062957,000043:                                                                                          	# TJETLAW IS CALLED AS A SUBROUTINE WHEN THE LEM IS NOT DOCKED AND THE AUTOPILOT IS IN THE AUTOMATIC OR
062958,000044:                                                                                          	# ATTITUDE-HOLD MODE TO CALCULATE THE JET-FIRING-TIME (TJET) REQUIRED FOR THE AXIS INDICATED BY AXISCTR:
062959,000045:                                                                                          	#       -1      INDICATES THE P-AXIS
062960,000046:                                                                                          	#       +0      INDICATES THE U-AXIS
062961,000047:                                                                                          	#       +1      INDICATES THE V-AXIS.
062962,000048:                                                                                          	# THE REGISTERS E AND EDOT CONTAIN THE APPROPRIATE ATTITUDE ERROR AND ERROR RATE AND SENSETYP SHOWS WHETHER
062963,000049:                                                                                          	# UNBALANCED COUPLES ARE PREFERRED.  TJETLAW ALSO USES VARIOUS FUNCTIONS OF ACCELERATION AND DEADBAND WHICH ARE
062964,000050:                                                                                          	# COMPUTED IN THE 1/ACCONT SECTION OF 1/ACCS AND ARE STORED IN SUCH AN ORDER THAT THEY CAN BE CONVENIENTLY
062965,000051:                                                                                          	# ACCESSED BY INDEXING.
062966,000052: 
062967,000053:                                                                                          	# THE SIGN OF THE REQUIRED ROTATION IS CARRIED THROUGH TJETLAW AS ROTSENSE AND IS FINALLY APPLIED TO TJET JUST
062968,000054:                                                                                          	# PREVIOUS TO ITS STORAGE IN THE LOCATION CORRESPONDING TO THE AXIS (TJP, TJU OR TJV).  THE NUMBER OF JETS THAT
062969,000055:                                                                                          	# TJETLAW ASSUMES WILL BE USED IS INDICATED BY THE SETTING OF NUMBERT FOR THE U- OR V-AXIS.  TWO JETS ARE ALWAYS
062970,000056:                                                                                          	# ASSUMED FOR THE P-AXIS ALTHOUGH FOUR JETS WILL BE FIRED WHEN FIREFCT IS MORE NEGATIVE THAN -4.0 DEGREES
062971,000057:                                                                                          	# (FIREFCT IS THE DISTANCE TO A SWITCH CURVE IN THE PHASE PLANE) AND A LONG FIRING IS CALLED FOR.
062972,000058: 
062973,000059:                                                                                          	# IN ORDER TO AVOID SCALING DIFFICULTIES, SIMPLE ALGORITHMS TAGGED RUFLAW1, -2 AND -3 ARE RESORTED TO WHEN THE
062974,000060:                                                                                          	# ERROR AND/OR ERROR RATE ARE LARGE.
062975,000061: 
062976,000062:                                                                                          	# CALLING SEQUENCE:
062977,000063:                                                                                          	#               TC      TJETLAW         (MUST BE IN JASK)
062978,000064:                                                                                          	#       OR
062979,000065:                                                                                          	#               INHINT                  (MUST BE IN JASK)
062980,000066:                                                                                          	#               TC      IBNKCALL
062981,000067:                                                                                          	#               CADR    TJETLAW
062982,000068:                                                                                          	#               RELINT
062983,000069: 
062984,000070:                                                                                          	# EXIT:         RETURN TO Q.
062985,000071: 
062986,000072:                                                                                          	# INPUT:
062987,000073:                                                                                          	#       FROM THE CALLER:  E, EDOT, AXISCTR, SENSETYP, TJP, -U, -V.
062988,000074:                                                                                          	#       FROM 1/ACCONT:  48 ERASABLES BEGINNING AT BLOCKTOP (INCLUDING FLAT, ZONE3LIM AND ACCSWU, -V).
062989,000075: 
062990,000076:                                                                                          	# OUTPUT:
062991,000077:                                                                                          	#       TJP, -U OR -V, NUMBERT (DAPTEMP5), FIREFCT (DAPTEMP3).
062992,000078: 
062993,000079:                                                                                          	# DEBRIS:
062994,000080:                                                                                          	#       A, L, Q, E, EDOT, DAPTEMP1-6, DAPTREG1-4.
062995,000081: 
062996,000082:                                                                                          	# ALARM:  NONE
062997,000083: 
062998,000084: 17,3252                                           BANK     17                            	#
062999,000085: 17,2000                                           SETLOC   DAPS2                         	#
063000,000086: 17,2000                                           BANK                                   	#
063001,000087: 17,3252  E6,1524                                  EBANK=   TJP                           	#
063003,000089: 17,3252                                           COUNT*   $$/DAPTJ                      	#
063004,000090: 
063005,000091: 17,3252           00006        TJETLAW            EXTEND                                 	# SAVE Q FOR RETURN.
063006,000092: 17,3253           23745                           QXCH     HOLDQ                         	#
063007,000093: 
063008,000094:                                                                                          	# SET INDEXERS TO CORRESPOND TO THE AXIS AND TO THE SIGN OF EDOT
063009,000095: 
063010,000096: 17,3254           51505                           INDEX    AXISCTR                       	# AXISDIFF(-1)=NO OF LOCATIONS BER P AND U
063011,000097: 17,3255           33722                           CAF      AXISDIFF                      	# AXISDIFF(0)=0
063012,000098: 17,3256           55746                           TS       ADRSDIF1                      	# AXISDIFF(+1)=NO OF LOCATIONS BET V AND U
063013,000099: 
063014,000100: 17,3257           31427                           CAE      EDOT                          	# IF EDOT NEGATIVE, PICK UP SET OF VALUES
063015,000101: 17,3260           00006                           EXTEND                                 	#       THAT ALLOW USE OF SAME CODING AS FOR
063016,000102: 17,3261           63266                           BZMF     NEGEDOT                       	#       POSITIVE EDOT.
063017,000103: 17,3262           31746                           CAE      ADRSDIF1                      	# SET A SECOND INDEXER WHICH MAY BE
063018,000104: 17,3263           55744                           TS       ADRSDIF2                      	#       MODIFIED BY A DECISION FOR MAX JETS.
063019,000105: 17,3264           33724                           CAF      SENSOR                        	# FOR POSITIVE EDOT, ROTSENSE IS
063020,000106: 17,3265           13276                           TCF      SETSENSE                      	#       INITIALIZED POSITIVE.
063021,000107: 
063022,000108: 17,3266           41752        NEGEDOT            CS       E                             	# IN ORDER FOR NEG EDOT CASE TO USE CODING
063023,000109: 17,3267           55752                           TS       E                             	#       OF POS EDOT, MUST MODIFY AS FOLLOWS:
063024,000110: 17,3270           41427                           CS       EDOT                          	#       1. COMPLEMENT E AND EDOT.
063025,000111: 17,3271           55427                           TS       EDOT                          	#       2. SET SENSE OF ROTATION TO NEGATIVE
063026,000112: 17,3272           34753                           CAF      BIT1                          	#          (REVERSED LATER IF NECESSARY).
063027,000113: 17,3273           27746                           ADS      ADRSDIF1                      	#       3. INCREMENT INDEXERS BY ONE SO THAT
063028,000114: 17,3274           55744                           TS       ADRSDIF2                      	#          THE PROPER PARAMETERS ARE ACCESSED.
063029,000115: 17,3275           43724                           CS       SENSOR                        	#
063030,000116: 17,3276           55740        SETSENSE           TS       ROTSENSE                      	#
063031,000117: 
063032,000118:                                                                                          	# TEST MAGNITUDE OF E (ATTITUDE ERROR, SINGLE-PRECISION, SCALED AT PI RADIANS):
063033,000119:                                                                                          	#       IF GREATER THAN (OR EQUAL TO) PI/16 RADIANS, GO TO THE SIMPLIFIED TJET ROUTINE.
063034,000120:                                                                                          	#       IF LESS THAN PI/16 RADIANS, RESCALE TO PI/4.
063035,000121: 
063036,000122: 17,3277           31752                           CAE      E                             	# PICK UP ATTITUDE ERROR FOR THIS AXIS
063037,000123: 17,3300           00006                           EXTEND                                 	#
063038,000124: 17,3301           74747                           MP       BIT5                          	# SHIFT RIGHT TEN BITS:  IF A-REGISTER IS
063039,000125: 17,3302           10000                           CCS      A                             	#       ZERO, RESCALE AND TEST EDOT.
063040,000126: 17,3303           13664                           TCF      RUFLAW2                       	#
063041,000127: 17,3304           13306                           TCF      SCALEE                        	#
063042,000128: 17,3305           13630                           TCF      RUFLAW1                       	#
063043,000129: 17,3306           34737        SCALEE             CAF      BIT13                         	# ERROR IS IN L SCALED AT PI/16.  RESCALE
063044,000130: 17,3307           00006                           EXTEND                                 	#       IT TO PI/4 AND SAVE IT.
063045,000131: 17,3310           70001                           MP       L                             	#
063046,000132: 17,3311           55752                           TS       E                             	#
063047,000133: 
063048,000134:                                                                                          	# TEST MAGNITUDE OF EDOT (ERROR RATE SCALED AT PI/4 RADIANS/SECOND)
063049,000135:                                                                                          	#       IF GREATER THAN (OR EQUAL TO) PI/32 RADIANS/SECOND, GO TO THE SIMPLIFIED TJET ROUTINE.
063050,000136:                                                                                          	#       IF LESS THAN PI/32 RADIANS/SECOND, THEN RESCALE TO PI/32 RADIANS/SECOND.
063051,000137: 
063052,000138: 17,3312           31427                           CAE      EDOT                          	# PICK UP SINGLE-PRECISION ERROR-RATE
063054,000140: 17,3313           00006                           EXTEND                                 	# FOR THIS AXIS=
063055,000141: 17,3314           74750                           MP       BIT4                          	# SHIFT RIGHT ELEVEN BITS, IF THE A-REG IS
063056,000142: 17,3315           00006                           EXTEND                                 	# ZERO, THEN RESCALE AND USE FINELAW.
063057,000143: 17,3316           13320                           BZF      SCALEDOT                      	#
063058,000144: 17,3317           13672                           TCF      RUFLAW3                       	#
063059,000145: 
063060,000146:                                                                                          	# *** FINELAW STARTS HERE ***
063061,000147: 
063062,000148: 17,3320           23427        SCALEDOT           LXCH     EDOT                          	# EDOT IS SCALED AT PI/32 RADIANS/SECOND.
063063,000149: 
063064,000150: 17,3321           31427                           CAE      EDOT                          	# COMPUTE (EDOT)(EDOT)
063065,000151: 17,3322           00006                           EXTEND                                 	#
063066,000152: 17,3323           70000                           SQUARE                                 	# PRODUCT SCALED AT PI(2)/2(10) RAD/SEC.
063067,000153: 17,3324           00006                           EXTEND                                 	#
063068,000154: 17,3325           74737                           MP       BIT13                         	# SHIFT RIGHT TWO BITS TO RESCALE EDOTSQ
063069,000155: 17,3326           55737                           TS       EDOTSQ                        	#       TO PI(2)/2(8) RAD(2)/SEC(2).
063070,000156: 
063071,000157: 17,3327           11752        ERRTEST            CCS      E                             	# DOES BIG ERROR (THREE DEG BEYOND THE
063072,000158: 17,3330           63725                           AD       -3DEG                         	# DEADBAND) REQUIRE MAXIMUM JETS?
063073,000159: 17,3331           13333                           TCF      +2                            	#
063074,000160: 17,3332           63725                           AD       -3DEG                         	#
063075,000161: 17,3333           00006                           EXTEND                                 	#
063076,000162: 17,3334           51746                           INDEX    ADRSDIF1                      	#
063077,000163: 17,3335           61601                           SU       FIREDB                        	#
063078,000164: 17,3336           00006                           EXTEND                                 	#
063079,000165: 17,3337           63344                           BZMF     SENSTEST                      	# IF NOT:  ARE UNBALANCED JETS PREFERRED|
063080,000166: 17,3340           34752        MAXJETS            CAF      TWO                           	# IF YES:  INCREMENT ADDRESS LOCATOR AND
063081,000167: 17,3341           27744                           ADS      ADRSDIF2                      	#          SET SWITCH FOR JET SELECT LOGIC TO 4.
063082,000168: 17,3342           34751                           CAF      FOUR                          	#          (ALWAYS DO THIS FOR P-AXIS)
063083,000169: 17,3343           13347                           TCF      TJCALC                        	#
063084,000170: 17,3344           11500        SENSTEST           CCS      SENSETYP                      	# DOES TRANSLATION PREFER MIN JETS.
063085,000171: 17,3345           13347                           TCF      TJCALC                        	# YES.  USE MIN-JET PARAMETERS.
063086,000172: 17,3346           13340                           TCF      MAXJETS                       	# NO.  GET MAX-JET PARAMETERS.
063087,000173: 17,3347           55743        TJCALC             TS       NUMBERT                       	# SET TO +0,1,4 FOR (U,V-AXES) JET SELECT.
063088,000174: 
063089,000175:                                                                                          	# BEGINNING OF TJET CALCULATIONS:
063090,000176: 
063091,000177: 17,3350           41737                           CS       EDOTSQ                        	# SCALED AT PI(2)/2(8).
063092,000178: 17,3351           00006                           EXTEND                                 	#
063093,000179: 17,3352           51744                           INDEX    ADRSDIF2                      	#
063094,000180: 17,3353           71567                           MP       1/ANET1                       	# .5/ACC SCALED AT 2(6)/PI SEC(2)/RADIAN.
063095,000181: 17,3354           51746                           INDEX    ADRSDIF1                      	#
063096,000182: 17,3355           61601                           AD       FIREDB                        	# DEADBAND SCALED AT PI/4 RADIAN.
063097,000183: 17,3356           00006                           EXTEND                                 	#
063098,000184: 17,3357           61752                           SU       E                             	# ATTITUDE ERROR SCALED AT PI/4 RADIAN.
063099,000185: 17,3360           55741                           TS       FIREFCT                       	# -E-.5(EDOTSQ)/ACC-DB AT PI/4 RADIAN.
063100,000186: 17,3361           00006                           EXTEND                                 	#
063101,000187: 17,3362           63542                           BZMF     ZON1,2,3                      	#
063102,000188: 
063103,000189: 17,3363           51746        ZONE4,5            INDEX    ADRSDIF1                      	#
063104,000190: 17,3364           31573                           CAE      1/ACOAST                      	# .5/ACC SCALED AT 2(6)/PI WHERE
063106,000192: 17,3365           00006                           EXTEND                                 	# ACC = MAX(AMIN, AOS-).

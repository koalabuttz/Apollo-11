045342,001645:                                                                                          	# Page 1053
045343,001646:                                                                                          	# THE FOLLOWING ROUTINE PROCESSES THE GENERAL SHIFT INSTRUCTIONS SR, SRR, SL, AND SLR.
045344,001647:                                                                                          	# THE GIVEN ADDRESS IS DECODED AS FOLLOWS:
045345,001648:                                                                                          	#       BITS 1-7        SHIFT COUNT (SUBADDRESS) LESS THAN 125 DECIMAL.
045346,001649:                                                                                          	#       BIT 8           PSEUDO SIGN BIT (DETECTS CHANGE IN SIGN IN INDEXED SHIFTS).
045347,001650:                                                                                          	#       BIT 9           0 FOR LEFT SHIFT, AND 1 FOR RIGHT SHIFT.
045348,001651:                                                                                          	#       BIT 10          1 FOR TERMINAL ROUND ON SCALAR SHIFTS, 0 OTHERWISE
045349,001652:                                                                                          	#       BITS 11-13      0.
045350,001653:                                                                                          	#       BIT 14          1.
045351,001654:                                                                                          	#       BIT 15          0.
045352,001655:                                                                                          	# THE ABOVE ENCODING IS DONE BY THE YUL SYSTEM.
045353,001656: 
045354,001657: 00,2214           70116        GENSHIFT           MASK     ADDRWD                        	# GET SHIFT COUNT, TESTING FOR ZERO.
045355,001658: 00,2215           10000                           CCS      A                             	# (ARRIVES WITH C(A) = LOW7).

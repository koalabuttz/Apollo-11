016959,000480: 40,2104           02112                           TC       CHARIN2                       	# TO RE-ESTABLISH A FLASHING DISPLAY
016960,000481: 40,2105           42156                           CS       ELRCODE1                      	# WHICH HE HAS OBSCURED WITH DISPLAYS OF
016961,000482: 40,2106           60154                           AD       MPAC                          	# HIS OWN (SEE REMARKS PRECEDING ROUTINE

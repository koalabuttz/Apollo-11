065284,000031:                                                                                          	##      16:27 JULY 14, 1969 
065285,000032: 
065287,000034:                                                                                          	# PROGRAM NAME:         SPSRCS
065288,000035:                                                                                          	# AUTHOR:               EDGAR M. OSHIKA (AC ELECTRONICS)
065289,000036:                                                                                          	# MODIFIED:             TO RETURN TO ALL AXES VIA Q BY P. S. WEISSMAN, OCT 7, 1968
065290,000037:                                                                                          	# MODIFIED TO IMPROVE BENDING STABILITY BY G. KALAN, FEB. 14, 1969
065291,000038: 
065292,000039:                                                                                          	# FUNCTIONAL DESCRIPTION:
065293,000040:                                                                                          	#       THIS PROGRAM CONTROLS THE FIRING OF ALL RCS JETS IN THE DOCKED CONFIGURATION ACCORDING TO THE FOLLOWING PHASE
065294,000041:                                                                                          	#       PLANE LOGIC.
065295,000042: 
065296,000043:                                                                                          	#       1. JET SENSE TEST (SPSRCS)
065297,000044:                                                                                          	#               IF JETS ARE FIRING NEGATIVELY, SET OLDSENSE NEGATIVE AND CONTINUE
065298,000045:                                                                                          	#               IF JETS ARE FIRING POSITIVELY, SET OLDSENSE POSITIVE AND CONTINUE
065299,000046:                                                                                          	#               IF JETS ARE NOT FIRING, SET OLDSENSE TO ZERO AND GO TO OUTER RATE LIMIT TEST
065300,000047: 
065301,000048:                                                                                          	#       2. RATE DEAD BAND TEST
065302,000049:                                                                                          	#               IF JETS ARE FIRING NEGATIVELY AND RATE IS GREATER THAN TARGET RATE, LEAVE
065303,000050:                                                                                          	#                       JETS ON AND GO TO INHIBITION LOGIC.  OTHERWISE, CONTINUE.
065304,000051:                                                                                          	#               IF JETS ARE FIRING POSITIVELY AND RATE IS   LESS  THAN TARGET RATE, LEAVE
065305,000052:                                                                                          	#                       JETS ON AND GO TO INHIBITION LOGIC.  OTHERWISE, CONTINUE.
065306,000053: 
065307,000054:                                                                                          	#       3. OUTER RATE LIMIT TEST (SPSSTART)
065308,000055:                                                                                          	#               IF MAGNITUDE OF EDOT IS GREATER THAN 1.73 DEG/SEC SET JET FIRING TIME
065309,000056:                                                                                          	#                       TO REDUCE RATE AND GO TO INHIBITION LOGIC.  OTHERWISE, CONTINUE.
065310,000057: 
065311,000058:                                                                                          	#       4. COAST ZONE TEST
065312,000059:                                                                                          	#               IF STATE (E,EDOT) IS BELOW LINE E + 4 X EDOT > -1.4 DEG AND EDOT IS LESS THAN 1.30 DEG/SEC SET JET TIME POSI-
065313,000060:                                                                                          	#                       TIVE AND CONTINUE.  OTHERWISE, SET JET FIRING TIME TO ZERO AND CONTINUE.
065314,000061:                                                                                          	#               IF STATE IS ABOVE LINE E + 4 X EDOT > +1.4 DEG AND EDOT IS GREATER THAN -1.30 DEG/SEC, SET JET TIME NEGATIVE
065315,000062:                                                                                          	#                       AND CONTINUE.  OTHERWISE, SET JET FIRING TIME TO ZERO AND CONTINUE.
065316,000063: 
065317,000064:                                                                                          	#       5. INHIBITION LOGIC
065318,000065:                                                                                          	#               IF OLDSENSE IS NON-ZERO:
065319,000066:                                                                                          	#                       A) RETURN IF JET TIME HAS SAME SIGN AS OLDSENSE
065320,000067:                                                                                          	#                       B) SET INHIBITION COUNTER* AND RETURN IF JET TIME IS ZERO
065321,000068:                                                                                          	#                       C) SET INHIBITION COUNTER,* SET JET TIME TO ZERO AND RETURN IF SIGN
065322,000069:                                                                                          	#                          OF JET TIME IS OPPOSITE TO THAT OF OLDSENSE
065323,000070:                                                                                          	#               IF OLDSENSE IS ZERO:
065324,000071:                                                                                          	#                       A) RETURN IF INHIBITION COUNTER IS NOT POSITIVE
065325,000072:                                                                                          	#                       B) SET JET TIME TO ZERO AND RETURN IF INHIBITION COUNTER IS POSITIVE
065326,000073:                                                                                          	#               *NOTE: INHIBITION COUNTERS CAN BE SET TO 4 OR 10 FOR THE P, AND UV AXES,
065327,000074:                                                                                          	#               RESPECTIVELY, IN SPSRCS.  THEY ARE DECREMENTED BY ONE AT THE BEGINNING OF
065329,000076:                                                                                          	#               EACH DAP PASS.
065330,000077: 
065331,000078:                                                                                          	#       THE MINIMUM PULSE WIDTH OF THIS CONTROLLER IS DETERMINED BY THE REPETITION RATE AT WHICH THIS ROUTINE IS CALLED
065332,000079:                                                                                          	#       AND IS NOMINALLY 100 MS FOR ALL AXES IN DRIFTING FLIGHT.  DURING POWERED FLIGHT THE MINIMUM IS 100 MS FOR THE
065333,000080:                                                                                          	#       P AXIS AND 200 MS FOR THE CONTROL OF THE U AND V AXES.
065334,000081: 
065335,000082:                                                                                          	# CALLING SEQUENCE:
065336,000083:                                                                                          	#               INHINT
065337,000084:                                                                                          	#               TC      IBNKCALL
065338,000085:                                                                                          	#               CADR    SPSRCS
065339,000086: 
065340,000087:                                                                                          	# EXIT:
065341,000088:                                                                                          	#               TC      Q
065342,000089: 
065343,000090:                                                                                          	# ALARM/ABORT MODE:     NONE
065344,000091: 
065345,000092:                                                                                          	# SUBROUTINES CALLED:   NONE
065346,000093: 
065347,000094:                                                                                          	# INPUT:                E, EDOT
065348,000095:                                                                                          	#                       TJP, TJV, TJU           TJ MUST NOT BE NEGATIVE ZERO
065349,000096: 

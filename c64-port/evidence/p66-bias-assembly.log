014200,000156: 
014201,000157: 26,2117           01014        VB04N12            VN       412                           	#
014202,000158: 26,2120           01422        VB06N18            VN       0618                          	#
014204,000160: 26,2121           00000 13560  DP1MIN             2DEC     6000       B-28               	#

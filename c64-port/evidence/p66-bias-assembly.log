008355,000031: 
008357,000033: 
008358,000034:                                                                                          	# PROGRAM NAME:  AGS INITIALIZATION (R47)
008359,000035: 
008360,000036:                                                                                          	# WRITTEN BY:  RHODE/KILROY/FOLLETT
008361,000037: 
008362,000038:                                                                                          	# MOD NO. :     0
008363,000039:                                                                                          	# DATE:         23 MARCH 1967
008364,000040:                                                                                          	# MOD BY:       KILROY
008365,000041: 
008366,000042:                                                                                          	# MOD NO.:      1
008367,000043:                                                                                          	# DATE:         28 OCTOBER 1967
008368,000044:                                                                                          	# MOD BY:       FOLLETT
008369,000045: 
008370,000046:                                                                                          	# FUNCT. DESC.: (1) TO PROVIDE THE AGS ABORT ELECTRONICS ASSEMBLY (AEA) WITH THE LEM AND CSM STATE VECTORS
008371,000047:                                                                                          	#               (POSITION,VELOCITY,TIME) IN LEM IMU COORDINATES BY MEANS OF THE LGC DIGITAL DOWNLINK.
008372,000048: 
008373,000049:                                                                                          	#               (2) TO ZERO THE ICDU, LGC AND AEA GIMBAL ANGLE COUNTERS SIMULTANEOUSLY IN ORDER TO ESTABLISH A
008374,000050:                                                                                          	#               COMMON ZERO REFERENCE FOR THE MEASUREMENT OF GIMBAL (EULER) ANGLES WHICH DEFINE LEM ATTITUDE
008375,000051: 
008376,000052:                                                                                          	#               (3) TO ESTABLISH THE GROUND ELAPSED TIME OF AEA CLOCK ZERO.  (IF AN AEA CLOCK ZERO IS
008377,000053:                                                                                          	#               REQUESTED DURING THIS PROGRAM
008378,000054: 
008379,000055:                                                                                          	# LOG SECTION:  AGS INITIALIZATION
008380,000056: 
008381,000057:                                                                                          	# CALLING SEQ:  PROGRAM IS ENTERED WHEN ASTRONAUT KEYS V47E ON DSKY.
008382,000058:                                                                                          	#               R47 MAY BE CALLED AT ANY TIME EXCEPT WHEN ANOTHER EXTENDED VERB IS IN PROGRESS
008383,000059: 
008384,000060:                                                                                          	# SUBROUTINES
008385,000061:                                                                                          	# CALLED:
008386,000062: 
008387,000063:                                                                                          	# NORMAL EXIT:  ENDEXT
008388,000064: 
008389,000065:                                                                                          	# ALARM/ABORT:  ALARM - BAD REFSMMAT - CODE:220
008390,000066:                                                                                          	#               OPERATOR ERROR IF V47 SELECTED DURING ANOTHER EXTENDED VERB.
008391,000067: 
008392,000068:                                                                                          	# ERASABLES
008393,000069:                                                                                          	# USED:         SAMPTIME        (2)     TIME OF :ENTER: KEYSTROKE
008394,000070:                                                                                          	#               AGSK            (2)     GROUND ELAPSED TIME OF THE AEA CLOCK :ZERO:
008395,000071:                                                                                          	#               AGSBUFF         (140)   CONTAINS AGS INITIALIZATION DATA (SEE :OUTPUT: BELOW)
008396,000072:                                                                                          	#               AGSWORD         (1)     PREVIOUS DOWNLIST SAVED HERE
008397,000073: 
008398,000074: 05,2447  E4,1600                                  EBANK=   AGSBUFF                       	#
008399,000075: 
008400,000076: 40,2000                                           BANK     40                            	#
008401,000077: 32,2000                                           SETLOC   R47                           	#
008402,000078: 32,2000                                           BANK                                   	#
008403,000079: 
008404,000080: 32,2005                                           COUNT*   $$/R47                        	#
008405,000081: 
008406,000082: 32,2005           34737        AGSINIT            CAF      REFSMBIT                      	#
008407,000083: 32,2006           70077                           MASK     FLAGWRD3                      	# CHECK REFSMFLG.
008408,000084: 32,2007           10000                           CCS      A                             	#
008410,000086: 32,2010           02017                           TC       REDSPTEM                      	# REFSMMAT IS OK
008411,000087: 32,2011           05567                           TC       ALARM                         	# REFSMMAT IS BAD
008412,000088: 32,2012           00220                           OCT      220                           	#
008413,000089: 32,2013           05472                           TC       ENDEXT                        	#
008414,000090: 
008415,000091: 32,2014           00006        NEWAGS             EXTEND                                 	#
008416,000092: 32,2015           30014                           DCA      SAMPTIME                      	# TIME OF THE :ENTER: KEYSTROKE
008417,000093: 32,2016           53421                           DXCH     AGSK                          	# BECOMES NEW AEA CLOCK :ZERO:
008418,000094: 
008419,000095: 32,2017           00006        REDSPTEM           EXTEND                                 	#
008420,000096: 32,2020           31421                           DCA      AGSK                          	#
008421,000097: 32,2021           53052                           DXCH     DSPTEMX                       	#
008422,000098: 32,2022           32172        AGSDISPK           CAF      V06N16                        	#
008423,000099: 32,2023           04616                           TC       BANKCALL                      	# R1 = 00XXX. HRS., R2 = 000XX MIN.,
008424,000100: 32,2024           20334                           CADR     GOMARKF                       	# R3 = 0XX.XX SEC.
008425,000101: 32,2025           05472                           TC       ENDEXT                        	# TERMINATE RETURN
008426,000102: 32,2026           02036                           TC       AGSVCALC                      	# PROCEED RETURN
008427,000103: 32,2027           44746                           CS       BIT6                          	# IS ENTER VIA A V32
008428,000104: 32,2030           60154                           AD       MPAC                          	#
008429,000105: 32,2031           00006                           EXTEND                                 	#
008430,000106: 32,2032           12014                           BZF      NEWAGS                        	# YES, USE KEYSTROKE TIME FOR NEW AGSK
008431,000107: 
008432,000108: 32,2033           00006                           EXTEND                                 	# NO, NEW AGSK LOADED VIA V25
008433,000109: 32,2034           31052                           DCA      DSPTEMX                       	# LOADED INTO DSPTEMX BY KEYING
008434,000110: 32,2035           02016                           TC       REDSPTEM   -1                 	# V25E FOLLOWED BY HRS.,MINS.,SECS.
008435,000111:                                                                                          	# DISPLAY THE NEW K
008436,000112: 
008437,000113: 32,2036           06037        AGSVCALC           TC       INTPRET                       	#
008438,000114: 32,2037           77614                           SET                                    	#
008439,000115: 32,2040           01076                                    NODOFLAG                      	# DONT ALLOW V37
008440,000116: 32,2041           77414                           SET      EXIT                          	#
008441,000117: 32,2042           02076                                    XDSPFLAG                      	#
008442,000118: 
008443,000119: 32,2043           32172                           CAF      V06N16                        	#
008444,000120: 32,2044           04616                           TC       BANKCALL                      	#
008445,000121: 32,2045           20620                           CADR     EXDSPRET                      	#
008446,000122: 
008447,000123: 32,2046           06037                           TC       INTPRET                       	# EXTRAPOLATE LEM AND CSM STATE VECTORS
008448,000124: 32,2047           77634                           RTB                                    	# TO THE PRESENT TIME
008449,000125: 32,2050           21573                                    LOADTIME                      	# LOAD MPAC WITH TIME2,TIME1
008450,000126: 32,2051           34041                           STCALL   TDEC1                         	# CALCULATE LEM STATE VECTOR
008451,000127: 32,2052           27057                                    LEMPREC                       	#
008452,000128: 32,2053           77624                           CALL                                   	# CALL ROUTINE TO CONVERT TO SM COORDS AND
008453,000129: 32,2054           64132                                    SCALEVEC                      	# PROVIDE PROPER SCALING
008454,000130: 32,2055           16201                           STODL    AGSBUFF                       	# (LEMPREC AND CSMPREC LEAVE TDEC1 IN TAT)
008455,000131: 32,2056           00015                                    TAT                           	# TAT = TIME TO WHICH RATT1 AND VATT1 ARE

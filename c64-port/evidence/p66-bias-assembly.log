057109,000939:                                                                                          	# PROGRAM DESCRIPTION           P06             10 FEB 67
057110,000940: 
057111,000941:                                                                                          	# TRANSFER THE ISS/CMC FROM THE OPERATE TO THE STANDBY CONDITION.
057112,000942: 
057113,000943:                                                                                          	# THE NORMAL CONDITION OF READINESS OF THE GNCS WHEN NOT IN USE IS STANDBY.  IN THIS CONDITION THE IMU
057114,000944:                                                                                          	# HEATER POWER IS ON.  THE IMU OPERATE POWER IS OFF.  THE COMPUTER POWER IS ON.  THE OPTICS POWER IS OFF.  THE
057115,000945:                                                                                          	# CMC STANDBY ON THE MAIN AND LEB DISKYS IS ON.
057116,000946: 
057117,000947:                                                                                          	# CALLING SEQUENCE:
057118,000948:                                                                                          	#       ASTRONAUT REQUEST THROUGH DSKY  V37E 06E.
057119,000949: 
057120,000950:                                                                                          	# SUBROUTINES CALLED:
057121,000951:                                                                                          	#       GOPERF1
057122,000952:                                                                                          	#       BANKCALL
057123,000953:                                                                                          	#       FLAGDOWN
057124,000954: 
057126,000956:                                                                                          	# PRESTAND PREPARES FOR STANDBY BY SNAPSHOTTING THE SCALER AND TIME1 TIME2
057127,000957:                                                                                          	# THE LOW 5 BITS OF THE SCALER ARE INSPECTED TO INSURE COMPATABILITY
057128,000958:                                                                                          	# BETWEEN THE SCALER READING AND THE TIME1 TIME2 READING.
057129,000959: 
057130,000960: 37,2000                                           SETLOC   P05P06                        	#
057131,000961: 37,2000                                           BANK                                   	#
057132,000962: 
057133,000963: 37,3655     0314                                  EBANK=   TIME2SAV                      	#
057134,000964: 37,3655                                           COUNT*   $$/P06                        	#
057135,000965: 
057136,000966: 37,3655           05504        P06                TC       UPFLAG                        	# SET NODOV37 BIT
057137,000967: 37,3656           00054                           ADRES    NODOFLAG                      	#
057138,000968: 
057139,000969: 37,3657           00004        PRESTAND           INHINT                                 	#
057140,000970: 37,3660           00006                           EXTEND                                 	#
057141,000971: 37,3661           30025                           DCA      TIME2                         	# SNAPSHOT TIME1 TIME2
057142,000972: 37,3662           52315                           DXCH     TIME2SAV                      	#
057143,000973: 37,3663           03714                           TC       SCALPREP                      	#
057144,000974: 37,3664           03657                           TC       PRESTAND                      	# T1,T2,SCALER NOT COMPATIBLE
057145,000975: 37,3665           52155                           DXCH     MPAC                          	# T1,T2 AND SCALER OK
057146,000976: 37,3666           52317                           DXCH     SCALSAVE                      	# STORE SCALER
057147,000977: 37,3667           00004                           INHINT                                 	#
057148,000978: 37,3670           04616                           TC       BANKCALL                      	#
057149,000979: 37,3671           17175                           CADR     RNDREFDR                      	# REFSMM, DRIFT, TRACK FLAGS DOWN
057150,000980: 
057151,000981: 37,3672           05516                           TC       DOWNFLAG                      	#
057152,000982: 37,3673           00007                           ADRES    IMUSE                         	# IMUSE DOWN
057153,000983: 37,3674           05516                           TC       DOWNFLAG                      	#
057154,000984: 37,3675           00010                           ADRES    RNDVZFLG                      	# RNDVZFLG DOWN
057155,000985: 
057156,000986: 37,3676           34741                           CAF      BIT11                         	#
057157,000987: 37,3677           00006                           EXTEND                                 	#
057158,000988: 37,3700           05013                           WOR      CHAN13                        	# SET STANDBY ENABLE BIT
057159,000989: 
057160,000990: 37,3701           05353                           TC       PHASCHNG                      	# SET RESTART TO POSTAND WHEN STANDBY
057161,000991: 37,3702           07024                           OCT      07024                         	#       RECOVERS
057162,000992: 37,3703           20000                           OCT      20000                         	#
057163,000993: 37,3704     0316                                  EBANK=   SCALSAVE                      	#
057164,000994: 37,3704           03734 76060                     2CADR    POSTAND                       	#
057165,000995: 
057166,000996: 37,3706           34774                           CAF      OCT62                         	#
057167,000997: 37,3707           04616                           TC       BANKCALL                      	#
057168,000998: 37,3710           20623                           CADR     GOPERF1                       	#
057169,000999: 37,3711           13706                           TCF      -3                            	#
057170,001000: 37,3712           13706                           TCF      -4                            	#
057171,001001: 37,3713           13706                           TCF      -5                            	#
057172,001002: 
057173,001003: 37,3714     4774               OCT62              EQUALS   .5SEC                         	# DEC 50 = OCT 62
057174,001004: 
057175,001005:                                                                                          	# THE LOW 5 BITS OF THE SCALER READS 10000 FOR THE FIRST INTERVAL AFTER A
057177,001007:                                                                                          	# T1 INCREMENT.  IF SCALPREP DETECTS THIS INTERVAL THE T1,T2 AND SCALER
057178,001008:                                                                                          	# DATA ARE NOT COMPATABLE AND RETURN IS TO L+1 FOR ANOTHER READING OF THE
057179,001009:                                                                                          	# DATA.  OTHERWISE, THE RETURN IS TO L+2 TO PROCEED.  ROUTINE ALSO PREPARES
057180,001010:                                                                                          	# THE SCALER READING FOR COMPUTATION OF THE INCREMENT TO UPDATE T1T2.  (THE
057181,001011:                                                                                          	# 10 MS BIT (BIT 6) OF THE SCALER IS INCREMENTED 5 MS OUT OF PHASE FROM
057182,001012:                                                                                          	# T1.) ADDITION OF 5 MS (BIT 5) TO THE SCALER READING HAS THE EFFECT OF
057183,001013:                                                                                          	# ADJUSTING BIT 6 IN THE SCALER TO BE IN PHASE WITH BIT 1 OF T1.  THE LOW 5
057184,001014:                                                                                          	# BITS OF THE SCALER READING ARE THEN SET TO ZERO, TO TRUNCATE THE SCALER
057185,001015:                                                                                          	# DATA TO 10 MS.  RESULTS ARE STORED IN MPAC, +1.
057186,001016: 
057187,001017: 37,3714           00006        SCALPREP           EXTEND                                 	#
057188,001018: 37,3715           22156                           QXCH     MPAC       +2                 	#
057189,001019: 37,3716           04103                           TC       FINETIME   +1                 	#
057190,001020: 37,3717           00003                           RELINT                                 	#
057191,001021: 37,3720           52155                           DXCH     MPAC                          	#
057192,001022: 37,3721           34747                           CA       BIT5                          	# ADD 5 MS TO THE SCALER READING.
057193,001023: 37,3722           54001                           TS       L                             	#
057194,001024: 37,3723           34755                           CA       ZERO                          	#
057195,001025: 37,3724           20155                           DAS      MPAC                          	#
057196,001026: 37,3725           44346                           CS       LOW5                          	# SET LOW 5 BITS OF (SCALER+5MS) TO ZERO
057197,001027: 37,3726           70155                           MASK     MPAC       +1                 	# AND STORE RESULTS IN MPAC,+1.
057198,001028: 37,3727           56155                           XCH      MPAC       +1                 	#
057199,001029: 37,3730           74346                           MASK     LOW5                          	# TEST LOW 5 BITS OF SCALER FOR THE FIRST
057200,001030:                                                                                          	# INTERVAL AFTER THE T1 INCREMENT
057201,001031:                                                                                          	# (NOW = 00000, SINCE BIT 5 ADDED).
057202,001032: 37,3731           10000                           CCS      A                             	# IS IT 1ST INTERVAL AFTER T1 INCREMENT
057203,001033: 37,3732           24156                           INCR     MPAC       +2                 	# NO
057204,001034: 37,3733           00156                           TC       MPAC       +2                 	# YES
057205,001035: 
057206,001036:                                                                                          	# POSTAND RECOVERS TIME AFTER STANDBY.  THE SCALER IS SNAPSHOTTED AND THE
057207,001037:                                                                                          	# TIME1 TIME2 COUNTER IS SET TO ZERO.  THE LOW 5 BITS OF THE SCALER ARE
057208,001038:                                                                                          	# INSPECTED TO INSURE COMPATABILITY BETWEEN THE SCALER READING AND THE
057209,001039:                                                                                          	# CLEARING OF THE TIME COUNTER.  IT THEN COMPUTES THE DIFFERENCE IN SCALER
057210,001040:                                                                                          	# VALUES (IN DP) AND ADDS THIS TO THE PREVIOUSLY SNAPSHOTTED VALUES OF
057211,001041:                                                                                          	# TIME1 TIME2 AND PLACES THIS NEW TIME INTO THE TIME1 TIME2 COUNTER.
057212,001042: 
057213,001043: 37,3734                                           COUNT*   $$/P05                        	#
057214,001044: 
057215,001045: 37,3734           44741        POSTAND            CS       BIT11                         	# RECOVER TIME AFTER STANDBY.
057216,001046: 37,3735           00006                           EXTEND                                 	#
057217,001047: 37,3736           03013                           WAND     CHAN13                        	# CLEAR STANDBY ENABLE BIT
057218,001048: 37,3737           00004                           INHINT                                 	#
057219,001049: 37,3740           34755                           CA       ZERO                          	#
057220,001050: 37,3741           54001                           TS       L                             	#
057221,001051: 37,3742           52025                           DXCH     TIME2                         	# CLEAR TIME1TIME2
057222,001052: 37,3743           03714                           TC       SCALPREP                      	# STORE SCALER IN MPAC, MPAC+1
057223,001053: 37,3744           03737                           TC       POSTAND    +3                 	# T1,T2,SCALER NOT COMPATIBLE
057224,001054: 37,3745           00006                           EXTEND                                 	# T1,T2 AND SCALER OK
057225,001055: 37,3746           40317                           DCS      SCALSAVE                      	#
057226,001056: 37,3747           20155                           DAS      MPAC                          	# FORM DP DIFFERENCE OF POSTSTANDBY SCALER
057228,001058: 37,3750           34742                           CAF      BIT10                         	# MINUS PRESTANDBY SCALER AND SHIFT RIGHT
057229,001059: 37,3751           07307                           TC       SHORTMP                       	# 5 TO ALIGN BITS WITH TIME1 TIME2.
057230,001060: 37,3752           34755                           CAF      ZERO                          	#
057231,001061: 37,3753           54156                           TS       MPAC       +2                 	# NEEDED FOR TP AGREE
057232,001062: 37,3754           07257                           TC       TPAGREE                       	# MAKE DP DIFF AGREE
057233,001063: 37,3755           10154                           CCS      MPAC                          	#
057234,001064: 37,3756           03763                           TC       POSTCOM                       	# IF DP DIFF NET +, NO SCALER OVERFLOW
057235,001065: 37,3757           03763                           TC       POSTCOM                       	# BETWEEN PRE AND POST STANDBY.
057236,001066: 37,3760           03761                           TC       +1                            	# IF DP DIFF NET -, SCALER OVERFLOWED.  ADD
057237,001067: 37,3761           34742                           CAF      BIT10                         	# BIT 10 TO HIGH DIFF TO CORRECT.

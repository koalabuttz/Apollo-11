007105,000767:                                                                                          	# PROGRAM NAME:  IMUCAGE.
007106,000768: 
007107,000769:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM PROCESSES CHANGES OF THE IMUCAGE INBIT, CHANNEL 30 BIT 11.  IF THE BIT
007108,000770:                                                                                          	# CHANGES TO 0 (CAGE BUTTON PRESSED), THE ISS IS CAGED (ICDU ZERO + COARSE ALIGN + NO ATT LAMP) UNTIL THE
007109,000771:                                                                                          	# ASTRONAUT SELECTS ANOTHER PROGRAM TO ALIGN THE ISS.  ANY PULSE TRAINS TO THE ICDU'S AND GYRO'S ARE TERMINATED,
007110,000772:                                                                                          	# THE ASSOCIATED OUTCOUNTERS ARE ZEROED AND THE GYRO'S ARE DE-SELECTED.  NO ACTION OCCURS WHEN THE BUTTON IS
007111,000773:                                                                                          	# RELEASED (INBIT CHANGES TO 1).
007112,000774: 
007113,000775:                                                                                          	# CALLING SEQUENCE:  BY IMUMON WHEN IMU CAGE BIT CHANGES.
007114,000776: 
007115,000777:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
007116,000778: 
007117,000779:                                                                                          	# SUBROUTINES CALLED:  CAGESUB.
007118,000780: 
007119,000781:                                                                                          	# ERASABLE INITIALIZATION:  FRESH START AND RESTART SET BIT 11 OF IMODES30 TO 1.
007120,000782: 
007121,000783:                                                                                          	# ALARMS: NONE.
007122,000784: 
007123,000785:                                                                                          	# EXIT:  NXTIFAIL.
007124,000786: 
007125,000787:                                                                                          	# OUTPUT:  ISS CAGED, COUNTERS ZEROED, PULSE TRAINS TERMINATED AND NO ATT LAMP LIT.
007126,000788: 
007127,000789: 06,2565           10000        IMUCAGE            CCS      A                             	# NO ACTION IF GOING OFF.
007128,000790: 06,2566           12361                           TCF      ISSZERO                       	#
007129,000791: 06,2567           43002                           CS       OCT77000                      	# TERMINATE ICDU, RCDU, GYRO PULSE TRAINS
007130,000792: 06,2570           00006                           EXTEND                                 	#
007131,000793: 06,2571           03014                           WAND     CHAN14                        	#
007132,000794: 
007133,000795: 06,2572           42776                           CS       OCT272                        	# KNOCK DOWN DISPLAY INERTIAL DATA, IMU
007134,000796: 06,2573           00006                           EXTEND                                 	# ERROR COUNTER ENABLE, ZERO ICDU, COARSE
007135,000797: 06,2574           03012                           WAND     CHAN12                        	# ALIGN ENABLE, RR ERROR COUNTER ENABLE.
007136,000798: 
007137,000799: 06,2575           44745                           CS       ENGONBIT                      	# INSURE ENGONFLG IS CLEAR.
007138,000800: 06,2576           70101                           MASK     FLAGWRD5                      	#
007139,000801: 06,2577           54101                           TS       FLAGWRD5                      	#
007140,000802: 06,2600           44355                           CS       PRIO30                        	# TURN ENGINE OFF.
007141,000803: 06,2601           00006                           EXTEND                                 	#
007142,000804: 06,2602           02011                           RAND     DSALMOUT                      	#
007143,000805: 06,2603           64736                           AD       BIT14                         	#
007144,000806: 06,2604           00006                           EXTEND                                 	#
007145,000807: 06,2605           01011                           WRITE    DSALMOUT                      	# FORCE BIT14=1, BIT13=0.
007146,000808: 
007147,000809: 06,2606           02743                           TC       CAGESUB1                      	#
007148,000810: 
007149,000811: 06,2607           04674                           TC       IBNKCALL                      	# KNOCK DOWN TRACK, REFSMMAT, DRIFT FLAGS
007150,000812: 06,2610           17175                           CADR     RNDREFDR                      	#
007151,000813: 
007152,000814: 06,2611           44755                           CS       ZERO                          	#
007153,000815: 06,2612           54050                           TS       CDUXCMD                       	#
007154,000816: 06,2613           54051                           TS       CDUYCMD                       	#
007156,000818: 06,2614           54052                           TS       CDUZCMD                       	#
007157,000819: 06,2615           54047                           TS       GYROCMD                       	#
007158,000820: 
007159,000821: 06,2616           43001                           CS       OCT740                        	# HAVING WAITED AT LEAST 27 MCT FROM
007160,000822: 06,2617           00006                           EXTEND                                 	# GYRO PULSE TRAIN TERMINATION, WE CAN
007161,000823: 06,2620           03014                           WAND     CHAN14                        	# DE-SELECT THE GYROS

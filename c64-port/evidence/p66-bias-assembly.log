020215,003736:                                                                                          	# ERROR LIGHT RESET (RSET) TURNS OFF,
020216,003737:                                                                                          	# UPLINK ACTIVITY, AUTO, HOLD, FREE, OPERATOR ERROR,
020217,003738:                                                                                          	# PROG ALM, TRACKER FAIL.
020218,003739:                                                                                          	# LEAVES GIMBAL LOCK AND NO ATT ALONE.
020219,003740:                                                                                          	# IT ALSO ZEROES THE :TEST ALARM: OUT BIT, WHICH TURNS OFF STBY, RESTART.
020220,003741:                                                                                          	# IT ALSO SETS :CAUTION RESET: TO 1.
020221,003742:                                                                                          	# IT ALSO FORCES BIT 12 OF ALL DSPTAB ENTRIES TO 1.

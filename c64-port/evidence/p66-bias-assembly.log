012676,000187: 42,2132           32650                           CAF      IDADDTAB                      	#
012677,000188: 42,2133           54150                           TS       IDAD1TEM                      	# LOAD IDAD1TEM WITH FIRST IDADDTAB ENTRY
012678,000189: 42,2134           00006                           EXTEND                                 	#

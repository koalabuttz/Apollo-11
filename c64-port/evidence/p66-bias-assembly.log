033242,000644:                                                                                          	#       L+1             S40.1
033243,000645: 
033244,000646:                                                                                          	# NORMAL EXIT MODE
033245,000647:                                                                                          	#       AT L+2 OF CALLING SEQUENCE (GOTO L+2) NORMAL RETURN OR
033246,000648:                                                                                          	#       ERROR RETURN IF NOSOFLAG =1

024482,003286:                                                                                          	# PROGRAM NAME:  LRS22.1 (DATA READ SUBROUTINE 1)
024483,003287:                                                                                          	# MOD. NO.: 1           BY: P. VOLANTE  SDC             DATE:  11-15-66
024484,003288: 
024485,003289:                                                                                          	# FUNCTIONAL DESCRIPTION
024486,003290:                                                                                          	#       1)      READS RENDEZVOUS RADAR RANGE AND RANGE-RATE, TRUNION AND SHAFT ANGLES, THREE CDU VALUES AND TIME.  CONVERTS THIS
024487,003291:                                                                                          	#               DATA AND LEAVES IT FOR THE MEASUREMENT INCORPORATION ROUTINE (LSR22.3).  CHECKS FOR THE RR DATA GOOD DISCRETE, FOR
024488,003292:                                                                                          	#               RR REPOSITION AND RR CDU FAIL
024489,003293:                                                                                          	#       2)      COMPARES RADAR LOS WITH LOS COMPUTED FROM STATE VECTORS TO SEE IF THEY ARE WITHIN THREE DEGREES
024490,003294: 
024491,003295:                                                                                          	# CALLING SEQUENCE:  BANKCALL FOR LRS22.1
024492,003296: 
024493,003297:                                                                                          	# SUBROUTINES CALLED:
024494,003298:                                                                                          	#       RRRDOT          LPS20.1
024495,003299:                                                                                          	#       RRRANGE         BANKCALL
024496,003300:                                                                                          	#       RADSTALL        CDULOGIC
024497,003301:                                                                                          	#       RRNB            SMNB
024498,003302: 
024499,003303:                                                                                          	# NORMAL EXIT:  RETURN TO CALLER+1 WITH MPAC SET TO +0
024500,003304: 
024501,003305:                                                                                          	# ERROR EXITS:  RETURN TO CALLER+1 WITH ERROR CODE STORED IN MPAC AS FOLLOWS:
024502,003306:                                                                                          	#       00001 - ERROR EXIT 1 - RR DATA NO GOOD (NO RR DATA GOOD DISCRETE OR RR CDU FAIL OR RR REPOSITION)
024503,003307:                                                                                          	#       00002 - ERROR EXIT 2 - RR LOS NOT WITHIN THREE DEGREES OF LOS COMPUTED FROM STATE VECTORS
024504,003308: 
024505,003309:                                                                                          	# ALARMS:  521 - COULD NOT READ RADAR DATA (RR DATA GOOD DISCRETE NOT PRESENT BEFORE AND AFTER READING THE RADAR)
024506,003310:                                                                                          	#       (THIS ALARM IS ISSUED BY THE RADAREAD SUBROUTINE WHICH IS ENTERED FROM A RADARUPT)
024507,003311: 
024508,003312:                                                                                          	# OUTPUT:  RRLOSVEC - THE RR LINE-OF-SIGHT VECTOR (USED BY LRS22.2) - A HALF-UNIT VECTOR
024509,003313:                                                                                          	#       RM - THE RR RANGE READING (TO THE CSM) DP, IN METERS SCALED B-29 (USED BY LRS22.2 AND LRS22.3)
024510,003314: 
024511,003315:                                                                                          	#       ALL OF THE FOLLOWING OUTPUTS ARE USED BY LRS22.3:
024512,003316:                                                                                          	#               RDOTM - THE RR RANGE-RATE READING, DP, IN METERS PER CENTISECOND, SCALED B-7
024513,003317:                                                                                          	#               RRTRUN - RR TRUNION ANGLE, DP, IN REVOLUTIONS, SCALED B0
024514,003318:                                                                                          	#               RRSHAFT - RR SHAFT ANGLE, DP, IN REVOLUTIONS, SCALED B0
024515,003319:                                                                                          	#               AIG,AMG,AOG - THE CDU ANGLES, THREE SP WORDS
024516,003320:                                                                                          	#               MKTIME - THE TIME OF THE RR READING, DP, IN CENTISECONDS
024517,003321: 
024518,003322:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:
024519,003323:                                                                                          	#       RNRAD, THE RADAR READ COUNTER FROM WHICH IS OBTAINED:
024521,003325:                                                                                          	#               1) RR RANGE SCALED 9.38 FT. PER BIT ON THE LOW SCALE AND 75.04 FT. PER BIT ON THE HIGH SCALE
024522,003326:                                                                                          	#               2) RR RANGE RATE, SCALED .6278 FT./SEC. PER BIT
024523,003327:                                                                                          	#       THE CDU ANGLES FROM CDUX, CDUY, CDUZ AND TIME1 AND TIME2
024524,003328: 
024525,003329:                                                                                          	# DEBRIS:  LRS22.1X, A, L, Q, PUSHLIST
024526,003330: 

032637,000039:                                                                                          	##      16:27 JULY 14, 1969 
032638,000040: 
032640,000042:                                                                                          	# PROGRAM DESCRIPTION  P40BOTH          DECEMBER 22, 1966
032641,000043:                                                                                          	# MOD 03 BY PETER ADLER                 MARCH 3, 1967
032642,000044:                                                                                          	# CALLED VIA JOB FROM V37E
032643,000045: 
032644,000046:                                                                                          	# FUNCTIONAL DESCRIPTION
032645,000047: 
032646,000048:                                                                                          	#       1)      TO COMPUTE A PREFERRED IMU ORIENTATION AND A PREFERRED VEHICLE ATTITUDE FOR A LM DPS
032647,000049:                                                                                          	#               THRUSTING MANEUVER.
032649,000051:                                                                                          	#       3)      TO DO THE VEHICLE MANEUVER TO THE THRUSTING ATTITUDE.
032650,000052:                                                                                          	#       4)      TO CONTROL THE PGNCS DURING COUNTDOWN, IGNITION, THRUSTING, AND THRUST TERMINATION OF A
032651,000053:                                                                                          	#               PGNCS CONTROLLED DPS MANEUVER.
032652,000054:                                                                                          	#       5)      IN POSTBURN--ZERO RENDEZVOUS COUNTER, MAINTAIN VG CALCULATIONS FOR POSSIBLE RCS MANEUVER,
032653,000055:                                                                                          	#               SET MAXIMUM DEADBAND IN DAP, RESET STEERLAW CSTEER TO ZERO.
032654,000056: 
032655,000057:                                                                                          	#       NOTE:   P42, WHICH IS IN THIS LOG SECTION, DOES THE SAME FOR AN APS BURN, AND P41 DOES 1-3 FOR
032656,000058:                                                                                          	#               RCS PLUS DISPLAYS PARAMETERS FOR MANUAL CONTROL.
032657,000059: 
032658,000060:                                                                                          	# SUBROUTINES USED
032659,000061: 
032660,000062:                                                                                          	#       R02             IMU STATUS CHECK
032661,000063:                                                                                          	#       S40.1           COMPUTATION OF THRUST DIRECTION
032662,000064:                                                                                          	#       S40.13          LENGTH OF BURN
032663,000065:                                                                                          	#       S40.2,3         PREFERRED IMU ORIENATTION
032664,000066:                                                                                          	#       S40.8           X PRODUCT STEERING
032665,000067:                                                                                          	#       S40.9           LAMBERT VTOGAIN
032666,000068:                                                                                          	#       R60LEM          ATTITUDE MANEUVER
032667,000069:                                                                                          	#       LEMPREC         EXTRAPOLATE STATE VECTOR
032668,000070:                                                                                          	#       PREREAD         AVERAGE G, SERVICER
032669,000071:                                                                                          	#       ALLCOAST        DAP COASTING INITIALIZATION
032670,000072:                                                                                          	#       CLOKTASK        ERGO CLOCKJOB -- COUNT DOWN
032671,000073:                                                                                          	#       PHASCHNG, INTPRET, FLAGUP, FLAGDOWN, WAITLIST, LONGCALL, GOFLASH, GOFLASHR, GOPERF1, ALARM,
032672,000074:                                                                                          	#       PRIOLARM, GOTOPOOH, ENDOFJOB, BANKCALL, SETMAXDB, SETMINDB, CHECKMM, FLATOUT, OUTFLAT,
032673,000075:                                                                                          	#       KILLTASK, SGNAGREE, TPAGREE, ETC.
032674,000076: 
032675,000077:                                                                                          	# RESTARTS VIA GROUP 4
032676,000078: 
032677,000079:                                                                                          	# DISPLAYS
032678,000080: 
032679,000081:                                                                                          	#       V50N25  203 A/P TO PGNCS, AUTOTHROTTLE MODE, AUTO ATTITUDE CONTROL
032680,000082:                                                                                          	#       V06N40  TTI, VG, DELTAVM (DISPLAYED ONCE/SECOND BY CLOKTASK)
032681,000083:                                                                                          	#       V50N99  PLEASE PERFORM ENGINE ON ENABLE
032682,000084:                                                                                          	#       V06N40  TG (TIME TO GO TO CUTOFF), VG, DELTAVM -- ONCE/SECOND
032683,000085:                                                                                          	#       V16N40  FINAL VALUES OF TG, VG, DELTAVM
032684,000086:                                                                                          	#       V16N85  COMP OF VG (BODY AXES) FOR POSS. RCS MANUAL MANEUVER
032685,000087:                                                                                          	#       V05N09  POSSIBLE ALARMS
032686,000088:                                                                                          	#       V50N07  PLEASE SELECT P00
032687,000089: 
032689,000091:                                                                                          	#       VIA R30
032690,000092: 
032691,000093:                                                                                          	#       V06N44  HAPO, PERI, TFF
032692,000094:                                                                                          	#       V06N35  TIME TO PERIGEE, HMS
032693,000095: 
032694,000096:                                                                                          	# ALARM OR ABORT EXIT MODES
032695,000097: 
032696,000098:                                                                                          	#       PROGRAM ALARM, FLASHING DISPLAY OF ALARM CODE 1706 IF P40 SELECTED WITH DESCENT UNIT STAGED.
032697,000099:                                                                                          	#       V34E (TERMINATE) IS THE ONLY RESPONSE ACCEPTED.  TC GOTOPOOH.
032698,000100: 
032699,000101:                                                                                          	#       PROGRAM ALARM, FLASH CODE 1703:  TIG LESS THAN 45 SECS AWAY.  V34E= GOTOPOOH OR V33E= SLIP
032700,000102:                                                                                          	#       TIG BY 45 SECS.

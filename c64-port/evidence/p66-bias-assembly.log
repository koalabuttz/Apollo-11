024654,003458:                                                                                          	# PROGRAM NAME - LRS22.2 (DATA READ SUBROUTINE 2)
024655,003459:                                                                                          	# MOD. NO.: 1           BY: P VOLANTE  SDC              DATE   4-11-67
024656,003460: 
024657,003461:                                                                                          	# FUNCTIONAL DESCRIPTION-
024659,003463:                                                                                          	#       2)  CHECKS IF THE RR LOS (I.E. THE RADAR BORESIGHT VECTOR) IS WITHIN 30 DEGREES OF THE LM +Z AXIS
024660,003464: 
024661,003465:                                                                                          	# CALLING SEQUENCE-  BANKCALL FOR LRS22.2
024662,003466: 
024663,003467:                                                                                          	# SUBROUTINES CALLED:  G+N, AUTO   SETMAXDB
024664,003468: 
024665,003469:                                                                                          	# NORMAL EXIT-  RETURN TO CALLER WITH MPAC SET TO +0 (VIA SWRETURN)
024666,003470: 
024667,003471:                                                                                          	# ERROR EXIT-  RETURN TO CALLER WITH MPAC SET TO 00001 - RADAR LOS NOT WITHIN 30 DEGREES OF LM +Z AXIS
024668,003472: 
024669,003473:                                                                                          	# ALARMS-  NONE                                                             IN THE AUTO MODE
024670,003474: 
024671,003475:                                                                                          	# ERASABLE INITIALIZATION REQUIRED -
024672,003476:                                                                                          	#       RRLOSVEC - THE RR LINE-OF-SIGHT VECTOR - A HALF UNIT VECTOR COMPUTED BY LRS22.1
024673,003477:                                                                                          	#       RM - RR RANGE, METERS B-29, FROM LRS22.1
024674,003478:                                                                                          	#       BIT 14 CHANNEL 31 - INDICATES AUTOPILOT IS IN AUTO MODE
024675,003479: 
024676,003480:                                                                                          	# DEBRIS - A,L,Q MPAC - PUSHLIST AND PUSHLOC ARE NOT CHANGED BY THIS ROUTINE
024677,003481: 
024678,003482: 24,2000                                           SETLOC   P20S                          	#
024679,003483: 24,2000                                           BANK                                   	#

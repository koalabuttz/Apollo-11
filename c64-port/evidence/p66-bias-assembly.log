006734,000396: 06,2253           12256                           TCF      +3                            	#
006735,000397: 
006736,000398: 06,2254           05567                           TC       ALARM                         	# ALARM IF NOT.
006737,000399: 06,2255           00213                           OCT      213                           	#
006738,000400: 
006739,000401: 06,2256           02735                 +3        TC       CAGESUB                       	#
006740,000402: 06,2257           33005                           CAF      90SECS                        	#
006741,000403: 06,2260           05203                           TC       WAITLIST                      	#
006742,000404: 06,2261  E6,1414                                  EBANK=   M11                           	#
006743,000405: 06,2261           02266 14106                     2CADR    ENDTNON                       	#
006744,000406: 
006745,000407: 06,2263           12374                           TCF      C33TEST                       	#
006746,000408: 
006747,000409: 06,2264           33005        RETNON             CAF      90SECS                        	#
006748,000410: 06,2265           05224                           TC       VARDELAY                      	#
006749,000411: 
006750,000412: 06,2266           44752        ENDTNON            CS       BIT2                          	# RESET TURN-ON REQUEST FAIL BIT.
006751,000413: 06,2267           71302                           MASK     IMODES30                      	#
006752,000414: 06,2270           57302                           XCH      IMODES30                      	#
006753,000415: 06,2271           74752                           MASK     BIT2                          	# IF IT WAS OFF, SEND ISS DELAY COMPLETE.
006754,000416: 06,2272           00006                           EXTEND                                 	#
006755,000417: 06,2273           12306                           BZF      ENDTNON2                      	#
006756,000418: 
006757,000419: 06,2274           34736                           CAF      BIT14                         	# IF IT WAS ON AND TURN-ON REQUEST NOW
006759,000421: 06,2275           71302                           MASK     IMODES30                      	# PRESENT, RE-ENTER 90 SEC DELAY IN WL.
006760,000422: 06,2276           00006                           EXTEND                                 	#
006761,000423: 06,2277           12264                           BZF      RETNON                        	#
006762,000424: 
006763,000425: 06,2300           40074                           CS       FLAGWRD0                      	# IF IT IS NOT ON NOW, SEE IF A PROG WAS
006764,000426: 06,2301           74744                           MASK     IMUSEBIT                      	# WAITING.
006765,000427: 06,2302           10000                           CCS      A                             	#
006766,000428: 06,2303           15261                           TCF      TASKOVER                      	#
006767,000429: 06,2304           04635                           TC       POSTJUMP                      	#
006768,000430: 06,2305           17637                           CADR     IMUBAD                        	# UNSUCCESSFUL TURN-ON.
006769,000431: 
006770,000432: 06,2306           34735        ENDTNON2           CAF      BIT15                         	# SEND ISS DELAY COMPLETE.
006771,000433: 06,2307           00006                           EXTEND                                 	#
006772,000434: 06,2310           05012                           WOR      CHAN12                        	#
006773,000435: 
006774,000436: 06,2311           04674                           TC       IBNKCALL                      	# TURN OFF NO ATT LAMP.
006775,000437: 06,2312           17266                           CADR     NOATTOFF                      	#
006776,000438: 
006777,000439: 06,2313           05457        UNZ2               TC       ZEROICDU                      	#

033721,001123: 
033722,001124:                                                                                          	# FUNCTION              (1) GENERATES REQUIRED VELOCITY AND VELOCITY-TO-BE-GAINED
033723,001125:                                                                                          	#                       VECTORS FOR USE DURING AIMPOINT MANEUVERS EVERY TWO
033724,001126:                                                                                          	#                       COMPUTATION CYCLES (4 SECONDS).
033725,001127:                                                                                          	#                       (2) UPDATES THE B VECTOR WHICH IS USED IN THE FINAL
033726,001128:                                                                                          	#                       CALCULATION OF EXTRAPOLATING THE VELOCITY-TO-BE-GAINED
033727,001129:                                                                                          	#                       THROUGH ONE 2-SECOND INTERVAL INTO THE FUTURE.
033728,001130: 
033729,001131:                                                                                          	# CALLING SEQ VIA FINDVAC AS NEW JOB.
033730,001132: 
033731,001133:                                                                                          	# INPUT                 RN      - ACTIVE VEHICLE RADIUS VECTOR IN METERS AT +29.
033732,001134:                                                                                          	#                       VN      - ACTIVE VEHICLE VELOCITY VECTOR IN METERS/CS AT +7
033734,001136:                                                                                          	#                       VRPREV  - LAST COMPUTED VELOCITY REQUIRED VECTOR IN

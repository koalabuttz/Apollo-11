022650,001454:                                                                                          	# PROGRAM NAME_ RRLIMCHK                                                        ARE IN THE LIMITS OF THE CURRENT MODE.
022651,001455: 
022652,001456:                                                                                          	# FUNCTIONAL DESCRIPTION_
022653,001457: 
022654,001458:                                                                                          	#       RRLIMCHK CHECKS RR DESIRED GIMBAL ANGLES TO SEE IF THEY ARE WITHIN
022655,001459:                                                                                          	#       THE LIMITS OF THE CURRENT MODE.  INITIALLY THE DESIRED TRUNNION AND
022656,001460:                                                                                          	#       SHAFT ANGLES ARE STORED IN ITEMP1 AND ITEMP2.  THE CURRENT RR
022657,001461:                                                                                          	#       ANTENNAE MODE (RADMODES BIT 12) IS CHECKED WHICH IS = 0 FOR
022658,001462:                                                                                          	#       MODE 1 AND =1 FOR MODE 2.
022659,001463: 
022660,001464:                                                                                          	#       MODE 1 - THE TRUNNION ANGLE IS CHECKED AT MAGSUB TO SEE IF IT IS
022661,001465:                                                                                          	#       BETWEEN -55 AND +55 DEGREES.  IF NOT, RETURN TO L +2.  IF WITHIN LIMITS,
022662,001466:                                                                                          	#       THE SHAFT ANGLE IS CHECKED TO SEE IF IT IS BETWEEN -70 AND +59 DEGREES.
022663,001467:                                                                                          	#       IF NOT, RETURN TO L +2.  IF IN LIMITS, RETURN TO L +3.
022664,001468: 
022665,001469:                                                                                          	#       MODE 2 - THE SHAFT ANGLE IS CHECKED AT MAGSUB TO SEE IF IT IS
022666,001470:                                                                                          	#       BETWEEN -139 AND -25 DEGREES.  IF NOT, RETURN TO L +2.  IF WITHIN
022667,001471:                                                                                          	#       LIMITS, THE TRUNNION ANGLE IS CHECKED TO SEE IF IT IS BETWEEN +125
022668,001472:                                                                                          	#       AND -125 (+235) DEGREES.  IF NOT, RETURN TO L +2.  IF IN LIMITS, RETURN
022669,001473:                                                                                          	#       TO L +3.
022670,001474: 
022671,001475:                                                                                          	# CALLING SEQUENCE:
022672,001476: 
022673,001477:                                                                                          	#       L  TC  RRLIMCHK (WITH INTERRUPT INHIBITED)
022674,001478:                                                                                          	#       L  +1  ADRES  T,S  (DESIRED TRUNNION ANGLE ADDRESS)
022675,001479: 
022676,001480:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:
022677,001481: 
022678,001482:                                                                                          	#       RADMODES, MODEA, MODEB (OR DESIRED TRUNNION AND SHAFT
022679,001483:                                                                                          	#       ANGLES ELSEWHERE IN CONSECUTIVE LOCATIONS - UNSWITCHED ERASABLE OR
022680,001484:                                                                                          	#       CURRENT EBANK).

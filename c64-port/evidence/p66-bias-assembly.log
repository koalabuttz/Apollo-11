029855,001479:                                                                                          	# ..... PERIAPO .....
029856,001480: 
029857,001481:                                                                                          	# MOD NO -1                     LOG SECTION - P34-P35, P74-P75
029858,001482:                                                                                          	# MOD BY WHITE.P                DATE 18JAN68
029859,001483: 
029860,001484:                                                                                          	# FUNCTIONAL DESCRIPTION
029861,001485: 
029862,001486:                                                                                          	#       THIS SUBROUTINE COMPUTES THE TWO BODY APOCENTER AND PERICENTER
029863,001487:                                                                                          	#       ALTITUDES GIVEN THE POSITION AND VELOCITY VECTORS FOR A POINT ON
029864,001488:                                                                                          	#       THE TRAJECTORY AND THE PRIMARY BODY.
029865,001489: 
029866,001490:                                                                                          	#       SETRAD IS CALLED TO DETERMINE THE RADIUS OF THE PRIMARY BODY.
029867,001491: 
029868,001492:                                                                                          	#       APSIDES IS CALLED TO SOLVE FOR THE TWO BODY RADII OF APOCENTER AND
029869,001493:                                                                                          	#       PERICENTER AND THE ECCENTRICITY OF THE TRAJECTORY.
029870,001494: 
029871,001495:                                                                                          	# CALLING SEQUENCE
029872,001496: 
029873,001497:                                                                                          	#       L       CALL
029874,001498:                                                                                          	#       L+1             PERIAPO
029875,001499:                                                                                          	#       L+2     (RETURN - ALWAYS)
029876,001500: 
029877,001501:                                                                                          	# INPUT
029878,001502: 
029879,001503:                                                                                          	#       (1)     RVEC    POSITION VECTOR IN METERS
029880,001504:                                                                                          	#                       SCALE FACTOR - EARTH +29, MOON +27
029881,001505:                                                                                          	#       (2)     VVEC    VELOCITY VECTOR IN METERS/CENTISECOND
029882,001506:                                                                                          	#                       SCALE FACTOR - EARTH +7, MOON +5
029883,001507:                                                                                          	#       (3)     X1      PRIMARY BODY INDICATOR
029884,001508:                                                                                          	#                       EARTH -2, MOON -10
029885,001509: 
029886,001510:                                                                                          	# OUTPUT
029887,001511: 
029888,001512:                                                                                          	#       (1)     2D      APOCENTER RADIUS IN METERS
029889,001513:                                                                                          	#                       SCALE FACTOR - EARTH +29, MOON +27
029890,001514:                                                                                          	#       (2)     4D      APOCENTER ALTITUDE IN METERS
029891,001515:                                                                                          	#                       SCALE FACTOR - EARTH +29, MOON P27
029892,001516:                                                                                          	#       (3)     6D      PERICENTER RADIUS IN METERS
029893,001517:                                                                                          	#                       SCALE FACTOR - EARTH +29, MOON +27
029894,001518:                                                                                          	#       (4)     8D      PERICENTER ALTITUDE IN METERS
029895,001519:                                                                                          	#                       SCALE FACTOR - EARTH +29, MOON +27
029896,001520:                                                                                          	#       (5)     ECC     ECCENTRICITY OF CONIC TRAJECTORY
029897,001521:                                                                                          	#                       SCALE FACTOR - +3
029898,001522:                                                                                          	#       (6)     XXXALT  RADIUS OF THE PRIMARY BODY IN METERS
029899,001523:                                                                                          	#                       SCALE FACTOR - EARTH +29, MOON +27
029900,001524:                                                                                          	#       (7)     PUSHLOC EQUALS 10D
029901,001525: 
029902,001526:                                                                                          	# SUBROUTINES USED
029903,001527: 
029904,001528:                                                                                          	#       SETRAD
029906,001530:                                                                                          	#       APSIDES
029907,001531: 

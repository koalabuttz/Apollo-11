059206,000122: 10,3566           30134                           CA       BUF2       +1                 	#
059207,000123: 10,3567           05576                           TC       PRIOENT    +1                 	# * LEAVE L ALONE
059208,000124: 10,3570           77467        -2SEC              DEC      -200       B-14               	# *** DONT MOVE
059209,000125: 10,3571           35006                           CAF      V05N09                        	#
059210,000126: 10,3572           12504                           TCF      PRIODSPR                      	#

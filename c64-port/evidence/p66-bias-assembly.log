049509,000032:                                                                                          	##
049510,000033:                                                                                          	## Notations on the hardcopy document read, in part:
049511,000034:                                                                                          	##
049512,000035:                                                                                          	##    Assemble revision 001 of AGC program LMY99 by NASA 2021112-061
049513,000036:                                                                                          	##    16:27 JULY 14, 1969
049514,000037: 
049516,000039:                                                                                          	# PROGRAM DESCRIPTION - ENTIRE CONIC SUBROUTINE LOG SECTION     DATE - 1 SEPTEMBER 1967
049517,000040:                                                                                          	# MOD NO. - 0                                                   LOG SECTION - CONIC SUBROUTINES
049518,000041:                                                                                          	# MOD BY KRAUSE                                                 ASSEMBLY - COLOSSUS REVISION 88
049519,000042: 
049520,000043:                                                                                          	# FUNCTIONAL DESCRIPTION -
049521,000044:                                                                                          	#       THE FOLLOWING SET OF SUBROUTINES SOLVE VARIOUS PROBLEMS INVOLVING THE TRAJECTORY PRODUCED BY A CENTRAL
049522,000045:                                                                                          	# INVERSE-SQUARE FORCE ACTING ON A POINT MASS, AS OUTLINED IN THE CMC AND LGC LUNAR LANDING MISSION GSOP, SECTION
049523,000046:                                                                                          	# 5.5.1.2.  A GENERAL USAGE POINT-OF-VIEW WAS TAKEN IN FORMULATING, MECHANIZING, AND SCALING THE SUBROUTINES,
049524,000047:                                                                                          	# RATHER THAN OPTIMIZING EACH FOR A PARTICULAR USE.  THEREFORE, MULTIPLE USAGE CAN BE MADE OF THE SUBROUTINES
049525,000048:                                                                                          	# INVOLVING ANY REALISTIC SET OF CONSTRAINTS.  IT SHOULD BE NOTED THAT ONLY ONE SET OF CODING IS USED, WHETHER THE
049526,000049:                                                                                          	# EARTH, MOON, OR ANY OTHER CELESTIAL BODY IS SPECIFIED AS THE CENTRAL BODY OF THE PROBLEM, PROVIDED ONE OBSERVES
049527,000050:                                                                                          	# THE INHERENT SCALE CHANGE REQUIRED IN POSITION, VELOCITY, MU, AND TIME, AS OUTLINED IN MISSION PROGRAMMING
049528,000051:                                                                                          	# DEFINITION MEMO NO. 10.  THIS CAN BE ACCOMPLISHED BY SIMPLY ADDING TO THE MUTABLE AND INITIALIZING THE SUBROU-
049529,000052:                                                                                          	# TINES APPROPRIATELY.
049530,000053: 
049531,000054:                                                                                          	#       DUE TO THE UNIFORMITY OF THE EQUATIONS INVOLVED, CODING WAS MINIMIZED BY TREATING INDIVIDUAL EQUATIONS AND
049532,000055:                                                                                          	# BLOCKS OF EQUATIONS AS SUBROUTINES OF LOWER RANK WHENEVER POSSIBLE.  AS A RESULT, THREE BY-PRODUCTS SUBROUTINES,
049533,000056:                                                                                          	# DIRECTLY USABLE AS INDEPENDENT SUBROUTINES, WERE GENERATED.
049534,000057: 
049535,000058:                                                                                          	# RESTRICTIONS -
049536,000059:                                                                                          	#       THE ONLY LIMITATION IN THE SCOPE OF PROBLEM WHICH CAN BE SOLVED BY A PARTICULAR SUBROUTINE IS THE SCALING
049537,000060:                                                                                          	# LIMIT OF EACH PARAMETER AS SPECIFIED IN THE GSOP.  THESE SCALING LIMITS WERE CHOSEN SO THAT ALL FEASIBLE TRAJEC-
049538,000061:                                                                                          	# TORIES COULD BE HANDLED.
049539,000062: 
049540,000063:                                                                                          	#       SINCE THE SUBROUTINES (EXCEPT KEPLER) USE COMMON SUBROUTINES OF LOWER RANK WHICH USE ERASABLE OTHER THAN
049541,000064:                                                                                          	# THE PUSHLIST (DUE TO ITS LIMITED SIZE) AND COMMON INTERPRETIVE SWITCHES, THE CONIC SUBROUTINES CANNOT BE ALLOWED
049542,000065:                                                                                          	# TO INTERRUPT EACH OTHER.  IT IS UP TO THE USER TO GUARANTEE THIS CONDITION.
049543,000066: 
049545,000068:                                                                                          	# PROGRAM DESCRIPTION - KEPLER SUBROUTINE                       DATE - 11 OCTOBER 1967
049546,000069:                                                                                          	# MOD NO. -1                                                    LOG SECTION - CONIC SUBROUTINES
049547,000070:                                                                                          	# MOD BY KRAUSE                                                 ASSEMBLY - COLOSSUS 103 AND SUNDANCE 222
049548,000071:                                                                                          	# MOD NO. - 2 (AUGUST 1968) BY ROBERTSON: TO PERMIT BACKDATING BY MORE THAN ONE ORBITAL PERIOD.
049549,000072:                                                                                          	# MOD NO. - 3 (DEC 1968) BY ROBERTSON:  SUPPRESSION OF X-MODULO-ING
049550,000073:                                                                                          	# MOD. NO. - 4 (JAN 1969) BY ROBERTSON:  CLEAR OVFIND AT KEPLER ENTRY
049551,000074: 
049552,000075:                                                                                          	# FUNCTIONAL DESCRIPTION -
049553,000076:                                                                                          	#       THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR AND THE DESIRED TRANSFER TIME THROUGH WHICH THE STATE IS TO
049554,000077:                                                                                          	# BE UPDATED ALONG A CONIC TRAJECTORY, COMPUTES THE NEW, UPDATED STATE VECTOR.  THE TRAJECTORY MAY BE ANY CONIC
049555,000078:                                                                                          	# SECTION - CIRCULAR, ELLIPTIC, PARABOLIC, HYPERBOLIC, OR RECTILINEAR WITH RESPECT TO THE EARTH OR THE MOON.  THE
049556,000079:                                                                                          	# USE OF THE SUBROUTINE CAN BE EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WITHOUT
049557,000080:                                                                                          	# INTRODUCING ANY CODING CHANGES, ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.  AN ITERA-
049558,000081:                                                                                          	# TION TECHNIQUE IS UTILIZED IN THE COMPUTATION.
049559,000082: 
049560,000083:                                                                                          	#       IF A NEGATIVE TIME-OF-FLIGHT IS INPUT, THE PROGRAM WILL SOLVE FOR THE STATE WHICH WOULD BE PRODUCED BY
049561,000084:                                                                                          	# EXTRAPOLATING THE POSITION BACKWARD IN TIME.
049562,000085: 
049563,000086:                                                                                          	#       IF THE ABSOLUTE VALUE OF THE DESIRED TRANSFER TIME EXCEEDS THE ORBITAL PERIOD, THE SUBROUTINE, THROUGH A
049564,000087:                                                                                          	#  MODULAR TECHNIQUE, WILL COMPUTE THE STATE CORRESPONDING TO THE DESIRED TIME (WHETHER POSITIVE OR NEGATIVE).
049565,000088: 
049566,000089:                                                                                          	# THE RESTRICTIONS ARE -
049567,000090:                                                                                          	#       1. (PREVIOUS RESTRICTION ON THE NEGATIVE DESIRED TRANSFER TIME IS NOW DELETED.)
049568,000091:                                                                                          	#       2. THE PARAMETERS IN THE PROBLEM CANNOT EXCEED THEIR SCALING LIMITS AS SPECIFIED IN THE GSOP.  IF
049569,000092:                                                                                          	#          ANY OF THESE LIMITS ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
049570,000093: 
049571,000094:                                                                                          	#       THE NUMBER OF ITERATIONS AND, THEREFORE, THE COMPUTATION SPEED IS DEPENDENT ON THE ACCURACY OF THE
049572,000095:                                                                                          	# GUESS, XKFPNEW.  THE AGC COMPUTATION TIME IS APPROXIMATELY .061 SECONDS FOR INITIALIZATION, .065 SECONDS FOR THE
049573,000096:                                                                                          	# FINAL COMPUTATIONS, PLUS .083 SECONDS FOR EACH ITERATION.
049574,000097: 
049575,000098:                                                                                          	# REFERENCES -
049576,000099:                                                                                          	#       R-479, MISSION PROGRAMMING DEFINITION MEMO NO. 10, LUNAR LANDING MISSION GSOP, SECTION 5.5, SGA
049577,000100:                                                                                          	#       MEMO 67-4.
049578,000101: 
049579,000102:                                                                                          	# INPUT - ERASABLE INITIALIZATION REQUIRED
049580,000103:                                                                                          	#                       * SCALE FACTOR  *
049581,000104:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *               DESCRIPTION AND REMARKS
049582,000105:                                                                                          	#       --------        *-------------- *               -----------------------
049583,000106:                                                                                          	#       RRECT           * +29 FOR EARTH *       DP INITIAL POSITION VECTOR IN METERS
049584,000107:                                                                                          	#                       * +27 FOR MOON  *
049586,000109:                                                                                          	#       VRECT           * +7 FOR EARTH  *       DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
049587,000110:                                                                                          	#                       * +5 FOR MOON   * 
049588,000111:                                                                                          	#       X1 (38D)        * NONE          *       INDEX REGISTER SET TO -2D OR -10D ACCORDING TO WHETHER THE EARTH OR MOON,
049589,000112:                                                                                          	#                       *               *               RESPECTIVELY, IS THE CENTRAL BODY
049590,000113:                                                                                          	#       TAU.            * +28           *       DESIRED TRANSFER TIME IN CENTISECONDS (DP)
049591,000114:                                                                                          	#                       *               *               MAY BE POS OR NEG AND ABSOLUTE VALUE MAY BE GREATER OR LESS THAN ONE ORBITAL PERIOD.
049592,000115:                                                                                          	#       XKEPNEW         * +17 FOR EARTH *       DP GUESS OF ROOT X OF KEPLERS EQN IN SQRT(METERS). SIGN SHOULD AGREE WITH THAT OF TAU.
049593,000116:                                                                                          	#                       * +16 FOR MOON  *               AND ABS VALUE SHOULD BE LESS THAN THAT CORRESPONDING TO A PERIOD, VIZ, 2PI SQRT(SEMI-
049594,000117:                                                                                          	#                       *               *               MAJOR AXIS), FOR SPEED OF CONVERGENCE, BUT IF EITHER CONDITION FAILS, XKEPNEW IS RESET
049595,000118:                                                                                          	#                       *               *               BY KEPLER TO A POOR BUT VALID GUESS.
049596,000119:                                                                                          	#       TC              * +28           *       DP PREV. VALUE OF TIME IN CENTISECS.  MUST BE LESS THAN ONE ORBITAL PERIOD.
049597,000120:                                                                                          	#       XPREV           * +17 FOR EARTH *       DP PREV. VALUE OF X IN SQRT(METERS).  MUST BE LESS THAN AN X CORRESPONDING TO ONE
049598,000121:                                                                                          	#                       * +16 FOR MOON  *               ORBITAL PERIOD, VIZ, 2PI SQRT(SEMI-MAJOR AXIS)
049599,000122: 
049600,000123:                                                                                          	# SUBROUTINES CALLED -
049601,000124:                                                                                          	#       DELTIME
049602,000125: 
049603,000126:                                                                                          	# CALLING SEQUENCE AND NORMAL EXIT MODES -
049604,000127:                                                                                          	#       KEPRTN-2        GOTO                    MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
049605,000128:                                                                                          	#       KEPRTN-1                KEPLER          RETURNS WITH XPREV IN MPAC. PL IS AT 0.
049606,000129:                                                                                          	#       KEPRTN          ...                     CONTINUE
049607,000130: 
049608,000131:                                                                                          	# KEPLER MUST NOT BE CALLED DIRECTLY SINCE AN INTERRUPTION OF IT WOULD DESTROY THE ERASABLES IT NEEDS TO COMPLETE
049609,000132:                                                                                          	# THE INTERRUPTED JOB.  THEREFORE THE USER MUST CALL CSMCONIC OR LEMCONIC WHICH GUARANTEES NO INTERRUPTS AND WHICH
049610,000133:                                                                                          	# ALSO CALLS KEPPREP TO COMPUTE A GUESS OF XKEPNEW.
049611,000134: 
049612,000135:                                                                                          	# ABORT EXIT MODES -
049613,000136:                                                                                          	#       NONE
049614,000137: 
049615,000138:                                                                                          	# OUTPUT -
049616,000139:                                                                                          	#                       * SCALE FACTOR  *
049617,000140:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *       DESCRIPTION AND REMARKS
049618,000141:                                                                                          	#       --------        *-------------- *       -----------------------
049619,000142:                                                                                          	#       RCV             * +29 FOR EARTH *       DP TERMINAL POSITION VECTOR IN METERS
049620,000143:                                                                                          	#                       * +27 FOR MOON  *
049621,000144:                                                                                          	#       VCV             * +7 FOR EARTH  *       DP TERMINAL VELOCITY VECTOR IN METERS/CENTISEC
049622,000145:                                                                                          	#                       * +5 FOR MOON   *
049623,000146:                                                                                          	#       TC              * +28           *       DP TRANSFER TIME IN CENTISECS TO WHICH KEPLER CONVERGED. ALWAYS LESS THAN ONE PERIOD.
049624,000147:                                                                                          	#       XPREV           * +17 FOR EARTH *       DP VALUE OF X IN SQRT(METERS) TO WHCIH KEPLER CONVERGED. ALWAYS LESS THAN THE X
049625,000148:                                                                                          	#                       * +16 FOR MOON  *               CORRESPONDING TO ONE PERIOD.
049627,000150:                                                                                          	# FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
049628,000151: 
049629,000152:                                                                                          	# DEBRIS -
049630,000153:                                                                                          	#       PARAMETERS WHICH MAY BE OF USE -
049631,000154:                                                                                          	#                       * SCALE FACTOR  *
049632,000155:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *       DESCRIPTION AND REMARKS
049633,000156:                                                                                          	#       --------        *-------------- *       -----------------------
049634,000157:                                                                                          	#       URRECT          * +1            *       DP UNIT VECTOR OF INITIAL POSITION
049635,000158:                                                                                          	#       R1              * +29 FOR EARTH *       DP MAGNITUDE OF INITIAL POSITION IN METERS
049636,000159:                                                                                          	#                       * +27 FOR MOON  *
049637,000160:                                                                                          	#       ALPHA           * -22 FOR EARTH *       DP INVERSE OF SEMIMAJOR AXIS IN 1/METERS
049638,000161:                                                                                          	#                       * -20 FOR MOON  *
049639,000162:                                                                                          	#       TMODULO         * +28           *       DP INTEGRAL NUMBER OF PERIODS IN CENTISECS. WHICH WAS SUBTRACTED FROM TAU. TO PRODUCE A
049640,000163:                                                                                          	#                       *               *       TAU. OF LESS THAN ONE PERIOD.
049641,000164: 
049642,000165:                                                                                          	# PARAMETERS OF NO USE -
049643,000166:                                                                                          	#       DP PARAMETERS - EPSILONT, DELX, DELT, RCNORM, XMODULO, PLUS PUSHLIST REGISTERS 0 THROUGH 39D.
049644,000167: 
049646,000169: 
049647,000170:                                                                                          	# PROGRAM DESCRIPTION - LAMBERT SUBROUTINE                      DATE - 1 SEPTEMBER 1967
049648,000171:                                                                                          	# MOD NO. - 0                                                   LOG SECTION - CONIC SUBROUTINES
049649,000172:                                                                                          	# MOD BY KRAUSE                                                 ASSEMBLY - COLOSSUS REVISION 88
049650,000173: 
049651,000174:                                                                                          	# FUNCTIONAL DESCRIPTION -
049652,000175:                                                                                          	#       THIS SUBROUTINE CALCULATES THE INITIAL VELOCITY REQUIRED TO TRANSFER A POINT-MASS ALONG A CONIC TRAJECTORY
049653,000176:                                                                                          	# FROM AN INITIAL POSITION TO A TERMINAL POSITION IN A PRESCRIBED TIME INTERVAL.  THE RESULTING TRAJECTORY MAY BE
049654,000177:                                                                                          	# A SECTION OF A CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO THE EARTH OR THE MOON.  THE USE OF THE
049655,000178:                                                                                          	# SUBROUTINE CAN BE EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WITHOUT INTRODUCING ANY
049656,000179:                                                                                          	# CODING CHANGES, ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.  AN ITERATION TECHNIQUE IS
049657,000180:                                                                                          	# UTILIZED IN THE COMPUTATION.
049658,000181: 
049659,000182:                                                                                          	# THE RESTRICTIONS ARE -
049660,000183:                                                                                          	#       1. RECTILINEAR TRAJECTORIES CANNOT BE COMPUTED.
049661,000184:                                                                                          	#       2. AN ACCURACY DEGRADATION OCCURS AS THE COSINE OF THE TRUE ANOMALY DIFFERENCE APPROACHES +1.0.
049662,000185:                                                                                          	#       3. THE ANGLE BETWEEN ANY POSITION VECTOR AND ITS VELOCITY VECTOR MUST BE GREATER THAN 1 DEGREE 47.5 MINUTES
049663,000186:                                                                                          	#          AND LESS THAN 178 DEGREES 12.5 MINUTES.
049664,000187:                                                                                          	#       4. NEGATIVE TRANSFER TIME IS AMBIGUOUS AND WILL RESULT IN NO SOLUTION.
049665,000188:                                                                                          	#       5. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE
049666,000189:                                                                                          	#          LIMITS ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
049667,000190: 
049668,000191:                                                                                          	#       THE NUMBER OF ITERATIONS AND, THEREFORE, THE COMPUTATIONS SPEED IS DEPENDENT ON THE ACCURACY OF THE FIRST
049669,000192:                                                                                          	# GUESS OF THE INDEPENDENT VARIABLE, COGA.                                 THE AGC COMPUTATION TIME IS APPROXIMATE-
049670,000193:                                                                                          	# LY .105 SECONDS FOR INITIALIZATION, .069 SECONDS FOR FINAL COMPUTATIONS, PLUS .205 SECONDS FOR EACH ITERATION.
049671,000194: 
049672,000195:                                                                                          	# REFERENCES -
049673,000196:                                                                                          	#       R-479, MISSION PROGRAMMING DEFINITION MEMO NO. 10, LUNAR LANDING MISSION GSOP - SECTION 5.5, SGA MEMO 67-8,
049674,000197:                                                                                          	#       SGA MEMO 67-4.
049675,000198: 
049676,000199:                                                                                          	# INPUT - ERASABLE INITIALIZATION REQUIRED
049677,000200:                                                                                          	# 
049678,000201:                                                                                          	#                       * SCALE FACTOR  *
049679,000202:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *       DESCRIPTION AND REMARKS
049680,000203:                                                                                          	#       --------        *-------------- *       -----------------------
049681,000204:                                                                                          	#       R1VEC           * +29 FOR EARTH *       DP INITIAL POSITION VECTOR IN METERS
049682,000205:                                                                                          	#                       * +27 FOR MOON  *
049683,000206:                                                                                          	#       R2VEC           * +29 FOR EARTH *       DP TARGET OR TERMINAL POSITION VECTOR IN METERS
049684,000207:                                                                                          	#                       * +27 FOR MOON  *
049685,000208:                                                                                          	#       TDESIRED        * +28           *       DP DESIRED TRANSFER TIME IN CENTISECONDS
049686,000209:                                                                                          	#       X1 (38D)        * NONE          *       INDEX REGISTER SET TO -2D OR -10D ACCORDING TO WHETHER THE EARTH OR MOON,
049687,000210:                                                                                          	#                       *               *               RESPECTIVELY, IS THE CENTRAL BODY
049688,000211:                                                                                          	#       GEOMSGN         * NONE          *       SP +.5 IF DESIRED TRANSFER ANGLE IS LESS THAN 180 DEGREES, -.5 IF GREATER THAN 180 DEG.
049689,000212:                                                                                          	#       GUESSW          * NONE          *       AN INTERPRETER SWITCH TO BE SET IF NO GUESS OF COGA IS AVAILABLE, CLEAR IF A GUESS OF
049691,000214:                                                                                          	#                       *               *               COGA IS TO BE USED BY LAMBERT
049692,000215:                                                                                          	#       COGA            * +5            *       DP GUESS OF COTANGNT OF FLIGHT PATH ANGLE (MEASURED FROM VERTICAL).  THIS WILL BE
049693,000216:                                                                                          	#                                       *       IGNORED IF GUESSW IS SET.
049694,000217:                                                                                          	#       NORMSW          * NONE          *       AN INTERPRETER SWITCH TO BE SET IF UN IS TO BE AN INPUT TO THE SUBROUTINE, CLEAR IF
049695,000218:                                                                                          	#                       *               *               LAMBERT IS TO COMPUTE ITS OWN NORMAL (UN).
049696,000219:                                                                                          	#       UN              * +1            *       DP UNIT NORMAL TO THE DESIRED ORBIT PLANE IN THE DIRECTION OF THE RESULTING ANGULAR
049697,000220:                                                                                          	#                       *               *               MOMENTUM VECTOR.  THIS WILL BE IGNORED IF NORMSW IS CLEAR.
049698,000221:                                                                                          	#       VTARGTAG        * NONE          *       A S.P. TAG TO BE SET TO ZERO IF LAMBERT IS TO COMPUTE THE VELOCITY AT R2VEC AS WELL AS
049699,000222:                                                                                          	#                       *               *               AT R1VEC.
049700,000223:                                                                                          	#       ITERCTR         * NONE          *       A S.P. COUNTER WHICH SPECIFIES THE MAXIMUM NUMBER OF ITERATIONS ALLOWABLE.
049701,000224:                                                                                          	#                       *               *               (AN ITERATION MEANS A PASS THRU KEPLER EQN (DELTIME). AT LEAST ONE OF THESE MUST
049702,000225:                                                                                          	#                       *               *               ALWAYS OCCUR, EVEN IF COGA CORRESPONDING TO SOLUTION WERE INPUT AS A GUESS.)
049703,000226:                                                                                          	#                       *               *               TWENTY ITERATIONS ARE SUFFICIENT TO SOLVE ALL PROBLEMS INCLUDING THOSE WITHOUT GUESS.
049704,000227: 
049705,000228:                                                                                          	# SUBROUTINES CALLED -
049706,000229:                                                                                          	#       GEOM, GETX, DELTIME, ITERATOR, LAMENTER (PART OF NEWSTATE)
049707,000230: 
049708,000231:                                                                                          	# CALLING SEQUENCE AND NORMAL EXIT MODES -
049709,000232:                                                                                          	#       L       CALL                    MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
049710,000233:                                                                                          	#       L+1             LAMBERT         RETURNS WITH PL AT 0 AND WITH VVEC IN MPAC IF VTARGTAG WAS NON-ZERO OR VTARGET
049711,000234:                                                                                          	#                                       IN MPAC IF VTARGTAG WAS ZERO
049712,000235:                                                                                          	#       L+2     BON                     CONTINUE IF SOLNSW CLEAR SINCE SOLUTION IS ACCEPTABLE
049713,000236:                                                                                          	#       L+3             SOLNSW
049714,000237:                                                                                          	#       L+4             LAMABORT
049715,000238: 
049716,000239:                                                                                          	#       IF A LAMBERT RESULT IS TO BE A FIRST GUESS FOR THE NEXT LAMBERT CALCULATION, COGA MUST BE PRESERVED AND
049717,000240:                                                                                          	# GUESSW MUST BE CLEAR FOR EACH SUCCEEDING LAMBERT CALL.
049718,000241: 
049719,000242:                                                                                          	# ABORT EXIT MODES -
049720,000243:                                                                                          	#       IF SOLNSW WAS SET UPON EXITING, EITHER LAMBERT WAS ASKED TO COMPUTE A TRANSFER TOO NEAR 0 OR 360 DEG, OR T
049721,000244:                                                                                          	# WAS TOO SMALL TO PRODUCE A REALISTIC TRANSFER BETWEEN R1VEC AND R2VEC.  IN EITHER CASE THE FIX MUST BE MADE
049722,000245:                                                                                          	# ACCORDING TO THE NEEDS OF THE PARTICULAR USER.  THE ABORT EXIT MODE MAY BE CODED AS ...
049723,000246:                                                                                          	# LAMABORT      DLOAD   ABS             A MEASURE OF PROXIMITY TO 0 OR
049724,000247:                                                                                          	#                       1-CSTH          360 DEGREES.
049725,000248:                                                                                          	#               DSU     BMN
049726,000249:                                                                                          	#                       ONEBIT
049727,000250:                                                                                          	#                       CHANGER2        CHANGE R2VEC DIRECTION SLIGHTLY.
049728,000251:                                                                                          	#               DLOAD   DAD
049729,000252:                                                                                          	#                       TDESIRED
049730,000253:                                                                                          	#                       SOMETIME
049731,000254:                                                                                          	#               STCALL  TDESIRED        INCREASE TDESIRED
049732,000255:                                                                                          	#                       LAMBERT
049733,000256: 
049735,000258:                                                                                          	# OUTPUT -
049736,000259:                                                                                          	#                       * SCALE FACTOR  *
049737,000260:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *       DESCRIPTION AND REMARKS
049738,000261:                                                                                          	#       --------        *-------------- *       -----------------------
049739,000262:                                                                                          	#       VVEC            * +7 FOR EARTH  *       DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND REQUIRED TO SATISFY THE BOUNDARY VALUE
049740,000263:                                                                                          	#                       * +5 FOR MOON   *               PROBLEM.
049741,000264:                                                                                          	#       VTARGET         * +7 FOR EARTH  *       DP RESULTANT VELOCITY VECTOR AT R2VEC IN METERS/CENTISECOND.
049742,000265:                                                                                          	#                       * +5 FOR MOON   *
049743,000266:                                                                                          	#       SOLNSW          * NONE          *       INTERPRETER SWITCH WHICH IS SET IF THE SUBROUTINE CANNOT SOLVE THE PROBLEM, CLEAR IF THE
049744,000267:                                                                                          	#                       *               *               SOLUTION EXISTS.
049745,000268: 
049746,000269:                                                                                          	#       FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
049747,000270: 
049748,000271:                                                                                          	# DEBRIS -
049749,000272:                                                                                          	#       PARAMETERS WHICH MAY BE OF USE -
049750,000273: 
049751,000274:                                                                                          	#                       * SCALE FACTOR  *
049752,000275:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *       DESCRIPTION AND REMARKS
049753,000276:                                                                                          	#       --------        *-------------- *       -----------------------
049754,000277:                                                                                          	#       SNTH            * +1            *       DP SIN OF ANGLE BETWEEN R1VEC AND R2VEC
049755,000278:                                                                                          	#       CSTH            * +1            *       DP COSINE OF ANGLE
049756,000279:                                                                                          	#       1-CSTH          * +2            *       DP 1-CSTH
049757,000280:                                                                                          	#       COGA            * +5            *       DP COTAN OF INITIAL REQUIRED FLIGHT PATH ANGLE MEASURED FROM VERTICAL
049758,000281:                                                                                          	#       P               * +4            *       DP RATIO OF SEMILATUS RECTUM TO INITIAL RADIUS
049759,000282:                                                                                          	#       R1A             * +6            *       DP RATIO OF INITIAL RADIUS TO SEMIMAJOR AXIS
049760,000283:                                                                                          	#       R1 (32D)        * +29 FOR EARTH *       DP INITIAL RADIUS IN METERS
049761,000284:                                                                                          	#                       * +27 FOR MOON  *
049762,000285:                                                                                          	#       UR1             * +1            *       DP UNIT VECTOR OF R1VEC
049763,000286:                                                                                          	#       U2              * +1            *       DP UNIT VECTOR OF R2VEC
049764,000287: 
049765,000288:                                                                                          	#       PARAMETERS OF NO USE
049766,000289:                                                                                          	#               DP PARAMETERS - EPSILONL, CSTH-RHO, TPREV, TERRLAMB, R2, RTNLAMB (SP), PLUS PUSHLIST REGISTER 0 THROUGH 41D
049767,000290:                                                                                          	#               ADDITIONAL INTERPRETIVE SWITCHES USED - INFINFLG, 360SW, SLOPESW, ORDERSW
049768,000291: 
049770,000293:                                                                                          	# PROGRAM DESCRIPTION - TIME-THETA SUBROUTINE                   DATE - 1 SEPTEMBER 1967
049771,000294:                                                                                          	# MOD NO. - 0                                                   LOG SECTION - CONIC SUBROUTINES
049772,000295:                                                                                          	# MOD BY KRAUSE                                                 ASSEMBLY - COLOSSUS REVISION 88
049773,000296: 
049774,000297:                                                                                          	# FUNCTIONAL DESCRIPTION -
049775,000298:                                                                                          	#       THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR AND A DESIRED TRUE-ANOMALY-DIFFERENCE THROUGH WHICH THE
049776,000299:                                                                                          	# STATE IS TO BE UPDATED ALONG A CONIC TRAJECTORY, CALCULATES THE CORRESPONDING TIME-OF-FLIGHT AND, IN ADDITION,
049777,000300:                                                                                          	# PROVIDES THE OPTION OF COMPUTING THE NEW UPDATED STATE VECTOR.  THE RESULTING TRAJECTORY MAY BE A SECTION OF A
049778,000301:                                                                                          	# CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO THE EARTH OR THE MOON.  THE USE OF THE SUBROUTINE CAN BE
049779,000302:                                                                                          	# EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WITHOUT INTRODUCING ANY CODING CHANGES,
049780,000303:                                                                                          	# ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.
049781,000304: 
049782,000305:                                                                                          	# THE RESTRICTIONS ARE -
049783,000306:                                                                                          	#       1. THE ANGLE BETWEEN ANY POSITION VECTOR AND ITS VELOCITY VECTOR MUST BE GREATER THAN 1 DEGREE 47.5 MINUTES
049784,000307:                                                                                          	#          AND LESS THAN 178 DEGREES 12.5 MINUTES.
049785,000308:                                                                                          	#       2. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE LIMITS
049786,000309:                                                                                          	#          ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
049787,000310: 
049788,000311:                                                                                          	#       THE AGC COMPUTATION TIME IS APPROXIMATELY .292 SECONDS.
049789,000312: 
049790,000313:                                                                                          	# REFERENCES -
049791,000314:                                                                                          	#       R-479, MISSION PROGRAMMING DEFINITION MEMO NO. 10, LUNAR LANDING MISSION GSOP-SECTION 5.5, SGA MEMO 67-8.
049792,000315: 
049793,000316:                                                                                          	# INPUT - ERASABLE INITIALIZATION REQUIRED
049794,000317:                                                                                          	#                       * SCALE FACTOR  *
049795,000318:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *       DESCRIPTION AND REMARKS
049796,000319:                                                                                          	#       --------        *-------------- *       -----------------------
049797,000320:                                                                                          	#       RVEC            * +29 FOR EARTH *       DP INITIAL POSITION VECTOR IN METERS
049798,000321:                                                                                          	#                       * +27 FOR MOON  *
049799,000322:                                                                                          	#       VVEC            * +7 FOR EARTH  *       DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
049800,000323:                                                                                          	#                       * +5 FOR MOON   *
049801,000324:                                                                                          	#       SNTH            * +1            *       DP SINE OF TRUE-ANOMALY-DIFFERENCE THROUGH WHICH THE STATE IS TO BE UPDATED
049802,000325:                                                                                          	#       CSTH            * +1            *       DP COSINE OF THE ANGLE
049803,000326:                                                                                          	#       RVSW            * NONE          *       AN INTERPRETIVE SWITCH TO BE SET IF ONLY TIME IS TO BE AN OUTPUT, CLEAR IF THE NEW STATE
049804,000327:                                                                                          	#                       *               *               IS TO BE COMPUTED ALSO.
049805,000328:                                                                                          	#       X1 (38D)        * NONE          *       INDEX REGISTER TO BE SET TO -2D OR -10D ACCORDING TO WHETHER THE EARTH OR MOON,
049806,000329:                                                                                          	#                       *               *               RESPECTIVELY, IS THE CENTRAL BODY.
049807,000330: 
049808,000331:                                                                                          	# SUBROUTINES CALLED -
049810,000333:                                                                                          	#       PARAM, GEOM, GETX, DELTIME, NEWSTATE
049811,000334: 
049812,000335:                                                                                          	# CALLING SEQUENCE AND NORMAL EXIT MODES -
049813,000336:                                                                                          	#       IF ONLY TIME IS DESIRED AS OUTPUT -
049814,000337:                                                                                          	#       L       SET     CALL            MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
049815,000338:                                                                                          	#       L+1             RVSW
049816,000339:                                                                                          	#       L+2             TIMETHET        RETURN WITH PL AT 0 AND T IN MPAC
049817,000340:                                                                                          	#       L+3     ...                     CONTINUE
049818,000341: 
049819,000342:                                                                                          	#       IF THE UPDATE STATE VECTOR IS DESIRED AS WELL -
049820,000343:                                                                                          	#       L       CLEAR   CALL            MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
049821,000344:                                                                                          	#       L+1             RVSW
049822,000345:                                                                                          	#       L+2             TIMETHET        RETURNS WITH PL AT 6.  THE INITIAL POSITION VECTOR IS IN 0D OF THE PUSHLIST AND
049823,000346:                                                                                          	#                                       THE INITIAL VELOCITY VECTOR IN MPAC.
049824,000347:                                                                                          	#       L+3     STOVL   NEWVVEC
049825,000348:                                                                                          	#       L+4     STADR
049826,000349:                                                                                          	#       L+5     STORE   NEWRVEC         NEWVVEC AND NEWRVEC ARE SYMBOLIC REPRESENTATIONS OF THE USERS LOCATIONS.
049827,000350:                                                                                          	#       L+6     ...                     CONTINUE
049828,000351: 
049829,000352:                                                                                          	# ABORT EXIT MODES -
049830,000353:                                                                                          	#       IF COGAFLAG AND/OR INFINFLG IS SET AT THE EXIT TO TIME-THETA, TIME-THETA WILL TRANSFER TO POODOO WITH
049831,000354:                                                                                          	#       AN ALARM CODE (ORIGINALLY 00607), AND NOT RETURN TO THE CALLING PROGRAM.  (PCR 692 AND 721).
049832,000355: 
049833,000356:                                                                                          	# OUTPUT -
049834,000357:                                                                                          	#                       * SCALE FACTOR  *
049835,000358:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *       DESCRIPTION AND REMARKS
049836,000359:                                                                                          	#       --------        *-------------- *       -----------------------
049837,000360:                                                                                          	#       T (30D)         * +28           *       DP TRANSFER TIME IN CENTISECONDS
049838,000361:                                                                                          	#       INFINFLG        * NONE          *       AN INTERPRETIVE SWITCH WHICH IS SET IF THE TRANSFER ANGLE REQUIRES CLOSURE THROUGH
049839,000362:                                                                                          	#                       *               *               INFINITY (NO SOLUTION), CLEAR IF A PHYSICAL SOLUTION IS POSSIBLE.
049840,000363:                                                                                          	#       COGAFLAG        * NONE          *       AN INTERPRETIVE SWITCH WHICH IS SET IF RESTRICTION 1 HAS BEEN VIOLATED (NO SOLUTION),
049841,000364:                                                                                          	#                       *               *               CLEAR IF NOT.
049842,000365: 
049843,000366:                                                                                          	#       IN ADDITION, IF RVSW IS CLEAR, THE FOLLOWING ARE OUTPUT -
049844,000367:                                                                                          	#       MPAC  -         * +7 FOR EARTH  *       DP TERMINAL VELOCITY VECTOR IN METERS/CENTISEC.
049845,000368:                                                                                          	#        MPAC +5        * +5 FOR MOON   *
049846,000369:                                                                                          	#       0D - 5D         * +29 FOR EARTH *       DP TERMINAL POSITION VECTOR IN METERS (PL AT 6D)
049847,000370:                                                                                          	#                       * +27 FOR MOON  *
049848,000371: 
049849,000372:                                                                                          	#       FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
049850,000373: 
049852,000375:                                                                                          	# DEBRIS -
049853,000376:                                                                                          	#       PARAMETERS WHICH MAY BE OF USE -
049854,000377:                                                                                          	# 
049855,000378:                                                                                          	#                       * SCALE FACTOR  *
049856,000379:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *       DESCRIPTION AND REMARKS
049857,000380:                                                                                          	#       --------        *-------------- *       -----------------------
049858,000381:                                                                                          	#       R1 (32D)        * +29 FOR EARTH *       DP MAGNITUDE OF INITIAL POSITION VECTOR, RVEC, IN METERS
049859,000382:                                                                                          	#                       * +27 FOR MOON  *
049860,000383:                                                                                          	#       R1A             * +6            *       DP RATIO OF R1 TO SEMIMAJOR AXIS (NEG. FOR HYPERBOLIC TRAJECTORIES)
049861,000384:                                                                                          	#       P               * +4            *       DP RATIO OF SEMILATUS RECTUM TO R1
049862,000385:                                                                                          	#       COGA            * +5            *       DP COTAN OF ANGLE BETWEEN RVEC AND VVEC
049863,000386:                                                                                          	#       UR1             * +1            *       DP UNIT VECTOR OF RVEC
049864,000387:                                                                                          	#       U2              * +1            *       DP UNIT VECTOR OF VVEC
049865,000388:                                                                                          	#       UN              * +1            *       DP UNIT VECTOR OF UR1*U2
049866,000389: 
049867,000390:                                                                                          	#       PARAMETERS OF NO USE -
049868,000391:                                                                                          	#       SP PARAMETERS - RTNTT, GEOMSGN, RTNPRM, MAGVEC2=R2 (DP), PLUS PUSHLIST LOCATIONS 0-11D, 14D-21D, 24D-39D, 41D
049869,000392:                                                                                          	#       ADDITIONAL INTERPRETIVE SWITCHES USED - NORMSW, 360SW
049870,000393: 

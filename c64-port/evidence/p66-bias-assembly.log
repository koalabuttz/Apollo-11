022855,001659:                                                                                          	# PROGRAM NAME_  RRZEROSB
022856,001660: 
022857,001661:                                                                                          	# FUNCTIONAL DESCRIPTION_
022858,001662:                                                                                          	#       RRZEROSB IS A CLOSED SUBROUTINE TO ZERO THE RR CDU:S,
022859,001663:                                                                                          	#       DETERMINE THE RR MODE, AND TURNS ON THE TRACKER FAIL
022860,001664:                                                                                          	#       LAMP IF REQUIRED.  INITIALLY THE RR CDU ZERO BIT (CHAN 12
022861,001665:                                                                                          	#       BIT 1) IS SET.  FOLLOWING A 20 MILLISECOND WAIT, THE LGC
022862,001666:                                                                                          	#       RR CDU COUNTERS (OPTY, OPTX) ARE SET = 0 AFTER 
022863,001667:                                                                                          	#       WHICH THE RR CDU ZERO DISCRETE (CHAN 12 BIT 1) IS
022864,001668:                                                                                          	#       REMOVED.  A 4 SECOND WAIT IS SET TO ALL THE RR CDU:S
022865,001669:                                                                                          	#       TO REPEAT THE ACTUAL TRUNNION AND SHAFT ANGLES.  THE
022866,001670:                                                                                          	#       RR CDU ZERO FLAG (RADMODES BIT 13) IS REMOVED.  THE
022867,001671:                                                                                          	#       CONTENTS OF OPTY IS THEN CHECKED TO SEE IF THE TRUNNION
022868,001672:                                                                                          	#       ANGLE IS LESS THAN 90 DEGREES.  IF NOT, BIT 12 OF
022869,001673:                                                                                          	#       RADMODES IS SET = 1 TO INDICATE RR ANTENNA MODE 2.
022870,001674:                                                                                          	#       IF LESS THAN 90 DEGREES, BIT 12 OF RADMODES IS SET = 0 TO
022871,001675:                                                                                          	#       INDICATE RR ANTENNA MODE 1.  SETTRKF IS THEN CALLED TO
022872,001676:                                                                                          	#       SEE IF THE TRACKER FAIL LAMP SHOULD BE TURNED ON.
022873,001677: 
022874,001678:                                                                                          	# CALLING SEQUENCE:  L  TC  RRZEROSB  (FROM RRTURNON AND RRZERO)
022875,001679: 

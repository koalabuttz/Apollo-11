016807,000328:                                                                                          	# IDADDTEM      =       TEM2            MIXNOUN INDIRECT ADDRESS STORAGE
016808,000329:                                                                                          	# TEM3          ERASE                   EXEC TEMP
016809,000330:                                                                                          	# COUNT         =       TEM3            FOR DSPIN
016810,000331: 
016812,000333:                                                                                          	# TEM4          ERASE                   EXEC TEMP
016813,000334:                                                                                          	# LSTPTR        =       TEM4            LIST POINTER FOR GRABUSY
016814,000335:                                                                                          	# RELRET        =       TEM4            RETURN FOR RELDSP
016815,000336:                                                                                          	# FREERET       =       TEM4            RETURN FOR FREEDSP
016816,000337:                                                                                          	# DSPWDRET      =       TEM4            RETURN FOR DSPSIGN
016817,000338:                                                                                          	# SEPSCRET      =       TEM4            RETURN FOR SEPSEC
016818,000339:                                                                                          	# SEPMNRET      =       TEM4            RETURN FOR SEPMIN
016819,000340: 
016820,000341:                                                                                          	# TEM5          ERASE                   EXEC TEMP
016821,000342:                                                                                          	# NOUNADD       =       TEM5            TEMP STORAGE FOR NOUN ADDRESS
016822,000343: 
016823,000344:                                                                                          	# NNADTEM       ERASE                   TEMP FOR NOUN ADDRESS TABLE ENTRY
016824,000345:                                                                                          	# NNTYPTEM      ERASE                   TEMP FOR NOUN TYPE TABLE ENTRY
016825,000346:                                                                                          	# IDAD1TEM      ERASE                   TEMP FOR INDIR ADRESS TABLE ENTRY (MIXNN)
016826,000347:                                                                                          	#                                       MUST = IDAD2TEM-1, = IDAD3TEM-2.
016827,000348:                                                                                          	# IDAD2TEM      ERASE                   TEMP FOR INDIR ADRESS TABLE ENTRY (MIXNN)
016828,000349:                                                                                          	#                                       MUST = IDAD1TEM+1, = IDAD3TEM-1.
016829,000350:                                                                                          	# IDAD3TEM      ERASE                   TEMP FOR INDIR ADRESS TABLE ENTRY (MIXNN)
016830,000351:                                                                                          	#                                       MUST = IDAD1TEM+2, = IDAD2TEM+1.
016831,000352:                                                                                          	# RUTMXTEM      ERASE                   TEMP FOR SF ROUT TABLE ENTRY (MIXNN ONLY)
016832,000353: 

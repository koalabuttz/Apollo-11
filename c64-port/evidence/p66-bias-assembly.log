007489,001151:                                                                                          	# PROGRAM NAME_ RRCDUCHK
007490,001152: 
007491,001153:                                                                                          	# FUNCTIONAL DESCRIPTION_
007492,001154:                                                                                          	# RRCDUCHK CHECKS FOR RR CDU FAIL (CHAN 30 BIT 7).  INITIALLY THE
007493,001155:                                                                                          	# RR CDU FAIL BIT IS SAMPLED (CHAN 30 BIT 7).  IF NO CHANGE, THE
007494,001156:                                                                                          	# PROGRAM EXITS TO RRGIMON.  IF A CHANGE, THE RR AUTO MODE
007495,001157:                                                                                          	# (RADMODES BIT 2) BIT IS CHECKED.  IF NOT IN RR AUTO MODE, THE
007496,001158:                                                                                          	# PROGRAM EXITS TO NORRGMON.  IF IN AUTO MODE, RADMODES BIT 7
007497,001159:                                                                                          	# (RR CDU OK) IS UPDATED AND IF P-20 IS OPERATING PROGRAM ALARM 00515 IS
007498,001160:                                                                                          	# REQUESTED.  CONTROL IS TRANSFERRED TO SETTRKF TO UPDATE
007499,001161:                                                                                          	# THE TRACKER FAIL LAMP (DSPTAB+11D BIT 8).  CONTROL RETURNS TO
007500,001162:                                                                                          	# RRGIMON.
007501,001163: 

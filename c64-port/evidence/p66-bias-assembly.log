029445,001069:                                                                                          	# MOD BY WHITE.P                DATE  21NOV67
029446,001070: 
029447,001071:                                                                                          	# FUNCTIONAL DESCRIPTION
029448,001072: 
029449,001073:                                                                                          	#       THIS SUBROUTINE COMPUTES THE REQUIRED INITIAL VELOCITY VECTOR FOR
029450,001074:                                                                                          	#       A TRAJECTORY OF SPECIFIED TRANSFER TIME BETWEEN SPECIFIED INITIAL
029451,001075:                                                                                          	#       AND TARGET POSITIONS.  THE TRAJECTORY MAY BE EITHER CONIC OR
029452,001076:                                                                                          	#       PRECISION DEPENDING ON AN INPUT PARAMETER (NAMELY, NUMBER OF
029453,001077:                                                                                          	#       OFFSETS).  IN ADDITION, IN THE PRECISION TRAJECTORY CASE, THE
029454,001078:                                                                                          	#       SUBROUTINE ALSO COMPUTES AN OFFSET TARGET VECTOR, TO BE USED
029455,001079:                                                                                          	#       DURING PURE-CONIC CROSS-PRODUCT STEERING.  THE OFFSET TARGET
029456,001080:                                                                                          	#       VECTOR IS THE TERMINAL POSITION VECTOR OF A CONIC TRAJECTORY WHICH
029457,001081:                                                                                          	#       HAS THE SAME INITIAL STATE AS A PRECISION TRAJECTORY WHOSE
029458,001082:                                                                                          	#       TERMINAL POSITION VECTOR IS THE SPECIFIED TARGET VECTOR.
029459,001083: 
029460,001084:                                                                                          	#       IN ORDER TO AVOID THE INHERENT SINGULARITIES IN THE 180 DEGREE
029461,001085:                                                                                          	#       TRANSFER CASE WHEN THE (TRUE OR OFFSET) TARGET VECTOR MAY BE
029462,001086:                                                                                          	#       SLIGHTLY OUT OF THE ORBITAL PLANE, THIS SUBROUTINE ROTATES THIS
029463,001087:                                                                                          	#       VECTOR INTO A PLANE DEFINED BY THE INPUT INITIAL POSITION VECTOR
029464,001088:                                                                                          	#       AND ANOTHER INPUT VECTOR (USUALLY THE INITIAL VELOCITY VECTOR),
029465,001089:                                                                                          	#       WHENEVER THE INPUT TARGET VECTOR LIES INSIDE A CONE WHOSE VERTEX
029466,001090:                                                                                          	#       IS THE ORIGIN OF COORDINATES, WHOSE AXIS IS THE 180 DEGREE
029467,001091:                                                                                          	#       TRANSFER DIRECTION, AND WHOSE CONE ANGLE IS SPECIFIED BY THE USER.
029468,001092: 
029469,001093:                                                                                          	#       THE LAMBERT SUBROUTINE IS UTILIZED FOR THE CONIC COMPUTATIONS AND
029470,001094:                                                                                          	#       THE COASTING INTEGRATION SUBROUTINE IS UTILIZED FOR THE PRECISION
029471,001095:                                                                                          	#       TRAJECTORY COMPUTATIONS.
029472,001096: 
029473,001097:                                                                                          	# CALLING SEQUENCE
029474,001098: 
029475,001099:                                                                                          	#       L       CALL
029476,001100:                                                                                          	#       L+1             INITVEL
029477,001101:                                                                                          	#       L+2     (RETURN - ALWAYS)
029478,001102: 
029479,001103:                                                                                          	# INPUT
029480,001104: 
029481,001105:                                                                                          	#       (1)     RINIT           INITIAL POSITION RADIUS VECTOR
029482,001106:                                                                                          	#       (2)     VINIT           INITIAL POSITION VELOCITY VECTOR
029483,001107:                                                                                          	#       (3)     RTARG           TARGET POSITION RADIUS VECTOR
029484,001108:                                                                                          	#       (4)     DELLT4          DESIRED TIME OF FLIGHT FROM RINIT TO RTARG
029485,001109:                                                                                          	#       (5)     INTIME          TIME OF RINIT
029486,001110:                                                                                          	#       (6)     0D              NUMBER OF ITERATIONS OF LAMBERT/INTEGRVS
029487,001111:                                                                                          	#       (7)     2D              ANGLE TO 180 DEGREES WHEN ROTATION STARTS
029488,001112:                                                                                          	#       (8)     RTX1            -2 FOR EARTH, -10D FOR LUNAR
029489,001113:                                                                                          	#       (9)     RTX2            COORDINATE SYSTEM ORIGIN - 0 FOR EARTH, 2 FOR LUNAR
029490,001114:                                                                                          	#       PUSHLOC SET AT 4D
029491,001115: 
029493,001117:                                                                                          	# OUTPUT
029494,001118: 
029495,001119:                                                                                          	#       (1)     RTARG           OFFSET TARGET POSITION VECTOR
029496,001120:                                                                                          	#       (2)     VIPRIME         MANEUVER VELOCITY REQUIRED
029497,001121:                                                                                          	#       (3)     VTPRIME         VELOCITY AT TARGET AFTER MANEUVER
029498,001122:                                                                                          	#       (4)     DELVEET3        DELTA VELOCITY REQUIRED FOR MANEUVER
029499,001123: 

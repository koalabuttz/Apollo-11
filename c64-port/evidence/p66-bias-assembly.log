007558,001220:                                                                                          	# PROGRAM NAME_  RRGIMON                                                E AUTO MODE EXCEPT WHEN THE RR CDUS ARE
007559,001221: 
007560,001222:                                                                                          	# FUNCTIONAL DESCRIPTION_                                               TTER IS INITIATED BY THIS MONITOR WHEN
007561,001223:                                                                                          	# RRGIMON IS THE RR GIMBAL LIMIT MONITOR.  INITIALLY THE FOLLOWING IS   ED TO DRIVE THE GIMBALS TO T = 0 AND
007562,001224:                                                                                          	# CHECKED_  REMODE, RR CDU:S BEING ZEROED, REPOSITION, AND RR
007563,001225:                                                                                          	# NOT IN AUTO MODE (RADMODES BITS 14, 13, 11 2). IF ANY OF THESE
007564,001226:                                                                                          	# EXIST THE PROGRAM EXITS TO GPMATRIX.  IF NONE ARE PRESENT RRLIMCHK
007565,001227:                                                                                          	# IS CALLED TO SEE IF THE PRESENT RR CDU ANGLES (OPTY, OPTX) ARE WITHIN
007566,001228:                                                                                          	# THE LIMITS OF THE CURRENT MODE.  IF WITHIN LIMITS, THE PROGRAM EXITS
007567,001229:                                                                                          	# TO NORRGMON.  IF NOT WITHIN LIMITS, THE REPOSITION FLAG (RADMODES
007568,001230:                                                                                          	# BIT 11) IS SET, THE RR AUTO TRACKER AND RR ERROR COUNTER
007569,001231:                                                                                          	# (CHAN 12 BITS 14, 2) ARE DISABLED, AND A 20 MILLISECOND WAITLIST
007570,001232:                                                                                          	# CALL IS SET FOR DORREPOS AFTER WHICH THE PROGRAM EXITS TO NORRGMON.
007571,001233: 
007572,001234:                                                                                          	# CALLING SEQUENCE_
007573,001235:                                                                                          	# EVERY 480 MILLISECONDS FROM RRCDUCHK (VIA T4RUPT) UNLESS TURN-ON
007574,001236:                                                                                          	# HAS JUST BEEN INITIATED VIA RRAUTCHK OR IF THERE HAS BEEN A CHANGE IN
007575,001237:                                                                                          	# THE RR CDU FAIL BIT (CHAN 30 BIT 7) AND THE RR IS NOT IN THE AUTO MODE
007576,001238:                                                                                          	# (RADMODES BIT 2).
007577,001239: 
007578,001240:                                                                                          	# ERASABLE INITIALIZATION_  RADMODES
007579,001241: 
007580,001242:                                                                                          	# SUBROUTINES CALLED_
007581,001243:                                                                                          	# RRLIMCHK, WAITLIST
007582,001244: 
007583,001245:                                                                                          	# JOBS OR TASKS INITIATED_
007584,001246:                                                                                          	# DORREPOS
007585,001247: 
007586,001248:                                                                                          	# ALARMS_
007587,001249:                                                                                          	# NONE
007588,001250: 
007589,001251:                                                                                          	# EXIT_
007590,001252:                                                                                          	# NORRGMON
007591,001253: 
007592,001254: 06,3071           30101        RRGIMON            CAE      FLAGWRD5                      	# IS NO ANGLE MONITOR FLAG SET
007593,001255: 06,3072           74750                           MASK     NORRMBIT                      	#
007594,001256: 06,3073           10000                           CCS      A                             	#
007595,001257: 06,3074           13132                           TCF      NORRGMON                      	# YES - SKIP LIMIT CHECK
007596,001258: 06,3075           40103                           CS       FLAGWRD7                      	# IS SERVICER RUNNING?
007597,001259: 06,3076           74747                           MASK     AVEGFBIT                      	#
007598,001260: 06,3077           10000                           CCS      A                             	#
007599,001261: 06,3100           13105                           TCF      +5                            	# NO. DO R25
007600,001262: 06,3101           30102                           CA       FLAGWRD6                      	# YES. IS MUNFLAG SET?
007601,001263: 06,3102           74744                           MASK     MUNFLBIT                      	#
007602,001264: 06,3103           10000                           CCS      A                             	#
007603,001265: 06,3104           13132                           TCF      NORRGMON                      	# YES. DON'T DO R25
007604,001266: 06,3105           33127                 +5        CAF      OCT32002                      	# INHIBIT BY REMODE, ZEROING, MONITOR.
007605,001267: 06,3106           70110                           MASK     RADMODES                      	# OR RR NOT IN AUTO.
007606,001268: 06,3107           10000                           CCS      A                             	#
007607,001269: 06,3110           13132                           TCF      NORRGMON                      	#
007609,001271: 06,3111           04523                           TC       RRLIMCHK                      	# SEE IF ANGLES IN LIMITS.
007610,001272: 06,3112           00035                           ADRES    CDUT                          	#
007611,001273: 
007612,001274: 06,3113           13115                           TCF      MONREPOS                      	#
007613,001275: 
007614,001276: 06,3114           13132                           TCF      NORRGMON                      	# (ADDITIONAL CODING MAY GO HERE).
007615,001277: 
007616,001278: 06,3115           34741        MONREPOS           CAF      REPOSBIT                      	# SET FLAG TO SHOW REPOSITION IN PROGRESS.
007617,001279: 06,3116           26110                           ADS      RADMODES                      	#
007618,001280: 
007619,001281: 06,3117           43130                           CS       OCT20002                      	# DISABLE TRACKER AND ERROR COUNTER.
007620,001282: 06,3120           00006                           EXTEND                                 	#
007621,001283: 06,3121           03012                           WAND     CHAN12                        	#
007622,001284: 
007623,001285: 06,3122           34752                           CAF      TWO                           	#
007624,001286: 06,3123           05203                           TC       WAITLIST                      	#
007625,001287: 06,3124  E7,1456                                  EBANK=   LOSCOUNT                      	#
007626,001288: 06,3124           02127 52107                     2CADR    DORREPOS                      	#
007627,001289: 
007628,001290: 06,3126           13132                           TCF      NORRGMON                      	#
007629,001291: 
007630,001292: 06,3127           32002        OCT32002           OCT      32002                         	#
007631,001293: 06,3130           20002        OCT20002           OCT      20002                         	#
007632,001294: 06,3131           02100        OCT02100           OCT      02100                         	# P20, P22 MASK BITS
007633,001295: 
007635,001297:                                                                                          	# PROGRAM NAME:  GPMATRIX (DAPT4S) MOD. NO. 2 DATE: OCTOBER 27, 1966
007636,001298: 
007637,001299:                                                                                          	# AUTHOR: JONATHAN D. ADDELSTON (ADAMS ASSOCIATES)
007638,001300: 
007639,001301:                                                                                          	# MODIFIED:  7FEB. 1968 BY P. S. WEISSMAN TO DELETE COMPUTATION OF MR12 AND MR13, WHICH ARE NO LONGER REQIURED.
007640,001302: 
007641,001303:                                                                                          	# THIS PROGRAM CALCULATES ALL THE SINGLE-PRECISION MATRIX ELEMENTS WHICH ARE USED BY LEM DAP TO TRANSFORM VECTORS
007642,001304:                                                                                          	# FROM GIMBAL TO PILOT (BODY) AXES AND BACK AGAIN.  THESE ELEMENTS ARE USED EXCLUSIVELY BY BASIC LANGUAGE ROUTINES
007643,001305:                                                                                          	# AND THEREFORE ARE NOT ARRAYED FOR USE BY INTERPRETIVE PROGRAMS.
007644,001306: 
007645,001307:                                                                                          	# CALLING SEQUENCE:  GPMATRIX IS TRANSFERRED TO FROM DAPT4S AND IS THUS EXECUTED 4 TIMES A SECOND BY T4RUPT.
007646,001308:                                                                                          	# DAPT4S IS LISTED IN T4JUMP TABLE TWICE EXPLICITLY AND ALSO OCCURS AFTER RRAUTCHK (WHICH IS ALSO LISTED TWICE).
007647,001309: 
007648,001310:                                                                                          	# SUBROUTINES CALLED: SPSIN, SPCOS.
007649,001311: 
007650,001312:                                                                                          	# NORMAL EXIT MODE:  TCF RESUME
007651,001313: 
007652,001314:                                                                                          	# ALARM AND ABORT MODES:  NONE.
007653,001315: 
007654,001316:                                                                                          	# INPUT: CDUX, CDUY, CDUZ.
007655,001317: 
007656,001318:                                                                                          	# OUTPUT:  M11, M21, M31, M22, M32.
007657,001319: 
007658,001320:                                                                                          	# AOG = CDUX, AIG = CDUY, AMG = CDUZ: MNEMONIC IS : OIM = XYZ
007659,001321: 
007660,001322:                                                                                          	#               *       *       SIN(MG)                 0                       1       *
007661,001323:                                                                                          	#               M   =   *       COS(MG)COS(OG)          SIN(OG)                 0       *
007662,001324:                                                                                          	#                GP     *       -COS(MG)SIN(OG)         COS(OG)                 0       *
007663,001325: 
007664,001326:                                                                                          	#               *       *       0                       COS(OG)/COS(MG)         -SIN(OG)/COS(MG)        *
007665,001327:                                                                                          	#               M   =   *       0                       SIN(OG)                 COS(OG)                 *
007666,001328:                                                                                          	#                PG     *       1                       -SIN(MG)COS(OG)/COS(MG) SIN(MG)SIN(OG)/COS(MG)  *
007667,001329: 
007668,001330: 06,3132  E6,1414                                  EBANK=   M11                           	#
007669,001331: 06,3132  06,3132               DAPT4S             EQUALS   GPMATRIX                      	#
007670,001332: 
007671,001333:                                                                                          	# T4RUPT DAP LOGIC:
007672,001334: 
007673,001335: 06,3132           30034        GPMATRIX           CAE      CDUZ                          	# SINGLE ENTRY POINT
007674,001336: 06,3133           05033                           TC       SPSIN                         	# SIN(CDUZ) = SIN(MG)
007675,001337: 06,3134           55414                           TS       M11                           	# SCALED AT 1
007676,001338: 
007677,001339: 06,3135           30034                           CAE      CDUZ                          	#
007678,001340: 06,3136           05032                           TC       SPCOS                         	# COS(CDUZ) = COS(MG)
007679,001341: 06,3137           54061                           TS       COSMG                         	# SCALED AT 1 (ONLY A FACTOR)
007680,001342: 
007681,001343: 06,3140           30032                           CAE      CDUX                          	#
007682,001344: 06,3141           05033                           TC       SPSIN                         	# SIN(CDUX) = SIN(OG)
007683,001345: 06,3142           55417                           TS       M22                           	# SCALED AT 1 (ALSO IS MR22)
007684,001346: 
007685,001347: 06,3143           41417                           CS       M22                           	#
007687,001349: 06,3144           00006                           EXTEND                                 	#
007688,001350: 06,3145           70061                           MP       COSMG                         	# -SIN(OG)COS(MG)
007689,001351: 06,3146           55416                           TS       M31                           	# SCALED AT 1
007690,001352: 
007691,001353: 06,3147           30032                           CAE      CDUX                          	#
007692,001354: 06,3150           05032                           TC       SPCOS                         	# COS(CDUX) = COS(OG)
007693,001355: 06,3151           55420                           TS       M32                           	# SCALED AT 1 (ALSO IS MR23)
007694,001356: 
007695,001357: 06,3152           00006                           EXTEND                                 	#
007696,001358: 06,3153           70061                           MP       COSMG                         	# COS(OG)COS(MG)
007697,001359: 06,3154           55415                           TS       M21                           	# SCALED AT 1
007698,001360: 
007699,001361: 06,3155           05270                           TC       RESUME                        	#
007700,001362: 
007701,001363: 06,3156  06,3132               NORRGMON           EQUALS   DAPT4S                        	#
007702,001364: 06,3156     5270               ENDDAPT4           EQUALS   RESUME                        	#
(End of include-file T4RUPT_PROGRAM.agc, resuming MAIN.agc)
007702,000087: 

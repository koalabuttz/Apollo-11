063573,000027:                                                                                          	## about getting access to the (much) higher-quality images which Paul
063574,000028:                                                                                          	## actually created.
063575,000029:                                                                                          	##
063576,000030:                                                                                          	## Notations on the hardcopy document read, in part:
063577,000031:                                                                                          	##
063578,000032:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
063579,000033:                                                                                          	##      16:27 JULY 14, 1969 
063580,000034: 
063582,000036: 21,3077                                           BANK     21                            	#
063583,000037: 21,3077  E6,1450                                  EBANK=   QDIFF                         	#
063584,000038: 21,2000                                           SETLOC   DAPS4                         	#
063585,000039: 21,2000                                           BANK                                   	#
063586,000040: 
063587,000041: 21,3077                                           COUNT*   $$/DAPGT                      	#
063588,000042: 
063589,000043:                                                                                          	# CONTROL REACHES THIS POINT UNDER EITHER OF THE FOLLOWING TWO CONDITIONS ONCE THE DESCENT ENGINE AND THE DIGITAL
063590,000044:                                                                                          	# AUTOPILOT ARE BOTH ON:
063591,000045:                                                                                          	#       A) THE TRIM GIMBAL CONTROL LAW WAS ON DURING THE PREVIOUS Q,R-AXIS TIME5 INTERRUPT (OR THE DAPIDLER
063592,000046:                                                                                          	#          INITIALIZATION WAS SET FOR TRIM GIMBAL CONTROL AND THIS IS THE FIRST PASS), OR
063593,000047:                                                                                          	#       B) THE Q,R-AXES RCS AUTOPILOT DETERMINED THAT THE VEHICLE WAS ENTERING (OR HAD JUST ENTERED) A COAST
063594,000048:                                                                                          	#          ZONE WITH A SMALL OFFSET ANGULAR ACCELERATION.
063595,000049:                                                                                          	# GTS IS THE ENTRY TO THE GIMBAL TRIM SYSTEM FOR CONTROLLING ATTITUDE ERRORS AND RATES AS WELL AS ACCELERATIONS.
063596,000050: 
063597,000051: 21,3077           37747        GTS                CAF      NEGONE                        	# MAKE THE NEXT PASS THROUGH THE DAP BE
063598,000052: 21,3100           55631                           TS       COTROLER                      	#       THROUGH RCS CONTROL,
063599,000053: 21,3101           34751                           CAF      FOUR                          	#       AND ENSURE THAT IT IS NOT A SKIP.
063600,000054: 21,3102           55535                           TS       SKIPU                         	#
063601,000055: 21,3103           55536                           TS       SKIPV                         	#
063602,000056: 
063603,000057: 21,3104           34752                           CAF      TWO                           	#
063604,000058: 21,3105           55633                           TS       INGTS                         	# SET INDICATOR OF GTS CONTROL POSITIVE.
063605,000059: 21,3106           55632                           TS       QGIMTIMR                      	# SET TIMERS TO 200 MSEC TO AVOID BOTH
063606,000060: 21,3107           55634                           TS       RGIMTIMR                      	# RUNAWAY AND INTERFERENCE BY NULLING.
063607,000061: 
063608,000062:                                                                                          	# THE DRIVE SETTING ALGORITHM
063609,000063: 
063610,000064:                                                                                          	#       DEL = SGN(OMEGA + ALPHA*ABS(ALPHA)/(2*K))
063611,000065:                                                                                          	#                                                   2               1/2                  2       3/2
063612,000066:                                                                                          	#       NEGUSUM = ERROR*K + ALPHA*(DEL*OMEGA + ALPHA /(3*K)) + DEL*K   (DEL*OMEGA + ALPHA /(2*K))
063613,000067: 
063614,000068:                                                                                          	#       DRIVE = -SGN(NEGUSUM)
063615,000069: 
063616,000070: 21,3110           30021                           CA       SR                            	# SAVE THE SR.  SHIFT IT LEFT TO CORRECT
063617,000071: 21,3111           60000                           AD       A                             	# FOR THE RIGHT SHIFT DUE TO EDITING.
063618,000072: 21,3112           55505                           TS       SAVESR                        	#
063619,000073: 
063620,000074: 21,3113           34752        GTSGO+ON           CAF      TWO                           	# SET INDEXER FOR R-AXIS CALCULATIONS.
063621,000075: 21,3114           13116                           TCF      GOQTRIMG   +1                 	#
063622,000076: 
063623,000077: 21,3115           34755        GOQTRIMG           CAF      ZERO                          	# SET INDEXER FOR Q-AXIS CALCULATIONS
063624,000078: 21,3116           55750                           TS       QRCNTR                        	#
063625,000079: 
063632,000086: 21,3117           51750                           INDEX    QRCNTR                        	# AOS SCALED AT PI/2
063633,000087: 21,3120           31537                           CA       AOSQ                          	#
063634,000088: 21,3121           00006                           EXTEND                                 	#
063635,000089: 21,3122           74752                           MP       BIT2                          	# RESCALE AOS TO PI/4
063637,000091: 21,3123           00006                           EXTEND                                 	#
063638,000092: 21,3124           13130                           BZF      GTSQAXIS   -3                 	# USE FULL SCALE FOR LARGER AOS ESTIMATES.
063639,000093: 
063640,000094: 21,3125           50000                           INDEX    A                             	#
063641,000095: 21,3126           44734                           CS       LIMITS                        	# LIMITS +1 CONTAINS NEGMAX.
063642,000096: 21,3127           56001                           XCH      L                             	# LIMITS -1 CONTAINS POSMAX.
063643,000097: 
063644,000098: 21,3130           11750                           CCS      QRCNTR                        	# PICK UP RATE FOR THIS AXIS.  RATE CELLS
063645,000099: 21,3131           50000                           INDEX    A                             	# ARE ADJACENT, NOT SEPARATED.  AT PI/4
063646,000100: 21,3132           31436                           CA       EDOTQ                         	#
063647,000101: 21,3133           53744        GTSQAXIS           DXCH     WCENTRAL                      	#
063648,000102: 
063649,000103: 21,3134           51750                           INDEX    QRCNTR                        	# COLLECT K FOR THIS AXIS
063650,000104: 21,3135           31504                           CA       KQ                            	#
063651,000105: 21,3136           55741                           TS       KCENTRAL                      	#
063652,000106: 
063653,000107: 21,3137           00006                           EXTEND                                 	# CONTROL AUTHORITY ZERO.  AVOID DRIVING
063654,000108: 21,3140           13576                           BZF      POSDRIVE   +1                 	# ENGINE BELL TO THE STOPS.
063655,000109: 
063656,000110: 21,3141           51750                           INDEX    QRCNTR                        	# QDIFF, RDIFF ARE STORED IN D.P.
063657,000111: 21,3142           31450                           CAE      QDIFF                         	#
063658,000112: 
063659,000113: 21,3143           00006        ALGORTHM           EXTEND                                 	# Q(R)DIFF IS THETA (ERROR) SCALED AT PI.
063660,000114: 21,3144           71741                           MP       KCENTRAL                      	# FORM K*ERROR AT PI(2)/2(8), IN D.P.
063661,000115: 21,3145           23737                           LXCH     K2THETA                       	#
063662,000116: 21,3146           00006                           EXTEND                                 	#
063663,000117: 21,3147           74747                           MP       BIT5                          	# RESCALE TO 4*PI(2)
063664,000118: 21,3150           53740                           DXCH     K2THETA                       	#
063665,000119: 21,3151           00006                           EXTEND                                 	#
063666,000120: 21,3152           74747                           MP       BIT5                          	# FIRST TERM OF NEGUSUM IN K2THETA.
063667,000121: 21,3153           27740                           ADS      K2THETA    +1                 	# NO CARRY NEEDED       D.P. AT 4*PI(2)
063668,000122: 
063669,000123: 21,3154           41744                           CS       ACENTRAL                      	# FORM ALPHA(2)/(2*K) AT 16*PI, IN D.P.,
063670,000124: 21,3155           00006                           EXTEND                                 	# LIMITING QUOTIENT TO AVOID OVERFLOW.

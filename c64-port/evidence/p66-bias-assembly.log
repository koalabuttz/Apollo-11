053801,000042: 
053802,000043: 23,3537     0142                                  EBANK=   DEXDEX                        	#
053803,000044: 23,3537                                           COUNT*   $$/POWFL                      	#
053804,000045: 
053805,000046:                                                                                          	# CDUTRIG, CDUTRIG1, CDUTRIG2, AND CD*TR*GS ALL COMPUTE THE SINES AND
053806,000047:                                                                                          	# COSINES OF THREE 2'S COMPLEMENT ANGLES AND PLACE THE RESULT, DOUBLE
053807,000048:                                                                                          	# PRECISION, IN THE SAME ORDER AS THE INPUTS, AT SINCDU AND COSCDU.  AN
053808,000049:                                                                                          	# ADDITIONAL OUTPUT IS THE 1'S COMPLEMENT ANGLES AT CDUSPOT.  THESE
053809,000050:                                                                                          	# ROUTINES GO OUT OF THEIR WAY TO LEAVE THE MPAC AREA AS THEY FIND IT,
053810,000051:                                                                                          	# EXCEPT FOR THE GENERALLY UNIMPORTANT MPAC +2.  THEY DIFFER ONLY IN
053811,000052:                                                                                          	# WHERE THEY GET THE ANGLES, AND IN METHOD OF CALLING.
053812,000053: 
053813,000054:                                                                                          	# CDUTRIG (AND CDUTRIG1, WHICH CAN BE CALLED IN BASIC) COMPUTE THE
053814,000055:                                                                                          	# SINES AND COSINES FROM THE CURRENT CONTENTS OF THE CDU REGISTERS.
053815,000056:                                                                                          	# THE CONTENTS OF CDUTEMP, ETC., ARE NOT TOUCHED SO THAT THEY MAY
053816,000057:                                                                                          	# CONTINUE TO FORM A CONSISTENT SET WITH THE LATEST PIPA READINGS.
053817,000058: 
053818,000059:                                                                                          	# CDUTRIG1 IS LIKE CDUTRIG EXCEPT THAT IT CAN BE CALLED IN BASIC.
053819,000060: 
053820,000061:                                                                                          	# CD*TR*GS FINDS CDU VALUES IN CDUSPOT RATHER THAN IN CDUTEMP.  THIS
053821,000062:                                                                                          	# ALLOWS USERS TO MAKE TRANSFORMATIONS USING ARBITRARY ANGLES, OR REAL
053822,000063:                                                                                          	# ANGLES IN AN ORDER OTHER THAN X Y Z.  A CALL TO THIS ROUTINE IS
053823,000064:                                                                                          	# NECESSARY IN PREPARATION FOR A CALL TO AX*SR*T IN EITHER OF ITS TWO
053824,000065:                                                                                          	# MODES (SMNB OR NBSM).  SINCE AX*SR*T EXPECTS TO FIND THE SINES AND
053825,000066:                                                                                          	# COSINES IN THE ORDER Y Z X THE ANGLES MUST HAVE BEEN PLACED IN CDUSPOT
053826,000067:                                                                                          	# IN THIS ORDER.  CD*TR*GS NEED NOT BE REPEATED WHEN AX*SR*T IS CALLED
053827,000068:                                                                                          	# MORE THAN ONCE, PROVIDED THE ANGLES HAVE NOT CHANGED.  NOTE THAT SINCE
053828,000069:                                                                                          	# IT CLOBBERS BUF2 (IN THE SINE AND COSINE ROUTINES) CD*TR*GS CANNOT BE
053829,000070:                                                                                          	# CALLED USING BANKCALL.  SORRY.
053830,000071: 
053831,000072:                                                                                          	# CD*TR*G IS LIKE CD*TR*GS EXCEPT THAT IT CAN BE CALLED IN
053832,000073:                                                                                          	# INTERPRETIVE.
053833,000074: 

062845,000800: 17,3167           50000                           INDEX    A                             	# -COEFFQ.(Q) + COEFFR.(R) HAS OVERFLOWED
062846,000801: 17,3170           44734                           CS       LIMITS                        	# AND IS LIMITED TO POSMAX OR NEGMAX
062847,000802: 17,3171           23737                           LXCH     ROTEMP1                       	# COEFFQ.(Q) + COEFFR.(R) IS PUT INTO L

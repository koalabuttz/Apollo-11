025626,004430:                                                                                          	# PROGRAM NAME: R29     (RENDEZVOUS RADAR DESIGNATE DURING POWERED FLIGHT)
025627,004431:                                                                                          	# MOD NO. 2     BY H. BLAIR-SMITH       JULY 2, 1968.
025628,004432: 
025629,004433:                                                                                          	# FUNCTIONAL DESCRIPTION:
025630,004434: 
025631,004435:                                                                                          	#       DESIGNATES THE RENDEZVOUS RADAR TOWARD THE COMPUTED LOS TO THE CSM, WITH THE CHIEF OBJECTIVE OF OBTAINING RANGE
025632,004436:                                                                                          	#       AND RANGE RATE DATA AT 2-SECOND INTERVALS FOR TRANSMISSION TO THE GROUND.  WHEN THE RR IS WITHIN .5 DEGREE OF
025633,004437:                                                                                          	#       THE COMPUTED LOS, TRACKING IS ENABLED, AND DESIGNATION CONTINUES UNTIL THE DATA-GOOD DISCRETE IS RECEIVED.  AT
025634,004438:                                                                                          	#       THAT POINT, DESIGNATION CEASES AND A RADAR-READING ROUTINE TAKES OVER, PREPARING A CONSISTENT SET OF DATA FOR
025635,004439:                                                                                          	#       DOWN TELEMETRY.  THE SET INCLUDES RANGE, RANGE RATE, MARK TIME, TWO RR CDU ANGLES, THREE IMUCDU ANGLES, AND AN
025636,004440:                                                                                          	#       INDICATOR WHICH IS 1 WHEN THE SET IS CONSISTENT AND 0 OTHERWISE.  THE INDICATOR IS IN TRKMKCNT.
025637,004441: 
025638,004442:                                                                                          	# CALLING SEQUENCE:  BEGUN EVERY 2 SECONDS AS AN INTEGRAL PART OF SERVICER
025639,004443: 
025640,004444:                                                                                          	# SUBROUTINES CALLED:
025641,004445: 
025642,004446:                                                                                          	#       REMODE          RRTONLY
025643,004447:                                                                                          	#       UNIT            MPACVBUF
025644,004448:                                                                                          	#       QUICTRIG        AX*SR*T
025645,004449:                                                                                          	#       SPSIN           SPCOS
025646,004450:                                                                                          	#       SETRRECR        RROUT
025647,004451:                                                                                          	#       RRRDOT          RRRANGE
025648,004452: 
025649,004453:                                                                                          	# EXIT:  TO NOR29NOW, IN SERVICER.
025650,004454: 
025651,004455:                                                                                          	# OUTPUT:  (ALL FOR DOWNLINK)
025652,004456: 
025653,004457:                                                                                          	#       RM              RDOTM           (RAW)
025654,004458:                                                                                          	#       AIG             AMG             
025655,004459:                                                                                          	#       AOG             TRKMKCNT        TRKMKCNT = 00001 IF SET IS CONSISTENT,
025656,004460:                                                                                          	#       TANGNB          TANGNB +1       OTHERWISE TRKMKCNT = 00000.
025657,004461:                                                                                          	#       MKTIME
025659,004463: 
025660,004464:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:
025661,004465: 
025662,004466:                                                                                          	#       NOR29FLG        READRFLG                (TO 1 AND 0 BY FRESH START) (RESET NOR29FLG TO LET SERVICER RUN R29)
025663,004467:                                                                                          	#       PIPTIME         RADMODES (BIT 10)       (BIT SET TO 0 BY FRESH START)
025664,004468:                                                                                          	#       R(CSM)          V(CSM)
025665,004469:                                                                                          	#       R               V                       (PIPTIME THRU V BY AVE G IN SERVICER)
025666,004470: 
025667,004471:                                                                                          	# DEBRIS:
025668,004472: 
025669,004473:                                                                                          	#       RADMODES (BIT 10)
025670,004474:                                                                                          	#       LOSSM           LOSVDT/4                (= RRTARGET & LOSVEL)
025671,004475:                                                                                          	#       SAVECDUT        OLDESFLG                (SAVECDUT = MLOSV)
025672,004476:                                                                                          	#       LOSCMFLG        READRFLG
025673,004477: 
025674,004478:                                                                                          	# ALARMS:  NONE.
025675,004479: 

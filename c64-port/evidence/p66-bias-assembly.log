057683,000296:                                                                                          	#                               ...     ...             IMMEDIATE RETURN TO THE USER
057684,000297:                                                                                          	#       GOMARK3 IS USED FOR A PLEASE PERFORM ON A MARK REQUEST WITH A 3 COMP. DEC DISPLAY.  THE DESIRED MARK PLEASE
057685,000298:                                                                                          	#       PERFORM VERB AND NOUN ARE ENTERED IN A.  GOMARK3 DISPLAYS R1, R2, R3 BY MEANS OF A V06NYY FOLLOWED BY A FLASHING
057686,000299:                                                                                          	#       V5XNYY FOR A PLEASE PERFORM.  GOMARK3 HAS 3 ASTRONAUT RETURNS TO THE USER WITH NO IMMEDIATE RETURN.
057687,000300:                                                                                          	#                               CAF     V5XNYY          X=1,2,3,4       YY=NOUN
057688,000301:                                                                                          	#                               TC      BANKCALL
057689,000302:                                                                                          	#                               CADR    GOMARK3
057690,000303:                                                                                          	#                               ...     ...             TERMINATE RETURN
057691,000304:                                                                                          	#                               ...     ...             PROCEED RETURN
057692,000305:                                                                                          	#                               ...     ...             ENTER RETURN
057693,000306:                                                                                          	#       GOMARK4 IS THE SAME AS GOMARK3 ONLY R2 AND R3 ARE BLANKED AND R1 IS DISPLAYED IN OCTAL.
057694,000307:                                                                                          	#                               CAF     V5XNYY          X=1,2,3,4       YY=NOUN
057695,000308:                                                                                          	#                               TC      BANKCALL
057696,000309:                                                                                          	#                               CADR    GOMARK4
057697,000310:                                                                                          	#                               ...     ...             TERMINATE RETURN
057698,000311:                                                                                          	#                               ...     ...             PROCEED RETURN
057700,000313:                                                                                          	#                       ...     ...                     ENTER RETURN
057701,000314:                                                                                          	#       EXDSPRET IS USED TO DISPLAY A VERB NOUN ARRIVING IN A WITH A RETURN MADE TO THE USER AFTER THE DISPLAY HAS BEEN
057702,000315:                                                                                          	#       SENT OUT.
057703,000316:                                                                                          	#                               CAF     VXXNYY
057704,000317:                                                                                          	#                               TC      BANKCALL
057705,000318:                                                                                          	#                               CADR    EXDSPRET
057706,000319:                                                                                          	#                               ...     ...             RETURN TO USER
057707,000320:                                                                                          	#       KLEENEX CLEANS OUT ALL MARK DISPLAYS (ACTIVE AND INACTIVE). A RETURN IS MADE TO THE USER AFTER THE MARK DISPLAYS
057708,000321:                                                                                          	#       HAVE BEEN CLEANED OUT.
057709,000322:                                                                                          	#                               TC      BANKCALL
057710,000323:                                                                                          	#                               CADR    KLEENEX
057711,000324:                                                                                          	#                               ...     ...             RETURN TO USER
057712,000325:                                                                                          	#       MARKBRAN IS A SPECIAL PURPOSE ROUTINE USED FOR SAVING JOB VAC AREAS (SEE DESCRIPTION OF MARKBRAN BELOW).
057713,000326:                                                                                          	#                               TC      BANKCALL
057714,000327:                                                                                          	#                               CADR    MARKBRAN
057715,000328:                                                                                          	#                               ...     ...             BAD RETURN IF MARK DISPLAY NOT ACTIVE
057716,000329:                                                                                          	#                                                       (GOOD RETURN TO IMMEDIATE RETURN LOC OF
057717,000330:                                                                                          	#                                                       LAST FLASHING MARK R ROUTINE)
057718,000331:                                                                                          	#       PINBRNCH REESTABLISHES THE LAST ACTIVE FLASHING DISPLAY.  IF THERE IS NO ACTIVE FLASHING DISPLAY, THE DSKY IS
057719,000332:                                                                                          	#       BLANKED AND CONTROL IS SENT TO ENDOFJOB.
057720,000333:                                                                                          	#                               TC      POSTJUMP
057721,000334:                                                                                          	#                               CADR    PINBRNCH
057722,000335:                                                                                          	#       PRIODSP IS USED AS A PRIORITY DISPLAY.  IT WILL DISPLAY A GOFLASH TYPE DISPLAY WITH THREE POSSIBLE RETURNS FROM
057723,000336:                                                                                          	#       THE ASTRONAUT (SEE NO. 7 ABOVE).
057724,000337:                                                                                          	#       THE MAIN PURPOSE OF PRIODSP IS TO REPLACE THE PRESENT DISPLAY WITH A DISPLAY OF HIGHER PRIORITY AND TO
057725,000338:                                                                                          	#       PROVIDE A MEANS FOR RESTORING THE OLD DISPLAY WHEN THE PRIORITY DISPLAY
057726,000339:                                                                                          	#       IS RESPONDED TO BY THE ASTRONAUT.
057727,000340:                                                                                          	#       THE FORMER DISPLAY IS RESTORED BY AN AUTOMATIC BRANCH TO WAKE UP THE DISPLAY THAT WAS INTERRUPTED BY THE
057728,000341:                                                                                          	#       PRIO DISPLAY.
057729,000342:                                                                                          	#                               CAF     VXXNYY          VXXNYY WILL BE A FLASHING VERB NOUN
057730,000343:                                                                                          	#                               TC      BANKCALL
057731,000344:                                                                                          	#                               CADR    PRIODSP
057732,000345:                                                                                          	#                               ...     ...             TERMINATE RETURN
057733,000346:                                                                                          	#                               ...     ...             PROCEED RETURN
057735,000348:                                                                                          	#                               ...     ...             ENTER OR RECYCLE RETURN
057736,000349:                                                                                          	#       PRIODSPR IS THE SAME AS PRIODSP ONLY AN IMMEDIATE RETURN IS MADE TO THE USERS CALL CADR +4.
057737,000350:                                                                                          	#                               CAF     VXXNYY          VXXNYY WILL BE A FLASHING VERB NOUN
057738,000351:                                                                                          	#                               TC      BANKCALL
057739,000352:                                                                                          	#                               CADR    PRIODSPR
057740,000353:                                                                                          	#                               ...     ...             TERMINATE RETURN
057741,000354:                                                                                          	#                               ...     ...             PROCEED RETURN
057742,000355:                                                                                          	#                               ...     ...             ENTER OR RECYCLE RETURN
057743,000356:                                                                                          	#                               ...     ...             IMMEDIATE RETURN
057744,000357:                                                                                          	#       PRIOLARM DOES A V05N09 PRIODSPR.
057745,000358: 
057746,000359:                                                                                          	#       CLEANDSP CLEANS OUT ALL NORMAL DISPLAYS (ACTIVE AND INACTIVE).  A RETURN IS MADE TO THE USER AFTER NORMAL
057747,000360:                                                                                          	#       DISPLAYS ARE CLEANED OUT.
057748,000361:                                                                                          	#                               TC      BANKCALL
057749,000362:                                                                                          	#                               CADR    CLEANDSP

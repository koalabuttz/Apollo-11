026487,000098:                                                                                          	# PROGRAM DESCRIPTION S30.1     DATE 9NOV66
026488,000099:                                                                                          	# MOD NO 1                      LOG SECTION P30,P37
026489,000100:                                                                                          	# MOD BY RAMA AIYAWAR **
026490,000101: 
026491,000102:                                                                                          	# FUNCTIONAL DESCRIPTION
026492,000103:                                                                                          	#       BASED ON STORED TARGET PARAMETERS (R OF IGNITION (RTIG), V OF
026493,000104:                                                                                          	#       IGNITION (VTIG), TIME OF IGNITION (TIG)), COMPUTE PERIGEE ALTITUDE
026494,000105:                                                                                          	#       APOGEE ALTITUDE AND DELTAV REQUIRED (DELVSIN).
026495,000106: 
026496,000107:                                                                                          	# CALLING SEQUENCE
026497,000108:                                                                                          	#       L       CALL
026498,000109:                                                                                          	#       L+1             S30.1
026499,000110: 
026500,000111:                                                                                          	# NORMAL EXIT MODE
026501,000112:                                                                                          	#       AT L+2 OR CALLING SEQUENCE (GOTO L+2)
026502,000113: 
026503,000114:                                                                                          	# SUBROUTINES CALLED
026504,000115:                                                                                          	#       LEMPREC
026505,000116:                                                                                          	#       PERIAPO
026506,000117: 
026507,000118:                                                                                          	# ALARM OR ABORT EXIT MODES
026508,000119:                                                                                          	#       NONE
026509,000120: 
026510,000121:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
026511,000122:                                                                                          	#       TIG             TIME OF IGNITION        DP B28CS
026512,000123:                                                                                          	#       DELVSLV         SPECIFIED DELTA-V IN LOCAL VERT.
026513,000124:                                                                                          	#                       COORDS. OF ACTIVE VEHICLE AT
026514,000125:                                                                                          	#                       TIME OF IGNITION        VECTOR B+7 METERS/CS
026515,000126: 
026516,000127:                                                                                          	# OUTPUT
026517,000128:                                                                                          	#       RTIG            POSITION AT TIG         VECTOR B+29 METERS
026518,000129:                                                                                          	#       VTIG            VELOCITY AT TIG         VECTOR B+29 METERS/CS
026519,000130:                                                                                          	#       PDL 4D          APOGEE ALTITUDE         DP B+29 M, B+27 METERS.
026520,000131:                                                                                          	#       HAPO            APOGEE ALTITUDE         DP B+29 METERS
026521,000132:                                                                                          	#       PDL 8D          PERIGEE ALTITUDE        DP B+29 M, B+27 METERS.
026522,000133:                                                                                          	#       HPER            PERIGEE ALTITUDE        DP B+29 METERS
026523,000134:                                                                                          	#       DELVSIN         SPECIFIED DELTA-V IN INERTIAL
026524,000135:                                                                                          	#                       COORD. OF ACTIVE VEHICLE AT
026525,000136:                                                                                          	#                       TIME OF IGNITION        VECTOR B+7 METERS/CS
026526,000137:                                                                                          	#       DELVSAB         MAG. OF DELVSIN         VECTOR B+7 METERS/CS
026527,000138: 
026528,000139:                                                                                          	# DEBRIS        QTEMP   TEMP.ERASABLE
026529,000140:                                                                                          	#               QPRET, MPAC
026530,000141:                                                                                          	#               PUSHLIST

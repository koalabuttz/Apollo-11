048509,000243:                                                                                          	# SUBROUTINE TO SET GAMMA FOR THE LAT-LONG AND LALOTORV SUBROUTINES
048510,000244: 
048511,000245:                                                                                          	# GAMMA = B**2/A**2 FOR EARTH (B-1)
048512,000246:                                                                                          	# GAMMA = 1 FOR MOON (B-1)

044691,000994:                                                                                          	# Page 1034
044692,000995:                                                                                          	# DOUBLE PRECISION POLYNOMIAL EVALUATOR
044693,000996:                                                                                          	#                                 N        N-1
044694,000997:                                                                                          	#       THIS ROUTINE EVALUATES A X  + A   X    + ... + A  X + A  LEAVING THE DP RESULT IN MPAC ON EXIT.
044695,000998:                                                                                          	#                               N      N-1              1      0
044696,000999: 
044697,001000:                                                                                          	# THE ROUTINE HAS TWO ENTRIES
044698,001001: 
044699,001002:                                                                                          	#       1       ENTRY THRU POWRSERS.  THE COEFFICIENTS MAY BE EITHER IN FIXED OR ERASABLE E.  THE CALL IS BY
044700,001003:                                                                                          	#               TC POWRSERS, AND THE RETURN IS TO LOC(TC POWRSERS)+1.  THE ENTERING DATA MUST BE AS FOLLOWS:
044701,001004: 
044702,001005:                                                                                          	#                       A               SP      LOC-3           # ADDRESS FOR REFERENCING COEF TABLE
044703,001006:                                                                                          	#                       L               SP      N-1             # N IS THE DEGREE OF THE POWER SERIES
044704,001007:                                                                                          	#                       MPAC            DP      X               # ARGUMENT
044705,001008:                                                                                          	#                       LOC-2N          DP      A(0)
044706,001009:                                                                                          	#                                       ...
044707,001010:                                                                                          	#                       LOC             DP      A(N)
044708,001011: 
044709,001012:                                                                                          	#       2.      ENTRY THRU POLY.  THE CALL TO POLY AND THE ENTERING DATA MUST BE AS FOLLOWS
044710,001013: 
044711,001014:                                                                                          	#                       MPAC            DP      X               # ARGUMENT
044712,001015:                                                                                          	#                       LOC             TC      POLY
044713,001016:                                                                                          	#                       LOC+1           SP      N-1
044714,001017:                                                                                          	#                       LOC+2           DP      A(0)
044715,001018:                                                                                          	#                                       ...
044716,001019:                                                                                          	#                       LOC+2N+2        DP      A(N)            # RETURN IS TO LOC+2N+4
044717,001020: 
044718,001021:    7215           00006        POWRSERS           EXTEND                                 	#
044719,001022:    7216           22141                           QXCH     POLYRET                       	# RETURN ADDRESS
044720,001023:    7217           54117                           TS       POLISH                        	# POWER SERIES ADDRESS
044721,001024:    7220           22140                           LXCH     POLYCNT                       	# N-1 TO COUNTER

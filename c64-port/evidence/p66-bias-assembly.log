023214,002018:                                                                                          	# PROGRAM NAME_  RROUT                                                          RROR COUNTER SCALING. RROUT LIMITS THEM
023215,002019: 
023216,002020:                                                                                          	# FUNCTIONAL DESCRIPTION_
023217,002021: 
023218,002022:                                                                                          	#       RROUT RECEIVES RR GYRO COMMANDS IN TANG, TANG +1 IN RR
023219,002023:                                                                                          	#       ERROR COUNTER SCALING.  RROUT THEN LIMITS THEM AND
023220,002024:                                                                                          	#       GENERATES COMMANDS TO THE CDU TO ADJUST THE ERROR COUNTERS
023221,002025:                                                                                          	#       TO THE DESIRED VALUES.  INITIALLY MAGSUB CHECKS THE MAGNITUDE OF
023222,002026:                                                                                          	#       THE COMMAND (SHAFT ON 1ST PASS) TO SEE IF IT IS GREATER THAN
023223,002027:                                                                                          	#       384 PULSES.  IF NOT, CONTROL IS TRANSFERRED TO RROUTLIM TO
023224,002028:                                                                                          	#       LIMIT THE COMMAND TO +384 OR -384 PULSES.  THE DIFFERENCE IS
023225,002029:                                                                                          	#       THEN CALCULATED BETWEEN THE DESIRED STATE AND THE PRESENT STATE OF
023226,002030:                                                                                          	#       THE ERROR COUNTER AS RECORDED IN LASTYCMD AND LASTXCMD.
023227,002031:                                                                                          	#       THE RESULT IS STORED IN OPTXCMD (1ST PASS) AND OPTYCMD (2ND
023228,002032:                                                                                          	#       PASS).  FOLLOWING THE SECOND PASS, FOR THE TRUNNION COMMAND, THE
023229,002033:                                                                                          	#       OCDUT AND OCDUS ERROR COUNTER DRIVE BITS (CHAN 14 BITS 12, 11)
023230,002034:                                                                                          	#       ARE SET.  THIS PROGRAM THEN EXITS TO THE CALLING PROGRAM.
023231,002035: 
023232,002036:                                                                                          	# CALLING SEQUENCE:
023233,002037:                                                                                          	#       
023234,002038:                                                                                          	#       L TC RROUT (WITH RUPT INHIBITED) RROUT IS CALLED BY
023235,002039:                                                                                          	#       RRTONLY, RRSONLY, AND DODES

015483,000162: 22,3154           11530                           DV       1JACC                         	# = AJX         $ 90 DEG/SEC-SEC
015484,000163: 22,3155           51701                           INDEX    KSPNDX                        	#
015485,000164: 22,3156           55277                           TS       DELPEROR                      	#               $ 180 DEG
015486,000165: 22,3157           11701                           CCS      KSPNDX                        	#
015487,000166: 22,3160           13133                           TCF      RATEBIAS                      	#
015488,000167: 
015489,000168: 22,3161           30025                           CA       TIME1                         	#

063430,000516: 17,3731           00232        .0375AT4           DEC      .00938                        	# .0375 SEC SCALED AT 4.
063431,000517: 17,3732           77462        -.025AT2           DEC      -.0125                        	# -.025 SEC SCALED AT 2.

020646,000354: 
020648,000356:                                                                                          	# PROGRAM DESCRIPTION - VECPOINT
020649,000357: 
020650,000358:                                                                                          	# THIS INTERPRETIVE SUBROUTINE MAY BE USED TO POINT A SPACECRAFT AXIS IN A DESIRED DIRECTION.  THE AXIS
020651,000359:                                                                                          	# TO BE POINTED MUST APPEAR AS A HALF UNIT DOUBLE PRECISION VECTOR IN SUCCESSIVE LOCATIONS OF ERASABLE MEMORY
020652,000360:                                                                                          	# BEGINNING WITH THE LOCATION CALLED SCAXIS.  THE COMPONENTS OF THIS VECTOR ARE GIVEN IN SPACECRAFT COORDINATES.
020653,000361:                                                                                          	# THE DIRECTION IN WHICH THIS AXIS IS TO BE POINTED MUST APPEAR AS A HALF UNIT DOUBLE PRECISION VECTOR IN
020654,000362:                                                                                          	# SUCCESSIVE LOCATIONS OF ERASABLE MEMORY BEGINNING WITH THE ADDRESS CALLED POINTVSM.  THE COMPONENTS OF THIS
020655,000363:                                                                                          	# VECTOR ARE GIVEN IN STABLE MEMBER COORDINATES.  WITH THIS INFORMATION VECPOINT COMPUTES A SET OF THREE GIMBAL
020656,000364:                                                                                          	# ANGLES (2S COMPLEMENT) CORESPONDING TO THE CROSS-PRODUCT ROTATION BETWEEN SCAXIS AND POINTVSM AND STORES THEM
020657,000365:                                                                                          	# IN T(MPAC) BEFORE RETURNING TO THE CALLER.
020658,000366: 
020659,000367:                                                                                          	# THIS ROTATION, HOWEVER, MAY BRING THE S/C INTO GIMBAL LOCK.  WHEN POINTING A VECTOR IN THE Y-Z PLANE,
020660,000368:                                                                                          	# THE TRANSPONDER AXIS, OR THE AOT FOR THE LEM, THE PROGRAM WILL CORRECT THIS PROBLEM BY ROTATING THE CROSS-
020661,000369:                                                                                          	# PRODUCT ATTITUDE ABOUT POINTVSM BY A FIXED AMOUNT SUFFICIENT TO ROTATE THE DESIRED S/C ATTITUDE OUT OF GIMBAL
020662,000370:                                                                                          	# LOCK.  IF THE AXIS TO BE POINTED IS MORE THAN 40.6 DEGREES BUT LESS THAN 60.5 DEG FROM THE +X (OR -X) AXIS,
020663,000371:                                                                                          	# THE ADDITIONAL ROTATION TO AVOID GIMAL LOCK IS 35 DEGREES.  IF THE AXIS IS MORE THAN 60.5 DEGEES FROM +X (OR -X)
020664,000372:                                                                                          	# THE ADDITIONAL ROTATION IS 35 DEGREES.  THE GIMBAL ANGLES CORRESPONDING TO THIS ATTITUDE ARE THEN COMPUTED AND
020665,000373:                                                                                          	# STORED AS 2S COMPLIMENT ANGLES IN T(MPAC) BEFORE RETURNING TO THE CALLER.
020666,000374: 
020667,000375:                                                                                          	# WHEN POINTING THE X-AXIS, OR THE THRUST VECTOR, OR ANY VECTOR WITHIN 40.6 DEG OF THE X-AXIS, VECPOINT
020668,000376:                                                                                          	# CANNOT CORRECT FOR A CROSS-PRODUCT ROTATION INTO GIMBAL LOCK.  IN THIS CASE A PLATFORM REALIGNMENT WOULD BE
020669,000377:                                                                                          	# REQUIRED TO POINT THE VECTOR IN THE DESIRED DIRECTION.  AT PRESENT NO INDICATION IS GIVEN FOR THIS SITUATION
020670,000378:                                                                                          	# EXCEPT THAT THE FINAL MIDDLE GIMBAL ANGLE IN MPAC +2 IS GREATER THAN 59 DEGREES.
020671,000379: 
020672,000380:                                                                                          	# CALLING SEQUENCE -
020673,000381: 
020674,000382:                                                                                          	#       1)      LOAD SCAXIS, POINTVSM
020675,000383:                                                                                          	#       2)      CALL
020676,000384:                                                                                          	#                       VECPOINT
020677,000385: 
020678,000386:                                                                                          	# RETURNS WITH
020679,000387: 
020680,000388:                                                                                          	#       1)      DESIRED OUTER GIMBAL ANGLE IN MPAC
020681,000389:                                                                                          	#       2)      DESIRED INNER GIMBAL ANGLE IN MPAC +1
020682,000390:                                                                                          	#       3)      DESIRED MIDDLE GIMBAL ANGLE IN MPAC +2
020683,000391: 
020684,000392:                                                                                          	# ERASABLES USED -
020685,000393: 
020686,000394:                                                                                          	#       1)      SCAXIS          6
020687,000395:                                                                                          	#       2)      POINTVSM        6
020688,000396:                                                                                          	#       3)      MIS             18
020689,000397:                                                                                          	#       4)      DEL             18
020690,000398:                                                                                          	#       5)      COF             6
020691,000399:                                                                                          	#       6)      VECQTEMP        1
020692,000400:                                                                                          	#       7)      ALL OF VAC AREA 43
020693,000401: 
020694,000402:                                                                                          	#                       TOTAL   99
020695,000403: 
020696,000404: 27,2000                                           SETLOC   VECPT                         	#
020697,000405: 27,2000                                           BANK                                   	#
020699,000407: 27,2032                                           COUNT*   $$/VECPT                      	#
020700,000408: 
020701,000409: 27,2032  E6,1676                                  EBANK=   BCDU                          	#
020702,000410: 
020703,000411: 27,2032           40020        VECPNT1            STQ      BOV                           	# THIS ENTRY USES DESIRED CDUS
020704,000412: 27,2033           03325                                    VECQTEMP                      	# NOT PRESENT - ENTER WITH CDUD'S IN MPAC
020705,000413: 27,2034           56035                                    VECPNT2                       	#
020706,000414: 27,2035           52164        VECPNT2            AXC,2    GOTO                          	#
020707,000415: 27,2036           03246                                    MIS                           	#
020708,000416: 27,2037           56046                                    STORANG                       	#
020709,000417: 27,2040           40020        VECPOINT           STQ      BOV                           	# SAVE RETURN ADDRESS
020710,000418: 27,2041           03325                                    VECQTEMP                      	#
020711,000419: 27,2042           56043                                    VECLEAR                       	# AND CLEAR OVFIND
020712,000420: 27,2043           47164        VECLEAR            AXC,2    RTB                           	#
020713,000421: 27,2044           03246                                    MIS                           	# READ THE PRESENT CDU ANGLES AND
020714,000422: 27,2045           44403                                    READCDUK                      	# STORE THEM IN PD25, 26, 27
020715,000423: 27,2046           34032        STORANG            STCALL   25D                           	#
020716,000424: 27,2047           44410                                    CDUTODCM                      	# S/C AXES TO STABLE MEMBER AXES (MIS)
020717,000425: 27,2050           61375                           VLOAD    VXM                           	#
020718,000426: 27,2051           03773                                    POINTVSM                      	# RESOLVE THE POINTING DIRECTION VF INTO
020719,000427: 27,2052           03247                                    MIS                           	# INITIAL S/C AXES (VF = POINTVSM)
020720,000428: 27,2053           77656                           UNIT                                   	#
020721,000429: 27,2054           00035                           STORE    28D                           	#
020722,000430:                                                                                          	# PD 28 29 30 31 32 33
020723,000431: 27,2055           53435                           VXV      UNIT                          	# TAKE THE CROSS PRODUCT VF X VI
020724,000432: 27,2056           03765                                    SCAXIS                        	# WHERE VI = SCAXIS
020725,000433: 27,2057           57400                           BOV      VCOMP                         	#
020726,000434: 27,2060           56170                                    PICKAXIS                      	#
020727,000435: 27,2061           17271                           STODL    COF                           	# CHECK MAGNITUDE
020728,000436: 27,2062           00045                                    36D                           	# OF CROSS PRODUCT
020729,000437: 27,2063           50025                           DSU      BMN                           	# VECTOR, IF LESS
020730,000438: 27,2064           14411                                    DPB-14                        	# THAN B-14 ASSUME
020731,000439: 27,2065           56170                                    PICKAXIS                      	# UNIT OPERATION
020732,000440: 27,2066           50375                           VLOAD    DOT                           	# INVALID.
020733,000441: 27,2067           03765                                    SCAXIS                        	#
020734,000442: 27,2070           00035                                    28D                           	#
020735,000443: 27,2071           65552                           SL1      ARCCOS                        	#
020736,000444: 27,2072           77624        COMPMATX           CALL                                   	# NOW COMPUTE THE TRANSFORMATION FROM
020737,000445: 27,2073           44527                                    DELCOMP                       	# FINAL S/C AXES TO INITIAL S/C AXES MFI
020738,000446: 27,2074           75160                           AXC,1    AXC,2                         	#
020739,000447: 27,2075           03246                                    MIS                           	# COMPUTE THE TRANSFORMATION FROM FINAL
020740,000448: 27,2076           02230                                    KEL                           	# S/C AXES TO STABLE MEMBER AXES
020741,000449: 27,2077           77624                           CALL                                   	# MFS = MIS MFI
020742,000450: 27,2100           44312                                    MXM3                          	# (IN PD LIST)
020743,000451: 
020744,000452: 27,2101           51545                           DLOAD    ABS                           	#
020745,000453: 27,2102           00007                                    6                             	# MFS6 = SIN(CPSI)                      $2
020746,000454: 27,2103           50025                           DSU      BMN                           	#
020747,000455: 27,2104           14376                                    SINGIMLC                      	# = SIN(59 DEGS)                        $2
020748,000456: 27,2105           56160                                    FINDGIMB                      	# /CPSI/ LESS THAN 59 DEGS
020750,000458:                                                                                          	# I.E. DESIRED ATTITUDE NOT IN GIMBAL LOCK
020751,000459: 
020752,000460: 27,2106           51545                           DLOAD    ABS                           	# CHECK TO SEE IF WE ARE POINTING
020753,000461: 27,2107           03765                                    SCAXIS                        	# THE THRUST AXIS
020754,000462: 27,2110           51025                           DSU      BPL                           	#
020755,000463: 27,2111           14400                                    SINVEC1                       	# SIN 49.4 DEGS                         $2
020756,000464: 27,2112           56160                                    FINDGIMB                      	# IF SO, WE ARE TRYING TO POINT IT INTO
020757,000465: 27,2113           77775                           VLOAD                                  	# GIMBAL LOCK, ABORT COULD GO HERE
020758,000466: 27,2114           77626                           STADR                                  	#
020759,000467: 27,2115           50514                           STOVL    MIS        +12D               	#
020760,000468: 27,2116           77626                           STADR                                  	# STORE MFS (IN PD LIST) IN MIS
020761,000469: 27,2117           50522                           STOVL    MIS        +6                 	#
020762,000470: 27,2120           77626                           STADR                                  	#
020763,000471: 27,2121           50530                           STOVL    MIS                           	#
020764,000472: 27,2122           03255                                    MIS        +6                 	# INNER GIMBAL AXIS IN FINAL S/C AXES
020765,000473: 27,2123           57444                           BPL      VCOMP                         	# LOCATE THE IG AXIS DIRECTION CLOSEST TO
020766,000474: 27,2124           56125                                    IGSAMEX                       	# FINAL X S/C AXIS
020767,000475: 
020768,000476: 27,2125           50035        IGSAMEX            VXV      BMN                           	# FIND THE SHORTEST WAY OF ROTATING THE 
020769,000477: 27,2126           03765                                    SCAXIS                        	# S/C OUT OF GIMBAL LOCK BY A ROTATION 
020770,000478: 27,2127           56134                                    U=SCAXIS                      	# ABOUT +- SCAXIS, I.E. IF  (IG (SGN MFS3)
020771,000479:                                                                                          	# X SCAXIS . XF) LESS THAN 0, U = SCAXIS
020772,000480:                                                                                          	# OTHERWISE U = -SCAXIS
020773,000481: 
020774,000482: 27,2130           57575                           VLOAD    VCOMP                         	#
020775,000483: 27,2131           03765                                    SCAXIS                        	#
020776,000484: 27,2132           37271                           STCALL   COF                           	# ROTATE ABOUT -SCAXIS
020777,000485: 27,2133           56137                                    CHEKAXIS                      	#
020778,000486: 27,2134           77775        U=SCAXIS           VLOAD                                  	#
020779,000487: 27,2135           03765                                    SCAXIS                        	#
020780,000488: 27,2136           03271                           STORE    COF                           	# ROTATE ABOUT + SCAXIS
020781,000489: 27,2137           51545        CHEKAXIS           DLOAD    ABS                           	#
020782,000490: 27,2140           03765                                    SCAXIS                        	# SEE IF WE ARE POINTING THE AOT
020783,000491: 27,2141           51025                           DSU      BPL                           	#
020784,000492: 27,2142           14402                                    SINVEC2                       	# SIN 29.5 DEGS                         $2
020785,000493: 27,2143           56147                                    PICKANG1                      	# IF SO, ROTATE 50 DEGS ABOUT +- SCAXIS
020786,000494: 27,2144           52145                           DLOAD    GOTO                          	# IF NOT, MUST BE POINTING THE TRANSPONDER
020787,000495: 27,2145           14406                                    VECANG2                       	# OR SOME VECTOR IN THE Y, OR Z PLANE
020788,000496: 27,2146           56151                                    COMPMFSN                      	# IN THIS CASE ROTATE 35 DEGS TO GET OUT
020789,000497:                                                                                          	# OF GIMBAL LOCK (VECANG2  $360)
020790,000498: 27,2147           77745        PICKANG1           DLOAD                                  	#
020791,000499: 27,2150           14404                                    VECANG1                       	# = 50 DEGS                             $360
020792,000500: 27,2151           77624        COMPMFSN           CALL                                   	#
020793,000501: 27,2152           44527                                    DELCOMP                       	# COMPUTE THE ROTATION ABOUT SCAXIS TO
020794,000502: 27,2153           75160                           AXC,1    AXC,2                         	# BRING MFS OUT OF GIMBAL LOCK
020795,000503: 27,2154           03246                                    MIS                           	#
020796,000504: 27,2155           02230                                    KEL                           	#
020797,000505: 27,2156           77624                           CALL                                   	# COMPUTE THE NEW TRANSFORMATION FROM
020798,000506: 27,2157           44312                                    MXM3                          	# DESIRED S/C AXES TO STABLE MEMBER AXES
020799,000507:                                                                                          	# WHICH WILL ALIGN VI WITH VF AND AVOID
020801,000509:                                                                                          	# GIMBAL LOCK
020802,000510: 27,2160           45160        FINDGIMB           AXC,1    CALL                          	#
020803,000511: 27,2161           00000                                    0                             	# EXTRACT THE COMMANDED CDU ANGLES FROM
020804,000512: 27,2162           44654                                    DCMTOCDU                      	# THIS MATRIX
020805,000513: 27,2163           40234                           RTB      SETPD                         	#
020806,000514: 27,2164           21620                                    V1STO2S                       	# CONVERT TO 2:S COMPLEMENT
020807,000515: 27,2165           00001                                    0                             	#
020808,000516: 27,2166           77650                           GOTO                                   	#
020809,000517: 27,2167           03325                                    VECQTEMP                      	# RETURN TO CALLER
020810,000518: 
020811,000519: 27,2170           50375        PICKAXIS           VLOAD    DOT                           	# IF VF X VI = 0, FIND VF . VI
020812,000520: 27,2171           00035                                    28D                           	#
020813,000521: 27,2172           03765                                    SCAXIS                        	#
020814,000522: 27,2173           72240                           BMN      TLOAD                         	#
020815,000523: 27,2174           54350                                    ROT180                        	#
020816,000524: 27,2175           00032                                    25D                           	#
020817,000525: 27,2176           77650                           GOTO                                   	# IF VF = VI, CDU DESIRED = PRESENT CDU
020818,000526: 27,2177           03325                                    VECQTEMP                      	# PRESENT CDU ANGLES
020819,000527: 
020820,000528: 35,2000                                           BANK     35                            	#
020821,000529: 26,2000                                           SETLOC   MANUVER1                      	#
020822,000530: 26,2000                                           BANK                                   	#
020823,000531: 26,2350           47375        ROT180             VLOAD    VXV                           	# IF VF, VI ANTIPARALLEL, 108 DEG ROTATION
020824,000532: 26,2351           03255                                    MIS        +6                 	# IS REQUIRED.  Y STABLE MEMBER AXIS IN
020825,000533: 26,2352           06520                                    HIDPHALF                      	# INITIAL S/C AXES.
020826,000534: 26,2353           47256                           UNIT     VXV                           	# FIND Y(SM) X X(I)
020827,000535: 26,2354           03765                                    SCAXIS                        	# FIND UNIT(VI X UNIT(Y(SM) X X(I)))
020828,000536: 26,2355           40056                           UNIT     BOV                           	# I.E. PICK A VECTOR IN THE PLANE OF X(I),
020829,000537: 26,2356           54372                                    PICKX                         	# Y(SM) PERPENDICULAR TO VI
020830,000538: 26,2357           17271                           STODL    COF                           	#
020831,000539: 26,2360           00045                                    36D                           	# CHECK MAGNITUDE
020832,000540: 26,2361           50025                           DSU      BMN                           	# OF THIS VECTOR.
020833,000541: 26,2362           14411                                    DPB-14                        	# IF LESS THAN B-14,
020834,000542: 26,2363           54372                                    PICKX                         	# PICK X-AXIS.
020835,000543: 26,2364           77775                           VLOAD                                  	#
020836,000544: 26,2365           03271                                    COF                           	#
020837,000545: 26,2366           17271        XROT               STODL    COF                           	#
020838,000546: 26,2367           06520                                    HIDPHALF                      	#
020839,000547: 26,2370           77650                           GOTO                                   	#
020840,000548: 26,2371           56072                                    COMPMATX                      	#
020841,000549: 26,2372           52175        PICKX              VLOAD    GOTO                          	# PICK THE XAXIS IN THIS CASE
020842,000550: 26,2373           06520                                    HIDPHALF                      	#
020843,000551: 26,2374           54366                                    XROT                          	#
020844,000552: 26,2375           15555 35172  SINGIMLC           2DEC     .4285836003                    	# = SIN(59)                             $2
020845,000553: 
020846,000554: 26,2377           14113 36326  SINVEC1            2DEC     .3796356537                    	# = SIN(49.4)                           $2
020847,000555: 
020848,000556: 26,2401           07701 35703  SINVEC2            2DEC     .2462117800                    	# = SIN(29.5)                           $2
020849,000557: 
020850,000558: 26,2403           04343 21616  VECANG1            2DEC     .1388888889                    	# = 50 DEGREES                          $360
020852,000560: 26,2405           03070 34344  VECANG2            2DEC     .09722222222                    	# = 35 DEGREES                          $360
020853,000561: 
020854,000562: 26,2407           00000        1BITDP             OCT      0                             	# KEEP THIS BEFORE DPB(-14)        *********
020855,000563: 26,2410           00001        DPB-14             OCT      00001                         	#
020856,000564: 26,2411           00000                           OCT      00000                         	#

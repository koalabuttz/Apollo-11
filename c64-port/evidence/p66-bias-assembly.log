048429,000163:                                                                                          	# SUBROUTINE TO COMPUTE EARTH RADIUS
048430,000164: 
048431,000165:                                                                                          	# INPUT
048432,000166:                                                                                          	#       1/2 SIN LAT IN ALPHAV +4
048433,000167: 
048434,000168:                                                                                          	# OUTPUT
048435,000169:                                                                                          	#       EARTH RADIUS IN ERADM AND MPAC (METERS B-29)

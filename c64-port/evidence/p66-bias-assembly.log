034931,000277:                                                                                          	#       TTFINCR COMPUTATIONS ARE AS FOLLOWS --
034932,000278:                                                                                          	# Page 803
034933,000279:                                                                                          	#               TTF/8 UPDATED FOR TIME SINCE LAST PASS:

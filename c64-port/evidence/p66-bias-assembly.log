029741,001365: 
029742,001366:                                                                                          	# MOD NO. 0, BY WILLMAN, SUBROUTINE RENDGUID, LOG P34-P35, P74-P75
029743,001367:                                                                                          	# REVISION 03, 17 FEB 67
029744,001368: 
029745,001369:                                                                                          	# IF THE ACTIVE VEHICLE IS DOING THE COMPUTATION, MIDGIM COMPUTES
029746,001370:                                                                                          	# THE POSITIVE MIDDLE GIMBAL ANGLE OF THE ACTIVE VEHICLE TO THE INPUT
029747,001371:                                                                                          	# DELTA VELOCITY VECTOR (0D IN PUSH LIST), OTHERWISE
029748,001372:                                                                                          	# MIDGIM CONVERTS THE INPUT DELTA VELOCITY VECTOR FROM INERTIAL COORDIN-
029749,001373:                                                                                          	# ATES TO LOCAL VERTICAL COORDINATES OF THE ACTIVE VEHICLE.
029750,001374: 
029751,001375:                                                                                          	# .. INPUTS ..
029752,001376: 
029753,001377:                                                                                          	#       NAME    MEANING                                         UNITS/SCALING/MODE
029754,001378: 
029755,001379:                                                                                          	#       AVFLAG  INT FLAG - 0 IS CSM ACTIVE, 1 IS LEM ACTIVE                     BIT
029756,001380:                                                                                          	#       RINIT   ACTIVE VEHICLE RADIUS VECTOR                    METERS/CSEC (+7) VT
029757,001381:                                                                                          	#       VINIT   ACTIVE VEHICLE VELOCITY VECTOR                  METERS/CSEC (+7) VT
029758,001382:                                                                                          	#       0D(PL)  ACTIVE VEHICLE DELTA VELOCITY VECTOR            METERS/CSEC (+7) VT
029759,001383: 
029760,001384:                                                                                          	# .. OUTPUTS ..
029761,001385: 
029762,001386:                                                                                          	#    NAME       MEANING                                         UNITS/SCALING/MODE
029763,001387: 
029764,001388:                                                                                          	#    +MGA       + MIDDLE GIMBAL ANGLE                           REVOLUTIONS (+0) DP
029765,001389:                                                                                          	#    DELVLVC    DELTA VELOCITY VECTOR IN LV COORD.              METERS/CSEC (+7) VT
029766,001390:                                                                                          	#    MGLVFLAG   INT FLAG - 0 IS +MGA COMPUTED, 1 IS DELVLVC COMP.       -       BIT
029767,001391: 

007001,000663:                                                                                          	# PROGRAM NAME:  TLIM.
007002,000664: 
007003,000665:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM MAINTAINS THE TEMP LAMP (BIT 4 OF CHANNEL 11) ON THE DSKY TO AGREE WITH
007004,000666:                                                                                          	# THE TEMP SIGNAL FROM THE ISS (BIT 15 OF CHANNEL 30).  HOWEVER, THE LIGHT WILL NOT BE TURNED OFF IF A LAMP TEST
007005,000667:                                                                                          	# IS IN PROGRESS.
007006,000668: 
007007,000669:                                                                                          	# CALLING SEQUENCE:  CALLED BY IMUMON ON A CHANGE OF BIT 15 OF CHANNEL 30.
007008,000670: 
007009,000671:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
007010,000672: 
007011,000673:                                                                                          	# SUBROUTINES CALLED:  LAMPTEST.
007012,000674: 
007013,000675:                                                                                          	# ERASABLE INITIALIZATION:  FRESH START AND RESTART TURN THE TEMP LAMP OFF.
007014,000676: 
007015,000677:                                                                                          	# ALARMS:  TEMP LAMP TURNED ON WHEN IMU TEMP GOES OUT OF LIMITS.
007016,000678: 
007017,000679:                                                                                          	# EXIT:  NXTIFAIL.
007018,000680: 
007019,000681:                                                                                          	# OUTPUT:  SERVICE OF TEMP LAMP.                  IN A, EXCEPT FOR TLIM.
007020,000682: 
007021,000683: 06,2514           74733        TLIM               MASK     POSMAX                        	# REMOVE BIT FROM WORD OF CHANGES AND SET
007022,000684: 06,2515           54071                           TS       RUPTREG2                      	# DSKY TEMP LAMP ACCORDINGLY.
007023,000685: 
007024,000686: 06,2516           11302                           CCS      IMODES30                      	#
007025,000687: 06,2517           12525                           TCF      TEMPOK                        	#
007026,000688: 06,2520           12525                           TCF      TEMPOK                        	#
007027,000689: 
007028,000690: 06,2521           34750                           CAF      BIT4                          	# TURN ON LAMP.
007029,000691: 06,2522           00006                           EXTEND                                 	#
007030,000692: 06,2523           05011                           WOR      DSALMOUT                      	#
007031,000693: 06,2524           12225                           TCF      NXTIFAIL                      	#
007032,000694: 
007033,000695: 06,2525           02766        TEMPOK             TC       LAMPTEST                      	# IF TEMP NOW OK, DONT TURN OFF LAMP IF
007034,000696: 06,2526           12225                           TCF      NXTIFAIL                      	# LAMP TEST IN PROGRESS.
007035,000697: 
007036,000698: 06,2527           44750                           CS       BIT4                          	#
007037,000699: 06,2530           00006                           EXTEND                                 	#
007038,000700: 06,2531           03011                           WAND     DSALMOUT                      	# TURN OFF LAMP
007039,000701: 06,2532           12225                           TCF      NXTIFAIL                      	#

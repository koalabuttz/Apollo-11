030010,001634:                                                                                          	# PROGRAM DESCRIPTION
030011,001635:                                                                                          	# SUBROUTINE NAME       R36     OUT-OF-PLANE RENDEZVOUS ROUTINE
030012,001636:                                                                                          	# MOD NO. 0             DATE    22 DECEMBER 67
030013,001637:                                                                                          	# MOD BY N.M.NEVILLE    LOG SECTION EXTENDED VERBS
030014,001638:                                                                                          	# FUNCTIONAL DESCRIPTION
030015,001639: 
030016,001640:                                                                                          	# TO DISPLAY AT ASTRONAUT REQUEST LGC CALCULATED RENDEZVOUS
030017,001641:                                                                                          	# OUT-OF-PLANE PARAMETERS (Y, YDOT, PSI).  (REQUESTED BY DSKY).
030018,001642: 
030019,001643:                                                                                          	# CALLING SEQUENCE
030020,001644: 
030021,001645:                                                                                          	#       ASTRONAUT REQUEST THROUGH DSKY V 90 E
030022,001646: 
030023,001647:                                                                                          	# SUBROUTINES CALLED
030024,001648: 
030025,001649:                                                                                          	#       EXDSPRET
030026,001650:                                                                                          	#       GOMARKF
030027,001651:                                                                                          	#       CSMPREC
030028,001652:                                                                                          	#       LEMPREC
030029,001653:                                                                                          	#       SGNAGREE
030030,001654:                                                                                          	#       LOADTIME
030031,001655: 
030032,001656:                                                                                          	# NORMAL EXIT MODES
030033,001657: 
030034,001658:                                                                                          	#       ASTRONAUT REQUEST THROUGH DSKY TO TERMINATE PROGRAM V 34 E
030035,001659: 
030036,001660:                                                                                          	# ALARM OR ABORT EXIT MODES
030037,001661: 
030038,001662:                                                                                          	#       NONE
030039,001663: 
030040,001664:                                                                                          	# OUTPUT
030041,001665: 
030042,001666:                                                                                          	#       DECIMAL DISPLAY OF TIME, Y, YDOT AND PSI
030043,001667: 
030044,001668:                                                                                          	#       DISPLAYED VALUES Y, YDOT, AND PSI, ARE STORED IN ERASABLE
030045,001669:                                                                                          	#       REGISTERS RANGE, RRATE AND RTHETA RESPECTIVELY.
030046,001670: 
030047,001671:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
030048,001672: 
030049,001673:                                                                                          	#       CSM AND LEM STATE VECTORS
030050,001674: 
030051,001675:                                                                                          	# DEBRIS
030052,001676: 
030053,001677:                                                                                          	#       CENTRALS A,Q,L

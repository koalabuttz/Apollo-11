007165,000827:                                                                                          	# PROGRAM NAME:  IMUOP.
007166,000828: 
007167,000829:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM PROCESSES CHANGES IN THE ISS OPERATE DISCRETE, BIT 9 OF CHANNEL 30.
007168,000830:                                                                                          	# IF THE INBIT CHANGES TO 0, INDICATING ISS ON, IMUOP GENERALLY SETS BIT 7 OF IMODES30 TO 1 TO REQUEST ISS
007169,000831:                                                                                          	# INITIALIZATION VIA TNONTEST.  AN EXCEPTION IS DURING A FAILED ISS DELAY DURING WHICH BIT 2 OF IMODES30 IS SET
007170,000832:                                                                                          	# TO 1 AND NO FURTHER INITIALIZATION IS REQUIRED.  WHEN THE INBIT CHANGES TO 1, INDICATING ISS OFF, IMUSEFLG IS
007171,000833:                                                                                          	# TESTED TO SEE IF ANY PROGRAM WAS USING THE ISS.  IF SO, PROGRAM ALARM 00214 IS ISSUED.
007172,000834: 
007173,000835:                                                                                          	# CALLING SEQUENCE:  BY IMUMON WHEN BIT 9 OF CHANNEL 30 CHANGES.
007174,000836: 
007175,000837:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
007176,000838:                                                                                          	# 
007177,000839:                                                                                          	# SUBROUTINES CALLED:  ALARM, IF ISS IS TURNED OFF WHILE IN USE.
007178,000840: 
007179,000841:                                                                                          	# ERASABLE INITIALIZATION:  ON FRESH START AND RESTART, BIT 9 OF IMODES30 IS SET TO 1 EXCEPT WHEN THE GIMBAL LOCK
007180,000842:                                                                                          	# LAMP IS ON, IN WHICH CASE IT IS SET TO 0.  THIS PREVENTS ICDU ZERO BY TNONTEST WITH THE ISS IN GIMBAL LOCK.
007181,000843: 
007182,000844:                                                                                          	# ALARMS:  PROGRAM ALARM 00214 IF THE ISS IS TURNED OFF WHILE IN USE.
007183,000845: 
007184,000846:                                                                                          	# EXIT:  NXTIFAIL.
007185,000847: 
007186,000848:                                                                                          	# OUTPUT:  ISS INITIALIZATION REQUEST (IMODES30 BIT 7) OR PROGRAM ALARM 00214.
007187,000849: 
007188,000850: 06,2622           00006        IMUOP              EXTEND                                 	#
007189,000851: 06,2623           12643                           BZF      IMUOP2                        	#
007190,000852: 
007191,000853: 06,2624           41303                           CS       IMODES33                      	# DISABLE DAP
007192,000854: 06,2625           74746                           MASK     BIT6                          	#
007193,000855: 06,2626           27303                           ADS      IMODES33                      	#
007194,000856: 
007195,000857: 06,2627           04674                           TC       IBNKCALL                      	# KNOCK DOWN TRACK, REFSMMAT, DRIFT FLAGS
007196,000858: 06,2630           17175                           CADR     RNDREFDR                      	#
007197,000859: 
007198,000860: 06,2631           42777                           CS       BITS7&8                       	# KNOCK DOWN RENDEZVOUS, IMUUSE FLAGS
007199,000861: 06,2632           70074                           MASK     FLAGWRD0                      	#
007200,000862: 06,2633           56074                           XCH      FLAGWRD0                      	# IF GOING OFF, ALARM IF PROG USING IMU.
007201,000863: 06,2634           40000                           COM                                    	#
007202,000864: 06,2635           74744                           MASK     IMUSEFLG                      	#
007203,000865: 06,2636           10000                           CCS      A                             	#
007204,000866: 06,2637           12225                           TCF      NXTIFAIL                      	#
007205,000867: 
007206,000868: 06,2640           05567                           TC       ALARM                         	#
007207,000869: 06,2641           00214                           OCT      214                           	#
007208,000870: 06,2642           12225                           TCF      NXTIFAIL                      	#
007209,000871: 
007210,000872: 06,2643           34752        IMUOP2             CAF      BIT2                          	# SEE IF FAILED ISS TURN-ON SEQ IN PROG.
007211,000873: 06,2644           71302                           MASK     IMODES30                      	#
007212,000874: 06,2645           10000                           CCS      A                             	#
007213,000875: 06,2646           12225                           TCF      NXTIFAIL                      	# IF SO, DONT PROCESS UNTIL PRESENT 90

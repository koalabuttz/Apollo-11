023682,002486: 
023684,002488:                                                                                          	# PROGRAM NAME_  DODES
023685,002489: 
023686,002490:                                                                                          	# FUNCTIONAL DESCRIPTION_
023687,002491: 
023688,002492:                                                                                          	#       DODES CALCULATES AND REQUESTS ISSUANCE OF RR GYRO TORQUE
023689,002493:                                                                                          	#       COMMANDS.  INITIALLY THE CURRENT RR CDU ANGLES ARE STORED AND
023690,002494:                                                                                          	#       THE LOS HALF-UNIT VECTOR TRANSFORMED FROM STABLE MEMBER TO
023691,002495:                                                                                          	#       NAVIGATION BASE COORDINATES VIA SMNB IF NECESSARY.  THE
023692,002496:                                                                                          	#       SHAFT AND TRUNNION COMMANDS ARE THEN CALCULATED AS FOLLOWS_
023693,002497:                                                                                          	#               + SHAFT = LOS . (COS(S), 0, -SIN(S))  (DOT PRODUCT)
023694,002498:                                                                                          	#               - TRUNNION = LOS . (SIN(T)SIN(S), COS(T), SIN(T)COS(S))
023695,002499:                                                                                          	#       THE SIGN OF THE SHAFT COMMAND IS THEN REVERSED IF IN MODE 2
023696,002500:                                                                                          	#       (RADMODES BIT 12) BECAUSE A RELAY IN THE RR REVERSES THE 
023697,002501:                                                                                          	#       POLARITY OF THE COMMAND.  AT RRSCALUP EACH COMMAND IS
023698,002502:                                                                                          	#       SCALED AND IF EITHER, OR BOTH, OF THE COMMANDS IS GREATER THAN
023699,002503:                                                                                          	#       .5 DEGREES, MPAC +1 IS SET POSITIVE.  IF A CONTINUOUS DESIGNATE 
023700,002504:                                                                                          	#       (RADMODES BIT 15) IS DESIRED AND THE SEARCH ROUTINE IS NOT OPERATING,
023701,002505:                                                                                          	#       THE RR AUTO TRACKER ENABLE BIT (CHAN 12 BIT 14) IS CLEARED AND RROUT
023702,002506:                                                                                          	#       CALLED TO PUT OUT THE COMMANDS PROVIDED NO REPOSITION (RADMODES BIT 11)
023703,002507:                                                                                          	#       IS IN PROGRESS.  IF A CONTINUOUS DESIGNATE AND THE SEARCH ROUTINE IS
023704,002508:                                                                                          	#       OPERATING (SRCHOPT FLAG SET) THE TRACK ENABLE IS NOT CLEARED.  IF NO
023705,002509:                                                                                          	#       CONTINUOUS DESIGNATE AND BOTH COMMANDS ARE NOT LESS THAN .5 DEGREES AS
023706,002510:                                                                                          	#       INDICATED BY MPAC +1, THE RR AUTO TRACKER ENABLE BIT (CHAN 12 BIT 14) IS
023707,002511:                                                                                          	#       CLEARED AND RROUT CALLED TO PUT OUT THE COMMANDS PROVIDED NO REPOSITION
023708,002512:                                                                                          	#       (RADMODES BIT 11) IS IN PROGRESS.  IF BOTH COMMANDS ARE LESS THAN .5
023709,002513:                                                                                          	#       DEGREES AS INDICATED BY MPAC+1, THE RR AUTO TRACKER ENABLE BIT
023710,002514:                                                                                          	#       (CHAN 12 BIT 14) IS CLEARED AND RROUT CALLED TO PUT OUT THE
023711,002515:                                                                                          	#       COMMANDS PROVIDED NO REPOSITION (RADMODES BIT 11) IS IN
023712,002516:                                                                                          	#       PROGRESS.  IF BOTH COMMANDS ARE LESS THAN .5 DEGREES, THE
023713,002517:                                                                                          	#       LOCK-ON FLAG (STATE BIT 5) IS CHECKED.  IF NOT PRESENT, THE
023714,002518:                                                                                          	#       DESIGNATE FLAG (RADMODES BIT 10) IS CLEARED, THE RR ERROR
023715,002519:                                                                                          	#       COUNTER ENABLE BIT (CHAN 12 BIT 2) IS CLEARED, AND ENDOFJOB
023716,002520:                                                                                          	#       CALLED. IF LOCK-ON IS DESIRED, THE RR AUTO TRACKER (CHAN 12
023717,002521:                                                                                          	#       BIT 14) IS ENABLED FOLLOWED BY A CHECK OF THE RECEIPT OF THE
023718,002522:                                                                                          	#       RR DATA GOOD (CHAN 33 BIT 4) SIGNAL.  IF RR DATA GOOD
023719,002523:                                                                                          	#       PRESENT, THE DESIGNATE FLAG (RADMODES BIT 10) IS CLEARED,
023720,002524:                                                                                          	#       THE RR ERROR COUNTER ENABLE BIT (CHAN 12 BIT 2) IS CLEARED,
023721,002525:                                                                                          	#       AND ENDOFJOB CALLED.  IF RR DATA GOOD IS NOT PRESENT, RROUT
023722,002526:                                                                                          	#       IS CALLED TO PUT OUT THE COMMANDS PROVIDED NO REPOSITION
023723,002527:                                                                                          	#       (RADMODES BIT 11) IS IN PROGRESS AFTER WHICH THE JOB IS TERMINATED
023724,002528:                                                                                          	#       VIA ENDOFJOB.
023725,002529: 

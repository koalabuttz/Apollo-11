003756,000189: 
003758,000191:                                                                                          	# INTERPRETIVE SWITCH BIT ASSIGNMENTS
003759,000192: 
003760,000193:                                                                                          	#       ** FLAGWORDS AND BITS NOW ASSIGNED AND DEFINED IN THEIR OWN LOG SECTION. **
003761,000194: 
003763,000196:                                                                                          	# GENERAL ERASABLE ASSIGNMENTS.
003764,000197: 
003765,000198:    0061                                           SETLOC   61                            	#
003766,000199:                                                                                          	# INTERRUPT TEMPORARY STORAGE POOL.     (11D)
003767,000200: 
003768,000201:                                                                                          	# (ITEMP1 THROUGH RUPTREG4)             
003769,000202: 
003770,000203:                                                                                          	# ANY OF THESE MAY BE USED AS TEMPORARIES DURING INTERRUPT OR WITH INTERRUPT INHIBITED. THE ITEMP SERIES
003771,000204:                                                                                          	# IS USED DURING CALLS TO THE EXECUTIVE AND WAITLIST - THE RUPTREGS ARE NOT.
003772,000205: 
003773,000206:    0061                        ITEMP1             ERASE                                  	#
003774,000207:    0062     0061               WAITEXIT           EQUALS   ITEMP1                        	#
003775,000208:    0062     0061               EXECTEM1           EQUALS   ITEMP1                        	#
003776,000209: 
003777,000210:    0062                        ITEMP2             ERASE                                  	#
003778,000211:    0063     0062               WAITBANK           EQUALS   ITEMP2                        	#
003779,000212:    0063     0062               EXECTEM2           EQUALS   ITEMP2                        	#
003780,000213: 
003781,000214:    0063                        ITEMP3             ERASE                                  	#
003782,000215:    0064     0063               RUPTSTOR           EQUALS   ITEMP3                        	#
003783,000216:    0064     0063               WAITADR            EQUALS   ITEMP3                        	#
003784,000217:    0064     0063               NEWPRIO            EQUALS   ITEMP3                        	#
003785,000218: 
003786,000219:    0064                        ITEMP4             ERASE                                  	#
003787,000220:    0065     0064               LOCCTR             EQUALS   ITEMP4                        	#
003788,000221:    0065     0064               WAITTEMP           EQUALS   ITEMP4                        	#
003789,000222: 
003790,000223:    0065                        ITEMP5             ERASE                                  	#
003791,000224:    0066     0065               NEWLOC             EQUALS   ITEMP5                        	#
003792,000225: 
003793,000226:    0066                        ITEMP6             ERASE                                  	#
003794,000227:                                                                                          	# NEWLOC+1      EQUALS  ITEMP6          DP ADDRESS.
003795,000228: 
003796,000229:    0067                                           SETLOC   67                            	#
003797,000230:    0067                        NEWJOB             ERASE                                  	# MUST BE AT LOC 67 DUE TO WIRING.
003798,000231: 
003799,000232:    0070                        RUPTREG1           ERASE                                  	#
003800,000233:    0071                        RUPTREG2           ERASE                                  	#
003801,000234:    0072                        RUPTREG3           ERASE                                  	#
003802,000235:    0073                        RUPTREG4           ERASE                                  	#
003803,000236:    0074     0073               KEYTEMP1           EQUALS   RUPTREG4                      	#
003804,000237:    0074     0073               DSRUPTEM           EQUALS   RUPTREG4                      	#
003805,000238: 
003806,000239:                                                                                          	# FLAGWORD RESERVATIONS.                (16D)
003807,000240: 
003808,000241:    0074                        STATE              ERASE    +15D                          	# FLAGWORD REGISTERS.
003809,000242: 
003810,000243:                                                                                          	# P25 RADAR STORAGE.  (MAY BE UNSHARED IN E7)  (TEMP OVERLAY)  (2D)  OVERLAYS FLGWRD 14 & 15
003812,000245:    0114     0112               LASTYCMD           EQUALS   STATE      +14D               	# B(1)PRM       THESE ARE CALLED BY T4RUPT
003813,000246:    0114     0113               LASTXCMD           EQUALS   LASTYCMD   +1                 	# B(1)PRM       THEY MUST BE CONTIGUOUS, Y FIRST
003814,000247: 
003815,000248:                                                                                          	# EXEC TEMPORARIES WHICH MAY BE USED BETWEEN CCS NEWJOBS. (32D) (INTB15+ THROUGH RUPTMXTM)
003816,000249:    0114                        INTB15+            ERASE                                  	# REFLECTS 15TH BIT OF INDEXABLE ADDRESSES
003817,000250:    0115     0114               DSEXIT             =        INTB15+                       	# RETURN FOR DSPIN
003818,000251:    0115     0114               EXITEM             =        INTB15+                       	# RETURN FOR SCALE FACTOR ROUTINE SELECT
003819,000252:    0115     0114               BLANKRET           =        INTB15+                       	# RETURN FOR 2BLANK
003820,000253: 
003821,000254:    0115                        INTBIT15           ERASE                                  	# SIMILAR TO ABOVE.
003822,000255:    0116     0115               WRDRET             =        INTBIT15                      	# RETURN FOR 5BLANK
003823,000256:    0116     0115               WDRET              =        INTBIT15                      	# RETURN FOR DSPWD
003824,000257:    0116     0115               DECRET             =        INTBIT15                      	# RETURN FOR PUTCOM(DEC LOAD)
003825,000258:    0116     0115               21/22REG           =        INTBIT15                      	# TEMP FOR CHARIN
003826,000259: 
003827,000260:                                                                                          	# THE REGISTERS BETWEEN ADDRWD AND PRIORITY MUST STAY IN THE FOLLOWING ORDER FOR INTERPRETIVE TRACE.
003828,000261: 
003829,000262:    0116                        ADDRWD             ERASE                                  	# 12 BIT INTERPRETIVE OPERAND SUB-ADDRESS.
003830,000263:    0117                        POLISH             ERASE                                  	# HOLDS CADR MADE FROM POLISH ADDRESS.
003831,000264:    0120     0117               UPDATRET           =        POLISH                        	# RETURN FOR UPDATNN, UPDATVB
003832,000265:    0120     0117               CHAR               =        POLISH                        	# TEMP FOR CHARIN
003833,000266:    0120     0117               ERCNT              =        POLISH                        	# COUNTER FOR ERROR LIGHT RESET
003834,000267:    0120     0117               DECOUNT            =        POLISH                        	# COUNTER FOR SCALING AND DISPLAY (DEC)
003835,000268: 
003836,000269:    0120                        FIXLOC             ERASE                                  	# WORK AREA ADDRESS.
003837,000270:    0121                        OVFIND             ERASE                                  	# SET NON-ZERO ON OVERFLOW.
003838,000271: 
003839,000272:    0122                        VBUF               ERASE    +5                            	# TEMPORARY STORAGE USED FOR VECTORS.
003840,000273:    0130     0122               SGNON              =        VBUF                          	# TEMP FOR +,- ON
003841,000274:    0130     0122               NOUNTEM            =        VBUF                          	# COUNTER FOR MIXNOUN FETCH
003842,000275:    0130     0122               DISTEM             =        VBUF                          	# COUNTER FOR OCTAL DISPLAY VERBS
003843,000276:    0130     0122               DECTEM             =        VBUF                          	# COUNTER FOR FETCH (DEC DISPLAY VERBS)
003844,000277: 
003845,000278:    0130     0123               SGNOFF             =        VBUF       +1                 	# TEMP FOR +,- ON
003846,000279:    0130     0123               NVTEMP             =        VBUF       +1                 	# TEMP FOR NVSUB
003847,000280:    0130     0123               SFTEMP1            =        VBUF       +1                 	# STORAGE FOR SF CONST HI PART (=SFTEMP2-1)
003848,000281:    0130     0123               HITEMIN            =        VBUF       +1                 	# TEMP FOR LOAD OF HRS,MIN,SEC
003849,000282:                                                                                          	# MUST = LOTEMIN-1.
003850,000283: 
003851,000284:    0130     0124               CODE               =        VBUF       +2                 	# FOR DSPIN
003852,000285:    0130     0124               SFTEMP2            =        VBUF       +2                 	# STORAGE FOR SF CONST LO PART (=SFTEMP1+1)
003853,000286:    0130     0124               LOTEMIN            =        VBUF       +2                 	# TEMP FOR LOAD OF HRS,MIN,SEC
003854,000287:                                                                                          	# MUST = HITEMIN+1.
003855,000288: 
003856,000289:    0130     0125               MIXTEMP            =        VBUF       +3                 	# FOR MIXNOUN DATA
003857,000290:    0130     0125               SIGNRET            =        VBUF       +3                 	# RETURN FOR +,- ON
003858,000291: 
003859,000292:                                                                                          	# ALSO MIXTEMP+1 = VBUF+4, MIXTEMP+2 = VBUF+5.
003860,000293: 
003861,000294:    0130                        BUF                ERASE    +2                            	# TEMPORARY SCALAR STORAGE.
003863,000296:    0133                        BUF2               ERASE    +1                            	#
003864,000297:    0135     0130               INDEXLOC           EQUALS   BUF                           	# CONTAINS ADDRESS OF SPECIFIED INDEX.
003865,000298:    0135     0130               SWWORD             EQUALS   BUF                           	# ADDRESS OF SWITCH WORD.
003866,000299:    0135     0131               SWBIT              EQUALS   BUF        +1                 	# SWITCH BIT WITHIN SWITCH WORD.
003867,000300:    0135                        MPTEMP             ERASE                                  	# TEMPORARY USED IN MULTIPLY AND SHIFT.
003868,000301:    0136     0135               DMPNTEMP           =        MPTEMP                        	# DMPSUB TEMPORARY
003869,000302:    0136                        DOTINC             ERASE                                  	# COMPONENT INCREMENT FOR DOT SUBROUTINE.
003870,000303:    0137     0136               DVSIGN             EQUALS   DOTINC                        	# DETERMINES SIGN OF DDV RESULT.
003871,000304:    0137     0136               ESCAPE             EQUALS   DOTINC                        	# USED IN ARCSIN/ARCCOS.

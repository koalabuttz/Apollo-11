002099,000033: 
002100,000034:                                                                                          	# *** CHANNEL DESCRIPTIONSF WORDS ARE ALLOCATED IN ERASABLE ASSIGNMENTS ***
002101,000035: 
002102,000036:                                                                                          	# CHANNEL 1     IDENTICAL TO COMPUTER REGISTER L (0001)
002103,000037: 
002104,000038:                                                                                          	# CHANNEL 2     IDENTICAL TO COMPUTER REGISTER Q (0002)
002105,000039: 
002106,000040:                                                                                          	# CHANNEL 3     HISCALAR; INPUT CHANNEL; MOST SIGNIFICANT 14 BITS FROM 33 STAGE BINARY COUNTER. SCALE
002107,000041:                                                                                          	#               FACTOR IS B23 IN CSEC, SO MAX VALUE ABOUT 23.3 HOURS AND LEAST SIGNIFICANT BIT 5.12 SECS.
002108,000042: 
002109,000043:                                                                                          	# CHANNEL 4     LOSCALAR; INPUT CHANNEL; NEXT MOST SIGNIFICANT 14 BITS FROM THE 33 STAGE BINARY COUNTER
002110,000044:                                                                                          	#               ASSOCIATED WITH CHANNEL 3. SCALE FACTOR IS B9 IN CSEC. SO MAX VAL IS 5.12 SEC AND LEAST
002111,000045:                                                                                          	#               SIGNIFICANT BIT IS 1/3200 SEC. SCALE FACTOR OF D.P. WORD WITH CHANNEL 3 IS B23 CSEC.
002112,000046: 
002113,000047:                                                                                          	# CHANNEL 5     PYJETS;  OUTPUT CHANNEL; PITCH RCS JET CONTROL.  (REACTION CONTROL SYSTEM) USES BITS 1-8.
002114,000048: 
002115,000049:                                                                                          	# CHANNEL 6     ROLLJETS; OUTPUT CHANNEL; ROLL RCS JET CONTROL.  (REACTION CONTROL SYSTEM) USES BIT 1-8.
002116,000050: 
002117,000051:                                                                                          	# CHANNEL 7     SUPERBNK; OUTPUT CHANNEL; NOT RESET BY RESTART; FIXED EXTENSION BITS USED TO SELECT THE
002118,000052:                                                                                          	#               APPROPRIATE FIXED MEMORY BANK IF FBANK IS 30 OCTAL OR MORE.  USES BITS 5-7.
002119,000053: 
002120,000054:                                                                                          	# CHANNEL 10    OUTO; OUTPUT CHANNEL; REGISTER USED TO TRANSMIT LATCHING-RELAY DRIVING INFORMATION FOR
002121,000055:                                                                                          	#               THE DISPLAY SYSTEM.  BITS 15-12 ARE SET TO THE ROW NUMBER (1-14 OCTAL) OF THE RELAY TO BE
002122,000056:                                                                                          	#               CHANGED AND BITS 11-1 CONTAIN THE REQUIRED SETTINGS FOR THE RELAYS IN THE ROW.
002123,000057: 
002124,000058:                                                                                          	# CHANNEL 11    DSALMOUT; OUTPUT CHANNEL; REGISTER WHOSE BITS ARE USED FOR ENGINE ON-OFF CONTROL AND TO
002125,000059:                                                                                          	#               DRIVE INDIVIDUAL INDICATORS OF THE DISPLAY SYSTEM.  BITS 1-7 ARE A RELAYS.
002126,000060: 
002127,000061:                                                                                          	#               BIT 1           ISS WARNING
002128,000062:                                                                                          	#               BIT 2           LIGHT COMPUTER ACTIVITY LAMP
002129,000063:                                                                                          	#               BIT 3           LIGHT UPLINK ACTIVITY LAMP
002130,000064:                                                                                          	#               BIT 4           LIGHT TEMP CAUTION LAMP
002131,000065:                                                                                          	#               BIT 5           LIGHT KEYBOARD RELEASE LAMP
002132,000066:                                                                                          	#               BIT 6           FLASH VERB AND NOUN LAMPS
002133,000067:                                                                                          	#               BIT 7           LIGHT OPERATOR ERROR LAMP
002135,000069:                                                                                          	#               BIT 8           SPARE
002136,000070:                                                                                          	#               BIT 9           TEST CONNECTOR OUTBIT
002137,000071:                                                                                          	#               BIT 10          CAUTION RESET
002138,000072:                                                                                          	#               BIT 11          SPARE
002139,000073:                                                                                          	#               BIT 12          SPARE
002140,000074:                                                                                          	#               BIT 13          ENGINE ON
002141,000075:                                                                                          	#               BIT 14          ENGINE OFF
002142,000076:                                                                                          	#               BIT 15          SPARE
002143,000077: 
002144,000078:                                                                                          	# CHANNEL 12    CHAN12; OUTPUT CHANNEL; BITS USED TO DRIVE NAVIGATION AND SPAECRAFT HARDWARE
002145,000079: 
002146,000080:                                                                                          	#               BIT 1           ZERO RR CDU; CDU'S GIVE RRADAR INFORMATION FOR LM
002147,000081:                                                                                          	#               BIT 2           ENABLE CDU RADAR ERROR COUNTERS
002148,000082:                                                                                          	#               BIT 3           NOT USED
002149,000083:                                                                                          	#               BIT 4           COARSE ALIGN ENABLE OF IMU
002150,000084:                                                                                          	#               BIT 5           ZERO IMU CDU'S
002151,000085:                                                                                          	#               BIT 6           ENABLE IMU ERROR COUNTER, CDU ERROR COUNTER.
002152,000086:                                                                                          	#               BIT 7           SPARE
002153,000087:                                                                                          	#               BIT 8           DISPLAY INERTIAL DATA
002154,000088:                                                                                          	#               BIT 9           -PITCH GIMBAL TRIM (BELL MOTION) DESCENT ENGINE
002155,000089:                                                                                          	#               BIT 10          +PITCH GIMBAL TRIM (BELL MOTION) DESCENT ENGINE
002156,000090:                                                                                          	#               BIT 11          -ROLL GIMBAL TRIM (BELL MOTION) DESCENT ENGINE
002157,000091:                                                                                          	#               BIT 12          +ROLL GIMBAL TRIM (BELL MOTION) DESCENT ENGINE
002158,000092:                                                                                          	#               BIT 13          LR POSITION 2 COMMAND
002159,000093:                                                                                          	#               BIT 14          ENABLE RENDESVOUS RADAR LOCK-ON; AUTO ANGLE TRACK'G
002160,000094:                                                                                          	#               BIT 15          ISS TURN ON DELAY COMPLETE
002161,000095: 
002163,000097:                                                                                          	# CHANNEL 13    CHAN13; OUTPUT CHANNEL
002164,000098: 
002165,000099:                                                                                          	#               BIT 1           RADAR C         PROPER SETTING OF THE A,B,C MATRIX
002166,000100:                                                                                          	#               BIT 2           RADAR B         SELECTS CERTAIN RADAR
002167,000101:                                                                                          	#               BIT 3           RADAR A         PARAMETERS TO BE READ.
002168,000102:                                                                                          	#               BIT 4           RADAR ACTIVITY
002169,000103:                                                                                          	#               BIT 5           NOT USED (CONNECTS AN ALTERNATE INPUT TO UPLINK)
002170,000104:                                                                                          	#               BIT 6           BLOCK INPUTS TO UPLINK CELL
002171,000105:                                                                                          	#               BIT 7           DOWNLINK TELEMETRY WORD ORDER CODE BIT
002172,000106:                                                                                          	#               BIT 8           RHC COUNTER ENABLE (READ HAND CONTROLLER ANGLES)
002173,000107:                                                                                          	#               BIT 9           START RHC READ INTO COUNTERS IF BIT 8 SET
002174,000108:                                                                                          	#               BIT 10          TEST ALARMS, TEST DSKY LIGHTS
002175,000109:                                                                                          	#               BIT 11          ENABLE STANDBY
002176,000110:                                                                                          	#               BIT 12          RESET TRAP 31-A         ALWAYS APPEAR TO BE SET TO 0
002177,000111:                                                                                          	#               BIT 13          RESET TRAP 31-B         ALWAYS APPEAR TO BE SET TO 0
002178,000112:                                                                                          	#               BIT 14          RESET TRAP 32           ALWAYS APPEAR TO BE SET TO 0
002179,000113:                                                                                          	#               BIT 15          ENABLE T6 RUPT
002180,000114: 
002181,000115:                                                                                          	# CHANNEL 14    CHAN14; OUTPUT CHANNEL; USED TO CONTROL COMPUTER COUNTER CELLS (CDU, GYRO, SPACECRAFT FUNC.
002182,000116: 
002183,000117:                                                                                          	#               BIT 1           OUTLINK ACTIVITY (NOT USED)
002184,000118:                                                                                          	#               BIT 2           ALTITUDE RATE OR ALTITIDE SELECTOR
002185,000119:                                                                                          	#               BIT 3           ALTITUDE METER ACTIVITY
002186,000120:                                                                                          	#               BIT 4           THRUST DRIVE ACTIVITY FOR DESCENT ENGINE
002187,000121:                                                                                          	#               BIT 5           SPARE
002188,000122:                                                                                          	#               BIT 6           GYRO ENABLE POWER FOR PULSES
002189,000123:                                                                                          	#               BIT 7           GYRO SELECT B           PAIR OF BITS IDENTIFIES AXIS OF -
002190,000124:                                                                                          	#               BIT 8           GYRO SELECT A           GYRO SYSTEM TO BE TORQUED.
002191,000125:                                                                                          	#               BIT 9           GYRO TORQUING COMMAND IN NEGATIVE DIRECTION
002193,000127:                                                                                          	#               BIT 10          GYRO ACTIVITY
002194,000128:                                                                                          	#               BIT 11          DRIVE CDU S
002195,000129:                                                                                          	#               BIT 12          DRIVE CDU T
002196,000130:                                                                                          	#               BIT 13          DRIVE CDU Z
002197,000131:                                                                                          	#               BIT 14          DRIVE CDU Y
002198,000132:                                                                                          	#               BIT 15          DRIVE CDU X
002199,000133: 
002200,000134:                                                                                          	# CHANNEL 15    MNKEYIN; INPUT CHANNEL; KEY CODE INPUT FROM KEYBOARD OF DSKY, SENSED BY PROGRAM WHEN
002201,000135:                                                                                          	#               PROGRAM INTERRUPT #5 IS RECEIVED.  USES BITS 5-1
002202,000136: 
002203,000137:                                                                                          	# CHANNEL 16    NAVKEYIN; INPUT CHANNEL; OPTICS MARK INFORMATION AND NAVIGA ION PANEL DSKY (CM) OR THRUST
002204,000138:                                                                                          	#               CONTROL (LM) SENSED BY PROGRAM WHEN PROGRAM INTER-RUPT #6 IS RECEIVED.  USES BITS 3-7 ONLY.
002205,000139: 
002206,000140:                                                                                          	#               BIT 1           NOT ASSIGNED
002207,000141:                                                                                          	#               BIT 2           NOT ASSIGNED
002208,000142:                                                                                          	#               BIT 3           OPTICS X-AXIS MARK SIGNAL FOR ALIGN OPTICAL TSCOPE
002209,000143:                                                                                          	#               BIT 4           OPTICS Y-AXIS MARK SIGNAL FOR AOT
002210,000144:                                                                                          	#               BIT 5           OPTICS MARK REJECT SIGNAL
002211,000145:                                                                                          	#               BIT 6           DESCENT+ ; CREW DESIRED SLOWING RATE OF DESCENT
002212,000146:                                                                                          	#               BIT 7           DESCENT- ; CREW DESIRED SPEEDING UP RATE OF D'CENT
002213,000147: 
002214,000148:                                                                                          	# NOTE: ALL BITS IN CHANNELS 30-33 ARE INVERTED AS SENSED BY THE PROGRAM, SO THAT A VALUE OF ZERO MEANS
002215,000149:                                                                                          	# THAT THE INDICATED SIGNAL IS PRESENT.
002216,000150: 
002217,000151:                                                                                          	# CHANNEL 30    INPUT CHANNEL
002218,000152: 
002219,000153:                                                                                          	#               BIT 1           ABORT WITH DESCENT STAGE
002220,000154:                                                                                          	#               BIT 2           UNUSED
002221,000155:                                                                                          	#               BIT 3           ENGINE ARMED SIGNAL
002222,000156:                                                                                          	#               BIT 4           ABORT WITH ASCENT ENGINE STAGE
002223,000157:                                                                                          	#               BIT 5           AUTO THROTTLE; COMPUTER CONTROL OF DESCENT ENGINE
002225,000159:                                                                                          	#               BIT 6           DISPLAY INERTIAL DATA
002226,000160:                                                                                          	#               BIT 7           RR CDU FAIL
002227,000161:                                                                                          	#               BIT 8           SPARE
002228,000162:                                                                                          	#               BIT 9           IMU OPERATE WITH NO MALFUNCTION
002229,000163:                                                                                          	#               BIT 10          LM COMPUTER (NOT AGS) HAS CONTROL OF LM
002230,000164:                                                                                          	#               BIT 11          IMU CAGE COMMAND TO DRIVE IMU GIMBAL ANGLES TO 0.
002231,000165:                                                                                          	#               BIT 12          IMU CDU FAIL (MALFUNCTION OF IMU CDU,S)
002232,000166:                                                                                          	#               BIT 13          IMU FAIL (MALFUNCTION OF IMU STABILIZATION LOOPS)
002233,000167:                                                                                          	#               BIT 14          ISS TURN ON REQUESTED
002234,000168:                                                                                          	#               BIT 15          TEMPERATURE OF STABLE MEMBER WITHIN DESIGN LIMITS
002235,000169: 
002236,000170:                                                                                          	# CHANNEL 31    INPUT CHANNEL; BITS ASSOCIATED WITH THE ATTITUDE CONTROLLER, TRANSLATIONAL CONTROLLER,
002237,000171:                                                                                          	#               AND SPACECRAFT ATTITUDE CONTROL; USED BY RCS DAP
002238,000172: 
002239,000173:                                                                                          	#               BIT 1           ROTATION (BY RHC) COMMANDED IN POSITIVE PITCH DIRECTION; MUST BE IN MINIMUM IMPULSE MODE.
002240,000174:                                                                                          	#                               ALSO POSITIVE ELEVATION CHANGE FOR LANDING POINT DESIGNATOR
002241,000175:                                                                                          	#               BIT 2           AS BIT 1 EXCEPT NEGATIVE PITCH AND ELEVATION
002242,000176:                                                                                          	#               BIT 3           ROTATION (BY RHC) COMMANDED IN POSITIVE YAW DIRECTION; MUST BE IN MINUMUM IMPULSE MODE.
002243,000177:                                                                                          	#               BIT 4           AS BIT 3 EXCEPT NEGATIVE YAW
002244,000178:                                                                                          	#               BIT 5           ROTATION (BY RHC) COMMANDED IN POSITIVE ROLL DIRECTION; MUST BE IN MINIMUM IMPULSE MODE.
002245,000179:                                                                                          	#                               ALSO POSITIVE AZIMUTH CHANGE FOR LANDING POINT DESIGNATOR
002246,000180:                                                                                          	#               BIT 6           AS BIT 5 EXCEPT NEGATIVE ROLL AND AZIMUTH
002247,000181:                                                                                          	#               BIT 7           TRANSLATION IN +X DIRECTION COMMANDED BY THC
002248,000182:                                                                                          	#               BIT 8           TRANSLATION IN -X DIRECTION COMMANDED BY THC
002249,000183:                                                                                          	#               BIT 9           TRANSLATION IN +Y DIRECTION COMMANDED BY THC
002250,000184:                                                                                          	#               BIT 10          TRANSLATION IN -Y DIRECTION COMMANDED BY THC
002251,000185:                                                                                          	#               BIT 11          TRANSLATION IN +Z DIRECTION COMMANDED BY THC
002252,000186:                                                                                          	#               BIT 12          TRANSLATION IN -Z DIRECTION COMMANDED BY THC
002254,000188:                                                                                          	#               BIT 13          ATTITUDE HOLD MODE ON SCS MODE CONTROL SWITCH
002255,000189:                                                                                          	#               BIT 14          AUTO STABILIZATION OF ATTITUDE ON SCS MODE SWITCH
002256,000190:                                                                                          	#               BIT 15          ATTITUDE CONTROL OUT OF DETENT (RHC NOT IN NEUTRAL
002257,000191: 
002258,000192:                                                                                          	# CHANNEL 32    INPUT CHANNEL.
002259,000193: 
002260,000194:                                                                                          	#               BIT 1           THRUSTERS 2 & 4 DISABLED BY CREW
002261,000195:                                                                                          	#               BIT 2           THRUSTERS 5 & 8 DISABLED BY CREW
002262,000196:                                                                                          	#               BIT 3           THRUSTERS 1 & 3 DISABLED BY CREW
002263,000197:                                                                                          	#               BIT 4           THRUSTERS 6 & 7 DISABLED BY CREW
002264,000198:                                                                                          	#               BIT 5           THRUSTERS 14 & 16 DISABLED BY CREW
002265,000199:                                                                                          	#               BIT 6           THRUSTERS 13 & 15 DISABLED BY CREW
002266,000200:                                                                                          	#               BIT 7           THRUSTERS 9 & 12 DISABLED BY CREW
002267,000201:                                                                                          	#               BIT 8           THRUSTERS 10 & 11 DISABLED BY CREW
002268,000202:                                                                                          	#               BIT 9           DESCENT ENGINE GIMBALS DISABLED BY CREW
002269,000203:                                                                                          	#               BIT 10          APPARENT DESCENT ENGINE GIMBAL FAILURE
002270,000204:                                                                                          	#               BIT 14          INDICATES PROCEED KEY IS DEPRESSED
002271,000205: 
002272,000206:                                                                                          	# CHANNEL 33    CHAN33; INPUT CHANNEL; FOR HARDWARE STATUS AND COMMAND INFORMATION.  BITS 15-11 ARE FLIP-
002273,000207:                                                                                          	#               FLOP BITS RESET BY A CHANNEL "WRITE" COMMAND THAT ARE RESET BY A RESTART & BY T4RUPT LOOP.
002274,000208: 
002275,000209:                                                                                          	#               BIT 1           SPARE
002276,000210:                                                                                          	#               BIT 2           RR AUTO-POWER ON
002277,000211:                                                                                          	#               BIT 3           RR RANGE LOW SCALE
002278,000212:                                                                                          	#               BIT 4           RR DATA GOOD
002279,000213:                                                                                          	#               BIT 5           LR RANGE DATA GOOD
002280,000214:                                                                                          	#               BIT 6           LR POS1
002281,000215:                                                                                          	#               BIT 7           LR POS2
002283,000217:                                                                                          	#               BIT 8           LR VEL DATA GOOD
002284,000218:                                                                                          	#               BIT 9           LR RANGE LOW SCALE
002285,000219:                                                                                          	#               BIT 10          BLOCK UPLINK INPUT
002286,000220:                                                                                          	#               BIT 11          UPLINK TOO FAST

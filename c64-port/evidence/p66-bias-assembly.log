059115,000031:                                                                                          	# Page 1381
059116,000032:                                                                                          	# THE FOLLOWING SUBROUTINE MAY BE CALLED TO DISPLAY A NON-ABORTIVE ALARM CONDITION.  IT MAY BE CALLED
059117,000033:                                                                                          	# EITHER IN INTERRUPT OR UNDER EXECUTIVE CONTROL.
059118,000034: 

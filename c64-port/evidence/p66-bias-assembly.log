019383,002904: 
019385,002906: 
019386,002907:                                                                                          	# KEY RELEASE ROUTINE
019387,002908: 
019388,002909:                                                                                          	# THIS ROUTINE ALWAYS TURNS OFF THE UPACT LIGHT AND ALWAYS CLEARS DSPLOCK.
019389,002910: 
019390,002911:                                                                                          	# THE HIGHEST PRIORITY FUNCTION OF THE KEY RELEASE BUTTON IS THE
019391,002912:                                                                                          	# UNSUSPENDING OF A SUSPENDED MONITOR WHICH WAS EXTERNALLY INITIATED.
019392,002913:                                                                                          	# THIS FUNCTION IS ACCOMPLISHED BY CLEARING DSPLOCK AND TURNING OFF
019393,002914:                                                                                          	# THE KEY RELEASE LIGHT IF BOTH DSPLIST AND CADRSTOR ARE EMPTY.
019394,002915: 
019395,002916:                                                                                          	# IF NO SUCH MONITOR EXISTS, THEN RELDSP IS EXECUTED TO CLEAR DSPLOCK
019396,002917:                                                                                          	# AND THE EXTERNAL MONITOR BIT (FREEING THE DISPLAY SYSTEM FOR INTERNAL
019397,002918:                                                                                          	# USE), TURN OFF THE KEY RELEASE LIGHT, AND WAKE UP ANY JOB IN DSPLIST.
019398,002919: 
019399,002920:                                                                                          	# IN ADDITION IF THERE IS A JOB IN ENDIDLE, THEN CONTROL IS TRANSFERRED
019400,002921:                                                                                          	# TO PINBRNCH (IN DISPLAY INTERFACE ROUTINE) TO RE-EXECUTE THE SERIES OF
019401,002922:                                                                                          	# NVSUB CALLS ETC. THAT PRECEDED THE ENDIDLE CALL STILL AWAITING RESPONSE.
019402,002923:                                                                                          	# THIS FEATURE IS INTENDED FOR USE WHEN THE OPERATOR HAS BEEN REQUESTED TO
019403,002924:                                                                                          	# RESPOND TO SOME INTERNAL ACTION THAT USED ENDIDLE, BUT HE HAS WRITTEN
019404,002925:                                                                                          	# OVER THE INFORMATION ON THE DISPLAY PANEL BY SOME DISPLAYS OF HIS OWN
019405,002926:                                                                                          	# INITIATION WHICH DO NOT SERVE AS RESPONSES. HITTING KEYRLSE WILL
019406,002927:                                                                                          	# RE-ESTABLISH THE DISPLAYS TO THE STATE THEY WERE IN BEFORE HE OBSCURED
019407,002928:                                                                                          	# THEM, SO THAT HE CAN SEE THE WAITING REQUEST. THIS WORKS ONLY FOR
019408,002929:                                                                                          	# INTERNAL PROGRAMS THAT USED ENDIDLE THROUGH MARGARETS DISPLAY
019409,002930:                                                                                          	# SUBROUTINES.
019410,002931: 

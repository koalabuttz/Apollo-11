048535,000269:                                                                                          	# ..... SETRE SUBROUTINE .....
048536,000270:                                                                                          	# SUBROUTINE TO SET RE (EARTH OR MOON RADIUS)
048537,000271: 
048538,000272:                                                                                          	#       RE = RM FOR MOON
048539,000273:                                                                                          	#       RE = RREF FOR FIXED EARTH RADIUS OR COMPUTED RF FOR FISCHER ELLIPSOID
048540,000274: 
048541,000275:                                                                                          	# CALLING SEQUENCE
048542,000276:                                                                                          	#       L       CALL
048543,000277:                                                                                          	#       L+1             SETRE
048544,000278: 
048545,000279:                                                                                          	# SUBROUTINES USED
048546,000280:                                                                                          	#       GETERAD
048547,000281: 
048548,000282:                                                                                          	# INPUT
048549,000283:                                                                                          	#       ERADFLAG = 0 FOR FIXED RE, 1 FOR COMPUTED RE
048550,000284:                                                                                          	#       ALPHAV +4 = 1/2 SINL IF GETERAD IS CALLED
048551,000285:                                                                                          	#       LUNAFLAG = 0 FOR EARTH, =1 FOR MOON
048552,000286: 
048553,000287:                                                                                          	# OUTPUT
048554,000288:                                                                                          	#       ERADM = 504RM FOR MOON (METERS B-29)
048555,000289:                                                                                          	#       ERADM = ERAD OR COMPUTED RF FOR EARTH (METERS B-29)
048556,000290: 
048557,000291: 13,2560           71220        SETRE              STQ      DLOAD                         	#
048558,000292: 13,2561           00051                                    SETREX                        	#
048559,000293: 13,2562           10003                                    504RM                         	#
048560,000294: 13,2563           71214                           BON      DLOAD                         	# BRANCH FOR MOON
048561,000295: 13,2564           01703                                    LUNAFLAG                      	#
048562,000296: 13,2565           26575                                    TSTRLSRM                      	#
048563,000297: 13,2566           10001                                    ERAD                          	#

059374,000038:                                                                                          	##
059375,000039:                                                                                          	## Notations on the hardcopy document read, in part:
059376,000040:                                                                                          	##
059377,000041:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
059378,000042:                                                                                          	##      16:27 JULY 14, 1969 
059379,000043: 
059381,000045:                                                                                          	# PROGRAM NAME:     P27
059382,000046:                                                                                          	# WRITTEN BY:       KILROY/ DE WOLF
059383,000047: 
059384,000048:                                                                                          	# MOD NO:           6
059385,000049:                                                                                          	# MOD BY:           KILROY
059386,000050:                                                                                          	# DATE:             01DEC67
059387,000051: 
059388,000052:                                                                                          	# LOG SECTION:      UPDATE PROGRAM.
059389,000053: 
059390,000054:                                                                                          	# FUNCT. DESCR:     P27 (THE UPDATE PROGRAM) PROCESSES COMMANDS AND DATA
059391,000055:                                                                                          	#                       INSERTIONS REQUESTED BY THE GROUND VIA UPLINK.
059392,000056:                                                                                          	#                       THE P27 PROGRAM WILL ACCEPT UPDATES
059393,000057:                                                                                          	#                       ONLY DURING P00 FOR THE LM, AND ONLY DURING P00,
059394,000058:                                                                                          	#                   P02, AND FRESH START FOR THE CSM
059395,000059: 
059396,000060:                                                                                          	# CALLING SEQ:      PROGRAM IS INITIATED BY UPLINK ENTRY OF VERBS 70, 71, 72 AND 73.
059397,000061: 
059398,000062:                                                                                          	# SUBROUTINES:      TESTXACT, NEWMODEX, NEWMODEX +3, GOXDSPF, BANKCALL, FINDVAC, INTPRET, INTSTALL, TPAGREE,
059399,000063:                                                                                          	#                   INTWAKEU, ENDEXT, POSTJUMP, FALTON, NEWPHASE, PHASCHNG
059400,000064: 
059401,000065:                                                                                          	# NORMAL EXIT:      TC ENDEXT
059402,000066: 
059403,000067:                                                                                          	# ALARM/ABORT:      TC FALTON FOLLOWED BY TC ENDEXT
059404,000068: 
059405,000069:                                                                                          	# RESTARTS:         P27 IS RESTART PROTECTED IN TWO WAYS...
059406,000070:                                                                                          	#                   1. PRIOR TO VERIFLAG INVERSION(WHICH IS CAUSED BY THE GROUND/ASTRONAUT'S VERIFICATION OF UPDATE
059407,000071:                                                                                          	#                      DATA BY SENDING A V33E WHEN V21N02 IS FLASHING)---
059408,000072:                                                                                          	#                      NO PROTECTION EXCEPT PRE-P27 MODE IS RESTORED, COAST + ALIGN DOWNLIST IS SELECTED AND UPLINK
059409,000073:                                                                                          	#                      ACTIVITY LIGHT IS TURNED OFF.(JUST AS IF A V34E WAS SENT DURING P27 DATA LOADS).
059410,000074:                                                                                          	#                      V70,V71,V72 OR V73 WILL HAVE TO BE COMPLETELY RESENT BY USER.
059411,000075:                                                                                          	#                   2. AFTER VERIFLAG INVERSION(WHEN UPDATE OF THE SPECIFIED ERASABLES IS BEING PERFORMED)---
059412,000076:                                                                                          	#                      PROTECTED AGAINST RESTARTS.
059413,000077: 
059414,000078:                                                                                          	# DEBRIS:           UPBUFF   (20D)  TEMP STORAGE FOR ADDRESSES AND CONTENTS.
059415,000079:                                                                                          	#                   UPVERB   (1)    VERB NUMBER MINUS 70D (E.G., FOR V72, UPVERB = 72D - 70D = 2)
059416,000080:                                                                                          	#                   UPOLDMOD (1)    FOR MAJOR MODE INTERRUPTED BY P27.
059417,000081:                                                                                          	#                   COMPNUMB (1)    TOTAL NUMBER OF COMPONENTS TO BE TRANSMITTED.
059418,000082:                                                                                          	#                   UPCOUNT  (1)    ACTUAL NUMBER OF COMPONENTS RECEIVED.
059419,000083:                                                                                          	#                   UPTEMP   (1)    SCRATCH, BUT USUALLY CONTAINS COMPONENT NUMBER TO BE CHANGED DURING VERIFY CYCLE
059420,000084: 
059421,000085:                                                                                          	# INPUT:
059422,000086: 
059423,000087:                                                                                          	#  ENTRY:             DESCRIPTION
059424,000088: 
059425,000089:                                                                                          	#  V70EXXXXXEXXXXXE   (LIFTOFF TIME INCREMENT) DOUBLE PRECISION OCTAL TIME INCREMENT, XXXXX XXXXX,
059426,000090:                                                                                          	#                     IS ADDED TO TEPHEM, SUBTRACTED FROM AGC CLOCK(TIME2,TIME1), SUBTRACTED FROM CSM STATE
059427,000091:                                                                                          	#                     VECTOR TIME(TETCSM) AND SUBTRACTED FROM LEM STATE VECTOR TIME(TETLEM).
059428,000092:                                                                                          	#                     THE DP OCTAL TIME INCREMENT IS SCALED AT 2(28).
059430,000094:                                                                                          	#  V71EIIEAAAAE     (CONTIGUOUS BLOCK UPDATE) II-2 OCTAL COMPONENTS,XXXXX,
059431,000095:                                                                                          	#  XXXXXE           ARE LOADED INTO ERASABLE STARTING AT ECADR, AAAA.
059432,000096:                                                                                          	# XXXXXE            IT IS .GE. 3 .AND. .LE. 200.,
059433,000097:                                                                                          	#                   AND (AAAA + II - 3) DOES NOT PRODUCE AN ADDRESS IN THE
059434,000098:                                                                                          	# 9 NEXT BANK.
059435,000099:                                                                                          	#   .               SCALING IS SAME AS INTERNAL REGISTERS.
059436,000100: 
059437,000101:                                                                                          	#  V72EIIE          (SCATTER UPDATE) (II-1)/2 OCTAL COMPONENTS,XXXXX, ARE
059438,000102:                                                                                          	#  AAAAEXXXXXE      LOADED INTO ERASABLE LOCATIONS, AAAA.

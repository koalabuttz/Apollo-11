048714,000134: 24,3707           00001                                    0D                            	#
048715,000135: 24,3710           77650                           GOTO                                   	#
048716,000136: 24,3711           00050                                    RPREXIT                       	#
048717,000137: 24,3712           77624        RTORPA             CALL                                   	# EARTH COMPUTATIONS
048718,000138: 24,3713           55743                                    EARTHMX                       	#
048719,000139: 24,3714           77624                           CALL                                   	#

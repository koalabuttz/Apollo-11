043525,000011:                                                                                          	## Mod history: 2009-05-24 RSB  Adapted from the corresponding 
043526,000012:                                                                                          	##                              Luminary131 file, using page 
043527,000013:                                                                                          	##                              images from Luminary 1A.
043528,000014:                                                                                          	##              2011-05-08 JL   Removed workaround.
043529,000015:                                                                                          	##              2016-12-17 RSB  Proofed text comments with octopus/ProoferComments
043530,000016:                                                                                          	##                              and corrected the errors found.
043531,000017:                                                                                          	##              2017-03-13 RSB  Comment-text fixes noted in proofing Luminary 116.
043532,000018:                                                                                          	##              2017-03-17 RSB  Comment-text fixes identified in diff'ing
043533,000019:                                                                                          	##                              Luminary 99 vs Comanche 55.
043534,000020:                                                                                          	##              2021-05-30 ABS  ISWCALLL -> ISWCALL
043535,000021: 
043536,000022:                                                                                          	## This source code has been transcribed or otherwise adapted from
043537,000023:                                                                                          	## digitized images of a hardcopy from the MIT Museum.  The digitization
043538,000024:                                                                                          	## was performed by Paul Fjeld, and arranged for by Deborah Douglas of
043539,000025:                                                                                          	## the Museum.  Many thanks to both.  The images (with suitable reduction
043540,000026:                                                                                          	## in storage size and consequent reduction in image quality as well) are
043541,000027:                                                                                          	## available online at www.ibiblio.org/apollo.  If for some reason you
043542,000028:                                                                                          	## find that the images are illegible, contact me at info@sandroid.org
043543,000029:                                                                                          	## about getting access to the (much) higher-quality images which Paul
043544,000030:                                                                                          	## actually created.
043545,000031:                                                                                          	##
043546,000032:                                                                                          	## Notations on the hardcopy document read, in part:
043547,000033:                                                                                          	##
043548,000034:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
043549,000035:                                                                                          	##      16:27 JULY 14, 1969 
043550,000036: 
043552,000038:                                                                                          	# THE FOLLOWING ROUTINE CAN BE USED TO CALL A SUBROUTINE IN ANOTHER BANK. IN THE BANKCALL VERSION, THE
043553,000039:                                                                                          	# CADR OF THE SUBROUTINE IMMEDIATELY FOLLOWS THE TC BANKCALL INSTRUCTION, WITH C(A) AND C(L) PRESERVED.
043554,000040: 
043555,000041:    4616                                           BLOCK    02                            	#
043556,000042:    4616                                           COUNT*   $$/BANK                       	#
043557,000043:    4616           52134        BANKCALL           DXCH     BUF2                          	# SAVE INCOMING A,L.
043558,000044:    4617           50002                           INDEX    Q                             	# PICK UP CADR.
043559,000045:    4620           30000                           CA       0                             	#
043560,000046:    4621           24002                           INCR     Q                             	# SO WE RETURN TO THE LOC. AFTER THE CADR.
043561,000047: 
043562,000048:                                                                                          	# SWCALL IS  IDENTICAL TO BANKCALL, EXCEPT THAT THE CADR ARRIVES IN A.
043563,000049: 
043564,000050:    4622           54001        SWCALL             TS       L                             	#
043565,000051:    4623           22004                           LXCH     FBANK                         	# SWITCH BANKS, SAVING RETURN.
043566,000052:    4624           75012                           MASK     LOW10                         	# GET SUB-ADDRESS OF CADR.
043567,000053:    4625           56002                           XCH      Q                             	# A,L NOW CONTAINS DP RETURN.
043568,000054:    4626           52134                           DXCH     BUF2                          	# RESTORING INPUTS IF THIS IS A BANKCALL.
043569,000055:    4627           50002                           INDEX    Q                             	#
043570,000056:    4630           02000                           TC       10000                         	# SETTING Q TO SWRETURN.
043571,000057: 
043572,000058:    4631           56134        SWRETURN           XCH      BUF2       +1                 	# COMES HERE TO RETURN TO CALLER. C(A,L)
043573,000059:    4632           56004                           XCH      FBANK                         	# ARE PRESERVED FOR RETURN.
043574,000060:    4633           56134                           XCH      BUF2       +1                 	#
043575,000061:    4634           00133                           TC       BUF2                          	#
043576,000062: 
043577,000063:                                                                                          	# THE FOLLOWING ROUTINE CAN BE USED AS A UNILATERAL JUMP WITH C(A,L) PRESERVED AND THE CADR IMMEDIATELY
043578,000064:                                                                                          	# FOLLOWING THE TC POSTJUMP INSTRUCTION.
043579,000065: 
043580,000066:    4635           56002        POSTJUMP           XCH      Q                             	# SAVE INCOMING C(A).
043581,000067:    4636           50000                           INDEX    A                             	# GET CADR.
043582,000068:    4637           30000                           CA       0                             	#
043583,000069: 
043584,000070:                                                                                          	# BANKJUMP IS THE SAME AS POSTJUMP, EXCEPT THAT THE CADR ARRIVES IN A.
043585,000071: 
043586,000072:    4640           54004        BANKJUMP           TS       FBANK                         	#
043587,000073:    4641           75012                           MASK     LOW10                         	#
043588,000074:    4642           56002                           XCH      Q                             	# RESTORING INPUT C(A) IF THIS WAS A
043589,000075:    4643           50002        Q+10000            INDEX    Q                             	# POSTJUMP.
043590,000076:    4644           12000        PRIO12             TCF      10000                         	# PRIO12 = TCF  10000 = 12000
043591,000077: 
043593,000079:                                                                                          	# THE FOLLOWING ROUTINE GETS THE RETURN CADR SAVED BY SWCALL OR BANKCALL AND LEAVES IT IN A.
043594,000080: 
043595,000081:    4645           35012        MAKECADR           CAF      LOW10                         	#
043596,000082:    4646           70133                           MASK     BUF2                          	#
043597,000083:    4647           60134                           AD       BUF2       +1                 	#
043598,000084:    4650           00002                           TC       Q                             	#
043599,000085: 
043600,000086:    4651           54135        SUPDACAL           TS       MPTEMP                        	#
043601,000087:    4652           56004                           XCH      FBANK                         	# SET FBANK FOR DATA.
043602,000088:    4653           00006                           EXTEND                                 	#
043603,000089:    4654           04007                           ROR      SUPERBNK                      	# SAVE FBANK IN BITS 15-11, AND
043604,000090:    4655           56135                           XCH      MPTEMP                        	# SUPERBANK IN BITS 7-5.
043605,000091:    4656           75012                           MASK     LOW10                         	#
043606,000092:    4657           56001                           XCH      L                             	# SAVE REL. ADR. IN BANK, FETCH SUPERBITS.
043607,000093:    4660           00004                           INHINT                                 	# BECAUSE RUPT DOES NOT SAVE SUPERBANK.
043608,000094:    4661           00006                           EXTEND                                 	#
043609,000095:    4662           01007                           WRITE    SUPERBNK                      	# SET SUPERBANK FOR DATA.
043610,000096:    4663           50001                           INDEX    L                             	#
043611,000097:    4664           32000                           CA       10000                         	# PINBALL (FIX MEM DISP) PREVENTS DCA HERE
043612,000098:    4665           56135                           XCH      MPTEMP                        	# SAVE 1ST WD, FETCH OLD FBANK AND SBANK.
043613,000099:    4666           00006                           EXTEND                                 	#
043614,000100:    4667           01007                           WRITE    SUPERBNK                      	# RESTORE SUPERBANK.
043615,000101:    4670           00003                           RELINT                                 	#
043616,000102:    4671           54004                           TS       FBANK                         	# RESTORE FBANK.
043617,000103:    4672           30135                           CA       MPTEMP                        	# RECOVER FIRST WORD OF DATA.
043618,000104:    4673           00002                           RETURN                                 	# 24 WDS. DATACALL 516 MU, SUPDACAL 432 MU
043619,000105: 
043621,000107:                                                                                          	# THE FOLLOWING ROUTINES ARE IDENTICAL TO BANKCALL AND SWCALL EXCEPT THAT THEY ARE USED IN INTERRUPT.
043622,000108: 
043623,000109:    4674           52073        IBNKCALL           DXCH     RUPTREG3                      	# USES RUPTREG3,4 FOR DP RETURN ADDRESS.
043624,000110:    4675           50002                           INDEX    Q                             	#
043625,000111:    4676           30000                           CAF      0                             	#
043626,000112:    4677           24002                           INCR     Q                             	#
043627,000113: 
043628,000114:    4700           54001        ISWCALL            TS       L                             	#
043629,000115:    4701           22004                           LXCH     FBANK                         	#
043630,000116:    4702           75012                           MASK     LOW10                         	#
043631,000117:    4703           56002                           XCH      Q                             	#
043632,000118:    4704           52073                           DXCH     RUPTREG3                      	#
043633,000119:    4705           50002                           INDEX    Q                             	#
043634,000120:    4706           02000                           TC       10000                         	#
043635,000121: 
043636,000122:    4707           56073        ISWRETRN           XCH      RUPTREG4                      	#
043637,000123:    4710           56004                           XCH      FBANK                         	#
043638,000124:    4711           56073                           XCH      RUPTREG4                      	#
043639,000125:    4712           00072                           TC       RUPTREG3                      	#
043640,000126: 
043641,000127:                                                                                          	# 2. USPRCADR ACCESSES INTERPRETIVE CODING IN OTHER THAN THE USER'S FBANK.  THE CALLING SEQUENCE IS AS FOLLOWS:
043642,000128:                                                                                          	#       L       TC      USPRCADR
043643,000129:                                                                                          	#       L+1     CADR    INTPRETX        INTPRETX IS THE INTERPRETIVE CODING
043644,000130:                                                                                          	#                                       RETURN IS TO L+2
043645,000131: 
043646,000132:    4713           54164        USPRCADR           TS       LOC                           	# SAVE A
043647,000133:    4714           34744                           CA       BIT8                          	#
043648,000134:    4715           54023                           TS       EDOP                          	# EXIT INSTRUCTION TO EDOP
043649,000135:    4716           30006                           CA       BBANK                         	#
043650,000136:    4717           54165                           TS       BANKSET                       	# USER'S BBANK TO BANKSET
043651,000137:    4720           50002                           INDEX    Q                             	#
043652,000138:    4721           30000                           CA       0                             	#
043653,000139:    4722           54004                           TS       FBANK                         	# INTERPRETIVE BANK TO FBANK
043654,000140:    4723           75012                           MASK     LOW10                         	# YIELDS INTERPRETIVE RELATIVE ADDRESS
043655,000141:    4724           56002                           XCH      Q                             	# INTERPRETIVE ADDRESS TO Q, FETCHING L+1
043656,000142:    4725           56164                           XCH      LOC                           	# L+1 TO LOC, RETRIEVING ORIGINAL A
043657,000143:    4726           14643                           TCF      Q+10000                       	#
043658,000144: 
043660,000146:                                                                                          	# THERE ARE FOUR POSSIBLE SETTINGS FOR CHANNEL 07.  (CHANNEL 07 CONTAINS THE SUPERBANK SETTING.)
043661,000147: 
043662,000148:                                                                                          	#                                       PSEUDO-FIXED      OCTAL PSEUDO
043663,000149:                                                                                          	# SUPERBANK     SETTING S-REG. VALUE    BANK NUMBERS      ADDRESSES
043664,000150:                                                                                          	# ----------    ------- ------------     ------------      ------------
043665,000151:                                                                                          	# SUPERBANK 3     0XX    2000 - 3777       30 - 37       70000 - 107777         (WHERE XX CAN BE ANYTHING AND
043666,000152:                                                                                          	#                                                                               WILL USUALLY BE SEEN AS 11)
043667,000153:                                                                                          	# SUPERBANK 4     100    2000 - 3777       40 - 47      110000 - 127777         (AS FAR AS IT CAN BE SEEN,
043668,000154:                                                                                          	#                                                                               ONLY BANKS 40-43 WILL EVER BE
043669,000155:                                                                                          	#                                                                               AND ARE PRESENTLY AVAILABLE)
043670,000156:                                                                                          	# SUPERBANK 5     101    2000 - 3777       50 - 57      130000 - 147777         (PRESENTLY NOT AVAILABLE TO
043671,000157:                                                                                          	#                                                                               THE USER)
043672,000158:                                                                                          	# SUPERBANK 6     110    2000 - 3777       60 - 67      150000 - 167777         (PRESENTLY NOT AVAILABLE TO
043673,000159:                                                                                          	#                                                                               THE USER)
043674,000160:                                                                                          	# *** THIS ROUTINE MAY BE CALLED BY ANY PROGRAM LOCATED IN BANKS 00 - 27.  I.E., NO PROGRAM LIVING IN ANY
043675,000161:                                                                                          	# SUPERBANK SHOULD USE SUPERSW. ***
043676,000162: 
043677,000163:                                                                                          	# SUPERSW MAY BE CALLED IN THIS FASHION:
043678,000164:                                                                                          	#       CAF     ABBCON          WHERE  --  ABBCON   BBCON  SOMETHIN -- 
043679,000165:                                                                                          	#       TCR     SUPERSW         (THE SUPERBNK BITS ARE IN THE BBCON)
043680,000166:                                                                                          	#       ...       ...
043681,000167:                                                                                          	#        .         .
043682,000168:                                                                                          	#        .         .
043683,000169:                                                                                          	# OR IN THIS FASHION:
043684,000170:                                                                                          	#       CAF     SUPERSET        WHERE SUPERSET IS ONE OF THE FOUR AVAILABLE
043685,000171:                                                                                          	#       TCR     SUPERSW         SUPERBANK BIT CONSTANTS:
043686,000172:                                                                                          	#       ...       ...                                   SUPER011 OCTAL  60
043687,000173:                                                                                          	#        .         .                                    SUPER100 OCTAL 100
043688,000174:                                                                                          	#        .         .                                    SUPER101 OCTAL 120
043689,000175:                                                                                          	#                                                       SUPER110 OCTAL 140
043690,000176: 
043691,000177:    4727           00006        SUPERSW            EXTEND                                 	#
043692,000178:    4730           01007                           WRITE    SUPERBNK                      	# WRITE BITS 7-6-5 OF THE ACCUMULATOR INTO
043693,000179:                                                                                          	# CHANNEL 07
043694,000180:    4731           00002                           TC       Q                             	# TC TO INSTRUCTION FOLLOWING
043695,000181:                                                                                          	#       TC SUPERSW
043696,000182: 
(End of include-file INTER-BANK_COMMUNICATION.agc, resuming MAIN.agc)
043696,000133: 
043697,000134: $INTERPRETER.agc				        # pp. 1002-1094

007297,000959:                                                                                          	# PROGRAM NAME:  SETISSW
007298,000960: 
007299,000961:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM TURNS THE ISS WARNING LAMP ON AND OFF (CHANNEL 11 BIT 1 = 1 FOR ON,
007300,000962:                                                                                          	# 0 FOR OFF) DEPENDING ON THE STATUS OF IMODES30 BITS 13 (IMU FAIL) AND 4 (INHIBIT IMU FAIL), 12 (ICDU FAIL) AND
007301,000963:                                                                                          	# 3 (INHIBIT ICDU FAIL), AND 10 (PIPA FAIL) AND 1 (INHIBIT PIPA FAIL).  THE LAMP IS LEFT ON IF A LAMP TEST IS IN
007302,000964:                                                                                          	# PROGRESS.
007303,000965: 
007304,000966:                                                                                          	# CALLING SEQUENCE:  CALLED BY IMUMON ON CHANGES TO IMU FAIL AND ICDU FAIL.  CALLED BY IFAILOK AND PFAILOK UPON
007305,000967:                                                                                          	# REMOVAL OF THE FAIL INHIBITS.  CALLED BY PIPFAIL WHEN THE PIPA FAIL DISCRETE CHANGES.  IT IS CALLED BY PIPUSE
007306,000968:                                                                                          	# SINCE THE PIPA FAIL PROGRAM ALARM MAY NECESSITATE AN ISS WARNING, AND LIKEWISE BY PIPFREE WHEN THE ALARM DEPARTS
007307,000969:                                                                                          	# AND IT IS CALLED BY IMUZERO3 AND ISSUP AFTER THE FAIL INHIBITS HAVE BEEN REMOVED.
007308,000970: 
007309,000971:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
007310,000972: 
007311,000973:                                                                                          	# SUBROUTINES CALLED:  NONE.

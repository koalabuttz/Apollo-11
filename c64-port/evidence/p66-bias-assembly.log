014491,000285:                                                                                          	#     4
014492,000286: 
014493,000287:                                                                                          	# THIS ROUTINE DOES NOT SET THE PUSH DOWN POINTER, BUT USES THE NEXT 8 LOCATIONS OF THE PUSH DOWN LIST AND
014494,000288:                                                                                          	# RETURNS THE POINTER TO ITS ORIGINAL SETTING.  THIS PROCEDURE ALLOWS THE CALLER TO STORE THE MATRIX AT THE TOP OF
014495,000289:                                                                                          	# THE PUSH DOWN LIST.
014496,000290: 
014497,000291:                                                                                          	# DELCOMP
014498,000292:                                                                                          	# -------
014499,000293:                                                                                          	#                                                     *
014500,000294:                                                                                          	# THIS ROUTINE COMPUTES THE DIRECTION COSINE MATRIX (DEL) RELATING ON
014501,000295:                                                                                          	#                                                                           -
014502,000296:                                                                                          	# IS ROTATED WITH RESPECT TO THE FIRST BY AN ANGLE, A, ABOUT A UNIT VECTOR, U.  THE FORMULA FOR THIS MATRIX IS
014503,000297: 
014504,000298:                                                                                          	#        *              *        - -T              *
014505,000299:                                                                                          	#       DEL     =       I COSA + U U  (1 - COSA) + V  SINA
014506,000300:                                                                                          	#                                                   X
014507,000301: 
014508,000302:                                                                                          	# WHERE         *               ( 1    0    0 )
014509,000303:                                                                                          	#               I       =       ( 0    1    0 )
014510,000304:                                                                                          	#                               ( 0    0    1 )
014511,000305: 
014512,000306:                                                                                          	#                                    2                             
014513,000307:                                                                                          	#                               (  U           U  U          U  U  )
014514,000308:                                                                                          	#                               (   X           X  Y          X  Z )
014515,000309:                                                                                          	#                               (                                  )
014516,000310:                                                                                          	#               - -T            (                 2                )
014517,000311:                                                                                          	#               U U     =       ( U  U          U            U  U  )
014518,000312:                                                                                          	#                               (  Y  X          Y            Y  Z )
014519,000313:                                                                                          	#                               (                                  )
014520,000314:                                                                                          	#                               (                               2  )
014521,000315:                                                                                          	#                               ( U  U         U  U           U    )
014522,000316:                                                                                          	#                               (  Z  X         Z  Y           Z   )
014523,000317: 
014524,000318: 
014525,000319:                                                                                          	#                               (   0           -U               U  )
014526,000320:                                                                                          	#                               (                 Z               Y )
014527,000321:                                                                                          	#               *               (                                   )
014528,000322:                                                                                          	#               V       =       (  U             0              -U  )
014529,000323:                                                                                          	#                X              (   Z                             X )
014530,000324:                                                                                          	#                               (                                   )
014531,000325:                                                                                          	#                               ( -U             U               0  )
014532,000326:                                                                                          	#                               (   Y             X                 )
014533,000327: 
014535,000329:                                                                                          	#       -
014536,000330:                                                                                          	#       U       =       UNIT ROTATION VECTOR RESOLVED INTO S/C AXES
014537,000331:                                                                                          	#       A       =       ROTATION ANGLE
014538,000332: 
014539,000333:                                                                                          	#                        *
014540,000334:                                                                                          	# THE INTERPRETATION OF DEL IS AS FOLLOWS
014541,000335: 
014542,000336:                                                                                          	# IF A , A , A  REPRESENT THE COMPONENT OF A VECTOR IN THE ROTATED FRAME, THEN THE COMPONENTS OF THE SAME
014543,000337:                                                                                          	#     X   Y   Z
014544,000338:                                                                                          	# VECTOR IN THE ORIGINAL S/C AXES (B , B , B ) ARE
014545,000339:                                                                                          	#                                   X   Y   Z
014546,000340: 
014547,000341:                                                                                          	#       ( B  )                  ( A  )
014548,000342:                                                                                          	#       (  X )                  (  X )
014549,000343:                                                                                          	#       (    )            *     (    )
014550,000344:                                                                                          	#       ( B  )     =     DEL    ( A  )
014551,000345:                                                                                          	#       (  Y )                  (  Y )
014552,000346:                                                                                          	#       (    )                  (    )
014553,000347:                                                                                          	#       ( B  )                  ( A  )
014554,000348:                                                                                          	#       (  Z )                  (  Z )
014555,000349: 
014556,000350:                                                                                          	# THE ROUTINE WILL STORE THIS MATRIX (SCALED UNITY) IN SEQUENTIAL LOCATIONS OF ERASABLE MEMORY BEGINNING WITH
014557,000351:                                                                                          	#                                                                                             -
014558,000352:                                                                                          	# THE LOCATION CALLED DEL.  IN ORDER TO USE THE ROUTINE, THE CALLING PROGRAM MUST FIRST STORE U (A HALF UNIT
014559,000353:                                                                                          	# DOUBLE PRECISION VECTOR) IN THE SET OF ERASABLE LOCATIONS BEGINNING WITH THE ADDRESS CALLED COF.  THE ANGLE, A,
014560,000354:                                                                                          	# MUST THEN BE LOADED INTO D(MPAC).
014561,000355:                                                                                          	# 
014562,000356:                                                                                          	# INTERNALLY, THE PROGRAM ALSO USES THE FIRST 10 LOCATIONS OF THE PUSH DOWN LIST.
014563,000357: 

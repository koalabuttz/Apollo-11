012527,000038:                                                                                          	##      16:27 JULY 14, 1969 
012528,000039: 
012530,000041:                                                                                          	# THE FOLLOWING REFERS TO THE NOUN TABLES
012531,000042: 
012532,000043:                                                                                          	# COMPONENT CODE NUMBER         INTERPRETATION
012533,000044: 
012534,000045:                                                                                          	#       00000                   1 COMPONENT
012535,000046:                                                                                          	#       00001                   2 COMPONENT
012536,000047:                                                                                          	#       00010                   3 COMPONENT
012537,000048:                                                                                          	#       X1XXX                   BIT 4 = 1.  DECIMAL ONLY
012538,000049:                                                                                          	#       1XXXX                   BIT 5 = 1.  NO LOAD
012539,000050:                                                                                          	# END OF COMPONENT CODE NUMBERS 
012540,000051: 
012541,000052:                                                                                          	# SF ROUTINE CODE NUMBER        INTERPRETATION
012542,000053: 
012543,000054:                                                                                          	#       00000                   OCTAL ONLY
012544,000055:                                                                                          	#       00001                   STRAIGHT FRACTIONAL
012545,000056:                                                                                          	#       00010                   CDU DEGREES (XXX.XX)
012546,000057:                                                                                          	#       00011                   ARITHMETIC SF
012547,000058:                                                                                          	#       00100                   ARITH DP1       OUT (MULT BY 2EXP14 AT END)     IN (STRAIGHT)
012548,000059:                                                                                          	#       00101                   ARITH DP2       OUT (STRAIGHT)                  IN (SL 7 AT END)
012549,000060:                                                                                          	#       00110                   LANDING RADAR POSITION (+0000X)
012550,000061:                                                                                          	#       00111                   ARITH DP3       OUT (SL 7 AT END)               IN (STRAIGHT)
012551,000062:                                                                                          	#       01000                   WHOLE HOURS IN R1, WHOLE MINUTES (MOD 60) IN R2,
012552,000063:                                                                                          	#                                       SECONDS (MOD 60) 0XX.XX IN R3.  *** ALARMS IF USED WITH OCTAL
012553,000064:                                                                                          	#       01001                   MINUTES (MOD 60) IN D1D2, D3 BLANK, SECONDS (MOD 60) IN D4D5
012554,000065:                                                                                          	#                                       LIMITS TO 59B59 IF MAG EXCEEDS THIS VALUE.
012555,000066:                                                                                          	#                                       ALARMS IF USED WITH OCTAL ******** IN (ALARM)
012556,000067:                                                                                          	#       01010                   ARITH DP4       OUT (STRAIGHT)                  IN (SL 3 AT END)
012557,000068:                                                                                          	#       01011                   ARITH1 SF       OUT (MULT BY 2EXP14 AT END)     IN (STRAIGHT)
012558,000069:                                                                                          	#       01100                   2 INTEGERS IN D1D2, D4D5, D3 BLANK.
012559,000070:                                                                                          	#                                       ALARMS IF USED WITH OCTAL ******** IN (ALARM)
012560,000071:                                                                                          	#       01101                   360-CDU DEGREES (XXX.XX)
012561,000072: 
012562,000073:                                                                                          	# END OF SF ROUTINE CODE NUMBERS
012563,000074: 
012564,000075:                                                                                          	# SF CONSTANT CODE NUMBER       INTERPRETATION
012565,000076: 
012566,000077:                                                                                          	#       00000                   WHOLE                           USE ARITH
012567,000078:                                                                                          	#       00000                   DP TIME SEC (XXX.XX SEC)        USE ARITHDP1
012568,000079:                                                                                          	#       00000                   LR POSITION (+0000X)            USE LR POSITION
012569,000080:                                                                                          	#       00001                   SPARE
012570,000081:                                                                                          	#       00010                   CDU DEGREES                     USE CDU DEGREES
012571,000082:                                                                                          	#       00010                   360-CDU DEGREES                 USE 360-CDU DEGREES
012572,000083:                                                                                          	#       00011                   DP DEGREES (90) XX.XXX DEG      USE ARITHDP3
012573,000084:                                                                                          	#       00100                   DP DEGREES (360) XXX.XX DEG     USE ARITHDP4
012574,000085:                                                                                          	#       00101                   DEGREES (180) XXX.XX DEG        USE ARITH
012575,000086:                                                                                          	#       00101                   OPTICAL TRACKER AZIMUTH ANGLE (XXX.XXDEG)
012576,000087:                                                                                          	#                                                               USE ARITHDP1
012577,000088:                                                                                          	#       00110                   WEIGHT2 (XXXXX. LBS)            USE ARITH1
012579,000090:                                                                                          	#       00111                   POSITION5 (XXX.XX NAUTICAL MILES)
012580,000091:                                                                                          	#                                                               USE ARITHDP3
012581,000092:                                                                                          	#       01000                   POSITION4 (XXXX.X NAUTICAL MILES)
012582,000093:                                                                                          	#                                                               USE ARITHDP3
012583,000094:                                                                                          	#       01001                   VELOCITY2 (XXXXX. FT/SEC)       USE ARITHDP4
012584,000095:                                                                                          	#       01010                   VELOCITY3 (XXXX.X FT/SEC)       USE ARITHDP3
012585,000096:                                                                                          	#       01011                   ELEVATION DEGREES (89.999 MAX)  USE ARITH
012586,000097:                                                                                          	#       01100                   RENDEZVOUS RADAR RANGE (XXX.XX NAUT MI)
012587,000098:                                                                                          	#                                                               USE ARITHDP1
012588,000099:                                                                                          	#       01101                   RENDEZVOUS RADAR RANGE RATE (XXXXX.FT/SEC
012589,000100:                                                                                          	#                                                               USE ARITHDP1
012590,000101:                                                                                          	#       01110                   LANDING RADAR ALTITUDE (XXXXX.FEET)
012591,000102:                                                                                          	#                                                               USE ARITHDP1
012592,000103:                                                                                          	#       01111                   INITIAL/FINAL ALTITUDE (XXXXX. FEET)
012593,000104:                                                                                          	#                                                               USE ARITHDP1
012594,000105:                                                                                          	#       10000                   ALTITUDE RATE (XXXXX.FT/SEC)    USE ARITH
012595,000106:                                                                                          	#       10001                   FORWARD/LATERAL VELOCITY (XXXXX.FEET/SEC)
012596,000107:                                                                                          	#                                                               USE ARITH
012597,000108:                                                                                          	#       10010                   ROTATIONAL HAND CONTROLLER ANGLE RATES
012598,000109:                                                                                          	#                                       XXXXX.DEG/SEC           USE ARITH
012599,000110:                                                                                          	#       10011                   LANDING RADAR VELX (XXXXX.FEET/SEC)
012600,000111:                                                                                          	#                                                               USE ARITHDP1
012601,000112:                                                                                          	#       10100                   LANDING RADAR VELY (XXXXX.FEET/SEC)
012602,000113:                                                                                          	#                                                               USE ARITHDP1
012603,000114:                                                                                          	#       10101                   LANDING RADAR VELZ (XXXXX.FEET/SEC)
012604,000115:                                                                                          	#                                                               USE ARITHDP1
012605,000116:                                                                                          	#       10110                   POSITION7 (XXXX.X NAUT MI)      USE ARITHDP4
012606,000117:                                                                                          	#       10111                   TRIM DEGREES2 (XXX.XX DEG)      USE ARITH
012607,000118:                                                                                          	#       11000                   COMPUTED ALTITUDE (XXXXX. FEET)
012608,000119:                                                                                          	#                                                               USE ARITHDP1
012609,000120:                                                                                          	#       11001                   DP DEGREES (XXXX.X DEG)         USE ARITHDP3
012610,000121:                                                                                          	#       11010                   POSITION9 (XXXXX. FT)           USE ARITHDP3
012611,000122:                                                                                          	#       11011                   VELOCITY4 (XXXX.X FT/SEC)       USE ARITHDP2
012612,000123:                                                                                          	#       11100                   RADIANS (XX.XXX RADIANS)        USE ARITHDP4
012613,000124: 
012614,000125:                                                                                          	# END OF SF CONSTANT CODE NUMBERS
012615,000126: 
012616,000127:                                                                                          	# FOR GREATER THAN SINGLE PRECISION SCALES, PUT ADDRESS OF MAJOR PART INTO
012617,000128:                                                                                          	# NOUN TABLES.
012618,000129: 
012619,000130:                                                                                          	# OCTAL LOADS PLACE +0 INTO MAJOR PART, DATA INTO MINOR PART.
012620,000131: 
012621,000132:                                                                                          	# OCTAL DISPLAYS SHOW MINOR PART ONLY.
012622,000133: 
012623,000134:                                                                                          	# TO GET AT BOTH MAJOR AND MINOR PARTS (IN OCTAL), USE NOUN 01.
012624,000135: 
012625,000136:                                                                                          	# A NOUN MAY BE DECLARED :DECIMAL ONLY: BY MAKING BIT4=1 OF ITS COMPONENT
012626,000137:                                                                                          	# CODE NUMBER.  IF THIS NOUN IS USED WITH ANY OCTAL DISPLAY VERB, OR IF
012627,000138:                                                                                          	# DATA IS LOADED IN OCTAL, IT ALARMS.
012628,000139: 
012629,000140: 
012630,000141:                                                                                          	# IN LOADING AN :HOURS, MINUTES, SECONDS: NOUN, ALL 3 WORDS MUST BE
012631,000142:                                                                                          	# LOADED, OR ALARM.
012632,000143: 
012634,000145: 
012635,000146:                                                                                          	# ALARM IF AN ATTEMPT IS MADE TO LOAD :SPLIT MINUTES/SECONDS: (MMBSS).
012636,000147:                                                                                          	# THIS IS USED FOR DISPLAY ONLY.
012637,000148: 
012639,000150:                                                                                          	# THE FOLLOWING ROUTINES ARE FOR READING THE NOUN TABLES AND THE SF TABLES
012640,000151:                                                                                          	# (WHICH ARE IN A SEPARATE BANK FROM THE REST OF PINBALL).  THESE READING
012641,000152:                                                                                          	# ROUTINES ARE IN THE SAME BANK AS THE TABLES.  THEY ARE CALLED BY DXCH Z.
012642,000153: 
012643,000154:                                                                                          	# LODNNTAB LOADS NNADTEM WITH THE NNADTAB ENTRY, NNTYPTEM WITH THE
012644,000155:                                                                                          	# NNTYPTAB ENTRY.  IF THE NOUN IS MIXED, IDAD1TEM IS LOADED WITH THE FIRST
012645,000156:                                                                                          	# IDADDTAB ENTRY, IDAD2TEM THE SECOND IDADDTAB ENTRY, IDAD3TEM THE THIRD
012646,000157:                                                                                          	# IDADDTAB ENTRY, RUTMXTEM WITH THE RUTMXTAB ENTRY.  MIXBR IS SET FOR
012647,000158:                                                                                          	# MIXED OR NORMAL NOUN.
012648,000159: 
012649,000160: 06,3263                                           BANK     6                             	#
012650,000161: 42,2000                                           SETLOC   PINBALL3                      	#
012651,000162: 42,2000                                           BANK                                   	#
012652,000163: 42,2103                                           COUNT*   $$/NOUNS                      	#
012653,000164: 42,2103           52152        LODNNTAB           DXCH     IDAD2TEM                      	# SAVE RETURN INFO IN IDAD2TEM, IDAD3TEM.
012654,000165: 42,2104           51002                           INDEX    NOUNREG                       	#
012655,000166: 42,2105           32154                           CAF      NNADTAB                       	#
012656,000167: 42,2106           54146                           TS       NNADTEM                       	#
012657,000168: 42,2107           51002                           INDEX    NOUNREG                       	#
012658,000169: 42,2110           32320                           CAF      NNTYPTAB                      	#
012659,000170: 42,2111           54147                           TS       NNTYPTEM                      	#
012660,000171: 42,2112           41002                           CS       NOUNREG                       	#
012661,000172: 42,2113           64771                           AD       MIXCON                        	#
012662,000173: 42,2114           00006                           EXTEND                                 	#
012663,000174: 42,2115           62121                           BZMF     LODMIXNN                      	# NOUN NUMBER G/E FIRST MIXED NOUN
012664,000175: 42,2116           34753                           CAF      ONE                           	# NOUN NUMBER L/ FIRST MIXED NOUN
012665,000176: 42,2117           54140                           TS       MIXBR                         	# NORMAL.  +1 INTO MIXBR.
012666,000177: 42,2120           02137                           TC       LODNLV                        	#
012667,000178: 42,2121           34752        LODMIXNN           CAF      TWO                           	# MIXED.  +2 INTO MIXBR.
012668,000179: 42,2122           54140                           TS       MIXBR                         	#
012669,000180: 42,2123           51002                           INDEX    NOUNREG                       	#
012670,000181: 42,2124           33064                           CAF      RUTMXTAB   -40D               	# FIRST MIXED NOUN = 40.
012671,000182: 42,2125           54153                           TS       RUTMXTEM                      	#
012672,000183: 42,2126           35012                           CAF      LOW10                         	#
012673,000184: 42,2127           70146                           MASK     NNADTEM                       	#
012674,000185: 42,2130           54002                           TS       Q                             	# TEMP

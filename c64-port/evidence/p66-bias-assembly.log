009802,000092: $RESTART_TABLES.agc				        # pp. 238-243
009803,000001:                                                                                          	# Copyright:    Public domain.
009804,000002:                                                                                          	# Filename:     RESTART_TABLES.agc
009805,000003:                                                                                          	# Purpose:      Part of the source code for Luminary 1A build 099.
009806,000004:                                                                                          	#               It is part of the source code for the Lunar Module's (LM)
009807,000005:                                                                                          	#               Apollo Guidance Computer (AGC), for Apollo 11.
009808,000006:                                                                                          	# Assembler:    yaYUL
009809,000007:                                                                                          	# Contact:      Ron Burkey <info@sandroid.org>.
009810,000008:                                                                                          	# Website:      www.ibiblio.org/apollo.
009811,000009:                                                                                          	# Pages:        238-243
009812,000010:                                                                                          	# Mod history:  2009-05-10 SN   (Sergio Navarro).  Started adapting
009813,000011:                                                                                          	#                               from the Luminary131/ file of the same
009814,000012:                                                                                          	#                               name, using Luminary099 page images.
009815,000013: 
009816,000014:                                                                                          	# This source code has been transcribed or otherwise adapted from
009817,000015:                                                                                          	# digitized images of a hardcopy from the MIT Museum.  The digitization
009818,000016:                                                                                          	# was performed by Paul Fjeld, and arranged for by Deborah Douglas of
009819,000017:                                                                                          	# the Museum.  Many thanks to both.  The images (with suitable reduction
009820,000018:                                                                                          	# in storage size and consequent reduction in image quality as well) are
009821,000019:                                                                                          	# available online at www.ibiblio.org/apollo.  If for some reason you
009822,000020:                                                                                          	# find that the images are illegible, contact me at info@sandroid.org
009823,000021:                                                                                          	# about getting access to the (much) higher-quality images which Paul
009824,000022:                                                                                          	# actually created.
009825,000023: 
009826,000024:                                                                                          	# Notations on the hardcopy document read, in part:
009827,000025: 
009828,000026:                                                                                          	#       Assemble revision 001 of AGC program LMY99 by NASA 2021112-061
009829,000027:                                                                                          	#       16:27 JULY 14, 1969
009830,000028: 
009831,000029:                                                                                          	# Page 238
009832,000030:                                                                                          	# RESTART TABLES
009833,000031:                                                                                          	# ------------------
009834,000032: 
009835,000033:                                                                                          	# THERE ARE TWO FORMS OF RESTART TABLES FOR EACH GROUP.  THEY ARE KNOWN AS THE EVEN RESTART TABLES AND THE ODD
009836,000034:                                                                                          	# RESTART TABLES.  THE ODD TABLES HAVE ONLY ONE ENTRY OF THREE LOCATIONS WHILE THE EVEN TABLES HAVE TWO ENTRIES
009837,000035:                                                                                          	# EACH USING THREE LOCATIONS. THE INFORMATION AS TO WHETHER IT IS A JOB, WAITLIST, OR A LONGCALL IS GIVEN BY THE
009838,000036:                                                                                          	# WAY THINGS ARE PUT INTO THE TABLES.
009839,000037:                                                                                          	#      A JOB HAS ITS PRIORITY STORED IN PRDTTAB OF THE CORRECT PHASE SPOT - A POSITIVE PRIORITY INDICATES A
009840,000038:                                                                                          	# FINDVAC JOB, A NEGATIVE PRIORITY A NOVAC.  THE 2CADR OF THE JOB IS STORED IN THE CADRTAB.
009841,000039:                                                                                          	# FOR EXAMPLE,
009842,000040: 
009843,000041:                                                                                          	# 5.7SPOT       OCT     23000
009844,000042:                                                                                          	#               2CADR   SOMEJOB
009845,000043: 
009846,000044:                                                                                          	# A RESTART OF GROUP 5 WITH PHASE SEVEN WOULD THEN CAUSE SOMEJOB TO BE RESTARTED AS A FINDVAC WITH PRIORITY 23.
009847,000045: 
009848,000046:                                                                                          	# 5.5SPOT       OCT     -23000
009849,000047:                                                                                          	#               2CADR   ANYJOB
009850,000048: 
009851,000049:                                                                                          	# HERE A RESTART OF GROUP 5 WITH PHASE 7 WOULD CAUSE ANYJOB TO BE RESTARTED AS A NOVAC WITH PRIORITY 23.
009852,000050:                                                                                          	# A LONGCALL HAS ITS GENADR OF ITS 2CADR STORED NEGATIVELY AND ITS BBCON STORED POSITIVELY.  IN ITS PRDTTAB IS
009853,000051:                                                                                          	# PLACED THE LOCATION OF A DP REGISTER THAT CONTAINS THE DELTA TIME THAT LONGCALL HAD BEEN ORIGINALLY STARTED
009854,000052:                                                                                          	# WITH.  EXAMPLE,
009855,000053: 
009856,000054:                                                                                          	# 3.6SPOT       GENADR  DELTAT
009857,000055:                                                                                          	#              -GENADR  LONGTASK
009858,000056:                                                                                          	#               BBCON   LONGTASK
009859,000057: 
009860,000058:                                                                                          	#               OCT     31000
009861,000059:                                                                                          	#               2CADR   JOBAGAIN
009862,000060: 
009863,000061:                                                                                          	# THIS WOULD START UP LONGTASK AT THE APPROPRIATE TIME, OR IMMEDIATELY IF THE TIME HAD ALREADY PASSED. IT SHOULD
009864,000062:                                                                                          	# BE NOTED THAT IF DELTAT IS IN A SWITCHED E BANK, THIS INFORMATOIN SHOULD BE IN THE BBCON OFTHE 2CADR OF THE
009865,000063:                                                                                          	# TASK.  FROM ABOVE, WE SEE THAT THE SECOND PART OF THIS PHASE WOULD BE STARTED AS A JOB WITH A PRIORITY OF 31.
009866,000064: 
009867,000065:                                                                                          	# WAITLIST CALLS ARE IDENTIFIED BY THE FACT THAT THEIR 2CADR IS STORED NEGATIVELY. IF PRDTTAB OF THE PHASE SPOT
009868,000066:                                                                                          	# IS POSITIVE, THEN IT CONTAINS THE DELTA TIME, IF PRDTTAB IS NEGATIVE THEN IT IS THE -GENADR OF AN ERASABLE
009869,000067:                                                                                          	# LOCATION CONTAINING THE DELTA TIME, THAT IS, THE TIME IS STORED INDIRECTLY.  IT SHOULD BE NOTED AS ABOVE, THAT
009870,000068:                                                                                          	# IF THE TIME IS STORED INDIRECTLY, THE BBCON MUST CONTAIN THE NECESSARY E BANK INFORMATION IF APPLICABLE.  WITH
009871,000069:                                                                                          	# WAITLIST WE HAVE ONE FURTHER OPTION, IF -0 IS STORED IN PRDTTAB, IT WILL CAUSE AN IMMEDIATE RESTART OF THE
009872,000070:                                                                                          	# TASK.  EXAMPLES,
009873,000071: 
009874,000072:                                                                                          	#               OCT     77777           # THIS WILL CAUSE AN IMMEDIATE RESTART
009875,000073:                                                                                          	#              -2CADR   ATASK           # OF THE TASK :ATASK:
009876,000074: 
009877,000075:                                                                                          	#               DEC     200             # IF THE TIME OF THE 2 SECONDS SINCE DUMMY
009878,000076:                                                                                          	#              -2CADR   DUMMY           # WAS PUT ON THE WAITLIST IS UP, IT WILL BEGIN
009879,000077:                                                                                          	#                                       # IN 10 MS, OTHERWISE IT WILL BEGIN WHEN
009880,000078:                                                                                          	#                                       # IT NORMALLY WOULD HAVE BEGUN.
009881,000079:                                                                                          	# Page 239
009882,000080:                                                                                          	#              -GENADR  DTIME           # WHERE DTIME CONTAINS THE DELTA TIME
009883,000081:                                                                                          	#              -2CADR   TASKTASK        # OTHERWISE THIS IS AS ABOVE
009884,000082: 
009885,000083:                                                                                          	# ***** NOW THE TABLES THEMSELVES *****
009886,000084: 

054834,000619:                                                                                          	# PROGRAM NAME:      T(X)                                                 DATE:    01.17.67
054835,000620:                                                                                          	# MOD NO:  0                                                              LOG SECTION:    TIME OF FREE FALL
054836,000621:                                                                                          	# MOD BY:  RR BAIRNSFATHER
054837,000622:                                                                                          	# FUNCTIONAL DESCRIPTION:      THE POLYNOMIAL T(X) IS USED BY TIME OF FLIGHT SUBROUTINES  CALCTFF AND
054838,000623:                                                                                          	#          CALCTPER TO APPROXIMATE THE SERIES
054839,000624:                                                                                          	#                            2     3
054840,000625:                                                                                          	#                 1/3 -X/5 +X /7 -X /9 ...
054841,000626: 
054842,000627:                                                                                          	#          WHERE  X = ALFA Z Z       IF ALFA Z Z LEQ 1
054843,000628:                                                                                          	#                 X = 1/(ALFA Z Z)   IF ALFA Z Z  G  1
054844,000629: 
054845,000630:                                                                                          	#          ALSO   X IS NEG FOR HYPERBOLIC ORBITS
054846,000631:                                                                                          	#                 X = 0 FOR PARABOLIC ORBITS
054847,000632:                                                                                          	#                 X IS POSITIVE FOR ELLIPTIC ORBITS
054848,000633:                                                                                          	#          FOR FLIGHT 278, THE POLYNOMIAL  T(X) IS FITTED OVER THE RANGE  (0,+1)  AND HAS A MAXIMUM
054849,000634:                                                                                          	#          DEVIATION FROM THE SERIES OF  2 E-5       (T(X) IS A CHEBYCHEV  TYPE FIT AND WAS OBTAINED USING
054850,000635:                                                                                          	#          MAX PROGRAM AUTCURFIT294RRB  AND IS VALID TO THE SAME TOLERANCE OVER THE RANGE  (-.08,+1). )

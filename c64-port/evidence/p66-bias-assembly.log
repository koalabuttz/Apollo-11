045820,002123: 00,2737           52160                           DXCH     MPAC       +3                 	# SUPPLY ARGUMENTS IN USUAL SEQUENCE.
045821,002124: 00,2740           52155                           DXCH     MPAC                          	#
045822,002125: 00,2741           52160                           DXCH     MPAC       +3                 	#
045823,002126: 
045824,002127: 00,2742           02750                           TC       V/SCDV                        	# Y COMPONENT.
045825,002128: 00,2743           52162                           DXCH     MPAC       +5                 	#
045826,002129: 00,2744           52155                           DXCH     MPAC                          	#
045827,002130: 00,2745           52162                           DXCH     MPAC       +5                 	#
045828,002131: 
045829,002132: 00,2746           02750                           TC       V/SCDV                        	# Z COMPONENT.
045830,002133: 00,2747           17420                           TCF      VROTATEX                      	# GO RE-ARRANGE COMPONENTS BEFORE EXIT.
045831,002134: 
045832,002135:                                                                                          	# Page 1068

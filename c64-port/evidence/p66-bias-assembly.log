034439,000016:                                                                                          	##                              side-by-side diff of Luminary 69/99/116/131/210.
034440,000017: 
034441,000018:                                                                                          	## This source code has been transcribed or otherwise adapted from
034442,000019:                                                                                          	## digitized images of a hardcopy from the MIT Museum.  The digitization
034443,000020:                                                                                          	## was performed by Paul Fjeld, and arranged for by Deborah Douglas of
034444,000021:                                                                                          	## the Museum.  Many thanks to both.  The images (with suitable reduction
034445,000022:                                                                                          	## in storage size and consequent reduction in image quality as well) are
034446,000023:                                                                                          	## available online at www.ibiblio.org/apollo.  If for some reason you
034447,000024:                                                                                          	## find that the images are illegible, contact me at info@sandroid.org
034448,000025:                                                                                          	## about getting access to the (much) higher-quality images which Paul
034449,000026:                                                                                          	## actually created.
034450,000027:                                                                                          	##
034451,000028:                                                                                          	## Notations on the hardcopy document read, in part:
034452,000029:                                                                                          	##
034453,000030:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
034454,000031:                                                                                          	##      16:27 JULY 14, 1969 
034455,000032: 
034457,000034: 31,2216                                           BANK     31                            	#
034458,000035: 31,2000                                           SETLOC   FTHROT                        	#
034459,000036: 31,2000                                           BANK                                   	#
034460,000037: 31,2216  E7,1612                                  EBANK=   PIF                           	#
034461,000038: 31,2216                                           COUNT*   $$/THROT                      	#
034462,000039: 
034463,000040:                                                                                          	# * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
034464,000041:                                                                                          	# HERE FC, DESIRED THRUST, AND FP, PRESENT THRUST, UNWEIGHTED, ARE COMPUTED.
034465,000042: 
034466,000043: 31,2216           31246        THROTTLE           CA       ABDELV                        	# COMPUTE PRESENT ACCELERATION IN UNITS OF
034467,000044: 31,2217           00006                           EXTEND                                 	# 2(-4) M/CS/CS, SAVING SERVICER TROUBLE
034468,000045: 31,2220           72417                           MP       /AF/CNST                      	#
034469,000046: 31,2221           00006                 +3        EXTEND                                 	#
034470,000047: 31,2222           23607                           QXCH     RTNHOLD                       	#
034471,000048: 31,2223           02400        AFDUMP             TC       MASSMULT                      	#
034472,000049: 31,2224           53470                           DXCH     FP                            	# FP = PRESENT THRUST
034473,000050: 31,2225           00006                           EXTEND                                 	#
034474,000051: 31,2226           31464                           DCA      /AFC/                         	#
034475,000052: 31,2227           02400                           TC       MASSMULT                      	#
034476,000053: 31,2230           55615                           TS       FC                            	# FC = THRUST DESIRED BY GUIDANCE
034477,000054: 31,2231           53466                           DXCH     FCODD                         	# FCODD = WHAT IT IS GOING TO GET
034478,000055: 
034479,000056:                                                                                          	# IF IT HAS BEEN LESS THAN 3 SECONDS SINCE THE LAST THROTTLING, AUGMENT FP USING THE FWEIGHT CALCULATED THEN.
034480,000057: 
034481,000058: 31,2232           41617                           CS       TTHROT                        	# THIS CODING ASSUMES A FLATOUT WITHIN
034482,000059: 31,2233           60025                           AD       TIME1                         	#       80 SECONDS BEFORE FIRST THROTTLE CALL
034483,000060: 31,2234           74733                           MASK     POSMAX                        	#
034484,000061: 31,2235           40000                           COM                                    	#
034485,000062: 31,2236           65002                           AD       3SECS                         	#
034486,000063: 31,2237           00006                           EXTEND                                 	#
034487,000064: 31,2240           62244                           BZMF     WHERETO                       	# BRANCH IF (TIME1-TTHROT +1) > 3 SECONDS
034488,000065: 31,2241           00006                           EXTEND                                 	#
034489,000066: 31,2242           31611                           DCA      FWEIGHT                       	#
034490,000067: 31,2243           21470                           DAS      FP                            	#
034491,000068: 
034492,000069:                                                                                          	#     THIS LOGIC DETERMINES THE THROTTLING IN THE REGION 10% - 94%.  THE MANUAL THROTTLE, NOMINALLY SET AT
034493,000070:                                                                                          	# MINIMUM BY ASTRONAUT OR MISSION CONTROL PROGRAMS, PROVIDES THE LOWER BOUND.  A STOP IN THE THROTTLE HARDWARE
034494,000071:                                                                                          	# PROVIDES THE UPPER.
034495,000072: 
034496,000073: 31,2244           35014        WHERETO            CA       EBANK5                        	# INITIALIZE L*WCR*T AND H*GHCR*T FROM
034497,000074: 31,2245           54003                           TS       EBANK                         	#       PAD LOADED ERASABLES IN W-MATRIX
034499,000076: 31,2246  E5,1506                                  EBANK=   LOWCRIT                       	#
034500,000077: 31,2246           00006                           EXTEND                                 	#
034501,000078: 31,2247           31507                           DCA      LOWCRIT                       	#
034502,000079: 31,2250           52131                           DXCH     L*WCR*T                       	#
034503,000080: 31,2251           35016                           CA       EBANK7                        	#
034504,000081: 31,2252           54003                           TS       EBANK                         	#
034505,000082: 31,2253  E7,1612                                  EBANK=   PIF                           	#
034506,000083: 31,2253           44755                           CS       ZERO                          	# INITIALIZE PIFPSET
034507,000084: 31,2254           55606                           TS       PIFPSET                       	#
034508,000085: 31,2255           40131                           CS       H*GHCR*T                      	#
034509,000086: 31,2256           61620                           AD       FCOLD                         	#
034510,000087: 31,2257           00006                           EXTEND                                 	#
034511,000088: 31,2260           62272                           BZMF     LOWFCOLD                      	# BRANCH IF FCOLD < OR = HIGHCRIT
034512,000089: 31,2261           40130                           CS       L*WCR*T                       	#
034513,000090: 31,2262           61465                           AD       FCODD                         	#
034514,000091: 31,2263           00006                           EXTEND                                 	#
034515,000092: 31,2264           62267                           BZMF     FCOMPSET                      	# BRANCH IF FC < OR = LOWCRIT
034516,000093: 31,2265           31467                           CA       FP                            	# SEE NOTE 1
034517,000094: 31,2266           12277                           TCF      FLATOUT1                      	#
034518,000095: 
034519,000096: 31,2267           42002        FCOMPSET           CS       FMAXODD                       	# SEE NOTE 2
034520,000097: 31,2270           61467                           AD       FP                            	#
034521,000098: 31,2271           12301                           TCF      FLATOUT2                      	#
034522,000099: 
034523,000100: 31,2272           40131        LOWFCOLD           CS       H*GHCR*T                      	#
034524,000101: 31,2273           61465                           AD       FCODD                         	#
034525,000102: 31,2274           00006                           EXTEND                                 	#
034526,000103: 31,2275           62302                           BZMF     DOPIF                         	# BRANCH IF FC < OR = HIGHCRIT
034527,000104: 
034528,000105: 31,2276           32003                           CA       FMAXPOS                       	# NO:  THROTTLE-UP
034529,000106: 31,2277           53466        FLATOUT1           DXCH     FCODD                         	#
034530,000107: 31,2300           34737                           CA       FEXTRA                        	#
034531,000108: 31,2301           55606        FLATOUT2           TS       PIFPSET                       	#
034532,000109: 
034533,000110:                                                                                          	# NOTE 1        FC IS SET EQUAL TO FP SO PIF WILL BE ZERO.  THIS IS DESIRABLE
034534,000111:                                                                                          	#               AS THERE IS ACTUALLY NO THROTTLE CHANGE.
034535,000112: 
034536,000113:                                                                                          	# NOTE2         HERE, SINCE WE ARE ABOUT TO RETURN TO THE THROTTLEABLE REGION
034537,000114:                                                                                          	#               (BELOW 55%) THE QUANTITY -(FMAXODD-FP) IS COMPUTED AND PUT
034538,000115:                                                                                          	#               INTO PIFPSET TO COMPENSATE FOR THE DIFFERENCE BETWEEN THE
034539,000116:                                                                                          	#               NUMBER OF BITS CORRESPONDING TO FULL THROTTLE (FMAXODD) AND THE
034540,000117:                                                                                          	#               NUMBER CORRESPONDING TO ACTUAL THRUST (FP).  THUS THE TOTAL
034541,000118:                                                                                          	#               THROTTLE COMMAND PIF = FC - FP - (FMAXODD - FP) = FC - FMAXODD.
034542,000119: 
034543,000120: 31,2302           03740        DOPIF              TC       FASTCHNG                      	#
034544,000121: 31,2303           00006                           EXTEND                                 	#
034545,000122: 31,2304           31466                           DCA      FCODD                         	#
034546,000123: 31,2305           55620                           TS       FCOLD                         	#
034547,000124: 31,2306           53613                           DXCH     PIF                           	#
034548,000125: 31,2307           00006                           EXTEND                                 	#
034550,000127: 31,2310           41470                           DCS      FP                            	#
034551,000128: 31,2311           21613                           DAS      PIF                           	# PIF = FC - FP, NEVER EQUALS +0
034552,000129: 
034553,000130: 31,2312           31612        DOIT               CA       PIF                           	#
034554,000131: 31,2313           61606                           AD       PIFPSET                       	# ADD IN PIFPSET, WITHOUT CHANGING PIF
034555,000132: 31,2314           55614                           TS       PSEUDO55                      	#
034556,000133: 31,2315           54055                           TS       THRUST                        	#
034557,000134: 31,2316           34750                           CAF      BIT4                          	#
034558,000135: 31,2317           00006                           EXTEND                                 	#
034559,000136: 31,2320           05014                           WOR      CHAN14                        	#
034560,000137: 31,2321           30025                           CA       TIME1                         	#
034561,000138: 31,2322           55617                           TS       TTHROT                        	#
034562,000139: 
034563,000140:                                                                                          	# SINCE /AF/ IS NOT AN INSTANTANEOUS ACCELERATION, BUT RATHER AN "AVERAGE" OF THE ACCELERATION LEVELS DURING
034564,000141:                                                                                          	# THE PRECEEDING PIPA INTERVAL, AND SINCE FP IS COMPUTED DIRECTLY FROM /AF/, FP IN ORDER TO CORRESPOND TO THE
034565,000142:                                                                                          	# ACTUAL THRUST LEVEL AT THE END OF THE INTERVAL MUST BE WEIGHTED BY
034566,000143: 
034567,000144:                                                                                          	#                 PIF(PPROCESS + TL)     PIF /PIF/
034568,000145:                                                                                          	#       FWEIGHT = ------------------ + -------------
034569,000146:                                                                                          	#                      PGUID           2 PGUID FRATE
034570,000147: 
034571,000148:                                                                                          	# WHERE PPROCESS IS THE TIME BETWEEN PIPA READING AND THE START OF THROTTLING, PGUID IS THE GUIDANCE PERIOD, AND
034572,000149:                                                                                          	# FRATE IS THE THROTTLING RATE (32 UNITS PER CENTISECOND).  PGUID IS EITHER 1 OR 2 SECONDS.  THE "TL" IN THE
034573,000150:                                                                                          	# FIRST TERM REPRESENTS THE ENGINE'S RESPONSE LAG.  HERE FWEIGHT IS COMPUTED FOR USE NEXT PASS.
034574,000151: 
034575,000152: 31,2323           31762                           CA       THISTPIP   +1                 	# INITIALIZE FWEIGHT COMP AS IF FOR P66
034576,000153: 31,2324           54130                           TS       BUF                           	#
034577,000154: 
034578,000155: 31,2325           41011                           CS       MODREG                        	# ARE WE IN FACT IN P66?
034579,000156: 31,2326           62501                           AD       DEC66                         	#
034580,000157: 31,2327           00006                           EXTEND                                 	#
034581,000158: 31,2330           12335                           BZF      FWCOMP                        	# YES
034582,000159: 
034583,000160: 31,2331           31235                           CA       PIPTIME    +1                 	# NO:  INITIALIZE FOR TWO SECOND PERIOD
034584,000161: 31,2332           54130                           TS       BUF                           	#
034585,000162: 31,2333           35003                           CAF      4SECS                         	#
034586,000163: 31,2334           12336                           TCF      FWCOMP     +1                 	#
034587,000164: 
034588,000165: 31,2335           35000        FWCOMP             CAF      2SECS                         	#
034589,000166: 31,2336           54002                 +1        TS       Q                             	#
034590,000167: 31,2337           00006                           EXTEND                                 	#
034591,000168: 31,2340           74746                           MP       BIT6                          	#
034592,000169: 31,2341           22131                           LXCH     BUF        +1                 	#
034593,000170: 31,2342           40130                           CS       BUF                           	# TIME OF LAST PIPA READING.
034594,000171: 31,2343           60025                           AD       TIME1                         	#
034595,000172: 31,2344           62004                           AD       THROTLAG                      	# COMPENSATE FOR ENGINE RESPONSE LAG
034596,000173: 31,2345           74357                           MASK     LOW8                          	# MAKE SURE SMALL AND POSITIVE
034597,000174: 31,2346           22007                           ZL                                     	#
034598,000175: 31,2347           00006                           EXTEND                                 	#
034600,000177: 31,2350           10002                           DV       Q                             	#
034601,000178: 31,2351           00006                           EXTEND                                 	#
034602,000179: 31,2352           71612                           MP       PIF                           	#
034603,000180: 31,2353           60000                           DOUBLE                                 	#
034604,000181: 31,2354           53611                           DXCH     FWEIGHT                       	#
034605,000182: 31,2355           11612                           CCS      PIF                           	#
034606,000183: 31,2356           64753                           AD       ONE                           	#
034607,000184: 31,2357           12361                           TCF      +2                            	#
034608,000185: 31,2360           64753                           AD       ONE                           	#
034609,000186: 31,2361           00006                           EXTEND                                 	#
034610,000187: 31,2362           71612                           MP       PIF                           	#
034611,000188: 31,2363           00006                           EXTEND                                 	#
034612,000189: 31,2364           10131                           DV       BUF        +1                 	#
034613,000190: 31,2365           22007                           ZL                                     	#
034614,000191: 31,2366           21611                           DAS      FWEIGHT                       	#
034615,000192: 
034616,000193: 31,2367           01607        THDUMP             TC       RTNHOLD                       	#
034617,000194: 
034618,000195:                                                                                          	# FLATOUT THROTTLES UP THE DESCENT ENGINE, AND IS CALLED AS A BASIC SUBROUTINE.
034619,000196: 
034620,000197: 31,2370           34737        FLATOUT            CAF      BIT13                         	# 4096 PULSES
034621,000198: 31,2371           55606        WHATOUT            TS       PIFPSET                       	# USE PIFPSET SO FWEIGHT WILL BE ZERO
034622,000199: 31,2372           44755                           CS       ZERO                          	#
034623,000200: 31,2373           55620                           TS       FCOLD                         	#
034624,000201: 31,2374           55612                           TS       PIF                           	#
034625,000202: 31,2375           00006                           EXTEND                                 	#
034626,000203: 31,2376           23607                           QXCH     RTNHOLD                       	#
034627,000204: 31,2377           12312                           TCF      DOIT                          	#
034628,000205: 
034629,000206:                                                                                          	# MASSMULT SCALES ACCELERATION, ARRIVING IN A AND L IN UNITS OF 2(-4) M/CS/CS, TO FORCE IN PULSE UNITS.
034630,000207: 
034631,000208: 31,2400           00006        MASSMULT           EXTEND                                 	#
034632,000209: 31,2401           22130                           QXCH     BUF                           	#
034633,000210: 31,2402           52155                           DXCH     MPAC                          	#
034634,000211: 31,2403           07103                           TC       DMP                           	#
034635,000212: 31,2404           01244                           ADRES    MASS                          	#
034636,000213: 31,2405           07103                           TC       DMP                           	# LEAVES PROPERLY SCALED FORCE IM MPAC
034637,000214: 31,2406           02005                           ADRES    SCALEFAC                      	#
034638,000215: 31,2407           07257                           TC       TPAGREE                       	#
034639,000216: 31,2410           30154                           CA       MPAC                          	#
034640,000217: 31,2411           00006                           EXTEND                                 	#
034641,000218: 31,2412           12415                           BZF      +3                            	#
034642,000219: 31,2413           34733                           CAF      POSMAX                        	#
034643,000220: 31,2414           00130                           TC       BUF                           	#
034644,000221: 31,2415           52156                           DXCH     MPAC       +1                 	#
034645,000222: 31,2416           00130                           TC       BUF                           	#
034647,000224:                                                                                          	# CONSTANTS:-
034648,000225: 
034649,000226: 31,2417     4737               FEXTRA             =        BIT13                         	# FEXT +5.13309020 E+4
034650,000227: 
034651,000228: 31,2417           04143        /AF/CNST           DEC      .13107                        	#
034652,000229: 
034653,000230:                                                                                          	# * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
(End of include-file THROTTLE_CONTROL_ROUTINES.agc, resuming MAIN.agc)

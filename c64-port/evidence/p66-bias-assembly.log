024370,003174: 
024371,003175:                                                                                          	# ALARMS_  NONE
024372,003176: 
024373,003177:                                                                                          	# OUTPUT_
024374,003178:                                                                                          	#       LOS VECTOR (HALF UNIT) IN SM COORDINATES STORED IN RRTARGET
024375,003179:                                                                                          	#       MAGNITUDE OF THE LOS VECTOR (METERS SCALED B-29) STORED IN MSLOV
024376,003180:                                                                                          	#       RRNBSW CLEARED

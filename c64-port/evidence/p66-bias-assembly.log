043701,000004:                                                                                          	#               It is part of the source code for the Lunar Module's (LM)
043702,000005:                                                                                          	#               Apollo Guidance Computer (AGC), for Apollo 11.
043703,000006:                                                                                          	# Assembler:    yaYUL
043704,000007:                                                                                          	# Contact:      Ron Burkey <info@sandroid.org>.
043705,000008:                                                                                          	# Website:      www.ibiblio.org/apollo.
043706,000009:                                                                                          	# Pages:        1002-1094
043707,000010:                                                                                          	# Mod history:  2009-05-25 RSB  Adapted from the corresponding
043708,000011:                                                                                          	#                               Luminary131 file, using page
043709,000012:                                                                                          	#                               images from Luminary 1A.
043710,000013:                                                                                          	#               2011-01-06 JL   Fixed pseudo-label indentation.
043711,000014:                                                                                          	#               2011-05-08 JL   Removed workarounds.
043712,000015: 
043713,000016:                                                                                          	# This source code has been transcribed or otherwise adapted from
043714,000017:                                                                                          	# digitized images of a hardcopy from the MIT Museum.  The digitization
043715,000018:                                                                                          	# was performed by Paul Fjeld, and arranged for by Deborah Douglas of
043716,000019:                                                                                          	# the Museum.  Many thanks to both.  The images (with suitable reduction
043717,000020:                                                                                          	# in storage size and consequent reduction in image quality as well) are
043718,000021:                                                                                          	# available online at www.ibiblio.org/apollo.  If for some reason you
043719,000022:                                                                                          	# find that the images are illegible, contact me at info@sandroid.org
043720,000023:                                                                                          	# about getting access to the (much) higher-quality images which Paul
043721,000024:                                                                                          	# actually created.
043722,000025: 
043723,000026:                                                                                          	# Notations on the hardcopy document read, in part:
043724,000027: 
043725,000028:                                                                                          	#       Assemble revision 001 of AGC program LMY99 by NASA 2021112-061
043726,000029:                                                                                          	#       16:27 JULY 14, 1969
043727,000030: 
043728,000031:                                                                                          	# Page 1002
043729,000032:                                                                                          	# SECTION 1:  DISPATCHER
043730,000033: 
043731,000034:                                                                                          	# ENTRY TO THE INTERPRETER.  INTPRET SETS LOC TO THE FIRST INSTRUCTION, BANKSET TO THE BBANK OF THE
043732,000035:                                                                                          	# OBJECT INTERPRETIVE PROGRAM, AND INTBIT15 TO THE BIT15 CONTENTS OF FBANK.  INTERPRETIVE PROGRAMS MAY BE IN
043733,000036:                                                                                          	# VIRTUALLY ALL BANKS PRESENT UNDER ANY SUPER-BANK SETTING, WITH THE RESTRICTION THAT PROGRAMS IN HIGH BANKS
043734,000037:                                                                                          	# (BIT15 OF FBANK = 1) DO NOT REFER TO LOWBANKS, AND VICE-VERSA.  THE INTERPRETER DOES NOT SWITCH SUPERBANKS.
043735,000038:                                                                                          	# E-BANK SWITCHING OCCURS WHENEVER GENERAL ERASABLE (100-3777) IS ADDRESSED.
043736,000039: 
043737,000040:    6037                                           BLOCK    03                            	#
043738,000041: 
043739,000042:    6037                                           COUNT*   $$/INTER                      	#
043740,000043:    6037           00003        INTPRET            RELINT                                 	#
043741,000044:    6040           00006                           EXTEND                                 	# SET LOC TO THE WORD FOLLOWING THE TC.
043742,000045:    6041           22164                           QXCH     LOC                           	#
043743,000046: 
043744,000047:    6042           30006                 +2        CA       BBANK                         	# INTERPRETIVE BRANCHES FINISH HERE.
043745,000048:    6043           54165                           TS       BANKSET                       	#
043746,000049:    6044           74735                           MASK     BIT15                         	# GET 15TH BIT FOR INDEXABLE ADDRESSES.
043747,000050:    6045           54115                           TS       INTBIT15                      	#
043748,000051: 
043749,000052:    6046           54023                           TS       EDOP                          	# MAKE SURE NO INSTRUCTIONS LEFT OVER
043750,000053: 
043751,000054:    6047           16070                           TCF      NEWOPS                        	# PICK UP OP CODE PAIR AND BEGIN.
043752,000055: 
043753,000056:    6050           22006        INTRSM             LXCH     BBANK                         	# RESUME SUSPENDED INTERPRETIVE JOB
043754,000057:    6051           16042                           TCF      INTPRET    +3                 	#
043755,000058: 
043756,000059:                                                                                          	# DLOAD LOADS MPAC, MPAC +1, LEAVING ZERO IN MPAC +2.
043757,000060: 
043758,000061:    6052           00006        DLOAD              EXTEND                                 	#
043759,000062:    6053           50116                           INDEX    ADDRWD                        	#
043760,000063:    6054           30001                           DCA      0                             	# LOAD DP C(C(ADDRWD)) INT MPAC,MPAC +1
043761,000064:    6055           52155        SLOAD2             DXCH     MPAC                          	#
043762,000065:    6056           34755                           CAF      ZERO                          	# ZERO MPAC +2
043763,000066: 
043764,000067:                                                                                          	# Page 1003
043765,000068:                                                                                          	# AT THE END OF MOST INSTRUCTIONS, CONTROL IS GIVEN TO DANZIG TO DISPATCH THE NEXT OPERATION.
043766,000069: 
043767,000070:    6057           54156                           TS       MPAC       +2                 	# AND DECLARE DP MODE
043768,000071: 
043769,000072:    6060           54163        NEWMODE            TS       MODE                          	# PROLOGUE FOR MODE-CHANGING INSTRUCTIONS.
043770,000073: 
043771,000074:    6061           30165        DANZIG             CA       BANKSET                       	# SET BBANK BEFORE TESTING NEWJOB SO THAT
043772,000075:    6062           54006                           TS       BBANK                         	# IT MAY BE SAVED DIRECTLY BY CHANJOB.
043773,000076: 
043774,000077:    6063           10023        NOIBNKSW           CCS      EDOP                          	# SEE IF AN ORDER CODE IS LEFT OVER FROM
043775,000078:    6064           16077                           TCF      OPJUMP                        	# THE LAST PAIR RETRIEVED.  IF SO, EXECUTE.
043776,000079:                                                                                          	# EDOP IS SET TO ZERO ON ITS RE-EDITIING.
043777,000080: 
043778,000081:    6065           10067                           CCS      NEWJOB                        	# SEE IF A JOB OF HIGHER PRIORITY IS
043779,000082:    6066           15126                           TCF      CHANG2                        	# PRESENT, AND IF SO, CHANGE JOBS.
043780,000083: 
043781,000084:    6067           24164                           INCR     LOC                           	# ADVANCE THE LOCATION COUNTER.
043782,000085: 
043783,000086:                                                                                          	# ITRACE (1) REFERS TO "NEWOPS"
043784,000087:    6070           50164        NEWOPS             INDEX    LOC                           	# ENTRY TO BEGIN BY PICKING OP CODE PAIR.
043785,000088:    6071           30000                           CA       0                             	# MAY BE AN OPCODE PAIR OR A STORE CODE.
043786,000089:    6072           10000                           CCS      A                             	# TEST SIGN AND GET DABS(A).
043787,000090:    6073           16362                           TCF      DOSTORE                       	# PROCESS STORE CODE.
043788,000091: 
043789,000092:    6074           00177        LOW7               OCT      177                           	#
043790,000093: 
043791,000094:    6075           54023                           TS       EDOP                          	# OP CODE PAIR.  LEAVE THE OTHER IN EDOP
043792,000095:    6076           76074                           MASK     LOW7                          	# WHERE CCS EDOP WILL HONOR IT NEXT.
043793,000096: 
043794,000097:    6077           54020        OPJUMP             TS       CYR                           	# LOWWD ENTERS HERE IF A RIGHT-HAND OP
043795,000098:    6100           10020                           CCS      CYR                           	# CODE IS TO BE PROCESSED.  TEST PREFICES.
043796,000099:    6101           16247                           TCF      OPJUMP2                       	# TEST SECOND PREFIX BIT.
043797,000100: 
043798,000101:    6102           16743                           TCF      EXIT                          	# +0 OP CODE IS EXIT
043799,000102: 
043800,000103:                                                                                          	# Page 1004
043801,000104:                                                                                          	# PROCESS ADDRESSES WHICH MAY BE DIRECT, INDEXED, OR REFERENCE THE PUSHDOWN LIST.
043802,000105: 
043803,000106:    6103           74753        ADDRESS            MASK     BIT1                          	# SEE IF ADDRESS IS INDEXED.  CYR CONTAINED
043804,000107:    6104           10000                           CCS      A                             	# 400XX, SO BIT 1 IS NOW AS IT WAS IN CYR.
043805,000108:    6105           16146                           TCF      INDEX                         	# FORM INDEXED ADDRESS.
043806,000109: 
043807,000110:    6106           50164        DIRADRES           INDEX    LOC                           	# LOOK AHEAD TO NEXT WORD TO SEE IF
043808,000111:    6107           40001        OCT40001           CS       1                             	# ADDRESS IS GIVEN.
043809,000112:    6110           10000                           CCS      A                             	#
043810,000113:    6111           16215                           TCF      PUSHUP                        	# IF NOT.
043811,000114: 
043812,000115:    6112           77773        NEG4               DEC      -4         B-14               	#
043813,000116: 
043814,000117:    6113           24164                           INCR     LOC                           	# IF SO, TO SHOW WE PICKED UP A WORD.
043815,000118:    6114           54116                           TS       ADDRWD                        	#
043816,000119: 
043817,000120:                                                                                          	# Page 1005
043818,000121:                                                                                          	# FINAL DIGESTION OF DIRECT ADDRESSES OF OP CODES WITH 01 PREFIX IS DONE HERE.   IN EACH CASE, THE
043819,000122:                                                                                          	# REQUIRED 12-BIT SUB-ADDRESS IS LEFT IN ADDRWD, WITH ANY REQUIRED E OR F BANK SWITCHING DONE.  ADDRESSES LESS
043820,000123:                                                                                          	# THAN 45D ARE TAKEN TO BE RELATIVE TO THE WORK AREA.  THE OP CODE IS NOW IN BITS 1-5 OF CYR WITH BIT 14 = 1.
043821,000124: 
043822,000125:    6115           66251                           AD       -ENDVAC                       	# SEE IF ADDRESS RELATIVE TO WORK AREA.

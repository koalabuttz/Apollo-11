010270,000174:                                                                                          	#                       ELEVATION ANGLE IN SINGLE PREC AT CDU SCALE IN 9D OF JOB VAC
010271,000175:                                                                                          	#                       ROTATION ANGLE IN SINGLE PREC 1S COMP SCALED BY PI IN 10D OF VAC
010272,000176: 
010273,000177:                                                                                          	#       OUTPUT -        OPTIC AXIS VEC IN NB COORDS IN SCAXIS
010274,000178:                                                                                          	#                       X-MARK PLANE 1/4VEC IN NB COORDS AT 18D OF JOB VAC
010275,000179:                                                                                          	#                       Y-MARK PLANE 1/4VEC IN NB COORDS AT 12D OF JOB VAC

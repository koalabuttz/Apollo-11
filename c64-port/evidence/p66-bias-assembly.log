044076,000379:                                                                                          	# Page 1014
044077,000380:                                                                                          	# SECTION 2     LOAD AND STORE PACKAGE.
044078,000381: 
044079,000382:                                                                                          	# A SET OF EIGHT STORE CODES IS PROVIDED AS THE PRIMARY METHOD OF STORING THE MULTI-PURPOSE
044080,000383:                                                                                          	# ACCUMULATOR (MPAC).  IF IN THE DANZIG SECTION LOC REFERS TO AN ALGEBRAICALLY POSITIVE WORD, IT IS TAKEN AS A
044081,000384:                                                                                          	# STORE CODE WITH A CORRESPONDING ERASABLE ADDRESS.  MOST OF THESE CODES ARE TWO ADDRESS, SPECIFYING THAT THE WORD
044082,000385:                                                                                          	# FOLLOWING THE STORE CODE IS TO BE USED AS AN ADDRESS FROM WHICH TO RE-LOAD MPAC.  FOUR OPTIONS ARE AVAILABLE:
044083,000386: 
044084,000387:                                                                                          	#       1. STORE        STORE MPAC.  THE E ADDRESS MAY BE INDEXED.
044085,000388:                                                                                          	#       2. STODL        STORE MPAC AND RE-LOAD IT IN DP WITH THE NEXT ADDRESS (THE LOAD MAY BE INDEXED).
044086,000389:                                                                                          	#       3. STOVL        STORE MPAC AND RE-LOAD A VECTOR (AS ABOVE).
044087,000390:                                                                                          	#       4. STCALL       STORE AND DO A CALL (BOTH ADDRESES MUST BE DIRECT HERE).
044088,000391: 
044089,000392:                                                                                          	# STODL AND STOVL WILL TAKE FROM THE PUSH-DOWN LIST IF NO LOAD ADDRESS IS GIVEN.
044090,000393: 
044091,000394:    6354                                           BLOCK    3                             	#
044092,000395: 
044093,000396:    6354                                           COUNT*   $$/INTER                      	#
044094,000397:    6354           30165        STADR              CA       BANKSET                       	# THE STADR CODE (PUSHUP UP ON STORE
044095,000398:    6355           54004                           TS       FBANK                         	# ADDRESS) ENTERS HERE.

063340,000426:                                                                                          	# *** ROUGHLAW ***
063341,000427: 
063342,000428:                                                                                          	# BEFORE ENTRY TO RUFLAW:
063343,000429:                                                                                          	#       1. INDEXERS ADRSDIF1 AND ADRSDIF2 ARE SET ON BASIS OF AXIS, AND SIGN OF EDOT.
063344,000430:                                                                                          	#       2. IF EDOT WAS NEGATIVE, E AND EDOT ARE ROTATED INTO UPPER HALF-PLANE AND ROTSENSE IS MADE NEGATIVE.
063345,000431:                                                                                          	#       3. E IS SCALED AT PI RADIANS AND EDOT AT PI/4 RAD/SEC.
063346,000432:                                                                                          	#          (EXCEPT THE RUFLAW3 ENTRY WHEN E IS AT PI/4)
063347,000433: 
063348,000434:                                                                                          	# RUFLAW1:      ERROR MORE NEGATIVE THAN PI/16 RAD.  FIRE TO A RATE OF 6.5 DEG/SEC (IF JET TIME EXCEEDS 20 MSEC.).
063349,000435:                                                                                          	# RUFLAW2:      ERROR MORE POSITIVE THAN PI/16 RAD.  FIRE TO AN OPPOSING RATE OF 6.5 DEG/SEC.
063350,000436:                                                                                          	# RUFLAW3:      ERROR RATE GREATER THAN PI/32 RAD/SEC AND ERROR WITHIN BOUNDS.  COAST IF BELOW FIREFCT, FIRE IF ABOVE
063351,000437: 
063352,000438: 17,3630           43743        RUFLAW1            CS       RUFRATE                       	# DECREMENT EDOT BY .1444 RAD/SEC AT PI/4
063353,000439: 17,3631           27427                           ADS      EDOT                          	#       WHICH IS THE TARGET RATE
063354,000440: 17,3632           00006                           EXTEND                                 	#
063355,000441: 17,3633           63654                           BZMF     SMALRATE                      	# BRANCH IF RATE LESS THAN TARGET.
063356,000442: 17,3634           03712                           TC       RUFSETUP                      	# REVERSE ROTSENSE AND INDICATE MAX JETS.
063357,000443: 17,3635           31427                           CAE      EDOT                          	# PICK UP DESIRED RATE CHANGE.
063358,000444: 
063359,000445: 17,3636           00006        RUFLAW12           EXTEND                                 	# COMPUTE TJET
063360,000446: 17,3637           51744                           INDEX    ADRSDIF2                      	#       = (DESIRED RATE CHANGE)/(2-JET ACCEL.)
063361,000447: 17,3640           71571                           MP       1/ANET1    +2                 	#
063362,000448: 17,3641           67741                           AD       -1/8                          	# IF TJET, SCALED AT 32 SEC, EXCEEDS
063363,000449: 17,3642           00006                           EXTEND                                 	#       4 SECONDS, SET TJET TO TJMAX.
063364,000450: 17,3643           63645                           BZMF     +2                            	#

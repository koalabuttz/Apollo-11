007453,001115:                                                                                          	# RRTURNON
007454,001116: 
007455,001117:                                                                                          	# ALARMS_  PROGRAM ALARM 00514 - RADAR GOES OUT OF AUTO MODE WHILE BEING
007456,001118:                                                                                          	# USED

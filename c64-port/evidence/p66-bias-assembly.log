039779,000032: 
039781,000034:                                                                                          	# PROGRAM NAME:  FINDCDUW
039782,000035:                                                                                          	# MOD NUMBER:  1        68 07 15
039783,000036:                                                                                          	# MOD AUTHOR:  KLUMPP
039784,000037: 
039785,000038:                                                                                          	# OBJECTS OF MOD:       1.      TO SUPPLY COMMANDED GIMBAL ANGLES FOR NOUN 22.
039786,000039:                                                                                          	#                       2.      TO MAINTAIN CORRECT AND CURRENT THRUST
039787,000040:                                                                                          	#                               DIRECTION DATA IN ALL MODES.  THIS IS DONE BY
039788,000041:                                                                                          	#                               FETCHING FOR THE THRUST DIRECTION FILTER THE
039789,000042:                                                                                          	#                               CDUD'S IN PNGCS-AUTO, THE CDU'S IN ALL OTHER
039790,000043:                                                                                          	#                               MODES.
039791,000044:                                                                                          	#                       3.      TO SUBSTITUTE A STOPRATE FOR THE NORMAL
039792,000045:                                                                                          	#                               AUTOPILOT COMMANDS WHENEVER
039793,000046:                                                                                          	#                               1) NOT IN PNGCS-AUTO, OR
039794,000047:                                                                                          	#                               2) ENGINE IS OFF.
039795,000048: 
039796,000049:                                                                                          	# FUNCTIONAL DESCRIPTION:
039797,000050: 
039798,000051:                                                                                          	# FINDCDUW PROVIDES THE INTERFACES BETWEEN THE VARIOUS POWERED FLITE GUIDANCE PROGRAMS
039799,000052:                                                                                          	# AND THE DIGITAL AUTOPILOT.  THE INPUTS TO FINDCDUW ARE THE THRUST COMMAND VECTOR
039800,000053:                                                                                          	# AND THE WINDOW COMMAND VECTOR, AND THE OUTPUTS ARE THE GIMBAL ANGLE
039801,000054:                                                                                          	# INCREMENTS, THE COMMANDED ATTITUDE ANGLE RATES, AND THE COMMANDED
039802,000055:                                                                                          	# ATTITUDE LAG ANGLES (WHICH ACCOUNT FOR THE ANGLES BY WHICH THE BODY WILL
039803,000056:                                                                                          	# LAG BEHIND A RAMP COMMAND IN ATTITUDE ANGLE DUE TO THE FINITE ANGULAR
039804,000057:                                                                                          	# ACCELERATIONS AVAILABLE).
039805,000058: 
039806,000059:                                                                                          	# FINDCDUW ALINES THE ESTIMATED THRUST VECTOR FROM THE THRUST DIRECTION
039807,000060:                                                                                          	# FILTER WITH THE THRUST COMMAND VECTOR, AND, WHEN XOVINHIB SET,
039808,000061:                                                                                          	# ALINES THE +Z HALF OF THE LM ZX PLANE WITH THE WINDOW COMMAND VECTOR.
039809,000062: 
039811,000064:                                                                                          	# SPECIFICATIONS:
039812,000065: 
039813,000066:                                                                                          	# INITIALIZATION:       A SINGLE INTERPRETIVE CALL TO INITCDUW IS REQUIRED
039814,000067:                                                                                          	#                       BEFORE EACH GUIDED MANEUVER USING FINDCDUW.
039815,000068: 
039816,000069:                                                                                          	# CALL:                 INTERPRETIVE CALL TO FINDCDUW WITH THE THRUST COMMAND
039817,000070:                                                                                          	#                       VECTOR IN MPAC.  INTERPRETIVE CALL TO FINDCDUW -2 WITH
039818,000071:                                                                                          	#                       THE THRUST COMMAND VECTOR IN UNFC/2 AND NOT IN MPAC.
039819,000072: 
039820,000073:                                                                                          	# RETURNS:              NORMAL INTERPRETIVE IN ALL CASES
039821,000074:                                                                                          	#                       1.      NORMALLY ALL AUTOPILOT CMDS ARE ISSUED.
039822,000075:                                                                                          	#                       2.      IF NOT PNGCS AUTO, DO STOPRATE AND RETURN
039823,000076:                                                                                          	#                               WITHOUT ISSUING AUTOPILOT CMDS.
039824,000077:                                                                                          	#                       3.      IF ENGINE OFF, DO STOPRATE AND RETURN WITHOUT
039825,000078:                                                                                          	#                               ISSUING AUTOPILOT CMDS.
039826,000079: 
039827,000080:                                                                                          	# ALARMS:               00401   IF INPUTS DETERMINE AN ATTITUDE IN GIMBAL LOCK.
039828,000081:                                                                                          	#                               FINDCDUW DRIVES CDUXD AND CDUYD TO THE RQD VALUES,
039829,000082:                                                                                          	#                               BUT DRIVES CDUZD ONLY TO THE GIMBAL LOCK CONE.
039830,000083: 
039831,000084:                                                                                          	#                       00402   IF UNFC/2 OR UNWC/2 PRODUCE OVERFLOW WHEN
039832,000085:                                                                                          	#                               UNITIZED USING NORMUNIT.  FINDCDUW ISSUES
039833,000086:                                                                                          	#                               STOPRATE AS ONLY INPUT TO AUTOPILOT.
039834,000087: 
039835,000088:                                                                                          	# INPUTS:               UNFC/2          THRUST COMMAND VECTOR, NEED NOT BE SEMI-UNIT.
039836,000089:                                                                                          	#                       UNWC/2          WINDOW COMMAND VECTOR, NEED NOT BE SEMI-UNIT.
039837,000090:                                                                                          	#                       XOVINHIB        FLAG DENOTING X AXIS OVERRIDE INHIBITED.
039838,000091:                                                                                          	#                       CSMDOCKD        FLAG DENOTING CSM DOCKED.
039839,000092:                                                                                          	#                       STEERSW         FLAG DENOTING INSUFF THRUST FOR THRUST DIR FLTR.
039840,000093: 
039841,000094:                                                                                          	# OUTPUTS:              DELCDUX,Y,Z
039842,000095:                                                                                          	#                       OMEGAPD,+1,+2
039843,000096:                                                                                          	#                       DELPEROR,+1,+2
039844,000097:                                                                                          	#                       CPHI,+1,+2 FOR NOUN22
039845,000098: 
039846,000099:                                                                                          	# DEBRIS:               FINDCDUW DESTROYS SINCDUX,Y,Z AND COSCDUX,Y,Z BY
039847,000100:                                                                                          	#                       WRITING INTO THESE LOCATIONS THE SINES AND COSINES
039848,000101:                                                                                          	#                       OF THE CDUD'S IN PNGCS-AUTO, OF THE CDU'S OTHERWISE.
039849,000102: 

026623,000035:                                                                                          	##
026624,000036:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
026625,000037:                                                                                          	##      16:27 JULY 14, 1969 
026626,000038: 
026628,000040:                                                                                          	# COELLIPTIC SEQUENCE INITIATION (CSI) PROGRAMS (P32 AND P72)
026629,000041: 
026630,000042:                                                                                          	# MOD NO -1             LOG SECTION - P32-P35, P72-P75
026631,000043:                                                                                          	# MOD BY WHITE.P        DATE 1 JUNE 67
026632,000044: 
026633,000045:                                                                                          	# PURPOSE
026634,000046: 
026635,000047:                                                                                          	#       (1)     TO CALCULATE PARAMETERS ASSOCIATED WITH THE FOLLOWING
026636,000048:                                                                                          	#               CONCENTRIC FLIGHT PLAN MANEUVERS - THE CO-ELLIPTIC SEQUENCE
026637,000049:                                                                                          	#               INITIATION (CSI) MANEUVER AND THE CONSTANT DELTA ALTITUDE
026638,000050:                                                                                          	#               (CDH) MANEUVER.
026639,000051: 
026640,000052:                                                                                          	#       (2)     TO CALCULATE THESE PARAMETERS BASED UPON MANEUVER DATA
026641,000053:                                                                                          	#               APPROVED AND KEYED INTO THE DSKY BY THE ASTRONAUT.
026642,000054: 
026643,000055:                                                                                          	#       (3)     TO DISPLAY TO THE ASTRONAUT AND THE GROUND DEPENDENT VARIABLES
026644,000056:                                                                                          	#               ASSOCIATED WITH THE CONCENTRIC FLIGNT PLAN MANEUVERS FOR
026645,000057:                                                                                          	#               APPROVAL BY THE ASTRONAUT/GROUND.
026646,000058: 
026647,000059:                                                                                          	#       (4)     TO STORE THE CSI TARGET PARAMETERS FOR USE BY THE DESIRED
026648,000060:                                                                                          	#               THRUSTING PROGRAM.
026649,000061: 
026650,000062:                                                                                          	# ASSUMPTIONS
026651,000063: 
026652,000064:                                                                                          	#       (1)     AT A SELECTED TPI TIME THE LINE OF SIGHT BETWEEN THE ACTIVE
026653,000065:                                                                                          	#               AND PASSIVE VEHICLES IS SELECTED TO BE A PRESCRIBED ANGLE (E)
026654,000066:                                                                                          	#               FROM THE HORIZONTAL PLANE DEFINED BY THE ACTIVE VEHICLE
026655,000067:                                                                                          	#               POSITION.
026656,000068: 
026657,000069:                                                                                          	#       (2)     THE TIME BETWEEN CSI IGNITION AND CDH IGNITION MUST BE
026658,000070:                                                                                          	#               COMPUTED TO BE GREATER THAN 10 MINUTES FOR SUCCESSFUL
026659,000071:                                                                                          	#               COMPLETION OF THE PROGRAM.
026660,000072: 
026661,000073:                                                                                          	#       (3)     THE TIME BETWEEN CDH IGNITION AND TPI IGNITION MUST BE
026662,000074:                                                                                          	#               COMPUTED TO BE GREATER THAN 10 MINUTES FOR SUCCESSFUL
026663,000075:                                                                                          	#               COMPLETION OF THE PROGRAM.
026664,000076: 
026665,000077:                                                                                          	#       (4)     CDH DELTA V IS SELECTED TO MINIMIZE THE VARIATION OF THE
026666,000078:                                                                                          	#               ALTITUDE DIFFERENCE BETWEEN THE ORBITS.
026667,000079: 
026668,000080:                                                                                          	#       (5)     CSI BURN IS DEFINED SUCH THAT THE IMPULSIVE DELTA V IS IN THE
026669,000081:                                                                                          	#               HORIZONTAL PLANE DEFINED BY THE ACTIVE VEHICLE POSITION AT CSI
026670,000082:                                                                                          	#               IGNITION.
026671,000083: 
026672,000084:                                                                                          	#       (6)     THE PERICENTER ALTITUDE OF THE ORBIT FOLLOWING CSI AND CDH
026673,000085:                                                                                          	#               MUST BE GREATER THAN 35,000 FT (LUNAR ORBIT) OR 85 NM (EARTH
026674,000086:                                                                                          	#               ORBIT) FOR SUCCESSFUL COMPLETION OF THIS PROGRAM.
026675,000087: 
026676,000088:                                                                                          	#       (7)     THE CSI AND CDH MANEUVERS ARE ORIGINALLY ASSUMED TO BE
026677,000089:                                                                                          	#               PARALLEL TO THE PLANE OF THE CSM ORBIT.  HOWEVER CREW
026679,000091:                                                                                          	#               MODIFICATION OF DELTA V (LV) COMPONENTS MAY RESULT IN AN
026680,000092:                                                                                          	#               OUT-OF-PLANE CSI MANEUVER.
026681,000093: 
026682,000094:                                                                                          	#       (8)     STATE VECTOR UPDATES BY P27 ARE DISALLOWED DURING AUTOMATIC
026683,000095:                                                                                          	#               STATE VECTOR UPDATING INITIATED BY P20 (SEE ASSUMPTION 10).
026684,000096: 
026685,000097:                                                                                          	#       (9)     COMPUTED VARIABLES MAY BE STORED FOR LATER VERIFICATION BY
026686,000098:                                                                                          	#               THE GROUND.  THESE STORAGE CAPABILITIES ARE NORMALLY LIMITED
026687,000099:                                                                                          	#               ONLY TO THE PARAMETERS FOR ONE THRUSTING MANEUVER AT A TIME
026688,000100:                                                                                          	#               EXCEPT FOR CONCENTRIC FLIGHT PLAN MANEUVER SEQUENCES.
026689,000101: 
026690,000102:                                                                                          	#       (10)    THE RENDEZVOUS RADAR MAY OR MAY NOT BE USED TO UPDATE THE LM
026691,000103:                                                                                          	#               OR CSM STATE VECTORS FOR THIS PROGRAM.  IF RADAR USE IS
026692,000104:                                                                                          	#               DESIRED THE RADAR WAS TURNED ON AND LOCKED ON THE CSM BY
026693,000105:                                                                                          	#               PREVIOUS SELECTION OF P20.  RADAR SIGHTING MARKS WILL BE MADE
026694,000106:                                                                                          	#               AUTOMATICALLY APPROXIMATELY ONCE A MINUTE WHEN ENABLED BY THE
026695,000107:                                                                                          	#               TRACK AND UPDATE FLAGS (SEE P20).  THE RENDEZVOUS TRACKING
026696,000108:                                                                                          	#               MARK COUNTER IS ZEROED BY THE SELECTION OF P20 AND AFTER EACH
026697,000109:                                                                                          	#               THRUSTING MANEUVER.
026698,000110: 
026699,000111:                                                                                          	#       (11)    THE ISS NEED NOT BE ON TO COMPLETE THIS PROGRAM.
026700,000112: 
026701,000113:                                                                                          	#       (12)    THE OPERATION OF THE PROGRAM UTILIZES THE FOLLOWING FLAGS -
026702,000114: 
026703,000115:                                                                                          	#                       ACTIVE VEHICLE FLAG - DESIGNATES THE VEHICLE WHICH IS
026704,000116:                                                                                          	#                       DOING RENDEZVOUS THRUSTING MANEUVERS TO THE PROGRAM WHICH
026705,000117:                                                                                          	#                       CALCULATES THE MANEUVER PARAMETERS.  SET AT THE START OF
026706,000118:                                                                                          	#                       EACH RENDEZVOUS PRE-THRUSTING PROGRAM.
026707,000119: 
026708,000120:                                                                                          	#                       FINAL FLAG - SELECTS FINAL PROGRAM DISPLAYS AFTER CREW HAS
026709,000121:                                                                                          	#                       COMPLETED THE FINAL MANEUVER COMPUTATION AND DISPLAY
026710,000122:                                                                                          	#                       CYCLE.
026711,000123: 
026712,000124:                                                                                          	#                       EXTERNAL DELTA V STEERING FLAG - DESIGNATES THE TYPE OF
026713,000125:                                                                                          	#                       STEERING REQUIRED FOR EXECUTION OF THIS MANEUVER BY THE
026714,000126:                                                                                          	#                       THRUSTING PROGRAM SELECTED AFTER COMPLETION OF THIS
026715,000127:                                                                                          	#                       PROGRAM.
026716,000128: 
026717,000129:                                                                                          	#       (13)    IT IS NORMALLY REQUIRED THAT THE ISS BE ON FOR 1 HOUR PRIOR TO
026718,000130:                                                                                          	#               A THRUSTING MANEUVER.
026719,000131: 
026720,000132:                                                                                          	#       (14)    THIS PROGRAM IS SELECTED BY THE ASTRONAUT BY DSKY ENTRY -
026721,000133: 
026722,000134:                                                                                          	#                       P32 IF THIS VEHICLE IS ACTIVE VEHICLE.
026723,000135: 
026724,000136:                                                                                          	#                       P72 IF THIS VEHICLE IS PASSIVE VEHICLE.
026725,000137: 
026726,000138:                                                                                          	# INPUT
026727,000139: 
026728,000140:                                                                                          	#       (1)     TCSI            TIME OF THE CSI MANEUVER
026729,000141: 
026731,000143:                                                                                          	#       (2)     NN              NUMBER OF APSIDAL CROSSINGS THRU WHICH THE ACTIVE
026732,000144:                                                                                          	#                               VEHICLE ORBIT CAN BE ADVANCED TO OBTAIN THE CDH
026733,000145:                                                                                          	#                               MANEUVER POINT
026734,000146:                                                                                          	#       (3)     ELEV            DESIRED LOS ANGLE AT TPI
026735,000147:                                                                                          	#       (4)     TTPI            TIME OF THE TPI MANEUVER
026736,000148: 
026737,000149:                                                                                          	# OUTPUT
026738,000150: 
026739,000151:                                                                                          	#       (1)     TRKMKCNT        NUMBER OF MARKS
026740,000152:                                                                                          	#       (2)     TTOGO           TIME TO GO
026741,000153:                                                                                          	#       (3)     +MGA            MIDDLE GIMBAL ANGLE
026742,000154:                                                                                          	#       (4)     DIFFALT         DELTA ALTITUDE AT CDH
026743,000155:                                                                                          	#       (5)     T1TOT2          DELTA TIME FROM CSI TO CDH
026744,000156:                                                                                          	#       (6)     T2TOT3          DELTA TIME FROM CDH TO TPI
026745,000157:                                                                                          	#       (7)     DELVLVC         DELTA VELOCITY AT CSI - LOCAL VERTICAL COORDINATES
026746,000158:                                                                                          	#       (8)     DELVLVC         DELTA VELOCITY AT CDH - LOCAL VERTICAL COORDINATES
026747,000159: 
026748,000160:                                                                                          	# DOWNLINK
026749,000161: 
026750,000162:                                                                                          	#       (1)     TCSI            TIME OF THE CSI MANEUVER
026751,000163:                                                                                          	#       (2)     TCDH            TIME OF THE CDH MANEUVER
026752,000164:                                                                                          	#       (3)     TTPI            TIME OF THE TPI MANEUVER
026753,000165:                                                                                          	#       (4)     TIG             TIME OF THE CSI MANEUVER
026754,000166:                                                                                          	#       (5)     DELVEET1        DELTA VELOCITY AT CSI - REFERENCE COORDINATES
026755,000167:                                                                                          	#       (6)     DELVEET2        DELTA VELOCITY AT CDH - REFERENCE COORDINATES
026756,000168:                                                                                          	#       (7)     DIFFALT         DELTA ALTITUDE AT CDH
026757,000169:                                                                                          	#       (8)     NN              NUMBER OF APSIDAL CROSSINGS THRU WHICH THE ACTIVE
026758,000170:                                                                                          	#                               VEHICLE ORBIT CAN BE ADVANCED TO OBTAIN THE CDH
026759,000171:                                                                                          	#                               MANEUVER POINT
026760,000172:                                                                                          	#       (9)     ELEV            DESIRED LOS ANGLE AT TPI
026761,000173: 
026762,000174:                                                                                          	# COMMUNICATION TO THRUSTING PROGRAMS
026763,000175: 
026764,000176:                                                                                          	#       (1)     TIG             TIME OF THE CSI MANEUVER
026765,000177:                                                                                          	#       (2)     RTIG            POSITION OF ACTIVE VEHICLE AT CSI - BEFORE ROTATION
026766,000178:                                                                                          	#                               INTO PLANE OF PASSIVE VEHICLE
026767,000179:                                                                                          	#       (3)     VTIG            VELOCITY OF ACTIVE VEHICLE AT CSE - BEFORE ROTATION
026768,000180:                                                                                          	#                               INTO PLANE OF PASSIVE VEHICLE
026769,000181:                                                                                          	#       (4)     DELVSIN         DELTA VELOCITY AT CSI - REFERENCE COORDINATES
026770,000182:                                                                                          	#       (5)     DELVSAB         MAGNITUDE OF DELTA VELOCITY AT CSI
026771,000183:                                                                                          	#       (6)     XDELVFLG        SET TO INDICATE EXTERNAL DELTA V VG COMPUTATION
026772,000184: 

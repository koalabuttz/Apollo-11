060048,000144: 10,3676           13702                           TCF      +4                            	#
060049,000145: 10,3677           50000                           INDEX    A                             	# SIGN.
060050,000146: 10,3700           34734                           CAF      LIMITS                        	# FIX IT, BY ADDING IN 37777 OR 40000
060051,000147: 10,3701           60142                           AD       TEM2                          	#
060052,000148: 
060053,000149: 10,3702           50130                           INDEX    BUF                           	#
060054,000150: 10,3703           54000                           TS       0                             	# STORE NEW ANGLE IN 2S COMPLEMENT.
060055,000151: 10,3704           00002                           TC       Q                             	#
060056,000152: 
060058,000154:                                                                                          	# RTB TO TORQUE GYROS, EXCEPT FOR THE CALL TO IMUSTALL.  ECADR OF COMMANDS ARRIVES IN X1.
060059,000155: 
060060,000156: 10,3705           50120        PULSEIMU           INDEX    FIXLOC                        	# ADDRESS OF GYRO COMMANDS SHOULD BE IN X1
060061,000157: 10,3706           30046                           CA       X1                            	#
060062,000158: 10,3707           04616                           TC       BANKCALL                      	#
060063,000159: 10,3710           17323                           CADR     IMUPULSE                      	#
060064,000160: 10,3711           16061                           TCF      DANZIG                        	#
060065,000161: 
060067,000163:                                                                                          	# THE SUBROUTINE SIGNMPAC SETS C(MPAC, MPAC +1) TO SIGN(MPAC).
060068,000164:                                                                                          	# FOR THIS, ONLY THE CONTENTS OF MPAC ARE EXAMINED.  ALSO +0 YIELDS POSMAX AND -0 YIELDS NEGMAX.
060069,000165: 
060070,000166:                                                                                          	# ENTRY MAY BE BY EITHER OF THE FOLLOWING:
060071,000167:                                                                                          	#       1.      LIMIT THE SIZE OF MPAC ON INTERPRETIVE OVERFLOW:
060072,000168:                                                                                          	#               ENTRY:          BOVB
060073,000169:                                                                                          	#                                       SIGNMPAC
060074,000170:                                                                                          	#       2.      GENERATE IN MPAC THE SIGNUM FUNCTION OF MPAC:
060075,000171:                                                                                          	#               ENTRY:          RTB
060076,000172:                                                                                          	#                                       SIGNMPAC
060077,000173:                                                                                          	# IN EITHER CASE, RETURN IS TO THE NEXT INTERPRETIVE INSTRUCTION IN THE CALLING SEQUENCE.
060078,000174: 
060079,000175: 10,3712           00006        SIGNMPAC           EXTEND                                 	#
060080,000176: 10,3713           34733                           DCA      DPOSMAX                       	#
060081,000177: 10,3714           52155                           DXCH     MPAC                          	#
060082,000178: 10,3715           10000                           CCS      A                             	#
060083,000179: 10,3716           34755        DPMODE             CAF      ZERO                          	# SETS MPAC +2 TO ZERO IN THE PROCESS
060084,000180: 10,3717           16057                           TCF      SLOAD2     +2                 	#
060085,000181: 10,3720           13721                           TCF      +1                            	#
060086,000182: 10,3721           00006                           EXTEND                                 	#
060087,000183: 10,3722           44733                           DCS      DPOSMAX                       	#
060088,000184: 10,3723           16055                           TCF      SLOAD2                        	#
060089,000185: 
060090,000186:                                                                                          	# RTB OP CODE NORMUNIT IS LIKE INTERPRETIVE INSTRUCTION UNIT, EXCEPT THAT IT CAN BE DEPENDED ON NOT TO BLOW
060091,000187:                                                                                          	# UP WHEN THE VECTOR BEING UNITIZED IS VERY SMALL -- IT WILL BLOW UP WHEN ALL COMPONENTS ARE ZERO.  IF NORMUNIT
060092,000188:                                                                                          	# IS USED AND THE UPPER ORDER HALVES OF ALL COMPONENTS ARE ZERO, THE MAGNITUDE RETURNED IN 36D WILL BE TOO LARGE
060093,000189:                                                                                          	# BY A FACTOR OF 2(13) AND THE SQUARED MAGNITUDE RETURNED AT 34D WILL BE TOO BIG BY A FACTOR OF 2(26).
060094,000190: 
060095,000191: 10,3724           34753        NORMUNX1           CAF      ONE                           	#
060096,000192: 10,3725           13727                           TCF      NORMUNIT   +1                 	#
060097,000193: 10,3726           34755        NORMUNIT           CAF      ZERO                          	#
060098,000194: 10,3727           60120                           AD       FIXLOC                        	#
060099,000195: 10,3730           54156                           TS       MPAC       +2                 	#
060100,000196: 10,3731           04616                           TC       BANKCALL                      	# GET SIGN AGREEMENT IN ALL COMPONENTS
060101,000197: 10,3732           01010                           CADR     VECAGREE                      	#
060102,000198: 10,3733           10154                           CCS      MPAC                          	#
060103,000199: 10,3734           13770                           TCF      NOSHIFT                       	#
060104,000200: 10,3735           13737                           TCF      +2                            	#
060105,000201: 10,3736           13770                           TCF      NOSHIFT                       	#
060106,000202: 10,3737           10157                           CCS      MPAC       +3                 	#
060107,000203: 10,3740           13770                           TCF      NOSHIFT                       	#
060108,000204: 10,3741           13743                           TCF      +2                            	#
060109,000205: 10,3742           13770                           TCF      NOSHIFT                       	#
060110,000206: 10,3743           10161                           CCS      MPAC       +5                 	#
060111,000207: 10,3744           13770                           TCF      NOSHIFT                       	#
060112,000208: 10,3745           13747                           TCF      +2                            	#
060113,000209: 10,3746           13770                           TCF      NOSHIFT                       	#
060115,000211: 10,3747           30155                           CA       MPAC       +1                 	# SHIFT ALL COMPONENTS LEFT 13
060116,000212: 10,3750           00006                           EXTEND                                 	#
060117,000213: 10,3751           74736                           MP       BIT14                         	#
060118,000214: 10,3752           20155                           DAS      MPAC                          	# DAS GAINS A LITTLE ACCURACY
060119,000215: 10,3753           30160                           CA       MPAC       +4                 	#
060120,000216: 10,3754           00006                           EXTEND                                 	#
060121,000217: 10,3755           74736                           MP       BIT14                         	#
060122,000218: 10,3756           20160                           DAS      MPAC       +3                 	#
060123,000219: 10,3757           30162                           CA       MPAC       +6                 	#
060124,000220: 10,3760           00006                           EXTEND                                 	#
060125,000221: 10,3761           74736                           MP       BIT14                         	#
060126,000222: 10,3762           20162                           DAS      MPAC       +5                 	#
060127,000223: 10,3763           34761                           CAF      THIRTEEN                      	#
060128,000224: 10,3764           50156                           INDEX    MPAC       +2                 	#
060129,000225: 10,3765           54045                           TS       37D                           	#
060130,000226: 10,3766           04635        OFFTUNIT           TC       POSTJUMP                      	#
060131,000227: 10,3767           01024                           CADR     UNIT       +1                 	# SKIP THE "TC VECAGREE" DONE AT UNIT
060132,000228: 
060133,000229: 10,3770           34755        NOSHIFT            CAF      ZERO                          	#
060134,000230: 10,3771           13764                           TCF      OFFTUNIT   -2                 	#
060135,000231: 
060136,000232:                                                                                          	# RTB VECSGNAG ... FORCES SIGN AGREEMENT OF VECTOR IN MPAC.
060137,000233: 
060138,000234: 10,3772           04616        VECSGNAG           TC       BANKCALL                      	#
060139,000235: 10,3773           01010                           CADR     VECAGREE                      	#
060140,000236: 10,3774           06061                           TC       DANZIG                        	#
060141,000237: 
060142,000238: 
(End of include-file RTB_OP_CODES.agc, resuming MAIN.agc)

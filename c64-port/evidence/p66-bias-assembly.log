049195,000218:                                                                                          	#       W = ERROR TRANSITION MATRIX
049196,000219:                                                                                          	#       DELTAX = COMPUTED STATE VECTOR DEVIATIONS
049197,000220:                                                                                          	#       DMENFLG = SIZE OF W MATRIX (ZERO=6X6) (1=9X9)
049198,000221:                                                                                          	#       GAMMA = SCALAR FOR INCORPORATION
049199,000222:                                                                                          	#       ZI = VECTOR USED IN INCORPORATION
049200,000223:                                                                                          	#       OMEGA = WEIGHTING VECTOR
049201,000224: 
049202,000225:                                                                                          	# OUTPUT

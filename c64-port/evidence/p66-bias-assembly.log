023627,002431:                                                                                          	#       ENDRADAR, FINDVAC
023628,002432: 
023629,002433:                                                                                          	# JOBS OR TASKS INITIATED_  DODES
023630,002434: 
023631,002435:                                                                                          	# ALARMS_  PROGRAM ALARM 00503 (30 SECONDS HAVE EXPIRED) WITH NO RR DATA
023632,002436:                                                                                          	# GOOD (CHAN 33 BIT 4) RECEIVED WHEN LOCK-ON (STATE BIT 5) WAS REQUESTED.
023633,002437: 

033258,000660:                                                                                          	#       WEIGHT/G        ANTICIPATED VEHICLE MASS        DP B16 KGM
033259,000661:                                                                                          	#       XDELVFLG        1=DELTA-V MANEUVER, 0=AIMPT STEER
033260,000662:                                                                                          	#       F               THRUST FOR ENGINE USED
033261,000663:                                                                                          	#   IF DELTA-V MANEUVER
033262,000664:                                                                                          	#       DELVSIN         SPECIFIED DELTA-V REQUIRED IN
033263,000665:                                                                                          	#                       INERTIAL COORDS. OF ACTIVE VEHICLE
033264,000666:                                                                                          	#                       AT TIME OF IGNITION             VECTOR B7 M/CS
033265,000667:                                                                                          	#       DELVSAB         MAG. OF DELVSIN                 DP B7 M/CS
033266,000668:                                                                                          	#       RTIG            POSITION AT TIME OF IGNITION    VECTOR B29 M
033267,000669:                                                                                          	#       VTIG            VELOCITY AT TIME OF IGNITION    VECTOR B7 M/CS
033268,000670:                                                                                          	#   IF AIMPT STEER
033269,000671:                                                                                          	#       TIG             TIME OF IGNITION                DP B28 CS
033270,000672:                                                                                          	#       RTARG           POSITION TARGET TIME            VECTOR B29 M
033271,000673:                                                                                          	#       CSTEER          C FOR STEER LAW                 DP B2
033272,000674:                                                                                          	#       DLTARG          TARGET TIME-IGNITION TIME       DP B28 CS

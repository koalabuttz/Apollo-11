046322,002625:                                                                                          	# TRIGONOMETRIC FUNCTION PACKAGE.
046323,002626:                                                                                          	#       THE FOLLOWING TRIGONOMETRIC FUNCTIONS ARE AVAIALABLE AS INTERPRETIVE OPERATIONS:
046324,002627:                                                                                          	#       1.      SIN             COMPUTES (1/2)SINE(2 PI MPAC).
046325,002628:                                                                                          	#       2.      COS             COMPUTES (1/2)COSINE(2 PI MPAC).
046326,002629:                                                                                          	#       3.      ASIN            COMPUTES (1/2PI)ARCSINE(2 MPAC).
046327,002630:                                                                                          	#       4.      ACOS            COMPUTES (1/2PI)ARCCOSINE(2 MPAC).
046328,002631: 
046329,002632:                                                                                          	# SIN-ASIN AND COS-ACOS ARE MUTUALLY INVERSE, I.E., SIN(ASIN(X)) = X.

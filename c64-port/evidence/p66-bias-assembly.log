013447,000041: 
013448,000042:                                                                                          	# THESE TWO ROUTINES COMPUTE THE ACTUAL STATE VECTOR FOR LM,CSM BY ADDING
013449,000043:                                                                                          	# THE CONIC R,V AND THE DEVIATIONS R,V.  THE STATE VECTORS ARE CONVERTED TO
013450,000044:                                                                                          	# METERS B-29 AND METERS/CSEC B-7 AND STORED APPROPRIATELY IN RN,VN OR
013451,000045:                                                                                          	# R-OTHER,V-OTHER FOR DOWNLINK.  THE ROUTINES NAMES ARE SWITCHED IN THE
013452,000046:                                                                                          	# OTHER VEHICLES COMPUTER.
013453,000047: 
013454,000048:                                                                                          	# INPUT
013455,000049:                                                                                          	#       STATE VECTOR IN TEMPORARY STORAGE AREA
013456,000050:                                                                                          	#       IF STATE VECTOR IS SCALED POS B27 AND VEL B5
013457,000051:                                                                                          	#               SET X2 TO +2
013458,000052:                                                                                          	#       IF STATE VECTOR IS SCALED POS B29 AND VEL B7
013459,000053:                                                                                          	#               SET X2 TO 0
013460,000054: 
013461,000055:                                                                                          	# OUTPUT
013462,000056:                                                                                          	#       R(T) IN RN, V(T) IN VN, T IN PIPTIME
013463,000057:                                                                                          	# OR
013464,000058:                                                                                          	#       R(T) IN R-OTHER, V(T) IN V-OTHER        (T IS DEFINED BY T-OTHER)
013465,000059: 

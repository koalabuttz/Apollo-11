021735,000539: 
021736,000540:                                                                                          	# NORMAL EXIT MODES -
021737,000541: 
021738,000542:                                                                                          	#       P25 MAY BE TERMINATED IN TWO WAYS - ASTRONAUT SELECTION OF IDLING
021739,000543:                                                                                          	#       PROGRAM (P00) BY KEYING V37E00E OR BY KEYING IN V56E
021740,000544: 

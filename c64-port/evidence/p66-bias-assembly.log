021236,000040:                                                                                          	##
021237,000041:                                                                                          	## Notations on the hardcopy document read, in part:
021238,000042:                                                                                          	##
021239,000043:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
021240,000044:                                                                                          	##      16:27 JULY 14, 1969 
021241,000045: 
021243,000047:                                                                                          	# RENDEZVOUS NAVIGATION PROGRAM 20
021244,000048: 
021245,000049:                                                                                          	# PROGRAM DESCRIPTION
021246,000050: 
021247,000051:                                                                                          	#       MOD NO - 2
021248,000052:                                                                                          	#       BY P. VOLANTE
021249,000053: 
021250,000054:                                                                                          	# FUNCTIONAL DESCRIPTION
021251,000055: 
021252,000056:                                                                                          	#       THE PURPOSE OF THIS PROGRAM IS TO CONTROL THE RENDEZVOUS RADAR FROM
021253,000057:                                                                                          	#       STARTUP THROUGH ACQUISITION AND LOCKON TO THE CSM AND TO UPDATE EITHER 
021254,000058:                                                                                          	#       THE LM OR CSM STATE VECTOR (AS SPECIFIED BY THE ASTRONAUT BY DSKY ENTRY)
021255,000059:                                                                                          	#       ON THE BASIS OF THE RR TRACKING DATA.
021256,000060: 
021257,000061:                                                                                          	# CALLING SEQUENCE -
021258,000062: 
021259,000063:                                                                                          	#       ASTRONAUT REQUEST THROUGH DSKY V37E20E
021260,000064: 
021261,000065:                                                                                          	# SUBROUTINES CALLED
021262,000066: 
021263,000067:                                                                                          	#       R02BOTH (IMU STATUS CHECK)                      FLAGUP
021264,000068:                                                                                          	#       GOFLASH (PINBALL-DISPLAY)                       FLAGDOWN
021265,000069:                                                                                          	#       R23LEM  (MANUAL ACQUISITION)                    BANKCALL
021266,000070:                                                                                          	#       LS201   (LOS DETERMINATION)                     TASKOVER
021267,000071:                                                                                          	#       LS202   (RANGE LIMIT TEST)
021268,000072:                                                                                          	#       R61LEM  (PREFERRED TRACKING ATTITUDE)
021269,000073:                                                                                          	#       R21LEM  (RR DESIGNATE)                          ENDOFJOB
021270,000074:                                                                                          	#       R22LEM  (DATA READ)                             GOPERF1
021271,000075:                                                                                          	#       R31LEM  (RENDEZVOUS PARAMETER DISPLAY)  
021272,000076:                                                                                          	#       PRIOLARM (PRIORITY DISPLAY)
021273,000077: 
021274,000078:                                                                                          	# NORMAL EXIT MODES -
021275,000079: 

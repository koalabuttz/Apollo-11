026922,000334: 
026924,000336:                                                                                          	# CONSTANT DELTA HEIGHT (CDH) PROGRAMS (P33 AND P73)
026925,000337:                                                                                          	# MOD NO -1                     LOG SECTION - P32-P35, P72-P75
026926,000338:                                                                                          	# MOD BY WHITE.P                DATE  1JUNE67
026927,000339: 
026928,000340:                                                                                          	# PURPOSE
026929,000341: 
026930,000342:                                                                                          	#       (1)     TO CALCULATE PARAMETERS ASSOCIATED WITH THE CONSTANT DELTA
026931,000343:                                                                                          	#               ALTITUDE MANEUVER (CDH).
026932,000344: 
026933,000345:                                                                                          	#       (2)     TO CALCULATE THESE PARAMETERS BASED UPON MANEUVER DATA
026934,000346:                                                                                          	#               APPROVED AND KEYED INTO THE DSKY BY THE ASTRONAUT.
026935,000347: 
026936,000348:                                                                                          	#       (3)     TO DISPLAY TO THE ASTRONAUT AND THE GROUND DEPENDENT VARIABLES
026937,000349:                                                                                          	#               ASSOCIATED WITH THE CDH MANEUVER FOR APPROVAL BY THE
026938,000350:                                                                                          	#               ASTRONAUT/GROUND.
026939,000351: 
026940,000352:                                                                                          	#       (4)     TO STORE THE CDH TARGET PARAMETERS FOR USE BY THE DESIRED
026941,000353:                                                                                          	#               THRUSTING PROGRAM.
026942,000354: 
026943,000355:                                                                                          	# ASSUMPTIONS
026944,000356: 
026945,000357:                                                                                          	#       (1)     THIS PROGRAM IS BASED UPON PREVIOUS COMPLETION OF THE
026946,000358:                                                                                          	#               CO-ELLIPTIC SEQUENCE INITIATION (CSI) PROGRAM (P32/P72).
026947,000359:                                                                                          	#               THERFORE -
026948,000360: 
026949,000361:                                                                                          	#               (A)     AT A SELECTED TPI TIME (NOW IN STORAGE) THE LINE OF SIGHT
026950,000362:                                                                                          	#                       BETWEEN THE ACTIVE AND PASSIVE VEHICLES WAS SELECTED TO BE
026951,000363:                                                                                          	#                       A PRESCRIBED ANGLE (E) (NOW IN STORAGE) FROM THE
026952,000364:                                                                                          	#                       HORIZONTAL PLANE DEFINED BY THE ACTIVE VEHICLE POSITION.
026953,000365: 
026954,000366:                                                                                          	#               (B)     THE TIME BETWEEN CSI IGNITION AND CDH IGNITION WAS
026955,000367:                                                                                          	#                       COMPUTED TO BE GREATER THAN 10 MINUTES.
026956,000368: 
026957,000369:                                                                                          	#               (C)     THE TIME BETWEEN CDH IGNITION AND TPI IGNITION WAS
026958,000370:                                                                                          	#                       COMPUTED TO BE GREATER THAN 10 MINUTES.
026959,000371: 
026960,000372:                                                                                          	#               (D)     THE VARIATION OF THE ALTITUDE DIFFERENCE BETWEEN THE
026961,000373:                                                                                          	#                       ORBITS WAS MINMIZED.
026962,000374: 
026963,000375:                                                                                          	#               (E)     CSI BURN WAS DEFINED SUCH THAT THE IMPULSIVE DELTA V WAS
026964,000376:                                                                                          	#                       IN THE HORIZONTAL PLANE DEFINED BY ACTIVE VEHICLE
026965,000377:                                                                                          	#                       POSITION AT CSI IGNITION.
026966,000378: 
026967,000379:                                                                                          	#               (F)     THE PERICENTER ALTITUDES OF THE ORBITS FOLLOWING CSI AND
026968,000380:                                                                                          	#                       CDH WERE COMPUTED TO BE GREATER THAN 35,000 FT FOR LUNAR
026969,000381:                                                                                          	#                       ORBIT OR 85 NM FOR EARTH ORBIT.
026970,000382: 
026971,000383:                                                                                          	#               (G)     THE CSI AND CDH MANEUVERS WERE ASSUMED TO BE PARALLEL TO
026972,000384:                                                                                          	#                       THE PLANE OF THE PASSIVE VEHICLE ORBIT.  HOWEVER, CREW
026974,000386:                                                                                          	#                       MODIFICATION OF DELTA V (LV) COMPONENTS MAY HAVE RESULTED
026975,000387:                                                                                          	#                       IN AN OUT-OF-PLANE MANEUVER.
026976,000388: 
026977,000389:                                                                                          	#       (2)     STATE VECTOR UPDATES BY P27 ARE DISALLOWED DURING AUTOMATIC
026978,000390:                                                                                          	#               STATE VECTOR UPDATING INITIATED BY P20 (SEE ASSUMPTION 4).
026979,000391: 
026980,000392:                                                                                          	#       (3)     COMPUTED VARIABLES MAY BE STORED FOR LATER VERIFICATION BY
026981,000393:                                                                                          	#               THE GROUND.  THESE STORAGE CAPABILITES ARE NORMALLY LIMITED
026982,000394:                                                                                          	#               ONLY TO THE PARAMETERS FOR ONE THRUSTING MANEUVER AT A TIME
026983,000395:                                                                                          	#               EXCEPT FOR CONCENTRIC FLIGHT PLAN MANEUVER SEQUENCES.
026984,000396: 
026985,000397:                                                                                          	#       (4)     THE RENDEZVOUS RADAR MAY OR MAY NOT BE USED TO UPDATE THE LM
026986,000398:                                                                                          	#               OR CSM STATE VECTORS FOR THIS PROGRAM.  IF RADAR USE IS
026987,000399:                                                                                          	#               DESIRED THE RADAR WAS TURNED ON AND LOCKED ON THE CSM BY
026988,000400:                                                                                          	#               PREVIOUS SELECTION OF P20.  RADAR SIGHTING MARKS WILL BE MADE
026989,000401:                                                                                          	#               AUTOMATICALLY APPROXIMATELY ONCE A MINUTE WHEN ENABLED BY THE
026990,000402:                                                                                          	#               TRACK AND UPDATE FLAGS (SEE P20).  THE RENDEZVOUS TRACKING
026991,000403:                                                                                          	#               MARK COUNTER IS ZEROED BY THE SELECTION OF P20 AND AFTER EACH
026992,000404:                                                                                          	#               THRUSTING MANEUVER.
026993,000405: 
026994,000406:                                                                                          	#       (5)     THE ISS NEED NOT BE ON TO COMPLETE THIS PROGRAM.
026995,000407: 
026996,000408:                                                                                          	#       (6)     THE OPERATION OF THE PROGRAM UTILIZES THE FOLLOWING FLAGS -
026997,000409: 
026998,000410:                                                                                          	#                       ACTIVE VEGICLE FLAG - DESIGNATES THE VEHICLE WHICH IS
026999,000411:                                                                                          	#                       DOING RENDEZVOUS THRUSTING MANEUVERS TO THE PROGRAM WHICH
027000,000412:                                                                                          	#                       CALCULATES THE MANEUVER PARAMETERS.  SET AT THE START OF
027001,000413:                                                                                          	#                       EACH RENDEZVOUS PRE-THRUSTING PROGRAM.
027002,000414: 
027003,000415:                                                                                          	#                       FINAL FLAG - SELECTS FINAL PROGRAM DISPLAYS AFTER CREW HAS
027004,000416:                                                                                          	#                       COMPLETED THE FINAL MANEUVER COMPUTATION AND DISPLAY
027005,000417:                                                                                          	#                       CYCLE.
027006,000418: 
027007,000419:                                                                                          	#                       EXTERNAL DELTA V STEERING FLAG - DESIGNATES THE TYPE OF
027008,000420:                                                                                          	#                       STEERING REQUIRED FOR EXECUTION OF THIS MANEUVER BY THE
027009,000421:                                                                                          	#                       THRUSTING PROGRAM SELECTED AFTER COMPLETION OF THIS
027010,000422:                                                                                          	#                       PROGRAM.
027011,000423: 
027012,000424:                                                                                          	#       (7)     IT IS NORMALLY REQUIRED THAT THE ISS BE ON FOR 1 HOUR PRIOR TO
027013,000425:                                                                                          	#               A THRUSTING MANEUVER.
027014,000426: 
027015,000427:                                                                                          	#       (8)     THIS PROGRAM IS SELECTED BY THE ASTRONAUT BY DSKY ENTRY -
027016,000428: 
027017,000429:                                                                                          	#                       P33 IF THIS VEHICLE IS ACTIVE VEHICLE.
027018,000430: 
027019,000431:                                                                                          	#                       P73 IF THIS VEHICLE IS PASSIVE VEHICLE.
027020,000432: 
027021,000433:                                                                                          	# INPUT
027022,000434: 
027023,000435:                                                                                          	#       (1)     TTPI0   TIME OF THE TPI MANEUVER - SAVED FROM P32/P72
027025,000437:                                                                                          	#       (2)     ELEV    DESIRED LOS ANGLE AT TPI - SAVED FROM P32/P72
027026,000438:                                                                                          	#       (3)     TCDH    TIME OF THE CDH MANEUVER
027027,000439: 
027028,000440:                                                                                          	# OUTPUT
027029,000441: 
027030,000442:                                                                                          	#       (1)     TRKMKCNT        NUMBER OF MARKS
027031,000443:                                                                                          	#       (2)     TTOGO           TIME TO GO
027032,000444:                                                                                          	#       (3)     +MGA            MIDDLE GIMBAL ANGLE
027033,000445:                                                                                          	#       (4)     DIFFALT         DELTA ALTITUDE AT CDH
027034,000446:                                                                                          	#       (5)     T2TOT3          DELTA TIME FROM CDH TO COMPUTED TPI
027035,000447:                                                                                          	#       (6)     NOMTPI          DELTA TIME FROM NOMINAL TPI TO COMPUTED TPI
027036,000448:                                                                                          	#       (7)     DELVLVC         DELTA VELOCITY AT CDH - LOCAL VERTICAL COORDINATES
027037,000449: 
027038,000450:                                                                                          	# DOWNLINK
027039,000451: 
027040,000452:                                                                                          	#       (1)     TCDH            TIME OF THE CDH MANEUVER
027041,000453:                                                                                          	#       (2)     TTPI            TIME OF THE TPI MANEUVER
027042,000454:                                                                                          	#       (3)     TIG             TIME OF THE CDH MANEUVER
027043,000455:                                                                                          	#       (4)     DELVEET2        DELTA VELOCITY AT CDH - REFERENCE COORDINATES
027044,000456:                                                                                          	#       (5)     DIFFALT         DELTA ALTITUDE AT CDH
027045,000457:                                                                                          	#       (6)     ELEV            DESIRED LOS ANGLE AT TPI
027046,000458: 
027047,000459:                                                                                          	# COMMUNICATION TO THRUSTING PROGRAMS
027048,000460: 
027049,000461:                                                                                          	#       (1)     TIG             TIME OF THE CDH MANEUVER
027050,000462:                                                                                          	#       (2)     RTIG            POSITION OF ACTIVE VEHICLE AT CDH - BEFORE ROTATION
027051,000463:                                                                                          	#                               INTO PLANE OF PASSIVE VEHICLE
027052,000464:                                                                                          	#       (3)     VTIG            VELOCITY OF ACTIVE VEHICLE AT CDH - BEFORE ROTATION
027053,000465:                                                                                          	#                               INTO PLANE OF PASSIVE VEHICLE
027054,000466:                                                                                          	#       (4)     DELVSIN         DELTA VELOCITY AT CDH - REFERENCE COORDINATES
027055,000467:                                                                                          	#       (5)     DELVSAB         MAGNITUDE OF DELTA VELOCITY AT CDH
027056,000468:                                                                                          	#       (6)     XDELVFLG        SET TO INDICATE EXTERNAL DELTA V VG COMPUTATION
027057,000469: 

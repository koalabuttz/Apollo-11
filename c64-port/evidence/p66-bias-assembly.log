045649,001952: 00,2564           52155                           DXCH     MPAC                          	#
045650,001953: 
045651,001954: 00,2565           10140        MAXTEST            CCS      MAXDVSW                       	# 0 IF MAJORS MIGHT BE =, -1 OTHERWISE.
045652,001955: 00,2566           06552        BIASHI             DEC      .4192      B-1                	# SQRT CONSTANTS.
045653,001956: 
045654,001957: 00,2567           12642                           TCF      MAXDV                         	# CHECK TO SEE IF THAY ARE NOW EQUAL.
045655,001958: 
045656,001959:                                                                                          	# Page 1062
045657,001960:                                                                                          	# THE FOLLOWING IS A GENERAL PURPOSE DOUBLE PRECISION DIVISION ROUTINE.  IT DIVIDES MPAC BY BUF AND LEAVES
045658,001961:                                                                                          	# THE RESULT IN MPAC.  THE FOLLOWING CONDITIONS MUST BE SATISFIED:
045659,001962: 
045660,001963:                                                                                          	#       1.      THE DIVISOR (BUF) MUST BE POSITIVE AND NOT LESS THAN .5.
045661,001964: 
045662,001965:                                                                                          	#       2.      THE DIVIDEND (MPAC) MUST BE POSITIVE WITH THE MAJOR PART OF MPAC STRICTLY LESS THAN THAT OF BUF
045663,001966:                                                                                          	#               (A SPECIAL APPROXIMATION, MAXDV, IS USED WHEN THE MAJOR PARTS ARE EQUAL).
045664,001967: 
045665,001968:                                                                                          	# UNDERSTANDING THAT A/B = Q + S(R/B) WHERE S = 2(-14) AND Q AND R ARE QUOTIENT AND REMAINDER, RESPEC-
045666,001969:                                                                                          	# TIVELY, THE FOLLOWING APPROXIMATION IS OBTAINED BY MULTIPLYING ABOVE AND BELOW BY C - SD AND NEGLECTING TERMS OF
045667,001970:                                                                                          	# ORDER S-SQUARED (POSSIBLY INTRODUCING ERROR INTO THE LOW TWO BITS OF THE RESULT).  SIGN AGREEMENT IS UNNECESSARY.
045668,001971: 
045669,001972:                                                                                          	#       A + SB .      (R - QD)                                             A + SB
045670,001973:                                                                                          	#       ------ = Q + S(------) WHERE Q AND R ARE QUOTIENT AND REMAINDER OF ------ RESPECTIVELY.
045671,001974:                                                                                          	#       C + SD        (  C   }                                                C
045672,001975: 
045673,001976: 00,2570           52155        GENDDV             DXCH     MPAC                          	# WE NEED A AND B ONLY FOR FIRST DV.
045674,001977: 00,2571           00006                 +1        EXTEND                                 	# (SPECIAL UNIT PROLOGUE ENTERS HERE).
045675,001978: 00,2572           10130                           DV       BUF                           	# A NOW CONTAINS Q AND L, R.
045676,001979: 00,2573           52155                           DXCH     MPAC                          	#
045677,001980: 
045678,001981: 00,2574           40154                           CS       MPAC                          	# FORM DIVIDEND FOR MINOR PART OF RESULT.
045679,001982: 00,2575           00006                           EXTEND                                 	#
045680,001983: 00,2576           70131                           MP       BUF        +1                 	#
045681,001984: 00,2577           60155                           AD       MPAC       +1                 	# OVERFLOW AT THIS POINT IS POSITIVE SINCE
045682,001985: 00,2600           54000                           OVSK                                   	# R IS POSITIVE IN EVERY CASE.
045683,001986: 00,2601           12606                           TCF      +5                            	#
045684,001987: 
045685,001988: 00,2602           00006                           EXTEND                                 	# OVERFLOW CAN BE REMOVED BY SUBTRACTING C
045686,001989: 00,2603           60130                           SU       BUF                           	# (BUF) ONCE SINCE R IS ALWAYS LESS THAN C
045687,001990: 00,2604           24154                           INCR     MPAC                          	# IN THIS CASE.  INCR COMPENSATES SUBTRACT.
045688,001991: 00,2605           12610                           TCF      +DOWN                         	# (SINCE C(A) IS STILL POSITIVE).
045689,001992: 
045690,001993: 00,2606           00006                 +5        EXTEND                                 	# C(A) CAN BE MADE LESS THAN C IN MAGNI-
045691,001994: 00,2607           62620                           BZMF     -UP                           	# TUDE BY DIMINISHING IT BY C (SINCE C IS
045692,001995:                                                                                          	# NOT LESS THAN .5) UNLESS C(A) = 0.
045693,001996: 
045694,001997:                                                                                          	# Page 1063
045695,001998: 00,2610           00006        +DOWN              EXTEND                                 	#
045696,001999: 00,2611           60130                           SU       BUF                           	# IF POSITIVE, REDUCE ONLY IF NECESSARY
045697,002000: 00,2612           00006                           EXTEND                                 	# SINCE THE COMPENSATING INCR MIGHT CAUSE
045698,002001: 00,2613           12616                           BZF      +3                            	# OVERFLOW.
045699,002002: 00,2614           00006                           EXTEND                                 	# DON'T SUBTRACT UNLESS RESULT IS POSITIVE
045700,002003: 00,2615           62624                           BZMF     ENDMAXDV                      	# OR ZERO.
045701,002004: 
045702,002005: 00,2616           24154                 +3        INCR     MPAC                          	# KEEP SUBTRACT HERE AND COMPENSATE.
045703,002006: 00,2617           12625                           TCF      FINALDV                       	#
045704,002007: 
045705,002008: 00,2620           00006        -UP                EXTEND                                 	# IF ZERO, SET MINOR PART OF RESULT TO
045706,002009: 00,2621           12630                           BZF      FINALDV    +3                 	# ZERO.
045707,002010: 
045708,002011: 00,2622           00006                           EXTEND                                 	# IF NEGATIVE, ADD C TO A, SUBTRACTING ONE
045709,002012: 00,2623           26154                           DIM      MPAC                          	# TO COMPENSATE.  DIM IS OK HERE SINCE THE
045710,002013: 00,2624           60130        ENDMAXDV           AD       BUF                           	# MAJOR PART NEVER GOES NEGATIVE.
045711,002014: 
045712,002015:                                                                                          	# Page 1064
045713,002016: 00,2625           22007        FINALDV            ZL                                     	# DO DV TO OBTAIN MINOR PART OF RESULT.
045714,002017: 00,2626           00006                           EXTEND                                 	#
045715,002018: 00,2627           10130                           DV       BUF                           	#
045716,002019: 00,2630           54155                 +3        TS       MPAC       +1                 	#
045717,002020: 
045718,002021: 00,2631           10136                           CCS      DVSIGN                        	# LEAVE RESULT POSITIVE UNLESS C(DVSIGN)=
045719,002022: 00,2632           00002                           TC       Q                             	# -0.
045720,002023: 00,2633           00002                           TC       Q                             	#
045721,002024: 00,2634           00002                           TC       Q                             	#
045722,002025: 
045723,002026: 00,2635           00006                           EXTEND                                 	#
045724,002027: 00,2636           40155                           DCS      MPAC                          	#
045725,002028: 00,2637           52155                           DXCH     MPAC                          	#
045726,002029: 00,2640           34755                           CAF      ZERO                          	# SO WE ALWAYS RETURN WITH C(A) = 0.
045727,002030: 00,2641           00002                           TC       Q                             	#
045728,002031: 
045729,002032:                                                                                          	# Page 1065
045730,002033:                                                                                          	# IF THE MAJOR PARTS OF THE DIVISOR AND DIVIDEND ARE EQUAL, BUT THE MINOR PARTS ARE SUCH THAT THE
045731,002034:                                                                                          	# DIVIDEND IS STRICTLY LESS THAN THE DIVISOR IN MAGNITUDE, THE FOLLOWING APPROXIMATION IS USED.  THE ASSUMPTIONS
045732,002035:                                                                                          	# ARE THE SAME AS THE GENERAL ROUTINE WITH THE ADDITION THAT SIGN AGREEMENT IS NECESSARY (B, C, & D POSITIVE).
045733,002036: 
045734,002037:                                                                                          	#       C + SB .          (C + B - D)
045735,002038:                                                                                          	#       ------ = 37777 + S(---------)
045736,002039:                                                                                          	#       C + SD            (    C    )
045737,002040: 
045738,002041:                                                                                          	# THE DIVISION MAY BE PERFORMED IMMEDIATELY SINCE B IS STRICTLY LESS THAN D AND C IS NOT LESS THAN .5.
045739,002042: 
045740,002043: 00,2642           40154        MAXDV              CS       MPAC                          	# SEE IF MAXDV CASE STILL HOLDS AFTER
045741,002044: 00,2643           60130                           AD       BUF                           	# NORMALIZATION.
045742,002045: 00,2644           00006                           EXTEND                                 	#
045743,002046: 00,2645           12647                           BZF      +2                            	#
045744,002047: 00,2646           12570                           TCF      GENDDV                        	# MPAC NOW LESS THAN BUFF -- DIVIDE AS USUAL.
045745,002048: 
045746,002049: 00,2647           34733                 +2        CAF      POSMAX                        	# SET MAJOR PART OF RESULT.
045747,002050: 00,2650           54154                           TS       MPAC                          	#
045748,002051: 
045749,002052: 00,2651           40131                           CS       BUF        +1                 	# FORM DIVIDEND OF MINOR PART OF RESULT.
045750,002053: 00,2652           60155                           AD       MPAC       +1                 	#
045751,002054: 00,2653           12624                           TCF      ENDMAXDV                      	# GO ADD C AND DO DIVIDE, ATTACHING SIGN
045752,002055:                                                                                          	# BEFORE EXITING.
045753,002056: 
045754,002057:                                                                                          	# Page 1066
045755,002058:                                                                                          	# VECTOR DIVIDED BY SCALAR, V/SC, IS EXECUTED HERE.  THE VECTOR IS NOW IN MPAC WITH SCALAR IN BUF.
045756,002059: 
045757,002060: 00,2654           44753        V/SC2              CS       ONE                           	# INITIALIZE DIVIDEND NORMALIZATION COUNT
045758,002061: 00,2655           54137                           TS       DVNORMCT                      	# AND DIVISION SIGN REGISTER.
045759,002062: 00,2656           54127                           TS       VBUF       +5                 	#
045760,002063: 
045761,002064: 00,2657           03010                           TC       VECAGREE                      	# FORCE SIGN AGREEMENT IN VECTOR
045762,002065: 
045763,002066: 00,2660           52131                           DXCH     BUF                           	#
045764,002067: 00,2661           07544                           TC       ALSIGNAG                      	# SIGN AGREE BUF
045765,002068: 00,2662           52131                           DXCH     BUF                           	#
045766,002069: 00,2663           10130                           CCS      BUF                           	# FORCE DIVISOR POSITIVE WITH MAJOR PART
045767,002070: 00,2664           12721                           TCF      /BUF+                         	# NON-ZERO (IF POSSIBLE).
045768,002071: 00,2665           12667                           TCF      +2                            	#
045769,002072: 00,2666           12715                           TCF      /BUF-                         	#
045770,002073: 
045771,002074: 00,2667           56131                           XCH      BUF        +1                 	# SHIFT VECTOR AND SCALAR LEFT 14.
045772,002075: 00,2670           56130                           XCH      BUF                           	#
045773,002076: 00,2671           56155                           XCH      MPAC       +1                 	#
045774,002077: 00,2672           56154                           XCH      MPAC                          	#
045775,002078: 00,2673           00006                           EXTEND                                 	# CHECK FOR OVERFLOW IN EACH CASE.
045776,002079: 00,2674           12676                           BZF      +2                            	#
045777,002080: 00,2675           12405                           TCF      DVOVF                         	#
045778,002081: 
045779,002082: 00,2676           56160                           XCH      MPAC       +4                 	#
045780,002083: 00,2677           56157                           XCH      MPAC       +3                 	#
045781,002084: 00,2700           00006                           EXTEND                                 	#
045782,002085: 00,2701           12703                           BZF      +2                            	#
045783,002086: 00,2702           12405                           TCF      DVOVF                         	#
045784,002087: 
045785,002088: 00,2703           56162                           XCH      MPAC       +6                 	#
045786,002089: 00,2704           56161                           XCH      MPAC       +5                 	#
045787,002090: 00,2705           00006                           EXTEND                                 	#
045788,002091: 00,2706           12710                           BZF      +2                            	#
045789,002092: 00,2707           12405                           TCF      DVOVF                         	#
045790,002093: 

031120,000044: 
031122,000046:                                                                                          	# STABLE ORBIT RENDEZVOUS PROGRAMS (P38 AND P78)
031123,000047: 
031124,000048:                                                                                          	# MOD NO -1             LOG SECTION - STABLE ORBIT - P38-P39
031125,000049:                                                                                          	# MOD BY RUDNICKI.S     DATE 25JAN68
031126,000050: 
031127,000051:                                                                                          	# FUNCTIONAL DESCRIPTION
031128,000052: 
031129,000053:                                                                                          	#       P38 AND P78 CALCULATE THE REQUIRED DELTA V AND OTHER INITIAL
031130,000054:                                                                                          	#       CONDITIONS REQUIRED BY THE AGC TO (1) PUT THE ACTIVE VEHICLE
031131,000055:                                                                                          	#       ON A TRANSFER TRAJECTORY THAT INTERCEPTS THE PASSIVE VEHICLE
031132,000056:                                                                                          	#       ORBIT A GIVEN DISTANCE, DELTA R, EITHER AHEAD OF OR BEHIND THE
031133,000057:                                                                                          	#       PASSIVE VEHICLE AND (2) ACTUALLY PLACE THE ACTIVE VEHICLE IN THE
031134,000058:                                                                                          	#       PASSIVE VEHICLE ORBIT WITH A DELTA R SEPARATION BETWEEN THE TWO
031135,000059:                                                                                          	#       VEHICLES
031136,000060: 
031137,000061:                                                                                          	# CALLING SEQUENCE
031138,000062: 
031139,000063:                                                                                          	#       ASTRONAUT REQUEST THRU DSKY
031140,000064: 
031141,000065:                                                                                          	#       V37E38E         IF THIS VEHICLE IS ACTIVE VEHICLE

064159,000613:                                                                                          	# SUBROUTINE ROOTCYCL:  BY CRAIG WORK, 3 APRIL 68
064160,000614: 
064161,000615:                                                                                          	# ROOTCYCL IS A SUBROUTINE WHICH EXECUTES ONE NEWTON SQUARE ROOT ALGORITHM ITERATION.  THE INITIAL GUESS AT THE
064162,000616:                                                                                          	# SQUARE ROOT IS PRESUMED TO BE IN THE A REGISTER AND ONE-HALF THE SQUARE IS TAKEN FROM HALFARG.  THE NEW APPROXI-
064163,000617:                                                                                          	# MATION TO THE SQUARE ROOT IS RETURNED IN THE A REGISTER.  DEBRIS:  A, L, SR, SCRATCH.  ROOTCYCL IS CALLED FROM
064164,000618:                                                                                          	# LOCATION (LOC) BY A TC ROOTCYCL, AND RETURNS (TC Q) TO LOC +1.
064165,000619: 
064166,000620:                                                                                          	# WARNING:  IF THE INITIAL GUESS IS NOT GREATER THAN THE SQUARE, DIVIDE OR ADD OVERFLOW IS A REAL POSSIBILITY.
064167,000621: 
064168,000622: 21,3636           55746        ROOTCYCL           TS       SCRATCH                       	# STORE X
064169,000623: 21,3637           54021                           TS       SR                            	# X/2 NOW IN SR
064170,000624: 21,3640           31747                           CA       HALFARG                       	# ARG/2 IN THE A REG
064171,000625: 21,3641           22007                           ZL                                     	# PREPARE FOR DIVISION
064172,000626: 21,3642           00006                           EXTEND                                 	#
064173,000627: 21,3643           11746                           DV       SCRATCH                       	# (ARG/X)/2
064174,000628: 21,3644           60021                           AD       SR                            	# (X + ARG/X)/2 IN THE A REG
064175,000629: 21,3645           00002                           TC       Q                             	#

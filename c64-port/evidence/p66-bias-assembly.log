057752,000365: 
057753,000366:                                                                                          	# GENERAL INFORMATION
057754,000367:                                                                                          	# ------- -----------
057755,000368: 
057756,000369:                                                                                          	# ALARM OR ABORT EXIT MODES --
057757,000370:                                                                                          	#       PRIOBORT        TC      ABORT
057758,000371:                                                                                          	#                       OCT     1502
057759,000372: 
057760,000373:                                                                                          	#       PRIOBORT IS BRANCED TO WHEN (1) A NORMAL DISPLAY IS REQUESTED AND ANOTHER NORMAL DISPLAY IS ALREADY ACTIVE
057761,000374:                                                                                          	#       (REFLASH AND REGODSP ARE EXCEPTIONS) OR (2) A PRIORITY DISPLAY IS REQUESTED WHEN ANOTHER PRIORITY DISPLAY IS
057762,000375:                                                                                          	#       ALREADY ACTIVE (A PRIORITY WITH LINUS BIT14 IS AN EXCEPTION).
057763,000376: 
057764,000377:                                                                                          	# ERASABLE INITIALIZATION REQUIRED --
057765,000378:                                                                                          	#       ACCOMPLISHED BY FRESH START -   1.  FLAGWRD4 (USED EXCLUSIVELY BY DISPLAY INTERFACE ROUTINES)
057766,000379:                                                                                          	#                                       2.  NVSAVE = NORMAL VERB AND NOUN REGISTER.
057767,000380:                                                                                          	#                                       3.  EBANKTEM = NORMAL INACTIVE FLAGWORD (ALSO CONTAINS NORMALS EBANK).
057768,000381:                                                                                          	#                                       5.  R1SAVE = MARKBRAN CONTROL WORD
057769,000382:                                                                                          	#                                       4.  RESTREG = PRIORITY 30 AND SUPERBANK 3.
057770,000383: 
057771,000384:                                                                                          	# OUTPUT --
057772,000385:                                                                                          	#       NVWORD = PRIO VERB AND NOUN
057773,000386:                                                                                          	#       NVWORD +1 (MARKNV) = MARK VERB AND NOUN
057774,000387:                                                                                          	#       NVWORD +2 (NVSAVE) = NORMAL VERB AND NOUN
057775,000388:                                                                                          	#       DSPFLG (EBANKSAV) = PRIO FLAGWORD (INCLUDING EBANK)
057776,000389:                                                                                          	#       DSPFLG +1 (MARKEBAN) = MARK FLAGWORD (INCLUDING EBANK)
057777,000390:                                                                                          	#       DSPFLG +2 (EBANKTEM) = NORMAL FLAGWORD (INCLUDIG EBANK)
057778,000391: 
057779,000392:                                                                                          	#       CADRFLSH = PRIO USERS CALL CADR +1 LOCATION
057780,000393:                                                                                          	#       CADRFLSH +1 (MARKFLSH) = MARK USERS CALL CADR +1 LOCATION
057781,000394:                                                                                          	#       CADRFLSH +2 (TEMPFLSH) = NORMAL USERS CALL CADR +1 LOCATION
057782,000395:                                                                                          	#       PRIOTIME = TIME EACH PRIO REQUEST FIRST SENT OUT
057783,000396:                                                                                          	#       OPTION1 = DESIRED OPTION FROM GOPERF4
057784,000397:                                                                                          	#       FLAGWRD4 = BIT INFO FOR CONTROL OF ALL DISPLAY ROUTINES
057785,000398:                                                                                          	#       DSPTEM1 = R1 INFO FOR ASTRONAUT FROM PERFORM DISPLAYS (NORMAL)
057786,000399: 
057787,000400:                                                                                          	# SUBROUTINES USED -- NVSUB, FLAGUP, FLAGDOWN, ENDOFJOB, BLANKSUB, ABORT, JOBWAKE, JOBSLEEP, FINDVAC, PRIOCHNG,
057788,000401:                                                                                          	#       JAMTERM, NVSUBUSY, FLASHON, ENDIDLE, CHANG1, BANKJUMP, MAKECADR, NOVAC,

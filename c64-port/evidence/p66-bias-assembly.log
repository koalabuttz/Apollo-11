040520,000025:                                                                                          	## available online at www.ibiblio.org/apollo.  If for some reason you
040521,000026:                                                                                          	## find that the images are illegible, contact me at info@sandroid.org
040522,000027:                                                                                          	## about getting access to the (much) higher-quality images which Paul
040523,000028:                                                                                          	## actually created.
040524,000029:                                                                                          	##
040525,000030:                                                                                          	## Notations on the hardcopy document read, in part:
040526,000031:                                                                                          	##
040527,000032:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
040528,000033:                                                                                          	##      16:27 JULY 14, 1969 
040529,000034: 
040531,000036:                                                                                          	# PROGRAM NAME - PROG52                 DATE - JAN 9, 1967
040532,000037:                                                                                          	# MOD NO - 0                                    LOG SECTION - P51-P53
040533,000038:                                                                                          	# MODIFICATION BY - LONSKE                      ASSEMBLY - SUNDANCE REV 46
040534,000039: 
040535,000040:                                                                                          	# FUNCTIONAL DESCRIPTION -
040536,000041: 
040537,000042:                                                                                          	#       ALIGNS THE IMU TO ONE OF THREE ORIENTATIONS SELECTED BY THE ASTRONAUT.  THE PRESENT IMU ORIENTATION IS KNOWN
040538,000043:                                                                                          	#       AND IS STORED IN REFSMMAT.  THE THREE POSSIBLE ORIENTATIONS MAY BE_
040539,000044: 
040540,000045:                                                                                          	#       (A)     PREFERRED ORIENTATION
040541,000046: 
040542,000047:                                                                                          	#               AN OPTIMUM ORIENTATION FOR A PREVIOUSLY CALCULATED MANUEVER.  THIS ORIENTATION MUST BE CALCULATED AND
040543,000048:                                                                                          	#               STORED BY A PREVIOUSLY SELECTED PROGRAM.
040544,000049: 
040545,000050:                                                                                          	#       (B)     NOMINAL ORIENTATION
040546,000051: 
040547,000052:                                                                                          	#               X   = UNIT ( R )
040548,000053:                                                                                          	#               -SM
040549,000054: 
040550,000055:                                                                                          	#               Y   = UNIT (V X R)
040551,000056:                                                                                          	#                SM
040552,000057: 
040553,000058:                                                                                          	#               Z   = UNIT (X   X Y  )
040554,000059:                                                                                          	#                SM          SM    SM
040555,000060: 
040556,000061:                                                                                          	#               WHERE_
040557,000062: 
040558,000063:                                                                                          	#               R = THE GEOCENTRIC RADIUS VECTOR AT TIME T(ALIGN) SELECTED BY THE ASTRONAUT
040559,000064:                                                                                          	#               -
040560,000065: 
040561,000066:                                                                                          	#               V = THE INERTIAL VELOCITY VECTOR AT TIME T(ALIGN) SELECTED BY THE ASTRONAUT
040562,000067:                                                                                          	#               -
040563,000068: 
040564,000069:                                                                                          	#       (C)     REFSMMAT ORIENTATION
040565,000070: 
040566,000071:                                                                                          	#       (D)     LANDING SITE - THIS IS NOT AVAILIBLE IN SUNDANCE
040567,000072: 
040568,000073:                                                                                          	#       THIS SELECTION CORRECTS THE PRESENT IMU ORIENTATION.  THE PRESENT ORIENTATION DIFFERS FROM THAT TO WHICH IT
040569,000074:                                                                                          	#       WAS LAST ALIGNED ONLY DUE TO GYRO DRIFT (I.E. NEITHER GIMBAL LOCK NOR IMU POWER INTERRUPTION HAS OCCURED
040570,000075:                                                                                          	#       SINCE THE LAST ALIGNMENT).
040571,000076: 
040572,000077:                                                                                          	#       AFTER A IMU ORIENTATION HAS BEEN SELECTED ROUTINE S52.2 IS OPERATED TO COMPUTE THE GIMBAL ANGLES USING THE
040573,000078:                                                                                          	#       NEW ORIENTATION AND THE PRESENT VEHICLE ATTITUDE.  CAL52A THEN USES THESE ANGLES, STORED IN THETAD,+1,+2, TO
040574,000079:                                                                                          	#       COARSE ALIGN THE IMU.  THE STAR SELECTION ROUTINE, R56, IS THEN OPERATED.  IF 2 STARS ARE NOT AVAILABLE AN ALARM
040575,000080:                                                                                          	#       IS FLASHED TO NOTIFY THE ASTRONAUT.  AT THIS POINT THE ASTRONAUT WILL MANUEVER THE VEHICLE AND SELECT 2 STARS
040576,000081:                                                                                          	#       EITHER MANUALLY OR AUTOMATICALLY.  AFTER 2 STARS HAVE BEEN SELECTED THE IMU IS FINE ALIGNED USING ROUTINE R51.  IF
040577,000082:                                                                                          	#       THE RENDEZVOUS NAVIGATION PROCESS IS OPERATING (INDICATED BY RNDVZFLG) P20 IS DISPLAYED.  OTHERWISE P00 IS
040578,000083:                                                                                          	#       REQUESTED.
040579,000084: 
040580,000085:                                                                                          	# CALLING SEQUENCE -
040581,000086: 
040583,000088:                                                                                          	#       THE PROGRAM IS CALLED BY THE ASTRONAUT BY DSKY ENTRY.
040584,000089: 
040585,000090:                                                                                          	# SUBROUTINES CALLED -
040586,000091: 
040587,000092:                                                                                          	#       1. FLAGDOWN              7. S52.2               13. NEWMODEX
040588,000093:                                                                                          	#       2. R02BOTH               8. CAL53A              14. PRIOLARM
040589,000094:                                                                                          	#       3. GOPERF4               9. FLAGUP
040590,000095:                                                                                          	#       4. MATMOVE              10. R56
040591,000096:                                                                                          	#       5. GOFLASH              11. R51
040592,000097:                                                                                          	#       6. S52.3                12. GOPERF3
040593,000098: 
040594,000099:                                                                                          	# NORMAL EXIT MODES -
040595,000100: 
040596,000101:                                                                                          	#       EXITS TO ENDOFJOB
040597,000102: 
040598,000103:                                                                                          	# ALARM OR ABORT EXIT MODES -
040599,000104: 
040600,000105:                                                                                          	#       NONE
040601,000106: 
040602,000107:                                                                                          	# OUTPUT -
040603,000108: 
040604,000109:                                                                                          	#       THE FOLLOWING MAY BE FLASHED ON THE DSKY
040605,000110:                                                                                          	#               1. IMU ORIENTATION CODE
040606,000111:                                                                                          	#               2. ALARM CODE 215 - PREFERRED IMU ORIENTATION NOT SPECIFIED
040607,000112:                                                                                          	#               3. TIME OF NEXT IGNITION
040608,000113:                                                                                          	#               4. GIMBAL ANGLES
040609,000114:                                                                                          	#               5. ALARM CODE 405 - TWO STARS NOT AVAILABLE
040610,000115:                                                                                          	#               6. PLEASE PERFORM P00
040611,000116:                                                                                          	#       THE MODE DISPLAY MAY BE CHANGED TO 20
040612,000117: 
040613,000118:                                                                                          	# ERASABLE INITIALIZATION REQUIRED -
040614,000119: 
040615,000120:                                                                                          	#       PFRATFLG SHOULD BE SET IF A PREFERRED ORIENTATION HAS BEEN COMPUTED.  IF IT HAS BEEN COMPUTED IT IS STORED IN
040616,000121:                                                                                          	#       XSMD, YSMD, ZSMD.
040617,000122: 
040618,000123:                                                                                          	#       RNDVZFLG INDICATES WHETHER THE RENDEZVOUS NAVIGATION PROCESS IS OPERATING.
040619,000124: 

045174,001477: 00,2020           70020                           MASK     CYR                           	# COUNT-1 IS NOW IN BITS 2-3 OF CYR.  THE
045175,001478: 00,2021           54021                           TS       SR                            	# ROUNDING BIT IS IN BIT1 AT THIS POINT.
045176,001479: 

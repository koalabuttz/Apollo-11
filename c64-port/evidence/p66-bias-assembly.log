034028,001430:                                                                                          	# SUBROUTINE NAME:  S41.1       MOD. NO. 0      DATE: FEBRUARY 28, 1967
034029,001431:                                                                                          	# MOD. NO. 1    DATE: JANUARY 23, 1968: BY PETER ADLER (MIT/IL)
034030,001432: 
034031,001433:                                                                                          	# AUTHOR: JONATHAN D. ADDELSTON (ADAMS ASSOCIATES)
034032,001434: 
034033,001435:                                                                                          	# S41.1 PERFORMS THE COORDINATE SYSTEM TRANFORMATION FROM THE REFERENCE FRAME TO THE BODY OF THE LM.
034034,001436:                                                                                          	# SPECIFICALLY, IT IS USED TO TRANSFORM A VELOCITY (SCALED AT 2(+7) METERS/CENTISECOND) FROM REFERENCE TO LM AXIS
034035,001437:                                                                                          	# COORDINATES.  FIRST THE VECTOR IS TRANSFORMED TO THE STABLE MEMBER COORDINATES BY THE MATRIX REFSMMAT.  THIS
034036,001438:                                                                                          	# LEAVES THE VECTOR IN MPAC, SCALED AT 2(+8) METERS/CENTISECOND.  THEN
034037,001439:                                                                                          	# THE SUBROUTINE CDUTRIG IS CALLED TO SET UP THE DOUBLE-PRECISION CDU VECTOR ALONG WITH ITS SINES AND COSINES.
034038,001440:                                                                                          	# THE VECTOR IS THEN TRANSFORMED FROM STABLE MEMBER COORDINATES TO SPACECRAFT (OR LM) COORDINATES BY THE
034039,001441:                                                                                          	# SUBROUTINE *SMNB*.  FINALLY( THE VECTOR IS RESCALED TO 2(+7) METERS/CENTISECOND, AND CONTROL IS RETURNED TO THE
034040,001442:                                                                                          	# CALLER WITH C(MPAC) = VELOCITY(LM).
034041,001443: 
034042,001444:                                                                                          	# CALLING SEQUENCE:
034043,001445:                                                                                          	#       L       VLOAD   CALL
034044,001446:                                                                                          	#       L +1            VELOCITY(REF)           SCALED AT 2(+7) M/CS IN REFERENCE COORDS.
034045,001447:                                                                                          	#       L +2            S41.1
034046,001448:                                                                                          	#       L +3    STORE   VELOCITY(LM)            SCALED AT 2(+7) M/CS IN LM BODY AXIS SYS.
034047,001449: 
034048,001450:                                                                                          	# SUBROUTINES CALLED:
034049,001451:                                                                                          	#       1.      CDUTRIG,
034050,001452:                                                                                          	#                       WHICH CALLS CDULOGIC.
034051,001453:                                                                                          	#       2.      *SMNB*
034052,001454: 
034053,001455:                                                                                          	# NORMAL RETURN:  L +3 (SEE CALLING SEQUENCE, ABOVE.)
034054,001456: 
034055,001457:                                                                                          	# ALARM/ABORT MODES:  NONE.
034056,001458: 
034057,001459:                                                                                          	# RESTART PROTECTION:  NONE.
034058,001460: 
034060,001462:                                                                                          	# INPUT:
034061,001463:                                                                                          	#       1.      REFSMMAT.
034062,001464:                                                                                          	#       2.      CDUX, CDUY, CDUZ.
034063,001465:                                                                                          	#       3.      VELOCITY (REF) IN MPAC.
034064,001466: 
034065,001467:                                                                                          	# OUTPUT:
034066,001468:                                                                                          	#       1.      CDUSPOT:        DOUBLE PRECISION CDU VECTOR, ORDERED Y,Z,X.
034067,001469:                                                                                          	#       2.      SINCDU:         HALF SINES OF CDUSPOT COMPONENTS.
034068,001470:                                                                                          	#       3.      COSCDU:         HALF COSINES OF CDUSPOT COMPONENTS.
034069,001471:                                                                                          	#       4.      MPAC:           VELOCITY(LM) (SCALED AT 2(+7) METERS/CENTISECOND)
034070,001472: 
034071,001473:                                                                                          	# DEBRIS:  NONE.
034072,001474: 
034073,001475:                                                                                          	# CHECKOUT STATUS:  CODED.
034074,001476: 
034075,001477: 27,3267                                           COUNT*   $$/S41.1                      	#
034076,001478: 27,3267           76521        S41.1              MXV      VSL1                          	# CONVERT VECTOR IN MPAC FROM REF AT 2(+7)
034077,001479: 27,3270           01734                                    REFSMMAT                      	# TO SM AND RESCALE DUE TO HALFUNIT MATRIX
034078,001480: 27,3271           77650                           GOTO                                   	# CONVERT TO BODY AT 2(+7) USING PRESENT
034079,001481: 27,3272           47646                                    CDU*SMNB                      	# CDU ANGLES.  CDU*SMNB WILL RETURN
034080,001482:                                                                                          	# VIA RVQ TO THE CALLER OF S41.1
(End of include-file P40-P47.agc, resuming MAIN.agc)

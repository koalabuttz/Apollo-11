020328,000036:                                                                                          	# MOD NO: 0                             DATE: 1 MAY 1968
020329,000037:                                                                                          	# MOD BY: DIGITAL DEVEL GROUP           LOG SECTION R60,R62
020330,000038: 
020331,000039:                                                                                          	# FUNCTIONAL DESCRIPTION:
020332,000040: 
020333,000041:                                                                                          	# CALLED AS A GENERAL SUBROUTINE TO MANEUVER THE LM TO A SPECIFIED
020334,000042:                                                                                          	# ATTITUDE.
020335,000043: 
020336,000044:                                                                                          	# 1. IF THE 3-AXIS FLAG IS NOT SET THE FINAL CDU ANGLES ARE
020337,000045:                                                                                          	# CALCULATED (VECPOINT).
020338,000046: 
020339,000047:                                                                                          	# 2. THE FDAI BALL ANGLES (NOUN 18) ARE CALCULATED (BALLANGS).
020340,000048: 
020341,000049:                                                                                          	# 3. REQUEST FLASHING DISPLAY V50 N18 PLEASE PERFORM AUTO MANEUVER.
020342,000050: 
020343,000051:                                                                                          	# 4. IF PRIORITY DISPLAY FLAG IS SET DO A PHASECHANGE.  THEN AWAIT
020344,000052:                                                                                          	# ASTRONAUT RESPONSE.
020345,000053: 
020346,000054:                                                                                          	# 5. DISPLAY RESPONSE RETURNS:
020347,000055: 
020348,000056:                                                                                          	#       A.      ENTER - RESET 3-AXIS FLAG AND RETURN TO CLIENT.
020349,000057: 
020350,000058:                                                                                          	#       B.      TERMINATE - IF IN P00 GO TO STEP 5A.  OTHERWISE CHECK IF R61 IS
020351,000059:                                                                                          	#               THE CALLING PROGRAM.  IF IN R61 AN EXIT IS MADE TO GOTOV56.  IF
020352,000060:                                                                                          	#               NOT IN R61 AN EXIT IS DONE VIA GOTOP00H.
020353,000061: 
020354,000062:                                                                                          	#       C.      PROCEED - CONTINUE WITH PROGRAM AT STEP 6.
020355,000063: 
020356,000064:                                                                                          	# 6. IF THE 3-AXISFLAG IS NOT SET, THE FINAL CDU ANGLES ARE CALCULATED
020357,000065:                                                                                          	# (VECPOINT).
020358,000066: 
020359,000067:                                                                                          	# 7. THE FDAI BALL ANGLES (NOUN 18) ARE CALCULATED (BALLANGS).
020360,000068: 
020361,000069:                                                                                          	# 8. IF THE G+N SWITCH IS NOT SET GO BACK TO STEP 3.
020362,000070:                                                                                          	# 
020363,000071:                                                                                          	# 9. IF THE AUTO SWITCH IS NOT SET GO BACK TO STEP 3.
020364,000072: 
020365,000073:                                                                                          	# 10. NONFLASHING DISPLAY V06N18 (FDAI ANGLES).
020366,000074: 
020367,000075:                                                                                          	# 11. DO A PHASECHANGE.
020368,000076: 
020369,000077:                                                                                          	# 12. DO A MANEUVER CALCULATION AND ICDU DRIVE ROUTINE TO ACHIEVE FINAL
020370,000078:                                                                                          	# GIMBAL ANGLES (GOMANUR).
020371,000079: 
020372,000080:                                                                                          	# 13. AT END OF MANEUVER GO TO STEP 3.
020373,000081: 
020374,000082:                                                                                          	#       IF SATISFACTORY MANEUVER STEP 5A EXITS R60.
020375,000083:                                                                                          	#       FOR FURTHER ADJUSTMENT OF THE VEHICLE ATTITUDE ABOUT THE
020376,000084:                                                                                          	#       DESIRED VECTOR, THE ROUTINE MAY BE PERFORMED AGAIN STARTING AT
020378,000086:                                                                                          	#       STEP 5C.
020379,000087: 
020380,000088:                                                                                          	# CALLING SEQUENCE:     TC      BANKCALL
020381,000089:                                                                                          	#                       CADR    R60LEM
020382,000090: 
020383,000091:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:     SCAXIS, POINTVSM (FOR VECPOINT)
020384,000092:                                                                                          	#                                       3AXISFLG.
020385,000093: 
020386,000094:                                                                                          	# SUBROUTINES CALLED:   VECPOINT, BALLANGS, GOPERF2R, LINUS, GODSPER,
020387,000095:                                                                                          	#                       GOMANUR, DOWNFLAG, PHASCHNG, UPFLAG
020388,000096: 
020389,000097:                                                                                          	# NORMAL EXIT MODES:    CAE     TEMPR60         (CALLERS RETURN ADDRESS)
020390,000098:                                                                                          	#                       TC      BANKJUMP
020391,000099: 
020392,000100:                                                                                          	# ALARMS: NONE
020393,000101: 
020394,000102:                                                                                          	# OUTPUT: NONE
020395,000103: 
020396,000104:                                                                                          	# DEBRIS: CPHI, CTHETA, CPSI, 3AXISFLG, TBASE2
020397,000105: 

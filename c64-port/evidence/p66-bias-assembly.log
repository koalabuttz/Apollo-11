022806,001610:                                                                                          	# PROGRAM NAME_  RRTURNON
022807,001611: 
022808,001612:                                                                                          	# FUNCTIONAL DESCRIPTION_
022809,001613: 
022810,001614:                                                                                          	#       RRTURNON IS THE TURN-ON SEQUENCE WHICH, ALONG WITH
022811,001615:                                                                                          	#       RRZEROSB, ZEROS THE CDU:S AND DETERMINES THE RR MODE.
022812,001616:                                                                                          	#       INITIALLY, CONTROL IS TRANSFERRED TO RRZEROSB FOR THE
022813,001617:                                                                                          	#       ACTUAL TURN-ON SEQUENCE.  UPON RETURN THE PROGRAM
022814,001618:                                                                                          	#       WAITS 1 SECOND BEFORE REMOVING THE TURN-ON FLAG
022815,001619:                                                                                          	#       (RADMODES BIT1) SO THE REPOSITION ROUTINE WON:T
022816,001620:                                                                                          	#       INITIATE PROGRAM ALARM 00501.  A CHECK IS THEN MADE
022817,001621:                                                                                          	#       TO SEE IF A PROGRAM IS USING THE RR (STATE BIT 7).  IF
022818,001622:                                                                                          	#       SO, THE PROGRAM EXITS TO ENDRADAR SO THAT THE RR CDU
022819,001623:                                                                                          	#       FAIL FLAG (RADMODES BIT 7) CAN BE CHECKED BEFORE
022820,001624:                                                                                          	#       RETURNING TO THE WAITING PROGRAM.  IF NOT, THE PROGRAM EXITS
022821,001625:                                                                                          	#       TO TASKOVER.
022822,001626: 
022823,001627:                                                                                          	# CALLING SEQUENCE:  WAITLIST TASK FROM RRAUTCHK IF THE RR POWER ON AUTO
022824,001628:                                                                                          	# BIT (CHAN 33 BIT 2) CHANGES TO 0 AND NO PROGRAM WAS USING 
022825,001629:                                                                                          	# THE RR (STATE BIT 7).
022826,001630: 
022827,001631:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:
022828,001632: 
022829,001633:                                                                                          	#       RADMODES, STATE
022830,001634: 
022831,001635:                                                                                          	# SUBROUTINES CALLED_  RRZEROSB, FIXDELAY, TASKOVER, ENDRADAR
022832,001636: 
022833,001637:                                                                                          	# JOBS OR TASKS INITIATED_
022834,001638:                                                                                          	#       
022835,001639:                                                                                          	#       NONE
022836,001640: 
022837,001641:                                                                                          	# ALARMS_  NONE (SEE RRZEROSB)
022838,001642: 
022839,001643:                                                                                          	# EXIT_  TASKOVER, ENDRADAR (WAITING PROGRAM)
022840,001644: 

064537,000359:                                                                                          	# SUBROUTINE:   DVOVSUB
064538,000360:                                                                                          	# AUTHOR:       C. WORK, MOD 0 12 JUNE 68
064539,000361:                                                                                          	# PURPOSE:      THIS SUBROUTINE PROVIDES A SINGLE-PRECISION MACHINE LANGUAGE DIVISION OPERATION WHICH RETURNS
064540,000362:                                                                                          	#               (1) THE QUOTIENT, IF THE DIVISION WAS NORMAL.
064541,000363:                                                                                          	#               (2) NEGMAX, IF THE QUOTIENT WAS IMPROPER AND NEGATIVE.
064542,000364:                                                                                          	#               (3) POSMAX, IF THE QUOTIENT WAS IMPROPER AND POSITIVE OR IF THERE WAS A ZERO DIVISOR.
064543,000365:                                                                                          	#               THE CALLING PROGRAM IS PRESUMED TO BE A JOB IN THE F BANK WHICH CONTAINS DVOVSUB.  E BANK MUST BE 6.
064544,000366:                                                                                          	#               THE DIVISOR FOR THIS ROUTINE MAY BE IN EITHER FIXED OR ERASABLE STORAGE.  SIGN AGREEMENT IS
064545,000367:                                                                                          	#               ASSUMED BETWEEN THE TWO HALVES OF THE DIVIDEND.  (THIS IS CERTAIN IF THE A AND L REGISTERS ARE THE RE-
064546,000368:                                                                                          	#               SULT OF A MULTIPLICATION OPERATION.)
064547,000369:                                                                                          	# CALL SEQUENCE:
064548,000370:                                                                                          	#                       L       TC      DVOVSUB
064549,000371:                                                                                          	#                       L +1    ADRES   (DIVISOR)
064550,000372:                                                                                          	#                       L +2    RETURN HERE, WITH RESULT IN A,L
064551,000373:                                                                                          	# INPUT:        DIVIDEND IN A,L (SIGN AGREEMENT ASSUMED), DIVISOR IN LOCATION DESIGNATED BY "ADRES".
064552,000374:                                                                                          	#               DIVISOR MAY BE IN THE DVOVSUB FBANK,FIXED-FIXED FBANK,EBANK 6, OR UNSWITCHED ERASABLE.
064553,000375:                                                                                          	# OUTPUT:       QUOTIENT AND REMAINDER, OR POSMAX (NEGMAX), WHICHEVER IS APPROPRIATE.
064554,000376:                                                                                          	# DEBRIS:       SCRATCHX,SCRATCHY,SCRATCHZ,A,L  (NOTE: SCRATCHX,Y,Z ARE EQUATED TO MPAC +4,+5, AND +6.)
064555,000377:                                                                                          	# ABORTS OR ALARMS:  NONE
064556,000378:                                                                                          	# EXITS:        TO THE CALL POINT +2.
064557,000379:                                                                                          	# SUBROUTINES CALLED:  NONE.
064558,000380: 
064559,000381: 20,2776           54161        DVOVSUB            TS       SCRATCHY                      	# SAVE UPPER HALF OF DIVIDEND
064560,000382: 20,2777           54160                           TS       SCRATCHX                      	#
064561,000383: 20,3000           50002                           INDEX    Q                             	# OBTAIN ADDRESS OF DIVISOR.
064562,000384: 20,3001           30000                           CA       0                             	#
064563,000385: 20,3002           24002                           INCR     Q                             	# STEP Q FOR PROPER RETURN SEQUENCE.
064564,000386: 20,3003           50000                           INDEX    A                             	#
064565,000387: 20,3004           30000                           CA       0                             	# PICK UP THE DIVISOR.
064566,000388: 20,3005           00006                           EXTEND                                 	# RETURN POSMAX FOR A ZERO DIVISOR.
064567,000389: 20,3006           13035                           BZF      MAXPLUS                       	#
064568,000390: 
064569,000391: 20,3007           54162                           TS       SCRATCHZ                      	# STORE DIVISOR.
064570,000392: 

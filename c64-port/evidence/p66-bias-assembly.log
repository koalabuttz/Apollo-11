017634,001155:                                                                                          	# NOUN TABLES
017635,001156: 
017636,001157:                                                                                          	# NOUN CODE L/40, NORMAL NOUN CASE.  NOUN CODE G/E 40, MIXED NOUN CASE.
017637,001158:                                                                                          	# FOR NORMAL CASE, NNADTAB CONTAINS ONE       ECADR     FOR EACH NOUN.
017638,001159:                                                                                          	# +0 INDICATES NOUN NOT USED.   - ENTRY INDICATES MACHINE CADR (E OR F) TO
017639,001160:                                                                                          	# BE SPECIFIED. -1 INDICATES CHANNEL TO BE SPECIFIED.  -0 INDICATES AUGMENT
017640,001161:                                                                                          	# OF LAST MACHINE CADR SUPPLIED.
017641,001162: 
017642,001163:                                                                                          	# FOR MIXED CASE, NNADTAB CONTAINS ONE INDIRECT ADDRESS (IDADDREL) IN LOW
017643,001164:                                                                                          	# 10 BITS, AND THE COMPONENT CODE NUMBER IN THE HIGH 5 BITS.
017644,001165: 
017645,001166:                                                                                          	# NNTYPTAB IS A PACKED TABLE OF THE FORM MMMMMNNNNNPPPPP.
017646,001167: 
017647,001168:                                                                                          	# FOR THE NORMAL CASE,  M-S ARE THE COMPONENT CODE NUMBER.
017648,001169:                                                                                          	#                       N-S ARE THE SF ROUTINE CODE NUMBER.
017649,001170:                                                                                          	#                       P-S ARE THE SF CONSTANT CODE NUMBER.
017650,001171: 
017651,001172:                                                                                          	# MIXED CASE,           M-S ARE THE SF CONSTANT3 CODE NUMBER    3 COMPONENT CASE
017652,001173:                                                                                          	#                       N-S ARE THE SF CONSTANT2 CODE NUMBER
017653,001174:                                                                                          	#                       P-S ARE THE SF CONSTANT1 CODE NUMBER
017654,001175:                                                                                          	#                       N-S ARE THE SF CONSTANT2 CODE NUMBER    2 COMPONENT CASE
017655,001176:                                                                                          	#                       P-S ARE THE SF CONSTANT1 CODE NUMBER
017656,001177:                                                                                          	#                       P-S ARE THE SF CONSTANT1 CODE NUMBER    1 COMPONENT CASE
017657,001178: 
017658,001179:                                                                                          	# THERE IS ALSO AN INDIRECT ADDRESS TABLE (IDADDTAB) FOR MIXED CASE ONLY.
017659,001180:                                                                                          	# EACH ENTRY CONTAINS ONE ECADR.    IDADDREL IS THE RELATIVE ADDRESS OF
017660,001181:                                                                                          	# THE FIRST OF THESE ENTRIES.
017661,001182:                                                                                          	# THERE IS ONE ENTRY IN THIS TABLE FOR EACH COMPONENT OF A MIXED NOUN
017662,001183:                                                                                          	# THEY ARE LISTED IN ORDER OF ASCENDING K.
017663,001184: 
017664,001185:                                                                                          	# THERE IS ALSO A SCALE FACTOR ROUTINE NUMBER TABLE (RUTMXTAB) FOR MIXED
017665,001186:                                                                                          	# CASE ONLY.  THERE IS ONE ENTRY PER MIXED NOUN.  THE FORM IS,
017666,001187: 
017667,001188:                                                                                          	#       QQQQQRRRRRSSSSS
017668,001189: 
017669,001190:                                                                                          	# Q-S ARE THE SF ROUTINE 3 CODE NUMBER          3 COMPONENT CASE
017670,001191:                                                                                          	# R-S ARE THE SF ROUTINE 2 CODE NUMBER
017671,001192:                                                                                          	# S-S ARE THE SF ROUTINE 1 CODE NUMBER
017672,001193:                                                                                          	# R-S ARE THE SF ROUTINE 2 CODE NUMBER          2 COMPONENT CASE
017673,001194:                                                                                          	# S-S ARE THE SF ROUTINE 1 CODE NUMBER
017674,001195: 
017675,001196:                                                                                          	# IN OCTAL DISPLAY AND LOAD (OCT OR DEC) VERBS, EXCLUDE USE OF VERBS WHOSE
017676,001197:                                                                                          	# COMPONENT NUMBER IS GREATER THAN THE NUMBER OF COMPONENTS IN NOUN.
017677,001198:                                                                                          	# (ALL MACHINE ADDRESS TO BE SPECIFIED NOUNS ARE 3 COMPONENT.)
017678,001199: 
017679,001200:                                                                                          	# IN MULTI-COMPONENT LOAD VERBS, NO MIXING OF OCTAL AND DECIMAL DATA
017680,001201:                                                                                          	# COMPONENT WORDS IS ALLOWED. ALARM IF VIOLATION.
017681,001202: 
017682,001203:                                                                                          	# IN DECIMAL LOADS OF DATA, 5 NUMERICAL CHARACTERS MUST BE KEYED IN
017683,001204:                                                                                          	# BEFORE EACH ENTER. IF NOT, ALARM.
017684,001205: 

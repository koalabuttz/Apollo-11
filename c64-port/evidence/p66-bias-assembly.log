048672,000092:                                                                                          	# ..... R-TO-RP SUBROUTINE .....
048673,000093:                                                                                          	# SUBROUTINE TO CONVERT R (VECTOR IN REFERENCE COORD. SYSTEM) TO RP
048674,000094:                                                                                          	# (VECTOR IN PLANETARY COORD SYSTEM) EITHER EARTH-FIXED OR MOON-FIXED
048675,000095: 
048676,000096:                                                                                          	#       RP = M(T) * (R - L X R)
048677,000097: 
048678,000098:                                                                                          	# CALLING SEQUENCE
048679,000099:                                                                                          	#       L       CALL
048680,000100:                                                                                          	#       L+1             R-TO-RP
048681,000101: 
048682,000102:                                                                                          	# SUBROUTINES USED
048683,000103:                                                                                          	#       EARTHMX, MOONMX, EARTHL
048684,000104: 
048685,000105:                                                                                          	# INPUT
048686,000106:                                                                                          	#       MPAC = 0 FOR EARTH, NON-ZERO FOR MOON
048687,000107:                                                                                          	#       0-5D = R VECTOR
048688,000108:                                                                                          	#       6-7D = TIME
048689,000109: 
048690,000110:                                                                                          	#       ITEMS AVAILABLE FROM LAUNCH DATA
048691,000111:                                                                                          	#               504LM = THE LIBRATION VECTOR L OF THE MOON AT TIME TIMSUBL, EXPRESSED
048692,000112:                                                                                          	#                       IN THE MOON-FIXED COORD. SYSTEM   RADIANS B0
048693,000113: 
048694,000114:                                                                                          	#       ITEMS NECESSARY FOR SUBROUTINES USED (SEE DESCRIPTION OF SUBR.)
048695,000115: 
048696,000116:                                                                                          	# OUTPUT
048697,000117:                                                                                          	#       MPAC = RP VECTOR METERS B-29 FOR EARTH, B-27 FOR MOON
048698,000118: 
048699,000119: 24,3670           46020        R-TO-RP            STQ      BHIZ                          	#
048700,000120: 24,3671           00050                                    RPREXIT                       	#
048701,000121: 24,3672           51712                                    RTORPA                        	#

003735,000168: 26,2022  0000002               QCHAN              EQUALS   Q                             	#
003736,000169: 26,2022                        HISCALAR           EQUALS   3                             	#
003737,000170: 26,2022                        LOSCALAR           EQUALS   4                             	#
003738,000171: 26,2022                        CHAN5              EQUALS   5                             	#
003739,000172: 26,2022                        CHAN6              EQUALS   6                             	#
003740,000173: 26,2022                        SUPERBNK           EQUALS   7                             	# SUPER-BANK.
003741,000174: 26,2022                        OUT0               EQUALS   10                            	#
003742,000175: 26,2022                        DSALMOUT           EQUALS   11                            	#
003743,000176: 26,2022                        CHAN12             EQUALS   12                            	#

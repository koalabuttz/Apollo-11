020918,000032: 
020920,000034:                                                                                          	# SUBROUTINE NAME: R05 - S-BAND ANTENNA FOR LM
020921,000035: 
020922,000036:                                                                                          	# MOD0 BY T. JAMES
020923,000037:                                                                                          	# MOD1 BY P. SHAKIR
020924,000038: 
020925,000039:                                                                                          	# FUNCTIONAL DESCRIPTION
020926,000040: 
020927,000041:                                                                                          	# THE S-BAND ANTENNA ROUTINE, R05, COMPUTES AND DISPLAYS THE PITCH AND
020928,000042:                                                                                          	# YAW ANTENNA GIMBAL ANGLES REQUIRED TO POINT THE LM STEERABLE ANTENNA
020929,000043:                                                                                          	# TOWARD THE CENTER OF THE EARTH.  THIS ROUTINE IS SELECTED BY THE ASTRO-
020930,000044:                                                                                          	# NAUT VIA DSKY ENTRY DURING COASTING FLIGHT OR WHEN THE LM IS ON THE MOON
020931,000045:                                                                                          	# SURFACE.  THE EARTH OR MOON REFERENCE COORDINATE SYSTEM IS USED DEPENDING
020932,000046:                                                                                          	# ON WHETHER THE LM IS ABOUT TO ENTER OR HAS ALREADY ENTERED THE MOON
020933,000047:                                                                                          	# SPHERE OF INFLUENCE, RESPECTIVELY
020934,000048: 
020935,000049:                                                                                          	# TO CALL SUBROUTINE, ASTRONAUT KEYS IN V 64 E
020936,000050: 
020937,000051:                                                                                          	# SUBROUTINES CALLED -
020938,000052:                                                                                          	#       R02BOTH
020939,000053:                                                                                          	#       INTPRET
020940,000054:                                                                                          	#       LOADTIME
020941,000055:                                                                                          	#       LEMCONIC
020942,000056:                                                                                          	#       LUNPOS
020943,000057:                                                                                          	#       CDUTRIG
020944,000058:                                                                                          	#       *SMNB*
020945,000059:                                                                                          	#       BANKCALL
020946,000060:                                                                                          	#       B5OFF
020947,000061:                                                                                          	#       ENDOFJOB
020948,000062:                                                                                          	#       BLANKET
020949,000063: 
020950,000064:                                                                                          	# RETURNS WITH
020951,000065:                                                                                          	#       PITCH ANGLE IN PITCHANG         REV. B0
020952,000066:                                                                                          	#       YAW ANGLE IN YAWANG             REV. B0
020953,000067: 
020954,000068:                                                                                          	# ERASABLES USED
020955,000069:                                                                                          	#       PITCHANG
020956,000070:                                                                                          	#       YAWANG
020957,000071:                                                                                          	#       RLM
020958,000072:                                                                                          	#       VAC AREA
020959,000073: 
020960,000074: 41,3731                                           BANK     41                            	#
020961,000075: 42,2000                                           SETLOC   SBAND                         	#
020962,000076: 42,2000                                           BANK                                   	#
020963,000077: 

059440,000104:                                                                                          	#   .               SCALING IS SAME AS INTERNAL REGISTERS.
059441,000105: 
059442,000106:                                                                                          	#  V73EXXXXXEXXXXXE (OCTAL CLOCK INCREMENT) DOUBLE PRECISION OCTAL TIME
059443,000107:                                                                                          	#                   INCREMENT XXXXX XXXXX, IS ADDED TO THE AGC CLOCK, IN
059444,000108:                                                                                          	#                   CENTISECONDS SCALED AT (2)28.
059445,000109:                                                                                          	#                   THIS LOAD IS THE OCTAL EQUIVALENT OF V55.

007925,000043:                                                                                          	# SPECIAL DOWNLINK OP CODES
007926,000044:                                                                                          	#       OP CODE         ADDRESS(EXAMPLE)        SENDS..                 BIT 15          BITS 14-12      BITS 11
007927,000045:                                                                                          	#                                                                                                            -0
007928,000046:                                                                                          	#       ------          ----------              ----------              ------          ----------      -------
007929,000047:                                                                                          	#                                                                                                            --
007930,000048:                                                                                          	#       1DNADR          TIME2                   (2 AGC WDS)             0               0               ECADR
007931,000049:                                                                                          	#       2DNADR          TEPHEM                  (4 AGC WDS)             0               1               ECADR
007932,000050:                                                                                          	#       3DNADR          VGBODY                  (6 AGC WDS)             0               2               ECADR
007933,000051:                                                                                          	#       4DNADR          STATE                   (8 AGC WDS)             0               3               ECADR
007934,000052:                                                                                          	#       5DNADR          UPBUFF                  (10 AGC WDS)            0               4               ECADR
007935,000053:                                                                                          	#       6DNADR          DSPTAB                  (12 AGC WDS)            0               5               ECADR
007936,000054:                                                                                          	#       DNCHAN          30                      CHANNELS                0               7               CHANNEL
007937,000055:                                                                                          	#                                                                                                       ADDRESS
007938,000056:                                                                                          	#       DNPTR           NEXTLIST                POINTS TO NEXT          0               6               ADRES
007939,000057:                                                                                          	#                                               LIST.
007940,000058: 
007941,000059:                                                                                          	# DOWNLIST FORMAT DEFINITIONS AND RULES-
007942,000060:                                                                                          	# 1. END OF A LIST = -XDNADR (X = 1 TO 6), -DNPTR, OR -DNCHAN.
007943,000061:                                                                                          	# 2. SNAPSHOT SUBLIST = LIST WHICH STARTS WITH A -1DNADR.
007944,000062:                                                                                          	# 3. SNAPSHOT SUBLIST CAN ONLY CONTAIN 1DNADRS.
007945,000063:                                                                                          	# 4. TIME2 1DNADR MUST BE LOCATED IN THE CONTROL LIST OF A DOWNLIST.
007946,000064:                                                                                          	# 5. ERASABLE DOWN TELEMETRY WORDS SHOULD BE GROUPED IN SEQUENTIAL
007947,000065:                                                                                          	#    LOCATIONS AS MUCH AS POSSIBLE TO SAVE STORAGE USED BY DOWNLINK LISTS.
007948,000066: 
007949,000067: 05,2065                                           COUNT*   $$/DLIST                      	#
007950,000068: 05,2065                        ERASZERO           EQUALS   7                             	#
007951,000069: 05,2065  0000007               UNKNOWN            EQUALS   ERASZERO                      	#
007952,000070: 05,2065  0000007               SPARE              EQUALS   ERASZERO                      	# USE SPARE TO INDICATE AVAILABLE SPACE
007953,000071: 05,2065           77340        LOWIDCOD           OCT      77340                         	# LOW ID CODE
007954,000072: 
007955,000073: 05,2066  05,2172               NOMDNLST           EQUALS   LMCSTADL                      	# FRESH START AND POST P27 DOWNLIST
007956,000074: 
007957,000075: 05,2066  05,2407               AGSLIST            EQUALS   LMAGSIDL                      	#
007958,000076: 
007959,000077: 05,2066  05,2407               UPDNLIST           EQUALS   LMAGSIDL                      	# UPDATE PROGRAM (P27) DOWNLIST
007960,000078: 

020081,003602:    4470           34755                           CAF      ZERO                          	#
020082,003603:    4471           57043                           XCH      DSPLIST                       	#
020083,003604:    4472           05137                           TC       JOBWAKE                       	#
020084,003605:    4473           00003        RELDSP2            RELINT                                 	#
020085,003606:    4474           44747                           CS       BIT5                          	# TURN OFF KEY RELEASE LIGHT
020086,003607:    4475           00006                           EXTEND                                 	# (BIT 5 OF CHANNEL 11)
020087,003608:    4476           03011                           WAND     DSALMOUT                      	#
020088,003609:    4477           34755                           CAF      ZERO                          	#
020089,003610:    4500           55012                           TS       DSPLOCK                       	#
020090,003611:    4501           00144                           TC       RELRET                        	#
020091,003612:    4502           56002        RELDSP1            XCH      Q                             	# SET DSPLOCK TO +0. NO DSPLIST SEARCH.
020092,003613:    4503           54144                           TS       RELRET                        	# TURN KEY RLSE LIGHT OFF IF DSPLIST IS
020093,003614:                                                                                          	# EMPTY. LEAVE KEY RLSE LIGHT ALONE IF 
020094,003615:                                                                                          	# DSPLIST IS NOT EMPTY.
020095,003616:    4504           11043                           CCS      DSPLIST                       	#

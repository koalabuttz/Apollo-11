053574,000122: 23,3336           14025                           STODL    THETA                         	# X = ARCSIN(SIN) WITH SIGN(SIN)
053575,000123: 23,3337           00021                                    COSTH                         	#
053576,000124: 23,3340           77640                           BMN                                    	#
053577,000125: 23,3341           47344                                    TRIG2                         	# IF (135,-135)

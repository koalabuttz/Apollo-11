024353,003157:                                                                                          	# PROGRAM NAME_  LPS20.1 VECTOR EXTRAPOLATION AND LOS COMPUTATION
024354,003158:                                                                                          	# MOD. NO. 2    BY J.D. COYNE   SDC     DATE 12-7-66
024355,003159: 
024356,003160:                                                                                          	# FUNCTIONAL DESCRIPTION_
024357,003161:                                                                                          	#       1)      EXTRAPOLATE THE LEM AND CSM VECTORS IN ACCORDANCE WITH THE TIME REFERED TO IN CALLER + 1.
024358,003162:                                                                                          	#       2)      COMPUTES THE LOS VECTOR TO THE CSM, CONVERTS IT TO STABLE MEMBER COORDINATES AND STORES IT IN RRTARGET.
024359,003163:                                                                                          	#       3)      COMPUTES THE MAGNITUDE OF THE LOS VECTOR AND STORES IT IN MLOSV
024360,003164: 
024361,003165:                                                                                          	# CALLING SEQUENCE      CALL
024362,003166:                                                                                          	#                               LPS20.1
024363,003167: 

059144,000060:    5577           04007                           ROR      SUPERBNK                      	# ADD SUPER BITS.
059145,000061:    5600           55364                           TS       ALMCADR    +1                 	#
059146,000062: 
059147,000063:    5601           30002        LARMENT            CA       Q                             	# STORE RETURN FOR ALARM
059148,000064:    5602           54061                           TS       ITEMP1                        	#
059149,000065: 
059150,000066:    5603           10375        CHKFAIL1           CCS      FAILREG                       	# IS ANYTHING IN FAILREG

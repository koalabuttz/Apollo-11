015124,000918: 22,2643           00007                                    6                             	#
015125,000919: 22,2644           77604                           BOVB                                   	#
015126,000920: 22,2645           21712                                    SIGNMPAC                      	#
015127,000921: 22,2646           16247                           STODL    KEL        +14D               	# UY UZ(1-COS(A)) +UX SIN(A)
015128,000922: 22,2647           62421                           BDSU     SL2                           	#
015129,000923: 22,2650           77604                           BOVB                                   	#
015130,000924: 22,2651           21712                                    SIGNMPAC                      	#
015131,000925: 22,2652           02243                           STORE    KEL        +10D               	# UY UZ (1-COS(A)) -UX SIN(A)
015132,000926: 22,2653           77616                           RVQ                                    	#
015133,000927: 
015134,000928:                                                                                          	# DIRECTION COSINE MATRIX TO CDU ANGLE ROUTINE
015135,000929:                                                                                          	# X1 CONTAINS THE COMPLEMENT OF THE STARTING ADDRESS FOR MATRIX (SCALED 2)
015136,000930:                                                                                          	# LEAVES CDU ANGLES SCALED 2PI IN V(MPAC)
015137,000931:                                                                                          	# COS(MGA) WILL BE LEFT IN S1 (SCALED 1)
015138,000932: 
015139,000933:                                                                                          	# THE DIRECTION COSINE MATRIX RELATING S/C AXES TO STABLE MEMBER AXES CAN BE WRITTEN AS***
015140,000934: 
015141,000935:                                                                                          	#       C  = COS(THETA) COS(PSI)
015142,000936:                                                                                          	#        0
015143,000937: 
015144,000938:                                                                                          	#       C  = -COS(THETA) SIN(PSI) COS(PHI) + SI (THETA) SIN(PHI)
015145,000939:                                                                                          	#        1
015146,000940: 
015147,000941:                                                                                          	#       C  = COS(THETA) SIN(PSI) SIN(PHI) + S N(THETA) COS(PHI)
015148,000942:                                                                                          	#        2
015149,000943: 
015150,000944:                                                                                          	#       C  = SIN(PSI)
015151,000945:                                                                                          	#        3
015152,000946: 
015153,000947:                                                                                          	#       C  = COS(PSI) COS(PHI)
015154,000948:                                                                                          	#        4
015155,000949: 
015156,000950:                                                                                          	#       C  = -COS(PSI) SIN(PHI)
015157,000951:                                                                                          	#        5
015158,000952: 
015159,000953:                                                                                          	#       C  = -SIN(THETA) COS(PSI)
015160,000954:                                                                                          	#        6
015161,000955: 
015162,000956:                                                                                          	#       C  = SIN(THETA) SIN(PSI) COS(PHI) + COS THETA) SIN(PHI)
015163,000957:                                                                                          	#        7
015164,000958: 
015165,000959:                                                                                          	#       C  = -SIN(THETA) SIN(PSI) SIN(PHI) + CO (THETA)COS(PHI)
015166,000960:                                                                                          	#        8
015168,000962: 
015169,000963:                                                                                          	# WHERE PHI = OGA
015170,000964:                                                                                          	#       THETA = IGA
015171,000965:                                                                                          	#       PSI = MGA
015172,000966: 
015173,000967: 22,2654           67543        DCMTOCDU           DLOAD*   ARCSIN                        	#
015174,000968: 22,2655           00007                                    6,1                           	#
015175,000969: 22,2656           71406                           PUSH     COS                           	# PD +0         PSI
015176,000970: 22,2657           41152                           SL1      BOVB                          	#
015177,000971: 22,2660           21712                                    SIGNMPAC                      	#
015178,000972: 22,2661           00051                           STORE    S1                            	#
015179,000973: 22,2662           57543                           DLOAD*   DCOMP                         	#
015180,000974: 22,2663           00015                                    12D,1                         	#
015181,000975: 22,2664           67471                           DDV      ARCSIN                        	#
015182,000976: 22,2665           00051                                    S1                            	#
015183,000977: 22,2666           51123                           PDDL*    BPL                           	# PD +2         THETA
015184,000978: 22,2667           00001                                    0,1                           	# MUST CHECK THE SIGN OF COS(THETA)
015185,000979: 22,2670           44702                                    OKTHETA                       	# TO DETERMINE THE PROPER QUADRANT
015186,000980: 22,2671           57545                           DLOAD    DCOMP                         	#
015187,000981: 22,2672           43244                           BPL      DAD                           	#
015188,000982: 22,2673           44677                                    SUHALFA                       	#
015189,000983: 22,2674           06520                                    DPHALF                        	#
015190,000984: 22,2675           77650                           GOTO                                   	#
015191,000985: 22,2676           44701                                    CALCPHI                       	#
015192,000986: 22,2677           77625        SUHALFA            DSU                                    	#
015193,000987: 22,2700           06520                                    DPHALF                        	#
015194,000988: 22,2701           77606        CALCPHI            PUSH                                   	#
015195,000989: 22,2702           57543        OKTHETA            DLOAD*   DCOMP                         	#
015196,000990: 22,2703           00013                                    10D,1                         	#
015197,000991: 22,2704           67471                           DDV      ARCSIN                        	#
015198,000992: 22,2705           00051                                    S1                            	#
015199,000993: 22,2706           51123                           PDDL*    BPL                           	# PUSH DOWN PHI
015200,000994: 22,2707           00011                                    8D,1                          	#
015201,000995: 22,2710           44722                                    OKPHI                         	#
015202,000996: 22,2711           57545                           DLOAD    DCOMP                         	# PUSH UP PHI
015203,000997: 22,2712           43244                           BPL      DAD                           	#
015204,000998: 22,2713           44717                                    SUHALFAP                      	#
015205,000999: 22,2714           06520                                    DPHALF                        	#
015206,001000: 22,2715           77650                           GOTO                                   	#
015207,001001: 22,2716           44723                                    VECOFANG                      	#
015208,001002: 22,2717           52025        SUHALFAP           DSU      GOTO                          	#
015209,001003: 22,2720           06520                                    DPHALF                        	#
015210,001004: 22,2721           44723                                    VECOFANG                      	#
015211,001005: 22,2722           77745        OKPHI              DLOAD                                  	# PUSH UP PHI
015212,001006: 22,2723           43466        VECOFANG           VDEF     RVQ                           	#
015214,001008:                                                                                          	# ROUTINES FOR TERMINATING THE AUTOMATIC MANEUVER AND RETURNING TO USER
015215,001009: 
015216,001010: 22,2724           77776        TOOBADF            EXIT                                   	#
015217,001011: 22,2725           05567                           TC       ALARM                         	#
015218,001012: 22,2726           00401                           OCT      00401                         	#
015219,001013: 
015220,001014: 22,2727           12732                           TCF      NOGO                          	# DO NOT ZERO ATTITUDE ERRORS
015221,001015: 
015222,001016: 22,2730           04616                           TC       BANKCALL                      	#
015223,001017: 22,2731           40153                           CADR     ZATTEROR                      	# ZERO ATTITUDE ERRORS
015224,001018: 
015225,001019: 22,2732           04616        NOGO               TC       BANKCALL                      	#
015226,001020: 22,2733           40165                           CADR     STOPRATE                      	# STOP RATES
015227,001021: 
015228,001022: 22,2734           34752                           CAF      TWO                           	#
015229,001023: 22,2735           00004                           INHINT                                 	# ALL RETURNS ARE NOW MADE VIA GOODEND
015230,001024: 22,2736           05203                           TC       WAITLIST                      	#
015231,001025: 22,2737  E6,1676                                  EBANK=   BCDU                          	#
015232,001026: 22,2737           03234 44066                     2CADR    GOODMANU                      	#
015233,001027: 
015234,001028: 22,2741           15155                           TCF      ENDOFJOB                      	#
015235,001029: 
015236,001030: 22,2742           77776        TOOBADI            EXIT                                   	#
015237,001031: 22,2743           12732                           TCF      NOGO                          	#
015238,001032: 
015239,001033: 
(End of include-file ATTITUDE_MANEUVER_ROUTINE.agc, resuming MAIN.agc)

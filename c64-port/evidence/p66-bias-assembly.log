015498,000177: 
015499,000178: 22,3170           40025        CONTMANU           CS       TIME1                         	# RESET FOR NEXT DCDU UPDATE
015500,000179: 22,3171           61706                           AD       NEXTIME                       	#
015501,000180: 22,3172           10000                           CCS      A                             	#
015502,000181: 22,3173           64753                           AD       ONE                           	#
015503,000182: 22,3174           13177                           TCF      MANUCALL                      	#
015504,000183: 22,3175           64735                           AD       NEGMAX                        	#

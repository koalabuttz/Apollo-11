007503,001165:                                                                                          	# EVERY 480 MILLISECONDS FROM RRAUTCHK (VIA T4RUPT) UNLESS A
007504,001166:                                                                                          	# TURN-ON SEQUENCE HAS JUST BEEN INITIATED.

023121,001925:                                                                                          	# PROGRAM NAMES_        RRTONLY, RRSONLY
023122,001926: 
023123,001927:                                                                                          	# FUNCTIONAL DESCRIPTION_
023124,001928: 
023125,001929:                                                                                          	#       RRTONLY AND RRSONLY ARE SUBROUTINES FOR DOING SINGLE AXIS
023126,001930:                                                                                          	#       RR MANEUVERS FOR REMODE AND REPOSITION.  IT DRIVES TO
023127,001931:                                                                                          	#       WITHIN 1 DEGREE.  INITIALLY, AT RR1AX2, THE REMODE AND REPOSITION
023128,001932:                                                                                          	#       FLAGS (RADMODES BITS 14, 11) ARE CHECKED.  IF BOTH EXIST,
023129,001933:                                                                                          	#       THE PROGRAM EXITS TO REPOSRPT (SEE DORREPOS).  THIS INDICATES
023130,001934:                                                                                          	#       THAT SOMEONE POSSIBLY REQUESTED A DESIGNATE (RADMODES BIT 10)
023131,001935:                                                                                          	#       WHICH REQUIRES A REMODE (RADMODES BIT 14) AND THAT A
023132,001936:                                                                                          	#       REPOSITION IS IN PROGRESS (RADMODES BIT 11).  IF NONE
023133,001937:                                                                                          	#       OR ONLY ONE OF THE FLAGS EXIST, REMODE OR REPOSITION, MAGSUB
023134,001938:                                                                                          	#       IS CALLED TO SEE IF THE APPROPRIATE ANGLE IS WITHIN 1 DEGREE.  IF YES,
023135,001939:                                                                                          	#       CONTROL RETURNS TO THE CALLING ROUTINE.  IF NOT, CONTROL IS
023136,001940:                                                                                          	#       TRANSFERRED TO RROUT FOR SINGLE AXIS MANEUVERS WITH THE OTHER
023137,001941:                                                                                          	#       ANGLE SET = 0.  FOLLOWING A .5 SECOND WAIT, THE ABOVE PROCEDURE IS
023138,001942:                                                                                          	#       REPEATED.
023139,001943: 
023140,001944:                                                                                          	# CALLING SEQUENCE:     L-1     CAF     *ANGLE*         (DESIRED ANGLE SCALED PI)
023141,001945:                                                                                          	#                       L       TC      RRTONLY         (TRUNNION ONLY)
023142,001946:                                                                                          	#                       RRSONLY                         (SHAFT ONLY)
023143,001947:                                                                                          	#                       RRTONLY IS CALLED BY PREPOS29;
023144,001948:                                                                                          	#                       RRTONLY AND RRSONLY ARE CALLED BY DORREPOS AND REMODE
023145,001949: 

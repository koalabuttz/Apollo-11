042871,000026:                                                                                          	##
042872,000027:                                                                                          	## Notations on the hardcopy document read, in part:
042873,000028:                                                                                          	##
042874,000029:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
042875,000030:                                                                                          	##      16:27 JULY 14, 1969 
042876,000031: 
042878,000033:                                                                                          	# NAME - LSPOS - LOCATE SUN AND MOON                    DATE - 25 OCT 67
042879,000034:                                                                                          	# MOD NO. 1
042880,000035:                                                                                          	# MOD BY NEVILLE                                        ASSEMBLY SUNDANCE
042881,000036: 
042882,000037:                                                                                          	# FUNCTIONAL DESCRIPTION
042883,000038: 
042884,000039:                                                                                          	#        COMPUTES UNIT POSITION VECTOR OF THE SUN AND MOON IN THE BASIC REFERENCE SYSTEM. THE SUN VECTOR S IS
042885,000040:                                                                                          	# LOCATED VIA TWO ANGLES. THE FIRST ANGLE(OBLIQUITY) IS THE ANGLE BETWEEN THE EARTH EQUATOR AND THE ECLIPTIC. THE
042886,000041:                                                                                          	# SECOND ANGLE IS THE LONGITUDE OF THE SUN MEASURED IN THE ECLIPTIC.
042887,000042:                                                                                          	# THE POSITION VECTOR OF THE SUN IS
042888,000043:                                                                                          	#       -
042889,000044:                                                                                          	#       S = (COS(LOS), COS(OBL)*SIN(LOS), SIN(OBL)*SIN(LOS)), WHERE
042890,000045: 
042891,000046:                                                                                          	#       LOS = LOS +LOS *T-(C *SIN(2PI*T)/365.24 +C *COS(2PI*T)/365.24)
042892,000047:                                                                                          	#                0    R     0                     1
042893,000048:                                                                                          	#       LOS  (RAD) IS THE LONGITUDE OF THE SUN FOR MIDNIGHT JUNE 30TH OF THE PARTICULAR YEAR.
042894,000049:                                                                                          	#          0
042895,000050:                                                                                          	#       LOS  (RAD/DAY) IS THE MEAN RATE FOR THE PARTICULAR YEAR.
042896,000051:                                                                                          	#          R
042897,000052: 
042898,000053:                                                                                          	# LOS  AND LOS  ARE STORED AS LOSC AND LOSR IN RATESP.
042899,000054:                                                                                          	#    0        R
042900,000055:                                                                                          	# COS(OBL) AND SIN(OBL) ARE STORED IN THE MATRIX KONMAT.
042901,000056: 
042902,000057:                                                                                          	# T, TIME MEASURED IN DAYS (24 HOURS), IS STORED IN TIMEP.
042903,000058: 
042904,000059:                                                                                          	# C  AND C  ARE FUDGE FACTORS TO MINIMIZE THE DEVIATION.  THEY ARE STORED AS ONE CONSTANT (CMOD), SINCE
042905,000060:                                                                                          	#  0      1                               2  2 1/2
042906,000061:                                                                                          	# C *SIN(X)+C *COS(X) CAN BE WRITTEN AS (C +C )   *SIN(X+PHI), WHERE PHI=ARCTAN(C /C ).
042907,000062:                                                                                          	#  0         1                            0  1                                   1  0
042908,000063: 
042909,000064:                                                                                          	# THE MOON IS LOCATED VIA FOUR ANGLES. THE FIRST IS THE OBLIQUITY. THE SECOND IS THE MEAN LONGITUDE OF THE MOON,
042910,000065:                                                                                          	# MEASURED IN THE ECLIPTIC FROM THE MEAN EQUINOX TO THE MEAN ASCENDING NODE OF THE LUNAR ORBIT, AND THEN ALONG THE
042911,000066:                                                                                          	# ORBIT.  THE THIRD ANGLE IS THE ANGLE BETWEEN THE ECLIPTIC AND THE LUNAR ORBIT.  THE FOURTH ANGLE IS THE LONGITUDE
042912,000067:                                                                                          	# OF THE NODE OF THE MOON, MEASURED IN THE LUNAR ORBIT.  LET THESE ANGLES BE OBL,LOM,IM, AND LON RESPECTIVELY.
042913,000068: 
042914,000069:                                                                                          	# THE SIMPLIFIED POSITION VECTOR OF THE MOON IS
042915,000070:                                                                                          	#       -
042916,000071:                                                                                          	#       M=(COS(LOM), COS(OBL)*SIN(LOM)-SIN(OBL)*SIN(IM)*SIN(LOM-LON), SIN(OBL)*SIN(LOM)+COS(OBL)*SIN(IM)*SIN(LOM-LON))
042917,000072: 
042918,000073:                                                                                          	# WHERE
042919,000074:                                                                                          	#       LOM=LOM +LOM *T-(A *SIN 2PI*T/27.5545+A *COS(2PI*T/27.5545)+B *SIN 2PI*T/32+B *COS(2PI*T/32)), AND
042920,000075:                                                                                          	#              0    R     0                    1                     0               1
042921,000076:                                                                                          	#       LON=LON +LON
042922,000077:                                                                                          	#              0    R
042923,000078:                                                                                          	# A , A , B  AND B  ARE STORED AS AMOD AND BMOD (SEE DESCRIPTION OF CMOD, ABOVE).  COS(OBL), SIN(OBL)*SIN(IM),
042924,000079:                                                                                          	#  0   1   0      1
042925,000080:                                                                                          	# SIN(OBL), AND COS(OBL)*SIN(IM) ARE STORED IN KONMAT AS K1, K2, K3 AND K4, RESPECTIVELY.  LOM , LOM , LON , LON                                   
042926,000081:                                                                                          	# ARE STORED AS LOMO, LOMR, LONO, AND LONR IN RATESP.                                         0     R     0     R
042927,000082:                                                                                          	# THE THREE PHIS ARE STORED AS AARG, BARG, AND CARG(SUN).  ALL CONSTANTS ARE UPDATED BY YEAR.
042928,000083: 
042929,000084:                                                                                          	# CALLING SEQUENCE
042931,000086:                                                                                          	#       CALL LSPOS.  RETURN IS VIA CPRET.
042932,000087: 
042933,000088:                                                                                          	# ALARMS OR ABORTS
042934,000089:                                                                                          	#       NONE
042935,000090: 
042936,000091:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
042937,000092:                                                                                          	#       TEPHEM - TIME FROM MIDNIGHT 1 JULY PRECEDING THE LAUNCH TO THE TIME OF THE LAUNCH (WHEN THE AGC CLOCK WENT
042938,000093:                                                                                          	#       TO ZERO).  TEPHEM IS TP WITH UNITS OF CENTI-SECONDS.
042939,000094: 
042940,000095:                                                                                          	#       TIME2 AND TIME1 ARE IN MPAC AND MPAC +1 WHEN PROGRAM IS CALLED.
042941,000096: 
042942,000097:                                                                                          	# OUTPUT
042943,000098:                                                                                          	#       UNIT POSITIONAL VECTOR OF SUN IN VSUN.  (SCALED B-1)
042944,000099:                                                                                          	#       UNIT POSITIONAL VECTOR OF MOON IN VMOON.  (SCALED B-1)
042945,000100: 
042946,000101:                                                                                          	# SUBROUTINES USED
042947,000102:                                                                                          	#       NONE
042948,000103: 

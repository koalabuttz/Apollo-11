025856,004660:                                                                                          	# R29DODES:  RR DESIGNATION LOOP FOR R29
025857,004661: 
025858,004662:                                                                                          	# THIS ROUTINE DOES MUCH THE SAME THING AS DODES, BUT A GREAT DEAL FASTER.  IT TAKES THE NON-UNITIZED LOS VECTOR
025859,004663:                                                                                          	# IN STABLE MEMBER COORDINATES (LOSSM) AND A DELTA-LOS IN SM AXES (LOSVDT/4) WHICH IS 1/2 SEC TIMES LOS VELOCITY,
025860,004664:                                                                                          	# AND DEVELOPS THE SHAFT AND TRUNNION COMMANDS USING SINGLE PRECISION AS MUCH AS POSSIBLE, AND INTERPRETIVE NOT AT
025861,004665:                                                                                          	# ALL.  THE UNIT(LOSSM + LOSVEL * 1 SEC) IS COMPUTED IN DP AND TRANSFORMED TO NAV BASE COORDINATES IN DOUBLE PRE-
025862,004666:                                                                                          	# CISION (USING SP SINES AND COSINES OF CDU ANGLES), AND THE REST IS DONE IN SP.
025863,004667: 
025864,004668:                                                                                          	# THE FUNCTIONAL DIFFERENCE IS THAT R29DODES ALWAYS CLEARS LOSCMFLG WHEN IT ENDS, AND IT STARTS UP THE R29READ
025865,004669:                                                                                          	# TASK WHEN LOCK-ON IS ACHIEVED.
025866,004670: 
025867,004671: 32,2547                                           BANK     32                            	#
025868,004672: 32,2000                                           SETLOC   F2DPS*32                      	#
025869,004673: 32,2000                                           BANK                                   	#
025870,004674: 
025871,004675: 32,2547                                           COUNT*   $$/R29                        	#
025872,004676: 32,2547  E3,1760                                  EBANK=   LOSVDT/4                      	#
025873,004677: 
025874,004678: 32,2547           34753        R29DODES           CA       ONE                           	#
025875,004679: 32,2550           55107                           TS       TANG                          	# INDICATE 1ST PASS THRU VECTOR LOOP.
025876,004680: 32,2551           34756                           CA       FIVE                          	#
025877,004681: 
025878,004682: 32,2552           10000        R29DVBEG           CCS      A                             	# COUNT DOWN BY TWOS IN VECTOR LOOP.
025879,004683: 32,2553           54002                           TS       Q                             	#
025880,004684: 32,2554           11107                           CCS      TANG                          	#

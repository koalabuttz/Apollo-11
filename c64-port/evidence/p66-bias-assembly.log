007242,000904: 06,2654           27302                           ADS      IMODES30                      	#
007243,000905: 
007244,000906: 06,2655           02703                           TC       SETISSW                       	#
007245,000907: 
007246,000908: 06,2656           41302                           CS       IMODES30                      	# IF PIP FAIL DOESNT LIGHT ISS WARNING, DO
007247,000909: 06,2657           74753                           MASK     BIT1                          	# A PROGRAM ALARM IF IMU OPERATING BUT NOT
007248,000910: 06,2660           10000                           CCS      A                             	# CAGED OR BEING TURNED ON.

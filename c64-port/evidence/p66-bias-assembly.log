057557,000170:                                                                                          	#                               CAF     VXXNYY          VXX NYY WILL BE A FLASHING VERB NOUN
057558,000171:                                                                                          	#                               TC      BANKCALL
057559,000172:                                                                                          	#                               CADR    REFLASH
057560,000173:                                                                                          	#                               ...     ...             TERMINATE RETURN
057561,000174:                                                                                          	#                               ...     ...             PROCEED RETURN
057562,000175:                                                                                          	#                               ...     ...             ENTER RETURN

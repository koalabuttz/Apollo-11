006640,000302: 
006641,000303: 06,2212           64753                 -1        AD       ONE                           	# (RE-ENTERS HERE FROM NXTIFAIL.)
006642,000304: 06,2213           24070        NXTIFBIT           INCR     RUPTREG1                      	# ADVANCE BIT POSITION NUMBER.
006643,000305: 06,2214           60000                 +1        DOUBLE                                 	#
006644,000306: 06,2215           54000                           TS       A                             	# SKIP IF OVERFLOW.
006645,000307: 06,2216           12213                           TCF      NXTIFBIT                      	# LOOK FOR BIT.

031374,000298:                                                                                          	# STABLE ORBIT MIDCOURSE PROGRAM (P39 AND P79)
031375,000299: 
031376,000300:                                                                                          	# MOD NO -1             LOG SECTION - STABLE ORBIT - P38-P39
031377,000301:                                                                                          	# MOD BY RUDNICKI.S     DATE 25JAN68
031378,000302: 
031380,000304:                                                                                          	# FUNCTIONAL DESCRIPTION
031381,000305: 
031382,000306:                                                                                          	#       P39 AND P79 CALCULATE THE REQUIRED DELTA V AND OTHER INITIAL
031383,000307:                                                                                          	#       CONDITIONS REQUIRED BY THE AGC TO MAKE A MIDCOURSE CORRECTION
031384,000308:                                                                                          	#       MANEUVER AFTER COMPLETING THE SOI MANEUVER BUT BEFORE MAKING
031385,000309:                                                                                          	#       THE SOR MANEUVER
031386,000310: 
031387,000311:                                                                                          	# CALLING SEQUENCE
031388,000312: 
031389,000313:                                                                                          	#       ASTRONAUT REQUEST THRU DSKY
031390,000314: 
031391,000315:                                                                                          	#       V37E39E         IF THIS VEHICLE IS ACTIVE VEHICLE
031392,000316:                                                                                          	#       V37E79E         IF OTHER VEHICLE IS ACTIVE VEHICLE
031393,000317: 
031394,000318:                                                                                          	# INPUT
031395,000319: 
031396,000320:                                                                                          	#       (1)  TPASS4     TIME OF INTERCEPT - SAVED FROM P38/P78
031397,000321:                                                                                          	#       (2)  TARGTIME   TIME THAT PASSIVE VEHICLE IS AT INTERCEPT POINT -
031398,000322:                                                                                          	#                       SAVED FROM P38/P78
031399,000323: 
031400,000324:                                                                                          	# OUTPUT
031401,000325: 
031402,000326:                                                                                          	#       (1)  TRKMKCNT   NUMBER OF MARKS
031403,000327:                                                                                          	#       (2)  TTOGO      TIME TO GO
031404,000328:                                                                                          	#       (3)  +MGA       MIDDLE GIMBAL ANGLE
031405,000329:                                                                                          	#       (4)  DELVLVC    DELTA VELOCITY AT MID - LOCAL VERTICAL COORDINATES
031406,000330: 

009654,001095:                                                                                          	# THE PREMM TABLE CONTAINS THE E-BANK, MAJOR MODE, AND PRIORITY
009655,001096:                                                                                          	# INFORMATION, IT IS IN THE FOLLOWING FORM,
009656,001097: 
009657,001098:                                                                                          	#       PPP PPE EEM MMM MMM
009658,001099: 
009659,001100:                                                                                          	#       WHERE THE       7 M BITS CONTAIN THE MAJOR MODE NUMBER
009660,001101:                                                                                          	#                       3 E BITS CONTAIN THE E-BANK NUMBER
009661,001102:                                                                                          	#                       5 P BITS CONTAIN THE PRIORITY AT WHICH THE JOB IS
009662,001103:                                                                                          	#                           TO BE STARTED
009663,001104: 

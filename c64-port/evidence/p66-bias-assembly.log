057629,000242:                                                                                          	#       GOXDSPR = GOMARKR
057630,000243:                                                                                          	#                               CAF     VXXNYY
057631,000244:                                                                                          	#                               TC      BANKCALL
057632,000245:                                                                                          	#                               CADR    GOMARKR         OTHER EXTENDED VERBS USE CADR GOXDSPR
057633,000246:                                                                                          	#                               ...     ...             IMMEDIATE RETURN OF GOMARKR

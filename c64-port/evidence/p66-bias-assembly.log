059185,000101:                                                                                          	# PRIOLARM DISPLAYS V05N09 VIA PRIODSPR WITH 3 RETURNS TO THE USER FROM THE ASTRONAUT AT CALL LOC +1,+2,+3 AND
059186,000102:                                                                                          	# AN IMMEDIATE RETURN TO THE USER AT CALL LOC +4.  EXAMPLE FOLLOWS,
059187,000103:                                                                                          	#               CAF     OCTXX           # ALARM CODE
059188,000104:                                                                                          	#               TC      BANKCALL
059189,000105:                                                                                          	#               CADR    PRIOLARM
059190,000106:                                                                                          	#               ...     ...
059191,000107:                                                                                          	#               ...     ...
059192,000108:                                                                                          	#               ...     ...             # ASTRONAUT RETURN
059193,000109:                                                                                          	#               TC      PHASCHNG        # IMMEDIATE RETURN TO USER.  RESTART
059194,000110:                                                                                          	#               OCT     X.1             # PHASE CHANGE FOR PRIO DISPLAY

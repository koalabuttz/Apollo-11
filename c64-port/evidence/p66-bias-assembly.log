024706,003510:                                                                                          	# PROGRAM NAME - LSR22.3                                DATE - 29 MAY 1967
024707,003511:                                                                                          	# MOD. NO 3                                             LOG SECTION - P20-25
024708,003512:                                                                                          	# MOD. BY - DANFORTH                                    ASSEMBLY LEMP20S REV 10
024709,003513: 
024710,003514:                                                                                          	# FUNCTIONAL DESCRIPTION
024711,003515:                                                                                          	#       THIS ROUTINE COMPUTES THE B-VECTORS AND DELTA Q FOR EACH OF THE QUANTITIES MEASURED BY THE RENDEZVOUS
024712,003516:                                                                                          	#       RADAR.  (RANGE, RANGE RATE, SHAFT AND TRUNNION ANGLES).  THE ROUTINE CALLS THE INCORP1 AND INCORP2 ROUTINES
024713,003517:                                                                                          	#       WHICH COMPUTE THE DEVIATIONS AND CORRECT THE STATE VECTOR.
024714,003518: 
024715,003519:                                                                                          	# CALLING SEQUENCE
024716,003520:                                                                                          	#       THIS ROUTINE IS PART OF P20 RENDEZVOUS NAVIGATION FOR THE LM COMPUTER ONLY.  THE ROUTINE IS ENTERED FROM
024717,003521:                                                                                          	#       R22 LEM ONLY AND RETURNS DIRECTLY TO R22LEM FOLLOWING SUCCESSFUL INCORPORATION OF MEASURED DATA.  IF THE
024718,003522:                                                                                          	#       COMPUTED STATE VECTOR DEVIATIONS EXCEED THE MAXIMUM PERMITTED.  THE ROUTINE RETURNS TO R22LEM TO DISPLAY
024719,003523:                                                                                          	#       THE DEVIATIONS.  IF THE ASTRONAUT ACCEPTS THE DATA R22LEM RETURNS TO LSR22.3 TO INCORPORATE THE
024720,003524:                                                                                          	#       DEVIATIONS INTO THE STATE VECTOR.  IF THE ASTRONAUT REJECTS THE DEVIATIONS, NO MORE MEASUREMENTS ARE
024721,003525:                                                                                          	#       PROCESSED FOR THIS MARK, I.E.,  R22LEM GETS THE NEXT MARK.
024722,003526: 
024723,003527:                                                                                          	# SUBROUTINES CALLED
024724,003528:                                                                                          	#       WLINIT          LGCUPDTE        INTEGRV         INCORP1         ARCTAN
024725,003529:                                                                                          	#       GETULC          RARARANG        INCORP2         NBSM            INTSTALL
024726,003530: 
024727,003531:                                                                                          	# OUTPUT
024728,003532:                                                                                          	#       CORRECTED LM OR CSM STATE VECTOR (PERMANENT)
024729,003533:                                                                                          	#       NUMBER OF MARKS INCORPORATED IN MARKCTR
024730,003534:                                                                                          	#       MAGNITUDE OF POSITION DEVIATION (FOR DISPLAY) IN R22DISP METERS B-29
024731,003535:                                                                                          	#       MAGNITUDE OF VELOCITY DEVIATION (FOR DISPLAY) IN R22DISP +2 M/CSEC B-7
024732,003536:                                                                                          	#       UPDATED W-MATRIX
024733,003537: 
024734,003538:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
024735,003539:                                                                                          	#       LM AND CSM STATE VECTORS
024736,003540:                                                                                          	#       W-MATRIX
024737,003541:                                                                                          	#       MARK TIME IN MKTIME
024738,003542:                                                                                          	#       RADAR RANGE IN RM METERS B-29
024739,003543:                                                                                          	#               RANGE RATE IN RDOTM METERS/CSES B-7
024740,003544:                                                                                          	#               SHAFT ANGLE IN RRSHAFT REVS. B0
024741,003545:                                                                                          	#               TRUNNION ANGLE IN RRTRUN REVS. B0
024742,003546:                                                                                          	#       GIMBAL ANGLES   INNER IN AIG
024743,003547:                                                                                          	#                       MIDDLE IN AMG
024744,003548:                                                                                          	#                       OUTER IN AOG

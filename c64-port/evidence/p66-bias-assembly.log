048863,000283: 25,3755           20206                                    5,1                           	#               SUCH THAT SCALING IS B-0
048864,000284: 25,3756           67206                           PUSH     SLOAD                         	# PD 10D  SAVE PARTIAL (X0+XDOT*T) IN 8-9D
048865,000285: 25,3757           00017                                    TIMSUBM                       	#
048866,000286: 25,3760           41261                           SL       DMP                           	#
048867,000287: 25,3761           20212                                    9D                            	#

032505,000974:                                                                                          	# KILLTASK
032506,000975:                                                                                          	# MOD NO:  NEW PROGRAM
032507,000976:                                                                                          	# MOD BY:  COVELLI
032508,000977: 
032509,000978:                                                                                          	# FUNCTIONAL DESCRIPTION:
032510,000979: 
032511,000980:                                                                                          	#       KILLTASK IS USED TO REMOVE A TASK FROM THE WAITLIST BY SUBSTITUTING A NULL TASK CALLED 'NULLTASK' (OF COURSE),
032512,000981:                                                                                          	#       WHICH MERELY DOES A TC TASKOVER.  IF THE SAME TASK IS SCHEDULED MORE THAN ONCE, ONLY THE ONE WHICH WILL OCCUR
032513,000982:                                                                                          	#       FIRST IS REMOVED.  IF THE TASK IS NOT SCHEDULED, KILLTASK TAKES NO ACTION AND RETURNS WITH NO ALARM.  KILLTASK
032514,000983:                                                                                          	#       LEAVES INTERRUPTS INHIBITED SO CALLER MUST RELINT
032515,000984: 
032516,000985:                                                                                          	# CALLING SEQUENCE:
032517,000986:                                                                                          	#       L       TC      KILLTASK        IN FIXED-FIXED
032518,000987:                                                                                          	#       L+1     CADR    ????????        CADR (NOT 2CADR) OF TASK TO BE REMOVED.
032519,000988:                                                                                          	#       L+2     (RELINT)                RETURN
032520,000989: 
032521,000990:                                                                                          	# EXIT MODE:  AT L+2 OF CALLING SEQUENCE.
032522,000991: 
032523,000992:                                                                                          	# ERASABLE INITIALIZATION= NONE.
032524,000993: 
032525,000994:                                                                                          	# OUTPUT:  2CADR OF NULLTASK IN LST2
032526,000995: 
032527,000996:                                                                                          	# DEBRIS:  ITEMP1 - ITEMP4, A, L, Q.
032528,000997: 
032529,000998: 36,3147  E3,1410                                  EBANK=   LST2                          	#
032530,000999:    6027                                           BLOCK    3                             	# KILLTASK MUST BE IN FIXED-FIXED.
032531,001000:    6000                                           SETLOC   FFTAG6                        	#
032532,001001:    6000                                           BANK                                   	#
032533,001002:    6027                                           COUNT*   $$/KILL                       	#
032534,001003:    6027           36036        KILLTASK           CA       KILLBB                        	#
032535,001004:    6030           00004                           INHINT                                 	#
032536,001005:    6031           22000                           LXCH     A                             	#
032537,001006:    6032           50002                           INDEX    Q                             	#
032538,001007:    6033           30000                           CA       0                             	# GET CADR.
032539,001008:    6034           22006                           LXCH     BBANK                         	#
032540,001009:    6035           12200                           TCF      KILLTSK2                      	# CONTINUE IN SWITCHED FIXED
032541,001010: 
032542,001011:    6036  E3,1410                                  EBANK=   LST2                          	#
032543,001012:    6036           56063        KILLBB             BBCON    KILLTSK2                      	#
032544,001013: 
032545,001014: 27,2200                                           BANK     27                            	#
032546,001015: 
032547,001016: 27,2000                                           SETLOC   P40S1                         	#
032548,001017: 27,2000                                           BANK                                   	#
032549,001018: 27,2200                                           COUNT*   $$/KILL                       	#
032550,001019: 
032551,001020: 27,2200           22062        KILLTSK2           LXCH     ITEMP2                        	# SAVE CALLER'S BBANK
032553,001022: 27,2201           24002                           INCR     Q                             	#
032554,001023: 27,2202           00006                           EXTEND                                 	#
032555,001024: 27,2203           22061                           QXCH     ITEMP1                        	# RETURN 2CADR IN ITEMP1,ITEMP2
032556,001025: 
032557,001026: 27,2204           54063                           TS       ITEMP3                        	# CADR IS IN A
032558,001027: 27,2205           75012                           MASK     LOW10                         	#
032559,001028: 27,2206           64741                           AD       BIT11                         	#
032560,001029: 27,2207           54064                           TS       ITEMP4                        	# GENADR OF TASK
032561,001030: 
032562,001031: 27,2210           45012                           CS       LOW10                         	#
032563,001032: 27,2211           70063                           MASK     ITEMP3                        	#
032564,001033: 27,2212           54063                           TS       ITEMP3                        	# FBANK OF TASK
032565,001034: 
032566,001035: 27,2213           22007                           ZL                                     	#
032567,001036: 27,2214           50001        ADRSCAN            INDEX    L                             	#
032568,001037: 27,2215           41410                           CS       LST2                          	#
032569,001038: 27,2216           60064                           AD       ITEMP4                        	# COMPARE GENADRS
032570,001039: 27,2217           00006                           EXTEND                                 	#
032571,001040: 27,2220           12232                           BZF      TSTFBANK                      	# IF THEY MATCH, COMPARE FBANKS
032572,001041: 27,2221           44747        LETITLIV           CS       LSTLIM                        	#
032573,001042: 27,2222           60001                           AD       L                             	#
032574,001043: 27,2223           00006                           EXTEND                                 	# ARE WE DONE?
032575,001044: 27,2224           12230                           BZF      DEAD                          	# YES - DONE, SO RETURN
032576,001045: 27,2225           24001                           INCR     L                             	#
032577,001046: 27,2226           24001                           INCR     L                             	#
032578,001047: 27,2227           12214                           TCF      ADRSCAN                       	# CONTINUE LOOP.
032579,001048: 
032580,001049: 27,2230           52062        DEAD               DXCH     ITEMP1                        	#
032581,001050: 27,2231           52006                           DTCB                                   	#
032582,001051: 
032583,001052: 27,2232           45012        TSTFBANK           CS       LOW10                         	#
032584,001053: 27,2233           50001                           INDEX    L                             	#
032585,001054: 27,2234           71411                           MASK     LST2       +1                 	# COMPARE FBANKS ONLY.
032586,001055: 27,2235           00006                           EXTEND                                 	#
032587,001056: 27,2236           60063                           SU       ITEMP3                        	#
032588,001057: 27,2237           00006                           EXTEND                                 	#
032589,001058: 27,2240           12242                           BZF      KILLDEAD                      	# MATCH - KILL IT.
032590,001059: 27,2241           12221                           TCF      LETITLIV                      	# NO MATCH - CONTINUE.
032591,001060: 
032592,001061: 27,2242           34353        KILLDEAD           CA       TCTSKOVR                      	#
032593,001062: 27,2243           50001                           INDEX    L                             	#
032594,001063: 27,2244           55410                           TS       LST2                          	# REMOVE TASK BY INSERTING TASKOVER
032595,001064: 27,2245           12230                           TCF      DEAD                          	#
032596,001065: 
032597,001066: 27,2246     4747               LSTLIM             EQUALS   BIT5                          	# DEC 16

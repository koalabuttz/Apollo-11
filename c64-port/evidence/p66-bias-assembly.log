053588,000136: 23,3352           77616                           RVQ                                    	#       (+) - (+) OR (-) - (-)
053589,000137: 
053591,000139:                                                                                          	# SMNB, NBSM, AND AXISROT, WHICH USED TO APPEAR HERE, HAVE BEEN
053592,000140:                                                                                          	# COMBINED IN A ROUTINE CALLED AX*SR*T, WHICH APPEARS AMONG THE POWERED
053593,000141:                                                                                          	# FLIGHT SUBROUTINES.
053594,000142: 
053596,000144:                                                                                          	# CALCGA COMPUTES THE CDU DRIVING ANGLES REQUIRED TO BRING THE STABLE MEMBER INTO THE DESIRED ORIENTATION.
053597,000145: 
053598,000146:                                                                                          	# THE INPUTS ARE  1) THE NAVIGATION BASE COORDINATES REFERRED TO ANY COORDINATE SYSTEM.  THE THREE HALF-UNIT
053599,000147:                                                                                          	# VECTORS ARE STORED AT XNB, YNB, AND ZNB.  2) THE DESIRED STABLE MEMBER COORDINATES REFERRED TO THE SAME
053600,000148:                                                                                          	# COORDINATE SYSTEM ARE STORED AT XSM, YSM, AND ZSM.
053601,000149: 
053602,000150:                                                                                          	# THE OUTPUTS ARE THE THREE CDU DRIVING ANGLES AND ARE STORED SP AT THETAD, THETAD +1, AND THETAD +2.
053603,000151: 
053604,000152: 23,3353           77601        CALCGA             SETPD                                  	# PUSHDOWN 00-05, 16D-21D, 34D-37D

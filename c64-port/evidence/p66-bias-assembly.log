049874,000397:                                                                                          	# MOD BY KRAUSE                                         ASSEMBLY - COLOSSUS REVISION 88
049875,000398: 
049876,000399:                                                                                          	# FUNCTIONAL DESCRIPTION -
049877,000400: 
049878,000401:                                                                                          	#       THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR AND A DESIRED RADIUS TO WHICH THE
049879,000402:                                                                                          	#       STATE IS TO BE UPDATED ALONG A CONIC TRAJECTORY, CALCULATES THE CORRESPONDING TIME-OF-FLIGHT AND, IN ADDITION,
049880,000403:                                                                                          	#       PROVIDES THE OPTION OF COMPUTING THE NEW UPDATED STATE VECTOR.  THE RESULTING TRAJECTORY MAY BE A SECTION OF A
049881,000404:                                                                                          	#       CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO THE EARTH OR THE MOON.  THE USE OF THE SUBROUTINE CAN BE
049882,000405:                                                                                          	#       EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WITHOUT INTRODUCING ANY CODING CHANGES,
049883,000406:                                                                                          	#       ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.
049884,000407: 
049885,000408:                                                                                          	#       IF THE DESIRED RADIUS IS BEYOND THE RADIUS OF APOCENTER OF THE CONIC OR BELOW THE RADIUS OF PERICENTER,
049886,000409:                                                                                          	#       APSESW WILL BE SET AND THE SUBROUTINE WILL RETURN THE APOCENTER OR PERICENTER SOLUTION, RESPECTIVELY.
049887,000410: 
049888,000411:                                                                                          	# THE RESTRICTIONS ARE -
049889,000412:                                                                                          	#       1. THE ANGLE BETWEEN ANY POSITION VECTOR AND ITS VELOCITY VECTOR MUST BE GREATER THAN 1 DEGREE 47.5 MINUTES
049890,000413:                                                                                          	#          AND LESS THAN 178 DEGREES 12.5 MINUTES.
049891,000414:                                                                                          	#       2. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE LIMITS
049892,000415:                                                                                          	#          ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
049893,000416:                                                                                          	#       3. AN ACCURACY DEGRADATION OCCURS AS THE SENSITIVITIES OF TIME AND UPDATED STATE VECTOR TO CHANGES IN
049894,000417:                                                                                          	#          RDESIRED INCREASE.  THIS WILL OCCUR NEAR EITHER APSIS OF THE CONIC AND WHEN THE CONIC IS NEARLY CIRCULAR.  IN
049895,000418:                                                                                          	#          PARTICULAR, IF THE CONIC IS AN EXACT CIRCLE, THE PROBLEM IS UNDEFINED AND THE SUBROUTINE WILL ABORT.
049896,000419: 
049897,000420:                                                                                          	#       THE AGC COMPUTATION TIME IS APPROXIMATELY .363 SECONDS
049898,000421: 
049899,000422:                                                                                          	# REFERENCES -
049900,000423:                                                                                          	#       R-479, MISSION PROGRAMMING DEFINITION MEMO NO. 10, LUNAR LANDING MISSION GSOP-SECTION 5.5, SGA MEMO 67-8.
049901,000424: 
049902,000425:                                                                                          	# INPUT - ERASABLE INITIALIZATION REQUIRED
049903,000426:                                                                                          	#                       * SCALE FACTOR  *
049904,000427:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *       DESCRIPTION AND REMARKS
049905,000428:                                                                                          	#       --------        *-------------- *       -----------------------
049906,000429:                                                                                          	#       RVEC            * +29 FOR EARTH *       DP INITIAL POSITION VECTOR IN METERS
049907,000430:                                                                                          	#                       * +27 FOR MOON  *
049908,000431:                                                                                          	#       VVEC            * +7 FOR EARTH  *       DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
049909,000432:                                                                                          	#                       * +5 FOR MOON   *
049910,000433:                                                                                          	#       RDESIRED        * +29 FOR EARTH *       DP TERMINAL RADIAL DISTANCE ON CONIC TRAJECTORY FOR WHICH TRANSFER TIME IS TO BE
049911,000434:                                                                                          	#                       * +27 FOR MOON  *               COMPUTED.
049912,000435:                                                                                          	#       SGNRDOT         * NONE          *       SP TAG SET TO +.5 OR -.5 ACCORDING TO WHETHER THE RADIAL VELOCITY AT RDESIRED IS TO BE
049913,000436:                                                                                          	#                       *               *               POSITIVE OR NEGATIVE, RESPECTIVELY.   THIS TAG REDUCES THE DOUBLE-VALUED PROBLEM TO A
049915,000438:                                                                                          	#                       *               *               SINGLE-VALUED PROBLEM.
049916,000439:                                                                                          	#       X1 (38D)        * NONE          *       INDEX REGISTER TO BE SET TO -2D OR -10D ACCORDING TO WHETHER THE EARTH OR MOON,
049917,000440:                                                                                          	#                       *               *               RESPECTIVELY, IS THE CENTRAL BODY.
049918,000441:                                                                                          	#       RVSW            * NONE          *       AN INTERPRETIVE SWITCH TO BE SET IF ONLY TIME IS TO BE AN OUTPUT, CLEAR IF THE NEW STATE
049919,000442:                                                                                          	#                       *               *               IS TO BE COMPUTED ALSO.
049920,000443: 
049921,000444:                                                                                          	# SUBROUTINES CALLED -
049922,000445:                                                                                          	#       PARAM, GEOM, GETX, DELTIME, NEWSTATE
049923,000446: 
049924,000447:                                                                                          	# CALLING SEQUENCE AND NORMAL EXIT MODES -
049925,000448: 
049926,000449:                                                                                          	#       IF ONLY TIME IS DESIRED AS OUTPUT -
049927,000450:                                                                                          	#       L       SET     CALL            MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
049928,000451:                                                                                          	#       L+1             RVSW
049929,000452:                                                                                          	#       L+2             TIMERAD         RETURN WITH PL AT 0 AND T IN MPAC
049930,000453:                                                                                          	#       L+3     ...                     CONTINUE
049931,000454: 
049932,000455:                                                                                          	#       IF THE UPDATE STATE VECTOR IS DESIRED AS WELL -
049933,000456:                                                                                          	#       L       CLEAR   CALL            MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
049934,000457:                                                                                          	#       L+1             RVSW
049935,000458:                                                                                          	#       L+2             TIMERAD         RETURNS WITH PL AT 6.  THE INITIAL POSITION VECTOR IS IN 0D OF THE PUSHLIST AND
049936,000459:                                                                                          	#                                       THE INITIAL VELOCITY VECTOR IN MPAC.
049937,000460:                                                                                          	#       L+3     STOVL   NEWVVEC
049938,000461:                                                                                          	#       L+4     STADR
049939,000462:                                                                                          	#       L+5     STORE   NEWRVEC         NEWVVEC AND NEWRVEC ARE SYMBOLIC REPRESENTATIONS OF THE USERS LOCATIONS.
049940,000463:                                                                                          	#       L+6     ...                     CONTINUE
049941,000464: 
049942,000465:                                                                                          	# ABORT EXIT MODES -
049943,000466:                                                                                          	#       IF SOLNSW AND/OR COGAFLAG AND/OR INFINFLG IS SET AT THE EXIT TO TIME-RADIUS, TIME-RADIUS WILL TRANSFER
049944,000467:                                                                                          	#       TO POODOO WITH AN ALARM CODE (ORIGINALLY 00607), AND NOT RETURN TO THE CALLING PROGRAM. (PCR 692 & 721)
049945,000468: 
049946,000469:                                                                                          	# OUTPUT -
049947,000470:                                                                                          	#                       * SCALE FACTOR  *
049948,000471:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *       DESCRIPTION AND REMARKS
049949,000472:                                                                                          	#       --------        *-------------- *       -----------------------
049950,000473:                                                                                          	#       T (30D)         * +28           *       DP TRANSFER TIME IN CENTISECONDS
049951,000474:                                                                                          	#       INFINFLG        * NONE          *       AN INTERPRETIVE SWITCH WHICH IS SET IF RDESIRED AND SGNRDOT REQUIRE CLOSURE THROUGH
049952,000475:                                                                                          	#                       *               *               INFINITY (NO SOLUTION), CLEAR IF A PHYSICAL SOLUTION IS POSSIBLE.
049953,000476:                                                                                          	#       COGAFLAG        * NONE          *       AN INTERPRETIVE SWITCH WHICH IS SET IF RESTRICTION 1 HAS BEEN VIOLATED (NO SOLUTION),
049954,000477:                                                                                          	#                       *               *               CLEAR IF NOT.
049955,000478:                                                                                          	#       APSESW          * NONE          *       AN INTERPRETIVE SWITCH WHICH IS SET IF RDESIRED WAS GREATER THAN RADIUS OF APOCENTER OR
049957,000480:                                                                                          	#                       *               *               LESS THAN RADIUS OF PERICENTER.  THE APOCENTER OR PERICENTER SOLUTION, RESPECTIVELY,
049958,000481:                                                                                          	#                       *               *               WILL THEN BE RETURNED.  THE SWITCH IS CLEAR IF RDESIRED WAS BETWEEN PERICENTER AND
049959,000482:                                                                                          	#                       *               *               APOCENTER.
049960,000483:                                                                                          	#       SOLNSW          * NONE          *       AN INTERPRETIVE SWITCH WHICH IS SET IF THE CONIC IS SO CLOSE TO A CIRCLE THAT THE TERMIN
049961,000484:                                                                                          	#                                       *               POINT IS AMBIGUOUS, VIOLATING RESTRICTION 3.  IF ECCENTRICITY IS GREATER THAN 2-TO-THE-
049962,000485:                                                                                          	#                                       *               MINUS-18, THE SWITCH IS CLEAR.
049963,000486: 
049964,000487:                                                                                          	#       IN ADDITION, IF RVSW IS CLEAR, THE FOLLOWING ARE OUTPUT -
049965,000488: 
049966,000489:                                                                                          	#       MPAC  -         * +7 FOR EARTH  *       DP TERMINAL VELOCITY VECTOR IN METERS/CENTISEC.
049967,000490:                                                                                          	#        MPAC +5        * +5 FOR MOON   *
049968,000491:                                                                                          	#       0D - 5D         * +29 FOR EARTH *       DP TERMINAL POSITION VECTOR IN METERS (PL AT 6D)
049969,000492:                                                                                          	#                       * +27 FOR MOON  *
049970,000493: 
049971,000494:                                                                                          	#       FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
049972,000495: 
049973,000496:                                                                                          	# DEBRIS -
049974,000497:                                                                                          	#       PARAMETERS WHICH MAY BE OF USE -
049975,000498: 
049976,000499:                                                                                          	#                       * SCALE FACTOR  *
049977,000500:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *       DESCRIPTION AND REMARKS
049978,000501:                                                                                          	#       --------        *-------------- *       -----------------------
049979,000502:                                                                                          	#       R1 (32D)        * +29 FOR EARTH *       DP MAGNITUDE OF INITIAL POSITION VECTOR, RVEC, IN METERS
049980,000503:                                                                                          	#                       * +27 FOR MOON  *
049981,000504:                                                                                          	#       R1A             * +6            *       DP RATIO OF R1 TO SEMIMAJOR AXIS (NEG. FOR HYPERBOLIC TRAJECTORIES)
049982,000505:                                                                                          	#       P               * +4            *       DP RATIO OF SEMILATUS RECTUM TO R1
049983,000506:                                                                                          	#       COGA            * +5            *       DP COTAN OF ANGLE BETWEEN RVEC AND VVEC
049984,000507:                                                                                          	#       UR1             * +1            *       DP UNIT VECTOR OF RVEC
049985,000508:                                                                                          	#       U2              * +1            *       DP UNIT VECTOR OF VVEC
049986,000509:                                                                                          	#       UN              * +1            *       DP UNIT VECTOR OF UR1*U2
049987,000510:                                                                                          	#       CSTH            * +1            *       DP COSINE OF TRUE ANOMALY DIFFERENCE BETWEEN RVEC AND RDESIRED.
049988,000511:                                                                                          	#       SNTH            * +1            *       DP SINE OF TRUE ANOMALY DIFFERENCE.
049989,000512: 
049990,000513:                                                                                          	#       PARAMETERS OF NO USE -
049991,000514:                                                                                          	#               SP PARAMETERS - RTNTT, GEOMSGN, RTNPRM, MAGVEC2=R2 (DP), PLUS PUSHLIST LOCATIONS 0-11D, 14D-21D, 24D-39D, 41D
049992,000515:                                                                                          	#               ADDITIONAL INTERPRETIVE SWITCHES USED - NORMSW, 360SW
049993,000516: 
049994,000517: 
049996,000519:                                                                                          	# PROGRAM DESCRIPTION - APSIDES SUBROUTINE              DATE - 1 SEPTEMBER 1967
049997,000520:                                                                                          	# MOD NO. - 0                                           LOG SECTION - CONIC SUBROUTINES
049998,000521:                                                                                          	# MOD BY KRAUSE                                         ASSEMBLY - COLOSSUS REVISION 88
049999,000522: 
050000,000523:                                                                                          	# FUNCTIONAL DESCRIPTION -
050001,000524: 
050002,000525:                                                                                          	#       THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR CALCULATES THE RADIUS OF PERICENTER AND OF APOCENTER AND THE
050003,000526:                                                                                          	#       ECCENTRICITY OF THE RESULTING CONIC TRAJECTORY, WHICH MAY BE A STRAIGHT LINE,
050004,000527:                                                                                          	#       CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO THE EARTH OR THE MOON.  THE USE OF THE SUBROUTINE CAN BE
050005,000528:                                                                                          	#       EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WITHOUT INTRODUCING ANY CODING CHANGES,
050006,000529:                                                                                          	#       ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.
050007,000530: 
050008,000531:                                                                                          	# THE RESTRICTIONS ARE -
050009,000532:                                                                                          	#       1. IF APOCENTER IS BEYOND THE SCALING OF POSITION, THE SCALE FACTOR LIMIT (536,870,910 METERS WITH RESPECT
050010,000533:                                                                                          	#          TO THE EARTH OR 134,217,727.5 METERS WITH RESPECT TO THE MOON) WILL BE RETURNED.
050011,000534:                                                                                          	#       2. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE LIMITS
050012,000535:                                                                                          	#          ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
050013,000536: 
050014,000537:                                                                                          	#       THE AGC COMPUTATION TIME IS APPROXIMATELY .103 SECONDS.
050015,000538: 
050016,000539:                                                                                          	# REFERENCES -
050017,000540:                                                                                          	#       MISSION PROGRAMMING DEFINITION MEMO NO. 10, LUNAR LANDING MISSION GSOP-SECTION 5.5
050018,000541: 
050019,000542:                                                                                          	# INPUT - ERASABLE INITIALIZATION REQUIRED
050020,000543:                                                                                          	#                       * SCALE FACTOR  *
050021,000544:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *       DESCRIPTION AND REMARKS
050022,000545:                                                                                          	#       --------        *-------------- *       -----------------------
050023,000546:                                                                                          	#       RVEC            * +29 FOR EARTH *       DP INITIAL POSITION VECTOR IN METERS
050024,000547:                                                                                          	#                       * +27 FOR MOON  *
050025,000548:                                                                                          	#       VVEC            * +7 FOR EARTH  *       DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
050026,000549:                                                                                          	#                       * +5 FOR MOON   *
050027,000550:                                                                                          	#       X1 (38D)        * NONE          *       INDEX REGISTER TO BE SET TO -2D OR -10D ACCORDING TO WHETHER THE EARTH OR MOON,
050028,000551:                                                                                          	#                       *               *               RESPECTIVELY, IS THE CENTRAL BODY.
050029,000552: 
050030,000553:                                                                                          	# SUBROUTINES CALLED -
050031,000554:                                                                                          	#       PARAM, GEOM
050032,000555: 
050033,000556:                                                                                          	# CALLING SEQUENCE AND NORMAL EXIT MODES -
050035,000558:                                                                                          	#       IF ONLY TIME IS DESIRED AS OUTPUT -
050036,000559:                                                                                          	#       L       CALL                    MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
050037,000560:                                                                                          	#       L+1             APSIDES         RETURNS WITH PL AT 0, RADIUS OF APOCENTER IN MPAC AND RADIUS OF PERICENTER IN 0D
050038,000561:                                                                                          	#       L+2     STODL   APOAPSE
050039,000562:                                                                                          	#       L+3             0D
050040,000563:                                                                                          	#       L+4     STORE   PERIAPSE        APOAPSE AND PERIAPSE ARE SYMBOLIC REPRESENTATIONS OF THE USERS LOCATIONS
050041,000564:                                                                                          	#       L+5     ...                     CONTINUE
050042,000565: 
050043,000566:                                                                                          	# OUTPUT -
050044,000567:                                                                                          	#                       * SCALE FACTOR  *
050045,000568:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *       DESCRIPTION AND REMARKS
050046,000569:                                                                                          	#       --------        *-------------- *       -----------------------
050047,000570:                                                                                          	#       MPAC            * +29 FOR EARTH *       DP RADIUS OF APOCENTER IN METERS
050048,000571:                                                                                          	#                       * +27 FOR MOON  *
050049,000572:                                                                                          	#       0D-1D           * +29 FOR EARTH *       DP RADIUS OF PERICENTER IN METERS
050050,000573:                                                                                          	#                       * +27 FOR MOON  *
050051,000574:                                                                                          	#       ECC             * +3            *       DP ECCENTRICITY OF CONIC TRAJECTORY.
050052,000575: 
050053,000576:                                                                                          	#       FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
050054,000577: 
050055,000578:                                                                                          	# DEBRIS -
050056,000579: 
050057,000580:                                                                                          	#       PARAMETERS WHICH MAY BE OF USE -
050058,000581: 
050059,000582:                                                                                          	#                       * SCALE FACTOR  *
050060,000583:                                                                                          	#       VARIABLE        *IN POWERS OF 2 *       DESCRIPTION AND REMARKS
050061,000584:                                                                                          	#       --------        *-------------- *       -----------------------
050062,000585:                                                                                          	#       R1 (32D)        * +29 FOR EARTH *       DP MAGNITUDE OF INITIAL POSITION VECTOR, RVEC, IN METERS
050063,000586:                                                                                          	#                       * +27 FOR MOON  *
050064,000587:                                                                                          	#       R1A             * +6            *       DP RATIO OF R1 TO SEMIMAJOR AXIS (NEG. FOR HYPERBOLIC TRAJECTORIES)
050065,000588:                                                                                          	#       P               * +4            *       DP RATIO OF SEMILATUS RECTUM TO R1
050066,000589:                                                                                          	#       COGA            * +5            *       DP COTAN OF ANGLE BETWEEN RVEC AND VVEC
050067,000590:                                                                                          	#       UR1             * +1            *       DP UNIT VECTOR OF RVEC
050068,000591:                                                                                          	#       U2              * +1            *       DP UNIT VECTOR OF VVEC
050069,000592:                                                                                          	#       UN              * +1            *       DP UNIT VECTOR OF UR1*U2
050070,000593:                                                                                          	#       MAGVEC2         * +7 FOR EARTH  *       DP MAGNITUDE OF VVEC
050071,000594:                                                                                          	#                       * +5 FOR MOON   *
050072,000595: 
050073,000596:                                                                                          	#       PARAMETERS OF NO USE -
050074,000597:                                                                                          	#               SP PARAMETERS - RTNAPSE, GEOMSGN, RTNPRM, PLUS PUSHLIST LOCATIONS 0-5, 10D-11D, 14D-21D, 31D-38D.

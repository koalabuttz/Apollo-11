016774,000295:                                                                                          	# DECOUNT       =       POLISH          COUNTER FOR SCALING AND DISPLAY (DEC)
016775,000296: 
016776,000297:                                                                                          	# SGNON         =       VBUF            TEMP FOR +,- ON
016777,000298:                                                                                          	# NOUNTEM       =       VBUF            COUNTER FOR MIXNOUN FETCH
016778,000299:                                                                                          	# DISTEM        =       VBUF            COUNTER FOR OCTAL DISPLAY VERBS
016779,000300:                                                                                          	# DECTEM        =       VBUF            COUNTER FOR FETCH (DEC DISPLAY VERBS)
016780,000301: 
016781,000302:                                                                                          	# SGNOFF        =       VBUF    +1      TEMP FOR +,- ON
016782,000303:                                                                                          	# NVTEMP        =       VBUF    +1      TEMP FOR NVSUB
016783,000304:                                                                                          	# SFTEMP1       =       VBUF    +1      STORAGE FOR SF CONST HI PART (=SFTEMP2-1)
016784,000305:                                                                                          	# HITEMIN       =       VBUF    +1      TEMP FOR LOAD OF HRS, MIN, SEC
016785,000306:                                                                                          	#                                               MUST = LOTEMIN-1.
016786,000307:                                                                                          	# CODE          =       VBUF    +2      FOR DSPIN
016787,000308:                                                                                          	# SFTEMP2       =       VBUF    +2      STORAGE FOR SF CONST LO PART (=SFTEMP1+1)
016788,000309:                                                                                          	# LOTEMIN       =       VBUF    +2      TEMP FOR LOAD OF HRS, MIN, SEC
016789,000310:                                                                                          	#                                               MUST = HITEMIN+1.
016790,000311:                                                                                          	# MIXTEMP       =       VBUF    +3      FOR MIXNOUN DATA
016791,000312:                                                                                          	# SIGNRET       =       VBUF    +3      RETURN FOR +,- ON
016792,000313:                                                                                          	# ALSO MIXTEMP+1 = VBUF+4, MIXTEMP+2 = VBUF+5.
016793,000314: 
016794,000315:                                                                                          	# ENTRET        =       DOTINC          EXIT FROM ENTER
016795,000316: 
016796,000317:                                                                                          	# WDCNT         =       DOTRET          CHAR COUNTER FOR DSPWD
016797,000318:                                                                                          	# INREL         =       DOTRET          INPUT BUFFER SELECTOR (X, Y, Z, REG)
016798,000319: 
016799,000320:                                                                                          	# DSPMMTEM      =       MATINC          DSPCOUNT SAVE FOR DSPMM
016800,000321:                                                                                          	# MIXBR         =       MATINC          INDICATOR FOR MIXED OR NORMAL NOUN
016801,000322: 
016802,000323:                                                                                          	# TEM1          ERASE                   EXEC TEMP
016803,000324:                                                                                          	# DSREL         =       TEM1            REL ADDRESS FOR DSPIN
016804,000325: 

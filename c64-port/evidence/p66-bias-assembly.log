042071,001576:                                                                                          	# GRAVITY VECTOR DETERMINATION ROUTINE
042072,001577:                                                                                          	# BY KEN VINCENT
042073,001578: 
042074,001579:                                                                                          	# FOR DETAILED DESCRIPTION SEE 504GSOP 5.6.3.2.5
042075,001580: 
042076,001581:                                                                                          	# THIS PROGRAM FINDS THE DIRECTION OF THE MOONS GRAVITY
042077,001582:                                                                                          	# WHILE THE LM IS ON THE MOONS SURFACE.  IT WILL BE USED
042078,001583:                                                                                          	# FOR LUNAR SURFACE ALIGNMENT.  THE GRAVITY VECTOR IS
042079,001584:                                                                                          	# DETERMINED BY READING THE PIPAS WITH THE IMU AT TWO
042080,001585:                                                                                          	# PARTICULAR ORIONTATIONS.  THE TWO READINGS ARE AVERAGED
042081,001586:                                                                                          	# AND UNITIZED AND TRANSFORMED TO NB COORDINATES.  THE TWO
042082,001587:                                                                                          	# ORIENTATION WERE CHOSEN TO REDUCE BIAS ERRORS IN THE
042083,001588:                                                                                          	# READINGS.
042084,001589: 
042085,001590:                                                                                          	# CALL -
042086,001591:                                                                                          	#       TC      BANKCALL
042087,001592:                                                                                          	#       CADR    GVDETER
042088,001593: 
042089,001594:                                                                                          	# INPUTS -
042090,001595:                                                                                          	#       PIPAS, CDUS
042091,001596: 
042092,001597:                                                                                          	# OUTPUTS -
042093,001598:                                                                                          	#       STARSAV1 = UNIT GRAVITY
042094,001599:                                                                                          	#       GSAV     = DITTO
042095,001600:                                                                                          	#       GRAVBIT  = 1
042096,001601: 
042097,001602:                                                                                          	# SUBROUTINES -
042098,001603:                                                                                          	#       PIPASR, IMUCOARS, IMUFINE, IMUSTALL, 1/PIPA, DELAYJOB, CDUTRIG,
042099,001604:                                                                                          	#       *NBSM*, *SNMB*, CALCGA, FOFLASH
042100,001605: 
042101,001606:                                                                                          	# DEBRIS -
042102,001607:                                                                                          	#       VAC, SAC, STARAD, XSM, XNB, THETAD, DELV, COSCDU, SINCDU
042103,001608: 

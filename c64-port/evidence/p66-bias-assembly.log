054369,000154:                                                                                          	#          VONE   E:(-7)   M:(-5)   M/CS  STATE VECTOR          LEFT BY CALLER
054370,000155:                                                                                          	#          TFF/RTMU  E:(17)  M:(14)      1/RT(CS SQ/M CUBE)      IF ENTER VIA TFFCONMU.

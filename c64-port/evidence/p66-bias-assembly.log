048613,000033:                                                                                          	# ..... RP-TO-R SUBROUTINE .....
048614,000034:                                                                                          	# SUBROUTINE TO CONVERT RP (VECTOR IN PLANETARY COORDINATE SYSTEM, EITHER
048615,000035:                                                                                          	# EARTH-FIXED OR MOON-FIXED) TO R (SAME VECTOR IN THE BASIC REF. SYSTEM)
048616,000036: 
048617,000037:                                                                                          	#       R = MT(T) * (RP + LP X RP)      MT = M MATRIX TRANSPOSE
048618,000038: 
048619,000039:                                                                                          	# CALLING SEQUENCE
048620,000040:                                                                                          	#       L       CALL
048621,000041:                                                                                          	#       L+1             RP-TO-R
048622,000042: 
048623,000043:                                                                                          	# SUBROUTINES USED
048624,000044:                                                                                          	#       EARTHMX, MOONMX, EARTHL
048625,000045: 
048626,000046:                                                                                          	#       ITEMS AVAILABLE FROM LAUNCH DATA
048627,000047:                                                                                          	#               504LM = THE LIBRATION VECTOR L OF THE MOON AT TIME TIMSUBL, EXPRESSED
048628,000048:                                                                                          	#                       IN THE MOON-FIXED COORD. SYSTEM         RADIANS B0
048629,000049: 
048630,000050:                                                                                          	#       ITEMS NECESSARY FOR SUBR. USED (SEE DESCRIPTION OF SUBR.)
048631,000051: 
048632,000052:                                                                                          	# INPUT
048633,000053:                                                                                          	#       MPAC = 0 FOR EARTH, NON-ZERO FOR MOON
048634,000054:                                                                                          	#       0-5D = RP VECTOR
048635,000055:                                                                                          	#       6-7D = TIME
048636,000056: 
048637,000057:                                                                                          	# OUTPUT
048638,000058:                                                                                          	#       MPAC = R VECTOR METERS B-29 FOR EARTH, B-27 FOR MOON
048639,000059: 
048640,000060: 26,2000                                           SETLOC   PLANTIN1                      	#
048641,000061: 26,2000                                           BANK                                   	#
048642,000062: 
048643,000063: 26,3716                                           COUNT*   $$/LUROT                      	#
048644,000064: 
048645,000065: 26,3716           46020        RP-TO-R            STQ      BHIZ                          	#
048646,000066: 26,3717           00050                                    RPREXIT                       	#
048647,000067: 26,3720           55733                                    RPTORA                        	#
048648,000068: 26,3721           77624                           CALL                                   	# COMPUTE M MATRIX FOR MOON
048649,000069: 26,3722           51720                                    MOONMX                        	# LP=LM FOR MOON  RADIANS B0
048650,000070: 26,3723           77775                           VLOAD                                  	#
048651,000071: 26,3724           02013                                    504LM                         	#
048652,000072: 26,3725           53235        RPTORB             VXV      VAD                           	#
048653,000073: 26,3726           00001                                    504RPR                        	#

056931,000761:                                                                                          	# GENERAL STALLING ROUTINE.  USING PROGRAMS COME HERE TO WAIT FOR I/O COMPLETION.
056932,000762: 
056933,000763:                                                                                          	# PROGRAM DESCRIPTION                           DATE - 21 FEB 1967
056934,000764:                                                                                          	#                                               LOG SECTION IMU MODE SWITCHING
056935,000765:                                                                                          	# MOD BY - R. MELANSON TO ADD DOCUMENTATION     ASSEMBLY SUNDISK REV. 82
056936,000766: 
056937,000767:                                                                                          	# FUNCTIONAL DESCRIPTION -
056938,000768:                                                                                          	#       TO DELAY FURTHER EXECUTION OF THE CALLING ROUTINE UNTIL ITS SELECTED
056939,000769:                                                                                          	#       I/O FUNCTION IS COMPLETE.  THE FOLLOWING CHECKS ON THE CALLING ROUTINE:S
056940,000770:                                                                                          	#       MODECADR ARE MADE AND ACTED UPON.
056941,000771:                                                                                          	#       1) +0 INDICATES INCOMPLETE I/O OPERATION.  CALLING ROUTINE IS PUT TO
056942,000772:                                                                                          	#          SLEEP.
056943,000773:                                                                                          	#       2) -1 INDICATES COMPLETED I/O OPERATION.  STALL BYPASSES JOBSLEEP
056944,000774:                                                                                          	#          CALL AND RETURNS TO CALLING ROUTINE AT L+3
056945,000775:                                                                                          	#       3) -0 INDICATES COMPLETED I/O WITH FAILURE.  STALL CLEARS MODECADR
056946,000776:                                                                                          	#          AND RETURNS TO CALLING ROUTINE AT L+2.
056947,000777:                                                                                          	#       4) VALUE GREATER THAN 0 INDICATES TWO ROUTINES CALLING FOR USE OF
056948,000778:                                                                                          	#          SAME DEVICE.  STALL EXITS TO ABORT WHICH EXECUTES A PROGRAM
056949,000779:                                                                                          	#          RESTART WHICH IN TURN CLEARS ALL MODECADR REGISTERS.
056950,000780: 
056951,000781:                                                                                          	# CALLING SEQUENCE -
056952,000782:                                                                                          	#       L       TC      BANKCALL
056953,000783:                                                                                          	#       L+1     CADR    (ONE OF 5 STALL ADDRESSES I.E. IMUSTALL, OPTSTALL, RADSTALL,
056954,000784:                                                                                          	#                       AOTSTALL, OR ATTSTALL)
056955,000785: 
056956,000786:                                                                                          	# NORMAL-EXIT MODE -
056957,000787:                                                                                          	#       TCF JOBSLEEP    OR      TCF MODEXIT
056958,000788: 
056959,000789:                                                                                          	# ALARM OR ABORT EXIT MODE -
056960,000790:                                                                                          	#       TC      ABORT
056961,000791: 
056962,000792:                                                                                          	# OUTPUT -
056963,000793:                                                                                          	#       MODECADR=CADR   IF JOBSLEEP
056964,000794:                                                                                          	#       MODECADR=+0     IF I/O COMPLETE
056965,000795:                                                                                          	#       BUF2=L+3        IF I/O COMPLETE AND GOOD.
056966,000796:                                                                                          	#       BUF2=L+2        IF I/O COMPLETE BUT FAILED.
056967,000797: 
056968,000798:                                                                                          	# ERASABLE INITIALIZATION -
056969,000799:                                                                                          	#       BUF2 CONTAINS RETURN ADDRESS PLUS 1,(L+2)
056970,000800:                                                                                          	#       BUF2+1 CONTAINS FBANK VALUE OF CALLING ROUTINE.
056971,000801:                                                                                          	#       MODECADR OF CALLING ROUTINE CONTAINS +0,-1,-0 OR CADR RETURN ADDRESS.
056972,000802: 
056973,000803:                                                                                          	# DEBRIS -
056974,000804:                                                                                          	#       RUPTREG2 AND CALLING ROUTINE MODECADR.
056975,000805: 
056976,000806: 07,3712           34753        AOTSTALL           CAF      ONE                           	# AOT.
056977,000807: 07,3713           03717                           TC       STALL                         	#
056978,000808: 
056979,000809: 07,3714           34752        RADSTALL           CAF      TWO                           	#
056980,000810: 07,3715           13717                           TCF      STALL                         	#
056981,000811: 

048300,000034:                                                                                          	# SUBROUTINE TO CONVERT RAD VECTOR AT GIVEN TIME TO LAT,LONG AND ALT
048301,000035: 
048302,000036:                                                                                          	# CALLING SEQUENCE
048303,000037:                                                                                          	#       L-1     CALL
048304,000038:                                                                                          	#       L               LAT-LONG
048305,000039: 
048306,000040:                                                                                          	# SUBROUTINES USED
048307,000041:                                                                                          	#       R-TO-RP, ARCTAN, SETGAMMA, SETRE
048308,000042: 
048309,000043:                                                                                          	# ERASABLE INIT. REQ.
048310,000044:                                                                                          	#       AXO, -AYO, AZO, TEPHEM (SET AT LAUNCH TIME)
048311,000045:                                                                                          	#       ALPHAV = POSITION VECTOR METERS B-29
048312,000046:                                                                                          	#       MPAC -- TIME (CSECS B-28)
048313,000047:                                                                                          	#       ERADFLAG =1, TO COMPUTE EARTH RADIUS, =0 FOR FIXED EARTH RADIUS
048314,000048:                                                                                          	#       LUNAFLAG=0 FOR EARTH, 1 FOR MOON
048315,000049: 
048316,000050:                                                                                          	# OUTPUT
048317,000051:                                                                                          	#       LATITUDE IN LAT         (REVS. B-0)
048318,000052:                                                                                          	#       LONGITUDE IN LONG       (REVS. B-0)
048319,000053:                                                                                          	#       ALTITUDE IN ALT         METERS B-29
048320,000054: 
048321,000055: 30,3775                                           BANK     30                            	#
048322,000056: 13,2000                                           SETLOC   LATLONG                       	#
048323,000057: 13,2000                                           BANK                                   	#
048324,000058: 
048325,000059: 13,2351                                           COUNT*   $$/LT-LG                      	#
048326,000060: 13,2351  E4,1431                                  EBANK=   ALPHAV                        	#
048327,000061: 13,2351           40220        LAT-LONG           STQ      SETPD                         	#
048328,000062: 13,2352           03674                                    INCORPEX                      	#
048329,000063: 13,2353           00001                                    0D                            	#
048330,000064: 13,2354           24007                           STOVL    6D                            	# SAVE TIME IN 6-7D FOR R-TO-RP
048331,000065: 13,2355           02032                                    ALPHAV                        	#
048332,000066: 13,2356           51406                           PUSH     ABVAL                         	# 0-5D= R FOR R-TO-RP
048333,000067: 13,2357           16070                           STODL    ALPHAM                        	# ABS. VALUE OF R FOR ALT FORMULA BELOW
048334,000068: 13,2360           24007                                    ZEROVEC                       	# SET MPAC=0 FOR EARTH, NON-ZERO FOR MOON
048335,000069: 13,2361           71414                           BOFF     COS                           	# USE COS(0) TO GET NON-ZERO IN MPAC
048336,000070: 13,2362           01743                                    LUNAFLAG                      	# 0=EARTH, 1=MOON
048337,000071: 13,2363           26364                                    CALLRTRP                      	#
048338,000072: 13,2364           77624        CALLRTRP           CALL                                   	#
048339,000073: 13,2365           51670                                    R-TO-RP                       	# RP VECTOR CONVERTED FROM R B-29
048340,000074: 13,2366           77656                           UNIT                                   	# UNIT RP B-1
048341,000075: 13,2367           36032                           STCALL   ALPHAV                        	# U2= 1/2 SINL FOR SETRE SUBR BELOW
048342,000076: 13,2370           26550                                    SETGAMMA                      	#       SET GAMMA=B2/A2 FOR EARTH, =1 FOR MOON
048343,000077: 13,2371           77624                           CALL                                   	#       SCALED B-1
048344,000078: 13,2372           26560                                    SETRE                         	# CALC RE METERS B-29
048345,000079: 13,2373           63545                           DLOAD    DSQ                           	#
048346,000080: 13,2374           02032                                    ALPHAV                        	#
048347,000081: 13,2375           63525                           PDDL     DSQ                           	#
048348,000082: 13,2376           02034                                    ALPHAV     +2                 	#
048349,000083: 13,2377           75415                           DAD      SQRT                          	#
048351,000085: 13,2400           76405                           DMP      SL1R                          	#
048352,000086: 13,2401           00011                                    GAMRP                         	#
048353,000087: 13,2402           14021                           STODL    COSTH                         	# COS(LAT) B-1
048354,000088: 13,2403           02036                                    ALPHAV     +4                 	#
048355,000089: 13,2404           34023                           STCALL   SINTH                         	# SIN(LAT) B-1
048356,000090: 13,2405           26510                                    ARCTAN                        	#
048357,000091: 13,2406           15121                           STODL    LAT                           	# LAT B0
048358,000092: 13,2407           02032                                    ALPHAV                        	#
048359,000093: 13,2410           14021                           STODL    COSTH                         	# COS(LONG) B-1
048360,000094: 13,2411           02034                                    ALPHAV     +2                 	#
048361,000095: 13,2412           34023                           STCALL   SINTH                         	# SIN(LONG) B-1
048362,000096: 13,2413           26510                                    ARCTAN                        	#
048363,000097: 13,2414           15123                           STODL    LONG                          	# LONG. REVS B-0 IN RANGE -1/2 TO 1/2
048364,000098: 13,2415           02070                                    ALPHAM                        	#
048365,000099: 13,2416           77625                           DSU                                    	# ALT= R-RE METERS B-29
048366,000100: 13,2417           03673                                    ERADM                         	#
048367,000101: 13,2420           35125                           STCALL   ALT                           	# EXIT WITH ALT METERS B-29
048368,000102: 13,2421           03674                                    INCORPEX                      	#
048370,000104:                                                                                          	# SUBROUTINE TO CONVERT LAT,LONG,ALT AT GIVEN TIME TO RADIUS VECTOR
048371,000105: 
048372,000106:                                                                                          	# CALLING SEQUENCE
048373,000107:                                                                                          	#       L-1     CALL
048374,000108:                                                                                          	#       L               LALOTORV
048375,000109: 
048376,000110:                                                                                          	# SUBROUTINES USED
048377,000111:                                                                                          	#       SETGAMMA, SETRE, RP-TO-R
048378,000112: 
048379,000113:                                                                                          	# ERASABLE INIT. REQ.
048380,000114:                                                                                          	#       AXO, AYO, AZO, TEPHEM SET AT LAUNCH TIME
048381,000115:                                                                                          	#       LAT -- LATITUDE         (REVS B0)
048382,000116:                                                                                          	#       LONG -- LONGITUDE       (REVS B0)
048383,000117:                                                                                          	#       ALT -- ALTITUDE         (METERS) B-29
048384,000118:                                                                                          	#       MPAC -- TIME            (CSECS B-28)
048385,000119:                                                                                          	#       ERADFLAG =1 TO COMPUTE EARTH RADIUS, =0 FOR FIXED EARTH RADIUS
048386,000120:                                                                                          	#       LUNAFLAG=0 FOR EARTH, 1 FOR MOON
048387,000121: 
048388,000122:                                                                                          	# OUTPUT
048389,000123:                                                                                          	#       R-VECTOR IN ALPHAV      (METERS B-29)
048390,000124: 
048391,000125: 13,2422           40220        LALOTORV           STQ      SETPD                         	# LAT,LONG,ALT TO R VECTOR
048392,000126: 13,2423           03674                                    INCORPEX                      	#
048393,000127: 13,2424           00001                                    0D                            	#
048394,000128: 13,2425           34007                           STCALL   6D                            	# 6-7D= TIME FOR RP-TO-R
048395,000129: 13,2426           26550                                    SETGAMMA                      	# GAMMA=B2/A2 FOR EARTH, 1 FOR MOON B-1
048396,000130: 13,2427           73545                           DLOAD    SIN                           	#               COS(LONG)COS(LAT) IN MPAC
048397,000131: 13,2430           01121                                    LAT                           	#     UNIT RP = SIN(LONG)COS(LAT)    2-3D

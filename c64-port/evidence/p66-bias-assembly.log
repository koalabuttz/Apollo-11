028193,000029:                                                                                          	##
028194,000030:                                                                                          	## Notations on the hardcopy document read, in part:
028195,000031:                                                                                          	##
028196,000032:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
028197,000033:                                                                                          	##      16:27 JULY 14, 1969 
028198,000034: 
028200,000036:                                                                                          	# GROUND TRACKING DETERMINATION PROGRAM P21
028201,000037:                                                                                          	# PROGRAM DESCRIPTION
028202,000038:                                                                                          	#       MOD NO - 1
028203,000039:                                                                                          	#       MOD BY - N. M. NEVILLE
028204,000040: 
028205,000041:                                                                                          	# FUNCTIONAL DECRIPTION -
028206,000042:                                                                                          	#       TO PROVIDE THE ASTRONAUT DETAILS OF THE LM OR CSM GROUND TRACK WITHOUT
028207,000043:                                                                                          	#       THE NEED FOR GROUND COMMUNICATION (REQUESTED BY DSKY).
028208,000044: 
028209,000045:                                                                                          	# CALLING SEQUENCE -
028210,000046:                                                                                          	#       ASTRONAUT REQUEST THROUGH DSKY V37E21E
028211,000047: 
028212,000048:                                                                                          	# SUBROUTINES CALLED -
028213,000049:                                                                                          	#       GOPERF4
028214,000050:                                                                                          	#       GOFLASH
028215,000051:                                                                                          	#       THISPREC
028216,000052:                                                                                          	#       OTHPREC
028217,000053:                                                                                          	#       LAT-LONG
028218,000054: 
028219,000055:                                                                                          	# NORMAL EXIT MODES -
028220,000056:                                                                                          	#       ASTRONAUT REQUEST TROUGH DSKY TO TERMINATE PROGRAM V34E
028221,000057: 
028222,000058:                                                                                          	# ALARM OR ABORT EXIT MODES -
028223,000059:                                                                                          	#       NONE
028224,000060: 
028225,000061:                                                                                          	# OUTPUT -
028226,000062:                                                                                          	#       OCTAL DISPLAY OF OPTION CODE AND VEHICLE WHOSE GROUND TRACK IS TO BE
028227,000063:                                                                                          	#       COMPUTED
028228,000064:                                                                                          	#               OPTION CODE     00002
028229,000065:                                                                                          	#               THIS            00001
028230,000066:                                                                                          	#               OTHER           00002
028231,000067:                                                                                          	#       DECIMAL DISPLAY OF TIME TO BE INTEGRATED TO HOURS, MINUTES, SECONDS
028232,000068:                                                                                          	#       DECIMAL DISPLAY OF LAT,LONG,ALT
028233,000069: 
028234,000070:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
028235,000071:                                                                                          	#       AX0             2DEC    4.652459653 E-5 RADIANS         %68-69 CONSTANTS"
028236,000072:                                                                                          	#       -AY0            2DEC    2.147535898 E-5 RADIANS
028237,000073:                                                                                          	#       AZ0             2DEC    .7753206164     REVOLUTIONS
028238,000074:                                                                                          	#       FOR LUNAR ORBITS 504LM VECTOR IS NEEDED
028239,000075:                                                                                          	#       504LM           2DEC    -2.700340600 E-5 RADIANS
028240,000076:                                                                                          	#       504LM _2        2DEC    -7.514128400 E-4 RADIANS
028241,000077:                                                                                          	#       504LM _4        2DEC    _2.553198641 E-4 RADIANS
028242,000078: 
028243,000079:                                                                                          	#       NONE
028244,000080: 
028245,000081:                                                                                          	# DEBRIS
028247,000083:                                                                                          	#       CENTRALS - A,Q,L
028248,000084:                                                                                          	#       OTHER - THOSE USED BY THE ABOVE LISTED SUBROUTINES
028249,000085:                                                                                          	#       SEE LEMPREC, LAT-LONG
028250,000086: 
028251,000087: 35,2545  30,2000                                  SBANK=   LOWSUPER                      	# FOR LOW 2CADR'S.
028252,000088: 
028253,000089: 33,2200                                           BANK     33                            	#
028254,000090: 24,2000                                           SETLOC   P20S                          	#
028255,000091: 24,2000                                           BANK                                   	#
028256,000092: 
028257,000093: 24,3505  E7,1762                                  EBANK=   P21TIME                       	#
028258,000094: 24,3505                                           COUNT*   $$/P21                        	#
028259,000095: 24,3505           34753        PROG21             CAF      ONE                           	#

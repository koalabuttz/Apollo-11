006199,002632: E7,1745  E7,1632               YCO                EQUALS   RCO        +2                 	# I(2)TMP DISTANCE, SCALED AT 2(24).
006200,002633: E7,1745  E7,1634               1/DV1              EQUALS   YCO        +2                 	# B(2)TMP ATMAG
006201,002634: E7,1745  E7,1636               1/DV2              EQUALS   1/DV1      +2                 	# B(2)TMP ATMAG

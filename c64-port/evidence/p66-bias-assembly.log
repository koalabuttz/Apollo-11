030641,000041:                                                                                          	# SUBROUTINE NAME:  V82CALL
030642,000042:                                                                                          	# MOD NO: 0                                                             DATE: 16 FEB 67
030643,000043:                                                                                          	# MOD BY: RR BAIRNSFATHER                                               LOG SECTION:  R30
030644,000044:                                                                                          	# MOD NO: 1     MOD BY:  RR BAIRNSFATHER        DATE: 11 APR 67         SR30.1 CHANGED TO ALLOW MONITOR OPERN
030645,000045:                                                                                          	# MOD NO: 2     MOD BY  ALONSO                  DATE: 11 DEC 67         VB82 PROGRAM REWRITTEN
030646,000046:                                                                                          	# MOD NO: 3     MOD BY  ALONSO                  DATE: 26 MAR 68         PROG MOD TO HANDLE DIF EARTH/MOON SCALE
030647,000047: 
030648,000048:                                                                                          	# NEW FUNCTIONAL DESCRIPTION:   CALLED BY VERB 82 ENTER.  PRIORITY 10
030649,000049:                                                                                          	# USED THROUGHOUT.              CALCULATE AND DISPLAY ORBITAL PARAMETERS
030650,000050: 
030651,000051:                                                                                          	# 1.    IF AVERAGE G IS OFF:
030652,000052:                                                                                          	#               FLASH DISPLAY V04N06.  R2 INDICATES WHICH SHIP'S STATE VECTOR IS
030653,000053:                                                                                          	#                       TO BE UPDATED.  INITIAL CHOICE IS THIS SHIP (R2=1).  ASTRONAUT
030654,000054:                                                                                          	#                       CAN CHANGE TO OTHER SHIP BY V22EXE, WHERE X NOT EQ 1.
030655,000055:                                                                                          	#               SELECTED STATE VECTOR UPDATED BY THISPREC (OTHPREC).
030656,000056:                                                                                          	#               CALLS SR30.1 (WHICH CALLS TFFCONMU + TFFRP/RA) TO CALCULATE
030657,000057:                                                                                          	#                       RPER (PERIGEE RADIUS), RAPO (APOGEE RADIUS), HPER (PERIGEE
030658,000058:                                                                                          	#                       HEIGHT ABOVE LAUNCH PAD OR LUNAR LANDING SITE), HAPO (APOGEE
030659,000059:                                                                                          	#                       HEIGHT AS ABOVE), TPER (TIME TO PERIGEE), TFF (TIME TO
030660,000060:                                                                                          	#                       INTERSECT 300 KFT ABOVE PAD OR 35KFT ABOVE LANDING SITE).
030661,000061:                                                                                          	#               FLASH MONITOR V16N44 (HAPO, HPER, TFF).  TFF IS -59M59S IF IT WAS
030662,000062:                                                                                          	#                       NOT COMPUTABLE, OTHERWISE IT INCREMENTS ONCE PER SECOND.
030663,000063:                                                                                          	#                       ASTRONAUT HAS OPTION TO MONITOR TPER BY KEYING IN N 32 E.
030664,000064:                                                                                          	#                       DISPLAY IS IN HMS, IS NEGATIVE (AS WAS TFF), AND INCREMENTS
030665,000065:                                                                                          	#                       ONCE PER SECOND ONLY IF TFF DISPLAY WAS -59M59S.
030666,000066:                                                                                          	#       2.      IF AVERAGE G IS ON:
030667,000067:                                                                                          	#                       CALLS SR30.1 APPROX EVERY TWO SECS.  STATE VECTOR IS ALWAYS
030668,000068:                                                                                          	#                               FOR THIS VEHICLE.  V82 DOES NOT DISTURB STATE VECTOR.  RESULTS
030669,000069:                                                                                          	#                               OF SR30.1 ARE RAPO, RPER, HAPO, HPER, TPER, TFF.
030670,000070:                                                                                          	#                       FLASH MONITOR V16N44 (HAPO, HPER, TFF).
030671,000071:                                                                                          	#       ADDENDUM:  HAPO AND HPER SHOULD BE CHANGED TO READ HAPOX AND HPERX IN THE
030672,000072:                                                                                          	#               ABOVE REMARKS.
030673,000073: 
030674,000074:                                                                                          	# CALLING SEQUENCE: VERB 82 ENTER.
030675,000075: 
030676,000076:                                                                                          	# SUBROUTINES CALLED:   SR30.1, GOXDSPF
030677,000077:                                                                                          	#                       MAYBE - THISPREC, OTHPREC, LOADTIME, DELRSPL
030678,000078: 
030679,000079:                                                                                          	# NORMAL EXIT MODES:  TC ENDEXT
030680,000080: 
030681,000081:                                                                                          	# ALARMS:  NONE
030682,000082: 
030683,000083:                                                                                          	# OUTPUT:       HAPOX   (-29) M
030684,000084:                                                                                          	#               HPERX   (-29) M
030685,000085:                                                                                          	#               RAPO    (-29) M EARTH
030686,000086:                                                                                          	#                       (-27) M MOON
030687,000087:                                                                                          	#               RPER    (-29) M EARTH
030688,000088:                                                                                          	#                       (-27) M MOON
030689,000089:                                                                                          	#               TFF     (-28) CS        CONTAINS NEGATIVE QUANTITY
030690,000090:                                                                                          	#               -TPER   (-28) CS        CONTAINS NEGATIVE QUANTITY
030691,000091: 

060525,000031:                                                                                          	##      16:27 JULY 14, 1969 
060526,000032: 
060528,000034:                                                                                          	# THE DAPIDLER PROGRAM IS STARTED BY FRESH START AND RESTART.  THE DAPIDLER PROGRAM IS DONE 10 TIMES
060529,000035:                                                                                          	# PER SECOND UNTIL THE ASTRONAUT DESIRES THE DAP TO WAKE UP, AND THE IMU AND CDUS ARE READY FOR USE BY THE DAP.
060530,000036:                                                                                          	# THE NECESSARY INITIALIZATION OF THE DAP IS DONE BY THE DAPIDLER PROGRAM.
060531,000037: 
060532,000038: 16,2000                                           BANK     16                            	#
060533,000039: 16,2000                                           SETLOC   DAPS1                         	#
060534,000040: 16,2000                                           BANK                                   	#
060535,000041: 
060536,000042: 16,2000  E6,1537                                  EBANK=   AOSQ                          	#
060537,000043: 
060538,000044: 16,2000                                           COUNT*   $$/DAPID                      	#
060539,000045: 
060540,000046: 16,2000           00006        CHEKBITS           EXTEND                                 	#
060541,000047: 16,2001           00031                           READ     CHAN31                        	# IF BOTH BIT13 AND BIT14 ARE ONE, THEN
060542,000048: 16,2002           40000                           COM                                    	# THE MODE SELECT SWITCH IS IN THE OFF
060543,000049: 16,2003           74355                           MASK     BIT13-14                      	# POSITION, AND SO THE DAP SHOULD BE OFF,
060544,000050: 16,2004           00006                           EXTEND                                 	# WITH NO ATTITUDE ERROR DISPLAY.
060545,000051: 16,2005           12157                           BZF      MOREIDLE                      	#
060546,000052: 
060547,000053: 16,2006           41303                           CS       IMODES33                      	#
060548,000054: 16,2007           74746                           MASK     BIT6                          	#
060549,000055: 16,2010           10000                           CCS      A                             	#
060550,000056: 16,2011           12206                           TCF      JUMPDSP                       	#
060551,000057: 16,2012           41273                           CS       RCSFLAGS                      	# IMU NOT USABLE.  SET UP INITIALIZATION
060552,000058: 16,2013           74751                           MASK     BIT3                          	# FLAG FOR ATT ERROR DISPLAY ROUTINE.
060553,000059: 16,2014           27273                           ADS      RCSFLAGS                      	#
060554,000060: 16,2015           12163                           TCF      SHUTDOWN                      	#
060555,000061: 
060556,000062: 16,2016           34742        CHEKMORE           CAF      BIT10                         	# BIT 10 OF 30 IS PGNCS CONTROL OF S/C
060557,000063: 16,2017           00006                           EXTEND                                 	#
060558,000064: 16,2020           02030                           RAND     CHAN30                        	# BITS IN 30 ARE INVERTED
060559,000065: 16,2021           10000                           CCS      A                             	#
060560,000066: 16,2022           12157                           TCF      MOREIDLE                      	#
060561,000067: 
060562,000068: 16,2023           00002                           RETURN                                 	#
060563,000069: 
060565,000071:                                                                                          	# DAPIDLER ENTRY.
060566,000072: 
060567,000073: 16,2024           22016        DAPIDLER           LXCH     BANKRUPT                      	# INTERRUPT LEAD INS (CONTINUED)
060568,000074: 16,2025           00006                           EXTEND                                 	#
060569,000075: 16,2026           22012                           QXCH     QRUPT                         	#
060570,000076: 
060571,000077: 16,2027           31273                           CA       RCSFLAGS                      	#
060572,000078: 16,2030           74737                           MASK     BIT13                         	#
060573,000079: 16,2031           10000                           CCS      A                             	# CHECK IF 1/ACCJOB HAS BEEN SET UP SINCE
060574,000080: 16,2032           12041                           TCF      CHECKUP                       	# THE LAST FRESH START OR RESTART.
060575,000081: 16,2033           34737                           CA       BIT13                         	#
060576,000082: 16,2034           27273                           ADS      RCSFLAGS                      	# BIT 13 IS 1.
060577,000083: 16,2035           37715                           CAF      PRIO27                        	#
060578,000084: 16,2036           05072                           TC       NOVAC                         	# SET UP JOB TO DO A LITTLE INITIALIZATION
060579,000085: 16,2037  E6,1537                                  EBANK=   AOSQ                          	#       AND EXECUTE 1/ACCS.
060580,000086: 16,2037           02447 40106                     2CADR    1/ACCSET                      	# (WILL BRANCH TO MOREIDLE ON ACCSOKAY)
060581,000087: 
060582,000088: 16,2041           02000        CHECKUP            TC       CHEKBITS                      	# CHECK TO SEE IF LM DAP IS TO GO ON AND
060583,000089:                                                                                          	#       DO ERROR DISPLAY.
060584,000090: 
060585,000091: 16,2042           30111                           CAE      DAPBOOLS                      	# IF 1/ACCS HAS NOT BEEN COMPLETED, IDLE.
060586,000092: 16,2043           74751                           MASK     ACCSOKAY                      	#       NOTE:   ONLY FRESH START AND RESTART
060587,000093: 16,2044           00006                           EXTEND                                 	#               KNOCK THIS BIT DOWN.
060588,000094: 16,2045           12157                           BZF      MOREIDLE                      	#
060589,000095: 
060590,000096: 16,2046           04674        STARTDAP           TC       IBNKCALL                      	# ZERO ATTITUDE ERROR AND DESIRED RATES.
060591,000097: 16,2047           40153                           FCADR    ZATTEROR                      	#
060592,000098: 16,2050           34755                           CAF      ZERO                          	# ********** INITIALIZE: **********
060593,000099: 16,2051           55524                           TS       TJP                           	#
060594,000100: 16,2052           55525                           TS       TJU                           	#
060595,000101: 16,2053           55526                           TS       TJV                           	#
060596,000102: 16,2054           55421                           TS       OMEGAP                        	# RATES IN BODY (PILOT) COORDINATES.
060597,000103: 16,2055           55422                           TS       OMEGAQ                        	#
060598,000104: 16,2056           55423                           TS       OMEGAR                        	#
060599,000105: 16,2057           55430                           TS       TRAPEDP                       	#
060600,000106: 16,2060           55431                           TS       TRAPEDQ                       	#
060601,000107: 16,2061           55432                           TS       TRAPEDR                       	#
060602,000108: 16,2062           55537                           TS       AOSQ                          	# OFFSET ACCELERATION ESTIMATES.
060603,000109: 16,2063           55540                           TS       AOSQ       +1                 	#
060604,000110: 16,2064           55541                           TS       AOSR                          	#
060605,000111: 16,2065           55542                           TS       AOSR       +1                 	#
060606,000112: 16,2066           55424                           TS       ALPHAQ                        	# COPIES OF OFFSET ESTIMATES FOR DOWNLIST.
060607,000113: 16,2067           55425                           TS       ALPHAR                        	#
060608,000114: 16,2070           55501                           TS       NEGUQ                         	#
060609,000115: 16,2071           55503                           TS       NEGUR                         	#
060610,000116: 16,2072           55545                           TS       AOSQTERM                      	# QRAXIS RATE DERIVATION TERMS AND KALMAN
060611,000117: 16,2073           55546                           TS       AOSRTERM                      	# FILTER INITIALIZATION TERMS.
060612,000118: 16,2074           55510                           TS       QACCDOT                       	# DESCENT ACCELERATION DERIVATIVE EST.
060613,000119: 16,2075           55512                           TS       RACCDOT                       	#
060615,000121: 16,2076           55502                           TS       ALLOWGTS                      	# AOSTASK FLAG FOR QRAXIS RCS CONTROL USE.
060616,000122: 16,2077           55631                           TS       COTROLER                      	# DO TRYGTS ON FIRST PASS (WILL GO TO RCS)
060617,000123: 16,2100           55633                           TS       INGTS                         	# RECOGNIZE FIRST GTS PASS AS SUCH.
060618,000124: 16,2101           55632                           TS       QGIMTIMR                      	# STOP GIMBAL DRIVES.  (PROBABLY WOULD BE
060619,000125: 16,2102           55634                           TS       RGIMTIMR                      	#       GOOD ENOUGH JUST TO INACTIVATE TIMERS)
060620,000126: 16,2103           55460                           TS       OLDPMIN                       	# MINIMUM IMPULSE MODE ERASABLES
060621,000127: 16,2104           55461                           TS       OLDQRMIN                      	#
060622,000128: 16,2105           55767                           TS       PJETCTR                       	# INITIALIZE DOCKED JET INHIBITION
060623,000129: 16,2106           55770                           TS       UJETCTR                       	# COUNTERS
060624,000130: 16,2107           55771                           TS       VJETCTR                       	#
060625,000131: 16,2110     4747               CALLGMBL           EQUALS   BIT5                          	# RCSFLAGS INITIALIZATION.
060626,000132: 16,2110           42202                           CS       MANFLAG                       	#
060627,000133: 16,2111           71273                           MASK     RCSFLAGS                      	# NEGUQ(R) HAVE BEEN GENERATED.
060628,000134: 16,2112           55273                           TS       RCSFLAGS                      	#
060629,000135: 
060630,000136:                                                                                          	# SET UP "OLD" MEASURED CDU ANGLES:
060631,000137: 
060632,000138: 16,2113           00006                           EXTEND                                 	#
060633,000139: 16,2114           30033                           DCA      CDUX                          	# OLDXFORP AND OLDYFORP
060634,000140: 16,2115           53441                           DXCH     OLDXFORP                      	#
060635,000141: 16,2116           30034                           CA       CDUZ                          	#
060636,000142: 16,2117           55442                           TS       OLDZFORQ                      	#
060637,000143: 16,2120           41273                           CS       RCSFLAGS                      	#
060638,000144: 16,2121           74740                           MASK     BIT12                         	#
060639,000145: 16,2122           27273                           ADS      RCSFLAGS                      	# BIT 12 SET TO 1.
060640,000146: 16,2123           34751                           CA       FOUR                          	#
060641,000147: 16,2124           55535                           TS       SKIPU                         	#
060642,000148: 16,2125           55536                           TS       SKIPV                         	#
060643,000149: 16,2126           34733                           CA       POSMAX                        	#
060644,000150: 16,2127           54031                           TS       TIME6                         	#
060645,000151: 16,2130           55466                           TS       T6NEXT                        	#
060646,000152: 16,2131           55470                           TS       T6FURTHA                      	#
060647,000153: 16,2132           34755                           CA       ZERO                          	#
060648,000154: 16,2133           55467                           TS       T6NEXT     +1                 	#
060649,000155: 16,2134           55471                           TS       T6FURTHA   +1                 	#
060650,000156: 16,2135           55465                           TS       NXT6ADR                       	#
060651,000157: 16,2136           55472                           TS       NEXTP                         	#
060652,000158: 16,2137           55473                           TS       NEXTU                         	#
060653,000159: 16,2140           55474                           TS       NEXTV                         	#
060654,000160: 16,2141           44363                           CS       TEN                           	#
060655,000161: 16,2142           55757                           TS       DAPZRUPT                      	# JASK NOT IN PROGRESS, INITIALIZE NEG.
060656,000162: 16,2143           34752                           CA       TWO                           	#
060657,000163: 16,2144           55433                           TS       NPTRAPS                       	#
060658,000164: 16,2145           55434                           TS       NQTRAPS                       	#
060659,000165: 16,2146           55435                           TS       NRTRAPS                       	#
060660,000166: 16,2147           00006                           EXTEND                                 	#
060661,000167: 16,2150           32205                           DCA      PAXADIDL                      	#
060662,000168: 16,2151           53275                           DXCH     T5ADR                         	#
060663,000169: 16,2152           37727        SETTIME5           CAF      MS100                         	#
060664,000170: 16,2153           54030                           TS       TIME5                         	#
060666,000172: 16,2154           15270                           TCF      RESUME                        	#
060667,000173: 16,2155  E6,1537                                  EBANK=   AOSQ                          	#
060668,000174: 16,2155           02024 34106  IDLERADR           2CADR    DAPIDLER                      	#
060669,000175: 
060670,000176: 16,2157           04674        MOREIDLE           TC       IBNKCALL                      	# CALCULATE Q,R-AXES ATTITUDE ERRORS.
060671,000177: 16,2160           36626                           CADR     QERRCALC                      	#
060672,000178: 
060673,000179: 16,2161           04674                           TC       IBNKCALL                      	#
060674,000180: 16,2162           35446                           CADR     CALCPERR                      	# CALCULATE P AXIS ATTITUDE ERRORS.
060675,000181: 

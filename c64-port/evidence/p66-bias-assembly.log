061042,000062: 16,2221           05634                           TC       BAILOUT                       	# STILL IN PROGRESS AND A RESTART IS
061043,000063: 16,2222           02000                           OCT      02000                         	# CALLED FOR.  IT IS NEVER ZERO.
061044,000064: 
061045,000065: 16,2223           02000                           TC       CHEKBITS                      	# RETURN IS TO I+1 IF DAP SHOULD STAY ON.

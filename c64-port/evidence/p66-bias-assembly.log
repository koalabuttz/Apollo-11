042115,001620:                                                                                          	# FIND GIMBAL ANGLES WHICH ROTATE SM 180 DEG ABOUT G VEC
042116,001621: 
042117,001622:                                                                                          	#       DEFINE G COOR SYS
042118,001623:                                                                                          	#                     -
042119,001624:                                                                                          	#                     X          UNIT G     
042120,001625:                                                                                          	#               *     -                  - 
042121,001626:                                                                                          	#               M =   Y   =   UNITEZSM * X )
042122,001627:                                                                                          	#                     -            -     -   
042123,001628:                                                                                          	#                     Z       UNIT(X   * Y )
042124,001629: 
042125,001630:                                                                                          	#       THEN ROTATED SM WRT PRESENT IS
042126,001631: 
042127,001632:                                                                                          	#                            1,  0,  0  
042128,001633:                                                                                          	#                *      *T               *             *      *
042130,001635:                                                                                          	#               XSM =   M    0, -1,  0   M  =  2 (X X ) - 1/2 I  *
042131,001636:                                                                                          	#                                                  I J
042132,001637:                                                                                          	#                            0,  0, -1 
042133,001638: 
042134,001639:                                                                                          	#       ALSO NB WRT PRES SM IS
042135,001640: 
042136,001641:                                                                                          	#                *      *  *
042137,001642:                                                                                          	#               XNB = NBSM I
042138,001643:                                                                                          	#                                *    *

034384,000303: 31,2154           43014                           SET      CLEAR                         	#
034385,000304: 31,2155           04067                                    SURFFLAG                      	#
034386,000305: 31,2156           04666                                    LETABORT                      	#
034387,000306: 31,2157           77214                           SET      VLOAD                         	#
034388,000307: 31,2160           05062                                    APSFLAG                       	#
034389,000308: 31,2161           01221                                    RN                            	#
034390,000309: 31,2162           16032                           STODL    ALPHAV                        	#

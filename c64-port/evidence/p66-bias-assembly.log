048451,000185:                                                                                          	# B2XSC = B**2 SCALED B-51
048452,000186:                                                                                          	# B2/A2 = B**2/A**2 SCALED B-1
048453,000187:                                                                                          	# EE = (1-B**2/A**2) SCALED B-0

047726,000025: 
047727,000026:                                                                                          	# Notations on the hardcopy document read, in part:
047728,000027: 
047729,000028:                                                                                          	#       Assemble revision 001 of AGC program LMY99 by NASA 2021112-061
047730,000029:                                                                                          	#       16:27 JULY 14, 1969
047731,000030: 
047732,000031:                                                                                          	# Page 1117
047733,000032:                                                                                          	# PROGRAM DESCRIPTION                                                           DATE -- 10 OCTOBER 1966
047734,000033:                                                                                          	# MOD NO -- 2                                                                   LOG SECTION -- WAITLIST
047735,000034:                                                                                          	# MOD BY -- MILLER      (DTMAX INCREASED TO 162.5 SEC)                          ASSEMBLY -- SUNBURST REV 5
047736,000035:                                                                                          	# MOD 3 BY KERNAN       (INHINT INSERTED AT WAITLIST) 2/28/68 SKIPPER REV 4
047737,000036:                                                                                          	# MOD 4 BY KERNAN       (TWIDDLE IN 54) 3/28/68 SKIPPER REV 13.
047738,000037: 
047739,000038:                                                                                          	# FUNCTIONAL DESCRIPTION --
047740,000039:                                                                                          	#       PART OF A SECTION OF PROGRAMS -- WAITLIST, TASKOVER, T3RUPT, USED TO CALL A PROGRAM (CALLED A TASK),
047741,000040:                                                                                          	#       WHICH IS TO BEGIN IN C(A) CENTISECONDS.  WAITLIST UPDATES TIME3, LST1, AND LST2.  THE MEANING OF THESE LISTS
047742,000041:                                                                                          	#       FOLLOW.
047743,000042: 
047744,000043:                                                                                          	#               C(TIME3) = 16384 -(T1-T) CENTISECONDS, (T=PRESENT TIME, T1-TIME FOR TASK1)
047745,000044: 
047746,000045:                                                                                          	#                       C(LST1)         =       -(T2-T1)+1
047747,000046:                                                                                          	#                       C(LST1 +1)      =       -(T3-T2)+1
047748,000047:                                                                                          	#                       C(LST1 +2)      =       -(T4-T3)+1
047749,000048:                                                                                          	#                                      ...
047750,000049:                                                                                          	#                       C(LST1 +6)      =       -(T8-T7)+1
047751,000050:                                                                                          	#                       C(LST1 +7)      =       -(T9-T8)+1
047752,000051: 
047753,000052:                                                                                          	#                       C(LST2)         =       2CADR OF TASK1
047754,000053:                                                                                          	#                       C(LST2 +2)      =       2CADR OF TASK2
047755,000054:                                                                                          	#                                      ...
047756,000055:                                                                                          	#                       C(LST2 +14)     =       2CADR OF TASK8
047757,000056:                                                                                          	#                       C(LST2 +16)     =       2CADR OF TASK9
047758,000057: 
047759,000058:                                                                                          	# WARNINGS --
047760,000059:                                                                                          	#       1)      1 <= C(A) <= 16250D (1 CENTISECOND TO 162.5 SEC)
047761,000060:                                                                                          	#       2)      9 TASKS MAXIMUM
047762,000061:                                                                                          	#       3)      TASKS CALLED UNDER INTERRUPT INHIBITED
047763,000062:                                                                                          	#       4)      TASKS END BY TC TASKOVER
047764,000063: 
047765,000064:                                                                                          	# CALLING SEQUENCE --
047766,000065:                                                                                          	#       L-1     CA      DELTAT  (TIME IN CENTISECONDS TO TASK START)
047767,000066:                                                                                          	#       L       TC      WAITLIST
047768,000067:                                                                                          	#       L+1     2CADR   DESIRED TASK.
047769,000068:                                                                                          	#       L+2     (MINOR OF 2CADR)
047770,000069:                                                                                          	#       L+3     RELINT          (RETURNS HERE)
047771,000070: 
047772,000071:                                                                                          	# TWIDDLE --
047773,000072:                                                                                          	#       TWIDDLE IS FOR USE WHEN THE TASK BEING SET UP IS IN THE SAME EBANK AND FBANK AS THE USER.  IN
047774,000073:                                                                                          	#       SUCH CASES, IT IMPROVES UPON WAITLIST BY ELIMINATING THE NEED FOR THE BBCON HALF OF THE 2CADR,
047775,000074:                                                                                          	# Page 1118
047776,000075:                                                                                          	#       SAVING A WORD.  TWIDDLE IS LIKE WAITLIST IN EVERY RESPECT EXCEPT CALLING SEQUENCE, TO WIT,
047777,000076:                                                                                          	#               L-1     CA      DELTAT
047778,000077:                                                                                          	#               L       TC      TWIDDLE
047779,000078:                                                                                          	#               L+1     ADRES   DESIRED TASK
047780,000079:                                                                                          	#               L+2     RELINT          (RETURNS HERE)
047781,000080: 
047782,000081:                                                                                          	# NORMAL EXIT MODES --
047783,000082:                                                                                          	#       AT L+3 OF CALLING SEQUENCE.
047784,000083: 
047785,000084:                                                                                          	# ALARM OR ABORT EXIT MODES --
047786,000085:                                                                                          	#       TC      ABORT

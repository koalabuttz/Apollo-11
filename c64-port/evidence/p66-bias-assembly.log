056991,000821: 07,3723           13741                           TCF      MODABORT                      	# ALLOWABLE STATES ARE +0, -1, AND -0.
056992,000822: 07,3724           13735                           TCF      MODESLP                       	# OPERATION INCOMPLETE.
056993,000823: 07,3725           13731                           TCF      MODEGOOD                      	# COMPLETE AND GOOD IF = -1.
056994,000824: 
056995,000825: 07,3726           50071        MG2                INDEX    RUPTREG2                      	# COMPLETE AND FAILED IF -0.  RESET TO +0.
056996,000826: 07,3727           55304                           TS       MODECADR                      	# RETURN TO CALLER.
056997,000827: 07,3730           12755                           TCF      MODEEXIT                      	#
056998,000828: 
056999,000829: 07,3731           10000        MODEGOOD           CCS      A                             	# MAKE SURE INITIAL STATE -1.
057000,000830: 07,3732           13741                           TCF      MODABORT                      	#
057001,000831: 
057002,000832: 07,3733           24133                           INCR     BUF2                          	# IF SO, INCREMENT RETURN ADDRESS AND
057003,000833: 07,3734           13726                           TCF      MG2                           	# RETURN IMMEDIATELY, SETTING CADR = +0.
057004,000834: 
057005,000835: 07,3735           04645        MODESLP            TC       MAKECADR                      	# CALL FROM SWITCHABLE FIXED ONLY.
057006,000836: 07,3736           50071                           INDEX    RUPTREG2                      	#
057007,000837: 07,3737           55304                           TS       MODECADR                      	#
057008,000838: 07,3740           15133                           TCF      JOBSLEEP                      	#
057009,000839: 
057010,000840: 07,3741           52134        MODABORT           DXCH     BUF2                          	#
057011,000841: 07,3742           05716                           TC       BAILOUT1                      	# TWO PROGRAMS USING THE SAME DEVICE.
057012,000842: 07,3743           01210                           OCT      1210                          	#

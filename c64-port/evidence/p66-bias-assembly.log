048656,000076: 26,3731           00025                                    MMATRIX                       	# MPAC=R=MT(T)*(RP+LPXRP)
048657,000077: 26,3732           51706                                    RPRPXXXX                      	# RESET PUSHLOC TO 0 BEFORE EXITING
048658,000078: 26,3733           77624        RPTORA             CALL                                   	# EARTH COMPUTATIONS
048659,000079: 26,3734           55743                                    EARTHMX                       	# M MATRIX B-1
048660,000080: 26,3735           77624                           CALL                                   	#
048661,000081: 26,3736           15753                                    EARTHL                        	# L VECTOR RADIANS B0
048662,000082: 26,3737           76521                           MXV      VSL1                          	# LP=M(T)*L  RAD B-0
048663,000083: 26,3740           00025                                    MMATRIX                       	#
048665,000085: 26,3741           77650                           GOTO                                   	#
048666,000086: 26,3742           55725                                    RPTORB                        	#

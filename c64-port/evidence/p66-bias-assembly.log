054431,000216:                                                                                          	# SUBROUTINE NAME:  TFFRP/RA                                              DATE: 01.17.67
054432,000217:                                                                                          	# MOD NO:  0                                                              LOG SECTION:  TIME OF FREE FALL
054433,000218:                                                                                          	# MOD NO:  1    MOD BY:  RR BAIRNSFATHER      DATE:  11 APR 67
054434,000219:                                                                                          	# MOD NO:  2    MOD BY:  RR BAIRNSFATHER      DATE:  21 MAR 68            ACCEPT DIFFERENT EARTH/MOON SCALES
054435,000220:                                                                                          	#                                                                         ALSO IMPROVE ACCURACY OF RAPO.
054436,000221:                                                                                          	# FUNCTIONAL DESCRIPTION:         USED BY CALCTPER AND TFF DISPLAYS TO CALCULATE PERIGEE RADIUS AND ALSO
054437,000222:                                                                                          	#          APOGEE RADIUS FOR A GENERAL CONIC.
054438,000223:                                                                                          	#          PROGRAM GIVES PERIGEE RADIUS AS               APOGEE RADIUS IS GIVEN BY
054439,000224:                                                                                          	#                 RP = P /(1+E)                                 RA = (1+E) / ALFA
054440,000225:                                                                                          	#          WHERE   2
054441,000226:                                                                                          	#                 E  = 1 - P ALFA
054442,000227:                                                                                          	#          IF RA IS NEGATIVE OR SHOWS DIVIDE OVERFLOW, THEN RA = POSMAX BECAUSE
054443,000228:                                                                                          	#                 1. APOGEE RADIUS IS NOT MEANINGFUL FOR HYPERBOLA
054444,000229:                                                                                          	#                 2. APOGEE RADIUS IS NOT DEFINED FOR PARABOLA
054445,000230:                                                                                          	#                 3. APOGEE RADIUS EXCEEDS THE SCALING FOR ELLIPSE.
054446,000231:                                                                                          	#          THIS SUBROUTINE REQUIRED THE SIGNED RECIPROCAL SEMI MAJ AXIS, ALFA, AND SEMI-LATUS RECTUM AS DATA.
054447,000232:                                                                                          	# CALLING SEQUENCE:  CALL
054448,000233:                                                                                          	#                           TFFRP/RA
054449,000234:                                                                                          	#          PUSHLOC = PDL+0, ARBITRARY IF LEQ 10D
054450,000235:                                                                                          	#          C(MPAC) UNSPECIFIED
054451,000236: 
054452,000237:                                                                                          	# SUBROUTINES CALLED:  NONE
054453,000238:                                                                                          	# NORMAL EXIT MODE:    RVQ
054454,000239:                                                                                          	#          IF ELLIPSE, WITHIN NORMAL SCALING, RAPO IS CORRECT.
054455,000240:                                                                                          	#          OTHERWISE, RAPO = POSMAX.
054456,000241:                                                                                          	# ALARMS:  NONE
054457,000242:                                                                                          	# OUTPUT:  STORED IN PUSH LIST AREA. SCALE OF OUTPUT AGREES WITH DATA SUPPLIED TO  TFF/CONIC.
054458,000243:                                                                                          	#          RPER   E:(-29)  M:(-27)  M     PERIGEE RADIUS                  DESTROYED BY CALCTFF/CALCTPER, TFFTRIG.
054459,000244:                                                                                          	#          RAPO   E:(-29)  M:(-27)  M     APOGEE  RADIUS                  WILL BE DESTROYED BY CALCTFF/CALCTPER
054460,000245:                                                                                          	#          PUSHLOC AT PDL+0
054461,000246:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:
054462,000247:                                                                                          	#          TFFALFA E:(26-NR)      M   1/SEMI MAJ AXIS                     LEFT BY TFFCONIC
054463,000248:                                                                                          	#                  M:(24-NR)
054464,000249:                                                                                          	#          TFFNP  E: (-38+2NR)    M  LC P, SEMI LATUS RECTUM              LEFT BY TFFCONIC
054465,000250:                                                                                          	#                 M: (-36+2NR)
054466,000251:                                                                                          	#          X1                     -NR, NORM COUNT OF RMAG                 LEFT BY TFFCONIC
054467,000252:                                                                                          	#          X2                     -NA, NORM COUNT OF ALFA                 LEFT BY TFFCONIC
054468,000253: 

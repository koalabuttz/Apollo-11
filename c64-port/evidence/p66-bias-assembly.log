060171,000028:                                                                                          	##
060172,000029:                                                                                          	## Notations on the hardcopy document read, in part:
060173,000030:                                                                                          	##
060174,000031:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
060175,000032:                                                                                          	##      16:27 JULY 14, 1969 
060176,000033: 
060178,000035:                                                                                          	# PROGRAM NAMES:        (1) T6JOBCHK    MOD. NO. 5      OCTOBER 2, 1967
060179,000036:                                                                                          	#                       (2) DOT6RUPT
060180,000037:                                                                                          	# MODIFICATION BY:      LOWELL G HULL (A.C.ELECTRONICS)
060181,000038: 
060182,000039:                                                                                          	# THESE PROGRAMS ENABLE THE LM DAP TO CONTROL THE THRUST TIMES OF THE REACTION CONTROL SYSTEM JETS BY USING TIME6.
060183,000040:                                                                                          	# SINCE THE LM DAP MAINTAINS EXCLUSIVE CONTROL OVER TIME6 AND ITS INTERRUPTS, THE FOLLOWING CONVENTIONS HAVE BEEN
060184,000041:                                                                                          	# ESTABLISHED AND MUST NOT BE TAMPERED WITH:
060185,000042:                                                                                          	#       1.      NO NUMBER IS EVER PLACED INTO TIME6 EXCEPT BY LM DAP.
060186,000043:                                                                                          	#       2.      NO PROGRAM OTHER THAN LM DAP ENABLES THE TIME6 COUNTER.
060187,000044:                                                                                          	#       3.      TO USE TIME6, THE FOLLOWING SEQUENCE IS ALWAYS EMPLOYED:
060188,000045:                                                                                          	#               A.      A POSITIVE (NON-ZERO) NUMBER IS STORED IN TIME6.
060189,000046:                                                                                          	#               B.      THE TIME6 CLOCK IS ENABLED.
060190,000047:                                                                                          	#               C.      TIME6 IS INTERROGATED AND IS:
060191,000048:                                                                                          	#                       I.      NEVER FOUND NEGATIVE (NON-ZERO) OR +0.
060192,000049:                                                                                          	#                       II.     SOMETIMES FOUND POSITIVE (BETWEEN 1 AND 240D) INDICATING THAT IT IS ACTIVE.
060193,000050:                                                                                          	#                       III.    SOMETIMES FOUND POSMAX INDICATING THAT IT IS INACTIVE AND NOT ENABLED.
060194,000051:                                                                                          	#                       IV.     SOMETIMES FOUND NEGATIVE ZERO INDICATING THAT:
060195,000052:                                                                                          	#                               A.      A T6RUPT IS ABOUT TO OCCUR AT THE NEXT DINC, OR
060196,000053:                                                                                          	#                               B.      A T6RUPT IS WAITING IN THE PRIORITY CHAIN, OR
060197,000054:                                                                                          	#                               C.      A T6RUPT IS IN PROCESS NOW.
060198,000055:                                                                                          	#       4)      ALL PROGRAMS WHICH OPERATE IN EITHER INTERRUPT MODE OR WITH INTERRUPT INHIBITED MUST CALL T6JOBCHK
060199,000056:                                                                                          	#               EVERY 5 MILLISECONDS TO PROCESS A POSSIBLE WAITING T6RUPT BEFORE IT CAN BE HONORED BY THE HARDWARE.
060200,000057:                                                                                          	#      (5.      PROGRAM JTLST, IN Q,R-AXES, HANDLES THE INPUT LIST.)
060201,000058: 
060202,000059:                                                                                          	# T6JOBCHK CALLING SEQUENCE:
060203,000060:                                                                                          	#               L       TC      T6JOBCHK
060204,000061:                                                                                          	#               L+1     (RETURN)
060205,000062: 
060206,000063:                                                                                          	# DOT6RUPT CALLING SEQUENCE:
060207,000064:                                                                                          	#                       DXCH    ARUPT           T6RUPT LEAD IN AT LOCATION 4004.
060208,000065:                                                                                          	#                       EXTEND
060209,000066:                                                                                          	#                       DCA     T6ADR
060210,000067:                                                                                          	#                       DTCB
060211,000068: 
060212,000069:                                                                                          	# SUBROUTINES CALLED:   DOT6RUPT CALLS T6JOBCHK.
060213,000070: 
060214,000071:                                                                                          	# NORMAL EXIT MODES:    T6JOBCHK RETURNS TO L +1.
060215,000072:                                                                                          	#                       DOT6RUPT TRANSFERS CONTROL TO RESUME.
060216,000073: 
060217,000074:                                                                                          	# ALARM/ABORT MODES:    NONE.
060218,000075: 
060219,000076:                                                                                          	# INPUT:        TIME6           NXT6ADR         OUTPUT:         TIME6           NXT6ADR         CHANNEL 5
060220,000077:                                                                                          	#               T6NEXT          T6NEXT +1                       T6NEXT          T6NEXT +1       CHANNEL 6
060221,000078:                                                                                          	#               T6FURTHA        T6FURTHA +1                     T6FURTHA        T6FURTHA +1     BIT15/CH13
060222,000079: 
060223,000080:                                                                                          	# DEBRIS:       T6JOBCHK CLOBBERS A.  DOT6RUPT CLOBBERS NOTHING.
060224,000081: 
060225,000082:    5753                                           BLOCK    02                            	#
060227,000084: 17,2027                                           BANK     17                            	#
060228,000085: 17,2000                                           SETLOC   DAPS2                         	#
060229,000086: 17,2000                                           BANK                                   	#
060230,000087: 17,2027  E6,1466                                  EBANK=   T6NEXT                        	#
060231,000088: 17,2027                                           COUNT*   $$/DAPT6                      	#
060232,000089: 
060233,000090: 17,2027           10031        T6JOBCHK           CCS      TIME6                         	# CHECK TIME6 FOR WAITING T6RUPT:
060234,000091: 17,2030           00002                           TC       Q                             	# NONE: CLOCK COUTING DOWN.
060235,000092: 17,2031           05705                           TC       CCSHOLE                       	#
060236,000093: 17,2032           02032                           TC       T6JOBCHK   +3                 	#
060237,000094: 
060238,000095:                                                                                          	# CONTROL PASSES TO T6JOB ONLY WHEN C(TIME6) = -0 (I.E. WHEN A T6RUPT MUST BE PROCESSED).
060239,000096: 
060240,000097: 17,2033           34733        T6JOB              CAF      POSMAX                        	# DISABLE CLOCK: NEEDED SINCE RUPT OCCURS
060241,000098: 17,2034           00006                           EXTEND                                 	# 1 DINC AFTER T6 = 77777. FOR 625 MUSECS
060242,000099: 17,2035           03013                           WAND     CHAN13                        	# MUST NOT HAVE T6 = +0 WITH ENABLE SET
060243,000100: 
060244,000101: 17,2036           34733                           CA       POSMAX                        	#
060245,000102: 17,2037           22007                           ZL                                     	#
060246,000103: 17,2040           53471                           DXCH     T6FURTHA                      	#
060247,000104: 17,2041           53467                           DXCH     T6NEXT                        	#
060248,000105: 17,2042           23465                           LXCH     NXT6ADR                       	#
060249,000106: 17,2043           54031                           TS       TIME6                         	#
060250,000107: 
060251,000108: 17,2044           67725                           AD       PRIO37                        	#
060252,000109: 17,2045           54000                           TS       A                             	#
060253,000110: 17,2046           12052                           TCF      ENABLET6                      	#
060254,000111: 17,2047           34733                           CA       POSMAX                        	#
060255,000112: 17,2050           54031                           TS       TIME6                         	#
060256,000113: 17,2051           12063                           TCF      GOCH56                        	#
060257,000114: 17,2052           34735        ENABLET6           CA       BIT15                         	#
060258,000115: 17,2053           00006                           EXTEND                                 	#
060259,000116: 17,2054           05013                           WOR      CHAN13                        	#
060260,000117: 17,2055           31466                           CA       T6NEXT                        	#
060261,000118: 17,2056           67725                           AD       PRIO37                        	#
060262,000119: 17,2057           54000                           TS       A                             	#
060263,000120: 17,2060           12063                           TCF      GOCH56                        	#
060264,000121: 17,2061           34733                           CA       POSMAX                        	#
060265,000122: 17,2062           55466                           TS       T6NEXT                        	#
060266,000123: 17,2063           50001        GOCH56             INDEX    L                             	#
060267,000124: 17,2064           15753                           TCF      WRITEP     -1                 	#
060268,000125: 
060269,000126:    5753                                           BLOCK    02                            	#
060270,000127:    4000                                           SETLOC   FFTAG9                        	#
060271,000128:    4000                                           BANK                                   	#
060272,000129:    5753  E6,1635                                  EBANK=   CDUXD                         	#
060273,000130:    5753                                           COUNT*   $$/DAPT6                      	#
060274,000131: 
060275,000132:    5753           31472                           CA       NEXTP                         	#
060276,000133:    5754           00006        WRITEP             EXTEND                                 	#
060277,000134:    5755           01006                           WRITE    CHAN6                         	#
060279,000136:    5756           00002                           TC       Q                             	#
060280,000137: 
060281,000138:    5757           31473                           CA       NEXTU                         	#
060282,000139:    5760           54001        WRITEU             TS       L                             	#
060283,000140:    5761           45774                           CS       00314OCT                      	#
060284,000141:    5762           00006                           EXTEND                                 	#
060285,000142:    5763           02005                           RAND     CHAN5                         	#
060286,000143:    5764           60001                           AD       L                             	#
060287,000144:    5765           00006                           EXTEND                                 	#
060288,000145:    5766           01005                           WRITE    CHAN5                         	#
060289,000146:    5767           00002                           TC       Q                             	#
060290,000147: 
060291,000148:    5770           31474                           CA       NEXTV                         	#
060292,000149:    5771           54001        WRITEV             TS       L                             	#
060293,000150:    5772           35774                           CA       00314OCT                      	#
060294,000151:    5773           15762                           TCF      -9D                           	#
060295,000152:    5774           00314        00314OCT           OCT      00314                         	#
060296,000153: 
060297,000154: 17,2065                                           BANK     17                            	#
060298,000155: 17,2000                                           SETLOC   DAPS2                         	#
060299,000156: 17,2000                                           BANK                                   	#
060300,000157: 
060301,000158: 17,2065  E6,1466                                  EBANK=   T6NEXT                        	#
060302,000159: 17,2065                                           COUNT*   $$/DAPT6                      	#
060303,000160: 
060304,000161: 17,2065           22016        DOT6RUPT           LXCH     BANKRUPT                      	# (INTERRUPT LEAD INS CONTINUED)
060305,000162: 17,2066           00006                           EXTEND                                 	#
060306,000163: 17,2067           22012                           QXCH     QRUPT                         	#
060307,000164: 
060308,000165: 17,2070           02027                           TC       T6JOBCHK                      	# CALL T6JOBCHK.
060309,000166: 
060310,000167: 17,2071           15270                           TCF      RESUME                        	# END TIME6 INTERRUPT PROCESSOR.
060311,000168: 

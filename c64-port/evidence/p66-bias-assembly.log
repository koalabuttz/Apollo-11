023324,002128:                                                                                          	# PROGRAM NAME_  RRDESSM                                                        R (HALF-UNIT) IN RRTARGET. REMODES IF
023325,002129: 
023326,002130:                                                                                          	# FUNCTIONAL DESCRIPTION_
023327,002131: 
023328,002132:                                                                                          	#       THIS INTERPRETIVE ROUTINE WILL DESIGNATE, IF DESIRED ANGLES ARE
023329,002133:                                                                                          	#       WITHIN THE LIMITS OF EITHER MODE, TO A LINE-OF SIGHT (LOS) VECTOR
023330,002134:                                                                                          	#       (HALF-UNIT) KNOWN WITH RESPECT TO THE STABLE MEMBER PRESENT
023331,002135:                                                                                          	#       ORIENTATION.  INITIALLY THE IMU CDU:S ARE READ AND CONTROL
023332,002136:                                                                                          	#       TRANSFERRED TO SMNB TO TRANSFORM THE LOS VECTOR FROM STABLE
023333,002137:                                                                                          	#       MEMBER TO NAVIGATION BASE COORDINATES (SEE STG MEMO -699)
023334,002138:                                                                                          	#       RRANGLES IS THEN CALLED TO CALCULATE THE RR GIMBAL ANGLES,
023335,002139:                                                                                          	#       TRUNNION AND SHAFT, FOR BOTH THE PRESENT AND ALTERNATE MODE.
023336,002140:                                                                                          	#       RRLIMCHK IS CALLED TO SEE IF THE ANGLES CALCULATED FOR THE
023337,002141:                                                                                          	#       PRESENT MODE ARE WITHIN LIMITS.  IF WITHIN LIMITS, THE RETURN
023338,002142:                                                                                          	#       LOCATION IS INCREMENTED, INASMUCH AS NO VEHICLE MANEUVER IS
023339,002143:                                                                                          	#       REQUIRED, BEFORE EXITING TO STARTDES.  IF NOT WITHIN LIMITS OF THE
023340,002144:                                                                                          	#       CURRENT MODE, TRYSWS IS CALLED.  FOLLOWING INVERTING OF THE RR
023341,002145:                                                                                          	#       ANTENNA MODE FLAG (RADMODES BIT 12), RRLIMCHK IS CALLED
023342,002146:                                                                                          	#       TO SEE IF THE ANGLES CALCULATED FOR THE ALTERNATE MODE ARE WITHIN
023343,002147:                                                                                          	#       LIMITS.  IF YES, THE RR ANTENNA MODE FLAG IS AGAIN INVERTED,
023344,002148:                                                                                          	#       THE REMODE FLAG (RADMODES BIT 14) SET, AND THE RETURN LOCATION
023345,002149:                                                                                          	#       INCREMENTED, TO INDICATE NO VEHICLE MANEUVER IS REQUIRED, BEFORE
023346,002150:                                                                                          	#       EXITING TO STARTDES.  IF THESE ANGLES ARE NOT WITHIN LIMITS
023347,002151:                                                                                          	#       OF THE ALTERNATE MODE, THE RR ANTENNA MODE FLAG (RADMODES
023348,002152:                                                                                          	#       BIT 12) IS INVERTED BEFORE RETURNING DIRECTLY TO THE CALLING PROGRAM
023349,002153:                                                                                          	#       TO INDICATE THAT A VEHICLE MANEUVER IS REQUIRED.
023350,002154: 
023351,002155:                                                                                          	# CALLING SEQUENCE:
023352,002156: 
023353,002157:                                                                                          	#       L       STCALL  RRTARGET        (LOS HALF-UNIT VECTOR IN SM COORDINATES)
023354,002158:                                                                                          	#       L+1     RRDESSM
023355,002159:                                                                                          	#       L+2     BASIC                   (VEHICLE MANEUVER REQUIRED)
023356,002160:                                                                                          	#       L+3     BASIC                   (NO VEHICLE MANEUVER REQUIRED)

054510,000295:                                                                                          	# SUBROUTINE NAME:     CALCTPER / CALCTFF                                 DATE:  01.29.67
054511,000296:                                                                                          	# MOD NO:  0                                                              LOG SECTION:  TIME OF FREE FALL
054512,000297:                                                                                          	# MOD BY:  RR BAIRNSFATHER
054513,000298:                                                                                          	# MOD NO:  1           MOD BY:  RR BAIRNSFATHER DATE: 21 MAR 67
054514,000299:                                                                                          	# MOD NO:  2           MOD BY:  RR BAIRNSFATHER DATE: 14 APR 67
054515,000300:                                                                                          	# MOD BY:  3           MOD BY:  RR BAIRNSFATHER DATE: 8 JUL 67            NEAR EARTH MUE AND NEG TFF (GONEPAST)
054516,000301:                                                                                          	# MOD BY:  4           MOD BY:  RR BAIRNSFATHER DATE: 21 NOV 67           ADD VARIABLE MU.
054517,000302:                                                                                          	# MOD BY:  5           MOD BY:  RR BAIRNSFATHER DATE: 21 MAR 68           ACCEPT DIFFERENT EARTH/MOON SCALES
054518,000303:                                                                                          	# FUNCTIONAL DESCRIPTION:      PROGRAM CALCULATES THE FREE-FALL TIME OF FLIGHT FROM PRESENT POSITION  RN  AND
054519,000304:                                                                                          	#          VELOCITY  VN  TO A RADIUS LENGTH SPECIFIED BY  RTERM  , SUPPLIED BY THE USER. THE POSITION VECTOR
054520,000305:                                                                                          	#          RN  MAY BE ON EITHER SIDE OF THE CONIC, BUT  RTERM  IS CONSIDERED ON THE INBOUND SIDE.
054521,000306:                                                                                          	#          THE EQUATIONS ARE
054522,000307: 
054523,000308:                                                                                          	#                 Q2 = -SQRT(RTERM (2-RTERM ALFA) - LCP)    (INBOUND SIDE))        LEQ +- LCE/SQRT(ALFA)
054524,000309:                                                                                          	#                      _  _
054525,000310:                                                                                          	#                 Q1 = RN.VN / SQRT(MU)                                            LEQ +- LCE/SQRT(ALFA)
054526,000311: 
054527,000312:                                                                                          	#                 Z = NUM / DEN                                                    LEQ +- 1/SQRT(ALFA)
054528,000313: 
054529,000314:                                                                                          	#          WHERE, IF INBOUND
054530,000315:                                                                                          	#                 NUM = RTERM -RN                                                  LEQ +- 2 LCE/ALFA
054531,000316:                                                                                          	#                 DEN = Q2+Q1                                                      LEQ +- 2 LCE/SQRT(ALFA)
054532,000317: 
054533,000318:                                                                                          	#          AND, IF OUTBOUND
054534,000319:                                                                                          	#                 NUM = Q2-Q1                                                      LEQ +- 2 LCE/SQRT(ALFA)
054535,000320:                                                                                          	#                 DEN = 2 - ALFA (RTERM + RN) .                                    LEQ +- 2 LCE
054536,000321: 
054537,000322:                                                                                          	#          IF     ALFA ZZ < 1.0                 (FOR ALL CONICS EXCEPT ELLIPSES HAVING ABS(DEL ECC ANOM) G 90 DEG)
054538,000323: 
054539,000324:                                                                                          	#          THEN   X = ALFA Z Z
054540,000325:                                                                                          	#          AND    TFF = (RTERM +RN -2 ZZ T(X) ) Z/SQRT(MU)
054541,000326: 
054542,000327:                                                                                          	#                 EXCEPT IF ALFA PNZ, AND IF TFF NEG,
054543,000328:                                                                                          	#                 THEN   TFF = 2 PI /(ALFA SQRT(ALFA)) + TFF
054544,000329: 
054545,000330:                                                                                          	#          OR IF  ALFA ZZ  GEQ  1.0             (FOR ELLIPSES HAVING ABS(DEL ECC ANOM) GEQ 90 DEG)
054546,000331:                                                                                          	#          THEN   X = 1/ALFA Z Z
054547,000332:                                                                                          	#          AND    TFF = (PI/SQRT(ALFA) -Q2 +Q1 +2(X T(X) -1) /ALFA Z) /ALFA SQRT(MU)
054548,000333: 
054549,000334:                                                                                          	#          WHERE  T(X) IS A POLYNOMIAL APPROXIMATION TO THE SERIES
054550,000335:                                                                                          	#                            2     3                        2
054551,000336:                                                                                          	#                 1/3 -X/5 +X /7 -X /9 ...                (X   <  1.0)
054552,000337: 
054553,000338:                                                                                          	# CALLING SEQUENC:   TIME TO RTERM                           TIME TO PERIGEE
054554,000339:                                                                                          	#                    CALL                                    CALL
054555,000340:                                                                                          	#                           CALCTFF                                 CALCTPER
054556,000341:                                                                                          	#                    C(MPAC) = TERMNL RAD  M                 C(MPAC) = PERIGEE RAD  M
054557,000342:                                                                                          	#          FOR EITHER,   E: (-29)    M: (-27)
054558,000343:                                                                                          	#          FOR EITHER, PUSHLOC = PDL+0 , ARBITRARY IF LEQ 8D.
054560,000345: 
054561,000346:                                                                                          	# SUBROUTINES CALLED:  T(X),  VIA RTB
054562,000347:                                                                                          	# NORMAL EXIT MODE:  RVQ
054563,000348:                                                                                          	#          HOWEVER, PROGRAM EXITS WITH ONE OF THE FOLLOWING VALUES FOR TFF (-28) CS  IN MPAC. USER MUST STORE.
054564,000349:                                                                                          	#                 A.  TFF= FLIGHT TIME. NORMAL CASE FOR POSITIVE FLIGHT TIME LESS THAN ONE ORBITAL PERIOD.
054565,000350:                                                                                          	#                 B.  (THIS OPTION IS NO LONGER USED.)
054566,000351:                                                                                          	#                 C.  TFF = POSMAX.  THIS INDICATES THAT THE CONIC FROM THE PRESENT POSITION WILL NOT RETURN TO
054567,000352:                                                                                          	#                     THE SPECIFIED ALTITUDE.  ALSO INDICATES OUTBOUND PARABOLA OR HYPERBOLA.
054568,000353:                                                                                          	# OUTPUT:  C(MPAC)  (-28)  CS     TIME OF FLIGHT, OR TIME TO PERIGEE
054569,000354:                                                                                          	#          TFFX    (0)            X,                                      LEFT FOR ENTRY DISPLAY TFF ROUTINES
054570,000355:                                                                                          	#          NRTERM  E: (-29+NR)    M  RTERM, WEIGHTED BY NR                LEFT FOR ENTRY DISPLAY TFF ROUTINES
054571,000356:                                                                                          	#                  M:(-27+NR)
054572,000357:                                                                                          	#          TFFTEM  E:(-59+2NR)    LCP Z Z SGN(SDELF)                      LEFT FOR ENTRY DISPLAY TFF ROUTINES
054573,000358:                                                                                          	#                  M:(-55+2NR)    LCP /ALFA SGN(SDELF)                    LEFT FOR ENTRY DISPLAY TFF ROUTINES
054574,000359:                                                                                          	#          NOTE:  TFFTEM = PDL 36D AND WILL BE DESTROYED BY .:UNIT:.
054575,000360:                                                                                          	#          RMAG1  E:(-29)  M:(-27)  PDL 12 NOT TOUCHED.
054576,000361:                                                                                          	#          TFFQ1  E:(-16)  M:(-15)  PDL 14D
054577,000362:                                                                                          	#          TFFDELQ E:(-16) M:(-15)  PDL 10D
054578,000363:                                                                                          	#          PUSHLOC AT PDL+0
054579,000364:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:
054580,000365:                                                                                          	#          RONE   E:(-29)  M:(-27)  M   STATE VECTOR                      LEFT BY USER
054581,000366:                                                                                          	#          VONE'  E:(+10)  M:(+9)   VN/SQRT(NU)                           LEFT BY TFF/CONIC
054582,000367:                                                                                          	#          RMAG1  E:(-29)  M:(-27)  PRESENT RADIUS,  M                    LEFT BY TFFCONIC
054583,000368:                                                                                          	#          C(MPAC)E:(-29)  M:(-27)  RTERM, TERMINAL RADIUS LENGTH, M      LEFT BY USER
054584,000369: 
054585,000370:                                                                                          	#          THE FOLLOWING ARE STORED IN THE PUSH LIST AREA.
054586,000371:                                                                                          	#          TFF/RTMU  E:(17)  M:(14)  1/SQRT(MU)                           LEFT BY TFFCONIC.
054587,000372:                                                                                          	#          NRMAG  E:(-29+NR)   M  RMAG, NORMALIZED                        LEFT BY TFFCONIC
054588,000373:                                                                                          	#                 M:(-27+NR)
054589,000374:                                                                                          	#          X1                     -NR, NORM COUNT                         LEFT BY TFFCONIC
054590,000375:                                                                                          	#          TFFNP  E: (-38+2NR)  M   LCP, SEMI LATUS RECTUM, WEIGHT NR     LEFT BY TFFCONIC
054591,000376:                                                                                          	#                 M: (-36+2N4)
054592,000377:                                                                                          	#          TFFALFA  E: (26-NR)    1/M  ALFA, WEIGHT  NR                   LEFT BY TFFCONIC
054593,000378:                                                                                          	#                   M: (24-NR)
054594,000379:                                                                                          	#          TFFRTALF  E:(10+NA)    SQRT(ALFA), NORMALIZED                  LEFT BY TFFCONIC
054595,000380:                                                                                          	#                    M:(9+NA)
054596,000381:                                                                                          	#          X2                     -NA, NORMCOUNT                          LEFT BY TFFCONIC
054597,000382:                                                                                          	#          TFF1/ALF  E: (-22-2NA)  SIGNED SEMIMAJ AXIS, WEIGHTED BY NA    LEFT BY TFFCONICf
054598,000383:                                                                                          	#                    M: (-20-2NA)
054599,000384:                                                                                          	# DEBRIS:  QPRET,   PDL+0 ... PDL+3
054600,000385:                                                                                          	#          RTERM  E:(-29)  M(-27)   RTERM, TERMINAL RADIUS LENGTH
054601,000386:                                                                                          	#          RAPO   E:(-29)  M(-27)   PDL 16D  (=NRTERM)

025892,004696: 32,2566           50002                           INDEX    Q                             	# MOVE CURRENT LOS (1ST PASS) OR LOS PRO-
025893,004697: 32,2567           52156                           DXCH     MPAC       +1                 	# JECTED 1/2 SEC AHEAD (2ND PASS).
025894,004698: 32,2570           11107                           CCS      TANG                          	#

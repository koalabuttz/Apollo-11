001135,001056:                                                                                          	# OPTION CODES FOR LUMINARY
001136,001057: 
001137,001058:                                                                                          	# THE SPECIFIED OPTION CODES WILL BE FLASHED IN COMPONENT R1 IN
001138,001059:                                                                                          	# CONJUNCTION WITH V04N06 OR V04N12 (FOR EXTENDED VERBS) TO REQUEST THE
001139,001060:                                                                                          	# ASTRONAUT TO LOAD INTO COMPONENT R2 THE OPTION HE DESIRES.
001140,001061: 
001141,001062:                                                                                          	# *9            *17                             *52                             *11             *25     COLUMN
001142,001063: 
001143,001064:                                                                                          	# OPTION
001144,001065:                                                                                          	# CODE          PURPOSE                         INPUT FOR COMPONENT 2           PROGRAM(S)      APPLICABILITY
001145,001066: 
001146,001067:                                                                                          	# 00001         SPECIFY IMU ORIENTATION         1=PREF 2=NOM 3=REFSMMAT         P52             ALL
001147,001068:                                                                                          	#                                               4=LAND SITE
001148,001069:                                                                                          	# 00002         SPECIFY VEHICLE                 1=THIS 2=OTHER                  P21,R30         ALL
001149,001070:                                                                                          	# 00003         SPECIFY TRACKING ATTITUDE       1=PREFERRED 2=OTHER             R63             ALL
001150,001071:                                                                                          	# 00004         SPECIFY RADAR                   1=RR 2=LR                       R04             SUNDANCE + LUMINARY
001151,001072:                                                                                          	# 00005         SPECIFY SOR PHASE               1=FIRST 2=SECOND                P38             COLOSSUS + LUMINARY
001152,001073:                                                                                          	# 00006         SPECIFY RR COARSE ALIGN OPTION  1=LOCKON 2=CONTINUOUS DESIG.    V41N72          SUNDANCE + LUMINARY
001153,001074:                                                                                          	# 00010         SPECIFY ALIGNMENT MODE          0=ANY TIME 1=REFSMMAT +G        P57             LUMINARY
001154,001075:                                                                                          	#                                               2=TWO BODIES 3=ONE BODY + G
001155,001076:                                                                                          	# 00012         SPECIFY CSM ORBIT OPTION        1=NO ORBIT CHANGE 2=CHANGE      P22             LUMINARY
001156,001077:                                                                                          	#                                               ORBIT TO PASS OVER LM

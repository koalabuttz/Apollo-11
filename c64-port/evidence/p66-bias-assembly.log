035890,001236:                                                                                          	# ***********************************************************************************
035891,001237:                                                                                          	# DOUBLE PRECISION ROOT FINDER SUBROUTINE (BY ALLAN KLUMPP)
035892,001238:                                                                                          	# ***********************************************************************************
035893,001239: 
035894,001240:                                                                                          	#                                                      N        N-1
035895,001241:                                                                                          	#       ROOTPSRS FINDS ONE ROOT OF THE POWER SERIES A X  + A   X    + ... + A X + A
035896,001242:                                                                                          	#                                                    N      N-1              1     0
035897,001243:                                                                                          	# USING NEWTON'S METHOD STARTING WITH AN INITIAL GUESS FOR THE ROOT.  THE ENTERING DATA MUST BE AS FOLLOWS:
035898,001244:                                                                                          	#       A       SP      LOC-3           ADRES FOR REFERENCING PWR COF TABL
035899,001245:                                                                                          	#       L       SP      N-1             N IS THE DEGREE OF THE POWER SERIES
035900,001246:                                                                                          	#       MPAC    DP      X               INITIAL GUESS FOR ROOT
035901,001247: 
035902,001248:                                                                                          	#       LOC-2N  DP      A(0)
035903,001249:                                                                                          	#               ...
035904,001250:                                                                                          	#       LOC     DP      A(N)
035905,001251:                                                                                          	#       LOC+2   SP      PRECROOT         PREC RQD OF ROOT (AS FRACT OF 1ST GUESS)
035906,001252: 
035907,001253:                                                                                          	# Page 823
035908,001254:                                                                                          	# THE DP RESULT IS LEFT IN MPAC UPON EXIT, AND A SP COUNT OF THE ITERATIONS TO CONVERGENCE IS LEFT IN MPAC+2.
035909,001255:                                                                                          	# RETURN IS NORMALLY TO LOC(TC ROOTPSRS)+3.  IF ROOTPSRS FAILS TO CONVERGE TO IN 8 PASSES, RETURN IS TO LOC+1 AND
035910,001256:                                                                                          	# OUTPUTS ARE NOT TO BE TRUSTED.
035911,001257: 
035912,001258:                                                                                          	# PRECAUTION:  ROOTPSRS MAKES NO CHECKS FOR OVERFLOW OR FOR IMPROPER USAGE.  IMPROPER USAGE COULD
035913,001259:                                                                                          	# PRECLUDE CONVERGENCE OR REQUIRE EXCESSIVE ITERATIONS.  AS A SPECIFIC EXAMPLE, ROOTPSRS FORMS A DERIVATIVE
035914,001260:                                                                                          	# COEFFICIENT TABLE BY MULTIPLYING EACH A(I) BY I, WHERE I RANGES FROM 1 TO N.  IF AN ELEMENT OF THE DERIVATIVE
035915,001261:                                                                                          	# COEFFICIENT TABLE = 1 OR >1 IN MAGNITUDE, ONLY THE EXCESS IS RETAINED.  ROOTPSRS MAY CONVERGE ON THE CORRECT
035916,001262:                                                                                          	# ROOT NONETHELESS, BUT IT MAY TAKE AN EXCESSIVE NUMBER OF ITERATIONS.  THEREFORE THE USER SHOULD RECOGNIZE:
035917,001263:                                                                                          	#       1.  USER'S RESPONSIBILITY TO ASSUR THAT I X A(I) < 1 IN MAGNITUDE FOR ALL I.
035918,001264:                                                                                          	#       2.  USER'S RESPONSIBILITY TO ASSURE OVERFLOW WILL NOT OCCUR IN EVALUATING EITHER THE RESIDUAL OR THE DERIVATIVE
035919,001265:                                                                                          	#           POWER SERIES.  THIS OVERFLOW WOULD BE PRODUCED BY SUBROUTINE POWRSERS, CALLED BY ROOTPSRS, AND MIGHT NOT
035920,001266:                                                                                          	#           PRECLUDE EVENTUAL CONVERGENCE.
035921,001267:                                                                                          	#       3.  AT PRESENT, ERASABLE LOCATIONS ARE RESERVED ONLY FOR N UP TO 5.  AN N IN EXCESS OF 5 WILL PRODUCE CHAOS.
035922,001268:                                                                                          	#           ALL ERASABLES USED BY ROOTPSRS ARE UNSWITCHED LOCATED IN THE REGION FROM MPAC-33 OCT TO MPAC+7.
035923,001269:                                                                                          	#       4.  THE ITERATION COUNT RETURNED IN MPAC+2 MAY BE USED TO DETECT ABNORMAL PERFORMANCE.
035924,001270: 
035925,001271:                                                                                          	# STORE ENTERING DATA, INITIALIZE ERASABLES
035926,001272: 31,3553           00006        ROOTPSRS           EXTEND                                 	#

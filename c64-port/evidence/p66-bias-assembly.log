028710,000334:                                                                                          	# RENDEZVOUS MID-COURSE MANEUVER PROGRAMS (P35 AND P75)
028711,000335: 
028712,000336:                                                                                          	# MOD NO -1                     LOG SECTION - P32-P35, P72-P75
028713,000337:                                                                                          	# MOD BY WHITE.P                DATE  1JUNE67
028714,000338: 
028715,000339:                                                                                          	# PURPOSE
028716,000340: 
028717,000341:                                                                                          	#       (1)     TO CALCULATE THE REQUIRED DELTA V AND OTHER INITIAL CONDITIONS
028718,000342:                                                                                          	#               REQUIRED BY THE ACTIVE VEHICLE FOR EXECUTION OF THE NEXT
028719,000343:                                                                                          	#               MIDCOURSE CORRECTION OF THE TRANSFER PHASE OF AN ACTIVE
028720,000344:                                                                                          	#               VEHICLE RENDEZVOUS.
028721,000345: 
028722,000346:                                                                                          	#       (2)     TO DISPLAY TO THE ASTRONAUT AND THE GROUND CERTAIN DEPENDENT
028723,000347:                                                                                          	#               VARIABLES ASSOCIATED WITH THE MANEUVER FOR APPROVAL BY THE
028724,000348:                                                                                          	#               ASTRONAUT/GROUND.
028725,000349: 
028726,000350:                                                                                          	#       (3)     TO STORE THE TPM TARGET PARAMETERS FOR USE BY THE DESIRED
028727,000351:                                                                                          	#               THRUSTING PROGRAM.
028728,000352: 
028729,000353:                                                                                          	# ASSUMPTIONS
028730,000354: 
028731,000355:                                                                                          	#       (1)     THE ISS NEED NOT BE ON TO COMPLETE THIS PROGRAM.
028732,000356: 
028733,000357:                                                                                          	#       (2)     STATE VECTOR UPDATES BY P27 ARE DISALLOWED DURING AUTOMATIC
028734,000358:                                                                                          	#               STATE VECTOR UPDATING INITIATED BY P20 (SEE ASSUMPTION (3)).
028735,000359: 
028736,000360:                                                                                          	#       (3)     THE RENDEZVOUS RADAR IS ON AND IS LOCKED ON THE CSM.  THIS WAS
028737,000361:                                                                                          	#               DONE DURING PREVIOUS SELECTION OF P20.  RADAR SIGHTING MARKS
028738,000362:                                                                                          	#               WILL BE MADE AUTOMATICALLY APPROXIMATELY ONCE A MINUTE WHEN
028739,000363:                                                                                          	#               ENABLED BY THE TRACK AND UPDATE FLAGS (SEE P20).  THE
028740,000364:                                                                                          	#               RENDEZVOUS TRACKING MARK COUNTER IS ZEROED BY THE SELECTION OF
028741,000365:                                                                                          	#               P20 AND AFTER EACH THRUSTING MANEUVER.
028742,000366: 
028743,000367:                                                                                          	#       (4)     THE OPERATION OF THE PROGRAM UTILIZES THE FOLLOWING FLAGS -
028744,000368: 
028745,000369:                                                                                          	#                       ACTIVE VEHICLE FLAG - DESIGNATES THE VEHICLE WHICH IS
028746,000370:                                                                                          	#                       DOING RENDEZVOUS THRUSTING MANEUVERS TO THE PROGRAM WHICH
028747,000371:                                                                                          	#                       CALCULATES THE MANEUVER PARAMETERS.  SET AT THE START OF
028748,000372:                                                                                          	#                       EACH RENDEZVOUS PRE-THRUSTING PROGRAM.
028749,000373: 
028750,000374:                                                                                          	#                       FINAL FLAG - SELECTS FINAL PROGRAM DISPLAYS AFTER CREW HAS
028751,000375:                                                                                          	#                       SELECTED THE FINAL MANEUVER COMPUTATION CYCLE.
028752,000376: 
028753,000377:                                                                                          	#                       EXTERNAL DELTA V FLAG - DESIGNATES THE TYPE OF STEERING
028754,000378:                                                                                          	#                       REQUIRED FOR EXECUTION OF THIS MANEUVER BY THE THRUSTING
028755,000379:                                                                                          	#                       PROGRAM SELECTED AFTER COMPLETION OF THIS PROGRAM.
028756,000380: 
028757,000381:                                                                                          	#       (5)     THE TIME OF INTERCEPT (T(INT)) WAS DEFINED BY PREVIOUS
028758,000382:                                                                                          	#               COMPLETION OF THE TRANSFER PHASE INITIATION (TPI) PROGRAM
028759,000383:                                                                                          	#               (P34/P74) AND IS PRESENTLY AVAILABLE IN STORAGE.
028760,000384: 
028762,000386:                                                                                          	#       (6)     ONCE THE PARAMETERS REQUIRED FOR COMPUTION OF THE MANEUVER
028763,000387:                                                                                          	#               HAVE BEEN COMPLETELY SPECIFIED, THE VALUE OF THE ACTIVE
028764,000388:                                                                                          	#               VEHICLE CENTRAL ANGLE OF TRANSFER IS COMPUTED AND STORED.
028765,000389:                                                                                          	#               THIS NUMBER WILL BE AVAILABLE FOR DISPLAY TO THE ASTRONAUT
028766,000390:                                                                                          	#               THROUGH THE USE OF V06N52.
028767,000391: 
028768,000392:                                                                                          	#               THE ASTRONAUT WILL CALL THIS DISPLAY TO VERIFY THAT THE
028769,000393:                                                                                          	#               CENTRAL ANGLE OF TRANSFER OF THE ACTIVE VEHICLE IS NOT WITHIN
028770,000394:                                                                                          	#               170 TO 190 DEGREES.  IF THE ANGLE IS WITHIN THIS ZONE THE
028771,000395:                                                                                          	#               ASTRONAUT SHOULD REASSESS THE INPUT TARGETING PARAMETERS BASED
028772,000396:                                                                                          	#               UPON DELTA V AND EXPECTED MANEUVER TIME.
028773,000397: 
028774,000398:                                                                                          	#       (7)     THIS PROGRAM IS SELECTED BY THE ASTRONAUT BY DSKY ENTRY -
028775,000399: 
028776,000400:                                                                                          	#                       P35 IF THIS VEHICLE IS ACTIVE VEHICLE.
028777,000401: 
028778,000402:                                                                                          	#                       P75 IF THIS VEHICLE IS PASSIVE VEHICLE.
028779,000403: 
028780,000404:                                                                                          	# INPUT
028781,000405: 
028782,000406:                                                                                          	#       (1)     TPASS4          TIME OF INTERCEPT - SAVED FROM P34/P74
028783,000407: 
028784,000408:                                                                                          	# OUTPUT
028785,000409: 
028786,000410:                                                                                          	#       (1)     TRKMKCNT        NUMBER OF MARKS
028787,000411:                                                                                          	#       (2)     TTOGO           TIME TO GO
028788,000412:                                                                                          	#       (3)     +MGA            MIDDLE GIMBAL ANGLE
028789,000413:                                                                                          	#       (4)     DVLOS           DELTA VELOCITY AT MID - LINE OF SIGHT
028790,000414:                                                                                          	#       (5)     DELVLVC         DELTA VELOCITY AT MID - LOCAL VERTICAL COORDINATES
028791,000415: 
028792,000416:                                                                                          	# DOWNLINK
028793,000417: 
028794,000418:                                                                                          	#       (1)     TIG             TIME OF THE TPM MANEUVER
028795,000419:                                                                                          	#       (2)     DELVEET3        DELTA VELOCITY AT TPM - REFERENCE COORDINATES
028796,000420:                                                                                          	#       (3)     TPASS4          TIME OF INTERCEPT
028797,000421: 
028798,000422:                                                                                          	# COMMUNICATION TO THRUSTING PROGRAMS
028799,000423: 
028800,000424:                                                                                          	#       (1)     TIG             TIME OF THE TPM MANEUVER
028801,000425:                                                                                          	#       (2)     RTARG           OFFSET TARGET POSITION
028802,000426:                                                                                          	#       (3)     TPASS4          TIME OF INTERCEPT
028803,000427:                                                                                          	#       (4)     XDELVFLG        RESET TO INDICATE LAMBERT (AIMPOINT) VG COMPUTATION

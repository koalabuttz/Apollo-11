011782,000981:                                                                                          	# VERB 89       DESCRIPTION     RENDEZVOUS FINAL ATTITUDE ROUTINE (R63)
011783,000982:                                                                                          	# 
011784,000983:                                                                                          	# CALLED BY VERB 89 ENTER DURING P00.  PRIO 10 USED.  CALCULATES AND
011785,000984:                                                                                          	# DISPLAYS FINAL FDAI BALL ANGLES TO POINT LM +X OR +Z AXIS AT CSM.
011786,000985: 
011787,000986:                                                                                          	# 1. KEY IN V 89 E ONLY IF IN PROG 00.  IF NOT IN P00, OPERATOR ERROR AND
011788,000987:                                                                                          	# EXIT R63, OTHERWISE CONTINUE.
011789,000988: 
011790,000989:                                                                                          	# 2. IF IN P00, DO IMU STATUS CHECK ROUTINE (R02BOTH).  IF IMU ON AND ITS
011791,000990:                                                                                          	# ORIENTATION KNOWN TO LGC,CONTINUE.
011792,000991: 
011793,000992:                                                                                          	# 3. FLASH DISPLAY V 04 N 06.  R2 INDICATES WHICH SPACECRAFT AXIS IS TO
011794,000993:                                                                                          	# BE POINTED AT CSM.  INITIAL CHOICE IS PREFERRED (+Z) AXIS (R2=1).
011795,000994:                                                                                          	# ASTRONAUT CAN CHANGE TO (+X) AXIS (R2 NOT = 1) BY V 22 E 2 E.  CONTINUE
011796,000995:                                                                                          	# AFTER KEYING IN PROCEED.
011797,000996: 
011798,000997:                                                                                          	# 4. BOTH VEHICLE STATE VECTORS UPDATED BY CONIC EQS.
011799,000998: 
011800,000999:                                                                                          	# 5. HALF MAGNITUDE UNIT LOS VECTOR (IN STABLE MEMBER COORDINATES) AND
011802,001001:                                                                                          	# HALF MAGNITUDE UNIT SPACECRAFT AXIS VECTOR (IN BODY COORDINATES)
011803,001002:                                                                                          	# PREPARED FOR VECPOINT.
011804,001003: 
011805,001004:                                                                                          	# 6. GIMBAL ANGLES FROM VECPOINT TRANSFORMED INTO FDAI BALL ANGLES BY
011806,001005:                                                                                          	# BALLANGS.  FLASH DISPLAY V 06 N 18 AND AWAIT RESPONSE.
011807,001006: 
011808,001007:                                                                                          	# 7.    RECYCLE - RETURN TO STEP 4.
011809,001008:                                                                                          	#       TERMINATE - EXIT R63.
011810,001009:                                                                                          	#       PROCEED - RESET 3AXISFLG AND CALL R60LEM FOR ATTITUDE MANEUVER.

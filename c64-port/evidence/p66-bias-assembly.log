013503,000097: 
013505,000099:                                                                                          	# THE FOLLOWING ROUTINE TAKES A HALF UNIT TARGET VECTOR REFERRED TO NAV BASE COORDINATES AND FINDS BOTH
013506,000100:                                                                                          	# GIMBAL ORIENTATIONS AT WHICH THE RR MIGHT SIGHT THE TARGET.  THE GIMBAL ANGLES CORRESPONDING TO THE PRESENT MODE
013507,000101:                                                                                          	# ARE LEFT IN MODEA AND THOSE WHICH WOULD BE USED AFTER A REMODE IN MODEB.  THIS ROUTINE ASSUMES MODE 1 IS TRUNNION
013508,000102:                                                                                          	# ANGLE LESS THAN 90 DEGS IN ABS VALUE WITH ARBITRARY SHAFT, WITH A CORRESPONDING DEFINITION FOR MODE 2.  MODE
013509,000103:                                                                                          	# SELECTION AND LIMIT CHECKING ARE DONE ELSEWHERE.
013510,000104: 
013511,000105:                                                                                          	# THE MODE 1 CONFIGURATION IS CALCULATED FROM THE VECTOR AND THEN MODE 2 IS FOUND USING THE RELATIONS
013512,000106: 
013513,000107:                                                                                          	#       S(2) = 180 + S(1)
013514,000108:                                                                                          	#       T(2) = 180 - T(1)
013515,000109: 
013516,000110:                                                                                          	# THE VECTOR ARRIVES IN MPAC WHERE TRG*SMNG OR *SMNB* WILL HAVE LEFT IT.
013517,000111: 
013518,000112: 13,2133           00041        RRANGLES           STORE    32D                           	#
013519,000113: 13,2134           57545                           DLOAD    DCOMP                         	# SINCE WE WILL FIND THE MODE 1 SHAFT
013520,000114: 13,2135           00043                                    34D                           	# ANGLE LATER, WE CAN FIND THE MODE 1
013521,000115: 13,2136           67401                           SETPD    ASIN                          	# TRUNNION BY SIMPLY TAKING THE ARCSIN OF
013522,000116: 13,2137           00001                                    0                             	# THE Y COMPONENT, THE ASIN GIVING AN
013523,000117: 13,2140           44206                           PUSH     BDSU                          	# ANSWER WHOSE ABS VAL IS LESS THAN 90 DEG
013524,000118: 13,2141           24005                                    LODPHALF                      	#
013525,000119: 13,2142           14005                           STODL    4                             	# MODE 2 TRUNNION TO 4.
013526,000120: 
013527,000121: 13,2143           24007                                    LO6ZEROS                      	#
013528,000122: 13,2144           24043                           STOVL    34D                           	# UNIT THE PROJECTION OF THE VECTOR
013529,000123: 13,2145           00041                                    32D                           	#       IN THE X-Z PLANE
013530,000124: 13,2146           41056                           UNIT     BOVB                          	# IF OVERFLOW, TARGET VECTOR IS ALONG Y
013531,000125: 13,2147           52421                                    LUNDESCH                      	# CALL FOR MANEUVER UNLESS ON LUNAR SURF
013532,000126: 13,2150           14041                           STODL    32D                           	# PROJECTION VECTOR.
013533,000127: 13,2151           00041                                    32D                           	#
013534,000128: 13,2152           44142                           SR1      STQ                           	#
013535,000129: 13,2153           00051                                    S2                            	#
013536,000130: 13,2154           14023                           STODL    SINTH                         	# USE ARCTRIG SINCE SHAFT COULD BE ARB.
013537,000131: 13,2155           00045                                    36D                           	#
013538,000132: 13,2156           77742                           SR1                                    	#
013539,000133: 13,2157           34021                           STCALL   COSTH                         	#
013540,000134: 13,2160           47320                                    ARCTRIG                       	#
013542,000136: 13,2161           43206                           PUSH     DAD                           	# MODE 1 SHAFT TO 2.
013543,000137: 13,2162           24005                                    LODPHALF                      	#
013544,000138: 13,2163           24007                           STOVL    6                             	#
013545,000139: 13,2164           00005                                    4                             	#
013546,000140: 13,2165           77634                           RTB                                    	# FIND MODE 2 CDU ANGLES.
013547,000141: 13,2166           21635                                    2V1STO2S                      	#
013548,000142: 13,2167           25112                           STOVL    MODEB                         	#
013549,000143: 13,2170           00001                                    0                             	#

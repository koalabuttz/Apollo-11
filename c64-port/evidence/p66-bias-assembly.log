049188,000211:                                                                                          	#  INCORP2 -INCORPORATES THE COMPUTED STATE VECTOR DEVIATIONS INTO THE
049189,000212:                                                                                          	# ESTIMATED STATE VECTOR. THE STATE VECTOR UPDATED MAY BE FOR EITHER THE
049190,000213:                                                                                          	# LEM OR THE CSM. DETERMINED BY FLAG VEHUPFLG. (ZERO = LEM) (1 = CSM)
049191,000214: 
049192,000215:                                                                                          	# INPUT
049193,000216:                                                                                          	#       PERMANENT STATE VECTOR FOR EITHER THE LEM OR CSM

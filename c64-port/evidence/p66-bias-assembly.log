061028,000048:                                                                                          	# THE FOLLOWING T5RUPT ENTRY BEGINS THE PROGRAM WHICH CONTROLS THE P-AXIS ACTION OF THE LEM USING THE RCS JETS.
061029,000049:                                                                                          	# THE NOMINAL TIME BETWEEN THE P-AXIS RUPTS IS 100 MS IN ALL NON-IDLING MODES OF THE DAP.
061030,000050: 
061031,000051: 16,2213           37727        PAXIS              CA       MS100                         	#
061032,000052: 16,2214           26030                           ADS      TIME5                         	# *** NECESSARY IN ORDER TO ALLOW SYN-
061033,000053:                                                                                          	# CHRONIZATION WITH OTHER INTERRUPTS ***

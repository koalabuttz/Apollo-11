043930,000233:    6225           50000                           INDEX    A                             	# NO -- THE MODE IS DEFINITE.  PICK UP THE
043931,000234:    6226           46244                           CS       NO.WDS                        	#
043932,000235:    6227           16235                           TCF      REGUP      +2                 	#
043933,000236: 

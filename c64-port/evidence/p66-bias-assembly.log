047482,000285: 01,3002           70006                           MASK     BBANK                         	#
047483,000286: 01,3003           00006                           EXTEND                                 	#
047484,000287: 01,3004           04007                           ROR      SUPERBNK                      	# SAVE OLD SUPERBANK VALUE.
047485,000288: 01,3005           54165                           TS       BANKSET                       	#
047486,000289: 01,3006           44755                           CS       ZERO                          	#
047487,000290: 01,3007           54131        JOBSLP2            TS       BUF        +1                 	# HOLDS -- HIGHEST PRIORITY.
047488,000291: 01,3010           13120                           TCF      EJSCAN                        	# SCAN FOR HIGHEST PRIORITY ALA ENDOFJOB.
047489,000292: 
047490,000293: 01,3011           00004        NUCHANG2           INHINT                                 	# QUICK... DON'T LET NEWJOB CHANGE TO +0.
047491,000294: 01,3012           10067                           CCS      NEWJOB                        	#
047492,000295: 01,3013           13016                           TCF      +3                            	# NEWJOB STILL PNZ
047493,000296: 01,3014           00003                           RELINT                                 	# NEW JOB HAS CHANGED TO +0.  WAKE UP JOB
047494,000297: 01,3015           13216                           TCF      ADVAN      +2                 	# VIA NUDIRECT.  (VERY RARE CASE.)
047495,000298: 
047496,000299: 01,3016           34752                           CAF      TWO                           	#
047497,000300: 01,3017           00006                           EXTEND                                 	#
047498,000301: 01,3020           05011                           WOR      DSALMOUT                      	# TURN ON ACTIVITY LIGHT
047499,000302: 01,3021           52165                           DXCH     LOC                           	# AND SAVE ADDRESS INFO FOR BENEFIT OF
047500,000303: 01,3022           12712                           TCF      CHANJOB    +4                 	#       POSSIBLE SLEEPINT JOB.
047501,000304: 
047502,000305:                                                                                          	# Page 1111
047503,000306:                                                                                          	# TO WAKE UP A JOB, EACH CORE SET IS FOUND TO LOCATE ALL JOBS WHICH ARE ASLEEP.  IF THE FCADR IN THE
047504,000307:                                                                                          	# LOC REGISTER OF ANY SUCH JOB MATCHES THAT SUPPLIED BY THE CALLER, THAT JOB IS AWAKENED.  IF NO JOB IS FOUND,
047505,000308:                                                                                          	# LOCCTR IS SET TO -1 AND NO FURTHER ACTION TAKES PLACE.
047506,000309: 
047507,000310: 01,3023           54061        JOBWAKE2           TS       EXECTEM1                      	#
047508,000311: 01,3024           34755                           CAF      ZERO                          	# BEGIN CORE SET SCAN
047509,000312: 01,3025           54064                           TS       LOCCTR                        	#
047510,000313: 01,3026           32634                           CAF      NO.CORES                      	#
047511,000314: 01,3027           54062        JOBWAKE4           TS       EXECTEM2                      	#
047512,000315: 01,3030           50064                           INDEX    LOCCTR                        	#
047513,000316: 01,3031           10167                           CCS      PRIORITY                      	#
047514,000317: 01,3032           13035                           TCF      JOBWAKE3                      	# ACTIVE JOB -- CHECK NEXT CORE SET.
047515,000318: 01,3033           00014        COREINC            DEC      12         B-14               	# 12 REGISTERS PER CORE SET.
047516,000319: 01,3034           13044                           TCF      WAKETEST                      	# SLEEPING JOB -- SEE IF CADR MATCHES.
047517,000320: 
047518,000321: 01,3035           33033        JOBWAKE3           CAF      COREINC                       	#
047519,000322: 01,3036           26064                           ADS      LOCCTR                        	#
047520,000323: 01,3037           10062                           CCS      EXECTEM2                      	#
047521,000324: 01,3040           13027                           TCF      JOBWAKE4                      	#
047522,000325: 01,3041           44753                           CS       ONE                           	# EXIT IF SLEEPIN JOB NOT FOUND.
047523,000326: 01,3042           54064                           TS       LOCCTR                        	#
047524,000327: 01,3043           15160                           TCF      ENDFIND                       	#
047525,000328: 
047526,000329: 01,3044           40065        WAKETEST           CS       NEWLOC                        	#
047527,000330: 01,3045           50064                           INDEX    LOCCTR                        	#
047528,000331: 01,3046           60164                           AD       LOC                           	#
047529,000332: 01,3047           00006                           EXTEND                                 	#
047530,000333: 01,3050           13052                           BZF      +2                            	# IF MATCH.
047531,000334: 01,3051           13035                           TCF      JOBWAKE3                      	# EXAMINE NEXT CORE SET IF NO MATCH.
047532,000335: 
047533,000336: 01,3052           50064                           INDEX    LOCCTR                        	# RE-COMPLEMENT PRIORITY TO SHOW JOB AWAKE
047534,000337: 01,3053           40167                           CS       PRIORITY                      	#
047535,000338: 01,3054           54063                           TS       NEWPRIO                       	#
047536,000339: 01,3055           50064                           INDEX    LOCCTR                        	#
047537,000340: 01,3056           54167                           TS       PRIORITY                      	#
047538,000341: 
047539,000342: 01,3057           44350                           CS       FBANKMSK                      	# MAKE UP THE 2CADR OF THE WAKE ADDRESS
047540,000343: 01,3060           70065                           MASK     NEWLOC                        	# USING THE CADR IN NEWLOC AND THE EBANK
047541,000344: 01,3061           64741                           AD       2K                            	# HALF OF BBANK SAVED IN BANKSET.
047542,000345: 01,3062           56065                           XCH      NEWLOC                        	#
047543,000346: 01,3063           74350                           MASK     FBANKMSK                      	#
047544,000347: 01,3064           50064                           INDEX    LOCCTR                        	#
047545,000348: 01,3065           60165                           AD       BANKSET                       	#
047546,000349: 01,3066           54066                           TS       NEWLOC     +1                 	#
047547,000350: 
047548,000351: 01,3067           10064                           CCS      LOCCTR                        	# SPECIAL TREATMENT IF THIS JOB WAS
047549,000352: 01,3070           12661                           TCF      SETLOC                        	# ALREADY IN THE RUN (0) POSITION.
047550,000353: 01,3071           12651                           TCF      SPECTEST                      	#
047551,000354: 
047552,000355:                                                                                          	# Page 1112
047553,000356:                                                                                          	# PRIORITY CHANGE.  CHANGE THE CONTENTS OF PRIORITY AND SCAN FOR THE JOB OF HIGHEST PRIORITY.
047554,000357: 
047555,000358: 01,3072           54164        PRIOCH2            TS       LOC                           	#
047556,000359: 01,3073           34755                           CAF      ZERO                          	# SET FLAG TO TELL ENDJOB SCANNER IF THIS
047557,000360: 01,3074           54130                           TS       BUF                           	# JOB IS STILL HIGHEST PRIORITY.
047558,000361: 01,3075           35004                           CAF      LOW9                          	#
047559,000362: 01,3076           70167                           MASK     PRIORITY                      	#
047560,000363: 01,3077           60063                           AD       NEWPRIO                       	#
047561,000364: 01,3100           54167                           TS       PRIORITY                      	#
047562,000365: 01,3101           40000                           COM                                    	#
047563,000366: 01,3102           13007                           TCF      JOBSLP2                       	# AND TO EJSCAN.
047564,000367: 
047565,000368:                                                                                          	# Page 1113
047566,000369:                                                                                          	# RELEASE THIS CORE SET AND VAC AREA AND SCAN FOR THE JOB OF HIGHEST ACTIVE PRIORITY.
047567,000370: 
047568,000371: 01,3103           00004        ENDJOB1            INHINT                                 	#
047569,000372: 01,3104           44755                           CS       ZERO                          	#
047570,000373: 01,3105           54131                           TS       BUF        +1                 	#
047571,000374: 01,3106           56167                           XCH      PRIORITY                      	#
047572,000375: 01,3107           75004                           MASK     LOW9                          	#
047573,000376: 01,3110           54001                           TS       L                             	#
047574,000377: 
047575,000378: 01,3111           45164                           CS       FAKEPRET                      	#
047576,000379: 01,3112           60001                           AD       L                             	#
047577,000380: 
047578,000381: 01,3113           00006                           EXTEND                                 	#
047579,000382: 01,3114           63120                           BZMF     EJSCAN                        	# NOVAC ENDOFJOB
047580,000383: 
047581,000384: 01,3115           10001                           CCS      L                             	#
047582,000385: 01,3116           50000                           INDEX    A                             	#
047583,000386: 01,3117           54000                           TS       0                             	#
047584,000387: 
047585,000388: 01,3120           10203        EJSCAN             CCS      PRIORITY   +12D               	#
047586,000389: 01,3121           03171                           TC       EJ1                           	#
047587,000390: 01,3122           05705                           TC       CCSHOLE                       	#
047588,000391: 01,3123           13124                           TCF      +1                            	#
047589,000392: 
047590,000393: 01,3124           10217                           CCS      PRIORITY   +24D               	# EXAMINE EACH PRIORITY REGISTER TO FIND
047591,000394: 01,3125           03171                           TC       EJ1                           	# THE JOB OF HIGHEST ACTIVE PRIORITY.
047592,000395: 01,3126           05705                           TC       CCSHOLE                       	#
047593,000396: 01,3127           13130                           TCF      +1                            	#
047594,000397: 
047595,000398: 01,3130           10233                           CCS      PRIORITY   +36D               	#
047596,000399: 01,3131           03171                           TC       EJ1                           	#
047597,000400: 01,3132           67610        -CCSPR             -CCS     PRIORITY                      	#
047598,000401: 01,3133           13134                           TCF      +1                            	#
047599,000402: 
047600,000403: 01,3134           10247                           CCS      PRIORITY   +48D               	#
047601,000404: 01,3135           03171                           TC       EJ1                           	#
047602,000405: 01,3136           05705                           TC       CCSHOLE                       	#
047603,000406: 01,3137           13140                           TCF      +1                            	#
047604,000407: 
047605,000408: 01,3140           10263                           CCS      PRIORITY   +60D               	#
047606,000409: 01,3141           03171                           TC       EJ1                           	#
047607,000410: 01,3142           05705                           TC       CCSHOLE                       	#
047608,000411: 01,3143           13144                           TCF      +1                            	#
047609,000412: 
047610,000413: 01,3144           10277                           CCS      PRIORITY   +72D               	#
047611,000414: 01,3145           03171                           TC       EJ1                           	#
047612,000415: 01,3146           05705                           TC       CCSHOLE                       	#
047613,000416: 01,3147           13150                           TCF      +1                            	#
047614,000417: 
047615,000418: 01,3150           10313                           CCS      PRIORITY   +84D               	#
047616,000419:                                                                                          	# Page 1114
047617,000420: 01,3151           03171                           TC       EJ1                           	#
047618,000421: 01,3152           05705                           TC       CCSHOLE                       	#
047619,000422: 01,3153           13154                           TCF      +1                            	#
047620,000423: 
047621,000424:                                                                                          	# Page 1115
047622,000425:                                                                                          	# EVALUATE THE RESULTS OF THE SCAN.
047623,000426: 
047624,000427: 01,3154           10131                           CCS      BUF        +1                 	# SEE IF THERE ARE ANY ACTIVE JOBS WAITING
047625,000428: 01,3155           05705                           TC       CCSHOLE                       	#
047626,000429: 01,3156           05705                           TC       CCSHOLE                       	#
047627,000430: 
047628,000431: 01,3157           13161                           TCF      +2                            	#
047629,000432: 01,3160           13206                           TCF      DUMMYJOB                      	#
047630,000433: 01,3161           10130                           CCS      BUF                           	# BUF IS ZERO IS THIS IS A PRIOCHNG AND
047631,000434: 01,3162           13164                           TCF      +2                            	# CHANGED PRIORITY IS STILL HIGHEST.
047632,000435: 01,3163           12764                           TCF      ENDPRCHG   -1                 	#
047633,000436: 
047634,000437: 01,3164           50000                           INDEX    A                             	# OTHERWISE, SET NEWJOB TO THE RELATIVE
047635,000438: 01,3165           27777                           CAF      0          -1                 	# ADDRESS OF THE NEW JOB'S CORE SET.
047636,000439: 01,3166           63132                           AD       -CCSPR                        	#
047637,000440: 01,3167           54067                           TS       NEWJOB                        	#
047638,000441: 01,3170           12704                           TCF      CHANJOB    -2                 	#
047639,000442: 
047640,000443: 01,3171           54132        EJ1                TS       BUF        +2                 	#
047641,000444: 01,3172           60131                           AD       BUF        +1                 	# - OLD HIGH PRIORITY.
047642,000445: 01,3173           10000                           CCS      A                             	#
047643,000446: 01,3174           40132                           CS       BUF        +2                 	#
047644,000447: 01,3175           13201                           TCF      EJ2                           	# NEW HIGH PRIORITY.
047645,000448: 01,3176           13177                           NOOP                                   	#
047646,000449: 01,3177           50002                           INDEX    Q                             	#
047647,000450: 01,3200           00002                           TC       2                             	# PROCEED WITH SEARCH.
047648,000451: 
047649,000452: 01,3201           54131        EJ2                TS       BUF        +1                 	#
047650,000453: 01,3202           00006                           EXTEND                                 	#
047651,000454: 01,3203           22130                           QXCH     BUF                           	# FOR LOCATING CCS PRIORITY + X INSTR.
047652,000455: 01,3204           50130                           INDEX    BUF                           	#
047653,000456: 01,3205           00002                           TC       2                             	#
047654,000457: 
047655,000458:                                                                                          	# Page 1116
047656,000459:                                                                                          	# IDLING AND COMPUTER ACTIVITY (GREEN) LIGHT MAINTENANCE. THE IDLING ROUTINE IS NOT A JOB IN ITSELF,
047657,000460:                                                                                          	# BUT RATHER A SUBROUTINE OF THE EXECUTIVE.
047658,000461: 
047659,000462: 01,3206     1361                                  EBANK=   SELFRET                       	# SELF-CHECK STORAGE IN EBANK.
047660,000463: 
047661,000464: 01,3206           44755        DUMMYJOB           CS       ZERO                          	# SET NEWJOB TO -0 FOR IDLING.
047662,000465: 01,3207           54067                           TS       NEWJOB                        	#
047663,000466: 01,3210           00003                           RELINT                                 	#
047664,000467: 01,3211           44752                           CS       TWO                           	# TURN OFF THE ACTIVITY LIGHT.
047665,000468: 01,3212           00006                           EXTEND                                 	#
047666,000469: 01,3213           03011                           WAND     DSALMOUT                      	#
047667,000470: 01,3214           10067        ADVAN              CCS      NEWJOB                        	# IS THE NEWJOB ACTIVE?
047668,000471: 01,3215           13011                           TCF      NUCHANG2                      	# YES... ONE REQUIRING A CHANGE JOB.
047669,000472: 01,3216           34752                           CAF      TWO                           	# NEW JOB ALREADY IN POSITION FOR
047670,000473: 01,3217           13225                           TCF      NUDIRECT                      	# EXECUTION
047671,000474: 
047672,000475: 01,3220           31361                           CA       SELFRET                       	#
047673,000476: 01,3221           54001                           TS       L                             	# PUT RETURN ADDRESS IN L.
047674,000477: 01,3222           33224                           CAF      SELFBANK                      	#
047675,000478: 01,3223           15166                           TCF      SUPDXCHZ   +1                 	# AND DISPATCH JOB.
047676,000479: 
047677,000480: 01,3224     1361                                  EBANK=   SELFRET                       	#
047678,000481: 01,3224           66102        SELFBANK           BBCON    SELFCHK                       	#
047679,000482: 
047680,000483: 01,3225           00006        NUDIRECT           EXTEND                                 	# TURN THE GREEN LIGHT BACK ON.
047681,000484: 01,3226           05011                           WOR      DSALMOUT                      	#
047682,000485: 01,3227           52165                           DXCH     LOC                           	# JOBS STARTED IN THIS FASHION MUST BE
047683,000486: 01,3230           15165                           TCF      SUPDXCHZ                      	#
047684,000487: 
047685,000488:    5165                                           BLOCK    2                             	# IN FIXED-FIXED SO OTHERS MAY USE.
047686,000489: 
047687,000490:    5165                                           COUNT*   $$/EXEC                       	#
047688,000491: 

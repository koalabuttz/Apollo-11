060713,000219:                                                                                          	# PROGRAM:      ALTDSPLY
060714,000220:                                                                                          	# MOD 0.        6 DEC 1967
060715,000221:                                                                                          	# AUTHOR:       CRAIG WORK, DON KEENE, MIT IL
060716,000222:                                                                                          	# MOD 3 BY DON KEENE AUG 1, 1968 MOVED PROGRAM TO BANK 20
060717,000223: 
060718,000224:                                                                                          	# PROGRAM DESCRIPTION:
060719,000225:                                                                                          	#       ALTDSPLY REVERSES THE DSPLYALT BIT OF RCSFLAGS EACH TIME IT IS CALLED, WHICH IS PRESUMABLY EVERY 100 MS.
060720,000226:                                                                                          	#       IF THE REVERSED BIT IS ONE, NEEDLER IS CALLED TO DISPLAY ATTITUDE ERRORS.  IF THE BIT IS ZERO, THE ATTITUDE ERR-
060721,000227:                                                                                          	#       ORS ARE CALCULATED AS 1) DAP FOLLOWING ERRORS, IF NEEDLFLG = 0, AND 2) TOTAL ATTITUDE ERRORS FOR NEEDLFLG = 1.
060722,000228: 
060723,000229: 
060724,000230:                                                                                          	# WARNING:      ALTDSPLY MAY ONLY BE CALLED WITH INTERRUPT INHIBITED.
060725,000231: 
060726,000232:                                                                                          	# WARNING:      EBANK MUST BE SET TO 6 WHEN USING THIS ROUTINE.
060727,000233: 
060728,000234:                                                                                          	# INPUT:        RCSFLAGS AND    1) IF NEEDLFLG = 0, INPUT PERROR, QERROR, RERROR.
060729,000235:                                                                                          	#                               2) IF NEEDLFLG = 1, INPUT CPHI,CTHETA,CPSI,CDUX,CDUY,CDUZ,M11,M21,M32,M22,M32.  (GPMATRIX)
060730,000236: 
060731,000237: 
060732,000238:                                                                                          	# OUTPUTS:      RCSFLAGS WITH DSPLYALT REVERSED, AK, AK1, AK2, + NEEDLER OUTPUTS.
060733,000239: 
060734,000240:                                                                                          	# ENTRY:        TCF     ALTDSPLY
060735,000241: 
060736,000242:                                                                                          	# EXIT:         TCF     CHEKMORE
060737,000243: 
060738,000244:                                                                                          	# ALARM OR ABORT EXITS: NONE
060739,000245: 
060740,000246:                                                                                          	# SUBPROGRAMS CALLED:  NEEDLER, OVERSUB2
060741,000247: 
060742,000248:                                                                                          	# DEBRIS:       A, L, AND NEEDLER DEBRIS.
060743,000249: 
060744,000250: 20,2226           31273        ALTDSPLY           CA       RCSFLAGS                      	# INVERT THE DISPLAY ALTERNATION BIT.
060745,000251: 20,2227           54001                           TS       L                             	#
060746,000252: 20,2230           34750                           CA       DSPLYALT                      	#
060747,000253: 20,2231           00006                           EXTEND                                 	#
060748,000254: 20,2232           06001                           RXOR     LCHAN                         	#
060749,000255: 20,2233           55273                           TS       RCSFLAGS                      	#
060750,000256: 
060751,000257: 20,2234           74750                           MASK     DSPLYALT                      	#
060752,000258: 20,2235           10000                           CCS      A                             	# IS ALTERNATION FLAG ZERO?
060753,000259: 20,2236           12322                           TCF      NEEDLER                       	#
060754,000260: 
060755,000261: 20,2237           30074                           CAE      FLAGWRD0                      	# NEEDLFLG WILL INDICATE TOTAL OR DAP AT-
060757,000263: 20,2240           74750                           MASK     NEEDLBIT                      	# TITUDE ERROR DISPLAY REQUEST.
060758,000264: 20,2241           10000                           CCS      A                             	#
060759,000265: 20,2242           12252                           TCF      DSPLYTOT                      	# TOTAL ERROR IS NEEDED IN AK, AK +1, AK +2
060760,000266: 
060761,000267: 20,2243           41450                           CS       QERROR                        	# YES.  DISPLAY ATT ERRORS ON THE ,-BALL.
060762,000268: 20,2244           55762                           TS       AK         +1                 	# ERROR COMPLEMENTS ARE INPUT TO NEEDLER.
060763,000269: 20,2245           41452                           CS       RERROR                        	#
060764,000270: 20,2246           55763                           TS       AK         +2                 	#
060765,000271: 20,2247           41464                           CS       PERROR                        	#
060766,000272: 20,2250           57761                           XCH      AK                            	#
060767,000273: 
060768,000274: 20,2251           12442                           TCF      RETNMORE                      	# DISPLAY THESE THE NEXT TIME THROUGH
060769,000275: 
060770,000276:                                                                                          	# CALCULATE GIMBAL ANGLE TOTAL ERRORS, RESOLVE INTO PILOT AXES, STORE TOTAL ERRORS FOR NEEDLER.  Q-AXIS FIRST.
060771,000277: 
060772,000278: 20,2252           00006        DSPLYTOT           EXTEND                                 	#
060773,000279: 20,2253           22061                           QXCH     ITEMP1                        	# SAVE Q FOR CHEKBITS RETURN.
060774,000280: 
060775,000281: 20,2254           30322                           CA       CTHETA                        	# DESIRED ATTITUDE, Y-AXIS, 2'S COMP.
060776,000282: 20,2255           00006                           EXTEND                                 	# SUBTRACT CURRENT ATTITUDE.
060777,000283: 20,2256           20033                           MSU      CDUY                          	# DIFFERENCE SCALED AT PI, 1'S COMP.
060778,000284: 20,2257           55761                           TS       AK                            	# SAVE FOR R-ERROR CALCULATION.
060779,000285: 20,2260           00006                           EXTEND                                 	#
060780,000286: 20,2261           71415                           MP       M21                           	# (CHTETA-CDUY)*M21 SCALED AT PI RADIANS.
060781,000287: 20,2262           57762                           XCH      AK         +1                 	# STORE FIRST TERM OF Q ERROR.
060782,000288: 20,2263           30323                           CA       CPSI                          	# DESIRED ATTITUDE, Z-AXIS, 2'S COMP.
060783,000289: 20,2264           00006                           EXTEND                                 	# SUBTRACT CURRENT ATTITUDE.
060784,000290: 20,2265           20034                           MSU      CDUZ                          	# DIFFERENCE SCALED AT PI, 1'S COMP.
060785,000291: 20,2266           55763                           TS       AK         +2                 	# SAVE Z-AXIS TERM FOR R ERROR CALCULATION
060786,000292: 20,2267           00006                           EXTEND                                 	#
060787,000293: 20,2270           71417                           MP       M22                           	# (CPSI-CDUZ)*M22, SCALED AT PI RADIANS.
060788,000294: 20,2271           61762                           AD       AK         +1                 	# Q ERROR COMPLETE         , AT PI RAD.
060789,000295: 20,2272           02435                           TC       OVERSUB2                      	# PIN NEEDLES IN CASE OF OVERFLOW.
060790,000296: 20,2273           55762                           TS       AK         +1                 	#
060791,000297: 
060792,000298:                                                                                          	# R ERROR CALCULATION NEXT.
060793,000299: 
060794,000300: 20,2274           31761                           CA       AK                            	# Y-AXIS DIFFERENCE STORED BY Q-AXIS CALC.
060795,000301: 20,2275           00006                           EXTEND                                 	#
060796,000302: 20,2276           71416                           MP       M31                           	# (CTHETA-CDUY)*M31, SCALED AT PI RADIANS.
060797,000303: 20,2277           57763                           XCH      AK         +2                 	# FIRST TERM OF R ERROR.
060798,000304:                                                                                          	# Z-AXIS DIFFERENCE, STORED BY A CALC. IS
060799,000305: 20,2300           00006                           EXTEND                                 	# RECOVERED BY THE EXCHANGE.
060800,000306: 20,2301           71420                           MP       M32                           	# (CPSI-CDUZ)*M32, SCALED AT PI RADIANS.
060801,000307: 20,2302           61763                           AD       AK         +2                 	# R ERROR COMPLETE         , AT PI RAD.
060802,000308: 20,2303           02435                           TC       OVERSUB2                      	# PIN NEEDLES IN CASE OF OVERFLOW.
060803,000309: 20,2304           55763                           TS       AK         +2                 	#
060804,000310: 
060805,000311:                                                                                          	# NOW CALCULATE P ERROR.  (NOTE THAT M13 = 1, SCALED AT 1, SO THE MULTIPLICATION IS BY-PASSED.)
060807,000313: 20,2305           31761                           CA       AK                            	# Y-AXIS DIFFERENCE STORED BY Q AXIS CALC.
060808,000314: 20,2306           00006                           EXTEND                                 	#
060809,000315: 20,2307           71414                           MP       M11                           	# (CTHETA-CDUY)*M11 SCALED AT PI RADIANS.
060810,000316: 20,2310           57761                           XCH      AK                            	# FIRST TERM OF P ERROR IN AK, AT PI RAD.
060811,000317: 20,2311           30321                           CAE      CPHI                          	# DESIRED ATTITUDE, X-AXIS, 2'S COMP.
060812,000318: 20,2312           00006                           EXTEND                                 	# SUBTRACT CURRENT X ATTITUDE.
060813,000319: 20,2313           20032                           MSU      CDUX                          	# X-AXIS DIFFERENCE, 1'S COMP, AT PI RAD.
060814,000320: 
060815,000321:                                                                                          	# M13 = 1, SO BYPASS THE MULTIPLICATION.
060816,000322:                                                                                          	#               EXTEND
060817,000323:                                                                                          	#               MP      M13             (CPHI-CDUX)*M13 SCALED AT PI RADIANS.
060818,000324: 
060819,000325: 20,2314           61761                           AD       AK                            	# P ERROR COMPLETE      , SCALED AT PI RAD
060820,000326: 20,2315           02435                           TC       OVERSUB2                      	# PIN NEEDLES IN CASE OF OVERFLOW.
060821,000327: 20,2316           55761                           TS       AK                            	#
060822,000328: 
060823,000329: 20,2317           00006                           EXTEND                                 	#
060824,000330: 20,2320           22061                           QXCH     ITEMP1                        	# RESTORE Q FOR CHEKBITS RETURN.
060825,000331: 
060826,000332: 20,2321           12442                           TCF      RETNMORE                      	# DISPLAY THESE THE NEXT TIME THROUGH
060827,000333: 
060829,000335:                                                                                          	# FDAI ATTITUDE ERROR DISPLAY SUBROUTINE
060830,000336: 
060831,000337:                                                                                          	# PROGRAM DESCRIPTION:          D. KEENE        5/24/67
060832,000338:                                                                                          	# MOD 1 BY CRAIG WORK, 12 DEC 67
060833,000339:                                                                                          	# MOD 2 BY CRAIG WORK, 6 APRIL 68 CONVERTS ATTITUDE ERROR DISPLAY SCALING FROM 16 7/8 DEG. TO 42 3/16 DEGREES.
060834,000340: 
060835,000341:                                                                                          	# THIS SUBROUTINE IS USED TO DISPLAY ATTITUDE ERRORS ON THE FDAI VIA THE DIGITAL TO ANALOG CONVERTERS (DACS)
060836,000342:                                                                                          	# IN THE CDUS.  CARE IS TAKEN TO METER OUT THE APPROPRIATE NUMBER OF PULSES TO THE IMU ERROR COUNTERS AND PREVENT
060837,000343:                                                                                          	# OVERFLOW, TO CONTROL THE RELAY SEQUENCING, AND TO AVOID INTERFERENCE WITH THE COARSE ALIGN LOOP WHICH ALSO USES
060838,000344:                                                                                          	# THE DACS.
060839,000345: 
060840,000346:                                                                                          	# CALLING SEQUENCE:
060841,000347:                                                                                          	#       DURING THE INITIALIZATION SECTION OF THE USER'S PROGRAM, BIT3 OF RCSFLAGS SHOULD BE SET TO INITIATE THE
060842,000348:                                                                                          	#       TURN-ON SEQUENCE WITHIN THE NEEDLES PROGRAM:
060843,000349:                                                                                          	#               CS      RCSFLAGS        IN EBANK6
060844,000350:                                                                                          	#               MASK    BIT3
060845,000351:                                                                                          	#               ADS     RCSFLAGS
060846,000352:                                                                                          	#       THEREAFTER, THE ATTITUDE ERRORS GENERATED BY THE USER SHOULD BE TRANSFERED TO THE FOLLOWING LOCATIONS IN EBANK6:
060847,000353:                                                                                          	#               AK      SCALED 180 DEGREES      NOTE:   THESE LOCATIONS ARE SUBJECT
060848,000354:                                                                                          	#               AK1     SCALED 180 DEGREES              TO CHANGE
060849,000355:                                                                                          	#               AK2     SCALED 180 DEGREES
060850,000356:                                                                                          	#       FULL SCALED DEFLECTION OF THE NEEDLES CORRESPONDS TO 5 1/16 DEGREES, WHILE 384 BITS IN THE IMU ERROR COUNTER
060851,000357:                                                                                          	#       CORRESPONDS TO 42 3/16 DEGREES.  (DAC MAXIMUM CAPACITY IS 384 BITS.)  46 BITS EFFECTIVELY PIN THE NEEDLES.
060852,000358: 
060853,000359:                                                                                          	#       A CALL TO NEEDLER WILL THEN UPDATE THE DISPLAY:
060854,000360:                                                                                          	#               INHINT
060855,000361:                                                                                          	#               TC      IBNKCALL        NOTE:  EBANK SHOULD BE SET TO E6
060856,000362:                                                                                          	#               CADR    NEEDLER
060857,000363:                                                                                          	#               RELINT
060858,000364:                                                                                          	#       THIS PROCESS SHOULD BE REPEATED EACH TIME THE ERRORS ARE UPDATED.  AT LEAST 3 PASSES THRU THE PROGRAM ARE
060859,000365:                                                                                          	#       REQUIRED BEFORE ANYTHING IS ACTUALLY DISPLAYED ON THE ERROR METERS.
060860,000366:                                                                                          	#       NOTE:  EACH CALL TO NEEDLER MUST BE SEPARATED BY AT LEAST 50 MS TO ASSURE PROPER RELAY SEQUENCING.
060861,000367: 
060862,000368:                                                                                          	# ERASABLE USED:
060863,000369:                                                                                          	#       AK              CDUXCMD
060864,000370:                                                                                          	#       AK1             CDUYCMD
060865,000371:                                                                                          	#       AK2             CDUZCMD
060866,000372:                                                                                          	#       EDRIVEX         A,L,Q
060867,000373:                                                                                          	#       EDRIVEY         T5TEMP
060868,000374:                                                                                          	#       EDRIVEZ         DINDX
060870,000376: 
060871,000377:                                                                                          	# SWITCHES:             RCSFLAGS  BITS 3,2
060872,000378: 
060873,000379:                                                                                          	# I/O CHANNELS:         CHAN12  BIT 4 (COARSE ALIGN - READ ONLY)
060874,000380:                                                                                          	#                       CHAN12  BIT 6 (IMU ERROR COUNTER ENABLE)
060875,000381:                                                                                          	#                       CHAN14  BIT 13,14,15 (DAC ACTIVITY)
060876,000382: 
060877,000383:                                                                                          	# SIGN CONVENTION<      AK = THETAC - THETA
060878,000384:                                                                                          	#                       WHERE   THETAC = COMMAND ANGLE
060879,000385:                                                                                          	#                               THETA = PRESENT ANGLE
060880,000386: 
060881,000387: 20,2322           31273        NEEDLER            CA       RCSFLAGS                      	#
060882,000388: 20,2323           76242                           MASK     SIX                           	#
060883,000389: 20,2324           00006                           EXTEND                                 	#
060884,000390: 20,2325           12362                           BZF      NEEDLES3                      	#
060885,000391: 20,2326           74751                           MASK     BIT3                          	#
060886,000392: 20,2327           00006                           EXTEND                                 	#
060887,000393: 20,2330           12353                           BZF      NEEDLER2                      	# BIT3 = 0, BIT2 = 1
060888,000394: 
060889,000395: 20,2331           44746                           CS       BIT6                          	# FIRST PASS BIT3 = 1
060890,000396: 20,2332           00006                           EXTEND                                 	# DISABLE IMU ERROR COUNTER TO ZERO DACS
060891,000397: 20,2333           03012                           WAND     CHAN12                        	# MUST WAIT AT LEAST 60 MS BEFORE
060892,000398: 20,2334           44755        NEEDLE11           CS       ZERO                          	# ENABLING COUNTERS.
060893,000399: 20,2335           55761                           TS       AK                            	# ZERO THE INPUTS ON FIRST PASS
060894,000400: 20,2336           55762                           TS       AK1                           	#
060895,000401: 20,2337           55763                           TS       AK2                           	#
060896,000402: 20,2340           55764                           TS       EDRIVEX                       	# ZERO THE DISPLAY REGISTERS
060897,000403: 20,2341           55765                           TS       EDRIVEY                       	#
060898,000404: 20,2342           55766                           TS       EDRIVEZ                       	#
060899,000405: 20,2343           54050                           TS       CDUXCMD                       	# ZERO THE OUT COUNTERS
060900,000406: 20,2344           54051                           TS       CDUYCMD                       	#
060901,000407: 20,2345           54052                           TS       CDUZCMD                       	#
060902,000408: 20,2346           46242                           CS       SIX                           	# RESET RCSFLAGS FOR PASS2
060903,000409: 20,2347           71273                           MASK     RCSFLAGS                      	#
060904,000410: 20,2350           64752                           AD       BIT2                          	#
060905,000411: 20,2351           55273                           TS       RCSFLAGS                      	#
060906,000412: 20,2352           12442                           TCF      RETNMORE                      	#
060907,000413: 
060908,000414: 20,2353           34746        NEEDLER2           CAF      BIT6                          	# ENABLE IMU ERROR COUNTERS
060909,000415: 20,2354           00006                           EXTEND                                 	#
060910,000416: 20,2355           05012                           WOR      CHAN12                        	#
060911,000417: 20,2356           46242                           CS       SIX                           	# RESET RCSFLAGS TO DISPLAY ATTITUDE
060912,000418: 20,2357           71273                           MASK     RCSFLAGS                      	# ERRORS    WAIT AT LEAST 4 MS FOR
060913,000419: 20,2360           55273                           TS       RCSFLAGS                      	# RELAY CLOSURE
060914,000420: 20,2361           12442                           TCF      RETNMORE                      	#
060915,000421: 
060916,000422: 20,2362           34746        NEEDLES3           CAF      BIT6                          	# CHECK TO SEE IF IMU ERROR COUNTER
060917,000423: 20,2363           00006                           EXTEND                                 	# IS ENABLED
060918,000424: 20,2364           02012                           RAND     CHAN12                        	#
060920,000426: 20,2365           10000                           CCS      A                             	# IF NOT, RE-INITIALIZE NEEDLER.
060921,000427: 20,2366           12373                           TCF      NEEDLES                       	#
060922,000428: 
060923,000429: 20,2367           41273                           CS       RCSFLAGS                      	# SET UP INITIALIZATION FLAG IN RCSFLAGS.
060924,000430: 20,2370           74751                           MASK     BIT3                          	#
060925,000431: 20,2371           27273                           ADS      RCSFLAGS                      	#
060926,000432: 20,2372           12442                           TCF      RETNMORE                      	#
060927,000433: 
060928,000434: 20,2373           34752        NEEDLES            CAF      TWO                           	#
060929,000435: 20,2374           54063        DACLOOP            TS       DINDX                         	#
060930,000436: 20,2375           42434                           CS       ONETENTH                      	# RESCALE INPUTS TO + OR - 1800 DEGREES.
060931,000437: 20,2376           00006                           EXTEND                                 	#
060932,000438: 20,2377           50063                           INDEX    DINDX                         	#
060933,000439: 20,2400           71761                           MP       AK                            	#
060934,000440: 20,2401           54001                           TS       L                             	#
060935,000441: 20,2402           10000                           CCS      A                             	#
060936,000442: 20,2403           32432                           CA       DACLIMIT                      	#
060937,000443: 20,2404           12406                           TCF      +2                            	#
060938,000444: 20,2405           42432                           CS       DACLIMIT                      	#
060939,000445: 20,2406           60001                           AD       L                             	#
060940,000446: 20,2407           54061                           TS       T5TEMP                        	# OVFLO CHK
060941,000447: 20,2410           12414                           TCF      +4                            	#
060942,000448: 20,2411           50000                           INDEX    A                             	# ON OVERFLOW LIMIT OUTPUT TO +-384
060943,000449: 20,2412           32432                           CAF      DACLIMIT                      	#
060944,000450: 20,2413           54001                           TS       L                             	#
060945,000451: 20,2414           50063                           INDEX    DINDX                         	#
060946,000452: 20,2415           41764                           CS       EDRIVEX                       	# CURRENT VALUE OF DAC
060947,000453: 20,2416           60001                           AD       L                             	#
060948,000454: 20,2417           50063                           INDEX    DINDX                         	#
060949,000455: 20,2420           26050                           ADS      CDUXCMD                       	#
060950,000456: 20,2421           50063                           INDEX    DINDX                         	#
060951,000457: 20,2422           23764                           LXCH     EDRIVEX                       	#
060952,000458: 20,2423           10063                           CCS      DINDX                         	#
060953,000459: 20,2424           12374                           TCF      DACLOOP                       	#
060954,000460: 20,2425           37740                           CAF      13,14,15                      	#
060955,000461: 20,2426           00006                           EXTEND                                 	#
060956,000462: 20,2427           05014                           WOR      CHAN14                        	# SET DAC ACTIVITY BITS
060957,000463: 20,2430           12442                           TCF      RETNMORE                      	#
060958,000464: 
060959,000465: 20,2431           77177                           DEC      -384       B-14               	#
060960,000466: 20,2432           37200        DACLIMIT           DEC      16000      B-14               	#
060961,000467: 20,2433           00600                           DEC      384        B-14               	#
060962,000468: 
060963,000469: 20,2434           03146        ONETENTH           OCT      03146                         	# DECIMAL +0.1, SCALED AT 1.
060964,000470: 20,2435     4750               DSPLYALT           EQUALS   BIT4                          	# 100 MS ALTERNATION BIT IN RCSFLAGS
060965,000471: 
060966,000472: 20,2435           54007        OVERSUB2           TS       7                             	# RETURNS A UNCHANGED OR LIMITED TO
060967,000473: 20,2436           00002                           TC       Q                             	# POSMAX OR NEGMAX IF A HAS OVERFLOW
060968,000474: 20,2437           50000                           INDEX    A                             	#
060970,000476: 20,2440           44734                           CS       LIMITS                        	# DUPLICATE CODING IN BANK 16
060971,000477: 20,2441           00002                           TC       Q                             	#
060972,000478: 
060973,000479: 20,2442           00006        RETNMORE           EXTEND                                 	# RETURN TO CHEKMORE
060974,000480: 20,2443           32446                           DCA      MORECADR                      	#
060975,000481: 20,2444           52006                           DTCB                                   	#
060976,000482: 
060977,000483: 20,2445  E6,1537                                  EBANK=   AOSQ                          	#

048847,000267:                                                                                          	# 10-11D=XDOT (REVS/CSEC) SCALED B+23 FOR WEARTH,B+28 FOR NODDOT AND BDOT
048848,000268:                                                                                          	#                       AND B+27 FOR FDOT
048849,000269:                                                                                          	#  X1=DIFFERENCE IN 23 AND SCALING OF XDOT, =0 FOR WEARTH, 5 FOR NODDOT AND
048850,000270:                                                                                          	#                                       BDOT AND 4 FOR FDOT
048851,000271:                                                                                          	# 6-7D=T (CSEC B-28), TIMSUBO= (CSEC B-42 TRIPLE PREC.)

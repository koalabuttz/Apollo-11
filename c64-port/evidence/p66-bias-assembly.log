033400,000802:                                                                                          	# SUBROUTINE NAME:  S40.2,3             MOD. NO. 3 DATE: APRIL 4, 1967
033401,000803:                                                                                          	# MODIFICATION BY:  JONATHAN D. ADDELSTON (ADAMS ASSOCIATES)
033402,000804:                                                                                          	# MOD. NO. 4:  JULY 18, 1967: PETER ADLER (MIT/IL)
033403,000805:                                                                                          	# MOD. NO. 5:  OCTOBER 18, 1967:  PETER ADLER (MIT/IL)
033404,000806:                                                                                          	# ORIGINALLY BY:  SAYDEAN ZELDIN (MIT INSTRUMENTATION LAB) AND RICHARD TALAYCO (SYSTEM DEVELOPMENT CORP)
033405,000807: 
033406,000808:                                                                                          	# S40.2,3 COMPUTES "POINTVSM" WHICH IS THE HALF-UNIT DESIRED THRUST VECTOR IN STABLE-MEMBER COORDINATES FROM "UT"
033407,000809:                                                                                          	# WHICH IS THE SAME VECTOR IN REFERENCE COORDINATES.  IT DETERMINES THE CORRECT VALUES FOR "SCAXIS" USING THE +X
033408,000810:                                                                                          	# AXIS FOR DPS, APS, AND RCS BURNS.  THE "WINGS-LEVEL HEADS-UP" LM ORIENTATION IS THEN COMPUTED IN REFERENCE
033409,000811:                                                                                          	# COORDINATES.  THESE VECTORS ALSO DEFINE THE "PREFERRED IMU ORIENTATION".  UPON COMPLETION OF THIS CALCULATION,
033410,000812:                                                                                          	# THE "PREFERRED ATTITUDE COMPUTED" FLAG IS SET (PFRATFLG).
033411,000813: 
033412,000814:                                                                                          	# CALLING SEQUENCE:
033413,000815:                                                                                          	#       L       CALL                    INTERPRETIVE CALL.
033414,000816:                                                                                          	#       L +1            S40.2,3
033415,000817:                                                                                          	#       L +2    (RETURN)                GIMBAL ANGLE VECTOR IN MPAC.
033416,000818: 
033417,000819:                                                                                          	# SUBROUTINES CALLED:  NONE.
033418,000820: 
033419,000821:                                                                                          	# NORMAL RETURN:  L +2 (SEE CALLING SEQUENCE ABOVE).
033420,000822: 
033421,000823:                                                                                          	# ALARM/ABORT MODES:  NONE.
033422,000824: 

016836,000357: 
016837,000358:                                                                                          	#       MPAC, THRU MPAC +6
016838,000359:                                                                                          	#       BUF, +1, +2
016839,000360:                                                                                          	#       BUF2, +1, +2
016840,000361:                                                                                          	#       MPTEMP
016841,000362:                                                                                          	#       ADDRWD
016842,000363: 
016843,000364:                                                                                          	# END OF ADDITIONAL TEMPS FOR PINBALL EXEC ACTION
016844,000365: 
016845,000366:                                                                                          	# RESERVED FOR PINBALL INTERRUPT ACTION
016846,000367: 
016847,000368:                                                                                          	# DSPCNT        ERASE                   COUNTER FOR DSPOUT
016848,000369:                                                                                          	# UPLOCK        ERASE                   BIT1 = UPLINK INTERLOCK (ACTIVATED BY
016849,000370:                                                                                          	#                                       RECEPTION OF A BAD MESSAGE IN UPLINK)
016850,000371: 
016851,000372:                                                                                          	# END OF ERASABLES RESERVED FOR PINBALL INTERRUPT ACTION
016852,000373: 
016853,000374:                                                                                          	# TEMPORARIES FOR PINBALL INTERRUPT ACTION
016854,000375: 
016855,000376:                                                                                          	# KEYTEMP1      =       WAITEXIT        TEMP FOR KEYRUPT, UPRUPT
016856,000377:                                                                                          	# DSRUPTEM      =       WAITEXIT        TEMP FOR DSPOUT
016857,000378:                                                                                          	# KEYTEMP2      =       RUPTAGN         TEMP FOR KEYRUPT, UPRUPT
016858,000379: 
016859,000380:                                                                                          	# END OF TEMPORARIES FOR PINBALL INTERRUPT ACTION
016860,000381: 
016862,000383:                                                                                          	# THE INPUT CODES ASSUMED FOR THE KEYBOARD ARE,
016863,000384:                                                                                          	# 0             10000
016864,000385:                                                                                          	# 1             00001
016865,000386:                                                                                          	# 9             01001
016866,000387:                                                                                          	# VERB          10001
016867,000388:                                                                                          	# ERROR RES     10010
016868,000389:                                                                                          	# KEY RLSE      11001
016869,000390:                                                                                          	# +             11010
016870,000391:                                                                                          	# -             11011
016871,000392:                                                                                          	# ENTER         11100
016872,000393:                                                                                          	# CLEAR         11110
016873,000394:                                                                                          	# NOUN          11111
016874,000395: 
016876,000397: 
016877,000398:                                                                                          	# OUTPUT FORMAT FOR DISPLAY PANEL.  SET OUT0 TO AAAABCCCCCDDDDD.
016878,000399:                                                                                          	# A-S   SELECT A RELAYWORD. THIS DETERMINES WHICH PAIR OF CHARACTERS ARE
016879,000400:                                                                                          	#       ENERGIZED.
016880,000401:                                                                                          	# B     FOR SPECIAL RELAYS SUCH AS SIGNS ETC.
016881,000402:                                                                                          	# C-S   5 BIT RELAY CODE FOR LEFT CHAR OF PAIR SELECTED BY RELAYWORD
016882,000403:                                                                                          	# D-S   5 BIT RELAY CODE FOR RIGHT CHAR OF PAIR SELECTED BY RELAYWORD.
016883,000404: 
016884,000405:                                                                                          	# THE PANEL APPEARS AS FOLLOWS,
016885,000406:                                                                                          	# MD1   MD2                             (MAJOR MODE)
016886,000407:                                                                                          	# VD1   VD2 (VERB)      ND1     ND2     (NOUN)
016887,000408:                                                                                          	# R1D1  R1D2    R1D3    R1D4    R1D5    (R1)
016888,000409:                                                                                          	# R2D1  R2D2    R2D3    R2D4    R2D5    (R2)
016889,000410:                                                                                          	# R3D1  R3D2    R3D3    R3D4    R3D5    (R3)
016890,000411: 
016891,000412:                                                                                          	# EACH OF THESE IS GIVEN A DSPCOUNT NUMBER FOR USE WITHIN COMPUTATION ONLY
016892,000413: 
016893,000414:                                                                                          	# MD1   25              R2D1    11              ALL ARE OCTAL
016894,000415:                                                                                          	# MD2   24              R2D2    10
016895,000416:                                                                                          	# VD1   23              R2D3     7
016896,000417:                                                                                          	# VD2   22              R2D4     6
016897,000418:                                                                                          	# ND1   21              R2D5     5
016898,000419:                                                                                          	# ND2   20              R3D1     4
016899,000420:                                                                                          	# R1D1  16              R3D2     3
016900,000421:                                                                                          	# R1D2  15              R3D3     2
016901,000422:                                                                                          	# R1D3  14              R3D4     1
016902,000423:                                                                                          	# R1D4  13              R3D5     0
016903,000424:                                                                                          	# R1D5  12
016904,000425: 
016905,000426:                                                                                          	# THERE IS AN 11 REGISTER TABLE (DSPTAB) FOR THE DISPLAY PANEL.
016906,000427: 
016907,000428:                                                                                          	# DSPTAB                RELAYWD         BIT11           BITS 10-6       BITS 5-1
016908,000429:                                                                                          	# RELADD
016909,000430:                                                                                          	# 10            1011                            MD1 (25)        MD2 (24)
016910,000431:                                                                                          	# 9             1010                            VD1 (23)        VD2 (22)
016911,000432:                                                                                          	# 8             1001                            ND1 (21)        ND2 (20)
016912,000433:                                                                                          	# 7             1000                                            R1D1 (16)
016914,000435:                                                                                          	# 6             0111            +R1             R1D2 (15)       R1D3 (14)
016915,000436:                                                                                          	# 5             0110            -R1             R1D4 (13)       R1D5 (12)
016916,000437:                                                                                          	# 4             0101            +R2             R2D1 (11)       R2D2 (10)
016917,000438:                                                                                          	# 3             0100            -R2             R2D3 (7)        R2D4 (6)
016918,000439:                                                                                          	# 2             0011                            R2D5 (5)        R3D1 (4)
016919,000440:                                                                                          	# 1             0010            +R3             R3D2 (3)        R3D3 (2)
016920,000441:                                                                                          	# 0             0001            -R3             R3D4 (1)        R3D5 (0)
016921,000442:                                                                                          	#               0000        NO RELAYWORD
016922,000443: 
016923,000444:                                                                                          	# THE 5 BIT OUTPUT RELAY CODES ARE:
016924,000445: 
016925,000446:                                                                                          	# BLANK 00000
016926,000447:                                                                                          	# 0     10101
016927,000448:                                                                                          	# 1     00011
016928,000449:                                                                                          	# 2     11001
016929,000450:                                                                                          	# 3     11011
016930,000451:                                                                                          	# 4     01111
016931,000452:                                                                                          	# 5     11110
016932,000453:                                                                                          	# 6     11100
016933,000454:                                                                                          	# 7     10011
016934,000455:                                                                                          	# 8     11101
016935,000456:                                                                                          	# 9     11111
016936,000457: 
016937,000458:                                                                                          	# OUTPUT BITS USED BY PINBALL:
016938,000459: 
016939,000460:                                                                                          	#       KEY RELEASE LIGHT       -       BIT 5 OF CHANNEL 11
016940,000461:                                                                                          	#       VERB/NOUN FLASH         -       BIT 6 OF CHANNEL 11
016941,000462:                                                                                          	#       OPERATOR ERROR LIGHT    -       BIT 7 OF CHANNEL 11
016942,000463: 

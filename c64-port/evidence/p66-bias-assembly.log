021802,000606:                                                                                          	# PROGRAM DESCRIPTION
021803,000607: 
021804,000608:                                                                                          	#       MOD NO - 2
021805,000609:                                                                                          	#       BY P VOLANTE
021806,000610: 
021807,000611:                                                                                          	# FUNCTIONAL DESCRIPTION
021808,000612: 
021809,000613:                                                                                          	#       TO PROCESS AUTOMATIC RR MARK DATA TO UPDATE THE STATE VECTOR OF EITHER
021810,000614:                                                                                          	#       LM OR CSM AS DEFINED IN THE RENDEZVOUS NAVIGATION PROGRAM (P20)
021811,000615: 
021812,000616:                                                                                          	# CALLING SEQUENCE -
021813,000617: 
021814,000618:                                                                                          	#       TC      BANKCALL

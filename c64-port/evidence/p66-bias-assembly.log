033575,000977:                                                                                          	# NAME                  S40.13 - TIMEBURN
033576,000978: 
033577,000979:                                                                                          	# FUNCTION              (1) DETERMINE WHETHER A GIVEN COMBINATION OF VELOCITY TO
033578,000980:                                                                                          	#                       BE GAINED AND ENGINE CHOICE RESULT IN A BURN TIME
033579,000981:                                                                                          	#                       SUFFICIENT TO ALLOW STEERING AT THE VEHICLE DURING THE
033580,000982:                                                                                          	#                       BURN
033581,000983:                                                                                          	#                       (2) THE MAGNITUDE OF THE RESULTING BURN TIME -- IF IT
033582,000984:                                                                                          	#                       IS SHORT -- AND THE ASSOCIATED TIME OF THE ENGINE OFF
033583,000985:                                                                                          	#                       SIGNAL
033584,000986: 
033585,000987:                                                                                          	# CALLING SEQUENCE      VIA FINDVAC AS A NEW JOB
033586,000988: 
033587,000989:                                                                                          	# INPUT                 VGTIG VELOCITY TO BE GAINED VECTOR (METERS/CS) AT +7
033588,000990:                                                                                          	#                       WEIGHT/G MASS OF VEHICLE IN KGM AT +16
033589,000991:                                                                                          	#                       F  APS ENGINE THRUST IN M.NEWTONS AT +7
033590,000992:                                                                                          	#                               AND ALSO FOR RCS ENGINE
033591,000993:                                                                                          	#                       MDOT RATE OF DECREASE OF VEHICLE MASS DURING ENGINE
033592,000994:                                                                                          	#                               BURN IN KILOGRAMS/CS AT +3.  THIS SCALING MAY
033593,000995:                                                                                          	#                               REQUIRE MODIFICATION FOR SATURN BURNS.
033594,000996:                                                                                          	#                       ENG1FLAG      SWITCH TO DECIDE WHETHER APS OR DPS ENGINE IS USED
033595,000997:                                                                                          	#                               =0      DPS
033596,000998:                                                                                          	#                               =1      APS
033597,000999: 
033598,001000:                                                                                          	# OUTPUT                IMPULSW         ZERO FOR STEERING

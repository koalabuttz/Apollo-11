028412,000036:                                                                                          	## actually created.
028413,000037:                                                                                          	##
028414,000038:                                                                                          	## Notations on the hardcopy document read, in part:
028415,000039:                                                                                          	##
028416,000040:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
028417,000041:                                                                                          	##      16:27 JULY 14, 1969 
028418,000042: 
028420,000044:                                                                                          	# TRANSFER PHASE INITIATION (TPI) PROGRAMS (P34 AND P74)
028421,000045: 
028422,000046:                                                                                          	# MOD NO -1                     LOG SECTION - P32-P35, P72-P75
028423,000047:                                                                                          	# MOD BY WHITE.P                DATE  1JUNE67
028424,000048: 
028425,000049:                                                                                          	# PURPOSE
028426,000050: 
028427,000051:                                                                                          	#       (1)     TO CALCULATE THE REQUIRED DELTA V AND OTHER INITIAL CONDITIONS
028428,000052:                                                                                          	#               REQUIRED BY THE ACTIVE VEHICLE FOR EXECUTION OF THE TRANSFER
028429,000053:                                                                                          	#               PHASE INITIATION (TPI) MANEUVER, GIVEN -
028430,000054: 
028431,000055:                                                                                          	#               (A)     TIME OF IGNITION TIG (TPI) OR THE ELEVATION ANGLE (E) OF
028432,000056:                                                                                          	#                       THE ACTIVE/PASSIVE VEHICLE LOS AT TIG (TPI).
028433,000057: 
028434,000058:                                                                                          	#               (B)     CENTRAL ANGLE OF TRANSFER (CENTANG) FROM TIG (TPI) TO
028435,000059:                                                                                          	#                       INTERCEPT TIME (TIG (TPF)).
028436,000060: 
028437,000061:                                                                                          	#       (2)     TO CALCULATE TIG (TPI) GIVEN E OR E GIVEN TIG (TPI).
028438,000062: 
028439,000063:                                                                                          	#       (3)     TO CALCULATE THESE PARAMETERS BASED UPON MANEUVER DATA
028440,000064:                                                                                          	#               APPROVED AND KEYED INTO THE DSKY BY THE ASTRONAUT.
028441,000065: 
028442,000066:                                                                                          	#       (4)     TO DISPLAY TO THE ASTRONAUT AND THE GROUND CERTAIN DEPENDENT
028443,000067:                                                                                          	#               VARIABLES ASSOCIATED WITH THE MANEUVER FOR APPROVAL BY THE
028444,000068:                                                                                          	#               ASTRONAUT/GROUND.
028445,000069: 
028446,000070:                                                                                          	#       (5)     TO STORE THE TPI TARGET PARAMETERS FOR USE BY THE DESIRED
028447,000071:                                                                                          	#               THRUSTING PROGRAM.
028448,000072: 
028449,000073:                                                                                          	# ASSUMPTIONS
028450,000074: 
028451,000075:                                                                                          	#       (1)     LM ONLY - THIS PROGRAM IS BASED UPON PREVIOUS COMPLETION OF
028452,000076:                                                                                          	#               THE CONSTANT DELTA ALTITUDE (CDH) PROGRAM (P33/P73).
028453,000077:                                                                                          	#               THEREFORE -
028454,000078: 
028455,000079:                                                                                          	#               (A)     AT A SELECTED TPI TIME (NOW IN STORAGE) THE LINE OF SIGHT
028456,000080:                                                                                          	#                       BETWEEN THE ACTIVE AND PASSIVE VEHICLES WAS SELECTED TO BE
028457,000081:                                                                                          	#                       A PRESCRIBED ANGLE (E) (NOW IN STORAGE) FROM THE
028458,000082:                                                                                          	#                       HORIZONTAL PLANE DEFINED BY THE ACTIVE VEHICLE POSITION.
028459,000083: 
028460,000084:                                                                                          	#               (B)     THE TIME BETWEEN CDH IGNITION AND TPI IGNITION WAS
028461,000085:                                                                                          	#                       COMPUTED TO BE GREATER THAN 10 MINUTES.
028462,000086: 
028463,000087:                                                                                          	#               (C)     THE VARIATION OF THE ALTITUDE DIFFERENCE BETWEEN THE
028464,000088:                                                                                          	#                       ORBITS WAS MINIMIZED.
028465,000089: 
028466,000090:                                                                                          	#               (D)     THE PERICENTER ALTITUDES OF ORBITS FOLLOWING CSI AND
028467,000091:                                                                                          	#                       CDH WERE COMPUTED TO BE GREATER THAN 35,000 FT FOR LUNAR
028469,000093:                                                                                          	#                       ORBIT OR 85 NM FOR EARTH ORBIT.
028470,000094: 
028471,000095:                                                                                          	#               (E)     THE CSI AND CDH MANEUVERS WERE ASSUMED TO BE PARALLEL TO
028472,000096:                                                                                          	#                       THE PLANE OF THE PASSIVE VEHICLE ORBIT.  HOWEVER, CREW
028473,000097:                                                                                          	#                       MODIFICATION OF DELTA V (LV) COMPONENTS MAY HAVE RESULTED
028474,000098:                                                                                          	#                       IN AN OUT-OF-PLANE MANEUVER.
028475,000099: 
028476,000100:                                                                                          	#       (2)     STATE VECTOR UPDATED BY P27 ARE DISALLOWED DURING AUTOMATIC
028477,000101:                                                                                          	#               STATE VECTOR UPDATING INITIATED BY P20 (SEE ASSUMPTION (4)).
028478,000102: 
028479,000103:                                                                                          	#       (3)     THIS PROGRAM MUST BE DONE OVER A TRACKING STATION FOR REAL
028480,000104:                                                                                          	#               TIME GROUND PARTICIPATION IN DATA INPUT AND OUTPUT.  COMPUTED
028481,000105:                                                                                          	#               VARIABLES MAY BE STORED FOR LATER VERIFICATION BY THE GROUND.
028482,000106:                                                                                          	#               THESE STORAGE CAPABILITIES ARE LIMITED ONLY TO THE PARAMETERS
028483,000107:                                                                                          	#               FOR ONE THRUSTING MANEUVER AT A TIME EXCEPT FOR CONCENTRIC
028484,000108:                                                                                          	#               FLIGHT PLAN MANEUVER SEQUENCES.
028485,000109: 
028486,000110:                                                                                          	#       (4)     THE RENDEZVOUS RADAR MAY OR MAY NOT BE USED TO UPDATE THE LM
028487,000111:                                                                                          	#               OR CSM STATE VECTORS FOR THIS PROGRAM.  IF RADAR USE IS
028488,000112:                                                                                          	#               DESIRED THE RADAR WAS TURNED ON AND LOCKED ON THE CSM BY
028489,000113:                                                                                          	#               PREVIOUS SELECTION OF P20.  RADAR SIGHTING MARKS WILL BE MADE
028490,000114:                                                                                          	#               AUTOMATICALLY APPROXIMATELY ONCE A MINUTE WHEN ENABLED BY THE
028491,000115:                                                                                          	#               TRACK AND UPDATE FLAGS (SEE P20).  THE RENDEZVOUS TRACKING
028492,000116:                                                                                          	#               MARK COUNTER IS ZEROED BY THE SELECTION OF P20 AND AFTER EACH
028493,000117:                                                                                          	#               THRUSTING MANEUVER.
028494,000118: 
028495,000119:                                                                                          	#       (5)     THE ISS NEED NOT BE ON TO COMPLETE THIS PROGRAM.
028496,000120: 
028497,000121:                                                                                          	#       (6)     THE OPERATION OF THE PROGRAM UTILIZES THE FOLLOWING FLAGS -
028498,000122: 
028499,000123:                                                                                          	#                       ACTIVE VEHICLE FLAG - DESIGNATES THE VEHICLE WHICH IS
028500,000124:                                                                                          	#                       DOING RENDEZVOUS THRUSTING MANEUVERS TO THE PROGRAM WHICH
028501,000125:                                                                                          	#                       CALCULATES THE MANEUVER PARAMETERS.  SET AT THE START OF
028502,000126:                                                                                          	#                       EACH RENDEZVOUS PRE-THRUSTING PROGRAM.
028503,000127: 
028504,000128:                                                                                          	#                       FINAL FLAG - SELECTS FINAL PROGRAM DISPLAYS AFTER CREW HAS
028505,000129:                                                                                          	#                       SELECTED THE FINAL MANEUVER COMPUTATION CYCLE.
028506,000130: 
028507,000131:                                                                                          	#                       EXTERNAL DELTA V FLAG - DESIGNATES THE TYPE OF STEERING
028508,000132:                                                                                          	#                       REQUIRED FOR EXECUTION OF THIS MANEUVER BY THE THRUSTING
028509,000133:                                                                                          	#                       PROGRAM SELECTED AFTER COMPLETION OF THIS PROGRAM.
028510,000134: 
028511,000135:                                                                                          	#       (7)     ONCE THE PARAMETWRS REQUIRED FOR COMPUTION OF THE MANEUVER
028512,000136:                                                                                          	#               HAVE BEEN COMPLETELY SPECIFIED, THE VALUE OF THE ACTIVE
028513,000137:                                                                                          	#               VEHICLE CENTRAL ANGLE OF TRANSFER IS COMPUTED AND STORED.
028514,000138:                                                                                          	#               THIS NUMBER WILL BE AVAILABLE FOR DISPLAY TO THE ASTRONAUT
028515,000139:                                                                                          	#               THROUGH THE USE OF V06N52.
028516,000140: 
028517,000141:                                                                                          	#               THE ASTRONAUT WILL CALL THIS DISPLAY TO VERIFY THAT THE
028518,000142:                                                                                          	#               CENTRAL ANGLE OF TRANSFER OF THE ACTIVE VEHICLE IS NOT WITHIN
028520,000144:                                                                                          	#               170 TO 190 DEGREES.  IF THE ANGLE IS WITHIN THIS ZONE THE
028521,000145:                                                                                          	#               ASTRONAUT SHOULD REASSESS THE INPUT TARGETING PARAMETERS BASED
028522,000146:                                                                                          	#               UPON DELTA V AND EXPECTED MANEUVER TIME.
028523,000147: 
028524,000148:                                                                                          	#       (8)     THIS PROGRAM IS SELECTED BY THE ASTRONAUT BY DSKY ENTRY -
028525,000149: 
028526,000150:                                                                                          	#                       P34 IF THIS VEHICLE IS ACTIVE VEHICLE.
028527,000151: 
028528,000152:                                                                                          	#                       P74 IF THIS VEHICLE IS PASSIVE VEHICLE.
028529,000153: 
028530,000154:                                                                                          	# INPUT
028531,000155: 
028532,000156:                                                                                          	#       (1)     TTPI    TIME OF THE TPI MANEUVER
028533,000157:                                                                                          	#       (2)     ELEV    DESIRED LOS ANGLE AT TPI
028534,000158:                                                                                          	#       (3)     CENTANG ORBITAL CENTRAL ANGLE OF THE PASSIVE VEHICLE DURING
028535,000159:                                                                                          	#                       TRANSFER FROM TPI TO TIME OF INTERCEPT
028536,000160: 
028537,000161:                                                                                          	# OUTPUT
028538,000162: 
028539,000163:                                                                                          	#       (1)     TRKMKCNT        NUMBER OF MARKS
028540,000164:                                                                                          	#       (2)     TTOGO           TIME TO GO
028541,000165:                                                                                          	#       (3)     +MGA            MIDDLE GIMBAL ANGLE
028542,000166:                                                                                          	#       (4)     TTPI            COMPUTED TIME OF TPI MANEUVER
028543,000167:                                                                                          	#                OR
028544,000168:                                                                                          	#               ELEV            COMPUTED LOS ANGLE AT TPI
028545,000169:                                                                                          	#       (5)     POSTTPI         PERIGEE ALTITUDE AFTER THE TPI MANEUVER
028546,000170:                                                                                          	#       (6)     DELVTPI         MAGNITUDE OF DELTA V AT TPI
028547,000171:                                                                                          	#       (7)     DELVTPF         MAGNITUDE OF DELTA V AT INTERCEPT
028548,000172:                                                                                          	#       (8)     DVLOS           DELTA VELOCITY AT TPI - LINE OF SIGHT
028549,000173:                                                                                          	#       (9)     DELVLVC         DELTA VELOCITY AT TPI - LOCAL VERTICAL COORDINATES
028550,000174: 
028551,000175:                                                                                          	# DOWNLINK
028552,000176: 
028553,000177:                                                                                          	#       (1)     TTPI            TIME OF THE TPI MANEUVER
028554,000178:                                                                                          	#       (2)     TIG             TIME OF THE TPI MANEUVER
028555,000179:                                                                                          	#       (3)     ELEV            DESIRED LOS ANGLE AT TPI
028556,000180:                                                                                          	#       (4)     CENTANG         ORBITAL CENTRAL ANGLE OF THE PASSIVE VEHICLE DURING
028557,000181:                                                                                          	#                               TRANSFER FROM TPI TO TIME OF INTERCEPT
028558,000182:                                                                                          	#       (5)     DELVEET3        DELTA VELOCITY AT TPI - REFERENCE COORDINATES
028559,000183:                                                                                          	#       (6)     TPASS4          TIME OF INTERCEPT
028560,000184: 
028561,000185:                                                                                          	# COMMUNICATION TO THRUSTING PROGRAMS
028562,000186: 
028563,000187:                                                                                          	#       (1)     TIG             TIME OF THE TPI MANEUVER
028564,000188:                                                                                          	#       (2)     RTARG           OFFSET TARGET POSITION
028565,000189:                                                                                          	#       (3)     TPASS4          TIME OF INTERCEPT
028566,000190:                                                                                          	#       (4)     XDELVFLG        RESET TO INDICATE LAMBERT (AIMPOINT) VG COMPUTATION
028567,000191: 
028568,000192:                                                                                          	# SUBROUTINES USED

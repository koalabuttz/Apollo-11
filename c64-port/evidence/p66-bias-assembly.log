007215,000877: 
007217,000879:                                                                                          	# PROGRAM NAME:  PIPFAIL
007218,000880: 
007219,000881:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM PROCESSES CHANGES OF BIT 13 OF CHANNEL 33, PIPA FAIL.  IT SETS BIT 10 OF
007220,000882:                                                                                          	# IMODES30 TO AGREE.  IT CALLS SETISSW IN CASE A PIPA FAIL NECESSITATES AN ISS WARNING.  IF NOT, I.E., IMODES30
007221,000883:                                                                                          	# BIT 1 = 1, AND A PIPA FAIL IS PRESENT AND THE ISS IS NOT BEING INITIALIZED, PROGRAM ALARM 00212 IS ISSUED.
007222,000884: 
007223,000885:                                                                                          	# CALLING SEQUENCE:  BY C33TEST ON CHANGES OF CHANNEL 33 BIT 13.
007224,000886: 
007225,000887:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
007226,000888: 
007227,000889:                                                                                          	# SUBROUTINES CALLED:  1) SETISSW, AND 2) ALARM (SEE FUNCTIONAL DESCRIPTION).
007228,000890: 
007229,000891:                                                                                          	# ERASABLE INITIALIZATION:  SEE IMUMON FOR INITIALIZATION OF IMODES30.  THE RELAVANT BITS ARE 5, 7, 8, 9, AND 10.
007230,000892: 
007231,000893:                                                                                          	# ALARMS:  PROGRAM ALARM 00212 IF PIPA FAIL IS PRESENT BUT NEITHER ISS WARNING IS TO BE ISSUED NOR THE ISS IS
007232,000894:                                                                                          	# BEING INITIALIZED.
007233,000895: 
007234,000896:                                                                                          	# EXIT:  NXTFL33.
007235,000897: 
007236,000898:                                                                                          	# OUTPUT:  PROGRAM ALARM 00212 AND ISS WARNING MAINTENANCE.
007237,000899: 

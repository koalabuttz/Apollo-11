054251,000036: 
054253,000038:                                                                                          	#          THE TFF SUBROUTINES MAY BE USED IN EITHER EARTH OR MOON CENTERED COORDINATES. THE TFF ROUTINES NEVER
054254,000039:                                                                                          	# KNOW WHICH ORIGIN APPLIES. IT IS THE USER WHO KNOWS, AND WHO SUPPLIES  RONE, VONE, AND 1/SQRT(MU) AT THE
054255,000040:                                                                                          	# APPROPRIATE SCALE LEVEL FOR THE PROPER PRIMARY BODY.
054256,000041: 
054257,000042:                                                                                          	#          EARTH ORIGIN           POSITION      -29       METERS
054258,000043:                                                                                          	#                                 VELOCITY      -7        METERS/CENTISECOND
054259,000044:                                                                                          	#                                 1/SQRT(MU)    +17       SQRT(CS SQ/METERS CUBED)
054260,000045: 
054261,000046:                                                                                          	#          MOON ORIGIN            POSITION      -27       METERS
054262,000047:                                                                                          	#                                 VELOCITY      -5        METERS/CENTISECONDS
054263,000048:                                                                                          	#                                 1/SQRT(MU)    +14       SQRT(CS SQ/METERS CUBED)
054264,000049: 
054265,000050:                                                                                          	# ALL DATA PROVIDED TO AND RECEIVED FROM ANY TFF SUBROUTINE WILL BE AT ONE OF THE LEVELS ABOVE. IN ALL CASES,
054266,000051:                                                                                          	# THE FREE FALL TIME IS RETURNED IN CENTISECONDS AT (-28). PROGRAM  TFF/CONIC  WILL GENERATE VONE/RTMU  AND
054267,000052:                                                                                          	# LEAVE IT IN  VONE' AT (+10) IF EARTH ORIGIN AND (+9) IF MOON ORIGIN.
054268,000053:                                                                                          	#          THE USER MUST STORE THE STATE VECTOR IN  RONE, VONE  AND MU IN THE FORM 1/SQRT(MU) IN TFF/RTMU
054269,000054:                                                                                          	# AT THE PROPER SCALE BEFORE CALLING  TFF/CONIC. SINCE RONE, VONE   ARE IN THE EXTENDED VERB STORAGE AREA,
054270,000055:                                                                                          	# THE USER MUST ALSO LOCK OUT THE EXTENDED VERBS, AND RELEASE THEM WHEN FINISHED.
054271,000056:                                                                                          	#          PROGRAMS     CALC/TFF  AND  CALC/TPER  ASSUME THAT THE TERMINAL RADIUS IS LESS THAN THE PRESENT
054272,000057:                                                                                          	# RADIUS. THIS RESTRICTION CAN BE REMOVED BY A  15 W CODING CHANGE, BUT AT PRESENT IT IS NOT DEEMED NECESSARY.
054273,000058: 
054274,000059:                                                                                          	#          THE FOLLOWING ERASABLE QUANTITIES ARE USED BY THE TFF ROUTINES, AND ARE LOCATED IN THE PUSH LIST.
054275,000060: 
054276,000061: 
054277,000062:                                                                                          	#                                                              BELOW      E:   IS USED FOR EARTH ORIGIN SCALE
054278,000063:                                                                                          	#                                                                         M:   IS USED FOR MOON  ORIGIN SCALE
054279,000064: 
054280,000065:                                                                                          	#TFFSW          =       119D    #                               BIT1      0 = CALCTFF             1 = CALCTPER
054281,000066: 10,2213                        TFFDELQ            =        10D                           	#                                         Q2-Q1                   E: (-16)  M: (-15)
054282,000067: 10,2213                        RMAG1              =        12D                           	#                                         ABVAL(RN)  M            E: (-29)  M: (-27)
054283,000068:                                                                                          	#RPER           =       14D     #                                         PERIGEE RADIUS  M       E: (-29)  M: (-27)
054284,000069: 10,2213                        TFFQ1              =        14D                           	#                                         R.V / SQRT(MUE)         E: (-16)  M: (-15)
054285,000070:                                                                                          	#SDELF/2                        #                                         SIN(THETA) /2
054286,000071: 10,2213                        CDELF/2            =        14D                           	#                                         COS(THETA) /2
054287,000072:                                                                                          	#RAPO           =       16D     #                                         APOGEE RADIUS  M        E: (-29)  M: (-27)
054288,000073: 10,2213                        NRTERM             =        16D                           	#                                         TERMINAL RADIUS  M      E: (-29+NR)
054289,000074:                                                                                          	#                                                                 M: (-27+NR)
054290,000075: 10,2213                        RTERM              =        18D                           	#                                         TERMINAL RADIUS  M      E: (-29)  M: (-27)
054291,000076: 10,2213                        TFFVSQ             =        20D                           	#                                         -(V SQUARED/MU)  1/M    E: (20)   M: (18)
054292,000077: 10,2213                        TFF1/ALF           =        22D                           	#                                         SEMI MAJ AXIS  M        E: (-22-2 NA)
054293,000078:                                                                                          	#                                                                 M: (-20-2 NA)
054294,000079: 10,2213                        TFFRTALF           =        24D                           	#                                         SQRT(ALFA)              E:(10+NA) M: (9+NA)
054295,000080: 10,2213                        TFFALFA            =        26D                           	#                                         ALFA  1/M               E:(26-NR) M: (24-NR)
054296,000081: 10,2213                        TFFNP              =        28D                           	#                                         SEMI LATUS RECTUM  M    E: (-38+2 NR)
054297,000082:                                                                                          	#                                                                 M: (-36+2 NR)
054298,000083: 10,2213                        TFF/RTMU           =        30D                           	#                                         1/SQRT(MU)              E: (17)   M: (14)
054299,000084: 10,2213                        NRMAG              =        32D                           	#                                         PRESENT RADIUS  M       E: (-29+NR)
054300,000085:                                                                                          	#                                                                 M: (-27+NR)
054301,000086: 10,2213                        TFFX               =        34D                           	#
054302,000087: 10,2213                        TFFTEM             =        36D                           	#                                         TEMPORARY
054304,000089:                                                                                          	#                                          REGISTERS S1, S2 ARE UNTOUCED BY ANY TFF SUBROUTINE
054305,000090:                                                                                          	#                                          INDEX REGISTERS X1, X2 ARE USED BY ALL TFF SUBROUTINES. THEY ARE ESTAB-
054306,000091:                                                                                          	#                                          LISHED IN TFF/CONIC AND MUST BE PRESERVED BETWEEN CALLS TO SUBSEQUENT
054307,000092:                                                                                          	#                                          SUBROUTINES.
054308,000093:                                                                                          	#                                          -NR                             C(X1) = NORM COUNT OF RMAG
054309,000094:                                                                                          	#                                          -NA                             C(X2)= NORM COUNT OF SQRT(ABS(ALFA))
054310,000095: 
054312,000097:                                                                                          	# SUBROUTINE NAME:     TFFCONIC                                         DATE:  01.29.67
054313,000098:                                                                                          	# MOD NO:  0                                                            LOG SECTION:  TIME OF FREE FALL
054314,000099:                                                                                          	# MOD BY:  RR BAIRNSFATHER
054315,000100:                                                                                          	# MOD NO:  1           MOD BY:  RR BAIRNSFATHER  DATE:  11 APR 67
054316,000101:                                                                                          	# MOD NO:  2           MOD BY:  RR BAIRNSFATHER  DATE:  21 NOV 67     ADD MOON MU.
054317,000102:                                                                                          	# MOD NO:  3           MOD BY:  RR BAIRNSFATHER  DATE:  21 MAR 68     ACCEPT DIFFERENT EARTH/MOON SCALES
054318,000103:                                                                                          	# FUNCTIONAL DESCRIPTION:      THIS SUBROUTINE IS CALLED TO COMPUTE THOSE CONIC PARAMETERS REQUIRED BY THE TFF
054319,000104:                                                                                          	#          SUBROUTINES AND TO ESTABLISH THEM IN THE PUSH LIST AREA. THE PARAMETERS ARE LISTED UNDER OUTPUT.
054320,000105:                                                                                          	#          THE EQUATIONS ARE:
054321,000106:                                                                                          	#                 _   _  _
054322,000107:                                                                                          	#                 H = RN*VN                                               ANGULAR MOMENTUM
054323,000108:                                                                                          	#                       _ _
054324,000109:                                                                                          	#                 LCP = H.H / MU                                          SEMI LATUS RECTUM
054325,000110:                                                                                          	#                               _  _
054326,000111:                                                                                          	#                 ALFA = 2/RN - VN.VN / MU                                RECIPROCAL SEMI-MAJOR AXIS, SIGNED
054327,000112: 
054328,000113:                                                                                          	#          AND ALFA IS POS FOR ELLIPTIC ORBITS
054329,000114:                                                                                          	#                       0 FOR PARABOLIC ORBITS
054330,000115:                                                                                          	#                      NEG FOR HYPERBOLIC ORBITS.
054331,000116:                                                                                          	#          SUBROUTINE ALSO COMPUTES AND SAVES RMAG.
054332,000117:                                                                                          	# CALLING SEQUENCE:
054333,000118:                                                                                          	#          TFFCONIC  EXPECTS CALLER TO ENTER WITH CORRECT GRAVITATIONAL CONSTANT IN MPAC, IN THE FORM
054334,000119:                                                                                          	#          1/SQRT(MU). PROGRAM WILL SAVE IN TFF/RTMU   . THE SCALE IS DETERMINED BY WHETHER EARTH OR MOON
054335,000120:                                                                                          	#          ORIGIN IS USED.  THE CALLER MUST LOCK OUT THE EXTENDED VERBS BEFORE PROVIDING STATE VECTOR IN RONE,
054336,000121:                                                                                          	#          VONE  AT PROPER SCALE. THE EXTENDED VERBS MUST BE RESTORED WHEN THE CALLER IS FINISHED USING THE
054337,000122:                                                                                          	#          TFF ROUTINES.
054338,000123:                                                                                          	#          ENTRY POINT  TFFCONMU  EXPECTS THAT TFF/RTMU IS ALREADY LOADED.
054339,000124:                                                                                          	#          TO SPECIFY MU:      DLOAD  CALL              IF MU ALREADY STORED:      CALL
054340,000125:                                                                                          	#                                     YOURMU      1/RTMU  E: (17)  M: (14)                TFFCONMU
054341,000126:                                                                                          	#                                     TFFCONIC
054342,000127:                                                                                          	#          PUSHLOC = PDL+0, ARBITRARY IF LEQ 18D
054343,000128: 
054344,000129:                                                                                          	# SUBROUTINES CALLED:  NONE
054345,000130:                                                                                          	# NORMAL EXIT MODES:   RVQ
054346,000131:                                                                                          	# ALARMS:  NONE
054347,000132:                                                                                          	# OUTPUT:  THE FOLLOWING ARE STORED IN THE PUSH LIST AREA.
054348,000133:                                                                                          	#          RMAG1  E:(-29) M:(-27) M  RN, PRESENT RADIUS LENGTH.
054349,000134:                                                                                          	#          NRMAG  E: (-29+NR)     M  RMAG, NORMALIZED
054350,000135:                                                                                          	#                 M: (-27+NR)
054351,000136:                                                                                          	#          X1                     -NR, NORM COUNT
054352,000137:                                                                                          	#          TFFNP  E: (-38+2NR)    M  LCP, SEMI LATUS RECTUM, WEIGHTED BY NR.       FOR VGAMCALC.
054353,000138:                                                                                          	#                 M: (-36+2NR)
054354,000139:                                                                                          	#          TFF/RTMU  E:(17)  M:(14)       1/SQRT(MU)
054355,000140:                                                                                          	#          TFFVSQ E:(20)  M:(18)  1/M   -(V SQ/MU): PRESENT VELOCITY,NORMALIZED.   FOR VGAMCALC
054356,000141:                                                                                          	#          TFFALFA  E: (26-NR)    1/M   ALFA, WEIGHTED BY NR
054357,000142:                                                                                          	#                   M: (24-NR)
054358,000143:                                                                                          	#          TFFRTALF E: (10+NA)    SQRT(ALFA), NORMALIZED
054359,000144:                                                                                          	#                   M: (9+NA)
054361,000146:                                                                                          	#          X2                           -NA, NORMCOUNT
054362,000147:                                                                                          	#          TFF1/ALF  E:(-22-2NA)        SIGNED SEMI MAJ AXIS, WEIGHTED BY NA
054363,000148:                                                                                          	#                    M:(-20-2NA)
054364,000149:                                                                                          	#          PUSHLOC AT PDL+0
054365,000150:                                                                                          	#          THE FOLLOWING  IS STORED IN GENERAL ERASABLE
054366,000151:                                                                                          	#          VONE'  E:(10) M:(9)    V/RT(MU), NORMALIZED VELOCITY
054367,000152:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:

060339,000027:                                                                                          	## actually created.
060340,000028:                                                                                          	##
060341,000029:                                                                                          	## Notations on the hardcopy document read, in part:
060342,000030:                                                                                          	##
060343,000031:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
060344,000032:                                                                                          	##      16:27 JULY 14, 1969 
060345,000033: 
060347,000035: 20,2123                                           BANK     20                            	#
060348,000036: 20,2000                                           SETLOC   DAPS3                         	#
060349,000037: 20,2000                                           BANK                                   	#
060350,000038: 
060351,000039: 20,2123  E6,1635                                  EBANK=   CDUXD                         	#
060352,000040: 20,2123                                           COUNT*   $$/DAPIF                      	#
060353,000041: 
060354,000042:                                                                                          	# MOD 0         DATE    11/15/66        BY GEORGE W. CHERRY
060355,000043:                                                                                          	# MOD 1                  1/23/67        MODIFICATION BY PETER ADLER
060356,000044: 
060357,000045:                                                                                          	# FUNCTIONAL DESCRIPTION
060358,000046:                                                                                          	#       HEREIN ARE A COLLECTION OF SUBROUTINES WHICH ALLOW MISSION CONTROL PROGRAMS TO CONTROL THE MODE
060359,000047:                                                                                          	#       AND INTERFACE WITH THE DAP.
060360,000048: 
060361,000049:                                                                                          	# CALLING SEQUENCES
060362,000050:                                                                                          	#       IN INTERRUPT OR WITH INTERRUPT INHIBITED
060363,000051:                                                                                          	#               TC      IBNKCALL
060364,000052:                                                                                          	#               FCADR   ROUTINE
060365,000053:                                                                                          	#       IN A JOB WITHOUT INTERRUPT INHIBITED
060366,000054:                                                                                          	#               INHINT
060367,000055:                                                                                          	#               TC      IBNKCALL
060368,000056:                                                                                          	#               FCADR   ROUTINE
060369,000057:                                                                                          	#               RELINT
060370,000058: 
060371,000059:                                                                                          	# OUTPUT
060372,000060:                                                                                          	#       SEE INDIVIDUAL ROUTINES BELOW
060373,000061: 
060374,000062:                                                                                          	# DEBRIS
060375,000063:                                                                                          	#       A, L, AND SOMETIMES MDUETEMP                    ODE     NOT IN PULSES MODE
060376,000064: 
060378,000066:                                                                                          	# SUBROUTINE NAMES:
060379,000067:                                                                                          	#       SETMAXDB, SETMINDB, RESTORDB, PFLITEDB
060380,000068:                                                                                          	# MODIFIED:     30 JANUARY 1968 BY P S WEISSMAN TO CREATE RESTORDB.
060381,000069:                                                                                          	# MODIFIED:     1 MARCH 1968 BY P S WEISSMAN TO SAVE EBANK AND CREATE PFLITEDB
060382,000070: 
060383,000071:                                                                                          	# FUNCTIONAL DESCRIPTION:
060384,000072:                                                                                          	#       SETMAXDB - SET DEADBAND TO 5.0 DEGREES
060385,000073:                                                                                          	#       SETMINDB - SET DEADBAND TO 0.3 DEGREE
060386,000074:                                                                                          	#       RESTORDB - SET DEADBAND TO MAX OR MIN ACCORDING TO SETTING OF DBSELECT BIT OF DAPBOOLS
060387,000075:                                                                                          	#       PFLITEDB - SET DEADBAND TO 1.0 DEGREE AND ZERO THE COMMANDED ATTITUDE CHANGE AND COMMANDED RATE
060388,000076: 
060389,000077:                                                                                          	#       ALL ENTRIES SET UP A NOVAC JOB TO DO 1/ACCS SO THAT THE TJETLAW SWITCH CURVES ARE POSITIONED TO
060390,000078:                                                                                          	#       REFLECT THE NEW DEADBAND.  IT SHOULD BE NOTED THAT THE DEADBAND REFERS TO THE ATTITUDE IN THE P-, U-, AND V-AXES.
060391,000079: 
060392,000080:                                                                                          	# SUBROUTINE CALLED:    NOVAC
060393,000081: 
060394,000082:                                                                                          	# CALLING SEQUENCE:     SAME AS ABOVE
060395,000083:                                                                                          	#                       OR      TC RESTORDB +1    FROM ALLCOAST
060396,000084: 
060397,000085:                                                                                          	# DEBRIS:               A, L, Q, RUPTREG1, (ITEMPS IN NOVAC)
060398,000086: 
060399,000087: 20,2123           30111        RESTORDB           CAE      DAPBOOLS                      	# DETERMINE CREW-SELECTED DEADBAND.
060400,000088: 20,2124           74750                           MASK     DBSELECT                      	#
060401,000089: 20,2125           00006                           EXTEND                                 	#
060402,000090: 20,2126           12140                           BZF      SETMINDB                      	#
060403,000091: 
060404,000092: 20,2127           32151        SETMAXDB           CAF      WIDEDB                        	# SET 5 DEGREE DEADBAND.
060405,000093: 20,2130           55346                 +1        TS       DB                            	#
060406,000094: 
060407,000095: 20,2131           00006                           EXTEND                                 	# SET UP JOB TO RE-POSITION SWITCH CURVES.
060408,000096: 20,2132           22070                           QXCH     RUPTREG1                      	#
060409,000097: 20,2133           37715        CALLACCS           CAF      PRIO27                        	#
060410,000098: 20,2134           05072                           TC       NOVAC                         	#
060411,000099: 20,2135  E6,1537                                  EBANK=   AOSQ                          	#
060412,000100: 20,2135           02454 40106                     2CADR    1/ACCJOB                      	#
060413,000101: 
060414,000102: 20,2137           00070                           TC       RUPTREG1                      	# RETURN TO CALLER.
060415,000103: 
060416,000104: 20,2140           32150        SETMINDB           CAF      NARROWDB                      	# SET 0.3 DEGREE DEADBAND.
060417,000105: 20,2141           12130                           TCF      SETMAXDB   +1                 	#
060418,000106: 
060419,000107: 20,2142           00006        PFLITEDB           EXTEND                                 	# THE RETURN FROM CALLACCS IS TO RUPTREG1.
060420,000108: 20,2143           22070                           QXCH     RUPTREG1                      	#
060421,000109: 20,2144           02153                           TC       ZATTEROR                      	# ZERO THE ERRORS AND COMMANDED RATES.
060422,000110: 20,2145           32152                           CAF      POWERDB                       	# SET DB TO 1.0 DEG.
060423,000111: 20,2146           55346                           TS       DB                            	#
060424,000112: 20,2147           12133                           TCF      CALLACCS                      	# SET UP 1/ACCS AND RETURN TO CALLER.
060425,000113: 20,2150           00155        NARROWDB           OCTAL    00155                         	# 0.3 DEGREE SCALED AT 45.
060427,000115: 20,2151           03434        WIDEDB             OCTAL    03434                         	# 5.0 DEGREES SCALED AT 45.
060428,000116: 20,2152           00554        POWERDB            DEC      .02222                        	# 1.0 DEGREE SCALED AT 45.
060429,000117: 
060430,000118: 20,2153           35015        ZATTEROR           CAF      EBANK6                        	#
060431,000119: 20,2154           56003                           XCH      EBANK                         	#
060432,000120: 20,2155           54001                           TS       L                             	# SAVE CALLERS EBANK IN L.
060433,000121: 20,2156           30032                           CAE      CDUX                          	#
060434,000122: 20,2157           55635                           TS       CDUXD                         	#
060435,000123: 20,2160           30033                           CAE      CDUY                          	#
060436,000124: 20,2161           55636                           TS       CDUYD                         	#
060437,000125: 20,2162           30034                           CAE      CDUZ                          	#
060438,000126: 20,2163           55637                           TS       CDUZD                         	#
060439,000127: 20,2164           12170                           TCF      STOPRATE   +3                 	#
060440,000128: 
060441,000129: 20,2165           35015        STOPRATE           CAF      EBANK6                        	#
060442,000130: 20,2166           56003                           XCH      EBANK                         	#
060443,000131: 20,2167           54001                           TS       L                             	# SAVE CALLERS EBANK IN L.
060444,000132: 20,2170           34755                 +3        CAF      ZERO                          	#
060445,000133: 20,2171           55643                           TS       OMEGAPD                       	#
060446,000134: 20,2172           55644                           TS       OMEGAQD                       	#
060447,000135: 20,2173           55645                           TS       OMEGARD                       	#
060448,000136: 20,2174           55640                           TS       DELCDUX                       	#
060449,000137: 20,2175           55641                           TS       DELCDUY                       	#
060450,000138: 20,2176           55642                           TS       DELCDUZ                       	#
060451,000139: 20,2177           55277                           TS       DELPEROR                      	#
060452,000140: 20,2200           55300                           TS       DELQEROR                      	#
060453,000141: 20,2201           55301                           TS       DELREROR                      	#
060454,000142: 20,2202           22003                           LXCH     EBANK                         	# RESTORE CALLERS EBANK.
060455,000143: 20,2203           00002                           TC       Q                             	#
060456,000144: 
060457,000145:                                                                                          	# SUBROUTINE NAME:      ALLCOAST
060458,000146:                                                                                          	# WILL BE CALLED BY FRESH STARTS AND ENGINE OFF ROUTINES.               .
060459,000147: 
060460,000148:                                                                                          	# CALLING SEQUENCE:     (SAME AS ABOVE)
060461,000149: 
060462,000150:                                                                                          	# EXIT:                 RETURN TO Q.
060463,000151: 
060464,000152:                                                                                          	# SUBROUTINES CALLED:   STOPRATE, RESTORDB, NOVAC
060465,000153: 
060466,000154:                                                                                          	# ZERO:                 (FOR ALL AXES) AOS, ALPHA, AOSTERM, OMEGAD, DELCDU, DELEROR
060467,000155: 
060468,000156:                                                                                          	# OUTPUT:               DRIFTBIT/DAPBOOLS, DB, JOB TO DO 1/ACCS
060469,000157: 
060470,000158:                                                                                          	# DEBRIS:               A, L, Q, RUPTREG1, RUPTREG2, (ITEMPS IN NOVAC)
060471,000159: 
060472,000160: 20,2204           00006        ALLCOAST           EXTEND                                 	# SAVE Q FOR RETURN
060473,000161: 20,2205           22071                           QXCH     RUPTREG2                      	#
060475,000163: 20,2206           02165                           TC       STOPRATE                      	# CLEAR RATE INTERFACE.  RETURN WITH A=0
060476,000164: 20,2207           22003                           LXCH     EBANK                         	# AND L=EBANK6.  SAVE CALLERS EBANK.
060477,000165: 20,2210           55537                           TS       AOSQ                          	#
060478,000166: 20,2211           55540                           TS       AOSQ       +1                 	#
060479,000167: 20,2212           55541                           TS       AOSR                          	#
060480,000168: 20,2213           55542                           TS       AOSR       +1                 	#
060481,000169: 20,2214           55424                           TS       ALPHAQ                        	# FOR DOWNLIST.
060482,000170: 20,2215           55425                           TS       ALPHAR                        	#
060483,000171: 20,2216           55545                           TS       AOSQTERM                      	#
060484,000172: 20,2217           55546                           TS       AOSRTERM                      	#
060485,000173: 20,2220           22003                           LXCH     EBANK                         	# RESTORE EBANK (EBANK6 NO LONGER NEEDED)
060486,000174: 
060487,000175: 20,2221           40111                           CS       DAPBOOLS                      	# SET UP DRIFTBIT
060488,000176: 20,2222           74744                           MASK     DRIFTBIT                      	#
060489,000177: 20,2223           26111                           ADS      DAPBOOLS                      	#
060490,000178: 20,2224           02124                           TC       RESTORDB   +1                 	# RESTORE DEADBANK TO CREW-SELECTED VALUE.
060491,000179: 
060492,000180: 20,2225           00071                           TC       RUPTREG2                      	# RETURN.
060493,000181: 
(End of include-file DAP_INTERFACE_SUBROUTINES.agc, resuming MAIN.agc)

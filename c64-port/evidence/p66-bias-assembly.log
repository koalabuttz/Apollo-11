051929,000572: 
051930,000573:                                                                                          	# INTEGRV IS AN ENTRY TO ORBIT INTEGRATION WHICH PERMITS THE CALLER,
051931,000574:                                                                                          	# NORMALLY THE NAVIGATION PROGRAM, TO SET THE INTEG. FLAGS.  THE ROUTINE
051932,000575:                                                                                          	# IS ENTERED AT INTEGRV1 BY CSMPREC ET. AL. AND AT ALOADED BY INTEGRVS.
051933,000576:                                                                                          	# THE ROUTINE SETS UP A-MEMORY IF ENTERED AT INTEGRV,1 AND SETS THE INTEG.
051934,000577:                                                                                          	# PROGRAM FOR PRECISION OR CONIC
051935,000578: 
051936,000579:                                                                                          	# THE CALLER MUST FIRST CALL INTSTALL TO CHECK IF INTEG. IS IN USE BEFORE
051937,000580:                                                                                          	# SETTING ANY FLAGS.
051938,000581: 
051939,000582:                                                                                          	# THE FLAGS WHICH SHOULD BE SET OR CLEARED ARE
051940,000583:                                                                                          	#       VINTFLAG        (IGNORED WHEN ENTERED FROM INTEGRVS)
051941,000584:                                                                                          	#       INTYPFLG
051942,000585:                                                                                          	#       DIM0FLAG
051943,000586:                                                                                          	#       D6OR9FLG
051944,000587: 
051945,000588:                                                                                          	# CALLING SEQUENCE
051946,000589:                                                                                          	#       L-X     CALL
051947,000590:                                                                                          	#       L-Y             INTSTALL
051948,000591:                                                                                          	#       L-1     SET OR CLEAR ALL FOUR FLAGS.  ALSO CAN SET STATEFLG IF DESIRED
051949,000592:                                                                                          	#               AND DIM0FLAG IS CLEAR.
051950,000593:                                                                                          	#       L       CALL
051951,000594:                                                                                          	#       L+1             INTEGRV
051952,000595: 
051953,000596:                                                                                          	# INITIALIZATION
051954,000597:                                                                                          	#       FLAGS AS ABOVE
051955,000598:                                                                                          	#       STORE TIME TO INTEGRATE TO IN TDEC1

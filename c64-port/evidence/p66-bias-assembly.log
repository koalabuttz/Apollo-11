051831,000474: 
051832,000475:                                                                                          	# SPECIAL PURPOSE ENTRIES TO ORBITAL INTEGRATION.  THESE ROUTINES PROVIDE ENTRANCES TO INTEGRATION WITH
051833,000476:                                                                                          	# APPROPRIATE SWITCHES SET OR CLEARED FOR THE DESIRED INTEGRATION.
051834,000477: 
051835,000478:                                                                                          	# CSMPREC AND LEMPREC PERFORM ORBIT INTEGRATION BY THE ENCKE METHOD TO THE TIME INDICATED IN TDEC1
051836,000479:                                                                                          	# ACCELERATIONS DUE TO OBLATENESS ARE INCLUDED.  NO W-MATRIX INT. IS DONE.
051837,000480:                                                                                          	# THE PERMANENT STATE VECTOR IS NOT UPDATED.
051838,000481: 
051839,000482:                                                                                          	# CSMCONIC AND LEMCONIC PERFORM ORBIT INTEG. BY KEPLERS METHOD TO THE TIME INDICATED IN TDEC1
051840,000483:                                                                                          	# NO DISTURBING ACCELERATIONS ARE INCLUDED.  IN THE PROGRAM FLOW THE GIVEN
051841,000484:                                                                                          	# STATE VECTOR IS RECTIFIED BEFORE SOLUTION OF KEPLERS EQUATION
051842,000485: 
051843,000486:                                                                                          	# THE ROUTINES ASSUME THAT THE CSM (LEM) STATE VECTOR IN P-MEM IS VALID.
051844,000487:                                                                                          	# SWITCHES SET PRIOR TO ENTRY TO THE MAIN INTEG. PROG ARE AS FOLLOWS
051845,000488:                                                                                          	#                       CSMPREC         CSMCONIC        LEMPREC         LEMCONIC
051846,000489:                                                                                          	#       VINTFLAG        SET             SET             CLEAR           CLEAR
051847,000490:                                                                                          	#       INTYPFLG        CLEAR           SET             CLEAR           SET
051848,000491:                                                                                          	#       DIM0FLAG        CLEAR           CLEAR           CLEAR           CLEAR
051849,000492: 

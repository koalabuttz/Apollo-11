048565,000299: 13,2570           00742                                    ERADFLAG                      	#
048566,000300: 13,2571           26573                                    SETRXX                        	#
048567,000301: 13,2572           26466                                    GETERAD                       	#
048568,000302: 13,2573           37673        SETRXX             STCALL   ERADM                         	# EXIT WITH RE OR RM METERS B-29
048569,000303: 13,2574           00051                                    SETREX                        	#
048570,000304: 13,2575           77214        TSTRLSRM           BON      VLOAD                         	# ERADFLAG=0, SET R0=RLS
048571,000305: 13,2576           00702                                    ERADFLAG                      	#         =1      R0=RM
048572,000306: 13,2577           26573                                    SETRXX                        	#
048573,000307: 13,2600           02023                                    RLS                           	#
048574,000308: 13,2601           64446                           ABVAL    SR2R                          	# SCALE FROM B-27 TO B-29
048575,000309: 13,2602           77650                           GOTO                                   	#
048576,000310: 13,2603           26573                                    SETRXX                        	#
048577,000311: 13,2604  0000051               SETREX             =        S2                            	#

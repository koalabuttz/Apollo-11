023024,001828:                                                                                          	# PROGRAM NAME_  REMODE                                                         IVES SHAFT TO -45, AND FINALLY DRIVES
023025,001829: 
023026,001830:                                                                                          	# FUNCTIONAL DESCRIPTION_                                                       S DONE WITH SINGLE AXIS ROTATIONS (SEE
023027,001831:                                                                                          	#       REMODE IS THE GENERAL REMODING SUBROUTINE.  IT DRIVES THE
023028,001832:                                                                                          	#       TRUNNION ANGLE TO 0 DEGREES IF THE CURRENT MODE IS MODE 1,
023029,001833:                                                                                          	#       180 DEGREES FOR MODE 2, THEN DRIVES THE SHAFT ANGLE TO -45
023030,001834:                                                                                          	#       DEGREES, AND FINALLY DRIVES THE TRUNNION ANGLE TO -130 DEGREES,
023031,001835:                                                                                          	#       TO PLACE THE RR IN MODE 2, -50 DEGREES FOR MODE 1, BEFORE
023032,001836:                                                                                          	#       INITIATING 2-AXIS CONTROL.  ALL REMODING IS DONE WITH SINGLE
023033,001837:                                                                                          	#       AXIS ROTATIONS (RR1AXIS).  INITIALLY THE RR ANTENNA MODE FLAG
023034,001838:                                                                                          	#       (RADMODES BIT 12) IS CHECKED.  CONTROL IS THEN TRANSFERRED TO
023035,001839:                                                                                          	#       RRTONLY TO DRIVE THR TRUNNION ANGLE TO 0 DEGREES IF IN MODE 1
023036,001840:                                                                                          	#       OR 180 DEGREES IF IN MODE 2.  RRSONLY IS THEN CALLED TO DRIVE
023037,001841:                                                                                          	#       THE SHAFT ANGLE TO -45 DEGREES. THE RR ANTENNA MODE FLAG
023038,001842:                                                                                          	#       (RADMODES BIT 12) IS CHECKED AGAIN.  CONTROL IS AGAIN
023039,001843:                                                                                          	#       TRANSFERRED TO RRTONLY TO DRIVE THE TRUNNION ANGLE TO -130
023040,001844:                                                                                          	#       DEGREES TO PLACE THE RR IN MODE 2 IF CURRENTLY IN MODE 1 OR TO
023041,001845:                                                                                          	#       -50 DEGREES IF IN MODE 2 TO PLACE THE RR IN MODE 1.  RMODINV
023042,001846:                                                                                          	#       IS THEN CALLED TO SET RADMODES BIT 12 TO INDICATE THE NEW
023043,001847:                                                                                          	#       RR ANTENNA MODE.  THE REMODE FLAG (RADMODES BIT 14)
023044,001848:                                                                                          	#       IS REMOVED TO INDICATE THAT REMODING IS COMPLETE.  THE PROGRAM
023045,001849:                                                                                          	#       THEN EXITS TO STDESIG TO BEGIN 2-AXIS CONTROL.
023046,001850: 

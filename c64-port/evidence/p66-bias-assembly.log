022931,001735:                                                                                          	# PROGRAM NAME_  DORREPOS
022932,001736: 
022933,001737:                                                                                          	# FUNCTIONAL DESCRIPTION_
022934,001738: 
022935,001739:                                                                                          	#       DORREPOS IS A SEQUENCE OF TASKS TO DRIVE THE RENDEZVOUS RADAR
022936,001740:                                                                                          	#       TO A SAFE POSITION.  INITIALLY SETRRECR IS CALLED WHERE THE RR
022937,001741:                                                                                          	#       ERROR COUNTERS (CHAN 12 BIT 2) ARE ENABLED AND LASTYCMD
022938,001742:                                                                                          	#       AND LASTXCMD SET = 0 TO INDICATE THE DIFFERENCE BETWEEN THE
022939,001743:                                                                                          	#       DESIRED STATE AND PRESENT STATE OF THE COMMANDS.  THE RR
022940,001744:                                                                                          	#       TURN-ON FLAG (RADMODES BIT 1) IS CHECKED AND IF NOT PRESENT,
022941,001745:                                                                                          	#       PROGRAM ALARM 00501 IS REQUESTED BEFORE CONTINUING.  IN EITHER
022942,001746:                                                                                          	#       CASE, FOLLOWING A 20 MILLISECOND WAIT THE PROGRAM CHECKS THE CURRENT
022943,001747:                                                                                          	#       RR ANTENNA MODE (RADMODES BIT 12).  RRTONLY IS THEN CALLED
022944,001748:                                                                                          	#       TO DRIVE THE TRUNNION ANGLE TO 0 DEGREES IF IN MODE 1 AND TO 180
022945,001749:                                                                                          	#       DEGREES IF IN MODE 2.  UPON RETURN, THE CURRENT RR ANTENNA
022946,001750:                                                                                          	#       MODE (RADMODES BIT 12) IS AGAIN CHECKED.  RRSONLY IS THEN
022947,001751:                                                                                          	#       CALLED TO DRIVE THE SHAFT ANGLE TO 0 DEGREES IF IN MODE 1 AND TO
022948,001752:                                                                                          	#       -90 DEGREES IF IN MODE 2.  IF DURING RRTONLY OR RRSONLY A
022949,001753:                                                                                          	#       REMODE HAS BEEN REQUESTED (RADMODES BIT 14), AND ALWAYS
022950,001754:                                                                                          	#       FOLLOWING COMPLETION OF RRSONLY, CONTROL IS TRANSFERRED TO
022951,001755:                                                                                          	#       REPOSRPT.  HERE THE REPOSITION FLAG (RADMODES BIT 11) IS 
022952,001756:                                                                                          	#       REMOVED.  A CHECK IS THEN MADE ON THE DESIGNATE FLAG (RADMODES
022953,001757:                                                                                          	#       BIT 10).  IF PRESENT, CONTROL IS TRANSFERRED TO BEGDES.  IF NOT PRESENT
022954,001758:                                                                                          	#       INDICATING NO FURTHER ANTENNA CONTROL REQUIRED, THE RR ERROR
022955,001759:                                                                                          	#       COUNTER BIT (CHAN 12 BIT 2) IS REMOVED AND THE ROUTINE EXITS TO
022956,001760:                                                                                          	#       TASKOVER.
022957,001761: 

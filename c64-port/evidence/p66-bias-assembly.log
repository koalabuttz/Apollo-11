006585,000247: 
006587,000249:                                                                                          	# PROGRAM NAME:  IMUMON
006588,000250: 
006589,000251:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM IS ENTERED EVERY 480 MS.  IT DETECTS CHANGES OF THE IMU STATUS BITS IN
006590,000252:                                                                                          	# CHANNEL 30 AND CALLS THE APPROPRIATE SUBROUTINES.  THE BITS PROCESSED AND THEIR RELEVANT SUBROUTINES ARE:
006591,000253: 
006592,000254:                                                                                          	#       FUNCTION                BIT     SUBROUTINE CALLED
006593,000255:                                                                                          	#       --------                ---     -----------------
006594,000256:                                                                                          	#       TEMP IN LIMITS           15     TLIM
006595,000257:                                                                                          	#       ISS TURN-ON REQUEST      14     ITURNON
006596,000258:                                                                                          	#       IMU FAIL                 13     IMUFAIL (SETISSW)
006597,000259:                                                                                          	#       IMU CDU FAIL             12     ICDUFAIL (SETISSW)
006598,000260:                                                                                          	#       IMU CAGE                 11     IMUCAGE
006599,000261:                                                                                          	#       IMU OPERATE               9     IMUOP
006600,000262: 
006601,000263:                                                                                          	# THE LAST SAMPLED STATE OF THESE BITS IS LEFT IN IMODES30.  ALSO, EACH SUBROUTINE CALLED FINDS THE NEW
006602,000264:                                                                                          	# VALUE OF THE BIT IN A, WITH Q SET TO THE PROPER RETURN LOCATION, NXTIFAIL.
006603,000265: 
006604,000266:                                                                                          	# CALLING SEQUENCE:  T4RUPT EVERY 480 MILLISECONDS.
006605,000267: 
006606,000268:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
006607,000269: 
006608,000270:                                                                                          	# SUBROUTINES CALLED:  TLIM, ITURNON, SETISSW, IMUCAGE, IMUOP.
006609,000271: 
006610,000272:                                                                                          	# ERASABLE INITIALIZATION:
006611,000273:                                                                                          	#       FRESH START OR RESTART WITH NO GROUPS ACTIVE:  C(IMODES30) = OCT 37411.
006612,000274:                                                                                          	#       RESTART WITH ACTIVE GROUPS:     C(IMODES30) = (B(IMODES30)AND(OCT 00035)) PLUS OCT 37400.
006613,000275:                                                                                          	#                                       THIS LEAVES IMU FAIL BITS INTACT.
006614,000276: 
006615,000277:                                                                                          	# ALARMS:  NONE.
006616,000278: 
006617,000279:                                                                                          	# EXIT:  TNONTEST.
006618,000280: 
006619,000281:                                                                                          	# OUTPUT:  UPDATED IMODES30 WITH CHANGES PROCESSED BY APPROPRIATE SUBROUTINE.
006620,000282: 
006621,000283: 06,2172           31302        IMUMON             CA       IMODES30                      	# SEE IF THERE HAS BEEN A CHANGE IN THE
006622,000284: 06,2173           00006                           EXTEND                                 	# RELEVANT BITS OF CHAN 30.
006623,000285: 06,2174           06030                           RXOR     CHAN30                        	#
006624,000286: 06,2175           72761                           MASK     30RDMSK                       	#
006625,000287: 06,2176           00006                           EXTEND                                 	#
006626,000288: 06,2177           12227                           BZF      TNONTEST                      	# NO CHANGE IN STATUS.
006627,000289: 
006628,000290: 06,2200           54070                           TS       RUPTREG1                      	# SAVE BITS WHICH HAVE CHANGED.
006629,000291: 06,2201           23302                           LXCH     IMODES30                      	# UPDATE IMODES30.
006630,000292: 06,2202           00006                           EXTEND                                 	#
006631,000293: 06,2203           06001                           RXOR     LCHAN                         	#
006632,000294: 06,2204           55302                           TS       IMODES30                      	#
006633,000295: 
006634,000296: 06,2205           44753                           CS       ONE                           	#
006635,000297: 06,2206           56070                           XCH      RUPTREG1                      	#
006636,000298: 06,2207           00006                           EXTEND                                 	#
006638,000300: 06,2210           62514                           BZMF     TLIM                          	# CHANGE IN IMU TEMP.

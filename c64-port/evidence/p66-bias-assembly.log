046590,002893: 
046591,002894:                                                                                          	# Page 1089
046592,002895:                                                                                          	# SUBROUTINE TO CONVERT AN ERASABLE ADDRESS (11 BITS) TO AN EBANK SETTING AND SUBADDRESS.
046593,002896: 
046594,002897: 01,2427           40117        15ADRERS           CS       POLISH                        	#
046595,002898: 01,2430           64772                           AD       DEC45                         	#
046596,002899: 01,2431           10000                           CCS      A                             	# DOES THE ADDRESS POINT TO THE WORK AREA?
046597,002900: 01,2432           30120                           CA       FIXLOC                        	# YES.  ADD FIXLOC.  EBANK OK AS IS.
046598,002901: 01,2433           12440                           TCF      +5                            	#
046599,002902: 
046600,002903: 01,2434           35007                           CA       OCT1400                       	# NO. SET EBANK & MAKE UP SUBADDRESS.
046601,002904: 01,2435           56117                           XCH      POLISH                        	#
046602,002905: 01,2436           54003                           TS       EBANK                         	#
046603,002906: 01,2437           74357                           MASK     LOW8                          	#
046604,002907: 01,2440           26117                 +5        ADS      POLISH                        	# FALL INTO TAGSUB, AND RETURN VIA Q.
046605,002908: 
046606,002909:                                                                                          	# SUBROUTINE WHICH SETS THE ADDRESS OF THE SPECIFIED INDEX IN INDEXLOC.  (ACTUALLY, THE ADDRESS -38D.)
046607,002910: 
046608,002911: 01,2441           30120        TAGSUB             CA       FIXLOC                        	#
046609,002912: 01,2442           54130                           TS       INDEXLOC                      	#
046610,002913: 
046611,002914: 01,2443           10020                           CCS      CYR                           	# BIT 15 SPECIFIES INDEX.
046612,002915: 01,2444           24130                           INCR     INDEXLOC                      	# 0 MEANS USE X2.
046613,002916: 01,2445           00002                           TC       Q                             	#
046614,002917: 01,2446           00002                           TC       Q                             	# 1 FOR X1.
046615,002918: 
046616,002919:                                                                                          	# Page 1090
046617,002920:                                                                                          	# MISCELLANEOUS OPERATION CODES WITH DIRECT ADDRESSES.  INCLUDED HERE ARE:
046618,002921:                                                                                          	#       1.      ITA     STORE CPRET (RETURN ADDRESS) IN ERASABLE.
046619,002922:                                                                                          	#       2.      CALL    CALL A SUBROUTINE, LEAVING RETURN IN QPRET.
046620,002923:                                                                                          	#       3.      RTB     RETURN TO BASIC LANGUAGE AT THE GIVEN ADDRESS.
046621,002924:                                                                                          	#       4.      BHIZ    BRANCH IF THE HIGH ORDER OF MPAC IS ZERO (SINGLE PRECISION).
046622,002925:                                                                                          	#       5.      BOV     BRANCH ON OVERFLOW.
046623,002926:                                                                                          	#       6.      GOTO    SIMPLE SEQUENCE CHANGE.
046624,002927: 
046625,002928: 01,2447           10020        RTB/BHIZ           CCS      CYR                           	#
046626,002929: 01,2450           30117        RTB                CA       POLISH                        	#
046627,002930: 01,2451           04621                           TC       SWCALL     -1                 	# SO A "TC Q" FROM ROUTINE LEADS TO DANZIG
046628,002931: 
046629,002932: 01,2452           10154        BHIZ               CCS      MPAC                          	#
046630,002933: 01,2453           16061                           TCF      DANZIG                        	#
046631,002934: 01,2454           16646                           TCF      GOTO                          	#
046632,002935: 01,2455           16061                           TCF      DANZIG                        	#
046633,002936: 01,2456           16646                           TCF      GOTO                          	#
046634,002937: 
046635,002938: 01,2457           10121        BOV(B)             CCS      OVFIND                        	# BRANCH ON OVERFLOW TO BASIC OR INTERP.
046636,002939: 01,2460           12462                           TCF      +2                            	#
046637,002940: 01,2461           16061                           TCF      DANZIG                        	#
046638,002941: 01,2462           54121                           TS       OVFIND                        	#
046639,002942: 01,2463           10020                           CCS      CYR                           	#
046640,002943: 01,2464           12450                           TCF      RTB                           	# IF BASIC.
046641,002944: 01,2465           00360        B5TOBB             OCT      360                           	#
046642,002945: 01,2466           16646                           TCF      GOTO                          	#
046643,002946: 
046644,002947:                                                                                          	# Page 1091
046645,002948: 01,2467           10020        BZE/GOTO           CCS      CYR                           	# SEE WHICH OP-CODE IS DESIRED.
046646,002949: 01,2470           06723                           TC       BRANCH                        	# DO BZE.
046647,002950: 01,2471           16061                           TCF      DANZIG                        	#
046648,002951: 01,2472           16646                           TCF      GOTO                          	# DO GOTO.
046649,002952: 01,2473           16061                           TCF      DANZIG                        	#
046650,002953: 
046651,002954: 01,2474           10020        BPL/BMN            CCS      CYR                           	#
046652,002955: 01,2475           12503                           TCF      BPL                           	#
046653,002956: 01,2476           12000        5B10               DEC      5          B+10               	# SHIFTS OP CODE IN SWITCH INSTRUCTION ADR
046654,002957: 
046655,002958: 01,2477           06723                           TC       BRANCH                        	# DO BMN
046656,002959: 01,2500           16061                           TCF      DANZIG                        	#
046657,002960: 01,2501           16061                           TCF      DANZIG                        	#
046658,002961: 01,2502           16646                           TCF      GOTO                          	# ONLY IF NNZ.
046659,002962: 
046660,002963: 01,2503           06723        BPL                TC       BRANCH                        	#
046661,002964: 01,2504           16646                           TCF      GOTO                          	# IF POSITIVE OR ZERO.
046662,002965: 01,2505           16646                           TCF      GOTO                          	#
046663,002966: 01,2506           16061                           TCF      DANZIG                        	#
046664,002967: 
046665,002968: 01,2507           10020        CALL/ITA           CCS      CYR                           	#
046666,002969: 01,2510           16640                           TCF      CALL                          	#
046667,002970: 
046668,002971: 01,2511           05705                           TC       CCSHOLE                       	#
046669,002972: 01,2512           02427                           TC       15ADRERS                      	# STORE QPRET.  (TAGSUB AFTER 15ADRERS IS
046670,002973: 01,2513           50120                           INDEX    FIXLOC                        	# SLOW IN THIS CASE, BUT SAVES STORAGE.)
046671,002974: 01,2514           30052                           CA       QPRET                         	#
046672,002975: 01,2515           12367                           TCF      MSTORE1                       	#
046673,002976: 
046674,002977:                                                                                          	# Page 1092
046675,002978:                                                                                          	# THE FOLLOWING OPERATIONS ARE AVAILABLE FOR ALTERING AND TESTING INTERPRETATIVE SWITCHES:
046676,002979: 
046677,002980:                                                                                          	#       00      BONSET          SET A SWITCH AND DO A GOTO IF IT WAS ON.
046678,002981:                                                                                          	#       01      SETGO           SET A SWITCH AND DO A GOTO.
046679,002982:                                                                                          	#       02      BOFSET          SET A SWITCH AND DOA GOTO IF IT WAS OFF
046680,002983:                                                                                          	#       03      SET             SET A SWITCH.
046681,002984: 
046682,002985:                                                                                          	#       04      BONINV          INVERT A SWITCH AND BRANCH IF IT WAS ON.
046683,002986:                                                                                          	#       05      INVGO           INVERT A SWITCH AND DO A GOTO.
046684,002987:                                                                                          	#       06      BOFINV          INVERT A SWITCH AND BRANCH IF IT WAS OFF
046685,002988:                                                                                          	#       07      INVERT          INVERT A SWITCH.
046686,002989: 
046687,002990:                                                                                          	#       10      BONCLR          CLEAR A SWITCH AND BRANCH IF IT WAS ON.
046688,002991:                                                                                          	#       11      CLRGO           CLEAR A SWITCH AND DO A GOTO.
046689,002992:                                                                                          	#       12      BOFCLR          CLEAR A SWITCH AND BRANCH IF IT WAS OFF.
046690,002993:                                                                                          	#       13      CLEAR           CLEAR A SWITCH.
046691,002994: 
046692,002995:                                                                                          	#       14      BON             BRANCH IF A SWITCH WAS ON.
046693,002996:                                                                                          	#       16      BOFF            BRANCH IF A SWITCH WAS OFF.
046694,002997: 
046695,002998:                                                                                          	# THE ADDRESS SUPPLIED WITH THE SWITCH INSTRUCTION IS INTERPRETED AS FOLLOWS:
046696,002999: 
046697,003000:                                                                                          	#       BITS 1-4        SWITCH BIT NUMBER (1-15).
046698,003001:                                                                                          	#       BITS 5-8        SWITCH OPERATION NUMBER
046699,003002:                                                                                          	#       BITS 9-         SWITCH WORD NUMBER (UP TO 64 SWITCH WORDS).
046700,003003: 
046701,003004:                                                                                          	# THE ADDRESS ITSELF IS MADE UP BY THE YUL SYSTEM ASSEMBLER.  THE BRANCH INSTRUCTIONS REQUIRE TWO
046702,003005:                                                                                          	# ADDRESSES, THE SECOND TAKEN AS THE DIRECT (OR INDIRECT IF IN ERASABLE) ADDRESS OF THE BRANCH.
046703,003006: 
046704,003007: 01,2516           34762        SWITCHES           CAF      LOW4                          	# LEAVE THE SWITCH BIT IN SWBIT.
046705,003008: 01,2517           70117                           MASK     POLISH                        	#
046706,003009: 01,2520           50000                           INDEX    A                             	#
046707,003010: 01,2521           34735                           CAF      BIT15                         	# (NUMBER FROM LEFT TO RIGHT.)
046708,003011: 01,2522           54131                           TS       SWBIT                         	#
046709,003012: 
046710,003013: 01,2523           34745                           CAF      BIT7                          	# LEAVE THE SWITCH NUMBER IN SWWORD.
046711,003014: 01,2524           00006                           EXTEND                                 	#
046712,003015: 01,2525           70117                           MP       POLISH                        	#
046713,003016: 01,2526           54130                           TS       SWWORD                        	#
046714,003017: 
046715,003018: 01,2527           00004                           INHINT                                 	# DURING SWITCH CHANGE SO RUPT CAN USE TOO
046716,003019: 01,2530           50000                           INDEX    A                             	# LEAVE THE SWITCH WORD ITSELF IN L.
046717,003020: 01,2531           30074                           CA       STATE                         	#
046718,003021: 01,2532           54002                           TS       Q                             	# Q WILL BE USED AS A CHANNEL.
046719,003022:                                                                                          	# Page 1093
046720,003023: 01,2533           34741                           CAF      BIT11                         	#
046721,003024: 01,2534           00006                           EXTEND                                 	# DISPATCH SWITCH BIT OPERATION AS IN BITS
046722,003025: 01,2535           70117                           MP       POLISH                        	# 7-8 OF POLISH.
046723,003026: 01,2536           72576                           MASK     B3TOB4                        	# GETS 4X2-BIT CODE.
046724,003027: 01,2537           50000                           INDEX    A                             	#
046725,003028: 01,2540           12541                           TCF      +1                            	#
046726,003029: 
046727,003030: 01,2541           30131                 +1        CA       SWBIT                         	# 00 -- SET SWITCH IN QUESTION.
046728,003031: 01,2542           00006                           EXTEND                                 	#
046729,003032: 01,2543           04002                           ROR      QCHAN                         	#
046730,003033: 01,2544           12553                           TCF      SWSTORE                       	#
046731,003034: 
046732,003035: 01,2545           30131                 +5        CA       SWBIT                         	# 01 -- INVERT SWITCH.
046733,003036: 01,2546           00006                           EXTEND                                 	#
046734,003037: 01,2547           06002                           RXOR     QCHAN                         	#
046735,003038: 01,2550           12553                           TCF      SWSTORE                       	#
046736,003039: 
046737,003040: 01,2551           40131                 +9D       CS       SWBIT                         	# 10 -- CLEAR.
046738,003041: 01,2552           70002                           MASK     Q                             	#
046739,003042: 01,2553           50130        SWSTORE            INDEX    SWWORD                        	#
046740,003043: 01,2554           54074                           TS       STATE                         	# NEW SWITCH WORD.
046741,003044: 
046742,003045:                                                                                          	# Page 1094
046743,003046: 01,2555           00003                 +13D      RELINT                                 	# 11 -- NOOP.
046744,003047: 01,2556           34737                           CAF      BIT13                         	#
046745,003048: 01,2557           00006                           EXTEND                                 	# DISPATCH SEQUENCE CHANGING OR BRANCING
046746,003049: 01,2560           70117                           MP       POLISH                        	# CODE.
046747,003050: 01,2561           72576                           MASK     B3TOB4                        	#
046748,003051: 01,2562           50000                           INDEX    A                             	#
046749,003052: 01,2563           12564                           TCF      +1                            	# ORIGINALLY STORED IN BITS 5-6
046750,003053: 
046751,003054: 01,2564           40002                 +1        CS       Q                             	# 00 -- BRANCH IF ON.
046752,003055: 01,2565           70131        TEST               MASK     SWBIT                         	#
046753,003056: 01,2566           10000                           CCS      A                             	#
046754,003057: 01,2567           12577                           TCF      SWSKIP                        	#
046755,003058: 
046756,003059: 01,2570           16715                 +5        TCF      SWBRANCH                      	# 01 -- GO TO.
046757,003060: 
046758,003061: 01,2571           12577                           TCF      SWSKIP                        	# HERE ONLY ON BIT 15.
046759,003062: 
046760,003063: 01,2572           05705                           TC       CCSHOLE                       	#
046761,003064: 01,2573           05705                           TC       CCSHOLE                       	#
046762,003065: 
046763,003066: 01,2574           30002                 +9D       CA       Q                             	# 10 -- BRANCH IF OFF.
046764,003067: 01,2575           12565                           TCF      TEST                          	#
046765,003068: 
046766,003069: 01,2576           00014        B3TOB4             OCT      0014                          	#
046767,003070: 01,2577           24164        SWSKIP             INCR     LOC                           	#
046768,003071: 
046769,003072: 01,2600  01,2516               SW/                EQUALS   SWITCHES                      	#
046770,003073: 
046771,003074: 01,2600           16061                 +13D      TCF      DANZIG                        	# 11 -- NOOP.
046772,003075: 
(End of include-file INTERPRETER.agc, resuming MAIN.agc)

040820,000325: 
040821,000326:                                                                                          	# FUNCTION - COMPUTE INPUTS FOR PICAPAR AND PLANET
040822,000327: 
040823,000328:                                                                                          	#       DEFINE
040824,000329: 
040825,000330:                                                                                          	#       U   = UNIT( SUN WRT EARTH )
040826,000331:                                                                                          	#        ES
040827,000332: 
040828,000333:                                                                                          	#       U   = UNIT( MOON WRT EARTH )
040829,000334:                                                                                          	#        EM
040830,000335: 
040831,000336:                                                                                          	#       R   = POSITION VECTOR OF LEM
040832,000337:                                                                                          	#        L
040833,000338: 
040834,000339:                                                                                          	#       R   = MEAN DISTANCE (384402KM) BETWEEN EARTH AND MOON
040835,000340:                                                                                          	#        EM
040836,000341: 
040837,000342:                                                                                          	#       P   = RATIO R  /(DISTANCE SUN TO EARTH) > .00257125
040838,000343:                                                                                          	#                    EM
040839,000344: 
040840,000345:                                                                                          	#       R   = EQUATORIAL RADIUSS (6378.166KM) OF EARTH
040841,000346:                                                                                          	#        E
040842,000347: 
040843,000348:                                                                                          	#       LOCSAM COMPUTES IN EARTH INFLUENCE
040844,000349: 
040845,000350:                                                                                          	#       VSUN = U
040846,000351:                                                                                          	#               ES
040847,000352: 
040848,000353:                                                                                          	#       VEARTH = -UNIT( R  )
040849,000354:                                                                                          	#                        L
040850,000355: 
040851,000356:                                                                                          	#       VMOON = UNIT(R  .U   - R  )
040852,000357:                                                                                          	#                     EM  EM    L
040853,000358: 
040854,000359:                                                                                          	#       CSUN = COS 90
040855,000360: 
040856,000361:                                                                                          	#       CEARTH = COS(5 + ARCSIN(R /MAG(R )))
040857,000362:                                                                                          	#                                E      L
040858,000363: 
040859,000364:                                                                                          	#       CMOON   = COS 5
040860,000365: 

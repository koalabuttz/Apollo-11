033600,001002:                                                                                          	#                       NOTHROTL        ZERO FOR THROTTLING
033601,001003:                                                                                          	#                                       ONE TO INHIBIT THROTTLING
033602,001004:                                                                                          	#                       TGO             TIME TO BURN IN CS
033603,001005: 
033604,001006:                                                                                          	#                       THE QUANTITY M.NEWTON = 10000 NEWTONS WILL BE USED TO EXPRESS
033605,001007:                                                                                          	#                       FORCE

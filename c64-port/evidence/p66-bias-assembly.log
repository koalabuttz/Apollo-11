048437,000171: 13,2466           63545        GETERAD            DLOAD    DSQ                           	#
048438,000172: 13,2467           02036                                    ALPHAV     +4                 	# SIN**2(L)
048439,000173: 13,2470           44352                           SL1      BDSU                          	#
048440,000174: 13,2471           24005                                    DP1/2                         	# COS**2(L)
048441,000175: 13,2472           44275                           DMPR     BDSU                          	#
048442,000176: 13,2473           26507                                    EE                            	#
048443,000177: 13,2474           24005                                    DP1/2                         	#
048444,000178: 13,2475           75465                           BDDV     SQRT                          	#
048445,000179: 13,2476           26503                                    B2XSC                         	#
048446,000180: 13,2477           77622                           SR4R                                   	#

053551,000099:                                                                                          	# ARCTRIG COMPUTES AN ANGLE GIVEN THE SINE AND COSINE OF THIS ANGLE.
053552,000100: 
053553,000101:                                                                                          	# THE INPUTS ARE SIN/4 AND COS/4 STORED DP AT SINTH AND COSTH.
053554,000102: 
053555,000103:                                                                                          	# THE OUTPUT IS THE CALCULATED ANGLE BETWEEN +.5 AND -.5 REVOLUTIONS AND STORED AT THETA.  THE OUTPUT IS ALSO
053556,000104:                                                                                          	# AVAILABLE AT MPAC.
053557,000105: 
053558,000106: 23,3320           51545        ARCTRIG            DLOAD    ABS                           	# PUSHDOWN  16D-21D
053559,000107: 23,3321           00023                                    SINTH                         	#

003560,001264:                                                                                          	# BIT 1 FLAG 13                                 # (0,1)=                0.5 DEG/SEC
003561,001265: 26,2022                        AUTR1FLG           =        209D                          	# (1,0)=                2.0 DEG/SEC
003562,001266: 26,2022     4753               AUTRATE1           =        BIT1                          	# (1,1)=               10.0 DEG/SEC

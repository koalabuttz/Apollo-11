053917,000158: 
053919,000160:                                                                                          	# ****************************************************************************************************************
053920,000161:                                                                                          	# THESE INTERFACE ROUTINES MAKE IT POSSIBLE TO CALL AX*SR*T, ETC., IN
053921,000162:                                                                                          	# INTERPRETIVE.  LATER, WHERE POSSIBLE, THEY WILL BE ELIMINATED.
053922,000163: 
053923,000164:                                                                                          	# THESE INTERFACE ROUTINES ARE PERMANENT.  ALL RESTORE USER'S EBANK
053924,000165:                                                                                          	# SETTING. ALL ARE STRICT INTERPRETIVE SUBROUTINES, CALLED USING "CALL",
053925,000166:                                                                                          	# RETURNING VIA QPRET.  ALL EXPECT AND RETURN THE VECTOR TO BE TRANSFOR-
053926,000167:                                                                                          	# MED INTERPRETER-STYLE IN MPAC; COMPONENTS AT MPAC, MPAC +3, AND MPAC +5.
053927,000168: 
053928,000169:                                                                                          	# TRG*SMNB AND TRG*NBSM BOTH EXPECT TO SEE THE 2'S COMPLEMENT ANGLES
053929,000170:                                                                                          	# AT CDUSPOT (ORDER Y Z X, AT CDUSPOT, CDUSPOT +2, AND CDUSPOT +4; ODD
053930,000171:                                                                                          	# LOCATIONS NEED NOT BE ZEROED).  TRG*NBSM DOES THE NB TO SM TRANSFOR-
053931,000172:                                                                                          	# MATION;  TRG*SMNB, VICE VERSA.
053932,000173: 
053933,000174:                                                                                          	# CDU*NBSM DOES ITS TRANSFORMATION USING THE PRESENT CONTENTS OF
053934,000175:                                                                                          	# THE CDU COUNTERS.  OTHERWISE IT IS LIKE TRG*NBSM.
053935,000176: 
053936,000177:                                                                                          	# CDU*SMNB IS THE COMPLEMENT OF CDU*NBSM.
053937,000178: 
053938,000179: 23,3646           77776        CDU*SMNB           EXIT                                   	#
053939,000180: 23,3647           03547                           TC       CDUTRIGS                      	#
053940,000181: 23,3650           13653                           TCF      C*MM*N1                       	#
053941,000182: 
053942,000183: 23,3651           77776        TRG*SMNB           EXIT                                   	#
053943,000184: 23,3652           03555                           TC       CD*TR*GS                      	#
053944,000185: 23,3653           07532        C*MM*N1            TC       MPACVBUF                      	# AX*SR*T EXPECTS VECTOR IN VBUF
053945,000186: 23,3654           46245                           CS       THREE                         	# SIGNAL FOR SM TO NB TRANSFORMATION
053946,000187: 23,3655           03675        C*MM*N2            TC       AX*SR*T                       	#
053947,000188: 23,3656           06037                           TC       INTPRET                       	#
053948,000189: 23,3657           43575                           VLOAD    RVQ                           	#
053949,000190: 23,3660           00123                                    VBUF                          	#
053950,000191: 
053951,000192: 23,3661           77776        CDU*NBSM           EXIT                                   	#
053952,000193: 23,3662           03547                           TC       CDUTRIGS                      	#
053953,000194: 23,3663           13666                           TCF      C*MM*N3                       	#
053954,000195: 
053955,000196: 23,3664           77776        TRG*NBSM           EXIT                                   	#
053956,000197: 23,3665           03555                           TC       CD*TR*GS                      	#
053957,000198: 23,3666           07532        C*MM*N3            TC       MPACVBUF                      	# FOR AX*SR*T
053958,000199: 23,3667           36245                           CA       THREE                         	# SIGNAL FOR NB TO SM TRANSFORMATION
053959,000200: 23,3670           13655                           TCF      C*MM*N2                       	#
053960,000201: 
053961,000202:                                                                                          	# *NBSM* AND *SMNB* EXPECT TO SEE THE SINES AND COSINES (AT SINCDU
053962,000203:                                                                                          	# AND COSCDU) RATHER THAN THE ANGLES THEMSELVES.  OTHERWISE THEY ARE
053963,000204:                                                                                          	# LIKE TRG*NBSM AND TRG*SMNB.
053964,000205: 
053965,000206:                                                                                          	# NOTE THAT JUST AS CD*TR*GS NEED BE CALLED ONLY ONCE FOR EACH SERIES
053966,000207:                                                                                          	# OF TRANSFORMATIONS USING THE SAME ANGLES, SO TOO ONLY ONE OF TRG*NBSM
053968,000209:                                                                                          	# AND TRG*SMNB NEED BE CALLED FOR EACH SERIES.  FOR SUBSEQUENT TRANSFOR-
053969,000210:                                                                                          	# MATIONS USE *NBSM* AND *SMNB*.
053970,000211: 
053971,000212: 23,3671           77776        *SMNB*             EXIT                                   	#
053972,000213: 23,3672           13653                           TCF      C*MM*N1                       	#
053973,000214: 
053974,000215: 23,3673           77776        *NBSM*             EXIT                                   	#
053975,000216: 23,3674           13666                           TCF      C*MM*N3                       	#
053976,000217: 
053977,000218:                                                                                          	# AX*SR*T COMBINES THE OLD SMNB AND NBSM.  FOR THE NB TO SM
053978,000219:                                                                                          	# TRANSFORMATION, ENTER WITH +3 IN A.  FOR SM TO NB, ENTER WITH -3.
053979,000220:                                                                                          	# THE VECTOR TO BE TRANSFORMED ARRIVES, AND IS RETURNED, IN VBUF.
053980,000221:                                                                                          	# AX*SR*T EXPECTS TO FIND THE SINES AND COSINES OF THE ANGLES OF ROTATION
053981,000222:                                                                                          	# AT SINCDU AND COSCDU, IN THE ORDER Y Z X.  A CALL TO CD*TR*GS, WITH
053982,000223:                                                                                          	# THE 2'S COMPLEMENT ANGLES (ORDER Y Z X) AT CDUSPOT, WILL TAKE CARE OF
053983,000224:                                                                                          	# THIS.  HERE IS A SAMPLE CALLING SEQUENCE:-
053984,000225:                                                                                          	#               TC      CDUTRIGS
053985,000226:                                                                                          	#               CS      THREE           ("CA THREE" FOR NBSM)
053986,000227:                                                                                          	#               TC      AX*SR*T
053987,000228:                                                                                          	# THE CALL TO CD*TR*GS NEED NOT BE REPEATED, WHEN AX*SR*T IS CALLED MORE
053988,000229:                                                                                          	# THAN ONCE, UNLESS THE ANGLES HAVE CHANGED.
053989,000230: 
053990,000231:                                                                                          	# AX*SR*T IS GUARANTEED SAFE ONLY FOR VECTORS OF MAGNITUDE LESS THAN
053991,000232:                                                                                          	# UNITY.  A LOOK AT THE CASE IN WHICH A VECTOR OF GREATER MAGNITUDE
053992,000233:                                                                                          	# HAPPENS TO LIE ALONG AN AXIS OF THE SYSTEM TO WHICH IT IS TO BE TRANS-
053993,000234:                                                                                          	# FORMED CONVINCES ONE THAT THIS IS A RESTRICTION WHICH MUST BE ACCEPTED.
053994,000235: 
053995,000236: 23,3675           54142        AX*SR*T            TS       DEXDEX                        	# WHERE IT BECOMES THE INDEX OF INDEXES
053996,000237: 23,3676           00006                           EXTEND                                 	#
053997,000238: 23,3677           22145                           QXCH     RTNSAVER                      	#
053998,000239: 
053999,000240: 23,3700           10142        R*TL**P            CCS      DEXDEX                        	#               +3 --> 0        -3 --> 2
054000,000241: 23,3701           40142                           CS       DEXDEX                        	# THUS:         +2 --> 1        -2 --> 1

017017,000538: 
017018,000539:                                                                                          	# NUM ASSEMBLES OCTAL 3 BITS AT A TIME.  FOR DECIMAL IT CONVERTS INCOMING
017019,000540:                                                                                          	# WORD AS A FRACTION, KEEPING RESULTS TO DP.
017020,000541:                                                                                          	# OCTAL RESULTS ARE LEFT IN XREG, YREG, OR ZREG.  HI PART OF DEC IN XREG,
017021,000542:                                                                                          	# YREG, ZREG.  THE LOW PARTS IN XREGLP, YREGLP, OR ZREGLP)
017022,000543:                                                                                          	# DECBRNCH IS LEFT AT +0 FOR OCT, +1 FOR + DEC, +2 FOR - DEC.

045792,002095: 00,2711           12721                           TCF      /BUF+                         	#
045793,002096: 00,2712           12405                           TCF      DVOVF                         	# ZERO DIVISOR - OVERFLOW.
045794,002097: 00,2713           12715                           TCF      /BUF-                         	#

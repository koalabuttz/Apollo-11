052276,000919:                                                                                          	# MIDTOAV1
052277,000920: 
052278,000921:                                                                                          	# THIS ROUTINE INTEGRATES (PRECISION) TO THE TIME SPECIFIED IN TDEC1.
052279,000922:                                                                                          	# IF, AT THE END OF AN INTEGRATION TIME STEP, CURRENT TIME PLUS A DELTA
052280,000923:                                                                                          	# TIME (SEE TIMEDELT.....BASED ON THE COMPUTATUON TIME FOR ONE TIME STEP)
052281,000924:                                                                                          	# IS GREATER THAN THE DESIRED TIME, ALARM 1703 IS SET AND THE INTEGRATION
052282,000925:                                                                                          	# IS DONE TO THE CURRENT TIME.
052283,000926:                                                                                          	# RETURN IS IN BASIC TO THE RETURN ADDRESS PLUS ONE.
052284,000927: 
052285,000928:                                                                                          	# IF THE INTEGRATION IS FINISHED TO THE DESIRED TIME, RETURN IS IN BASIC
052286,000929:                                                                                          	# TO THE RETURN ADDRESS
052287,000930: 
052288,000931:                                                                                          	# IN EITHER CASE, BEFORE RETURNING, THE EXTRAPOLATED STATE VECTOR IS TRAN
052289,000932:                                                                                          	# FERRED FROM R,VATT TO R,VN1-PIPTIME1 IS SET TO THE FINISHING INTEGRA-
052290,000933:                                                                                          	# TION TIME AND MPAC IS SET TO THE DELTA TIME ---
052291,000934:                                                                                          	#                       TAT MINUS CURRENT TIME.
052292,000935: 

019977,003498: 
019979,003500:                                                                                          	# INTERNAL USE OF KEYBOARD AND DISPLAY PROGRAM
019980,003501: 
019981,003502:                                                                                          	# USER MUST SCHEDULE CALLS TO NVSUB SO THAT THERE IS NO CONFLICT OF USE OR
019982,003503:                                                                                          	# CONFUSION TO OPERATOR. THE OLD GRABLOCK (INTERNAL/INTERNAL INTERLOCK)
019983,003504:                                                                                          	# HAS BEEN REMOVED AND THE INTERNAL USER NO LONGER HAS THE PROTECTION THIS
019984,003505:                                                                                          	# OFFERED.
019985,003506: 
019986,003507:                                                                                          	# THERE ARE TWO WAYS A JOB CAN BE PUT TO SLEEP BY THE KEYBOARD + DISPLAY
019987,003508:                                                                                          	# PROGRAM.      1) BY ENDIDLE
019988,003509:                                                                                          	#               2) BY NVSUBUSY
019989,003510:                                                                                          	# THE BASIC CONVENTION IS THAT ONLY ONE JOB WILL BE PERMITTED ASLEEP VIA
019990,003511:                                                                                          	# THE KEYBOARD + DISPLAY PROGRAM AT A TIME. IF A JOB ATTEMPTS TO GO TO
019991,003512:                                                                                          	# SLEEP BY MEANS OF (1) OR (2) AND THERE IS ALREADY A JOB ASLEEP THAT WAS
019992,003513:                                                                                          	# PUT TO SLEEP BY (1) OR (2), THEN AN ABORT IS CAUSED.
019993,003514: 
019994,003515:                                                                                          	# THE CALLING SEQUENCE FOR NVSUB IS
019995,003516:                                                                                          	#                       CAF             V/N
019996,003517:                                                                                          	#       L               TC              NVSUB
019997,003518:                                                                                          	#       L+1             RETURN HERE IF OPERATOR HAS INTERVENED
019998,003519:                                                                                          	#       L+2             RETURN HERE AFTER EXECUTION
019999,003520: 
020000,003521:                                                                                          	# A ROUTINE CALLED NVSUBUSY IS PROVIDED (USE IS OPTIONAL) TO PUT
020001,003522:                                                                                          	# YOUR JOB TO SLEEP UNTIL THE OPERATOR RELEASES THE KEYBOARD + DISPLAY
020002,003523:                                                                                          	# SYSTEM. NVSUBUSY ALSO TURNS ON THE KEY RELEASE LIGHT.
020003,003524:                                                                                          	# NVSUBUSY CANNOT BE CALLED FROM ERASABLE OR F/F MEMORY,
020004,003525:                                                                                          	# SINCE JOBSLEEP AND JOBWAKE CAN HANDLE ONLY FIXED BANKS.
020005,003526: 
020006,003527:                                                                                          	# THE CALLING SEQUENCE IS
020007,003528:                                                                                          	#       CAF     WAKEFCADR
020008,003529:                                                                                          	#       TC      NVSUBUSY
020009,003530: 
020010,003531: 
020011,003532:                                                                                          	# .
020012,003533: 
020013,003534:                                                                                          	# NVSUBUSY IS INTENDED FOR USE WHEN AN INTERNAL PROGRAM FINDS THE OPERATOR
020014,003535:                                                                                          	# IS USING THE KEYBOARD + DISPLAY PROGRAM (BY HIS OWN INITIATION). IT IS
020015,003536:                                                                                          	# NOT INTENDED FOR USE WHEN ONE INTERNAL PROGRAM FINDS ANOTHER INTERNAL 
020016,003537:                                                                                          	# PROGRAM USING THE KEYBOARD + DISPLAY PROGRAM.
020017,003538: 
020018,003539:                                                                                          	# NVSUBUSY ABORTS (WITH CODE 01206) IF A SECOND JOB ATTEMPTS TO GO TO
020019,003540:                                                                                          	# SLEEP IN PINBALL. IN PARTICULAR, IF AN ATTEMPT IS MADE TO GO TO NVSUBUSY
020020,003541:                                                                                          	# WHEN
020021,003542:                                                                                          	# 1)    DSPLIST NOT= +0.  THIS IS THE CASE WHERE THE CAPACITY OF THE DSPLIST
020022,003543:                                                                                          	#       IS EXCEEDED.
020023,003544:                                                                                          	# 2)    CADRSTOR NOT= +0.  THIS INDICATES THAT A JOB IS ALREADY USING
020025,003546:                                                                                          	# ENDIDLE.  (+-NZ INDICATE A JOB IS ALREADY ASLEEP DUE TO ENDIDLE.)
020026,003547: 
020027,003548:    4437           44444        PRENVBSY           CS       2K+3                          	# SPECIAL ENTRANCE FOR ROUTINES IN FIXED
020028,003549:    4440           60002                           AD       Q                             	# BANKS ONLY DESIRING THE FCADR OF (LOC
020029,003550:    4441           60004                           AD       FBANK                         	# FROM WHICH THE TC PRENVBSY WAS DONE) -2
020030,003551:    4442           04635        NVSUBUSY           TC       POSTJUMP                      	# TO BE ENTERED.
020031,003552:    4443           10647                           CADR     NVSUBSY1                      	#
020032,003553:    4444           02003        2K+3               OCT      2003                          	#
020033,003554: 
020034,003555:                                                                                          	# NVSUBSY1 MUST BE IN BANK 27 OR LOWER, SO IT WILL PUT CALLER TO SLEEP
020035,003556:                                                                                          	# WITH HIS PROPER SUPERBITS.
020036,003557: 
020037,003558: 04,2647                                           SETLOC   ENDSPMM    +1                 	#
020038,003559: 04,2647                                           COUNT*   $$/PIN                        	#
020039,003560: 04,2647           54001        NVSUBSY1           TS       L                             	#
020040,003561: 04,2650           04220                           TC       ISCADR+0                      	# ABORT IF CADRSTOR NOT= +0.
020041,003562: 04,2651           04224                           TC       ISLIST+0                      	# ABORT IF DSPLIST NOT= +0.
020042,003563: 04,2652           04374                           TC       RELDSPON                      	#
020043,003564: 04,2653           30001                           CA       L                             	#
020044,003565: 04,2654           55043                           TS       DSPLIST                       	#
020045,003566: 04,2655           05133        ENDNVBSY           TC       JOBSLEEP                      	#
020046,003567: 
020047,003568:                                                                                          	# NVSBWAIT IS A SPECIAL ENTRANCE FOR ROUTINES IN FIXED BANKS ONLY. IF
020048,003569:                                                                                          	# SYSTEM IS NOT BUSY, IT EXECUTES V/N AND RETURNS TO L+1 (L= LOC FROM
020049,003570:                                                                                          	# WHICH THE TC NVSBWAIT WAS DONE). IF SYSTEM IS BUSY, IT PUTS CALLING JOB
020050,003571:                                                                                          	# TO SLEEP WITH L-1 GOING INTO LIST FOR EVENTUAL WAKING UP WHEN SYSTEM
020051,003572:                                                                                          	# IS NOT BUSY.
020052,003573: 
020053,003574:    4445                                           SETLOC   NVSUBUSY   +3                 	#
020054,003575:    4445                                           COUNT*   $$/PIN                        	#
020055,003576:    4445           22007        NVSBWAIT           LXCH     7                             	# ZERO NVMONOPT OPTIONS
020056,003577:    4446           54123                           TS       NVTEMP                        	#
020057,003578:    4447           34736                           CAF      BIT14                         	#
020058,003579:    4450           71021                           MASK     MONSAVE1                      	# EXTERNAL MONITOR BIT
020059,003580:    4451           61012                           AD       DSPLOCK                       	#
020060,003581:    4452           10000                           CCS      A                             	#
020061,003582:    4453           14455                           TCF      NVSBWT1                       	# BUSY
020062,003583:    4454           14164                           TCF      NVSBCOM                       	# FREE. NVSUB WILL SAVE L+1 FOR RETURN
020063,003584:                                                                                          	# AFTER EXECUTION.
020064,003585:    4455           24002        NVSBWT1            INCR     Q                             	# L+2. PRENVBSY WILL PUT L-1 INTO LIST AND
020065,003586:    4456           14437                           TCF      PRENVBSY                      	# GO TO SLEEP.
020066,003587: 
020067,003588:                                                                                          	# RELDSP IS USED BY VBPROC, VBTERM, VBRQEXEC, VBRQWAIT, VBRELDSP, EXTENDED
020068,003589:                                                                                          	# VERB DISPATCHER, VBRESEQ, RECALTST.
020069,003590:                                                                                          	# RELDSP1 IS USED BY MONITOR SET UP, VBRELDSP.

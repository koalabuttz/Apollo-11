062757,000712: 
062758,000713:                                                                                          	# THE JET LIST:
062759,000714:                                                                                          	# THIS IS A WAITLIST FOR T6RUPTS.
062760,000715: 
062761,000716:                                                                                          	# CALLED BY:
062762,000717:                                                                                          	#               CA      TJ              TIME WHEN NEXT JETS WILL BE WRITTEN
062763,000718:                                                                                          	#               TS      T6FURTHA
062764,000719:                                                                                          	#               CA      INDEX           AXIS TO BE WIRTTEN AT TJ (FROM NOW)
062765,000720:                                                                                          	#               TS      T6FURTHA +1
062766,000721:                                                                                          	#               TC      JTLST
062767,000722: 
062768,000723:                                                                                          	# EXAMPLE - U-AXIS AUTOPILOT WILL WRITE ITS ROTATION CODE OF
062769,000724:                                                                                          	# JETS INTO CHANNEL 5.  IF IT DESIRES TO TURN OFF THIS POLICY WITHIN
062770,000725:                                                                                          	# 150MS AND THEN FIRE NEXTU, A CALL TO JTLST IS MADE WITH T6FURTHA
062771,000726:                                                                                          	# CONTAINING THE TIME TO TURN OFF THE POLICY, T6FURTHA +1 THE INDEX
062772,000727:                                                                                          	# OF THE U-AXIS(4), AND NEXTU WILL CONTAIN THE "U-TRANS" POLICY OR ZERO.
062773,000728: 
062774,000729:                                                                                          	# THE LIST IS EXACTLY 3 LONG.  (THIS LEADS TO SKIP LOGIC AND 150MS LIMIT)
062775,000730:                                                                                          	# THE INPUT IS THE LAST MEMBER OF THE LIST
062776,000731: 
062777,000732:                                                                                          	# RETURNS BY:
062778,000733:                                                                                          	#       +       TC      Q
062779,000734: 
062780,000735:                                                                                          	# DEFINITIONS:  (OUTPUT)
062781,000736:                                                                                          	#       TIME6           TIME OF NEXT RUPT
062782,000737:                                                                                          	#       T6NEXT          DELTA TIME TO NEXT RUPT
062783,000738:                                                                                          	#       T6FURTHA        DELTA TIME FROM 2ND TO LAST RUPT
062784,000739:                                                                                          	#       NXT6ADR         AXIS INDEX       Q - P-AXIS
062785,000740:                                                                                          	#       T6NEXT +1       AXIS INDEX       4 - U-AXIS
062786,000741:                                                                                          	#       T6FURTHA +1     AXIS INDEX      13 - V-AXIS
062787,000742: 
062788,000743: 17,3114           41470        JTLST              CS       T6FURTHA                      	#
062789,000744: 17,3115           60031                           AD       TIME6                         	#
062790,000745: 17,3116           00006                           EXTEND                                 	#
062791,000746: 17,3117           63131                           BZMF     MIDORLST                      	# TIME6 - T IS IN A
062792,000747: 
062793,000748: 17,3120           23465                           LXCH     NXT6ADR                       	#
062794,000749: 17,3121           53467                           DXCH     T6NEXT                        	#
062795,000750: 17,3122           53471                           DXCH     T6FURTHA                      	#

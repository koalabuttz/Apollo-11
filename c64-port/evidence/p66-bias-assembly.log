041318,000823:                                                                                          	# ROUTINE NAME - CHKSDATA               DATE - JAN 9, 1967
041319,000824:                                                                                          	# MOD NO - 0                            LOG SECTION - P51-P53
041320,000825:                                                                                          	# MODIFICATION BY - LONSKE              ASSEMBLY -
041321,000826: 
041322,000827:                                                                                          	# FUNCTIONAL DESCRIPTION - CHECKS THE VALIDITY OF A PAIR OF STAR SIGHTINGS.  WHEN A PAIR OF STAR SIGHTINGS ARE MADE
041323,000828:                                                                                          	# BY THE ASTRONAUT THIS ROUTINE OPERATES AND CHECKS THE OBSERVED SIGHTINGS AGAINST STORED STAR VECTORS IN THE
041324,000829:                                                                                          	# COMPUTER TO INSURE A PROPER SIGHTING WAS MADE.  THE FOLLOWING COMPUTATIONS ARE PERFORMED_
041325,000830:                                                                                          	#       OS1     =       OBSERVED STAR 1 VECTOR
041326,000831:                                                                                          	#       OS2     =       OBSERVED STAR 2 VECTOR
041327,000832:                                                                                          	#       SS1     =       STORED STAR 1 VECTOR
041328,000833:                                                                                          	#       SS2     =       STORED STAR 2 VECTOR
041329,000834:                                                                                          	#        A1     =       ARCCOS(OS1 - OS2)
041330,000835:                                                                                          	#        A2     =       ARCCOS(SS1 - SS2)
041331,000836:                                                                                          	#         A     =       ABS(2(A1 - A2))
041333,000838:                                                                                          	# THE ANGULAR DIFFERENCE IS DISPLAYED FOR ASTRONAUT ACCEPTENCE
041334,000839: 
041335,000840:                                                                                          	# EXIT MODE     1. FREEFLAG SET IMPLIES ASTRONAUT WANTS TO PROCEED
041336,000841:                                                                                          	#               2. FREEFLAG RESET IMPLIES ASTRONAUT WANTS TO RECYCLE            ERANCE)
041337,000842: 
041338,000843:                                                                                          	# OUTPUT -      1. VERB 6,NOUN 3 - DISPLAYS ANGULAR DIFFERENCE BETWEEN 2 SETS OF STARS.
041339,000844:                                                                                          	#               2. STAR VECTORS FROM STAR CATALOG ARE LEFT IN 6D AND 12D.
041340,000845: 
041341,000846:                                                                                          	# ERASABLE INITIALIZATION REQUIRED -
041342,000847:                                                                                          	#               1. MARK VECTORS ARE STORED IN STARAD AND STARAD +6.
041343,000848:                                                                                          	#               2. CATALOG VECTORS ARE STORED IN 6D AND 12D.
041344,000849: 
041345,000850:                                                                                          	# DEBRIS -
041346,000851: 

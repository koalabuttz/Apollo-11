011724,000923:                                                                                          	# V82PERF       VERB82          DESCRIPTION
011725,000924:                                                                                          	#       REQUEST ORBIT PARAMETERS DISPLAY (R30)
011726,000925: 
011727,000926:                                                                                          	#       1.      IF AVERAGE G IS OFF:
011728,000927:                                                                                          	#                       FLASH DISPLAY V04N06.  R2 INDICATES WHICH SHIP'S STATE VECTOR IS
011729,000928:                                                                                          	#                       TO BE UPDATED.  INITIAL CHOICE IS THIS SHIP (R2=1).  ASTRONAUT
011730,000929:                                                                                          	#                       CAN CHANGE TO OTHER SHIP BY V22EXE, WHERE X NOT EQ 1.
011731,000930:                                                                                          	#                       SELECTED STATE VECTOR UPDATED BY THISPREC (OTHPREC).
011732,000931:                                                                                          	#                       CALLS SR30.1 (WHICH CALLS TFFCONMU + TFFRP/RA) TO CALCULATE
011733,000932:                                                                                          	#                       RPER (PERIGEE RADIUS), RAPO (APOGEE RADIUS), HPER (PERIGEE
011734,000933:                                                                                          	#                       HEIGHT ABOVE LAUNCH PAD OR LUNAR LANDING SITE), HAPO (APOGEE
011735,000934:                                                                                          	#                       HEIGHT AS ABOVE), TPER (TIME TO PERIGEE), TFF (TIME TO 
011736,000935:                                                                                          	#                       INTERSECT 300 KFT ABOVE PAD OR 35KFT ABOVE LANDING SITE).
011737,000936:                                                                                          	#                       FLASH MONITOR V16N44 (HAPO, HPER, TFF).  TFF IS -59M59S IF IT WAS
011738,000937:                                                                                          	#                       NOT COMPUTABLE, OTHERWISE IT INCREMENTS ONCE PER SECOND.
011739,000938:                                                                                          	#                       ASTRONAUT HAS OPTION TO MONITOR TPER BY KEYING IN N 32 E.
011740,000939:                                                                                          	#                       DISPLAY IS IN HMS, IS NEGATIVE (AS WAS TFF), AND INCREMENTS
011741,000940:                                                                                          	#                       ONCE PER SECOND ONLY IF TFF DISPLAY WAS -59M59S.
011742,000941: 
011743,000942:                                                                                          	#       2.      IF AVERAGE G IS ON:
011744,000943:                                                                                          	#                       CALLS SR30.1 APPROX EVERY TWO SECS.  STATE VECTOR IS ALWAYS
011745,000944:                                                                                          	#                       FOR THIS VEHICLE.  V82 DOES NOT DISTURB STATE VECTOR.  RESULTS
011746,000945:                                                                                          	#                       OF SR30.1 ARE RAPO, RPER, HAPO, HPER, TPER, TFF.
011747,000946:                                                                                          	#                       FLASH MONITOR V16N44 (HAPO, HPER, TFF).
011748,000947:                                                                                          	#                       IF MODE IS P11, THEN CALL DELRSPL SO ASTRONAUT CAN MONITOR
011749,000948:                                                                                          	#                       RESULTS BY N50E.  SPLASH COMPUTATION DONE ONCE PER TWO SECS.
011750,000949: 

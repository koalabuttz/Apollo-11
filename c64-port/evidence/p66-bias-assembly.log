006656,000318: 
006658,000320:                                                                                          	# PROGRAM NAME:  TNONTEST.
006659,000321: 
006660,000322:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM HONORS REQUESTS FOR ISS INITIALIZATION.  ISS TURN-ON (CHANNEL 30 BIT 14)
006661,000323:                                                                                          	# AND ISS OPERATE (CHANNEL 30 BIT 9) REQUESTS ARE TREATED AS A PAIR AND PROCESSING TAKES PLACE .480 SECONDS
006662,000324:                                                                                          	# AFTER EITHER ONE APPEARS.  THIS INITIALIZATION TAKES ON ONE OF THE FOLLOWING THREE FORMS:
006663,000325: 
006664,000326:                                                                                          	#       1) ISS TURN-ON:  IN THIS SITUATION THE COMPUTER IS OPERATING WHEN THE ISS IS TURNED ON.  NOMINALLY,
006665,000327:                                                                                          	#       BOTH ISS TURN-ON AND ISS OPERATE APPEAR.  THE PLATFORM IS CAGED FOR 90 SECONDS AND THE ICDU'S ZEROED
006666,000328:                                                                                          	#       SO THAT AT THE END OF THE PROCESS THE GIMBAL LOCK MONITOR WILL FUNCTION PROPERLY.
006667,000329: 
006668,000330:                                                                                          	#       2) ICDU INITIALIZATION:  IN THIS CASE THE COMPUTER WAS PROBABLY TURNED ON WITH THE ISS IN OPERATE OR
006669,000331:                                                                                          	#       A FRESH START WAS DONE WITH THE ISS IN OPERATE.  IN THIS CASE ONLY ISS OPERATE IS ON.  THE ICDU'S ARE
006670,000332:                                                                                          	#       ZEROED SO THE GIMBAL LOCK MONITOR WILL FUNCTION.  AN EXCEPTION IS IF THE ISS IS IN GIMBAL LOCK AFTER
006671,000333:                                                                                          	#       A RESTART, THE ICDU'S WILL NOT BE ZEROED.
006672,000334: 
006673,000335:                                                                                          	#       3) RESTART WITH RESTARTABLE PROGRAM USING THE IMU:  IN THIS CASE, NO INITIALIZATION TAKES PLACE SINCE
006674,000336:                                                                                          	#       IT IS ASSUMED THAT THE USING PROGRAM DID THE INITIALIZATION AND THEREFORE T4RUPT SHOULD NOT INTERFERE.
006675,000337: 
006676,000338:                                                                                          	# IMODES30 BIT 7 IS SET = 1 BY THE FIRST BIT (CHANNEL 30 BIT 14 OR 9) WHICH ARRIVES.  FOLLOWING THIS. TNONTEST IS
006677,000339:                                                                                          	# ENTERED, FINDS BIT 7 = 1 BUT BIT 8 = 0, SO IT SETS BIT 8 = 1 AND EXITS.  THE NEXT TIME IT FINDS BIT 8 = 1 AND
006678,000340:                                                                                          	# PROCEEDS, SETTING BITS 8 AND 7 = 0.  AT PROCTNON, IF ISS TURN-ON REQUEST IS PRESENT, THE ISS IS CAGED (ZERO +
006679,000341:                                                                                          	# COARSE).  IF ISS OPERATE IS NOT PRESENT PROGRAM ALARM 00213 IS ISSUED.  AT THE END OF A 90 SECOND CAGE, BIT 2
006680,000342:                                                                                          	# OF IMODES30 IS TESTED.  IF IT IS = 1, ISS TURN-ON WAS NOT PRESENT FOR THE ENTIRE 90 SECONDS.  IN THAT CASE, IF
006681,000343:                                                                                          	# THE ISS TURN-ON REQUEST IS PRESENT THE 90 SECOND WAIT IS REPEATED, OTHERWISE NO ACTION OCCURS UNLESS A PROGRAM
006682,000344:                                                                                          	# WAS WAITING FOR THE INITIALIZATION IN WHICH CASE THE PROGRAM IS GIVEN AN IMUSTALL ERROR RETURN.  IF THE DELAY
006683,000345:                                                                                          	# WENT PROPERLY, THE ISS DELAY OUTBIT IS SENT AND THE ICDU'S ZEROED.  A TASK IS INITIATED TO REMOVE THE PIPA FAIL
006684,000346:                                                                                          	# INHIBIT BIT IN 10.24 SECONDS.  IF A MISSION PROGRAM WAS WAITING IT IS INFORMED VIA ENDIMU.
006685,000347: 
006686,000348:                                                                                          	# AT PROCTNON, IF ONLY ISS OPERATE IS PRESENT (OPONLY), THE CDU'S ARE ZEROED UNLESS THE PLATFORM IS IN COARSE
006687,000349:                                                                                          	# ALIGN (= GIMBAL LOCK HERE) OR A MISSION PROGRAM IS USING THE IMU (IMUSEFLG = 1).
006688,000350: 
006689,000351:                                                                                          	# CALLING SEQUENCE:  T4RUPT EVERY 480 MILLISECONDS AFTER IMUMON.
006690,000352: 
006691,000353:                                                                                          	# JOBS OR TASKS INITIATED:  1) ENDTNON, 90 SECONDS AFTER CAGING STARTED.  2) ISSUP, 4 SECONDS AFTER CAGING DONE.
006692,000354:                                                                                          	#       3) PFAILOK, 10.24 SECONDS AFTER INITIALIZATION COMPLETED.  4) UNZ2, 320 MILLISECONDS AFTER ZEROING
006693,000355:                                                                                          	#       STARTED.
006694,000356: 
006695,000357:                                                                                          	# SUBROUTINES CALLED: CAGESUB, CAGESUB2, ZEROICDU, ENDIMU, IMUBAD, NOATTOFF, SETISSW, VARDELAY.
006696,000358: 
006697,000359:                                                                                          	# ERASABLE INITIALIZATION:  SEE IMUMON.
006698,000360: 
006699,000361:                                                                                          	# ALARMS:  PROGRAM ALARM 00213 IF ISS TURN-ON REQUESTED WITHOUT ISS OPERATE.
006700,000362: 
006701,000363:                                                                                          	# EXIT:  ENDTNON EXITS TO C33TEST.  TASKS HAVING TO DO WITH INITIALIZATION EXIT AS FOLLOWS:  MISSION PROGRAM
006702,000364:                                                                                          	# WAITING AND INITIALIZATION COMPLETE, EXIT TO ENDIMU, MISSION PROGRAM WAITING AND INITIALIZATION FAILED, EXIT TO
006703,000365:                                                                                          	# IMUBAD, IMU NOT IN USE, EXIT TO TASKOVER.
006704,000366: 
006705,000367:                                                                                          	# OUTPUT:  ISS INITIALIZED.
006706,000368: 
006707,000369: 06,2227           41302        TNONTEST           CS       IMODES30                      	# AFTER PROCESSING ALL CHANGES, SEE IF IT
006709,000371: 06,2230           74745                           MASK     BIT7                          	# IS TIME TO ACT ON A TURN-ON SEQUENCE.
006710,000372: 06,2231           10000                           CCS      A                             	#
006711,000373: 06,2232           12374                           TCF      C33TEST                       	# NO - EXAMINE CHANNEL 33.
006712,000374: 
006713,000375: 06,2233           34744                           CAF      BIT8                          	# SEE IF FIRST SAMPLE OR SECOND.
006714,000376: 06,2234           71302                           MASK     IMODES30                      	#
006715,000377: 06,2235           10000                           CCS      A                             	#
006716,000378: 06,2236           12242                           TCF      PROCTNON                      	# REACT AFTER SECOND SAMPLE.
006717,000379: 
006718,000380: 06,2237           34744                           CAF      BIT8                          	# IF FIRST SAMPLE, SET BIT TO REACT NEXT
006719,000381: 06,2240           27302                           ADS      IMODES30                      	# TIME.
006720,000382: 06,2241           12374                           TCF      C33TEST                       	#
006721,000383: 
006722,000384:                                                                                          	# PROCESS IMU TURN-ON REQUESTS AFTER WAITING 1 SAMPLE FOR ALL SIGNALS TO ARRIVE.
006723,000385: 
006724,000386: 06,2242           42777        PROCTNON           CS       BITS7&8                       	#
006725,000387: 06,2243           71302                           MASK     IMODES30                      	#
006726,000388: 06,2244           55302                           TS       IMODES30                      	#

003608,000041: 
003610,000043:                                                                                          	# CONVENTIONS AND NOTATIONS UTILIZED FOR ERASABLE ASSIGNMENTS.
003611,000044: 
003612,000045:                                                                                          	#       EQUALS  IS USED IN TWO WAYS.  IT IS OFTEN USED TO CHAIN A GROUP
003613,000046:                                                                                          	#               OF ASSIGNMENTS SO THAT THE GROUP MAY BE MOVED WITH THE
003614,000047:                                                                                          	#               CHANGING OF ONLY ONE CARD.  EXAMPLE.
003615,000048: 
003616,000049:                                                                                          	#                       X       EQUALS  START
003617,000050:                                                                                          	#                       Y       EQUALS  X       +SIZE.X
003618,000051:                                                                                          	#                       Z       EQUALS  Y       +SIZE.Y
003619,000052: 
003620,000053:                                                                                          	#               (X, Y, AND Z ARE CONSECUTIVE AND BEGIN AT START.       )
003621,000054:                                                                                          	#               (SIZE.X AND SIZE.Y ARE THE RESPECTIVE SIZES OF X AND Y,
003622,000055:                                                                                          	#                USUALLY NUMERIC, IE. 1, 2, 6, 18D ETC.                )
003623,000056: 
003624,000057:                                                                                          	#       EQUALS  OFTEN IMPLIES THE SHARING OF REGISTERS (DIFFERENT NAMES
003625,000058:                                                                                          	#               AND DIFFERENT DATA).  EXAMPLE.
003626,000059: 
003627,000060:                                                                                          	#                       X       EQUALS  Y
003628,000061: 
003629,000062:                                                                                          	#       =       MEANS THAT MULTIPLE NAMES HAVE BEEN GIVEN TO THE SAME DATA.
003630,000063:                                                                                          	#               (THIS IS LOGICAL EQUIVALENCE, NOT SHARING)  EXAMPLE.
003631,000064: 
003632,000065:                                                                                          	#                       X       =       Y
003633,000066: 
003634,000067:                                                                                          	#       THE SIZE AND UTILIZATION OF AN ERASABLE ARE OFTEN INCLUDED IN
003635,000068:                                                                                          	#       THE COMMENTS IN THE FOLLOWING FORM.  M(SIZE)N.
003636,000069: 
003637,000070:                                                                                          	#               M       REFERS TO THE MOBILITY OF THE ASSIGNMENT.
003638,000071:                                                                                          	#                       B       MEANS THAT THE SYMBOL IS REFERENCED BY BASIC
003639,000072:                                                                                          	#                               INSTRUCTIONS AND THUS IS E-BANK SENSITIVE.
003640,000073:                                                                                          	#                       I       MEANS THAT THE SYMBOL IS REFERENCED ONLY BY
003641,000074:                                                                                          	#                               INTERPRETIVE INSTRUCTIONS, AND IS THUS E-BANK
003642,000075:                                                                                          	#                               INSENSITIVE AND MAY APPEAR IN ANY E-BANK.
003643,000076: 
003644,000077:                                                                                          	#               SIZE    IS THE NUMBER OF REGISTERS INCLUDED BY THE SYMBOL.
003645,000078: 
003646,000079:                                                                                          	#               N       INDICATES THE NATURE OR PERMANENCE OF THE CONTENTS.
003647,000080:                                                                                          	#                       PL      MEANS THAT THE CONTENTS ARE PAD LOADED.
003648,000081:                                                                                          	#                       DSP     MEANS THAT THE REGISTER IS USED FOR A DISPLAY.
003649,000082:                                                                                          	#                       PRM     MEANS THAT THE REGISTER IS PERMANENT,  IE. IT
003650,000083:                                                                                          	#                               IS USED DURING THE ENTIRE MISSION FOR ONE
003651,000084:                                                                                          	#                               PURPOSE AND CANNOT BE SHARED.
003652,000085:                                                                                          	#                       TMP     MEANS THAT THE REGISTER IS USED TEMPORARILY OR
003653,000086:                                                                                          	#                               IS A SCRATCH REGISTER FOR THE ROUTINE TO WHICH
003654,000087:                                                                                          	#                               IT IS ASSIGNED.  THAT IS, IT NEED NOT BE SET
003655,000088:                                                                                          	#                               PRIOR TO INVOCATION OF THE ROUTINE NOR DOES IT
003656,000089:                                                                                          	#                               CONTAIN USEFUL OUTPUT TO ANOTHER ROUTINE.  THUS
003658,000091:                                                                                          	#                               IT MAY BE SHARED WITHANY OTHER ROUTINE WHICH
003659,000092:                                                                                          	#                               IS NOT ACTIVE IN PARALLEL.
003660,000093:                                                                                          	#                       IN      MEANS INPUT TO THE ROUTINE AND IT IS PROBABLY
003661,000094:                                                                                          	#                               TEMPORARY FOR A HIGHER-LEVEL ROUTINE/PROGRAM.
003662,000095:                                                                                          	#                       OUT     MEANS OUTPUT FROM THE ROUTINE, PROBABLY
003663,000096:                                                                                          	#                               TEMPORARY FOR A HIGHER-LEVEL ROUTINE/PROGRAM.
003664,000097: 
003666,000099:                                                                                          	# SPECIAL REGISTERS.
003667,000100: 
003668,000101: 26,2022                        A                  EQUALS   0                             	#
003669,000102: 26,2022                        L                  EQUALS   1                             	# L AND Q ARE BOTH CHANNELS AND REGISTERS.
003670,000103: 26,2022                        Q                  EQUALS   2                             	#
003671,000104: 26,2022                        EBANK              EQUALS   3                             	#
003672,000105: 26,2022                        FBANK              EQUALS   4                             	#
003673,000106: 26,2022                        Z                  EQUALS   5                             	# ADJACENT TO FBANK AND BBANK FOR DXCH Z
003674,000107: 26,2022                        BBANK              EQUALS   6                             	# (DTCB) AND DXCH FBANK (DTCF).
003675,000108:                                                                                          	# REGISTER 7 IS A ZERO-SOURCE, USED BY ZL.
003676,000109: 
003677,000110: 26,2022                        ARUPT              EQUALS   10                            	# INTERRUPT STORAGE.
003678,000111: 26,2022                        LRUPT              EQUALS   11                            	#
003679,000112: 26,2022                        QRUPT              EQUALS   12                            	#
003680,000113: 26,2022                        SAMPTIME           EQUALS   13                            	# SAMPLED TIME 1 & 2.
003681,000114: 26,2022                        ZRUPT              EQUALS   15                            	# (13 AND 14 ARE SPARES.)
003682,000115: 26,2022                        BANKRUPT           EQUALS   16                            	# USUALLY HOLDS FBANK OR BBANK.
003683,000116: 26,2022                        BRUPT              EQUALS   17                            	# RESUME ADDRESS AS WELL.
003684,000117: 
003685,000118: 26,2022                        CYR                EQUALS   20                            	#
003686,000119: 26,2022                        SR                 EQUALS   21                            	#
003687,000120: 26,2022                        CYL                EQUALS   22                            	#
003688,000121: 26,2022                        EDOP               EQUALS   23                            	# EDITS INTERPRETIVE OPERATION CODE PAIRS.
003689,000122: 
003690,000123: 26,2022                        TIME2              EQUALS   24                            	#
003691,000124: 26,2022                        TIME1              EQUALS   25                            	#
003692,000125: 26,2022                        TIME3              EQUALS   26                            	#
003693,000126: 26,2022                        TIME4              EQUALS   27                            	#
003694,000127: 26,2022                        TIME5              EQUALS   30                            	#
003695,000128: 26,2022                        TIME6              EQUALS   31                            	#
003696,000129: 26,2022                        CDUX               EQUALS   32                            	#
003697,000130: 26,2022                        CDUY               EQUALS   33                            	#
003698,000131: 26,2022                        CDUZ               EQUALS   34                            	#
003699,000132: 26,2022                        CDUT               EQUALS   35                            	# REND RADAR TRUNNION CDU
003700,000133: 26,2022                        CDUS               EQUALS   36                            	# REND RADAR SHAFT CDU
003701,000134: 26,2022                        PIPAX              EQUALS   37                            	#
003702,000135: 26,2022                        PIPAY              EQUALS   40                            	#
003703,000136: 26,2022                        PIPAZ              EQUALS   41                            	#
003704,000137: 26,2022                        Q-RHCCTR           EQUALS   42                            	# RHC COUNTER REGISTERS
003705,000138: 26,2022                        P-RHCCTR           EQUALS   43                            	#
003706,000139: 26,2022                        R-RHCCTR           EQUALS   44                            	#
003707,000140: 26,2022                        INLINK             EQUALS   45                            	#
003708,000141: 26,2022                        RNRAD              EQUALS   46                            	#
003709,000142: 26,2022                        GYROCMD            EQUALS   47                            	#
003710,000143: 26,2022                        CDUXCMD            EQUALS   50                            	#
003711,000144: 26,2022                        CDUYCMD            EQUALS   51                            	#
003712,000145: 26,2022                        CDUZCMD            EQUALS   52                            	#
003713,000146: 26,2022                        CDUTCMD            EQUALS   53                            	# RADAR TRUNNION COMMAND
003714,000147: 26,2022                        CDUSCMD            EQUALS   54                            	# RADAR SHAFT COMMAND
003716,000149: 26,2022                        THRUST             EQUALS   55                            	#
003717,000150: 26,2022                        LEMONM             EQUALS   56                            	#
003718,000151: 26,2022                        OUTLINK            EQUALS   57                            	#
003719,000152: 26,2022                        ALTM               EQUALS   60                            	#
003720,000153: 
003721,000154:                                                                                          	# INTERPRETIVE REGISTERS ADDRESSED RELATIVE TO VAC AREA.
003722,000155: 
003723,000156: 26,2022                        LVSQUARE           EQUALS   34D                           	# SQUARE OF VECTOR INPUT TO ABVAL AND UNIT
003724,000157: 26,2022                        LV                 EQUALS   36D                           	# LENGTH OF VECTOR INPUT TO UNIT.
003725,000158: 26,2022                        X1                 EQUALS   38D                           	# INTERPRETIVE SPECIAL REGISTERS RELATIVE
003726,000159: 26,2022                        X2                 EQUALS   39D                           	# TO THE WORK AREA.
003727,000160: 26,2022                        S1                 EQUALS   40D                           	#
003728,000161: 26,2022                        S2                 EQUALS   41D                           	#
003729,000162: 26,2022                        QPRET              EQUALS   42D                           	#
003730,000163: 

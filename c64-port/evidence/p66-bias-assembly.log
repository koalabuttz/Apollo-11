054949,000030: 
054951,000032:                                                                                          	# PROGRAM DESCRIPTION                           DATE   20 DECEMBER 1967
054952,000033:                                                                                          	# PROGRAM NAME - SELF-CHECK                     LOG SECTION  AGC BLOCK TWO SELF-CHECK
054953,000034:                                                                                          	# MOD NO - 1                                    ASSEMBLY SUBROUTINE UTILITYM REV 25
054954,000035:                                                                                          	# MOD BY - GAUNTT
054955,000036: 
054956,000037:                                                                                          	# FUNCTIONAL DESCRIPTION
054957,000038:                                                                                          	#       PROGRAM HAS TWO MAIN PARTS.  THE FIRST IS SELF-CHECK WHICH RUNS AS A ZERO PRIORITY JOB WITH NO CORE SET, AS
054958,000039:                                                                                          	#       PART OF THE BACK-UP IDLE LOOP.  THE SECOND IS SHOW-BANKSUM WHICH RUNS AS A REGULAR EXECUTIVE JOB WITH ITS OWN
054959,000040:                                                                                          	#       STARTING VERB.
054960,000041: 
054961,000042:                                                                                          	#       THE PURPOSE OF SELF-CHECK IS TO CHECK OUT VARIOUS PARTS OF THE COMPUTER AS OUTLINED BELOW IN THE OPTIONS.
054962,000043: 
054963,000044:                                                                                          	#       THE PURPOSE OF SHOW-BANKSUM IS TO DISPLAY THE SUM OF EACH BANK, ONE AT A TIME.
054964,000045: 
054965,000046:                                                                                          	#       IN ALL THERE ARE 7 POSSIBLE OPTIONS IN THIS BLOCK II VERSION OF SELF-CHECK.  MORE DETAIL DESCRIPTION MAY BE
054966,000047:                                                                                          	#       FOUND IN E-2065 BLOCK II AGC SELF-CHECK AND SHOW BANKSUM BY EDWIN D. SMALLY DECEMBER 1966, AND ADDENDA 2 AND 3.
054967,000048: 
054968,000049:                                                                                          	#       THE DIFFERENT OPTIONS ARE CONTROLLED BY PUTTING DIFFERENT NUMBERS IN THE SMODE REGISTER (NOUN 27).  BELOW IS
054969,000050:                                                                                          	#       A DESCRIPTION OF WHAT PARTS OF THE COMPUTER THAT ARE CHECKED BY THE OPTIONS, AND THE CORRESPONDING NUMBER, IN
054970,000051:                                                                                          	#       OCTAL, TO LOAD INTO SMODE.
054971,000052:                                                                                          	#               +-4             ERASABLE MEMORY
054972,000053:                                                                                          	#               +-5             FIXED MEMORY
054973,000054:                                                                                          	#               +-1,2,3,6,7,10  EVERYTHING IN OPTIONS 4 AND 5.
054974,000055:                                                                                          	#               -0              SAME AS +-10 UNTIL AN ERROR IS DETECTED.
054975,000056:                                                                                          	#               +0              NO CHECK, PUTS COMPUTER INTO THE BACKUP IDLE LOOP.
054976,000057: 
054977,000058:                                                                                          	# WARNINGS
054978,000059:                                                                                          	#       USE OF E MEMORY RESERVED FOR SELF-CHECK (EVEN IN IDLE LOOP) AS TEMP STORAGE BY OTHER PROGRAMS IS DANGEROUS.
054979,000060:                                                                                          	#       SMODE SET GREATER THAN OCT 10 PUTS COMPUTER INTO BACKUP IDLE LOOP.
054980,000061: 
054981,000062:                                                                                          	# CALLING SEQUENCE
054982,000063:                                                                                          	#       TO CALL SELF-CHECK KEY IN
054983,000064:                                                                                          	#               V 21 N 27 E     OPTION NUMBER E
054984,000065:                                                                                          	#       TO CALL SHOW-BANKSUM KEY IN
054985,000066:                                                                                          	#               V 91 E          DISPLAYS FIRST BANK
054986,000067:                                                                                          	#               V 33 E          PROCEED, DISPLAYS NEXT BANK
054987,000068: 
054988,000069:                                                                                          	# EXIT MODES, NORMAL AND ALARM
054989,000070:                                                                                          	#       SELF-CHECK NORMALLY CONTINUES INDEFINITELY UNLESS THERE IS AN ERROR DETECTED.  IF SO + OPTION NUMBERS PUT
054990,000071:                                                                                          	#       COMPUTER INTO BACKUP IDLE LOOP, - OPTION NUMBERS RESTART THE OPTION.
054991,000072: 
054992,000073:                                                                                          	#       THE -0 OPTION PROCEEDS FROM THE LINE FOLLOWING THE LINE WHERE THE ERROR WAS DETECTED.
054993,000074: 
054994,000075:                                                                                          	#       SHOW-BANKSUM PROCEEDS UNTIL A TERMINATE IS KEYED IN (V 34 E).  THE COMPUTER IS PUT INTO THE BACKUP IDLE LOOP
054995,000076: 
054996,000077:                                                                                          	# OUTPUT
054998,000079:                                                                                          	#       SELF-CHECK UPON DETECTING AN ERROR LOADS THE SELF-CHECK ALARM CONSTANT (01102) INTO THE FAILREG SET AND
054999,000080:                                                                                          	#       TURNS ON THE ALARM LIGHT.  THE OPERATOR MAY THEN DISPLAY THE THREE FAILREGS BY KEYING IN V 05 N 09 E.  FOR FURTHER
055000,000081:                                                                                          	#       INFORMATION HE MAY KEY IN V 05 N 08 E, THE DSKY DISPLAY IN R1 WILL BE ADDRESS+1 OF WHERE THE ERROR WAS DETECTED,
055001,000082:                                                                                          	#       IN R2 THE BBCON OF SELF-CHECK, AND IN R3 THE TOTAL NUMBER OF ERRORS DETECTED BY SELF-CHECK SINCE THE LAST MAN
055002,000083:                                                                                          	#       INITIATED FRESH START (SLAP1).
055003,000084: 
055004,000085:                                                                                          	#       SHOW-BANKSUM STARTING WITH BANK 0 DISPLAYS IN R1 THE BANK SUM (A +-NUMBER EQUAL TO THE BANK NUMBER), IN R2
055005,000086:                                                                                          	#       THE BANK NUMBER, AND IN R3 THE BUGGER WORD.
055006,000087: 
055007,000088:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
055008,000089:                                                                                          	#       ACCOMPLISHED BY FRESH START
055009,000090:                                                                                          	#               SMODE SET TO +0
055010,000091: 
055011,000092:                                                                                          	# DEBRIS
055012,000093:                                                                                          	#       ALL EXITS FROM THE CHECK OF ERASABLE (ERASCHK) RESTORE ORIGINAL CONTENTS TO REGISTERS UNDER CHECK.
055013,000094:                                                                                          	#       EXCEPTION IS A RESTART.  RESTART THAT OCCURS DURING ERASCHK RESTORES ERASABLE, UNLESS THERE IS EVIDENCE TO DOUBT
055014,000095:                                                                                          	#       E MEMORY, IN WHICH CASE PROGRAM THEN DOES A FRESH START (DOFSTART).
055015,000096: 
055016,000097: 25,3770                                           BANK     25                            	#
055017,000098: 43,2000                                           SETLOC   SELFCHEC                      	#
055018,000099: 43,2000                                           BANK                                   	#

006845,000507:                                                                                          	# PROGRAM NAME:  C33TEST
006846,000508: 
006847,000509:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM MONITORS THREE FLIP-FLOP INBITS OF CHANNEL 33 AND CALLS THE APPROPRIATE
006848,000510:                                                                                          	# SUBROUTINE TO PROCESS A CHANGE.  IT IS ANALOGOUS TO IMUMON, WHICH MONITORS CHANNEL 30, EXCEPT THAT IT READS
006849,000511:                                                                                          	# CHANNEL 33 WITH A WAND INSTRUCTION BECAUSE A 'WRITE' PULSE IS REQUIRED TO RESET THE FLIP-FLOPS.  THE BITS
006850,000512:                                                                                          	# PROCESSED AND THE SUBROUTINES CALLED ARE:
006851,000513:                                                                                          	#       BIT     FUNCTION                SUBROUTINE
006852,000514:                                                                                          	#       ---     --------                ----------
006853,000515:                                                                                          	#        13     PIPA FAIL               PIPFAIL
006854,000516:                                                                                          	#        12     DOWNLINK TOO FAST       DNTMFAST
006855,000517:                                                                                          	#        11     UPLINK TOO FAST         UPTMFAST
006856,000518: 
006857,000519:                                                                                          	# UPON ENTRY TO THE SUBROUTINE, THE NEW BIT STATE IS IN A.
006858,000520: 
006859,000521:                                                                                          	# CALLING SEQUENCE:  EVERY 480 MILLISECONDS AFTER TNONTEST.
006860,000522: 
006861,000523:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
006862,000524: 
006863,000525:                                                                                          	# SUBROUTINES CALLED:  PIPFAIL, DNTMFAST AND UPTMFAST ON BIT CHANGES.
006864,000526: 
006865,000527:                                                                                          	# ERASABLE INITIALIZATION:  C(IMODES33) = OCT 16000 ON A FRESH START OR RESTART, THEREFORE, THESE ALARMS WILL
006866,000528:                                                                                          	# REAPPEAR IF THE CONDITIONS PERSIST.
006867,000529: 
006868,000530:                                                                                          	# ALARMS:  NONE.
006869,000531: 
006870,000532:                                                                                          	# EXIT:  GLOCKMON.
006871,000533: 
006872,000534:                                                                                          	# OUTPUT:  UPDATED BITS 13, 12 AND 11 OF IMODES33 WITH CHANGES PROCESSED.
006873,000535: 
006874,000536: 06,2374           31303        C33TEST            CA       IMODES33                      	# SEE IF RELEVANT CHAN33 BITS HAVE
006875,000537: 06,2375           75026                           MASK     33RDMSK                       	#
006876,000538: 06,2376           54001                           TS       L                             	# CHANGED.
006877,000539: 06,2377           35026                           CAF      33RDMSK                       	#
006878,000540: 06,2400           00006                           EXTEND                                 	#
006879,000541: 06,2401           03033                           WAND     CHAN33                        	# RESETS FLIP-FLOP INPUTS
006880,000542: 06,2402           00006                           EXTEND                                 	#
006881,000543: 06,2403           06001                           RXOR     LCHAN                         	#
006882,000544: 06,2404           00006                           EXTEND                                 	#
006883,000545: 06,2405           12434                           BZF      GLOCKMON                      	# ON NO CHANGE.
006884,000546: 
006885,000547: 06,2406           54070                           TS       RUPTREG1                      	# SAVE BITS WHICH HAVE CHANGED.
006886,000548: 06,2407           23303                           LXCH     IMODES33                      	#
006887,000549: 06,2410           00006                           EXTEND                                 	#
006888,000550: 06,2411           06001                           RXOR     LCHAN                         	#
006889,000551: 06,2412           55303                           TS       IMODES33                      	# UPDATED IMODES33.
006890,000552: 
006891,000553: 06,2413           34755                           CAF      ZERO                          	#
006892,000554: 06,2414           56070                           XCH      RUPTREG1                      	#
006893,000555: 06,2415           60000                           DOUBLE                                 	#
006895,000557: 06,2416           12421                           TCF      NXTIBT     +1                 	# SCAN FOR BIT CHANGES.
006896,000558: 
006897,000559: 06,2417           64753                 -1        AD       ONE                           	#
006898,000560: 06,2420           24070        NXTIBT             INCR     RUPTREG1                      	#
006899,000561: 06,2421           60000                 +1        DOUBLE                                 	#
006900,000562: 06,2422           54000                           TS       A                             	# (CODING IDENTICAL TO CHAN 30).
006901,000563: 06,2423           12420                           TCF      NXTIBT                        	#
006902,000564: 
006903,000565: 06,2424           56071                           XCH      RUPTREG2                      	#
006904,000566: 06,2425           50070                           INDEX    RUPTREG1                      	# GET NEW VALUE OF BIT WHICH CHANGED.
006905,000567: 06,2426           34737                           CAF      BIT13                         	#
006906,000568: 06,2427           71303                           MASK     IMODES33                      	#
006907,000569: 06,2430           50070                           INDEX    RUPTREG1                      	#
006908,000570: 06,2431           02763                           TC       C33JMP                        	#
006909,000571: 06,2432           10071        NXTFL33            CCS      RUPTREG2                      	# PROCESS POSSIBLE ADDITIONAL CHANGES.
006910,000572: 06,2433           12417                           TCF      NXTIBT     -1                 	#
006911,000573: 
006913,000575:                                                                                          	# PROGRAM NAME:  GLOCKMON
006914,000576: 
006915,000577:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM MONITORS THE CDUZ COUNTER TO DETERMINE WHETHER THE ISS IS IN GIMBAL LOCK
006916,000578:                                                                                          	# AND TAKES ACTION IF IT IS.  THREE REGIONS OF MIDDLE GIMBAL ANGLE (MGA) ARE USED:
006917,000579: 
006918,000580:                                                                                          	#       1) ABS(MGA) LESS THAN OR EQUAL TO 70 DEGREES - NORMAL MODE.
006919,000581:                                                                                          	#       2) ABS(MGA) GREATER THAN 70 DEGREES AND LESS THAN OR EQUAL TO 85 DEGREES - GIMBAL LOCK LAMP TURNED ON.
006920,000582:                                                                                          	#       3) ABS(MGA) GREATER THAN 85 DEGREES - ISS PUT IN COARSE ALIGN AND NO ATT LAMP TURNED ON.
006921,000583: 
006922,000584:                                                                                          	# CALLING SEQUENCE:  EVERY 480 MILLISECONDS AFTER C33TEST.
006923,000585: 
006924,000586:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
006925,000587: 
006926,000588:                                                                                          	# SUBROUTINES CALLED:   1) SETCOARS WHEN ABS(MGA) GREATER THAN 85 DEGREES AND ISS NOT IN COARSE ALIGN.
006927,000589:                                                                                          	#                       2) LAMPTEST BEFORE TURNING OFF GIMBAL LOCK LAMP.
006928,000590: 
006929,000591:                                                                                          	# ERASABLE INITIALIZATION:
006930,000592:                                                                                          	#               1) FRESH START OR RESTART WITH NO GROUPS ACTIVE:  C(CDUZ) = 0, IMODES30 BIT 6 = 0, IMODES33 BIT 1 =  0.
006931,000593:                                                                                          	#               2) RESTART WITH GROUPS ACTIVE:  SAME AS FRESH START EXCEPT C(CDUZ) NOT CHANGED SO GIMBAL MONITOR
006932,000594:                                                                                          	#                                               PROCEEDS AS BEFORE.
006933,000595: 

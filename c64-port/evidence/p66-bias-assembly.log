014236,000030:                                                                                          	##
014237,000031:                                                                                          	## Notations on the hardcopy document read, in part:
014238,000032:                                                                                          	##
014239,000033:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
014240,000034:                                                                                          	##      16:27 JULY 14, 1969 
014241,000035: 
014243,000037:                                                                                          	# BLOCK 2 LGC ATTITUDE MANEUVER ROUTINE - KALCMANU
014244,000038: 
014245,000039:                                                                                          	# MOD 2         DATE 5/1/67     BY DON KEENE
014246,000040: 
014247,000041:                                                                                          	# PROGRAM DESCRIPTION
014248,000042: 
014249,000043:                                                                                          	#      KALCMANU IS A ROUTINE WHICH GENERATES COMMANDS FOR THE LM DAP TO CHANGE THE ATTITUDE OF THE SPACECRAFT
014250,000044:                                                                                          	# DURING FREE FALL.  IT IS DESIGNED TO MANEUVER THE SPACECRAFT FROM ITS INITIAL ORIENTATION TO SOME DESIRED
014251,000045:                                                                                          	# ORIENTATION SPECIFIED BY THE PROGRAM WHICH CALLS KALCMANU, AVOIDING GIMBAL LOCK IN THE PROCESS.  IN THE 
014252,000046:                                                                                          	# MOD 2 VERSION, THIS DESIRED ATTITUDE IS SPECIFIED BY A SET OF THREE COMMANDED CDU ANGLES STORED AS 2S COMPLEMENT
014253,000047:                                                                                          	# SINGLE PRECISION ANGLES IN THE THREE CONSECUTIVE LOCATIONS, CPHI, CTHETA, CPSI, WHERE
014254,000048: 
014255,000049:                                                                                          	#       CPHI = COMMANDED OUTER GIMBAL ANGLE
014256,000050:                                                                                          	#       CTHETA = COMMANDED INNER GIMBAL ANGLE
014257,000051:                                                                                          	#       CPSI = COMMANDED MIDDLE GIMBAL ANGLE
014258,000052: 
014259,000053:                                                                                          	#     WHEN POINTING A SPACECRAFT AXIS (E.I. X, Y, Z, THE AOT, THRUST AXIS, ETC) THE SUBROUTINE VECPOINT MAY BE
014260,000054:                                                                                          	# USED TO GENERATE THIS SET OF DESIRED CDU ANGLES (SEE DESCRIPTION IN R60)   -
014261,000055:                                                                                          	#  WITH THIS INFORMATION KALCMANU DETERMINES THE DIRECTION OF THE SINGLE EQUIVALENT ROTATION (COF ALSO U) AND THE
014262,000056:                                                                                          	# MAGNITUDE OF THE ROTATION (AM) TO BRING THE S/C FROM ITS INITIAL ORIENTATION TO ITS FINAL ORIENTATION.
014263,000057:                                                                                          	# THIS DIRECTION REMAINS FIXED BOTH IN INERTIAL COORDINATES AND IN COMMANDED S/C AXES THROUGHOUT THE 
014264,000058:                                                                                          	#                  -
014265,000059:                                                                                          	# MANEUVER.  ONCE COF AND AM HAVE BEEN DETERMINED, KALCMANU THEN EXAMINES THE MANEUVER TO SEE IF IT WILL BRING
014266,000060:                                                                                          	#                                      -
014267,000061:                                                                                          	# THE S/C THROUGH GIMBAL LOCK.  IF SO, COF AND AM ARE READJUSTED SO THAT THE S/C WILL JUST SKIM THE GIMBAL
014268,000062:                                                                                          	# LOCK ZONE AND ALIGN THE X-AXIS.  IN GENERAL A FINAL YAW ABOUT X WILL BE NECESSARY TO COMPLETE THE MANEUVER.
014269,000063:                                                                                          	# NEEDLESS TO SAY, NEITHER THE INITIAL NOR THE FINAL ORIENTATION CAN BE IN GIMBAL LOCK.
014270,000064: 
014271,000065:                                                                                          	#      FOR PROPER ATTITUDE CONTROL THE DIGITAL AUTOPILOT MUST BE GIVEN AN ATTITUDE REFERENCE WHICH IT CAN TRACK.
014272,000066:                                                                                          	# KALCMANU DOES THIS BY GENERATING A REFERENCE OF DESIRED GIMBAL ANGLES (CDUXD, CDUYD, CDUZD) WHICH ARE UPDATED
014273,000067:                                                                                          	# EVERY ONE SECOND DURING THE MANEUVER.  TO ACHIEVE A SMOOTHER SEQUENCE OF COMMANDS BETWEEN SUCCESSIVE UPDATES,
014274,000068:                                                                                          	# THE PROGRAM ALSO GENERATES A SET OF INCREMENTAL CDU ANGLES (DELDCDU) TO BE ADDED TO CDU DESIRED BY THE DIGITAL
014275,000069:                                                                                          	# AUTOPILOT.  KALCMANU ALSO CALCULATES THE COMPONENT MANEUVER RATES (OMEGAPD, OMEGAQD, OMEGARD), WHICH CAN
014276,000070:                                                                                          	#                                     -
014277,000071:                                                                                          	# BE DETERMINED SIMPLY BY MULTIPLYING COF BY SOME SCALAR (ARATE) CORRESPONDING TO THE DESIRED ROTATIONAL RATE.
014278,000072: 
014279,000073:                                                                                          	#      AUTOMATIC MANEUVERS ARE TIMED WITH THE HELP OF WAITLIST SO THAT AFTER A SPECIFIED INTERVAL THE Y AND Z
014280,000074:                                                                                          	# DESIRED RATES ARE SET TO ZERO AND THE DESIRED CDU ANGLES (CDUYD, CDUZD) ARE SET EQUAL TO THE FINAL DESIRED CDU
014281,000075:                                                                                          	# ANGLES (CTHETA, CPSI).  IF ANY YAW REMAINS DUE TO GIMBAL LOCK AVOIDANCE, THE FINAL YAW MANEUVER IS
014282,000076:                                                                                          	# CALCULATED AND THE DESIRED YAW RATE SET TO SOME FIXED VALUE (ROLLRATE = + OR - 2 DEGREES PER SEC).
014283,000077:                                                                                          	# IN THIS CASE ONLY AN INCREMENTAL CDUX ANGLE (DELFROLL) IS SUPPLIED TO THE DAP.  AT THE END OF THE YAW
014284,000078:                                                                                          	# MANEUVER OR IN THE EVENT THAT THERE WAS NO FINAL YAW, CDUXD IS SET EQUAL TO CPHI AND THE X-AXIS DESIRED
014285,000079:                                                                                          	# RATE SET TO ZERO.  THUS, UPON COMPLETION OF THE MANEUVER THE S/C WILL FINISH UP IN A LIMIT CYCLE ABOUT THE
014286,000080:                                                                                          	# DESIRED FINAL GIMBAL ANGLES.
014287,000081: 
014288,000082:                                                                                          	# PROGRAM LOGIC FLOW
014289,000083: 
014290,000084:                                                                                          	#      KALCMANU IS CALLED AS A HIGH PRIORITY JOB WITH ENTRY POINTS AT KALCMAN3 AND VECPOINT.  IT FIRST PICKS
014291,000085:                                                                                          	# UP THE CURRENT CDU ANGLES TO BE USED AS THE BASIS FOR ALL COMPUTATIONS INVOLVING THE INITIAL S/C ORIENTATION.
014293,000087:                                                                                          	# IT THEN DETERMINES THE DIRECTION COSINE MATRICES RELATING BOTH THE INITIAL AND FINAL S/C ORIENTATION TO STABLE
014294,000088:                                                                                          	#               *   *                                                                               *
014295,000089:                                                                                          	# MEMBER AXES (MIS,MFS).  IT ALSO COMPUTES THE MATRIX RELATING FINAL S/C AXES TO INITIAL S/C AXES (MFI).  THE
014296,000090:                                                                                          	# ANGLE OF ROTATION (AM) IS THEN EXTRACTED FROM THIS MATRIX, AND TESTS ARE MADE TO DETERMINE IF
014297,000091: 
014298,000092:                                                                                          	#       A)      AM LESS THAN .25 DEGREES (MINANG)
014299,000093:                                                                                          	#       B)      AM GREATER THAN 170 DEGREES (MAXANG)
014300,000094: 
014301,000095:                                                                                          	# IF AM LESS THAN .25 DEGREES, NO COMPLICATED AUTOMATIC MANEUVERING IS NECESSARY.  THEREFORE WE CAN SIMPLY
014302,000096:                                                                                          	# SET CDU DESIRED EQUAL TO THE FINAL CDU DESIRED ANGLES AND TERMINATE THE JOB.
014303,000097: 
014304,000098:                                                                                          	# IF AM IS GREATER THAN .25 DEGREES BUT LESS THAN 170 DEGREES, THE AXES OF THE SINGLE EQUIVALENT ROTATION
014305,000099:                                                                                          	#   -                                                       *
014306,000100:                                                                                          	# (COF) IS EXTRACTED FROM THE SKEW SYMMETRIC COMPONENTS OF MFI.                       *     *
014307,000101:                                                                                          	# IF AM GREATER THAN 170 DEGREES AN ALTERNATE METHOD EMPLOYING THE SYMMETRIC PART OF MFI (MFISYM) IS USED
014308,000102:                                                                                          	#               -
014309,000103:                                                                                          	# TO DETERMINE COF.
014310,000104: 
014311,000105:                                                                                          	# THE PROGRAM THEN CHECKS TO SEE IF THE MANEUVER AS COMPUTED WILL BRING THE S/C THROUGH GIMBAL LOCK.  IF
014312,000106:                                                                                          	# SO, A NEW MANEUVER IS CALCULATED WHICH WILL JUST SKIM THE GIMBAL LOCK ZONE AND ALIGN THE S/C X-AXIS.  THIS
014313,000107:                                                                                          	# METHOD ASSURES THAT THE ADDITIONAL MANEUVERING TO AVOID GIMBAL LOCK WILL BE KEPT TO A MINIMUM.  SINCE A FINAL
014314,000108:                                                                                          	# P AXIS YAW WILL BE NECESSARY, A SWITCH IS RESET (STATE SWITCH 31) TO ALLOW FOR THE COMPUTATION OF THIS FINAL
014315,000109:                                                                                          	# YAW.
014316,000110: 
014317,000111:                                                                                          	# AS STATED PREVIOUSLY KALCMANU GENERATES A SEQUENCE OF DESIRED GIMBAL ANGLES WHICH ARE UPDATED EVERY 
014318,000112:                                                                                          	#                                                                                              -
014319,000113:                                                                                          	# SECOND.  THIS IS ACCOMPLISHED BY A SMALL ROTATION OF THE DESIRED S/C FRAME ABOUT THE VECTOR COF.  THE NEW
014320,000114:                                                                                          	# DESIRED REFERENCE MATRIX IS THEN,
014321,000115:                                                                                          	#        *               *       *
014322,000116:                                                                                          	#       MIS     =       MIS     DEL
014323,000117:                                                                                          	#          N+1             N
014324,000118:                                                                                          	#        *
014325,000119:                                                                                          	# WHERE DEL IS THE MATRIX CORRESPONDING TO THIS SMALL ROTATION.  THE NEW CDU ANGLES CAN THEN BE EXTRACTED
014326,000120:                                                                                          	#       *
014327,000121:                                                                                          	# FROM MIS.
014328,000122: 
014329,000123:                                                                                          	# AT THE BEGINNING OF THE MANEUVER THE AUTOPILOT DESIRED RATES (OMEGAPD, OMEGAQD, OMEGARD) AND THE 
014330,000124:                                                                                          	# MANEUVER TIMINGS ARE ESTABLISHED.  ON THE FIRST PASS AND ON ALL SUBSEQUENT UPDATES THE CDU DESIRED
014331,000125:                                                                                          	# ANGLES ARE LOADED WITH THE APPROPRIATE VALUES AND THE INCREMENTAL CDU ANGLES ARE COMPUTED.  THE AGC CLOCKS
014332,000126:                                                                                          	# (TIME1 AND TIME2) ARE THAN CHECKED TO SEE IF THE MANEUVER WILL TERMINATE BEFORE THE NEXT UPDATE.  IF
014333,000127:                                                                                          	# NOT, KALCMANU CALLS FOR ANOTHER UPDATE (RUN AS A JOB WITH PRIORITY TBD) IN ONE SECOND.  ANY DELAYS IN THIS
014334,000128:                                                                                          	# CALLING SEQUENCE ARE AUTOMATICALLY COMPENSATED IN CALLING FOR THE NEXT UPDATE.
014335,000129: 
014336,000130:                                                                                          	# IF IT IS FOUND THAT THE MANEUVER IS TO TERMINATE BEFORE THE NEXT UPDATE A ROUTINE IS CALLED (AS A WAIT-
014337,000131:                                                                                          	# LIST TASK) TO STOP THE MANEUVER AT THE APPROPRIATE TIME AS EXPLAINED ABOVE.
014338,000132: 
014340,000134:                                                                                          	# CALLING SEQUENCE
014341,000135: 
014342,000136:                                                                                          	# IN ORDER TO PERFORM A KALCMANU SUPERVISED MANEUVER, THE COMMANDED GIMBAL ANGLES MUST BE PRECOMPUTED AND
014343,000137:                                                                                          	# STORED IN LOCATIONS CPHI, CTHETA, CPSI.  THE USER:S PROGRAM MUST THEN CLEAR STATE SWITCH NO 33 TO ALLOW THE 
014344,000138:                                                                                          	# ATTITUDE MANEUVER ROUTINE TO PERFORM ANY FINAL P-AXIS YAW INCURRED BY AVOIDING GIMBAL LOCK.  THE MANEUVER IS
014345,000139:                                                                                          	# THEN INITIATED BY ESTABLISHING THE FOLLOWING EXECUTIVE JOB
014346,000140:                                                                                          	#                      *
014347,000141:                                                                                          	#       CAF     PRIO XX
014348,000142:                                                                                          	#                    --
014349,000143:                                                                                          	#       INHINT
014350,000144:                                                                                          	#       TC      FINDVAC
014351,000145:                                                                                          	#       2CADR   KALCMAN3
014352,000146:                                                                                          	#       RELINT
014353,000147: 
014354,000148:                                                                                          	# THE USER:S PROGRAM MAY EITHER CONTINUE OR WAIT FOR THE TERMINATION OF THE MANEUVER.  IF THE USER WISHES TO
014355,000149:                                                                                          	# WAIT, HE MAY PUT HIS JOB TO SLEEP WITH THE FOLLOWING INSTRUCTIONS
014356,000150: 
014357,000151:                                                                                          	#       L       TC      BANKCALL
014358,000152:                                                                                          	#       L+1     CADR    ATTSTALL
014359,000153:                                                                                          	#       L+2     (BAD RETURN)
014360,000154:                                                                                          	#       L+3     (GOOD RETURN)
014361,000155: 
014362,000156:                                                                                          	# UPON COMPLETION OF THE MANEUVER, THE PROGRAM WILL BE AWAKENED AT L+3 IF THE MANEUVER WAS COMPLETED
014363,000157:                                                                                          	# SUCCESSFULLY, OR AT L+2 IF THE MANEUVER WAS ABORTED.  THIS ABORT WOULD OCCUR IF THE INITIAL OR FINAL ATTITUDE
014364,000158:                                                                                          	# WAS IN GIMBAL LOCK.
014365,000159: 
014366,000160:                                                                                          	# *** NOTA BENE ***  IT IS ASSUMED THAT THE DESIRED MANEUVERING RATE (0.5, 2, 5, 10, DEG/SEC) HAS BEEN SELECTED BY
014367,000161:                                                                                          	# KEYBOARD ENTRY PRIOR TO THE EXECUTION OF KALCMANU.
014368,000162:                                                                                          	# IT IS ALSO ASSUMED THAT THE AUTOPILOT IS IN THE AUTO MODE.  IF THE MODE SWITCH IS CHANGED DURING THE
014369,000163:                                                                                          	# MANEUVER, KALCMANU WILL TERMINATE VIA GOODEND WITHIN 1 SECOND SO THAT R60 MAY REQUEST A TRIM OF THE S/C ATTITUDE
014370,000164:                                                                                          	# THIS IS THE ONLY MEANS FOR MANUALLY TERMINATING A KALCMANU SUPERVISED MANEUVER.
014371,000165:                                                                                          	# SUBROUTINES
014372,000166: 
014373,000167:                                                                                          	# KALCMANU USES A NUMBER OF INTERPRETIVE SUBROUTINES WHICH MAY BE OF GENERAL INTEREST.  SINCE THESE ROUTINES
014374,000168:                                                                                          	# WERE PROGRAMMED EXCLUSIVELY FOR KALCMANU, THEY ARE NOT, AS YET, GENERALLY AVAILABLE FOR USE BY OTHER PROGRAMS.
014375,000169: 
014376,000170:                                                                                          	# MXM3
014377,000171:                                                                                          	# ----
014378,000172: 
014379,000173:                                                                                          	# THIS SUBROUTINE MULTIPLIES TWO 3X3 MATRICES AND LEAVES THE RESULT IN THE FIRST 18 LOCATIONS OF THE PUSH
014380,000174:                                                                                          	# DOWN LIST, I.E.,
014381,000175:                                                                                          	#                       ( M     M     M  )
014382,000176:                                                                                          	#                       (  0     1     2 )
014383,000177:                                                                                          	#       *               (                )              *               *
014384,000178:                                                                                          	#       M       =       ( M     M     M  )      =       M1      X       M2
014385,000179:                                                                                          	#                       (  3     4     5 )
014386,000180:                                                                                          	#                       (                )
014387,000181:                                                                                          	#                       ( M     M     M  )
014389,000183:                                                                                          	#                       (  6     7     8 )
014390,000184:                                                                                          	#                                                                                  *
014391,000185:                                                                                          	# INDEX REGISTER X1 MUST BE LOADED WITH THE COMPLEMENT OF THE STARTING ADDRESS FOR M1, AND X2 MUST BE
014392,000186:                                                                                          	#                                                        *
014393,000187:                                                                                          	# LOADED WITH THE COMPLEMENT OF THE STARTING ADDRESS FOR M2.  THE ROUTINE USES THE FIRST 20 LOCATIONS OF THE PUSH
014394,000188:                                                                                          	# DOWN LIST.  THE FIRST ELEMENT OF THE MATRIX APPEARS IN PDO.  PUSH UP FOR M .
014395,000189:                                                                                          	#                                                                           8
014396,000190:                                                                                          	# TRANSPOS
014397,000191:                                                                                          	# --------
014398,000192: 
014399,000193:                                                                                          	# THIS ROUTINE TRANSPOSES A 3X3 MATRIX AND LEAVES THE RESULT IN THE PUSH DOWN LIST, I.E.,
014400,000194:                                                                                          	# 
014401,000195:                                                                                          	#       *               * T
014402,000196:                                                                                          	#       M       =       M1
014403,000197: 
014404,000198:                                                                                          	# INDEX REGISTER X1 MUST CONTAIN THE COMPLEMENT OF THE STARTING ADDRESS FOR M1.  PUSH UP FOR THE FIRST AND SUB-
014405,000199:                                                                                          	#                        *
014406,000200:                                                                                          	# SEQUENT COMPONENTS OF M.  THIS SUBROUTINE ALSO USES THE FIRST 20 LOCATIONS OF THE PUSH DOWN LIST.
014407,000201: 
014408,000202:                                                                                          	# CDU TO DCM
014409,000203:                                                                                          	# ----------
014410,000204: 
014411,000205:                                                                                          	# THIS SUBROUTINE CONVERTS THREE CDU ANGLES IN T(MPAC) TO A DIRECTION COSINE MATRIX (SCALED BY 2) RELATING
014412,000206:                                                                                          	# THE CORRESPONDING S/C ORIENTATIONS TO THE STABLE MEMBER FRAME.  THE FORMULAS FOR THIS CONVERSION ARE
014413,000207: 
014414,000208:                                                                                          	#       M       =       COSY COSZ
014415,000209:                                                                                          	#        0
014416,000210: 
014417,000211:                                                                                          	#       M       =       -COSY SINZ COSX + SINY SINX
014418,000212:                                                                                          	#        1
014419,000213: 
014420,000214:                                                                                          	#       M       =       COSY SINZ SINX + SINY COSX
014421,000215:                                                                                          	#        2
014422,000216: 
014423,000217:                                                                                          	#       M       =       SINZ
014424,000218:                                                                                          	#        3
014425,000219: 
014426,000220:                                                                                          	#       M       =       COSZ COSX
014427,000221:                                                                                          	#        4
014428,000222: 
014429,000223:                                                                                          	#       M       =       -COSZ SINX
014430,000224:                                                                                          	#        5
014431,000225: 
014432,000226:                                                                                          	#       M       =       -SINY COSZ
014433,000227:                                                                                          	#        6
014434,000228:                                                                                          	#       
014435,000229:                                                                                          	#       M       =       SINY SINZ COSX + COSY SINX
014436,000230:                                                                                          	#        7
014438,000232:                                                                                          	#       M       =       -SINY SINZ SINX + COSY COSX
014439,000233:                                                                                          	#        8
014440,000234: 
014441,000235:                                                                                          	# WHERE         X       =       OUTER GIMBAL ANGLE
014442,000236:                                                                                          	#               Y       =       INNER GIMBAL ANGLE
014443,000237:                                                                                          	#               Z       =       MIDDLE GIMBAL ANGLE
014444,000238: 
014445,000239:                                                                                          	# THE INTERPRETATION OF THIS MATRIX IS AS FOLLOWS
014446,000240: 
014447,000241:                                                                                          	# IF A , A , A  REPRESENT THE COMPONENTS OF A VECTOR IN S/C AXES THEN THE COMPONENTS OF THE SAME VECTOR IN
014448,000242:                                                                                          	#     X   Y   Z
014449,000243:                                                                                          	# STABLE MEMBER AXES (B , B , B ) ARE
014450,000244:                                                                                          	#                      X   Y   Z
014451,000245: 
014452,000246:                                                                                          	#       ( B  )                  ( A  )
014453,000247:                                                                                          	#       (  X )                  (  X )
014454,000248:                                                                                          	#       (    )                  (    )
014455,000249:                                                                                          	#       (    )            *     (    )
014456,000250:                                                                                          	#       ( B  )     =      M     ( A  )
014457,000251:                                                                                          	#       (  Y )                  (  Y )
014458,000252:                                                                                          	#       (    )                  (    )
014459,000253:                                                                                          	#       ( B  )                  ( A  )
014460,000254:                                                                                          	#       (  Z )                  (  Z )
014461,000255: 
014462,000256:                                                                                          	# THE SUBROUTINE WILL STORE THIS MATRIX IN SEQUENTIAL LOCATIONS OF ERASABLE MEMORY AS SPECIFIED BY THE CALLING
014463,000257:                                                                                          	#                                                                                                             *
014464,000258:                                                                                          	# PROGRAM.  TO DO THIS THE CALLING PROGRAM MUST FIRST LOAD X2 WITH THE COMPLEMENT OF THE STARTING ADDRESS FOR M.
014465,000259: 
014466,000260:                                                                                          	# INTERNALLY, THE ROUTINE USES THE FIRST 16 LOCATIONS OF THE PUSH DOWN LIST, ALSO STEP REGISTER S1 AND INDEX
014467,000261:                                                                                          	# REGISTER X2.
014468,000262: 
014469,000263:                                                                                          	# DCM TO CDU
014470,000264:                                                                                          	# ----------
014471,000265:                                                                                          	#                                                                      *
014472,000266:                                                                                          	# THIS ROUTINE EXTRACTS THE CDU ANGLES FROM A DIRECTION COSINE MATRIX (M SCALED BY 2) RELATING S/C AXIS TO
014473,000267:                                                                                          	#                                                                                 *
014474,000268:                                                                                          	# STABLE MEMBER AXES.  X1 MUST CONTAIN THE COMPLEMENT OF THE STARTING ADDRESS FOR M.  THE SUBROUTINE LEAVES THE
014475,000269:                                                                                          	# CORRESPONDING GIMBAL ANGLES IN V(MPAC) AS DOUBLE PRECISION 1:S COMPLEMENT ANGLES SCALED BY 2PI.  THE FORMULAS
014476,000270:                                                                                          	# FOR THIS CONVERSION ARE
014477,000271: 
014478,000272:                                                                                          	#       Z       =       ARCSIN (M  )
014479,000273:                                                                                          	#                                3
014480,000274: 
014481,000275:                                                                                          	#       Y       =       ARCSIN (-M /COSZ)
014482,000276:                                                                                          	#                                 6
014483,000277: 
014484,000278:                                                                                          	# IF M  IS NEGATIVE, Y IS REPLACED BY PI SGN Y - Y
014485,000279:                                                                                          	#     0
014487,000281:                                                                                          	#       X       =       ARCSIN (-M /COSZ)
014488,000282:                                                                                          	#                                 5
014489,000283: 

030938,000338:                                                                                          	# MOD NO: 0                                                             DATE: 16 FEB 67
030939,000339:                                                                                          	# MOD BY: RR BAIRNSFATHER                                               LOG SECTION: R32
030940,000340:                                                                                          	# MOD NO: 1     MOD BY: RR BAIRNSFATHER         DATE: 11 APR 67         SR30.1 CHANGED TO ALLOW MONITOR OPERN
030941,000341:                                                                                          	# MOD NO: 2     MOD BY: RR BAIRNSFATHER         DATE: 14 APR 67         ADD OVFL CK FOR RAPO
030942,000342:                                                                                          	# MOD NO: 3     MOD BY ALONSO                   DATE: 11 DEC 67         SUBROUTINE REWRITTEN
030943,000343:                                                                                          	# MOD NO: 4     MOD BY ALONSO                   DATE: 26 MAR 68         PROG MOD TO HANDLE DIF EARTH/MOON SCALE
030944,000344:                                                                                          	# MOD NO: 5     MOD BY: RR BAIRNSFATHER         DATE: 6 AUG 68          OVFL CK FOR HAPO & HPER. VOIDS MOD #2.
030945,000345: 
030946,000346:                                                                                          	# NEW FUNCTIONAL DESCRIPTION:  ORBITAL PARAMETERS DISPLAY FOR NOUNS 32 AND 44.
030947,000347:                                                                                          	# SR30.1 CALLS TFFCONMU AND TFFRP/RA TO CALCULATE RPER (PERIGEE RADIUS),
030948,000348:                                                                                          	# RAPO (APOGEE RADIUS), HPER (PERIGEE HEIGHT ABOVE LAUNCH PAD OR LUNAR
030949,000349:                                                                                          	# LANDING SITE), HAPO (APOGEE HEIGHT AS ABOVE), TPER (TIME TO PERIGEE),
030950,000350:                                                                                          	# TFF (TIME TO INTERSECT 300 KFT ABOVE PAD OR 35KFT ABOVE LANDING SITE).
030951,000351:                                                                                          	# IF HPER IS GREATER THAN OR EQUAL TO HPERMIN, CALCULATES TPER AND STORES
030952,000352:                                                                                          	# NEGATIVE IN -TPER.  OTHERWISE STORES +0 IN -TPER.  WHENEVER TPER IS
030953,000353:                                                                                          	# CALCULATED, TFF IS NOT COMPUTABLE AND DEFAULTS TO -59MIN 59SEC.  IF HAPO
030954,000354:                                                                                          	# WOULD EXCEED 9999.9 NM, IT IS LIMITED TO THAT VALUE FOR DISPLAY.
030955,000355: 
030956,000356:                                                                                          	# ADDENDUM:     HAPO AND HPER SHOULD BE CHANGED TO READ HAPOX AND HPERX IN THE
030957,000357:                                                                                          	#               ABOVE REMARKS.
030958,000358: 
030959,000359:                                                                                          	# CALLING SEQUENCE:     CALL
030960,000360:                                                                                          	#                               SR30.1
030961,000361: 
030962,000362:                                                                                          	# SUBROUTINES CALLED:   TFFCONMU, TFFRP/RA, CALCTPER, CALCTFF
030963,000363: 
030964,000364:                                                                                          	# NORMAL EXIT MODE:     CALLING LINE +1 (STILL IN INTERPRETIVE MODE)
030965,000365: 
030966,000366:                                                                                          	# ALARMS:       NONE
030967,000367: 
030968,000368:                                                                                          	# OUTPUT:       RAPO    (-29) M EARTH   APOGEE RADIUS   EARTH CENTERED COORD.
030969,000369:                                                                                          	#                       (-27) M MOON                    MOON CENTERED COORD.
030970,000370:                                                                                          	#               RPER    (-29) M EARTH   PERIGEE RADIUS  EARTH CENTERED COORD.
030971,000371:                                                                                          	#                       (-27) M MOON                    MOON CENTERED COORD.
030972,000372:                                                                                          	#               HAPOX   (-29) M         APOGEE ALTITUDE ABOVE PAD OR LAND. SITE MAX VALUE LIMITED TO 9999.9 NM.
030973,000373:                                                                                          	#               HPERX   (-29) M         PERIGEE ALT. ABOVE PAD OR LAND. SITE    MAX VALUE LIMITED TO 9999.9 NM.
030974,000374:                                                                                          	#               TFF     (-28) CS        TIME TO 300KFT OR 35KFT ALTITUDE
030975,000375:                                                                                          	#               -TPER   (-28) CS        TIME TO PERIGEE
030976,000376: 
030977,000377:                                                                                          	# ERASABLE INITIALIZATION REQUIRED -
030978,000378:                                                                                          	#       TFF/RTMU        (+17) EARTH     RECIPROCAL OF PROPER GRAV CONSTANT FOR
030979,000379:                                                                                          	#                       (+14) MOON      EARTH OR MOON = 1/SQRT(MU).
030980,000380:                                                                                          	#       RONE            (-29) M         STATE VECTOR
030981,000381:                                                                                          	#       VONE            (-7)  M/CS      STATE VECTOR
030982,000382:                                                                                          	#       RPADTEM         (-29) M EARTH   RADIUS OF LAUNCH PAD OR LUNAR LANDING
030983,000383:                                                                                          	#                       (-27) M MOON    SITE.
030984,000384:                                                                                          	#       HPERMIN         (-29) M EARTH   (300 OR 35) KFT MINIMUM PERIGEE ALTITUDE
030985,000385:                                                                                          	#                       (-27) M MOON    ABOVE LAUNCH PAD OR LUNAR LANDING SITE.
030986,000386:                                                                                          	#       V82EMFLG        (INT SW BIT)    RESET FOR EARTH, SET FOR MOON.
030987,000387: 
030988,000388:                                                                                          	# DEBRIS:       QPRET, PDL, S2
030989,000389: 

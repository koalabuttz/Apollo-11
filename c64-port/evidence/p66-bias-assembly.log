038000,000520:                                                                                          	# ******************* PIPA READER ********************
038001,000521:                                                                                          	# MOD NO. 00  BY D. LICKLY  DEC. 9 1966
038002,000522: 
038003,000523:                                                                                          	# FUNCTIONAL DESCRIPTION
038004,000524:                                                                                          	#       SUBROUTINE TO READ PIPA COUNTERS, TRYING TO BE VERY CAREFUL SO THAT IT WILL BE RESTARTABLE.
038005,000525:                                                                                          	#       PIPA READINGS ARE STORED IN THE VECTOR DELV.  THE HIGH ORDER PART OF EACH COMPONENT CONTAINS THE PIPA READING,
038006,000526:                                                                                          	#       RESTARTS BEGIN AT REREADAC.
038007,000527: 
038008,000528:                                                                                          	#       AT THE END OF THE PIPA READER THE CDUS ARE READ AND STORED AS A
038009,000529:                                                                                          	#       VECTOR IN CDUTEMP.  THE HIGH ORDER PART OF EACH COMPONENT CONTAINS
038010,000530:                                                                                          	#       THE CDU READING IN 2S COMP IN THE ORDER CDUX,Y,Z.  THE THRUST
038011,000531:                                                                                          	#       VECTOR ESTIMATOR IN FINDCDUD REQUIRES THE CDUS BE READ AT PIPTIME.
038012,000532: 
038013,000533:                                                                                          	# CALLING SEQUENCE AND EXIT
038014,000534:                                                                                          	#       CALL VIA TC, ISWCALL, ETC.
038015,000535:                                                                                          	#       EXIT IS VIA Q.
038016,000536: 
038017,000537:                                                                                          	# INPUT
038018,000538:                                                                                          	#       INPUT IS THROUGH THE COUNTERS PIPAX, PIPAY, PIPAZ, AND TIME2.
038019,000539: 
038020,000540:                                                                                          	# OUTPUT
038021,000541:                                                                                          	#       HIGH ORDER COMPONENTS OF THE VECTOR DELV CONTAIN THE PIPA READINGS.
038022,000542:                                                                                          	#       PIPTIME CONTAINS TIME OF PIPA READING.
038023,000543: 

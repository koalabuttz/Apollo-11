020536,000244:                                                                                          	# PROGRAM DESCRIPTION BALLANGS
020537,000245:                                                                                          	# MOD NO.                               LOG SECTION R60,R62
020538,000246: 
020539,000247:                                                                                          	# WRITTEN BY RAMA M. AIYAWAR
020540,000248: 
020541,000249:                                                                                          	# FUNCTIONAL DESCRIPTION
020542,000250: 
020543,000251:                                                                                          	#       COMPUTES LM FDAI BALL DISPLAY ANGLES
020544,000252: 
020545,000253:                                                                                          	# CALLING SEQUENCE
020546,000254: 
020547,000255:                                                                                          	#       TC      BALLANGS
020548,000256: 
020549,000257:                                                                                          	# NORMAL EXIT MODE
020550,000258: 
020551,000259:                                                                                          	#       TC      BALLEXIT        (SAVED Q)
020552,000260: 
020553,000261:                                                                                          	# ALARM OR EXIT MODE    NIL
020554,000262: 
020555,000263:                                                                                          	# SUBROUTINES CALLED
020556,000264: 
020557,000265:                                                                                          	#       CD*TR*G
020558,000266:                                                                                          	#       ARCTAN
020559,000267: 
020560,000268:                                                                                          	# INPUT
020561,000269: 
020562,000270:                                                                                          	#       CPHI,CTHETA,CPSI ARE THE ANGLES CORRESPONDING TO AOG, AIG, AMG.  THEY ARE
020563,000271:                                                                                          	#       SP,2S COMPLIMENT SCALED TO HALF REVOLUTION.
020564,000272: 
020565,000273:                                                                                          	# OUTPUT
020566,000274: 
020567,000275:                                                                                          	#       FDAIX, FDAIY, FDAIZ ARE THE REQUIRED BALL ANGLES SCALED TO HALF REVOLUTION
020568,000276:                                                                                          	#       SP,2S COMPLIMENT.
020569,000277: 
020570,000278:                                                                                          	#       THESE ANGLES WILL BE DISPLAYED AS DEGREES AND HUNDREDTHS, IN THE ORDER ROLL, PITCH, YAW, USING NOUNS 18 & 19.
020571,000279: 
020572,000280:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
020573,000281: 
020574,000282:                                                                                          	#       CPHI, CTHETA, CPSI      EACH A SP REGISTER
020575,000283: 
020576,000284:                                                                                          	# DEBRIS
020577,000285: 
020578,000286:                                                                                          	#       A,L,Q,MPAC,SINCDU,COSCDU,PUSHLIST,BALLEXIT
020579,000287: 
020580,000288:                                                                                          	# NOMENCLATURE: CPHI, CTHETA, & CPSI REPRESENT THE OUTER, INNER, & MIDDLE GIMBAL ANGLES, RESPECTIVELY; OR
020581,000289:                                                                                          	#               EQUIVALENTLY, CDUX, CDUY, & CDUZ.
020582,000290: 
020583,000291:                                                                                          	# NOTE:  ARCTAN CHECKS FOR OVERFLOW AND SHOULD BE ABLE TO HANDLE ANY SINGULARITIES.
020584,000292: 
020585,000293: 26,2000                                           SETLOC   BAWLANGS                      	#
020586,000294: 26,2000                                           BANK                                   	#

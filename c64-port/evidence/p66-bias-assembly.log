047690,000493:                                                                                          	# CALLING SEQUENCE:
047691,000494:                                                                                          	#               TCF     SUPDXCHZ        # WITH 2CADR OF DESIRED LOCATION IN A + L.
047692,000495: 
047693,000496:    5165           56001        SUPDXCHZ           XCH      L                             	# BASIC.
047694,000497:    5166           00006                 +1        EXTEND                                 	#
047695,000498:    5167           01007                           WRITE    SUPERBNK                      	#
047696,000499:    5170           54006                           TS       BBANK                         	#
047697,000500:    5171           00001                           TC       L                             	#
047698,000501: 
047699,000502:    5172           77677        NEG100             OCT      77677                         	#

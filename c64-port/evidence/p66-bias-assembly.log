055516,000082: 
055517,000083:                                                                                          	# Page 1295
055518,000084:                                                                                          	# PHASCHNG IS THE MAIN WAY OF MAKING PHASE CHANGES FOR RESTARTS.  THERE ARE THREE FORMS OF PHASCHNG, KNOWN AS TYPE
055519,000085:                                                                                          	# A, TYPE B, AND TYPE C.  THEY ARE ALL CALLED AS FOLLOWS, WHERE OCT XXXXX CONTAINS THE PHASE INFORMATION,
055520,000086:                                                                                          	#               TC      PHASCHNG
055521,000087:                                                                                          	#               OCT     XXXXX
055522,000088:                                                                                          	# TYPE A IS CONCERNED WITH FIXED PHASE CHANGES, THAT IS, PHASE INFORMATION THAT IS STORED PERMANENTLY.  THESE
055523,000089:                                                                                          	# OPTIONS ARE, WHERE G STANDS FOR A GROUP AND .X FOR THE PHASE,
055524,000090:                                                                                          	#       G.0             INACTIVE, WILL NOT PERMIT A GROUP G RESTART
055525,000091:                                                                                          	#       G.1             WILL CAUSE THE LAST DISPLAY TO BE REACTIVATED, USED MAINLY IN MANNED FLIGHTS
055526,000092:                                                                                          	#       G.EVEN          A DOUBLE TABLE RESTART, CAN CAUSE ANY COMBINATION OF TWO JOBS, TASKS, AND/OR
055527,000093:                                                                                          	#                       LONGCALL TO BE RESTARTED.
055528,000094:                                                                                          	#       G.ODD NOT .1    A SINGLE TABLE RESTART, CAN CAUSE EITHER A JOB, TASK, OR LONGCALL RESTART.
055529,000095: 
055530,000096:                                                                                          	# THIS INFORMATION IS PUT INTO THE OCTAL WORD AFTER TC PHASCHNG AS FOLLOWS
055531,000097:                                                                                          	#       TL0 00P PPP PPP GGG
055532,000098:                                                                                          	# WHERE EACH LETTER OR NUMBER STANTS FOR A BIT.  THE G'S STAND FOR THE GROUP, OCTAL 1-7, THE P'S FOR THE PHASE,
055533,000099:                                                                                          	# OCTAL 0 - 127.  0'S MUST BE 0.  IF ONE WISHES TO HAVE THE TBASE OF GROUP G TO BE SET AT THIS TIME,
055534,000100:                                                                                          	# T IS SET TO 1, OTHERWISE IT IS SET TO 0.  SIMILARLY IF ONE WISHES TO SET LONGBASE, THEN L IS SET TO 1, OTHERWISE
055535,000101:                                                                                          	# IT IS SET TO 0.  SOME EXAMPLES,
055536,000102:                                                                                          	#               TC      PHASCHNG        # THIS WILL CAUSE GROUP 3 TO BE SET TO 0,
055537,000103:                                                                                          	#               OCT     00003           # MAKING GROUP 3 INACTIVE
055538,000104: 
055539,000105:                                                                                          	#               TC      PHASCHNG        # IF A RESTART OCCURS THIS WOULD CAUSE
055540,000106:                                                                                          	#               OCT     00012           # GROUP 2 TO RESTART THE LAST DISPLAY
055541,000107: 
055542,000108:                                                                                          	#               TC      PHASCHNG        # THIS SETS THE TBASE OF GROUP 4 AND IN
055543,000109:                                                                                          	#               OCT     40064           # CASE OF A RESTART WOULD START UP THE TWO
055544,000110:                                                                                          	#                                       # THINGS LOCATED IN THE DOUBLE 4.6 RESTART
055545,000111:                                                                                          	#                                       # LOCATION.
055546,000112: 
055547,000113:                                                                                          	#               TC      PHASCHNG        # THIS SETS LONGBASE AND UPON A RESTART
055548,000114:                                                                                          	#               OCT     20135           # CAUSES 5.13 TO BE RESTARTED (SINCE
055549,000115:                                                                                          	#                                       # LONGBASE WAS SET THIS SINGLE ENTRY
055550,000116:                                                                                          	#                                       # SHOULD BE A LONGCALL)
055551,000117: 
055552,000118:                                                                                          	#               TC      PHASCHNG        # SINCE BOTH TBASE4 AND LONGBASE ARE SET,
055553,000119:                                                                                          	#               OCT     60124           # 4.12 SHOULD CONTAIN BOTH A TASK AND A
055554,000120:                                                                                          	#                                       # LONGCALL TO BE RESTARTED
055555,000121: 
055556,000122:                                                                                          	# TYPE C PHASCHNG CONTAINS THE VARIABLE TYPE OF PHASCHNG INFORMATION.  INSTEAD OF THE INFORMATION BEING IN A
055557,000123:                                                                                          	# PERMANENT FORM, ONE STORES THE DESIRED RESTART INFORMATION IN A VARIABLE LOCATION.  THE BITS ARE AS FOLLOWS,
055558,000124:                                                                                          	#       TL0 1AD XXX CJW GGG
055559,000125:                                                                                          	# WHERE EACH LETTER OR NUMBER STANDS FOR A BIT.  THE G'S STAND FOR THE GROUP, OCTAL 1 - 7.  IF THE RESTART IS TO
055560,000126:                                                                                          	# BE BY WAITLIST, W IS SET TO 1, IF IT IS A JOB, J IS SET TO 1, IF IT IS A LONGCALL, C IS SET TO 1.  ONLY ONE OF
055561,000127:                                                                                          	# THESE THREE BITS MAY BE SET.  X'S ARE IGNORED, 1 MUST BE 1, AND 0 MUST BE 0.  AGAIN T STANDS FOR THE TBASE,
055562,000128:                                                                                          	# Page 1296
055563,000129:                                                                                          	# AND L FOR LONGBASE.  THE BITS A AND D ARE CONCERNED WITH THE VARIABLE INFORMATION.  IF D IS SET TO 1, A PRIORITY
055564,000130:                                                                                          	# OR DELTA TIME WILL BE READ FROM THE NEXT LOCATION AFTER THE OCTAL INFORMATION., IF THIS IS TO BE INDIRECT, THAT
055565,000131:                                                                                          	# IS, THE NAME OF A LOCATION CONTAINING THE INFORMATION (DELTA TIME ONLY), THEN THIS IS GIVEN AS THE -GENADR OF
055566,000132:                                                                                          	# THAT LOCATION WHICH CONTAINS THE DELTA TIME.  IF THE OLD PRIORITY OR DELTA TIME IS TO BE USED, THAT WHICH IS
055567,000133:                                                                                          	# ALREADY IN THE VARIABLE STORAGE, THEN D IS SET TO 0.  NEXT THE A BIT IS USED.  IF IT IS SET TO 0, THE ADDRESS
055568,000134:                                                                                          	# THAT WOULD BE RESTARTED DURING A RESTART IS THE NEXT LOCATION AFTER THE PHASE INFORMATION, THAT IS, EITHER
055569,000135:                                                                                          	# (TC PHASCHNG) +2 OR +3, DEPENDING ON WHETHER D HAD BEEN SET OR NOT.  IF A IS SET TO 1, THEN THE ADDRESS THAT
055570,000136:                                                                                          	# WOULD BE RESTARTED IS THE 2CADR THAT IS READ FROM THE NEXT TWO LOCATION.  EXAMPLES,
055571,000137:                                                                                          	#       AD      TC      PHASCHNG        # THIS WOULD CAUSE LOCATION AD +3 TO BE
055572,000138:                                                                                          	#       AD+1    OCT     05023           # RESTARTED BY GROUP THREE WITH A PRIORITY
055573,000139:                                                                                          	#       AD+2    OCT     23000           # OF 23.  NOTE UPON RETURNING IT WOULD
055574,000140:                                                                                          	#       AD+3                            # ALSO GO TO AD+3
055575,000141: 
055576,000142:                                                                                          	#       AD      TC      PHASCHNG        # GROUP 1 WOULD CAUSE CALLCALL TO BE
055577,000143:                                                                                          	#       AD+1    OCT     27441           # BE STARTED AS A LONGCALL FROM THE TIME
055578,000144:                                                                                          	#       AD+2    -GENADR DELTIME         # STORED IN LONGBASE (LONGBASE WAS SET) BY
055579,000145:                                                                                          	#       AD+3    2CADR   CALLCALL        # A DELTA TIME STORED IN DELTIME.  THE
055580,000146:                                                                                          	#       AD+4                            # BBCON OF THE 2CADR SHOULD CONTAIN THE E
055581,000147:                                                                                          	#       AD+5                            # BANK OF DELTIME.  PHASCHNG RETURNS TO
055582,000148:                                                                                          	#                                       # LOCATION AD+5
055583,000149: 
055584,000150:                                                                                          	# NOTE THAT IF A VARIABLE PRIORITY IS GIVEN FOR A JOB, THE JOB WILL BE RESTARTED AS A NOVAC IF THE PRIORITY IS
055585,000151:                                                                                          	# NEGATIVE, AS A FINDVAC IF THE PRIORITY IS POSITIVE.
055586,000152: 
055587,000153:                                                                                          	# TYPE B PHASCHNG IS A COMBINATION OF VARIABLE AND FIXED PHASE CHANGES.  IT WILL START UP A JOB AS INDICATED
055588,000154:                                                                                          	# BELOW AND ALSO START UP ONE FIXED RESTART, THAT IS EITHER AN G.1 OR A G.ODD OR THE FIRST ENTRY OF G.EVEN
055589,000155:                                                                                          	# DOUBLE ENTRY.  THE BIT INFORMATION IS AS FOLLOW,
055590,000156:                                                                                          	#       TL1 DAP PPP PPP GGG
055591,000157:                                                                                          	# WHERE EACH LETTER OR NUMBER STANDS FOR A BIT.  THE G'S STAND FOR THE GROUP, OCTAL 1 - 7, THE P'S FOR THE FIXED
055592,000158:                                                                                          	# PHASE INFORMATION, OCTAL 0 - 127.  1 MUST BE 1.  AND AGAIN T STANDS FOR THE TBASE AND L FOR LONGBASE.  D THIS
055593,000159:                                                                                          	# TIME STANDS ONLY FOR PRIORITY SINCE THIS WILL BE CONSIDERED A JOB, AND IT MUST BE GIVEN DIRECTLY IF GIVEN.
055594,000160:                                                                                          	# AGAIN A STANDS FOR THE ADDRESS OF THE LOCATION TO BE RESTARTED, 1 IF THE 2CADR IS GIVEN, OR 0 IF IT IS TO BE
055595,000161:                                                                                          	# THE NEXT LOCATION.  (THE RETURN LOCATION OF PHASCHNG) EXAMPLES,
055596,000162:                                                                                          	#       AD      TC      PHASCHNG        # TBASE IS SET AND A RESTART CAUSE GROUP 3
055597,000163:                                                                                          	#       AD+1    OCT     56043           # TO START THE JOB AJOBAJOB WITH PRIORITY
055598,000164:                                                                                          	#       AD+2    OCT     31000           # 31 AND THE FIRST ENTRY OF 3.4SPOT (WE CAN
055599,000165:                                                                                          	#       AD+3    2CADR   AJOBAJOB        # ASSUME IT IS A TASK SINCE WE SET TBASE3)
055600,000166:                                                                                          	#       AD+4                            # UPON RETURN FROM PHASCHNG CONTROL WOULD
055601,000167:                                                                                          	#       AD+5                            # GO TO AD+5
055602,000168: 
055603,000169:                                                                                          	#       AD      TC      PHASCHNG        # UPON A RESTART THE LAST DISPLAY WOULD BE
055604,000170:                                                                                          	#       AD+1    OCT     10015           # RESTARTED AND A JOB WITH THE PREVIOUSLY
055605,000171:                                                                                          	#       AD+2                            # STORED PRIORITY WOULD BE BEGUN AT AD+2
055606,000172:                                                                                          	#                                       # BY MEANS OF GROUP 5
055607,000173:                                                                                          	# Page 1297
055608,000174:                                                                                          	# THE NOVAC-FINDVAC CHOICE FOR JOBS HOLDS HERE ALSO -- NEGATIVE PRIORITY CAUSES A NOVAC CALL, POSITIVE A FINDVAC.
055609,000175: 
055610,000176:                                                                                          	# SUMMARY OF BITS:
055611,000177:                                                                                          	#       TYPE A          TL0 00P PPP PPP GGG
055612,000178:                                                                                          	#       TYPE B          TL1 DAP PPP PPP GGG
055613,000179:                                                                                          	#       TYPE C          TL0 1AD XXX CJW GGG
055614,000180: 
055615,000181:                                                                                          	# Page 1298
055616,000182:                                                                                          	# 2PHSCHNG IS USED WHEN ONE WISHES TO START UP A GROUP OR CHANGE A GROUP WHILE UNDER THE CONTROL OF A DIFFERENT
055617,000183:                                                                                          	# GROUP.  FOR EXAMPLE, CHANGE THE PHASE OF GROUP 3 WHILE THE PORTION OF THE PROGRAM IS UNDER GROUP 5.  ALL 2PHSCHNG
055618,000184:                                                                                          	# CALLS ARE MADE IN THE FOLLOWING MANNER,
055619,000185:                                                                                          	#               TC      2PHSCHNG
055620,000186:                                                                                          	#               OCT     XXXXX
055621,000187:                                                                                          	#               OCT     YYYYY
055622,000188:                                                                                          	# WHERE OCT XXXXX MUST BE OF TYPE A AND OCT YYYYY MAY BE OF EITHER TYPE A OR TYPE B OR TYPE C.  THERE IS ONE
055623,000189:                                                                                          	# DIFFERENCE --- NOTE: IF LONGBASE IS TO BE SET THIS INFORMATION IS GIVEN IN THE OCT YYYYY INFORMATION, IT WILL
055624,000190:                                                                                          	# BE DISREGARDED IF GIVEN WITH THE OCT XXXXX INFORMATION.  A COUPLE OF EXAMPLES MAY HELP,
055625,000191:                                                                                          	#       AD      TC      2PHACHNG        # SET TBASE3 AND IF A RESTART OCCURS START
055626,000192:                                                                                          	#       AD+1    OCT     40083           # THE TWO ENTRIES IN 3.8 TABLE LOCATION
055627,000193:                                                                                          	#       AD+2    OCT     05025           # THIS IS OF TYPE C, SET THE JOB TO BE
055628,000194:                                                                                          	#       AD+3    OCT     18000           # TO BE LOCATION AD+4, WITH A PRIORITY 18,
055629,000195:                                                                                          	#       AD+4                            # FOR GROUP 5 PHASE INFORMATION.
055630,000196: 
055632,000198:    5327  40,2000                                  SBANK=   PINSUPER                      	#
055634,000200: 
055635,000201:    5327                                           COUNT*   $$/PHASE                      	#
055636,000202:    5327           00004        2PHSCHNG           INHINT                                 	# THE ENTRY FOR A DOUBLE PHASE CHANGE
055637,000203:    5330           50002                           NDX      Q                             	#
055638,000204:    5331           30000                           CA       0                             	#
055639,000205:    5332           24002                           INCR     Q                             	#
055640,000206:    5333           54072                           TS       TEMPP2                        	#
055641,000207: 
055642,000208:    5334           74757                           MASK     OCT7                          	#
055643,000209:    5335           60000                           DOUBLE                                 	#

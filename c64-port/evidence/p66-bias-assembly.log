049008,000031: 
049010,000033:                                                                                          	#  INCORP1--PERFORMS THE SIX DIMENSIONAL STATE VECTOR DEVIATION FOR POSITI
049011,000034:                                                                                          	# ON AND VELOCITY OR THE NINE DIMENSIONAL DEVIATION OF POSITION,VELOCITY,A
049012,000035:                                                                                          	# ND RADAR OR LANDMARK BIAS.THE OUTPUT OF THE BVECTOR ROUTINE ALONG WITH T
049013,000036:                                                                                          	# HE ERROR TRANSITION MATRIX(W) ARE USED AS INPUT TO THE ROUTINE.THE DEVIA
049014,000037:                                                                                          	# TION IS OBTAINED BY COMPUTING AN ESTIMATED TRACKING MEASUREMENT FROM THE
049015,000038:                                                                                          	# CURRENT STATE VECTOR AND COMPARING IT WITH AN ACTUAL TRACKING MEASUREMEN
049016,000039:                                                                                          	# T AND APPLYING A STATISTICAL WEIGHTING VECTOR.
049017,000040: 

047800,000099:                                                                                          	# DETAILED ANALYSIS OF TIMING --
047801,000100:                                                                                          	#       CONTROL WILL NOT BE RETURNED TO THE SPECIFIED ADDRESS (2CADR) IN EXACTLY DELTA T CENTISECONDS.
047802,000101:                                                                                          	#       THE APPROXIMATE TIME MAY BE CALCULATED AS FOLLOWS:
047803,000102:                                                                                          	#               LET T0 = THE TIME OF THE TC WAITLIST
047804,000103:                                                                                          	#               LET TS = T0 +147U + COUNTER INCREMENTS (SET UP TIME)
047805,000104:                                                                                          	#               LET X  = TS -(100TS)/100  (VARIANCE FROM COUNTERS)
047806,000105:                                                                                          	#               LET Y  = LENGTH OF TIME OF INHIBIT INTERRUPT AFTER T3RUPT
047807,000106:                                                                                          	#               LET Z  = LENGTH OF TIME TO PROCESS TASKS WHICH ARE DUE THIS T3RUPT BUT DISPATCHED EARLIER.
047808,000107:                                                                                          	#                        (Z=0, USUALLY).
047809,000108:                                                                                          	#               LET DELTD  = THE ACTUAL TIME TAKEN TO GIVE CONTROL TO 2CADR
047810,000109:                                                                                          	#               THEN DELTD = TS+DELTA T -X +Y +Z +1.05MS* +COUNTERS*
047811,000110:                                                                                          	#               *THE TIME TAKEN BY WAITLIST ITSELF AND THE COUNTER TICKING DURING THIS WAITLIST TIME.
047812,000111:                                                                                          	#       IN SHORT, THE ACTUAL TIME TO RETURN CONTROL TO A 2CADR IS AUGMENTED BY THE TIME TO SET UP THE TASK'S
047813,000112:                                                                                          	#       INTERRUPT, ALL COUNTERS TICKING, THE T3RUPT PROCESSING TIME, THE WAITLIST PROCESSING TIME AND THE POSSIBILITY
047814,000113:                                                                                          	#       OF OTHER TASKS INHIBITING THE INTERRUPT.

057371,000121:                                                                                          	# 'UPLINK ACTIVITY LIGHT' IS TURNED OFF BY .....
057372,000122:                                                                                          	#       1.      VBRELDSP
057373,000123:                                                                                          	#       2.      ERROR RESET
057374,000124:                                                                                          	#       3.      UPDATE PROGRAM (P27) ENTERED BY V70,V71,V72, AND V73.
057375,000125:                                                                                          	#                                    -
057376,000126:                                                                                          	# THE RECEPTION OF A BAD CODE (I.E  CCC FAILURE) LOCKS OUT FURTHER UPLINK ACTIVITY BY SETTING BIT4 OF FLAGWRD7 = 1.
057377,000127:                                                                                          	# THIS INDICATION WILL BE TRANSFERRED TO THE GROUND BY THE DOWNLINK WHICH DOWNLINKS ALL FLAGWORDS.
057378,000128:                                                                                          	# WHEN UPLINK ACTIVITY IS LOCKED OUT, IT CAN BE ALLOWED WHEN THE GROUND UPLINKS AND 'ERROR RESET' CODE.
057379,000129:                                                                                          	# (IT IS RECOMMENDED THAT THE 'ERROR LIGHT RESET' CODE IS PRECEEDED BY 16 BITS THE FIRST OF WHICH IS 1 FOLLOWED
057380,000130:                                                                                          	# BY 15 ZEROES.  THIS WILL ELIMINATE EXTRANEOUS BITS FROM INLINK WHICH MAY HAVE BEEN LEFT OVER FROM THE ORIGINAL
057381,000131:                                                                                          	# FAILURE)
057382,000132: 
057383,000133:                                                                                          	# UPLINK ACTIVITY IS ALSO ALLOWED (UNLOCKED) DURING FRESH START WHEN FRESH START SETS BIT4 OF FLAGWRD7 = 0.
057384,000134: 
057385,000135: 04,3400           44753                           CS       XDSPBIT                       	#

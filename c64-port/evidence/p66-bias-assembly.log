025959,004763: 32,2653           00006                           EXTEND                                 	#
025960,004764: 32,2654           70166                           MP       PUSHLOC                       	#
025961,004765: 32,2655           00006                           EXTEND                                 	#
025962,004766: 32,2656           70122                           MP       VBUF                          	# FORM SIN S COS T ULOSNBX.
025963,004767: 32,2657           20155                           DAS      MPAC                          	#
025964,004768: 32,2660           31767                           CA       SAVECDUT   +1                 	#
025965,004769: 32,2661           05032                           TC       SPCOS                         	#
025966,004770: 32,2662           55767                           TS       SAVECDUT   +1                 	# SAVECDUT +1 NOW = COS S.
025967,004771: 32,2663           00006                           EXTEND                                 	#
025968,004772: 32,2664           70166                           MP       PUSHLOC                       	#
025969,004773: 32,2665           00006                           EXTEND                                 	#

021818,000622: 
021819,000623:                                                                                          	#       LSR22.1         GOFLASH         WAITLIST
021820,000624:                                                                                          	#       LSR22.2         PRIOLARM        BANKCALL
021821,000625:                                                                                          	#       LSR22.3         R61LEM
021822,000626: 
021823,000627:                                                                                          	# NORMAL EXIT MODES -
021824,000628: 
021825,000629:                                                                                          	#       R22 WILL CONTINUE TO RECYCLE, UPDATING STATE VECTORS WITH RADAR DATA
021826,000630:                                                                                          	#       UNTIL P20 CEASES TO OPERATE (RENDEZVOUS FLAG SET TO ZERO) AT WHICH TIME
021827,000631:                                                                                          	#       R22 WILL TERMINATE SELF.
021828,000632: 
021829,000633:                                                                                          	# ALARM OR ABORT EXIT MODES -
021830,000634: 
021831,000635:                                                                                          	#       PRIORITY ALARM
021832,000636:                                                                                          	#       PRIORITY ALARM 525 LOS NOT WITHIN 3 DEGREE LIMIT
021833,000637: 
021834,000638:                                                                                          	# OUTPUT
021835,000639: 
021836,000640:                                                                                          	#       SEE OUTPUT FROM LSR22.3
021837,000641: 
021838,000642:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
021839,000643: 
021840,000644:                                                                                          	#       SEE LSR22.1, LSR22.2, LSR22.3
021841,000645: 
021842,000646:                                                                                          	# FLAGS SET + RESET
021843,000647: 
021844,000648:                                                                                          	#       NOANGFLG
021845,000649: 
021846,000650:                                                                                          	# DEBRIS
021847,000651: 

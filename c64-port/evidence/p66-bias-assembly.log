064004,000458: 21,3443           13445                           TCF      +2                            	# HIGH ORDER WORD IS ZERO.  TRY THE LOWER.
064005,000459: 21,3444           13451                           TCF      ZEROOT                        	# NEGATIVE.  USE ZERO FOR 1/2 POWER.

026426,000037:                                                                                          	# PROGRAM DESCRIPTION P30       DATE 3-6-67
026427,000038: 
026428,000039:                                                                                          	# MOD.1 BY RAMA AIYAWAR
026429,000040: 
026430,000041:                                                                                          	# FUNCTIONAL DESCRIPTION
026431,000042:                                                                                          	#       ACCEPT ASTRONAUT INPUTS OF TIG,DELV(LV)
026432,000043:                                                                                          	#       CALL IMU STATUS CHECK ROUTINE (R02)
026433,000044:                                                                                          	#       DISPLAY TIME TO GO, APOGEE, PERIGEE, DELV(MAG), MGA AT IGN
026434,000045:                                                                                          	#       REQUEST BURN PROGRAM
026435,000046: 
026436,000047:                                                                                          	# CALLING SEQUENCE VIA JOB FROM V37
026437,000048: 
026438,000049:                                                                                          	# EXIT VIA V37 CALL OR TO GOTOPOOH (V34E)
026439,000050: 
026440,000051:                                                                                          	# SUBROUTINE CALLS -    FLAGUP, PHASCHNG, BANKCALL, ENDOFJOB, GOFLASH, GOFLASHR
026441,000052:                                                                                          	#                       GOPERF3R, INTPRET, BLANKET, GOTOPOOH, R02BOTH, S30.1,
026442,000053:                                                                                          	#                       TTG/N35, MIDGIM, DISPMGA
026443,000054: 
026444,000055:                                                                                          	# ERASABLE INITIALIZATION - STATE VECTOR
026445,000056: 
026446,000057:                                                                                          	# OUTPUT -      RINIT, VINIT, +MGA, VTIG, RTIG, DELVSIN, DELVSAB, DELVSLV, HAPO,
026447,000058:                                                                                          	#               HPER, TTOGO
026448,000059: 
026449,000060:                                                                                          	# DEBRIS - A, L, MPAC, PUSHLIST
026450,000061: 

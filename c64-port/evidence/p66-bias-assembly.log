033961,001363:                                                                                          	# TRIMGIMB      (FORMERLY S40.6)
033962,001364:                                                                                          	# MOD 0         24 FEB 67       PETER ADLER
033963,001365: 
033964,001366:                                                                                          	# FUNCTION:
033965,001367:                                                                                          	#       TRIMS DPS ENGINE TO MINIMIZE THRUST/CG OFFSET.  ENGINE IS GIMBALLED TO FULL + PITCH AND + ROLL (TO LOCK)
033966,001368:                                                                                          	#       FOR REFERENCE AND IS THEN BROUGHT BACK TO TRIM POSITION BY RUNNING FOR THE PROPER TIMES (TO BE
033967,001369:                                                                                          	#       SPECIFIED BY GAEC) IN - PITCH AND - ROLL.
033968,001370: 
033969,001371:                                                                                          	# CALLING SEQUENCE:
033970,001372:                                                                                          	#       VIA WAITLIST FROM R03
033971,001373: 
033972,001374:                                                                                          	# INPUT:
033973,001375:                                                                                          	#       PITTIME         TIME TO RUN FROM FULL + PITCH TO TRIM (CS)
033974,001376:                                                                                          	#       ROLLTIME        TIME TO RUN FROM FULL + ROLL TO TRIM (CS)
033975,001377: 
033976,001378:                                                                                          	# SUBROUTINES USED:
033977,001379:                                                                                          	#       WAITLIST, FIXDELAY, VARDELAY, FLAGUP, FLAGDOWN, NOVAC
033978,001380: 
033979,001381: 27,3217                                           COUNT*   $$/S40.6                      	#
033980,001382: 27,3217  E6,1401                                  EBANK=   ROLLTIME                      	# OCTAL MASKS: PRIO5=05000 EBANK5=02400
033981,001383: 
033982,001384: 27,3217           05516        TRIMGIMB           TC       DOWNFLAG                      	# GMBDRVSW FLAG IS SET WHEN EITHER ROLL OR
033983,001385: 27,3220           00137                           ADRES    GMBDRVSW                      	# PITCH IS COMPLETED, WHICHEVER IS FIRST.
033984,001386: 
033985,001387: 27,3221           45017                           CS       PRIO5                         	# TURN OFF - PITCH, - ROLL, IF ON.
033986,001388: 27,3222           00006                           EXTEND                                 	#
033987,001389: 27,3223           03012                           WAND     CHAN12                        	#
033988,001390: 27,3224           35014                           CAF      EBANK5                        	# TURN ON + PITCH, + ROLL.
033989,001391: 27,3225           00006                           EXTEND                                 	#
033990,001392: 27,3226           05012                           WOR      CHAN12                        	#
033991,001393: 27,3227           05221                           TC       FIXDELAY                      	# WAIT ONE MINUTE TO MAKE SURE ENGINE IS
033992,001394: 27,3230           13560                           DEC      6000       B-14               	# AT FULL + PITCH AND FULL + ROLL
033993,001395: 27,3231           45014                           CS       EBANK5                        	# TURN OFF + PITCH, + ROLL.
033994,001396: 27,3232           00006                           EXTEND                                 	#
033995,001397: 27,3233           03012                           WAND     CHAN12                        	#
033996,001398: 27,3234           35017                           CAF      PRIO5                         	# TURN ON - PITCH, - ROLL.
033997,001399: 27,3235           00006                           EXTEND                                 	#
033998,001400: 27,3236           05012                           WOR      CHAN12                        	#
033999,001401: 27,3237           31402                           CAE      PITTIME                       	# GET TIME TO SHUT OFF - PITCH AND SET UP
034000,001402: 27,3240           05173                           TC       TWIDDLE                       	# TWIDDLE-TASK TO TURN IT OFF THEN
034001,001403: 27,3241           03260                           ADRES    PITCHOFF                      	#
034002,001404: 
034003,001405: 27,3242           31401                           CAE      ROLLTIME                      	# GET TIME TO SHUT OFF - ROLL AND GO AWAY
034004,001406: 27,3243           05224                           TC       VARDELAY                      	# UNTIL THEN
034005,001407: 27,3244           44740                           CS       BIT12                         	#
034006,001408: 27,3245           00006                           EXTEND                                 	#
034007,001409: 27,3246           03012                           WAND     CHAN12                        	# SHUT OFF ROLL

019433,002954: 
019435,002956:                                                                                          	# NVSUB IS USED FOR SUBROUTINE CALLS FROM WITHIN COMPUTER. IT CAN BE
019436,002957:                                                                                          	# USED TO CALL THE COMBINATION OF ANY DISPLAY, LOAD, OR MONITOR VERB
019437,002958:                                                                                          	# TOGETHER WITH ANY NOUN AVAILABLE TO THE KEYBOARD.
019438,002959:                                                                                          	# PLACE 0VVVVVVVNNNNNNN INTO A.
019439,002960:                                                                                          	# V-S ARE THE 7 BIT VERB CODE.  N-S ARE THE 7 BIT NOUN CODE.
019440,002961: 
019441,002962:                                                                                          	# IF NVSUB IS CALLED WITH THE FOLLOWING NEGATIVE NUMBERS (RATHER THAN THE
019442,002963:                                                                                          	# VERB-NOUN CODE) IN A, THEN THE DISPLAY IS BLANKED AS FOLLOWS -
019443,002964:                                                                                          	#  -4 FULL BLANK, -3 LEAVE MODE, -2 LEAVE MODE AND VERB, -1 BLANK R-S ONLY
019444,002965: 
019445,002966:                                                                                          	# NVSUB CAN BE USED WITH MACH CADR TO BE SPEC BY PLACING THE CADR INTO
019446,002967:                                                                                          	# MPAC+2 BEFORE THE STANDARD NVSUB CALL.
019447,002968: 
019448,002969:                                                                                          	# NVSUB RETURNS TO 2+ CALLING LOC AFTER PERFORMING TASK, IF DISPLAY
019449,002970:                                                                                          	# SYSTEM IS AVAILABLE. THE NEW NOUN AND VERB CODES ARE DISPLAYED.
019450,002971:                                                                                          	# IF V:S =0, THE NEW NOUN CODE IS DISPLAYED ONLY (RETURN WITH NO FURTHER
019451,002972:                                                                                          	# ACTION). IF N-S =0, THE NEW VERB CODE IS DISPLAYED ONLY (RETURN WITH NO
019452,002973:                                                                                          	# FURTHER ACTION).
019453,002974: 
019454,002975:                                                                                          	# IT RETURNS TO 1+ CALLING LOC WITHOUT PERFORMING TASK, IF DISPLAY
019455,002976:                                                                                          	# SYSTEM IS BLOCKED (NOTHING IS DISPLAYED IN THIS CASE).
019456,002977:                                                                                          	# IT DOES TC ABORT (WITH OCT 01501) IF IT ENCOUNTERS A DISPLAY PROGRAM
019457,002978:                                                                                          	# ALARM CONDITION BEFORE RETURN TO CALLER.
019458,002979: 
019459,002980:                                                                                          	# THE DISPLAY SYSTEM IS BLOCKED BY THE DEPRESSION OF ANY
019460,002981:                                                                                          	# KEY, EXCEPT ERROR LIGHT RESET
019461,002982:                                                                                          	# IT IS RELEASED BY THE KEY RELEASE BUTTON, ALL EXTENDED VERBS,
019462,002983:                                                                                          	# PROCEED WITHOUT DATA, TERMINATE, RESEQUENCE, INITIALIZE EXECUTIVE,
019463,002984:                                                                                          	# RECALL PART OF RECALTST IF ENDIDLE WAS USED,
019464,002985:                                                                                          	# VB = REQUEST EXECUTIVE, VB = REQUEST WAITLIST,
019465,002986:                                                                                          	# MONITOR SET UP.
019466,002987: 
019467,002988:                                                                                          	# THE DISPLAY SYSTEM IS ALSO BLOCKED BY THE EXTERNAL MONITOR BIT, WHICH
019468,002989:                                                                                          	# INDICATES AN EXTERNALLY INITIATED MONITOR IS RUNNING (SEE MONITOR)
019469,002990: 
019470,002991:                                                                                          	# A NVSUB CALL THAT PASSES DSPLOCK AND THE EXTERNAL MONITOR BIT ENDS OLD
019471,002992:                                                                                          	# MONITOR.
019472,002993: 
019473,002994:                                                                                          	# DSPLOCK IS THE INTERLOCK FOR USE OF KEYBOARD AND DISPLAY SYSTEM WHICH
019474,002995:                                                                                          	# LOCKS OUT INTERNAL USE WHENEVER THERE IS EXTERNAL KEYBOARD ACTION.
019475,002996: 
019476,002997:                                                                                          	# NVSUB SHOULD BE USED TWICE IN SUCCESSION FOR :PLEASE PERFORM: SITUATIONS
019477,002998:                                                                                          	# (SIMILARLY FOR PLEASE MARK).  FIRST PLACE THE CODED NUMBER FOR WHAT
019478,002999:                                                                                          	# ACTION IS DESIRED OF OPERATOR INTO THE REGISTERS REFERRED TO BY THE
019479,003000:                                                                                          	# :CHECKLIST: NOUN. GO TO NVSUB WITH A DISPLAY VERB AND THE :CHECKLIST:
019480,003001:                                                                                          	# NOUN.  GO TO NVSUB AGAIN WITH THE :PLEASE PERFORM: VERB AND ZEROS IN THE
019481,003002:                                                                                          	# LOW 7 BITS. THIS :PASTES UP: THE :PLEASE PERFORM: VERB INTO THE VERB
019482,003003:                                                                                          	# LIGHTS.
019483,003004: 
019484,003005:                                                                                          	# NVMONOPT IS AN ENTRY SIMILAR TO NVSUB, BUT REQUIRING AN ADDITIONAL
019486,003007:                                                                                          	# PARAMETER IN L. IT SHOULD BE USED ONLY WITH A MONITOR VERB-NOUN CODE IN
019487,003008:                                                                                          	# A. AFTER EACH MONITOR DISPLAY A *PLEASE* VERB WILL BE PASTED IN THE VERB
019488,003009:                                                                                          	# LIGHTS OR DATA WILL BE BLANKED (OR BOTH) ACCORDING TO THE OPTIONS
019489,003010:                                                                                          	# SPECIFIED IN L. IF BITS 8-14 OF L ARE OTHER THAN ZERO, THEN THEY WILL 
019490,003011:                                                                                          	# BE INTERPRETED AS A VERB CODE AND PASTED IN THE VERB LIGHTS. (THIS VERB
019491,003012:                                                                                          	# CODE SHOULD DESIGNATE ONE OF THE *PLEASE* VERBS.)  IF BITS 1-3 OF L ARE
019492,003013:                                                                                          	# OTHER THAN ZERO, THEN THEY WILL BE USED TO BLANK DATA BY BEING FED TO
019493,003014:                                                                                          	# BLANKSUB.  IF NVMONOPT IS USED WITH A VERB OTHER THAN A MONITOR VERB,
019494,003015:                                                                                          	# THE PARAMETER IN L HAS NO EFFECT.
019495,003016: 
019496,003017:                                                                                          	# NVSUB IN FIXED-FIXED PLACES 2+CALLING LOC INTO NVQTEM, TC NVSUBEND INTO
019497,003018:                                                                                          	# ENTRET. (THIS WILL RESTORE OLD CALLING BANK BITS)
019498,003019: 

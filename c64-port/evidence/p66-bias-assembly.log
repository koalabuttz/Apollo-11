016515,000036:                                                                                          	##
016516,000037:                                                                                          	## Notations on the hardcopy document read, in part:
016517,000038:                                                                                          	##
016518,000039:                                                                                          	##    Assemble revision 001 of AGC program LMY99 by NASA 2021112-061
016519,000040:                                                                                          	##    16:27 JULY 14, 1969
016520,000041: 
016522,000043:                                                                                          	# PROGRAM NAME - KEYBOARD AND DISPLAY PROGRAM
016523,000044:                                                                                          	# MOD NO - 4            DATE - 27 APRIL 1967            ASSEMBLY - PINDANCE REV 18
016524,000045:                                                                                          	# MOD BY - FILENE
016525,000046:                                                                                          	# LOG SECTION - PINBALL GAME BUTTONS AND LIGHTS
016526,000047: 
016527,000048:                                                                                          	# FUNCTIONAL DESCRIPTION-
016528,000049: 
016529,000050:                                                                                          	# THE KEYBOARD AND DISPLAY SYSTEM PROGRAM OPERATES UNDER EXECUTIVE
016530,000051:                                                                                          	# CONTROL AND PROCESSES INFORMATION EXCHANGED BETWEEN THE AGC AND THE
016531,000052:                                                                                          	# COMPUTER OPERATOR.  THE INPUTS TO THE PROGRAM ARE FROM THE KEYBOARD,
016532,000053:                                                                                          	# FROM INTERNAL PROGRAMS, AND FROM THE UPLINK.
016533,000054: 
016534,000055:                                                                                          	# THE LANGUAGE OF COMMUNICATION WITH THE PROGRAM IS A PAIR OF WORDS
016535,000056:                                                                                          	# KNOWN AS VERB AND NOUN.  EACH OF THESE IS REPRESENTED BY A 2 CHARACTER
016536,000057:                                                                                          	# DECIMAL NUMBER.  THE VERB CODE INDICATES WHAT ACTION IS TO BE TAKEN, THE
016537,000058:                                                                                          	# NOUN CODE INDICATES TO WHAT THIS ACTION IS APPLIED.  NOUNS USUALLY
016538,000059:                                                                                          	# REFER TO A GROUP OF ERASABLE REGISTERS.
016539,000060: 
016540,000061:                                                                                          	# VERBS ARE GROUPED INTO DISPLAYS, LOADS, MONITORS (DISPLAYS THAT ARE
016541,000062:                                                                                          	# UPDATED ONCE PER SECOND), SPECIAL FUNCTIONS, AND EXTENDED VERBS (THESE
016542,000063:                                                                                          	# ARE OUTSIDE OF THE DOMAIN OF PINBALL AND CAN BE FOUND UNDER LOG SECTION
016543,000064:                                                                                          	# :EXTENDED VERBS:).
016544,000065: 
016545,000066:                                                                                          	# A LIST OF VERBS AND NOUNS IS GIVEN IN LOG SECTION :ASSEMBLY AND 
016546,000067:                                                                                          	# OPERATION INFORMATION:.
016547,000068: 
016582,000103: 
016583,000104:                                                                                          	# CALLING SEQUENCES -
016584,000105: 
016585,000106:                                                                                          	# KEYBOARD:
016586,000107:                                                                                          	# EACH DEPRESSION OF A KEYBOARD BUTTON ACTIVATES INTERRUPT KEYRUPT1
016587,000108:                                                                                          	# AND PLACES THE 5 BIT KEY CODE INTO CHANNEL 15.  KEYRUPT1 PLACES THE KEY
016588,000109:                                                                                          	# CODE INTO MPAC, ENTERS AN EXECUTIVE REQUEST FOR THE KEYBOARD AND DISPLAY
016589,000110:                                                                                          	# PROGRAM (AT :CHARIN:), AND EXECUTES A RESUME.
016590,000111: 
016591,000112:                                                                                          	# UPLINK:
016592,000113:                                                                                          	# EACH WORD RECEIVED BY THE UPLINK ACTIVATES INTERRUPT UPRUPT WHICH
016593,000114:                                                                                          	# PLACES THE 5 BIT KEY CODE INTO MPAC, ENTERS AN EXECUTIVE REQUEST FOR THE
016594,000115:                                                                                          	# KEYBOARD AND DISPLAY PROGRAM (AT :CHARIN:) AND EXECUTES A RESUME.
016595,000116: 
016596,000117:                                                                                          	# INTERNAL PROGRAMS:
016597,000118:                                                                                          	# INTERNAL PROGRAMS CALL PINBALL AT :NVSUB: WITH THE DESIRED VERB/NOUN
016598,000119:                                                                                          	# CODE IN A (LOW 7 BITS FOR NOUN, NEXT 7 BITS FOR VERB).  DETAILS
016599,000120:                                                                                          	# DESCRIBED ON REMARKS CARDS JUST BEFORE :NVSUB: AND :NVSBWAIT: (SEE
016600,000121:                                                                                          	# SYMBOL TABLE FOR PAGE NUMBERS).
016601,000122: 
016602,000123:                                                                                          	# NORMAL EXIT MODES -
016603,000124: 
016604,000125:                                                                                          	#       IF PINBALL WAS CALLED BY EXTERNAL ACTION, THERE ARE FOUR EXITS:
016605,000126:                                                                                          	#               1)      ALL BUT (2), (3), AND (4) EXIT DIRECTLY TO ENDOFJOB.
016606,000127:                                                                                          	#               2)      EXTENDED VERBS GO TO THE EXTENDED VERB FAN AS PART OF THE
016608,000129:                                                                                          	#                       PINBALL EXECUTIVE JOB WITH PRIORITY 30000.  IT IS THE 
016609,000130:                                                                                          	#                       RESPONSIBILITY OF THE EXTENDED VERB CALLED TO EVENTUALLY
016610,000131:                                                                                          	#                       CHANGE PRIORITY (IF NECESSARY) AND DO AN ENDOFJOB.
016611,000132:                                                                                          	#                       ALSO PINBALL IS A NOVAC JOB.  EBANK SET FOR COMMON.
016612,000133:                                                                                          	#               3)      VERB 37.  CHANGE OF PROGRAM (MAJOR MODE) CALLS :V37: IN THE
016613,000134:                                                                                          	#                       SERVICE ROUTINES AS PART OF THE PINBALL EXEC JOB WITH PRIO
016614,000135:                                                                                          	#                       30000.  THE NEW PROGRAM CODE (MAJOR MODE) IS LEFT IN A.
016615,000136:                                                                                          	#               4)      KEY RELEASE BUTTON CALLS :PINBRNCH: IN THE DISPLAY INTERFACE
016616,000137:                                                                                          	#                       ROUTINES AS PART OF THE PINBALL EXEC JOB WITH PRIO 30000 IF 
016617,000138:                                                                                          	#                       THE KEY RELEASE LIGHT IS OFF AND :CADRSTOR: IS NOT +0.
016618,000139: 
016619,000140:                                                                                          	# IF PINBALL WAS CALLED BY INTERNAL PROGRAMS, EXIT FROM PINBALL IS BACK
016620,000141:                                                                                          	# TO CALLING ROUTINE.  DETAILS DESCRIBED IN REMARKS CARDS JUST BEFORE
016621,000142:                                                                                          	# :NVSUB: AND :NVSBWAIT: (SEE SYMBOL TABLE FOR PAGE NUMBERS).
016622,000143: 
016623,000144:                                                                                          	# ALARM OR ABORT EXIT MODES -
016624,000145: 
016625,000146:                                                                                          	#       EXTERNAL INITIATION:
016626,000147:                                                                                          	#       IF SOME IMPROPER SEQUENCE OF KEY CODES IS DETECTED, THE OPERATOR
016627,000148:                                                                                          	#       ERROR LIGHT IS TURNED ON AND EXIT IS TO :ENDOFJOB:.
016628,000149: 
016629,000150:                                                                                          	#       INTERNAL PROGRAM INITIATION:
016630,000151:                                                                                          	#       IF AN ILLEGAL V/N COMBINATION IS ATTEMPTED, AN ABORT IS CAUSED
016631,000152:                                                                                          	#       (WITH OCTAL 01501).
016632,000153:                                                                                          	#       IF A SECOND ATTEMPT IS MADE TO GO TO SLEEP IN PINBALL, AN ABORT IS
016633,000154:                                                                                          	#       CAUSED (WITH OCTAL 01206). THERE ARE TWO WAYS TO GO TO SLEEP IN PINBALL:
016634,000155:                                                                                          	#               1) ENDIDLE OR DATAWAIT.
016635,000156:                                                                                          	#               2) NVSBWAIT, PRENVBSY, OR NVSUBUSY.
016636,000157: 
016637,000158:                                                                                          	# CONDITIONS LEADING TO THE ABOVE ARE DESCRIBED IN FORTHCOMING MIT/IL
016638,000159:                                                                                          	# E-REPORT DESCRIBING KEYBOARD AND DISPLAY OPERATION FOR 278.
016639,000160: 
016640,000161:                                                                                          	# OUTPUT -
016641,000162: 
016642,000163:                                                                                          	# INFORMATION TO BE SENT TO THE DISPLAY PANEL IS LEFT IN THE :DSPTAB:
016643,000164:                                                                                          	# BUFFERS REGISTERS (UNDER EXEC CONTROL). :DSPOUT: (A PART OF T4RUPT)
016644,000165:                                                                                          	# HANDLES THE PLACING OF THE :DSPTAB: INFORMATION INTO OUTPUT CHANNEL 10
016645,000166:                                                                                          	# IN INTERRUPT.
016646,000167: 
016647,000168:                                                                                          	# ERASABLE INITIALIZATION -
016648,000169: 
016649,000170:                                                                                          	# FRESH START AND RESTART INITIALIZE THE NECESSARY E REGISTERS FOR
016650,000171:                                                                                          	# PINBALL IN :STARTSUB:.  REGISTERS ARE:  DSPTAB BUFFER, CADRSTOR,
016651,000172:                                                                                          	# REQRET, CLPASS, DSPLOCK, MONSAVE, MONSAVE1, VERBREG, NOUNREG, DSPLIST,
016652,000173:                                                                                          	# DSPCOUNT, NOUT.
016653,000174: 
016654,000175:                                                                                          	# A COMPLETE LIST OF ALL THE ERASABLES (BOTH RESERVED AND TEMPORARIES) FOR
016656,000177:                                                                                          	# PINBALL IS GIVEN BELOW.
016657,000178: 
016658,000179:                                                                                          	# THE FOLLOWING ARE OF GENERAL INTEREST -
016659,000180: 
016660,000181:                                                                                          	# REMARKS CARDS PRECEDE THE REFERENCED SYMBOL DEFINITION.  SEE SYMBOL
016661,000182:                                                                                          	# TABLE TO FIND APPROPRIATE PAGE NUMBERS.
016662,000183: 
016663,000184:                                                                                          	#       NVSUB           CALLING POINT FOR INTERNAL USE OF PINBALL.
016664,000185:                                                                                          	#                       OF RELATED INTEREST     NVSBWAIT
016665,000186:                                                                                          	#                                               NVSUBUSY
016666,000187:                                                                                          	#                                               PRENVBSY
016667,000188: 
016668,000189:                                                                                          	#       ENDIDLE         ROUTINE FOR INTERNAL PROGRAMS WISHING TO GO TO SLEEP WHILE
016669,000190:                                                                                          	#                       AWAITING OPERATORS RESPONSE.
016670,000191: 
016671,000192:                                                                                          	#       DSPMM           ROUTINE BY WHICH AN INTERNAL PROGRAM MAY DISPLAY A DECIMAL
016672,000193:                                                                                          	#                       PROGRAM CODE (MAJOR MODE) IN THE PROGRAM (MAJOR MODE) LIGHTS.
016673,000194:                                                                                          	#                       (DSPMM DOES NOT DISPLAY DIRECTLY BUT ENTERS EXEC REQUEST
016674,000195:                                                                                          	#                       FOR DSPMMJB WITH PRIO 30000 AND RETURNS TO CALLER.)
016675,000196: 
016676,000197:                                                                                          	#       BLANKSUB        ROUTINE BY WHICH AN INTERNAL PROGRAM MAY BLANK ANY
016677,000198:                                                                                          	#                       COMBINATION OF THE DISPLAY REGISTERS R1, R2, R3.
016678,000199: 
016679,000200:                                                                                          	#       JAMTERM         ROUTINES BY WHICH AN INTERNAL PROGRAM MAY PERFORM THE
016680,000201:                                                                                          	#       JAMPROC         TERMINATE (V 34) OR PROCEED (V 33) FUNCTION.
016681,000202: 
016682,000203:                                                                                          	#       MONITOR         VERBS FOR PERIODIC (1 PER SEC) DISPLAY.
016683,000204: 
016684,000205:                                                                                          	#       PLEASE PERFORM, PLEASE MARK SITUATIONS
016685,000206:                                                                                          	#               REMARKS DESCRIBING HOW AN INTERNAL ROUTINE SHOULD HANDLE
016686,000207:                                                                                          	#               THESE SITUATIONS CAN BE FOUND JUST BEFORE :NVSUB: (SEE
016687,000208:                                                                                          	#               SYMBOL TABLE FOR PAGE NUMBER).
016688,000209: 
016689,000210:                                                                                          	#       THE NOUN TABLE FORMAT IS DESCRIBED ON A PAGE OF REMARKS CARDS JUST
016690,000211:                                                                                          	#       BEFORE :DSPABC: (SEE SYMBOL TABLE FOR PAGE NUMBER).
016691,000212: 
016692,000213:                                                                                          	#       THE NOUN TABLES THEMSELVES ARE FOUND IN LOG SECTION :PINBALL NOUN
016693,000214:                                                                                          	#       TABLES:.
016694,000215: 
016695,000216:                                                                                          	# FOR FURTHER DETAILS ABOUT OPERATION OF THE KEYBOARD AND DISPLAY SYSTEM
016696,000217:                                                                                          	# PROGRAM, SEE THE MISSION PLAN AND/OR MIT/IL E-2129
016697,000218:                                                                                          	# DESCRIBING KEYBOARD AND DISPLAY OPERATION FOR 278.
016698,000219: 
016704,000225: 
016705,000226:                                                                                          	# THE FOLLOWING QUOTATION IS PROVIDED THROUGH THE COURTESY OF THE AUTHORS.
016706,000227: 
016707,000228:                                                                                          	# ::IT WILL BE PROVED TO THY FACE THAT THOU HAST MEN ABOUT THEE THAT
016708,000229:                                                                                          	# USUALLY TALK OF A NOUN AND A VERB, AND SUCH ABOMINABLE WORDS AS NO
016710,000231:                                                                                          	# CHRISTIAN EAR CAN ENDURE TO HEAR.::
016711,000232:                                                                                          	#                                       HENRY 6, ACT 2, SCENE 4
016712,000233: 
016715,000236: 
016716,000237:                                                                                          	# THE FOLLOWING ASSIGNMENTS FOR PINBALL ARE MADE ELSEWHERE
016717,000238: 
016718,000239:                                                                                          	# RESERVED FOR PINBALL EXECUTIVE ACTION
016719,000240: 
016720,000241:                                                                                          	# DSPCOUNT      ERASE                   DISPLAY POSITION INDICATOR
016721,000242:                                                                                          	# DECBRNCH      ERASE                   +DEC, -DEC, OCT INDICATOR
016722,000243:                                                                                          	# VERBREG       ERASE                   VERB CODE
016723,000244:                                                                                          	# NOUNREG       ERASE                   NOUN CODE
016724,000245:                                                                                          	# XREG          ERASE                   R1 INPUT BUFFER
016725,000246:                                                                                          	# YREG          ERASE                   R2 INPUT BUFFER
016726,000247:                                                                                          	# ZREG          ERASE                   R3 INPUT BUFFER
016727,000248:                                                                                          	# XREGLP        ERASE                   LO PART OF XREG (FOR DEC CONV ONLY)
016728,000249:                                                                                          	# YREGLP        ERASE                   LO PART OF YREG (FOR DEC CONV ONLY)
016729,000250:                                                                                          	# HITEMOUT      =       YREGLP          TEMP FOR DISPLAY OF HRS, MIN, SEC
016730,000251:                                                                                          	#                                               MUST = LOTEMOUT-1.
016731,000252:                                                                                          	# ZREGLP        ERASE                   LO PART OF ZREG (FOR DEC CONV ONLY)
016732,000253:                                                                                          	# LOTEMOUT      =       ZREGLP          TEMP FOR DISPLAY OF HRS, MIN, SEC
016733,000254:                                                                                          	#                                               MUST = HITEMOUT+1.
016734,000255:                                                                                          	# MODREG        ERASE                   MODE CODE
016735,000256:                                                                                          	# DSPLOCK       ERASE                   KEYBOARD/SUBROUTINE CALL INTERLOCK
016736,000257:                                                                                          	# REQRET        ERASE                   RETURN REGISTER FOR LOAD
016737,000258:                                                                                          	# LOADSTAT      ERASE                   STATUS INDICATOR FOR LOADTST
016738,000259:                                                                                          	# CLPASS        ERASE                   PASS INDICATOR CLEAR
016739,000260:                                                                                          	# NOUT          ERASE                   ACTIVITY COUNTER FOR DSPTAB
016740,000261:                                                                                          	# NOUNCADR      ERASE                   MACHINE CADR FOR NOUN
016741,000262:                                                                                          	# MONSAVE       ERASE                   N/V CODE FOR MONITOR. (= MONSAVE1-1)
016742,000263:                                                                                          	# MONSAVE1      ERASE                   NOUNCADR FOR MONITOR (MATBS) = MONSAVE+1
016743,000264:                                                                                          	# MONSAVE2      ERASE                   NVMONOPT OPTIONS
016744,000265:                                                                                          	# DSPTAB        ERASE           +13D    0-10, DISPLAY PANEL BUFFER.11-13, C RELAYS
016745,000266:                                                                                          	# CADRSTOR      ERASE                   ENDIDLE STORAGE
016746,000267:                                                                                          	# NVQTEM        ERASE                   NVSUB STORAGE FOR CALLING ADDRESS
016747,000268:                                                                                          	#                                       MUST = NVBNKTEM-1
016748,000269:                                                                                          	# NVBNKTEM      ERASE                   NVSUB STORAGE FOR CALLING BANK
016749,000270:                                                                                          	#                                       MUST = NVQTEM+1
016750,000271:                                                                                          	# VERBSAVE      ERASE                   NEEDED FOR RECYCLE
016751,000272:                                                                                          	# DSPLIST       ERASE                   WAITING REG FOR DSP SYST INTERNAL USE
016752,000273:                                                                                          	# EXTVBACT      REASE                   EXTENDED VERB ACTIVITY INTERLOCK
016753,000274:                                                                                          	# DSPTEM1       ERASE           +2      BUFFER STORAGE AREA 1 (MOSTLY FOR TIME)
016754,000275:                                                                                          	# DSPTEM2       ERASE           +2      BUFFER STORAGE AREA 2 (MOSTLY FOR DEG)
016755,000276: 
016756,000277:                                                                                          	# END OF ERASABLES RESERVED FOR PINBALL EXECUTIVE ACTION
016757,000278: 
016758,000279:                                                                                          	# TEMPORARIES FOR PINBALL EXECUTIVE ACTION
016759,000280: 
016761,000282: 
016762,000283:                                                                                          	# DSEXIT        =       INTB15+         RETURN FOR DSPIN
016763,000284:                                                                                          	# EXITEM        =       INTB15+         RETURN FOR SCALE FACTOR ROUTINE SELECT
016764,000285:                                                                                          	# BLANKRET      =       INTB15+         RETURN FOR 2BLANK
016765,000286: 
016766,000287:                                                                                          	# WRDRET        =       INTBIT15        RETURN FOR 5BLANK
016767,000288:                                                                                          	# WDRET         =       INTBIT15        RETURN FOR DSPWD
016768,000289:                                                                                          	# DECRET        =       INTBIT15        RETURN FOR PUTCOM(DEC LOAD)
016769,000290:                                                                                          	# 21/22REG      =       INTBIT15        TEMP FOR CHARIN
016770,000291: 

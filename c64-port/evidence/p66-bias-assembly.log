034209,000128:                                                                                          	# DDUMCALC IS PROGRAMMED AS FOLLOWS:-
034210,000129:                                                                                          	#                                         2                                           -
034211,000130:                                                                                          	#              (RIGNZ - RGU )/16 + 16(RGU  )KIGNY/B8 + (RGU - RIGNX)KIGNX/B4 + (ABVAL(VGU) - VIGN)KIGNV/B4
034212,000131:                                                                                          	#                          2             1                 0
034213,000132:                                                                                          	#       DDUM = -------------------------------------------------------------------------------------------
034214,000133:                                                                                          	#                                                10
034215,000134:                                                                                          	#                                               2   (VGU - 16 VGU KIGNX/B4)
034217,000136:                                                                                          	#                                                       2        0
034218,000137:                                                                                          	# THE NUMERATOR IS SCALED IN METERS AT 2(28).  THE DENOMINATOR IS A VELOCITY IN UNITS OF 2(10) M/CS.
034219,000138:                                                                                          	# THE QUOTIENT IS THUS A TIME IN UNITS OF 2(18) CENTISECONDS.  THE FINAL SHIFT RESCALES TO UNITS OF 2(28) CS.
034220,000139:                                                                                          	# THERE IS NO DAMPING FACTOR.  THE CONSTANTS KIGNX/B4, KIGNY/B8 AND KIGNV/B4 ARE ALL NEGATIVE IN SIGN.

014073,000029:                                                                                          	## Notations on the hardcopy document read, in part:
014074,000030:                                                                                          	##
014075,000031:                                                                                          	##      Assemble revision 001 of AGC program LMY99 by NASA 2021112-61
014076,000032:                                                                                          	##      16:27 JULY 14, 1969 
014077,000033: 
014079,000035:                                                                                          	# SUBROUTINE NAME:      V89CALL
014080,000036:                                                                                          	# MOD NO:       0                       DATE:           9 JAN 1968
014081,000037:                                                                                          	# MOD BY:       DIGITAL DEVEL GROUP     LOG SECTION:    R63
014082,000038: 
014083,000039:                                                                                          	# FUNCTIONAL DESCRIPTION:
014084,000040: 
014085,000041:                                                                                          	# CALLED BY VERB 89 ENTER DURING P00.  PRIO 10 USED.  CALCULATES AND
014086,000042:                                                                                          	# DISPLAYS FINAL FDAI BALL ANGLES TO POINT LM +X OR +Z AXIS AT CSM.
014087,000043: 
014088,000044:                                                                                          	# 1. KEY IN V 89 E ONLY IF IN PROG 00.  IF NOT IN P00, OPERATOR ERROR AND
014089,000045:                                                                                          	# EXIT R63, OTHERWISE CONTINUE.
014090,000046: 
014091,000047:                                                                                          	# 2. IF IN P00, DO IMU STATUS CHECK ROUTINE (R02BOTH).  IF IMU ON AND ITS
014092,000048:                                                                                          	# ORIENTATION KNOWN TO LGC, CONTINUE.
014093,000049: 
014094,000050:                                                                                          	# 3. FLASH DISPLAY V 04 N 06.  R2 INDICATES WHICH SPACECRAFT AXIS IS TO
014095,000051:                                                                                          	# BE POINTED AT CSM.  INITIAL CHOICE IS PREFERRED (+Z) AXIS (R2=1).
014096,000052:                                                                                          	# ASTRONAUT CAN CHANGE TO (+X) AXIS (R2 NOT =1) BY V 22 E 2 E.  CONTINUE
014097,000053:                                                                                          	# AFTER KEYING IN PROCEED.
014098,000054: 
014099,000055:                                                                                          	# 4. BOTH VEHICLE STATE VECTORS UPDATED BY CONIC EQS.
014100,000056: 
014101,000057:                                                                                          	# 5. HALF MAGNITUDE UNIT LOS VECTOR (IN STABLE MEMBER COORDINATES) AND
014102,000058:                                                                                          	# HALF MAGNITUDE UNIT SPACECRAFT AXIS VECTOR (IN BODY COORDINATES)
014103,000059:                                                                                          	# PREPARED FOR VECPOINT.
014104,000060: 
014105,000061:                                                                                          	# 6. GIMBAL ANGLES FROM VECPOINT TRANSFORMED INTO FDAI BALL ANGLES BY
014106,000062:                                                                                          	# BALLANGS.  FLASH DISPLAY V 06 N 18 AND AWAIT RESPONSE.
014107,000063: 
014108,000064:                                                                                          	# 7.    RECYCLE - RETURN TO STEP 4.
014109,000065:                                                                                          	#       TERMINATE - EXIT R63.
014110,000066:                                                                                          	#       PROCEED - RESET 3AXISFLG AND CALL R60LEM FOR ATTITUDE MANEUVER.
014111,000067: 
014112,000068:                                                                                          	# CALLING SEQUENCE:     V 89 E.
014113,000069: 
014114,000070:                                                                                          	# SUBROUTINES CALLED:   CHKPOOH, R02BOTH, GOXDSPF, CSMCONIC, LEMCONIC,
014115,000071:                                                                                          	#                       VECPOINT, BALLANGS, R60LEM.
014116,000072: 
014117,000073:                                                                                          	# NORMAL EXIT MODES:    TC ENDEXT
014118,000074: 
014119,000075:                                                                                          	# ALARMS:       1. OPERATOR ERROR IF NOT IN P00.
014120,000076:                                                                                          	#               2. PROGRAM ALARM IF IMU IS OFF.
014121,000077:                                                                                          	#               3. PROGRAM ALARM IF IMU ORIENTATION IS UNKNOWN.
014122,000078: 
014123,000079:                                                                                          	# OUTPUT:       NONE
014124,000080: 
014125,000081:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:  NONE
014126,000082: 
014127,000083:                                                                                          	# DEBRIS:       OPTION1, +1, TDEC1, POINTVSM, SCAXIS, CPHI, CTHETA, CPSI,
014129,000085:                                                                                          	#               3AXISFLG.
014130,000086: 

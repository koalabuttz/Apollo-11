020097,003618:    4506           04473                           TC       RELDSP2                       	# +0 EMPTY. TURN OFF KEY RLSE LIGHT
020098,003619:    4507           34755                           CAF      ZERO                          	# -  NOT EMPTY. LEAVE KEY RLSE LIGHT ALONE
020099,003620:    4510           55012                           TS       DSPLOCK                       	#
020100,003621:    4511           00144                           TC       RELRET                        	#

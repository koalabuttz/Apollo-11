057857,000888:                                                                                          	# AVETOMID
057858,000889: 
057859,000890:                                                                                          	# THIS ROUTINE PERFORMS THE TRANSITION FROM A THRUSTING PHASE TO THE COAST
057860,000891:                                                                                          	# PHASE BY INITIALIZING THIS VEHICLES PERMANENT STATE VECTOR WITH THE
057861,000892:                                                                                          	# VALUES LEFT BY THE AVERAGEG ROUTINE IN RN,VN,PIPTIME.
057862,000893: 
057863,000894:                                                                                          	# BEFORE THIS IS DONE THE W-MATRIX, IF ITS VALID (ORWFLAG OR RENDWFLG IS
057864,000895:                                                                                          	# SET) IS INTEGRATED FORWARD TO PIPTIME WITH THE PRE-THRUST STATE VECTOR.
057865,000896: 
057866,000897:                                                                                          	# IN ADDITION, THE OTHER VEHICLE IS INTEGRATED (PERMANENT) TO PIPTIME.
057867,000898: 
057868,000899:                                                                                          	# FINALLY TRKMKCNT IS ZEROED
057869,000900: 

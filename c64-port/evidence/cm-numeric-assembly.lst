011137,000940:                                                                                          	# TRACKTRM      VERB 56         DESCRIPTION
011138,000941:                                                                                          	#       TERMINATE TRACKING (P20)
011139,000942:                                                                                          	#       1.      KNOCK DOWN RENDEZVOUS, TRACK, AND UPDATE FLAGS.
011140,000943:                                                                                          	#       2.      REQUIRE P20 NOT RUNNING ALONE OR GO TO GOTOPOOH (REQUEST PROGRAM 00).
011141,000944:                                                                                          	#       3.      REQUIRE R22 RUNNING OR GO TO PINBRNCH.
011142,000945:                                                                                          	#       4.      IF INTEGRATION RUNNING, STALL UNTIL IT IS COMPLETED, THEN ZERO GROUPS 2 AND 3 TO KILL R21 + R22.
011143,000946:                                                                                          	#       3.      KNOCK DOWN RENDEZVOUS, R22, R21, TRACK, UPDATE, AND TARG1 FLAGS.
011144,000947:                                                                                          	#       4.      GO TO ENEMA (SOFTWARE RESTART).
011145,000948:                                                                                          	#       REFERENCE
011146,000949:                                                                                          	#               P20     RENDEZVOUS      NAVIGATION.
011147,000950:                                                                                          	#               R21     RENDEZVOUS      TRACKING SIGHTING MARK.

021611,001351: 04,2661           43215                           DAD      DAD                           	# CONVERT -MGA TO +MGA BY
021612,001352: 04,2662           10646                                    HALFREV                       	# ADDING ONE REVOLUTION
021613,001353: 04,2663           10646                                    HALFREV                       	#
021614,001354: 04,2664           03626        SETMGA             STORE    +MGA                          	#
021615,001355: 04,2665           43414                           CLR      RVQ                           	# CLEAR MGLVFLAG TO INDICATE +MGA CALC
021616,001356: 04,2666           02675                                    MGLVFLAG                      	# AND EXIT
021617,001357: 
021618,001358: 04,2667           77614        MIDGIM1            BOFF                                   	#
021619,001359: 04,2670           02747                                    COMPUTER                      	#
021620,001360: 04,2671           10654                                    GET+MGA                       	#
021621,001361: 

046298,000006:                                                                                          	##              Apollo Guidance Computer (AGC), for Apollo 11.
046299,000007:                                                                                          	## Assembler:   yaYUL
046300,000008:                                                                                          	## Contact:     Ron Burkey <info@sandroid.org>.
046301,000009:                                                                                          	## Website:     www.ibiblio.org/apollo.
046302,000010:                                                                                          	## Pages:       1037-1038
046303,000011:                                                                                          	## Mod history: 2009-05-13 RSB  Adapted from the Colossus249/ file of the
046304,000012:                                                                                          	##                              same name, using Comanche055 page images.
046305,000013:                                                                                          	##              2009-05-20 RSB  A "Page N" comment was corrected.
046306,000014:                                                                                          	##              2016-12-21 RSB  Proofed comment text using octopus/ProoferComments
046307,000015:                                                                                          	##                              but no errors found.
046308,000016:                                                                                          	##
046309,000017:                                                                                          	## This source code has been transcribed or otherwise adapted from digitized
046310,000018:                                                                                          	## images of a hardcopy from the MIT Museum.  The digitization was performed
046311,000019:                                                                                          	## by Paul Fjeld, and arranged for by Deborah Douglas of the Museum.  Many
046312,000020:                                                                                          	## thanks to both.  The images (with suitable reduction in storage size and
046313,000021:                                                                                          	## consequent reduction in image quality as well) are available online at
046314,000022:                                                                                          	## www.ibiblio.org/apollo.  If for some reason you find that the images are
046315,000023:                                                                                          	## illegible, contact me at info@sandroid.org about getting access to the 
046316,000024:                                                                                          	## (much) higher-quality images which Paul actually created.
046317,000025:                                                                                          	##
046318,000026:                                                                                          	## Notations on the hardcopy document read, in part:
046319,000027:                                                                                          	##
046320,000028:                                                                                          	##      Assemble revision 055 of AGC program Comanche by NASA
046321,000029:                                                                                          	##      2021113-051.  10:28 APR. 1, 1969  
046322,000030:                                                                                          	##
046323,000031:                                                                                          	##      This AGC program shall also be referred to as
046324,000032:                                                                                          	##                      Colossus 2A
046325,000033: 
046327,000035:                                                                                          	# CALCULATION OF  AMGB, AMBG  ONCE EVERY SECOND
046328,000036: 
046329,000037:                                                                                          	#       AMGB =  1       SIN(PSI)                0
046330,000038:                                                                                          	#               0       COS(PSI)COS(PHI)        SIN(PHI)
046331,000039:                                                                                          	#               0       -COS(PSI)SIN(PHI)       COS(PHI)
046332,000040: 
046333,000041:                                                                                          	#       AMBG =  1       -TAN(PSI)COS(PHI)       TAN(PSI)SIN(PHI)
046334,000042:                                                                                          	#               0       COS(PHI)/COS(PSI)       -SIN(PHI)/COS(PSI)
046335,000043:                                                                                          	#               0       SIN(PHI)                COS(PHI)
046336,000044: 
046337,000045:                                                                                          	# WHERE PHI AND PSI ARE CDU ANGLES
046338,000046: 
046339,000047: 20,3612                                           BANK     20                            	#
046340,000048: 22,2000                                           SETLOC   DAPS8                         	#
046341,000049: 22,2000                                           BANK                                   	#
046342,000050: 
046343,000051: 22,3447                                           COUNT*   $$/DAPEX                      	#
046344,000052: 22,3447  E6,1510                                  EBANK=   KMPAC                         	#
046345,000053: 22,3447           30102        AMBGUPDT           CA       FLAGWRD6                      	# CHECK FOR RCS AUTOPILOT
046346,000054: 22,3450           00006                           EXTEND                                 	#
046347,000055: 22,3451           65217                           BZMF     ENDOFJOB                      	# BIT15 = 0, BIT14 = 1
046348,000056: 22,3452           75002                           MASK     BIT14                         	# IF NOT RCS, EXIT
046349,000057: 22,3453           00006                           EXTEND                                 	#
046350,000058: 22,3454           15217                           BZF      ENDOFJOB                      	# TO PROTECT TVC DAP ON SWITCHOVER
046351,000059: 
046352,000060: 22,3455           30034                           CA       CDUZ                          	#
046353,000061: 22,3456           05075                           TC       SPSIN2                        	#
046354,000062: 22,3457           55640                           TS       AMGB1                         	# CALCULATE AMGB
046355,000063: 22,3460           30034                           CA       CDUZ                          	#
046356,000064: 22,3461           05074                           TC       SPCOS2                        	#
046357,000065: 22,3462           55645                           TS       CAPSI                         	# MUST CHECK FOR GIMBAL LOCK
046358,000066: 22,3463           33507                           CAF      QUADANGL                      	# = 7.25  DEGREES JET QUAD ANGULAR OFFSET
046359,000067: 22,3464           00006                           EXTEND                                 	#
046360,000068: 22,3465           20032                           MSU      CDUX                          	#
046361,000069: 22,3466           40000                           COM                                    	# CDUX - 7.25 DEG
046362,000070: 22,3467           05074                           TC       SPCOS1                        	#
046363,000071: 22,3470           55644                           TS       AMGB8                         	#
046364,000072: 22,3471           00006                           EXTEND                                 	#
046365,000073: 22,3472           71645                           MP       CAPSI                         	#
046366,000074: 22,3473           55641                           TS       AMGB4                         	#
046367,000075: 22,3474           33507                           CAF      QUADANGL                      	#
046368,000076: 22,3475           00006                           EXTEND                                 	#
046369,000077: 22,3476           20032                           MSU      CDUX                          	#
046370,000078: 22,3477           40000                           COM                                    	# CDUX - 7.25 DEG
046371,000079: 22,3500           05075                           TC       SPSIN1                        	#
046372,000080: 22,3501           55642                           TS       AMGB5                         	#
046373,000081: 22,3502           00006                           EXTEND                                 	#
046374,000082: 22,3503           71645                           MP       CAPSI                         	#
046375,000083: 22,3504           40000                           COM                                    	#
046377,000085: 22,3505           55643                           TS       AMGB7                         	#
046378,000086: 22,3506           15217                           TCF      ENDOFJOB                      	#
046379,000087: 22,3507           01224        QUADANGL           DEC      660        B-14               	# = 7.25 DEGREES
046380,000088: 
(End of include-file RCS-CSM_DAP_EXECUTIVE_PROGRAMS.agc, resuming MAIN.agc)

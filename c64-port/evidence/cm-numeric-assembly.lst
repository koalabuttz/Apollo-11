012694,000274: 23,2155           44301        LOG                NORM     BDSU                          	# GENERATES LOG BY SHIFTING ARG
012695,000275: 23,2156           00160                                    MPAC       +3                 	# UNTIL IT LIES BETWEEN .5 AND 1.
012696,000276: 23,2157           06212                                    NEARLY1                       	# THE LOG OF THIS PART IS FOUND AND THE
012697,000277: 23,2160           77776                           EXIT                                   	# LOG OF THE SHIFTED PART IS COMPUTED
012698,000278: 23,2161           07171                           TC       POLY                          	# AND ADDED IN.  SHIFT COUNT STORED
012699,000279: 23,2162           00002                           DEC      2          B-14               	# (N-1, SUPPLIED BY SMERZH)
012700,000280: 23,2163           00000 00000                     2DEC     0          B-28               	# IN MPAC +3.

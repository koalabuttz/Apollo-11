037586,000219: 
037587,000220:                                                                                          	# JJ            INDEX IN FINAL PHASE TABLE LOOK-UP
037588,000221: 
037589,000222:                                                                                          	# MM            INDEX IN FINAL PHASE TABLE LOOK-UP
037590,000223: 
037591,000224:                                                                                          	# GRAD          INTERPOLATION FACTOR IN FINAL PHASE
037592,000225: 
037593,000226:                                                                                          	# FX            DRANGE/D L/D = F3                       2700 NM
037594,000227: 
037595,000228:                                                                                          	# FX +1         AREF                                    805 FPSS
037596,000229: 
037597,000230:                                                                                          	# FX +2         RTOGO                                   2700 NM
037598,000231: 
037599,000232:                                                                                          	# FX +3         RDOTREF                                 VSAT/4
037600,000233: 
037601,000234:                                                                                          	# FX +4         DRANGE/D RDOT = F2                      21600/2VS NM/FPS
037602,000235: 
037603,000236:                                                                                          	# FX +5         DRANGE/D DRAG = F1                      2700/805 NM/FPSS
037604,000237: 
037605,000238:                                                                                          	# TEM1B         TEMPORARY LOCATION
037606,000239: 
037607,000240:                                                                                          	# TIME/RTO      TIME OF INITIAL TARGET RTINIT           B 28 CENTISEC
037608,000241: 
037609,000242:                                                                                          	# DTEAROT       EST TIME BETWEEN RTINIT AND RT          B 28 CENTISEC
037610,000243:                                                                                          	# -
037611,000244:                                                                                          	# UNITV         UNIT V VECTOR                           2
037612,000245:                                                                                          	# -
037613,000246:                                                                                          	# UNITR         UNIT R VECTOR                           2
037614,000247:                                                                                          	#  -
037615,000248:                                                                                          	# -VREL         NEGATIVE VELOCITY REL TO ATMOSP         2 VSAT
037616,000249: 
037617,000250:                                                                                          	# COMPUTER SWITCHES                                     INITIAL STATE           CM/FLAGS = STATE +6
037618,000251:                                                                                          	# -------- --------                                     -------------           -------------------
037619,000252: 
037620,000253:                                                                                          	# ENTRYDSP      DO ENTRY DISPLAY, IF SET                NON-BRANCH (1)          92D, BIT 13
037621,000254:                                                                                          	# GONEPAST      INDICATES OVERSHOOT OF TARGET           NON-BRANCH (0)          95D, BIT 10
037622,000255:                                                                                          	# RELVELSW      RELATIVE VELOCITY SWITCH                NON-BRANCH (0)          96D, BIT 9
037623,000256:                                                                                          	# EGSW          FINAL PHASE SWITCH                      NON-BRANCH (0)          97D, BIT 8
037624,000257:                                                                                          	# FIRSTPAS      INITIAL PASS THRU HUNTEST               NON-BRANCH (0)          98D, BIT 7
037625,000258:                                                                                          	# HIND          INDICATES ITERATION IN HUNTEST          NON-BRANCH (0)          99D, BIT 6
037626,000259:                                                                                          	# INRLSW        INDICATES INIT ROLL ATTITUDE SET        NON-BRANCH (0)          100D, BIT 5
037627,000260:                                                                                          	# LATSW         INHIBIT DOWNLIFT SWITCH IF NOT SET          BRANCH (1)          101D, BIT 4
037628,000261:                                                                                          	# .05GSW        INDICATES DRAG EXCEEDS .05 GS               BRANCH (0)          102D, BIT 3
037629,000262: 
037630,000263:                                                                                          	# GONEBY        INDICATES GONE PAST TARGET (SET)        SELF-INITIALZNG 112D, BIT 8
037631,000264: 

045875,000089: 21,3316           00000        MINTAU             DEC      0          B-14               	#
045876,000090: 21,3317           00027                           DEC      23         B-14               	# = 14MS
045877,000091: 21,3320           77750                           DEC      -23        B-14               	# = -14MS
045878,000092: 21,3321           00000                           DEC      0          B-14               	#
045879,000093: 
045881,000095:                                                                                          	# CALCULATION OF ATTITUDE ERRORS-
045882,000096:                                                                                          	#       -    *     -      -          -
045883,000097:                                                                                          	#       AK = AMGB (CDUX - THETADX) + BIAS
045884,000098: 
045885,000099:                                                                                          	# IE    *AK *   * 1        SIN(PSI)        0    ** CDUX - THETADX *    *BIAS *
045886,000100:                                                                                          	#       *   *   *                               **                *    *     *
045887,000101:                                                                                          	#       *AK1* = * 0   COS(PSI)COS(PHI)  SIN(PHI)** CDUY - THETADY *  + *BIAS1*
045888,000102:                                                                                          	#       *   *   *                               **                *    *     *
045889,000103:                                                                                          	#       *AK2*   * 0  -COS(PSI)SIN(PHI)  COS(PHI)** CDUZ - THETADZ *    *BIAS2*
045890,000104: 
045891,000105:                                                                                          	# THE BIASES ARE ADDED ONLY WHILE PERFORMING AUTOMATIC MANEUVERS (ESP KALCMANU) TO PROVIDE ADDITIONAL LEAD
045892,000106:                                                                                          	# AND PREVENT OVERSHOOT WHEN STARTING AN AUTOMATIC MANEUVER.  NORMALLY THE REQUIRED LEAD IS ONLY 1-2 DEGREES.
045893,000107:                                                                                          	# BUT DURING HIGH RATE MANEUVERS IT CAN BE AS MUCH AS 7 DEGREES.  THE BIASES ARE COMPUTED BY KALCMANU AND REMAIN
045894,000108:                                                                                          	# FIXED UNTIL THE MANEUVER IS COMPLETED AT WHICH TIME THEY ARE RESET TO ZERO.
045895,000109: 
045896,000110: 21,3322           30032        ATTHOLD            CA       CDUX                          	#
045897,000111: 21,3323           00006                           EXTEND                                 	#
045898,000112: 21,3324           21572                           MSU      THETADX                       	#
045899,000113: 21,3325           55567                           TS       ERRORX                        	#

007658,000187:                                                                                          	# Page 184
007659,000188: 05,2407           54371                           TS       NVSAVE                        	#
007660,000189: 05,2410           55071                           TS       EBANKTEM                      	#
007661,000190: 05,2411           55130                           TS       RATEINDX                      	#
007662,000191: 05,2412           55126                           TS       TRKMKCNT                      	#
007663,000192: 05,2413           55125                           TS       VHFCNT                        	#
007664,000193: 05,2414           55044                           TS       EXTVBACT                      	#
007665,000194: 
007666,000195: 05,2415           41036                           CS       DSPTAB     +11D               	#
007667,000196: 05,2416           75033                           MASK     BITS4&6                       	#
007668,000197: 05,2417           10000                           CCS      A                             	#
007669,000198: 05,2420           02424                           TC       +4                            	#
007670,000199: 05,2421           35033                           CA       BITS4&6                       	#
007671,000200: 05,2422           00006                           EXTEND                                 	# THE IMU WAS IN COARSE ALIGN IN GIMBAL

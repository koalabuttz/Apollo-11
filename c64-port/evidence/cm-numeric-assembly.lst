037789,000038: 
037791,000040:                                                                                          	# ENTRY INITIALIZATION ROUTINE
037792,000041:                                                                                          	#  -----------------------------
037793,000042: 
037794,000043: 25,2000                                           BANK     25                            	#
037795,000044: 25,2000                                           SETLOC   REENTRY                       	#
037796,000045: 25,2000                                           BANK                                   	#
037797,000046: 
037798,000047: 25,2000                                           COUNT*   $$/ENTRY                      	#
037799,000048: 25,2000  E7,1451                                  EBANK=   RTINIT                        	#
037800,000049: 
037801,000050: 25,2000     5060               EBENTRY            =        EBANK7                        	#
037802,000051: 25,2000     5057               EBAOG              EQUALS   EBANK6                        	#
037803,000052: 25,2000     5002               NTRYPRIO           EQUALS   PRIO20                        	# (SERVICER)
037804,000053: 25,2000     0102               CM/FLAGS           EQUALS   STATE      +6                 	#
037805,000054: 
037806,000055: 25,2000           77776        STARTENT           EXIT                                   	# MM = 63
037807,000056: 
037808,000057:                                                                                          	# COME HERE FROM CM/POSE.  RESTARTED IN CM/POSE.
037809,000058: 25,2001           42113                           CS       ENTMASK                       	# INITIALIZE ALL SWITCHES TO ZERO
037810,000059:                                                                                          	# EXCEPT LATSW, ENTRYDSP AND GONEPAST.
037811,000060:                                                                                          	# GONEBY 112D BIT8 FLAG7, SELF INITIALIZING
037812,000061: 25,2002           00004                           INHINT                                 	#
037813,000062: 25,2003           70102                           MASK     CM/FLAGS                      	#
037814,000063:                                                                                          	# ENTRYDSP = 92D B13
037815,000064:                                                                                          	# GONEPAST=95D B10,     RELVELSW=96D B9
037816,000065:                                                                                          	# EGSW = 97D B8         NOSWITCH = 98D B7
037817,000066:                                                                                          	# HIND=99D B6           INRLSW=100D B5
037818,000067:                                                                                          	# LATSW=101D B4         .05GSW=102D B3
037819,000068: 
037820,000069: 25,2004           62114                           AD       ENTRYSW                       	# SET ENTRYDSP, LATSW, GONEPAST.
037821,000070: 25,2005           54102                           TS       CM/FLAGS                      	#
037822,000071: 
037823,000072: 25,2006           00003                           RELINT                                 	#
037824,000073: 
037825,000074: 25,2007           06006                           TC       INTPRET                       	#
037826,000075: 
037827,000076: 25,2010           77735                           SLOAD                                  	#
037828,000077: 25,2011           03011                                    LODPAD                        	#
037829,000078: 25,2012           03626                           STORE    LOD                           	#
037830,000079: 
037831,000080: 25,2013           77735                           SLOAD                                  	#
037832,000081: 25,2014           03010                                    LADPAD                        	#
037833,000082: 25,2015           03624                           STORE    LAD                           	#
037834,000083: 
037835,000084: 25,2016           77605                           DMP                                    	# L/DCMINR = LAD COS(15)
037836,000085: 25,2017           15323                                    COS15                         	#
037837,000086: 25,2020           17630                           STODL    L/DCMINR                      	#
037838,000087: 25,2021           15146                                    LATSLOPE                      	#
037839,000088: 25,2022           70405                           DMP      SR1                           	# KLAT = LAD/24
037840,000089: 25,2023           03624                                    LAD                           	#
037842,000091: 25,2024           17632                           STODL    KLAT                          	#
037843,000092: 25,2025           15177                                    Q7F                           	#
037844,000093: 25,2026           17175                           STODL    Q7                            	# Q7 = Q7F
037845,000094: 25,2027           17372                                    NEARONE                       	# 1.0 -1BIT
037846,000095: 25,2030           17614                           STODL    FACTOR                        	#
037847,000096: 25,2031           03624                                    LAD                           	#
037848,000097: 25,2032           57565                           SIGN     DCOMP                         	#
037849,000098: 25,2033           03327                                    HEADSUP                       	# MAY BE NOISE FOR DISPLAY P61
037850,000099: 25,2034           37634                           STCALL   L/D                           	# L/D = - LAD SGN(HEADSUP)
037851,000100: 
037852,000101: 25,2035           52063                                    STARTEN1                      	# RETURN VIA GOTOADDR
037853,000102: 25,2036           47375                           VLOAD    VXV                           	#
037854,000103: 25,2037           01177                                    VN                            	# (-7) M/CS
037855,000104: 25,2040           01760                                    UNITR                         	# .5 UNIT               REF COORDS
037856,000105: 25,2041           50256                           UNIT     DOT                           	#
037857,000106: 25,2042           03474                                    RT                            	# RT/2 TARGET VECTOR    REF COORDS
037858,000107: 25,2043           03676                           STORE    LATANG                        	# LATANG = UNI.RT /4
037859,000108: 25,2044           47076                           DCOMP    RTB                           	#
037860,000109: 25,2045           45712                                    SIGNMPAC                      	#
037861,000110: 25,2046           17644                           STODL    K2ROLL                        	# K2ROLL = -SGN(LATANG)
037862,000111: 
037863,000112: 25,2047           03624                                    LAD                           	#

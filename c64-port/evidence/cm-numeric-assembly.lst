061823,000198: 
061824,000199: 01,3663           10000                           CCS      A                             	# IS IT A JOB OR IT IT TIMED
061825,000200: 01,3664           24000                           INCR     A                             	# POSITIVE, MUST BE A JOB
061826,000201: 01,3665           13740                           TCF      ITSAJOB2                      	#
061827,000202: 
061828,000203: 01,3666           24000                           INCR     A                             	# MUST BE EITHER A WAITLIST OR LONGCALL
061829,000204: 01,3667           54705                           TS       GOLOC                         	# LET-S STORE THE CORRECT CADR
061830,000205: 
061831,000206: 01,3670           33766                           CA       WTLTCADR                      	# SET UP OUR EXIT TO WAITLIST
061832,000207: 01,3671           54704                           TS       GOLOC      -1                 	#
061833,000208: 
061834,000209: 01,3672           30706                           CA       GOLOC      +1                 	# NOW FIND OUT IF IT IS A WAITLIST CALL
061835,000210: 01,3673           75006                           MASK     BIT10                         	# THIS SHOULD BE ONE IF WE HAVE -BB
061836,000211: 01,3674           10000                           CCS      A                             	# FOR THAT MATTER SO SHOULD BE BITS 9,8,7,
061837,000212:                                                                                          	# 6,5, AND LAST BUT NOT LEAST (PERHAPS NOT
061838,000213:                                                                                          	# IN IMPORTANCE ANYWAY. BIT 4
061839,000214: 01,3675           13733                           TCF      ITSWTLST                      	# IT IS A WAITLIST CALL
061840,000215: 
061841,000216: 01,3676           50156                           NDX      POINTER                       	# OBTAIN THE ORIGINAL DELTA T
061842,000217: 01,3677           32000                           CA       PRDTTAB                       	# ADDRESS FOR THIS LONGCALL
061843,000218: 
061844,000219: 01,3700           15507                           TCF      ITSLGCL1                      	# NOW GO GET THE DELTA TIME
061845,000220: 
061846,000221:                                                                                          	# ***** THIS MUST BE IN FIXED FIXED *****
061847,000222: 
061848,000223:    5507                                           BLOCK    02                            	#
061849,000224:    4000                                           SETLOC   FFTAG2                        	#
061850,000225:    4000                                           BANK                                   	#

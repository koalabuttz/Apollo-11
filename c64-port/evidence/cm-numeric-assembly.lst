018346,000138: 20,2066           00006                           EXTEND                                 	# FOR AUTOMATIC MANEUVERS
018347,000139: 20,2067           30025                           DCA      TIME2                         	#
018348,000140: 20,2070           21717                           DAS      TM                            	# TM+T0    MANEUVER COMPLETION TIME
018349,000141: 20,2071           45041                           CS       1SEC                          	#
018350,000142: 20,2072           54001                           TS       L                             	#
018351,000143: 20,2073           45021                           CS       ZERO                          	#
018352,000144: 20,2074           21717                           DAS      TM                            	# (TM+T0)-1
018353,000145: 20,2075           00004                           INHINT                                 	#
018354,000146: 20,2076           45017                           CS       ONE                           	# ENABLE AUTOPILOT TO PERFORM
018355,000147: 20,2077           55332                           TS       HOLDFLAG                      	# AUTOMATIC MANEUVERS
018356,000148: 20,2100           41130                           CS       RATEINDX                      	# SEE IF MANEUVERING AT HIGH RATE
018357,000149: 20,2101           66211                           AD       SIX                           	#
018358,000150: 20,2102           00006                           EXTEND                                 	#
018359,000151: 20,2103           62105                           BZMF     HIGHGAIN                      	#
018360,000152: 20,2104           12110                           TCF      +4                            	#
018361,000153: 20,2105           41501        HIGHGAIN           CS       RCSFLAGS                      	# IF SO, SET HIGH RATE FLAG (BIT 15 OF
018362,000154: 20,2106           75001                           MASK     BIT15                         	# RCSFLAGS)
018363,000155: 20,2107           27501                           ADS      RCSFLAGS                      	#
018364,000156: 20,2110           53711                           DXCH     BRATE                         	# X-AXIS MANEUVER RATE
018365,000157: 20,2111           53526                           DXCH     WBODY                         	#
018366,000158: 20,2112           53713                           DXCH     BRATE      +2                 	# Y-AXIS MANEUVER RATE
018367,000159: 20,2113           53530                           DXCH     WBODY1                        	#
018368,000160: 20,2114           53715                           DXCH     BRATE      +4                 	# Z-AXIS MANEUVER RATE
018369,000161: 20,2115           53532                           DXCH     WBODY2                        	#
018370,000162: 20,2116           31675                           CA       BIASTEMP   +1                 	# INSERT ATTITUDE ERROR BIASES

049572,000319: 
049573,000320:    6263           17543                           TCF      DMPR                          	# 20 -- DP MULTIPLY AND ROUND.
049574,000321:    6264           17546                           TCF      DDV                           	# 21 -- DP DIVIDE BY.
049575,000322:    6265           17552                           TCF      BDDV                          	# 22 -- DP DIVIDE INTO.
049576,000323:    6266           17570                           TCF      GSHIFT                        	# 23 -- GENERAL SHIFT INSTRUCTION
049577,000324:    6267           16720                           TCF      VAD                           	# 24 -- VECTOR ADD.

054481,000349: 26,3625           57545        EARTHL             DLOAD    DCOMP                         	#
054482,000350: 26,3626           01716                                    AXO                           	#
054483,000351: 26,3627           14017                           STODL    504LPL                        	#
054484,000352: 26,3630           01714                                    -AYO                          	#
054485,000353: 26,3631           14021                           STODL    504LPL     +2                 	#
054486,000354: 26,3632           15335                                    HI6ZEROS                      	#
054487,000355: 26,3633           24023                           STOVL    504LPL     +4                 	#
054488,000356: 26,3634           00017                                    504LPL                        	#
054489,000357: 26,3635           77616                           RVQ                                    	#

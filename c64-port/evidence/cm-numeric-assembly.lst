052060,002807:                                                                                          	# Page 1192
052061,002808:                                                                                          	# THE FOLLOWING INSTRUCTIONS ARE AVAILABLE FOR SETTING, MODIFYING, AND BRANCHING ON INDEX REGISTERS:
052062,002809:                                                                                          	#       1.      AXT     ADDRESS TO INDEX TRUE.
052063,002810:                                                                                          	#       2.      AXC     ADDRESS TO INDEX COMPLEMENTED.
052064,002811:                                                                                          	#       3.      LXA     LOAD INDEX FROM ERASABLE.
052065,002812:                                                                                          	#       4.      LXC     LOAD INDEX COMPLEMENTED FROM ERASABLE.
052066,002813:                                                                                          	#       5.      SXA     STORE INDEX IN ERASABLE.
052067,002814:                                                                                          	#       6.      XCHX    EXCHANGE INDEX REGISTER WITH ERASABLE.
052068,002815:                                                                                          	#       7.      INCR    INCREMENT INDEX REGISTER.
052069,002816:                                                                                          	#       8.      XAD     ERASABLE ERASABLE ADD TO INDEX REGISTER.
052070,002817:                                                                                          	#       9.      XSU     ERASABLE SUBTRACT FROM INDEX REGISTER.
052071,002818:                                                                                          	#       10.     TIX     BRANCH ON INDEX REGISTER AND DECREMENT.
052072,002819: 
052073,002820: 01,2371                                           BANK     01                            	#
052074,002821: 
052075,002822: 01,2371                                           COUNT    01/INTER                      	#
052076,002823: 
052077,002824: 01,2371           02466        AXT                TC       TAGSUB                        	# SELECT APPROPRIATE INDEX REGISTER.
052078,002825: 01,2372           30117                           CA       POLISH                        	#
052079,002826: 01,2373           50130        XSTORE             INDEX    INDEXLOC                      	# CONTAINS C(FIXLOC) OR C(FIXLOC)+1
052080,002827: 01,2374           54046                           TS       X1                            	#
052081,002828: 01,2375           16030                           TCF      DANZIG                        	#
052082,002829: 
052083,002830: 01,2376           02466        AXC                TC       TAGSUB                        	#
052084,002831: 01,2377           40117                           CS       POLISH                        	#
052085,002832: 01,2400           02373                           TC       XSTORE                        	#
052086,002833: 
052087,002834: 01,2401           02454        LXA                TC       15ADRERS                      	# LOAD INDEX REGISTER FROM ERASABLE.
052088,002835: 01,2402           50117                           INDEX    POLISH                        	#

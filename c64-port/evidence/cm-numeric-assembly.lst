047356,000040: 
047358,000042:                                                                                          	# SUBROUTINE TO READ GYMBAL ANGLES AND FORM DIFFERENCES.  GIMBAL ANGLES ARE SAVED IN 2S COMPLEMENT, BUT THE
047359,000043:                                                                                          	# DIFFERENCES ARE IN 1S COMP.  ENTER AND READ ANGLES EACH .1 SEC.
047360,000044: 
047361,000045:                                                                                          	#       CM/DSTBY = 1 FOR DAP OPERATION
047362,000046:                                                                                          	#       CM/DSTBY = 0 TO TERMINATE DAP OPERATION.
047363,000047: 
047364,000048: 15,2434                                           BANK     15                            	#
047365,000049: 
047366,000050: 15,2000                                           SETLOC   ETRYDAP                       	#
047367,000051: 15,2000                                           BANK                                   	#
047368,000052: 
047369,000053: 15,2434                                           COUNT    15/DAPEN                      	#
047370,000054: 
047371,000055: 15,2434  E6,1661                                  EBANK=   AOG                           	#
047372,000056: 
047373,000057: 15,2434           34377        READGYMB           CA       TEN                           	# KEEP RESTART DT GOING RELATIVE TO
047374,000058: 15,2435           27725                           ADS      CM/GYMDT                      	# PIPTIME.  (GROUP 6)
047375,000059: 
047376,000060:                                                                                          	# IF A RESTART OCCURS, SKIP PRESENT CYCLE.  THE
047377,000061:                                                                                          	# PHASCHNG PROTECTION IS IN CM/DAPIC.
047378,000062: 
047379,000063: 15,2436           35012                           CA       BIT6                          	# CHECK FOR FINE ALIGN MODE OF CDU.
047380,000064: 15,2437           71321                           MASK     IMODES33                      	# (PROTECT AOG/PIP ETC AS WELL AS
047381,000065: 15,2440           00006                           EXTEND                                 	# GIMBAL DIFFERENCES)
047382,000066: 15,2441           12447                           BZF      READGYM1                      	# OK
047383,000067: 
047384,000068: 15,2442           45017                           CS       BIT1                          	# NOT IN FINE ALIGN, SO IDLE.
047385,000069: 15,2443           70102                           MASK     CM/FLAGS                      	# SET GYMDIFSW = 0
047386,000070: 15,2444           54102                           TS       CM/FLAGS                      	#
047387,000071: 15,2445           06000                           TC       FLUSHJET                      	# QUENCH JETS, SINCE MAY BE A WHILE.
047388,000072: 15,2446           02514                           TC       CM/GYMIC   +2                 	#
047389,000073: 
047390,000074: 15,2447           30032        READGYM1           CA       CDUX                          	#
047391,000075: 15,2450           57661                           XCH      AOG                           	#
047392,000076: 15,2451           00006                           EXTEND                                 	#
047393,000077: 15,2452           21661                           MSU      AOG                           	# -DELAOG=AOG(N-1) - AOG(N)
047394,000078: 15,2453           55675                           TS       -DELAOG                       	#
047395,000079: 
047396,000080: 15,2454           30033                           CA       CDUY                          	#
047397,000081: 15,2455           57662                           XCH      AIG                           	#
047398,000082: 15,2456           00006                           EXTEND                                 	#
047399,000083: 15,2457           21662                           MSU      AIG                           	#
047400,000084: 15,2460           55676                           TS       -DELAIG                       	#
047401,000085: 
047402,000086: 15,2461           30034                           CA       CDUZ                          	#
047403,000087: 15,2462           57663                           XCH      AMG                           	#
047404,000088: 15,2463           00006                           EXTEND                                 	#
047405,000089: 15,2464           21663                           MSU      AMG                           	#
047406,000090: 15,2465           55677                           TS       -DELAMG                       	#
047407,000091: 
047409,000093: 15,2466           40102        DOBRATE?           CS       CM/FLAGS                      	# CM/DSTBY=103D BIT2  GYMDIFSW=104D BIT1
047410,000094: 15,2467           76214                           MASK     THREE                         	#
047411,000095: 15,2470           50000                           INDEX    A                             	#
047412,000096: 15,2471           02472                           TC       +1                            	#
047413,000097: 15,2472           02501                           TC       DOBRATE                       	# OK, GO ON
047414,000098: 15,2473           02512                           TC       CM/GYMIC                      	# DONT CALC BODYRATE ON FIRST PASS.
047415,000099: 15,2474           12475                           NOOP                                   	#
047416,000100: 15,2475           06000                           TC       FLUSHJET                      	# TURN OFF ALL JETS
047417,000101: 
047418,000102: 15,2476           05412                           TC       PHASCHNG                      	#
047419,000103: 15,2477           00006                           OCT      00006                         	# DEACTIVATE DAP GROUP 6.
047420,000104: 
047421,000105: 15,2500           05324                           TC       TASKOVER                      	#
047422,000106: 
047423,000107: 15,2501           35017        DOBRATE            CA       ONE                           	# DO BODYRATE
047424,000108: 15,2502           55720        DOBRATE1           TS       JETEM                         	# SKIP BODYRATE.
047425,000109: 
047426,000110: 15,2503           34377                           CA       TEN                           	# KEEP CDU READ GOING.
047427,000111: 15,2504           05245                           TC       WAITLIST                      	#
047428,000112: 15,2505  E6,1661                                  EBANK=   AOG                           	#
047429,000113: 15,2505           02434 32066                     2CADR    READGYMB                      	#
047430,000114: 
047431,000115:                                                                                          	# DOES NOT PROTECT TEMK, SQ IN SPSIN/COS
047432,000116: 
047433,000117: 15,2507           11720                           CCS      JETEM                         	#
047434,000118: 15,2510           02536                           TC       BODYRATE                      	#
047435,000119: 15,2511           05324                           TC       TASKOVER                      	# SKIP CALC ON INITIAL PASS.  (PASSES)
047436,000120: 
047437,000121: 15,2512           26102        CM/GYMIC           ADS      CM/FLAGS                      	# GYMDIFSW:  C(A)=1, KNOW BIT IS 0
047438,000122: 15,2513           35021                           CAF      ZERO                          	#
047439,000123: 15,2514           55711                           TS       JETAG                         	#
047440,000124: 15,2515           55706                           TS       OLDELP                        	#
047441,000125: 15,2516           55707                           TS       OLDELQ                        	#
047442,000126: 15,2517           55710                           TS       OLDELR                        	#
047443,000127: 15,2520           55723                           TS       GAMDOT                        	# NO GYM DIF, PROB NO GAM DIF.
047444,000128: 15,2521           02502                           TC       DOBRATE1                      	#
047445,000129: 
047447,000131:                                                                                          	# COME HERE TO CORRECT FOR OVERFLOW IN ANGULAR CALCULATIONS
047448,000132: 
047449,000133: 15,2522           54001        ANGOVCOR           TS       L                             	# THIS COSTS 2 MCT TO USE.
047450,000134: 15,2523           00002                           TC       Q                             	# NO OVFL
047451,000135: 15,2524           50000                           INDEX    A                             	#
047452,000136: 15,2525           35000                           CAF      LIMITS                        	#
047453,000137: 15,2526           26001                           ADS      L                             	#
047454,000138: 15,2527           00002                           TC       Q                             	#
047455,000139: 
047456,000140:    6000                                           BLOCK    3                             	#
047457,000141: 
047458,000142:    6000                                           COUNT    03/DAPEN                      	#
047459,000143: 
047460,000144:    6000           30007        FLUSHJET           CA       7                             	# COME HERE TO TURN OFF ALL JETS.
047461,000145:    6001           00006                           EXTEND                                 	#
047462,000146:    6002           01006                           WRITE    ROLLJETS                      	# ZERO CHANNEL 6
047463,000147:    6003           00006                           EXTEND                                 	#
047464,000148:    6004           01005                           WRITE    PYJETS                        	# ZERO CHANNEL 5
047465,000149:    6005           00002                           TC       Q                             	#
047466,000150: 
047467,000151: 15,2530                                           BANK     15                            	#
047468,000152: 
047469,000153: 15,2530                                           COUNT    15/DAPEN                      	#
047470,000154: 

023453,000034:                                                                                          	##
023454,000035:                                                                                          	## Notations on the hardcopy document read, in part:
023455,000036:                                                                                          	##
023456,000037:                                                                                          	##    Assemble revision 055 of AGC program Comanche by NASA
023457,000038:                                                                                          	##    2021113-051.  10:28 APR. 1, 1969  
023458,000039:                                                                                          	##
023459,000040:                                                                                          	##    This AGC program shall also be referred to as
023460,000041:                                                                                          	##            Colossus 2A
023461,000042: 
023463,000044: 
023464,000045:                                                                                          	# EARTH ORBIT INSERTION MONITOR PROGRAM
023465,000046:                                                                                          	# *************************************
023466,000047: 
023467,000048:                                                                                          	# PROGRAM DESCRIPTION -P11-
023468,000049: 
023469,000050:                                                                                          	#       MOD NO. 1
023470,000051:                                                                                          	#       MOD BY ELIASSEN
023471,000052: 
023472,000053:                                                                                          	# FUNCTIONAL DESCRIPTION
023473,000054: 
023474,000055:                                                                                          	#       P11 IS INITIATED BY
023475,000056: 
023476,000057:                                                                                          	#               A) GYROCOMPASS PRG P02 WHEN LIFTOFF DISCRETE IS RECEIVED OR
023477,000058:                                                                                          	#               B) BACKUP THRU VERB 75 ENTER
023478,000059: 
023479,000060:                                                                                          	#       PROGRAM WILL
023480,000061:                                                                                          	#               1. ZERO CMC CLOCK AT LIFTOFF (OR UPON RECEIPT OF BACKUP)
023481,000062:                                                                                          	#               2. UPDATE TEPHEM TO TIME CMC CLOCK WAS ZEROED
023482,000063:                                                                                          	#               3. INITIATE SERVICER AT PREREAD1
023483,000064:                                                                                          	#               4. CHANGE MAJOR MODE TO 11
023484,000065:                                                                                          	#               5. CLEAR DSKY IN CASE OF V 75
023485,000066:                                                                                          	#               6. STORE LIFTOFF IMU-CDU ANGLES FOR ATT. ERROR DISPLAY
023486,000067:                                                                                          	#               7. TERMINATE GYROCOMPASSING     -   -
023487,000068:                                                                                          	#               8. COMPUTE INITIAL VECTORS      RN, VN            -  -  -
023488,000069:                                                                                          	#               9. COMPUTE REFSMMAT FOR PRELAUNCH ALIGNMENT WHERE U ,U ,U  ARE
023489,000070:                                                                                          	#                       -        -                                 X  Y  Z
023490,000071:                                                                                          	#                       U =UNIT(-R)     LOCAL VERTICAL AT TIME OF LIFTOFF
023491,000072:                                                                                          	#                        Z     
023492,000073:                                                                                          	#                       -       -       -
023493,000074:                                                                                          	#                       U =UNIT(A),     A=HOR VECTOR AT LAUNCH AZIMUTH
023494,000075:                                                                                          	#                        X
023495,000076:                                                                                          	#                       -  -   -
023496,000077:                                                                                          	#                       U =U * U
023497,000078:                                                                                          	#                        U  Z   X
023498,000079:                                                                                          	#               10. SET REFSMMAT KNOWN FLAG
023499,000080:                                                                                          	#               11. SET AVGEXIT IN SERVICER TO VHHDOT TO
023500,000081:                                                                                          	#                   COMPUTE AND DISPLAY NOUN 62 EVERY 2 SECONDS
023501,000082: 
023502,000083:                                                                                          	#                       R1      V1   - INTERTIAL VELOCITY MAGNITUDE IN FPS
023503,000084:                                                                                          	#                       R2      HDOT - RATE OF CHANGE OF VEHICLE VEL IN FPS
023504,000085:                                                                                          	#                       R3      H    - VEHICLE ALTITUDE ABOVE PAD IN NM
023505,000086:                                                                                          	#               
023506,000087:                                                                                          	#               12. DISPLAY BODY AXES ATT. ERRORS ON FDAI NEEDLES
023507,000088: 
023508,000089:                                                                                          	#                       A) FROM L.O. TO RPSTART (APPROX. 0 TO +10SECS AFTER L.O.)
023509,000090:                                                                                          	#                          DESIRED ATTITUDE IS AS STORED AT L.O.
023510,000091:                                                                                          	#                       B) FROM RPSTART TO POLYSTOP (APPROX. +10 TO +133SECS AFTER LO)
023511,000092:                                                                                          	#                          DESIRED ATTITUDE IS SPECIFIED BY CMC PITCH AND ROLL
023512,000093:                                                                                          	#                          POLYNOMIALS DURING SATURN ROLLOUT AND PITCHOVER
023514,000095:                                                                                          	#                          THE DISPLAY IS RUN AS LOW PRIORITY JOB APPROX.
023515,000096:                                                                                          	#                          EVERY 1/2 SEC OR LESS AND IS DISABLED UPON OVFLO OF TIME1
023516,000097: 
023517,000098:                                                                                          	# SUBROUTINES CALLED
023518,000099: 
023519,000100:                                                                                          	#       2PHSCHNG        BANKCALL        CALCGRA         CDUTRIG         CLEANDSP        DANZIG
023520,000101:                                                                                          	#       DELAYJOB        EARTHR          ENDOFJOB        FINDVAC         IBNKCALL
023521,000102:                                                                                          	#       INTPRET         LALOTORV        NEEDLER         NEWMODEX        PHASCHNG
023522,000103:                                                                                          	#       POSTJUMP        POWRSERS        PREREAD1        REGODSPR        S11.1
023523,000104:                                                                                          	#       SERVEXIT        TASKOVER        TCDANZIG        V1ST02S         WAITLIST
023524,000105: 
023525,000106:                                                                                          	# ASTRONAUT REQUESTS (IF ALTITUDE ABOVE 300,000 FT)
023526,000107: 
023527,000108:                                                                                          	#       DSKY -
023528,000109:                                                                                          	#               MONITOR DISPLAY OF TIME TO PERIGEE R1 HOURS
023529,000110:                                                                                          	#                                                  R2 MINUTES
023530,000111: 
023531,000112:                                                                                          	#       DSKY -
023532,000113:                                                                                          	#               MONITOR DISPLAY OF R1 APOGEE ALTITUDE IN NAUTICAL MILES
023533,000114:                                                                                          	#                                  R2 PERIGEE ALTITUDE IN NAUTICAL MILES
023534,000115:                                                                                          	#                                  R3 TFF IN MINUTES/SECS
023535,000116: 
023536,000117:                                                                                          	#       IF ASTRONAUT HAS REQUESTED ANY OF THESE DISPLAYS HE MUST
023537,000118:                                                                                          	# HIT PROCEED TO RETURN TO NORMAL NOUN 62 DISPLAY
023538,000119:                                                                                          	# NORMAL EXIT MODE
023539,000120: 
023540,000121:                                                                                          	#       ASTRONAUT       VERB 37 ENTER 00 ENTER
023541,000122: 
023542,000123:                                                                                          	# ALARM MODES - NONE
023543,000124: 
023544,000125:                                                                                          	# ABORT EXIT MODES -
023545,000126: 
023546,000127:                                                                                          	# OUTPUT
023547,000128: 
023548,000129:                                                                                          	#       TLIFTOFF (DP)   TEPHEM (TP)
023549,000130:                                                                                          	#       REFSMMAT
023550,000131:                                                                                          	#       DSKY DISPLAY
023551,000132:                                                                                          	#       FDAI DISPLAY
023552,000133: 
023553,000134:                                                                                          	# ERASABLE INITIALIZATION
023554,000135: 
023555,000136:                                                                                          	#       AZO, AXO, -AYO
023556,000137:                                                                                          	#       LATITUDE
023557,000138:                                                                                          	#       PADLONG
023558,000139:                                                                                          	#       TEPHEM
023559,000140:                                                                                          	#       PGNCSALT
023560,000141:                                                                                          	#       POLYNUM THRU POLYNUM +14D)
023561,000142:                                                                                          	#       RPSTART
023562,000143:                                                                                          	#       POLYSTOP

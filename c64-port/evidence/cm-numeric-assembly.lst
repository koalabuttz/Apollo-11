016723,003501: 
016724,003502:                                                                                          	# IF MPAC, +1 ARE EACH +NZ OR +0 AND C(A)=-0, SHORTMP WRONGLY GIVES +0.
016725,003503:                                                                                          	# IF MPAC, +1 ARE EACH -NZ OR -0 AND C(A)=+0, SHORTMP WRONGLY GIVES +0.
016726,003504:                                                                                          	# PRSHRTMP FIXES FIRST CASE ONLY, BY MERELY TESTING C(A) AND IF IT = -0,
016727,003505:                                                                                          	# SETTING RESULT TO -0.
016728,003506: 
016729,003507:                                                                                          	# (DO NOT USE PRSHRTMP UNLESS MPAC, +1 ARE EACH +NZ OR +0, AS THEY ARE
016730,003508:                                                                                          	# WHEN THEY CONTAIN THE SF CONSTANTS.)
016731,003509: 
016732,003510:    4431           54135        PRSHRTMP           TS       MPTEMP                        	#
016733,003511:    4432           10000                           CCS      A                             	#
016734,003512:    4433           30135                           CA       MPTEMP                        	# C(A) +,  DO REGULAR SHORTMP
016735,003513:    4434           17257                           TCF      SHORTMP    +1                 	# C(A) +0, DO REGULAR SHORTMP
016736,003514:    4435           14433                           TCF      -2                            	# C(A) -,  DO REGULAR SHORTMP
016737,003515:    4436           45021                           CS       ZERO                          	# C(A) -0, FORCE RESULT TO -0 AND RETURN.
016738,003516:    4437           54154                           TS       MPAC                          	#
016739,003517:    4440           54155                           TS       MPAC       +1                 	#
016740,003518:    4441           54156                           TS       MPAC       +2                 	#

022599,000120: 23,2351           02344                           TC       -5                            	# DATA IN.  OPTIONX +1 = 1 FOR THIS VEHIC.
022600,000121:                                                                                          	#                UNEQ 1 FOR OTHER VEHICLE.
022601,000122: 23,2352           35014                           CAF      BIT4                          	# 80 MS
022602,000123: 23,2353           05245                           TC       WAITLIST                      	#
022603,000124: 23,2354  E4,1743                                  EBANK=   TFF                           	#
022604,000125: 23,2354           02531 46064                     2CADR    TICKTEST                      	#
022605,000126: 
022606,000127: 23,2356           00003                           RELINT                                 	#
022607,000128: 23,2357           32410        V82GOFLP           CAF      TFFBANK                       	# MAJOR RECYCLE LOOP ENTRY
022608,000129: 23,2360           54003                           TS       EBANK                         	#
022609,000130: 23,2361           35021                           CAF      ZERO                          	#
022610,000131: 23,2362           55742                           TS       V82FLAGS                      	# ZERO FLAGS FOR TICKTEST. INHIBITS
022611,000132:                                                                                          	# DECREMENTING OF TFF AND -TPER.
022612,000133: 23,2363           35063                           CAF      PRIO7                         	#
022613,000134: 23,2364           05147                           TC       FINDVAC                       	# V82GOFF1 WILL EXECUTE STATE VECTOR
022615,000136: 23,2365  E4,1743                                  EBANK=   TFF                           	# UPDATE AND ORBIT CALCULATIONS FOR
022616,000137: 23,2365           02411 46064                     2CADR    V82GOFF1                      	# SELECTED VEHICLE ABOUT PROPER BODY.
022617,000138: 
022618,000139: 23,2367           00003                           RELINT                                 	#
022619,000140: 23,2370           36214        V82STALL           CAF      THREE                         	# STALL IN THIS LOOP AND WITHOLD V 16 N 44
022620,000141: 23,2371           71742                           MASK     V82FLAGS                      	# UNTIL STATE VECTOR UPDATE SETS ONE OF
022621,000142: 23,2372           10000                           CCS      A                             	# OUR FLAG BITS.
022622,000143: 23,2373           02400                           TC       FLAGGON                       	# EXIT FROM STALL LOOP.
022623,000144: 23,2374           35041                           CAF      1SEC                          	#
022624,000145: 23,2375           04662                           TC       BANKCALL                      	#
022625,000146: 23,2376           01732                           CADR     DELAYJOB                      	#
022626,000147: 23,2377           02370                           TC       V82STALL                      	#
022627,000148: 
022628,000149: 23,2400           32407        FLAGGON            CAF      V16N44                        	# MONITOR HAPO,HPER,TFF.
022629,000150: 23,2401           04662                           TC       BANKCALL                      	#
022630,000151: 23,2402           20561                           CADR     GOXDSPF                       	#

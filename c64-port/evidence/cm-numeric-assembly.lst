020301,000041: 
020303,000043:                                                                                          	# TRANSFER PHASE INITIATION (TPI) PROGRAMS (P34 AND P74)
020304,000044:                                                                                          	# MOD NO -1                     LOG SECTION - P32-P35, P72-P75
020305,000045:                                                                                          	# MOD BY WHITE.P                DATE 1JUNE67
020306,000046: 
020307,000047:                                                                                          	# PURPOSE
020308,000048:                                                                                          	#       (1)     TO CALCULATE THE REQUIRED DELTA V AND OTHER INITIAL CONDITIONS
020309,000049:                                                                                          	#               REQUIRED BY THE ACTIVE VEHICLE FOR EXECUTION OF THE TRANSFER
020310,000050:                                                                                          	#               PHASE INITIATION (TPI) MANEUVER, GIVEN -
020311,000051:                                                                                          	#               (A)     TIME OF IGNITION TIG (TPI) OR THE ELEVATION ANGLE (E) OF
020312,000052:                                                                                          	#                       THE ACTIVE/PASSIVE VEHICLE LOS AT TIG (TPI).
020313,000053:                                                                                          	#               (B)     CENTRAL ANGLE OF TRANSFER (CENTANG) FROM TIG (TPI) TO
020314,000054:                                                                                          	#                       INTERCEPT TIME (TIG (TPF)).
020315,000055:                                                                                          	#       (2)     TO CALCULATE TIG (TPI) GIVEN E OR E GIVEN TIG (TPI).
020316,000056:                                                                                          	#       (3)     TO CALCULATE THESE PARAMETERS BASED UPON MANEUVER DATA
020317,000057:                                                                                          	#               APPROVED AND KEYED INTO THE DSKY BY THE ASTRONAUT.
020318,000058:                                                                                          	#       (4)     TO DISPLAY TO THE ASTRONAUT AND THE GROUND CERTAIN DEPENDENT
020319,000059:                                                                                          	#               VARIABLES ASSOCIATED WITH THE MANEUVER FOR APPROVAL BY THE
020320,000060:                                                                                          	#               ASTRONAUT/GROUND.
020321,000061:                                                                                          	#       (5)     TO STORE THE TPI TARGET PARAMETERS FOR USE BY THE DESIRED
020322,000062:                                                                                          	#               THRUSTING PROGRAM.
020323,000063: 
020324,000064:                                                                                          	# ASSUMPTIONS
020325,000065:                                                                                          	#       (1)     LM ONLY - THIS PROGRAM IS BASED UPON PREVIOUS COMPLETION OF
020326,000066:                                                                                          	#               THE CONSTANT DELTA ALTITUDE (CDH) PROGRAM (P33/P73).
020327,000067:                                                                                          	#               THEREFORE -
020328,000068:                                                                                          	#               (A)     AT A SELECTED TPI TIME (NOW IN STORAGE) THE LINE OF SIGHT
020329,000069:                                                                                          	#                       BETWEEN THE ACTIVE AND PASSIVE VEHICLES WAS SELECTED TO BE
020330,000070:                                                                                          	#                       A PRESCRIBED ANGLE (E) (NOW IN STORAGE) FROM THE
020331,000071:                                                                                          	#                       HORIZONTAL PLANE DEFINED BY THE ACTIVE VEHICLE POSITION.
020332,000072:                                                                                          	#               (B)     THE TIME BETWEEN CDH IGNITION AND TPI IGNITION WAS
020333,000073:                                                                                          	#                       COMPUTED TO BE GREATER THAN 10 MINUTES.
020334,000074:                                                                                          	#               (C)     THE VARIATION OF THE ALTITUDE DIFFERENCE BETWEEN THE
020335,000075:                                                                                          	#                       ORBITS WAS MINIMIZED.
020336,000076:                                                                                          	#               (D)     THE PERICENTER ALTITUDES OF ORBITS FOLLOWING CSI AND
020337,000077:                                                                                          	#                       CDH WERE COMPUTED TO BE GREATER THAN 35,000 FT FOR LUNAR
020339,000079:                                                                                          	#                       ORBIT OR 85 NM FOR EARTH ORBIT.
020340,000080:                                                                                          	#               (E)     THE CSI AND CDH MANEUVERS WERE ASSUMED TO BE PARALLEL TO
020341,000081:                                                                                          	#                       THE PLANE OF THE PASSIVE VEHICLE ORBIT.  HOWEVER, CREW
020342,000082:                                                                                          	#                       MODIFICATION OF DELTA V (LV) COMPONENTS MAY HAVE RESULTED
020343,000083:                                                                                          	#                       IN AN OUT-OF-PLANE MANEUVER.
020344,000084:                                                                                          	#       (2)     STATE VECTOR UPDATED BY P27 ARE DISALLOWED DURING AUTOMATIC
020345,000085:                                                                                          	#               STATE VECTOR UPDATING INITIATED BY P20 (SEE ASSUMPTION (4)).
020346,000086:                                                                                          	#       (3)     THIS PROGRAM MUST BE DONE OVER A TRACKING STATION FOR REAL
020347,000087:                                                                                          	#               TIME GROUND PARTICIPATION IN DATA INPUT AND OUTPUT.  COMPUTED
020348,000088:                                                                                          	#               VARIABLES MAY BE STORED FOR LATER VERIFICATION BY THE GROUND.
020349,000089:                                                                                          	#               THESE STORAGE CAPABILITIES ARE LIMITED ONLY TO THE PARAMETERS
020350,000090:                                                                                          	#               FOR ONE THRUSTING MANEUVER AT A TIME EXCEPT FOR CONCENTRIC
020351,000091:                                                                                          	#               FLIGHT PLAN MANEUVER SEQUENCES.
020352,000092:                                                                                          	#       (4)     THE RENDEZVOUS RADAR MAY OR MAY NOT BE USED TO UPDATE THE LM
020353,000093:                                                                                          	#               OR CSM STATE VECTORS FOR THIS PROGRAM.  IF RADAR USE IS
020354,000094:                                                                                          	#               DESIRED THE RADAR WAS TURNED ON AND LOCKED ON THE CSM BY
020355,000095:                                                                                          	#               PREVIOUS SELECTION OF P20.  RADAR SIGHTING MARKS WILL BE MADE
020356,000096:                                                                                          	#               AUTOMATICALLY APPROXIMATELY ONCE A MINUTE WHEN ENABLED BY THE
020357,000097:                                                                                          	#               TRACK AND UPDATE FLAGS (SEE P20).  THE RENDEZVOUS TRACKING
020358,000098:                                                                                          	#               MARK COUNTER IS ZEROED BY THE SELECTION OF P20 AND AFTER EACH
020359,000099:                                                                                          	#               THRUSTING MANEUVER.
020360,000100:                                                                                          	#       (5)     THE ISS NEED NOT BE ON TO COMPLETE THIS PROGRAM.
020361,000101:                                                                                          	#       (6)     THE OPERATION OF THE PROGRAM UTILIZES THE FOLLOWING FLAGS -
020362,000102: 
020363,000103:                                                                                          	#                       ACTIVE VEHICLE FLAG - DESIGNATES THE VEHICLE WHICH IS
020364,000104:                                                                                          	#                       DOING RENDEZVOUS THRUSTING MANEUVERS TO THE PROGRAM WHICH
020365,000105:                                                                                          	#                       CALCULATES THE MANEUVER PARAMETERS.  SET AT THE START OF
020366,000106:                                                                                          	#                       EACH RENDEZVOUS PRE-THRUSTING PROGRAM.
020367,000107: 
020368,000108:                                                                                          	#                       FINAL FLAG - SELECTS FINAL PROGRAM DISPLAYS AFTER CREW HAS
020369,000109:                                                                                          	#                       SELECTED THE FINAL MANEUVER COMPUTATION CYCLE.
020370,000110: 
020371,000111:                                                                                          	#                       EXTERNAL DELTA V FLAG - DESIGNATES THE TYPE OF STEERING
020372,000112:                                                                                          	#                       REQUIRED FOR EXECUTION OF THIS MANEUVER BY THE THRUSTING
020373,000113:                                                                                          	#                       PROGRAM SELECTED AFTER COMPLETION OF THIS PROGRAM.
020374,000114: 
020375,000115:                                                                                          	#       (7)     ONCE THE PARAMETWRS REQUIRED FOR COMPUTION OF THE MANEUVER
020376,000116:                                                                                          	#               HAVE BEEN COMPLETELY SPECIFIED, THE VALUE OF THE ACTIVE
020377,000117:                                                                                          	#               VEHICLE CENTRAL ANGLE OF TRANSFER IS COMPUTED AND STORED.
020378,000118:                                                                                          	#               THIS NUMBER WILL BE AVAILABLE FOR DISPLAY TO THE ASTRONAUT
020379,000119:                                                                                          	#               THROUGH THE USE OF V06N52.
020380,000120: 
020381,000121:                                                                                          	#               THE ASTRONAUT WILL CALL THIS DISPLAY TO VERIFY THAT THE
020382,000122:                                                                                          	#               CENTRAL ANGLE OF TRANSFER OF THE ACTIVE VEHICLE IS NOT WITHIN
020384,000124:                                                                                          	#               170 TO 190 DEGREES.  IF THE ANGLE IS WITHIN THIS ZONE THE
020385,000125:                                                                                          	#               ASTRONAUT SHOULD REASSESS THE INPUT TARGETING PARAMETERS BASED
020386,000126:                                                                                          	#               UPON DELTA V AND EXPECTED MANEUVER TIME.
020387,000127:                                                                                          	#       (8)     THIS PROGRAM IS SELECTED BY THE ASTRONAUT BY DSKY ENTRY -
020388,000128: 
020389,000129:                                                                                          	#                       P34 IF THIS VEHICLE IS ACTIVE VEHICLE.
020390,000130: 
020391,000131:                                                                                          	#                       P74 IF THIS VEHICLE IS PASSIVE VEHICLE.
020392,000132: 
020393,000133:                                                                                          	# INPUT
020394,000134:                                                                                          	#       (1)     TTPI    TIME OF THE TPI MANEUVER
020395,000135:                                                                                          	#       (2)     ELEV    DESIRED LOS ANGLE AT TPI
020396,000136:                                                                                          	#       (3)     CENTANG ORBITAL CENTRAL ANGLE OF THE PASSIVE VEHICLE DURING
020397,000137:                                                                                          	#                       TRANSFER FROM TPI TO TIME OF INTERCEPT
020398,000138: 
020399,000139:                                                                                          	# OUTPUT
020400,000140:                                                                                          	#       (1)     TRKMKCNT        NUMBER OF MARKS
020401,000141:                                                                                          	#       (2)     TTOGO           TIME TO GO
020402,000142:                                                                                          	#       (3)     +MGA            MIDDLE GIMBAL ANGLE
020403,000143:                                                                                          	#       (4)     TTPI            COMPUTED TIME OF TPI MANEUVER
020404,000144:                                                                                          	#                OR
020405,000145:                                                                                          	#               ELEV            COMPUTED LOS ANGLE AT TPI
020406,000146:                                                                                          	#       (5)     POSTTPI         PERIGEE ALTITUDE AFTER THE TPI MANEUVER
020407,000147:                                                                                          	#       (6)     DELVTPI         MAGNITUDE OF DELTA V AT TPI
020408,000148:                                                                                          	#       (7)     DELVTPF         MAGNITUDE OF DELTA V AT INTERCEPT
020409,000149:                                                                                          	#       (8)     DVLOS           DELTA VELOCITY AT TPI - LINE OF SIGHT
020410,000150:                                                                                          	#       (9)     DELVLVC         DELTA VELOCITY AT TPI - LOCAL VERTICAL COORDINATES
020411,000151: 
020412,000152:                                                                                          	# DOWNLINK
020413,000153:                                                                                          	#       (1)     TTPI            TIME OF THE TPI MANEUVER
020414,000154:                                                                                          	#       (2)     TIG             TIME OF THE TPI MANEUVER
020415,000155:                                                                                          	#       (3)     ELEV            DESIRED LOS ANGLE AT TPI
020416,000156:                                                                                          	#       (4)     CENTANG         ORBITAL CENTRAL ANGLE OF THE PASSIVE VEHICLE DURING
020417,000157:                                                                                          	#                               TRANSFER FROM TPI TO TIME OF INTERCEPT
020418,000158:                                                                                          	#       (5)     DELVEET3        DELTA VELOCITY AT TPI - REFERENCE COORDINATES
020419,000159:                                                                                          	#       (6)     TPASS4          TIME OF INTERCEPT
020420,000160: 
020421,000161:                                                                                          	# COMMUNICATION TO THRUSTING PROGRAMS
020422,000162:                                                                                          	#       (1)     TIG             TIME OF THE TPI MANEUVER
020423,000163:                                                                                          	#       (2)     RTARG           OFFSET TARGET POSITION
020424,000164:                                                                                          	#       (3)     TPASS4          TIME OF INTERCEPT
020425,000165:                                                                                          	#       (4)     XDELVFLG        RESET TO INDICATE LAMBERT (AIMPOINT) VG COMPUTATION

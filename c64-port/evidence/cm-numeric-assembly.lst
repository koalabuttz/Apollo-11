011415,001218: 43,3072           50120                           INDEX    FIXLOC                        	#
011416,001219: 43,3073           54052                           TS       QPRET                         	#
011417,001220: 43,3074           04701                           TC       POSTJUMP                      	#
011418,001221: 43,3075           27457                           CADR     INTWAKE                       	#
011419,001222: 
011420,001223: 43,3076           77634        TCPIN              RTB                                    	#
011421,001224: 43,3077           21272                                    PINBRNCH                      	#
011422,001225: 
011423,001226: 43,3100           00051        OCT51              OCT      51                            	#
011424,001227: 43,3101           67076        TCPINAD            CADR     TCPIN                         	#

005721,000153: 06,2071           42173        HANG20             CS       11,14,9                       	#
005722,000154: 06,2072           27302                           ADS      DSRUPTSW                      	#
005723,000155: 
005724,000156: 06,2073           37700                           CAF      20MRUPT                       	#
005725,000157: 
005726,000158: 06,2074           54027        SETTIME4           TS       TIME4                         	#
005727,000159: 
005729,000161:                                                                                          	# THE STATUS OF THE PROCEED PUSHBUTTON IS MONITORED EVERY 120 MILLISECONDS VIA THE CHANNEL 32 BIT 14 INBIT.
005730,000162:                                                                                          	# THE STATE OF THIS INBIT IS COMPARED WITH ITS STATE DURING THE PREVIOUS T4RUPT AND IS PROCESSED AS FOLLOWS.
005731,000163:                                                                                          	#       IF PREV ON AND NOW ON   - BYPASS
005732,000164:                                                                                          	#       IF PREV ON AND NOW OFF  - UPDATE IMODES33
005733,000165:                                                                                          	#       IF PREV OFF AND NOW ON  - UPDATE IMODES33 AND PROCESS VIA PINBALL
005734,000166:                                                                                          	#       IF PREV OFF AND NOW OFF - BYPASS
005735,000167:                                                                                          	# THE LOGIC EMPLOYED REQUIRES ONLY 9 MCT (APPROX. 108 MICROSECONDS) OF COMPUTER TIME WHEN NO CHANGES OCCUR.
005736,000168: 
005737,000169: 06,2075           31321        PROCEEDE           CA       IMODES33                      	# MONITIOR FOR PROCEED BUTTON
005738,000170: 06,2076           00006                           EXTEND                                 	#
005739,000171: 06,2077           06032                           RXOR     CHAN32                        	# CHECK IF BIT 14 DIFFERENT
005740,000172: 06,2100           75002                           MASK     BIT14                         	#
005741,000173: 06,2101           00006                           EXTEND                                 	#
005742,000174: 06,2102           12116                           BZF      T4JUMP                        	# NO CHANGE
005743,000175: 
005744,000176: 06,2103           23321                           LXCH     IMODES33                      	#
005745,000177: 06,2104           00006                           EXTEND                                 	#
005746,000178: 06,2105           06001                           RXOR     LCHAN                         	#
005747,000179: 06,2106           55321                           TS       IMODES33                      	# UPDATE IMODES33
005748,000180: 06,2107           75002                           MASK     BIT14                         	#
005749,000181: 06,2110           10000                           CCS      A                             	#
005750,000182: 06,2111           12116                           TCF      T4JUMP                        	# WAS ON - NOW OFF
005751,000183: 
005752,000184: 06,2112           34371                           CAF      CHRPRIO                       	# WAS OFF - NOW ON
005753,000185: 06,2113           05134                           TC       NOVAC                         	#
005754,000186: 06,2114     0777                                  EBANK=   DSPCOUNT                      	#
005755,000187: 06,2114           03357 60101                     2CADR    PROCKEY                       	#
005756,000188: 
005758,000190:                                                                                          	# JUMP TO APPROPRIATE ONCE-PER SECOND (.96 SEC ACTUALLY) ACTIVITY
005759,000191: 
005760,000192: 06,2116           50070        T4JUMP             INDEX    RUPTREG1                      	#
005761,000193: 06,2117           12120                           TCF      +1                            	#
005762,000194: 
005763,000195: 06,2120           12130                           TCF      OPTTEST                       	#
005764,000196: 06,2121           12765                           TCF      OPTMON                        	#
005765,000197: 06,2122           12174                           TCF      IMUMON                        	#
005766,000198: 06,2123           15333                           TCF      RESUME                        	#
005767,000199: 06,2124           12130                           TCF      OPTTEST                       	#
005768,000200: 06,2125           12765                           TCF      OPTMON                        	#
005769,000201: 06,2126           12174                           TCF      IMUMON                        	#
005770,000202: 06,2127           15333                           TCF      RESUME                        	#
005771,000203: 
005772,000204: 06,2130           04740        OPTTEST            TC       IBNKCALL                      	#
005773,000205: 06,2131           20000                           CADR     OPTDRIVE                      	#
005774,000206: 
005775,000207: 06,2132     7700               20MRUPT            =        OCT37776                      	# (DEC 16382)
005776,000208: 

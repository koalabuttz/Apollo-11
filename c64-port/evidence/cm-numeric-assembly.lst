059403,000002:                                                                                          	# Filename:     POWERED_FLIGHT_SUBROUTINES.agc
059404,000003:                                                                                          	# Purpose:      Part of the source code for Colossus 2A, AKA Comanche 055.
059405,000004:                                                                                          	#               It is part of the source code for the Command Module's (CM)
059406,000005:                                                                                          	#               Apollo Guidance Computer (AGC), for Apollo 11.
059407,000006:                                                                                          	# Assembler:    yaYUL
059408,000007:                                                                                          	# Contact:      Ron Burkey <info@sandroid.org>.
059409,000008:                                                                                          	# Website:      www.ibiblio.org/apollo.
059410,000009:                                                                                          	# Pages:        1365-1372
059411,000010:                                                                                          	# Mod history:  2009-05-10 SN   (Sergio Navarro).  Started adapting
059412,000011:                                                                                          	#                               from the Colossus249/ file of the same
059413,000012:                                                                                          	#                               name, using Comanche055 page images.
059414,000013: 
059415,000014:                                                                                          	# This source code has been transcribed or otherwise adapted from digitized
059416,000015:                                                                                          	# images of a hardcopy from the MIT Museum.  The digitization was performed
059417,000016:                                                                                          	# by Paul Fjeld, and arranged for by Deborah Douglas of the Museum.  Many
059418,000017:                                                                                          	# thanks to both.  The images (with suitable reduction in storage size and
059419,000018:                                                                                          	# consequent reduction in image quality as well) are available online at
059420,000019:                                                                                          	# www.ibiblio.org/apollo.  If for some reason you find that the images are
059421,000020:                                                                                          	# illegible, contact me at info@sandroid.org about getting access to the
059422,000021:                                                                                          	# (much) higher-quality images which Paul actually created.
059423,000022: 
059424,000023:                                                                                          	# Notations on the hardcopy document read, in part:
059425,000024: 
059426,000025:                                                                                          	#    Assemble revision 055 of AGC program Comanche by NASA
059427,000026:                                                                                          	#    2021113-051.  10:28 APR. 1, 1969
059428,000027: 
059429,000028:                                                                                          	#    This AGC program shall also be referred to as
059430,000029:                                                                                          	#            Colossus 2A
059431,000030: 
059432,000031: 
059433,000032:                                                                                          	# Page 1365
059434,000033: 14,3422                                           BANK     14                            	# SAME FBANK AS THE FINDCDUD SUB-PROGRAM
059435,000034: 23,2000                                           SETLOC   POWFLITE                      	#
059436,000035: 23,2000                                           BANK                                   	#
059437,000036: 
059438,000037: 23,3477     0142                                  EBANK=   DEXDEX                        	#
059439,000038: 23,3477                                           COUNT*   $$/POWFL                      	#
059440,000039: 
059441,000040:                                                                                          	#       CDUTRIG, CDUTRIG1, CDUTRIG2, AND CD*GR*GS ALL COMPUTE THE SINES AND
059442,000041:                                                                                          	# COSINES OF THREE 2'S COMPLEMENT ANGLES AND PLACE THE RESULT, DOUBLE
059443,000042:                                                                                          	# PRECISION, IN THE SAME ORDER AS THE INPUTS, AT SINCDU AND COSCDU.  AN
059444,000043:                                                                                          	# ADDITIONAL OUTPUT IS THE 1'S COMPLEMENT ANGLES AT CDUSPOT.  THESE
059445,000044:                                                                                          	# ROUTINES GO OUT OF THEIR WAY TO LEAVE THE MPAC AREA AS THEY FIND IT,
059446,000045:                                                                                          	# EXCEPT FOR THE GENERALLY UNIMPORTANT MPAC +2.  THEY DIFFER ONLY IN
059447,000046:                                                                                          	# WHERE THEY GET THE ANGLES, AND IN METHOD OF CALLING.
059448,000047: 
059449,000048:                                                                                          	#       CDUTRIG (AND CDUTRIG1, WHICH CAN BE CALLED IN BASIC) COMPUTE THE
059450,000049:                                                                                          	# SINES AND COSINES FROM THE CURRENT CONTENTS OF THE CDU REGISTERS.
059451,000050:                                                                                          	# THE CONTENTS OF CDUTEMP, ETC., ARE NOT TOUCHED SO THAT THEY MAY
059452,000051:                                                                                          	# CONTINUE TO FORM A CONSISTENT SET WITH THE LATEST PIPA READINGS.
059453,000052: 
059454,000053:                                                                                          	#       CDUTRIG1 IS LIKE CDUTRIG EXCEPT THAT IT CAN BE CALLED IN BASIC.
059455,000054: 
059456,000055:                                                                                          	#       CD*TR*GS FINDS CDU VALUES IN CDUSPOT RATHER THAN IN CDUTEMP.  THIS
059457,000056:                                                                                          	# ALLOWS USERS TO MAKE TRANSFORMATIONS USING ARBITRARY ANGLES, OR REAL
059458,000057:                                                                                          	# ANGLES IN AN ORDER OTHER THAN X Y Z.  A CALL TO THIS ROUTINE IS
059459,000058:                                                                                          	# NECESSARY IN PREPARATION FOR A CALL TO AX*SR*T IN EITHER OF ITS TWO
059460,000059:                                                                                          	# MODES (SMNB OR NBSM).  SINCE AX*SR*T EXPECTS TO FIND THE SINES AND
059461,000060:                                                                                          	# COSINES IN THE ORDER Y Z X THE ANGLES MUST HAVE BEEN PLACED IN CDUSPOT
059462,000061:                                                                                          	# IN THIS ORDER.  CD*TR*GS NEED NOT BE REPEATED WHEN AX*SR*T IS CALLED
059463,000062:                                                                                          	# MORE THAN ONCE, PROVIDED THE ANGLES HAVE NOT CHANGED.  NOTE THAT SINCE
059464,000063:                                                                                          	# IT CLOBBERS BUF2 (IN THE SINE AND COSINE ROUTINES) CD*TR*GS CANNOT BE
059465,000064:                                                                                          	# CALLED USING BANKCALL.  SORRY.
059466,000065: 
059467,000066:                                                                                          	#       CD*TR*G IS LIKE CD*TR*GS EXCEPT THAT IT CAN BE CALLED IN
059468,000067:                                                                                          	# INTERPRETIVE.
059469,000068: 
059470,000069: 23,3477           77776        CDUTRIG            EXIT                                   	#
059471,000070: 23,3500           03507                           TC       CDUTRIGS                      	#
059472,000071: 23,3501           06006                           TC       INTPRET                       	#
059473,000072: 23,3502           77616                           RVQ                                    	#
059474,000073: 
059475,000074: 23,3503           77776        CD*TR*G            EXIT                                   	#
059476,000075: 23,3504           03515                           TC       CD*TR*GS                      	#
059477,000076: 23,3505           06006                           TC       INTPRET                       	#
059478,000077: 23,3506           77616                           RVQ                                    	#
059479,000078: 
059480,000079: 23,3507           30032        CDUTRIGS           CA       CDUX                          	#
059481,000080: 23,3510           54772                           TS       CDUSPOT    +4                 	#
059482,000081: 23,3511           30033                           CA       CDUY                          	#
059483,000082: 23,3512           54766                           TS       CDUSPOT                       	#
059484,000083:                                                                                          	# Page 1366
059485,000084: 23,3513           30034                           CA       CDUZ                          	#
059486,000085: 23,3514           54770                           TS       CDUSPOT    +2                 	#
059487,000086: 
059488,000087: 23,3515           00006        CD*TR*GS           EXTEND                                 	#
059489,000088: 23,3516           22142                           QXCH     TEM2                          	#
059490,000089: 23,3517           35015                           CAF      FOUR                          	#
059491,000090: 23,3520           76211        TR*GL**P           MASK     SIX                           	# MAKE IT EVEN AND SMALLER
059492,000091: 23,3521           54143                           TS       TEM3                          	#
059493,000092: 23,3522           50143                           INDEX    TEM3                          	#
059494,000093: 23,3523           30766                           CA       CDUSPOT                       	#
059495,000094: 23,3524           52155                           DXCH     MPAC                          	# STORING 2'S COMP ANGLE, LOADING MPAC
059496,000095: 23,3525           52127                           DXCH     VBUF       +4                 	# STORING MPAC FOR LATER RESTORATION
059497,000096: 23,3526           04757                           TC       USPRCADR                      	#
059498,000097: 23,3527           45513                           CADR     CDULOGIC                      	#
059499,000098: 23,3530           00006                           EXTEND                                 	#
059500,000099: 23,3531           30155                           DCA      MPAC                          	#
059501,000100: 23,3532           50143                           INDEX    TEM3                          	#
059502,000101: 23,3533           52767                           DXCH     CDUSPOT                       	# STORING 1'S COMPLEMENT ANGLE
059503,000102: 23,3534           04757                           TC       USPRCADR                      	#
059504,000103: 23,3535           01516                           CADR     COSINE                        	#
059505,000104: 23,3536           52155                           DXCH     MPAC                          	#
059506,000105: 23,3537           50143                           INDEX    TEM3                          	#
059507,000106: 23,3540           52745                           DXCH     COSCDU                        	# STORING COSINE
059508,000107: 23,3541           00006                           EXTEND                                 	#
059509,000108: 23,3542           50143                           INDEX    TEM3                          	#
059510,000109: 23,3543           30767                           DCA      CDUSPOT                       	# LOADING 1'S COMPLEMENT ANGLE
059511,000110: 23,3544           04757                           TC       USPRCADR                      	#
059512,000111: 23,3545           01530                           CADR     SINE       +1                 	# SINE +1 EXPECTS ARGUMENT IN A AND L
059513,000112: 23,3546           52127                           DXCH     VBUF       +4                 	# BRINGING UP PRIOR MPAC TO BE RESTORED
059514,000113: 23,3547           52155                           DXCH     MPAC                          	#
059515,000114: 23,3550           50143                           INDEX    TEM3                          	#
059516,000115: 23,3551           52737                           DXCH     SINCDU                        	#
059517,000116: 23,3552           10143                           CCS      TEM3                          	#
059518,000117: 23,3553           13520                           TCF      TR*GL**P                      	#
059519,000118: 23,3554           00142                           TC       TEM2                          	#
059520,000119:                                                                                          	# Page 1367
059521,000120:                                                                                          	# *******************************************************************************************************
059522,000121: 
059523,000122:                                                                                          	#       QUICTRIG, INTENDED FOR GUIDANCE CYCLE USE WHERE TIME IS CRITICAL, IS A MUCH FASTER VERSION OF CD*TR*GS.
059524,000123:                                                                                          	# QUICTRIG COMPUTES AND STORES THE SINES AND COSINES OF THE 2'S COMPLEMENT ANGLES AT CDUSPOT, CDUSPOT +2,
059525,000124:                                                                                          	# AND CDUSPOT +4.  UNLIKE CD*TR*GS, QUICTRIG DOES NOT LEAVE THE 1'S COMPLEMENT VERSIONS OF THE ANGLES IN
059526,000125:                                                                                          	# CDUSPOT.  QUICTRIG'S EXECUTION TIME IS 4.1 MS; THIS IS 10 TIMES AS FAST AS CD*TR*GS.  QUICTRIG MAY BE
059527,000126:                                                                                          	# CALLED FROM INTERPRETIVE AS AN RTB OP-CODE, OR FROM BASIC VIA BANKCALL OR IBNKCALL.
059528,000127: 
059529,000128: 23,3555           00004        QUICTRIG           INHINT                                 	# INHINT SINCE DAP USES THE SAME TEMPS
059530,000129: 23,3556           00006                           EXTEND                                 	#
059531,000130: 23,3557           22061                           QXCH     ITEMP1                        	#
059532,000131: 23,3560           35015                           CAF      FOUR                          	#
059533,000132: 23,3561           76211                 +4        MASK     SIX                           	#
059534,000133: 23,3562           54062                           TS       ITEMP2                        	#
059535,000134: 23,3563           50062                           INDEX    ITEMP2                        	#
059536,000135: 23,3564           30766                           CA       CDUSPOT                       	#
059537,000136: 23,3565           05075                           TC       SPSIN                         	#
059538,000137: 23,3566           00006                           EXTEND                                 	#
059539,000138: 23,3567           75002                           MP       BIT14                         	# SCALE DOWN TO MATCH INTERPRETER OUTPUTS
059540,000139: 23,3570           50062                           INDEX    ITEMP2                        	#
059541,000140: 23,3571           52737                           DXCH     SINCDU                        	#
059542,000141: 23,3572           50062                           INDEX    ITEMP2                        	#
059543,000142: 23,3573           30766                           CA       CDUSPOT                       	#
059544,000143: 23,3574           05074                           TC       SPCOS                         	#
059545,000144: 23,3575           00006                           EXTEND                                 	#
059546,000145: 23,3576           75002                           MP       BIT14                         	#
059547,000146: 23,3577           50062                           INDEX    ITEMP2                        	#
059548,000147: 23,3600           52745                           DXCH     COSCDU                        	#
059549,000148: 23,3601           10062                           CCS      ITEMP2                        	#
059550,000149: 23,3602           13561                           TCF      QUICTRIG   +4                 	#
059551,000150: 23,3603           30061                           CA       ITEMP1                        	#
059552,000151: 23,3604           00003                           RELINT                                 	#
059553,000152: 23,3605           00000                           TC       A                             	#
059554,000153:                                                                                          	# Page 1368
059555,000154:                                                                                          	#****************************************************************************
059556,000155: 
059557,000156: 
059558,000157:                                                                                          	#       THESE INTERFACE ROUTINES MAKE IT POSSIBLE TO CALL AX*SR*T, ETC., IN
059559,000158:                                                                                          	# INTERPRETIVE.  LATER, WHERE POSSIBLE, THEY WILL BE ELIMINATED.
059560,000159: 
059561,000160:                                                                                          	#       NBSM WILL BE THE FIRST TO GO.  IT SHOULD NOT BE USED.
059562,000161: 
059563,000162: 23,3606           77620        NBSM               STQ                                    	#
059564,000163: 23,3607           00047                                    X2                            	#
059565,000164: 23,3610           76740                           LXC,1    VLOAD*                        	#
059566,000165: 23,3611           00050                                    S1                            	# BASE ADDRESS OF THE CDU ANGLES IS IN S1
059567,000166: 23,3612           00001                                    0,1                           	#
059568,000167: 23,3613           24767                           STOVL    CDUSPOT                       	#
059569,000168: 23,3614           00041                                    32D                           	# VECTOR TO BE TRANSFORMED IS IN 32D
059570,000169: 23,3615           77624                           CALL                                   	#
059571,000170: 23,3616           47637                                    TRG*NBSM                      	#
059572,000171: 23,3617           34041                           STCALL   32D                           	# SINCE THERE'S NO STGOTO
059573,000172: 23,3620           00047                                    X2                            	#
059574,000173: 
059575,000174:                                                                                          	#       THESE INTERFACE ROUTINES ARE PERMANENT.  ALL RESTORE USER'S EBANK
059576,000175:                                                                                          	# SETTING.  ALL ARE STRICT INTERPRETIVE SUBROUTINES, CALLED USING "CALL",
059577,000176:                                                                                          	# RETURNING VIA QPRET.  ALL EXPECT AND RETURN THE VECTOR TO BE TRANSFOR-
059578,000177:                                                                                          	# MED INTERPRETER-STYLE IN MPAC; COMPONENTS AT MPAC, MPAC +3, AND MPAC +5.
059579,000178: 
059580,000179:                                                                                          	#       TRG*SMNB AND TRG*NBSM BOTH EXPECT TO SEE THE 2'S COMPLEMENT ANGLES
059581,000180:                                                                                          	# AT CDUSPOT (ORDER Y Z X, AT CDUSPOT, CDUSPOT +2, AND CDUSPOT +4; ODD
059582,000181:                                                                                          	# LOCATIONS NEED NOT BE ZEROED).  TRG*NBSM DOES THE NB TO SM TRANSFOR-
059583,000182:                                                                                          	# MATION; TRG*SMNB, VICE VERSA.
059584,000183: 
059585,000184:                                                                                          	#       CDU*NBSM DOES ITS TRANSFORMATION USING THE PRESENT CONTENTS OF
059586,000185:                                                                                          	# THE CDL COUNTERS.  OTHERWISE IT IS LIKE TRG*NBSM.
059587,000186: 
059588,000187:                                                                                          	#       CDU*SMNB IS THE COMPLEMENT OF CDU*NBSM.
059589,000188: 
059590,000189: 23,3621           77776        CDU*SMNB           EXIT                                   	#
059591,000190: 23,3622           03507                           TC       CDUTRIGS                      	#
059592,000191: 23,3623           13626                           TCF      C*MM*N1                       	#
059593,000192: 
059594,000193: 23,3624           77776        TRG*SMNB           EXIT                                   	#
059595,000194: 23,3625           03515                           TC       CD*TR*GS                      	#
059596,000195: 23,3626           07501        C*MM*N1            TC       MPACVBUF                      	# AX*SR*T EXPECTS VECTOR IN VBUF
059597,000196: 23,3627           46214                           CS       THREE                         	# SIGNAL FOR SM TO NB TRANSFORMATION.
059598,000197: 23,3630           03650        C*MM*N2            TC       AX*SR*T                       	#
059599,000198: 23,3631           06006                           TC       INTPRET                       	#
059600,000199: 23,3632           43575                           VLOAD    RVQ                           	#
059601,000200: 23,3633           00123                                    VBUF                          	#
059602,000201: 
059603,000202: 23,3634           77776        CDU*NBSM           EXIT                                   	#
059604,000203: 23,3635           03507                           TC       CDUTRIGS                      	#
059605,000204: 
059606,000205:                                                                                          	# Page 1369
059607,000206: 
059608,000207: 23,3636           13641                           TCF      C*MM*N3                       	#
059609,000208: 
059610,000209: 23,3637           77776        TRG*NBSM           EXIT                                   	#
059611,000210: 23,3640           03515                           TC       CD*TR*GS                      	#
059612,000211: 23,3641           07501        C*MM*N3            TC       MPACVBUF                      	# FOR AX*SR*T
059613,000212: 23,3642           36214                           CA       THREE                         	# SIGNAL FOR NB TO SM TRANSFORMATION
059614,000213: 23,3643           13630                           TCF      C*MM*N2                       	#
059615,000214: 
059616,000215:                                                                                          	#       *NBSM* AND *SMNB* EXPECT TO SEE THE SINES AND COSINES (AT SINCDU
059617,000216:                                                                                          	# AND COSCDU) RATHER THAN THE ANGLES THEMSELVES.  OTHERWISE THEY ARE
059618,000217:                                                                                          	# LIKE TRG*NBSM AND TRG*SMNB.
059619,000218: 
059620,000219:                                                                                          	#       NOTE THAT JUST AS CD*TR*GS NEED BE CALLED ONLY ONCE FOR EACH SERIES
059621,000220:                                                                                          	# OF TRANSFORMATIONS USING THE SAME ANGLES, SO TOO ONLY ONE OF TRG*NBSM
059622,000221:                                                                                          	# AND TRG*SMNB NEED BE CALLED FOR EACH SERIES.  FOR SUBSEQUENT TRANFOR-
059623,000222:                                                                                          	# MATIONS USE *NBSM* AND *SMNB*.
059624,000223: 
059625,000224: 23,3644           77776        *SMNB*             EXIT                                   	#
059626,000225: 23,3645           13626                           TCF      C*MM*N1                       	#
059627,000226: 
059628,000227: 23,3646           77776        *NBSM*             EXIT                                   	#
059629,000228: 23,3647           13641                           TCF      C*MM*N3                       	#
059630,000229: 
059631,000230:                                                                                          	#       AX*SR*T COMBINES THE OLD SMNB AND NBSM.  FOR THE NB TO SM
059632,000231:                                                                                          	# TRANSFORMATION, ENTER WITH +3 IN A.  FOR SM TO NB, ENTER WITH -3.
059633,000232:                                                                                          	# THE VECTOR TO BE TRANSFORMED ARRIVES, AND IS RETURNED, IN VBUF.
059634,000233:                                                                                          	# AX*SR*T EXPECTS TO FIND THE SINES AND COSINES OF THE ANGLES OF ROTATION
059635,000234:                                                                                          	# AT SINCDU AND COSCDU, IN THE ORDER Y Z X.  A CALL TO CD*TR*GS, WITH
059636,000235:                                                                                          	# THE 2'S COMPLEMENT ANGLES (ORDER Y Z X) AT CDUSPOT, WILL TAKE CARE OF
059637,000236:                                                                                          	# THIS.  HERE IS A SAMPLE CALLING SEQUENCE:-
059638,000237: 
059639,000238:                                                                                          	#                       TC      CDUTRIGS
059640,000239:                                                                                          	#                       CS      THREE           ("CA THREE" FOR NBSM)
059641,000240:                                                                                          	#                       TC      AX*SR*T
059642,000241: 
059643,000242:                                                                                          	# THE CALL TO CD*TR*GS NEED NOT BE REPEATED, WHEN AX*SR*T IS CALLED MORE
059644,000243:                                                                                          	# THAN ONCE, UNLESS THE ANGLES HAVE CHANGED.
059645,000244: 
059646,000245:                                                                                          	#       AX*SR*T IS GUARANTEED SAFE ONLY FOR VECTORS OF MAGNITUDE LESS THAN
059647,000246:                                                                                          	# UNITY.  A LOOK AT THE CASE IN WHICH A VECTOR OF GREATER MAGNITUDE
059648,000247:                                                                                          	# HAPPENS TO LIE ALONG AN AXIS OF THE SYSTEM TO WHICH IT IS TO BE TRANS-
059649,000248:                                                                                          	# FORMED CONVINCES ONE THAT THIS IS A RESTRICTION WHICH MUST BE ACCEPTED.
059650,000249: 
059651,000250: 23,3650           54142        AX*SR*T            TS       DEXDEX                        	# WHERE IT BECOMES THE INDEX OF INDEXES
059652,000251: 23,3651           00006                           EXTEND                                 	#
059653,000252: 23,3652           22145                           QXCH     RTNSAVER                      	#
059654,000253: 
059655,000254: 23,3653           10142        R*TL**P            CCS      DEXDEX                        	#               +3 --> 0        -3 --> 2
059656,000255: 23,3654           40142                           CS       DEXDEX                        	# THUS:         +2 --> 1        -2 --> 1
059657,000256: 23,3655           66214                           AD       THREE                         	#               +1 --> 2        -1 --> 0

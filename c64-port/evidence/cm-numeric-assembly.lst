054170,000038:                                                                                          	# ..... RP-TO-R SUBROUTINE .....
054171,000039:                                                                                          	# SUBROUTINE TO CONVERT RP (VECTOR IN PLANETARY COORDINATE SYSTEM, EITHER
054172,000040:                                                                                          	# EARTH-FIXED OR MOON-FIXED) TO R (SAME VECTOR IN THE BASIC REF. SYSTEM)
054173,000041:                                                                                          	#       R = MT(T) * (RP + LP X RP)      MT = M MATRIX TRANSPOSE
054174,000042: 
054175,000043:                                                                                          	# CALLING SEQUENCE
054176,000044:                                                                                          	#       L       CALL
054177,000045:                                                                                          	#       L+1             RP-TO-R
054178,000046: 
054179,000047:                                                                                          	# SUBROUTINES USED
054180,000048:                                                                                          	#       EARTHMX, MOONMX, EARTHL
054181,000049: 
054182,000050:                                                                                          	#       ITEMS AVAILABLE FROM LAUNCH DATA
054183,000051:                                                                                          	#               504LM = THE LIBRATION VECTOR L OF THE MOON AT TIME TIMSUBL, EXPRESSED
054184,000052:                                                                                          	#               IN THE MOON-FIXED COORD. SYSTEM         RADIANS B0
054185,000053: 
054186,000054:                                                                                          	#       ITEMS NECESSARY FOR SUBR. USED (SEE DESCRIPTION OF SUBR.)
054187,000055: 
054188,000056:                                                                                          	# INPUT
054189,000057:                                                                                          	#       MPAC = 0 FOR EARTH, NON-ZERO FOR MOON
054190,000058:                                                                                          	#       0-5D = RP VECTOR
054191,000059:                                                                                          	#       6-7D = TIME
054192,000060: 
054193,000061:                                                                                          	# OUTPUT
054194,000062:                                                                                          	#       MPAC = R VECTOR METERS B-29 FOR EARTH, B-27 FOR MOON
054195,000063: 
054196,000064: 26,2000                                           SETLOC   PLANTIN                       	#
054197,000065: 26,2000                                           BANK                                   	#
054198,000066: 
054199,000067: 26,3344                                           COUNT*   $$/LUROT                      	#
054200,000068: 
054201,000069: 26,3344           46020        RP-TO-R            STQ      BHIZ                          	#
054202,000070: 26,3345           00050                                    RPREXIT                       	#
054203,000071: 26,3346           55361                                    RPTORA                        	#
054204,000072: 26,3347           77624                           CALL                                   	# COMPUTE M MATRIX FOR MOON
054205,000073: 26,3350           55421                                    MOONMX                        	# LP=LM FOR MOON        RADIANS B0
054206,000074: 26,3351           77775                           VLOAD                                  	#
054207,000075: 26,3352           02012                                    504LM                         	#
054208,000076: 26,3353           53235        RPTORB             VXV      VAD                           	#
054209,000077: 26,3354           00001                                    504RPR                        	#
054210,000078: 26,3355           00001                                    504RPR                        	#
054211,000079: 26,3356           52105                           VXM      GOTO                          	#
054212,000080: 26,3357           00025                                    MMATRIX                       	# MPAC=R=MT(T)*(RP+LPXRP)
054213,000081: 26,3360           55407                                    RPRPXXXX                      	# RESET PUSHLOC TO 0 BEFORE EXITING
054214,000082: 26,3361           77624        RPTORA             CALL                                   	# EARTH COMPUTATIONS
054215,000083: 26,3362           55573                                    EARTHMX                       	# M MATRIX B-1
054216,000084: 26,3363           77624                           CALL                                   	#
054217,000085: 26,3364           55625                                    EARTHL                        	# L VECTOR RADIANS B0
054218,000086: 26,3365           76521                           MXV      VSL1                          	# LP=M(T)*L     RAD B-0
054219,000087: 26,3366           00025                                    MMATRIX                       	#
054221,000089: 26,3367           77650                           GOTO                                   	#
054222,000090: 26,3370           55353                                    RPTORB                        	#
054223,000091: 
054225,000093:                                                                                          	# ..... R-TO-RP SUBROUTINE .....
054226,000094:                                                                                          	# SUBROUTINE TO CONVERT R (VECTOR IN REFERENCE COORD. SYSTEM) TO RP
054227,000095:                                                                                          	# (VECTOR IN PLANETARY COORD SYSTEM) EITHER EARTH-FIXED OR MOON-FIXED
054228,000096:                                                                                          	#       RP = M(T) * (R - L X R)
054229,000097: 
054230,000098:                                                                                          	# CALLING SEQUENCE
054231,000099:                                                                                          	#       L       CALL
054232,000100:                                                                                          	#       L+1             R-TO-RP
054233,000101: 
054234,000102:                                                                                          	# SUBROUTINES USED
054235,000103:                                                                                          	#       EARTHMX, MOONMX, EARTHL
054236,000104: 
054237,000105:                                                                                          	# INPUT
054238,000106:                                                                                          	#       MPAC = 0 FOR EARTH, NON-ZERO FOR MOON
054239,000107:                                                                                          	#       0-5D = R VECTOR
054240,000108:                                                                                          	#       6-7D = TIME
054241,000109: 
054242,000110:                                                                                          	#       ITEMS AVAILABLE FROM LAUNCH DATA
054243,000111:                                                                                          	#               504LM = THE LIBRATION VECTOR L OF THE MOON AT TIME TIMSUBL, EXPRESSED
054244,000112:                                                                                          	#               IN THE MOON-FIXED COORD. SYSTEM                 RADIANS B0
054245,000113: 
054246,000114:                                                                                          	#       ITEMS NECESSARY FOR SUBROUTINES USED (SEE DESCRIPTION OF SUBR.)
054247,000115: 
054248,000116:                                                                                          	# OUTPUT
054249,000117:                                                                                          	#       MPAC = RP VECTOR METERS B-29 FOR EARTH, B-27 FOR MOON
054250,000118: 
054251,000119: 26,3371           46020        R-TO-RP            STQ      BHIZ                          	#
054252,000120: 26,3372           00050                                    RPREXIT                       	#
054253,000121: 26,3373           55413                                    RTORPA                        	#
054254,000122: 26,3374           77624                           CALL                                   	#
054255,000123: 26,3375           55421                                    MOONMX                        	#
054256,000124: 26,3376           61375                           VLOAD    VXM                           	#
054257,000125: 26,3377           02012                                    504LM                         	# LP=LM
054258,000126: 26,3400           00025                                    MMATRIX                       	#
054259,000127: 26,3401           77772                           VSL1                                   	# L = MT(T)*LP          RADIANS B0
054260,000128: 26,3402           51235        RTORPB             VXV      BVSU                          	#
054261,000129: 26,3403           00001                                    504RPR                        	#
054262,000130: 26,3404           00001                                    504RPR                        	#
054263,000131: 26,3405           77721                           MXV                                    	# M(T)*(R-LXR)          B-2
054264,000132: 26,3406           00025                                    MMATRIX                       	#
054265,000133: 26,3407           40372        RPRPXXXX           VSL1     SETPD                         	#
054266,000134: 26,3410           00001                                    0D                            	#
054267,000135: 26,3411           77650                           GOTO                                   	#
054268,000136: 26,3412           00050                                    RPREXIT                       	#
054269,000137: 26,3413           77624        RTORPA             CALL                                   	# EARTH COMPUTATIONS
054270,000138: 26,3414           55573                                    EARTHMX                       	#
054271,000139: 26,3415           77624                           CALL                                   	#
054272,000140: 26,3416           55625                                    EARTHL                        	#
054273,000141: 26,3417           77650                           GOTO                                   	# MPAC=L=(-AX,-AY,0)    RAD B-0
054274,000142: 26,3420           55402                                    RTORPB                        	#
054275,000143: 
054277,000145:                                                                                          	# ..... MOONMX SUBROUTINE .....
054278,000146:                                                                                          	# SUBROUTINE TO COMPUTE THE TRANSFORMATION MATRIX M FOR THE MOON
054279,000147: 
054280,000148:                                                                                          	# CALLING SEQUENCE
054281,000149:                                                                                          	#       L       CALL
054282,000150:                                                                                          	#       L+1             MOONMX
054283,000151: 
054284,000152:                                                                                          	# SUBROUTINES USED
054285,000153:                                                                                          	#       NEWANGLE
054286,000154: 
054287,000155:                                                                                          	# INPUT
054288,000156:                                                                                          	#       6-7D = TIME
054289,000157: 
054290,000158:                                                                                          	#       ITEMS AVAILABLE FROM LAUNCH DATA
054291,000159:                                                                                          	#               BSUBO, BDOT
054292,000160:                                                                                          	#               TIMSUBO, NODIO, NODDOT, FSUBO, FDOT
054293,000161:                                                                                          	#               COSI = COS(I)   B-1
054294,000162:                                                                                          	#               SINI = SIN(I)   B-1
054295,000163:                                                                                          	#               I IS THE ANGLE BETWEEN THE MEAN LUNAR EQUATORIAL PLANE AND THE
054296,000164:                                                                                          	#               PLANE OF THE ECLIPTIC (1 DEGREE 32.1 MINUTES)
054297,000165: 
054298,000166:                                                                                          	# OUTPUT
054299,000167:                                                                                          	#       MMATRIX = 3X3 M MATRIX          B-1 (STORED IN VAC AREA)
054300,000168: 
054301,000169: 26,3421           40220        MOONMX             STQ      SETPD                         	#
054302,000170: 26,3422           00051                                    EARTHMXX                      	#
054303,000171: 26,3423           00011                                    8D                            	#
054304,000172: 26,3424           77770                           AXT,1                                  	# B REQUIRES SL 0, SL 5 IN NEWANGLE
054305,000173: 26,3425           00005                                    5                             	#
054306,000174: 26,3426           65345                           DLOAD    PDDL                          	# PD 10D        8-9D=BSUBO
054307,000175: 26,3427           15655                                    BSUBO                         	#               10-11D=BDOT
054308,000176: 26,3430           15647                                    BDOT                          	#
054309,000177: 26,3431           45006                           PUSH     CALL                          	# PD 12D
054310,000178: 26,3432           55546                                    NEWANGLE                      	# EXIT WITH PD 8D AND MPAC= B   REVS B0
054311,000179: 26,3433           71406                           PUSH     COS                           	# PD 10D
054312,000180: 26,3434           14041                           STODL    COB                           	# PD 8D         COS(B) B-1
054313,000181: 26,3435           77756                           SIN                                    	#               SIN(B) B-1
054314,000182: 26,3436           14043                           STODL    SOB                           	#               SETUP INPUT FOR NEWANGLE
054315,000183: 26,3437           15653                                    FSUBO                         	#                       8-9D=FSUBO
054316,000184: 26,3440           41525                           PDDL     PUSH                          	# PD 10D THEN 12D       10-11D=FDOT
054317,000185: 26,3441           15645                                    FDOT                          	#
054318,000186: 26,3442           45170                           AXT,1    CALL                          	# F REQUIRES SL 1, SL 6 IN NEWANGLE
054319,000187: 26,3443           00004                                    4                             	#
054320,000188: 26,3444           55546                                    NEWANGLE                      	# EXIT WITH PD 8D AND MPAC= F REVS B0
054321,000189: 26,3445           14027                           STODL    AVECTR     +2                 	# SAVE F TEMP
054322,000190: 26,3446           15651                                    NODIO                         	#                       8-9D=NODIO
054323,000191: 26,3447           41525                           PDDL     PUSH                          	# PD 10D THEN 12D       10-11D=NODDOT
054324,000192: 26,3450           15643                                    NODDOT                        	#                       MPAC=T
054325,000193: 26,3451           45170                           AXT,1    CALL                          	# NODE REQUIRES SL 0, SL 5 IN NEWANGLE
054326,000194: 26,3452           00005                                    5                             	#
054327,000195: 26,3453           55546                                    NEWANGLE                      	# EXIT WITH PD 8D AND MPAC= NODI REVS B0
054329,000197: 26,3454           71406                           PUSH     COS                           	# PD 10D        8-9D= NODI REVS B0
054330,000198: 26,3455           77606                           PUSH                                   	# PD 12D        10-11D= COS(NODI) B-1
054331,000199: 26,3456           00025                           STORE    AVECTR                        	#
054332,000200: 26,3457           76405                           DMP      SL1R                          	#
054333,000201: 26,3460           00041                                    COB                           	#                       COS(NODI) B-1
054334,000202: 26,3461           14035                           STODL    BVECTR     +2                 	# PD 10D  20-25D=AVECTR=COB*SIN(NODI)
054335,000203: 26,3462           76405                           DMP      SL1R                          	#                       SOB*SIN(NODI)
054336,000204: 26,3463           00043                                    SOB                           	#
054337,000205: 26,3464           14037                           STODL    BVECTR     +4                 	# PD 8D
054338,000206: 26,3465           41556                           SIN      PUSH                          	# PD 10D                -SIN(NODI) B-1
054339,000207: 26,3466           77676                           DCOMP                                  	#         26-31D=BVECTR=COB*COS(NODI)
054340,000208: 26,3467           14033                           STODL    BVECTR                        	# PD 8D                 SOB*COS(NODI)
054341,000209: 26,3470           00027                                    AVECTR     +2                 	# MOVE F FROM TEMP LOC. TO 504F
054342,000210: 26,3471           14007                           STODL    504F                          	#
054343,000211: 26,3472           76405                           DMP      SL1R                          	#
054344,000212: 26,3473           00041                                    COB                           	#
054345,000213: 26,3474           14027                           STODL    AVECTR     +2                 	#
054346,000214: 26,3475           00011                                    SINNODI                       	# 8-9D=SIN(NODI) B-1
054347,000215: 26,3476           76405                           DMP      SL1R                          	#
054348,000216: 26,3477           00043                                    SOB                           	#
054349,000217: 26,3500           14031                           STODL    AVECTR     +4                 	#                       0
054350,000218: 26,3501           15335                                    HI6ZEROS                      	#       8-13D= CVECTR=  -SOB B-1
054351,000219: 26,3502           57525                           PDDL     DCOMP                         	# PD 10D                COB
054352,000220: 26,3503           00043                                    SOB                           	#
054353,000221: 26,3504           63325                           PDDL     PDVL                          	# PD 12D THEN PD 14D
054354,000222: 26,3505           00041                                    COB                           	#
054355,000223: 26,3506           00033                                    BVECTR                        	#
054356,000224: 26,3507           63361                           VXSC     PDVL                          	# PD 20D        BVECTR*SINI B-2
054357,000225: 26,3510           15641                                    SINI                          	#
054358,000226: 26,3511           00011                                    CVECTR                        	#
054359,000227: 26,3512           53361                           VXSC     VAD                           	# PD 14D        CVECTR*COSI B-2
054360,000228: 26,3513           15637                                    COSI                          	#
054361,000229: 26,3514           77772                           VSL1                                   	#
054362,000230: 26,3515           24041                           STOVL    MMATRIX    +12D               	# PD 8D  M2=BVECTR*SINI+CVECTR*COSI B-1
054363,000231: 26,3516           63361                           VXSC     PDVL                          	# PD 14D
054364,000232: 26,3517           15641                                    SINI                          	#               CVECTR*SINI B-2
054365,000233: 26,3520           00033                                    BVECTR                        	#
054366,000234: 26,3521           52361                           VXSC     VSU                           	# PD 8D         BVECTR*COSI B-2
054367,000235: 26,3522           15637                                    COSI                          	#
054368,000236: 26,3523           65372                           VSL1     PDDL                          	# PD 14D
054369,000237: 26,3524           00007                                    504F                          	# 8-13D=DVECTR=BVECTR*COSI-CVECTR*SINI B-1
054370,000238: 26,3525           74346                           COS      VXSC                          	#
054371,000239: 26,3526           00011                                    DVECTR                        	#
054372,000240: 26,3527           73525                           PDDL     SIN                           	# PD 20D  14-19D= DVECTR*COSF B-2
054373,000241: 26,3530           00007                                    504F                          	#
054374,000242: 26,3531           52361                           VXSC     VSU                           	# PD 14D        AVECTR*SINF B-2
054375,000243: 26,3532           00025                                    AVECTR                        	#
054376,000244: 26,3533           77772                           VSL1                                   	#
054377,000245: 26,3534           14033                           STODL    MMATRIX    +6                 	# M1= AVECTR*SINF-DVECTR*COSF B-1
054378,000246: 26,3535           00007                                    504F                          	#
054380,000248: 26,3536           74356                           SIN      VXSC                          	# PD 8D
054381,000249: 26,3537           71525                           PDDL     COS                           	# PD 14D  8-13D=DVECTR*SINF B-2
054382,000250: 26,3540           00007                                    504F                          	#
054383,000251: 26,3541           53361                           VXSC     VAD                           	# PD 8D         AVECTR*COSF B-2
054384,000252: 26,3542           00025                                    AVECTR                        	#
054385,000253: 26,3543           57572                           VSL1     VCOMP                         	#
054386,000254: 26,3544           34025                           STCALL   MMATRIX                       	# M0= -(AVECTR*COSF+DVECTR*SINF) B-1
054387,000255: 26,3545           00051                                    EARTHMXX                      	#
054388,000256: 
054389,000257:                                                                                          	# COMPUTE X=X0+(XDOT)(T+T0)
054390,000258:                                                                                          	# 8-9D= XO (REVS B-0), PUSHLOC SET AT 12D
054391,000259:                                                                                          	# 10-11D=XDOT (REVS/CSEC) SCALED B+23 FOR WEARTH,B+28 FOR NODDOT AND BDOT
054392,000260:                                                                                          	#                       AND B+27 FOR FDOT
054393,000261:                                                                                          	# X1=DIFFERENCE IN 23 AND SCALING OF XDOT, =0 FOR WEARTH, 5 FOR NODDOT AND
054394,000262:                                                                                          	#                                       BDOT AND 4 FOR FDOT
054395,000263:                                                                                          	# 6-7D=T (CSEC B-28), TIMSUBO= (CSEC B-42 TRIPLE PREC.)
054396,000264: 
054397,000265: 26,3546           54345        NEWANGLE           DLOAD    SR                            	# ENTER PD 12D
054398,000266: 26,3547           00007                                    6D                            	#
054399,000267: 26,3550           20617                                    14D                           	#
054400,000268: 26,3551           72371                           TAD      TLOAD                         	# CHANGE MODE TO TP
054401,000269: 26,3552           01707                                    TIMSUBO                       	#
054402,000270: 26,3553           00155                                    MPAC                          	#
054403,000271: 26,3554           14017                           STODL    TIMSUBM                       	# T+T0 CSEC B-42
054404,000272: 26,3555           00020                                    TIMSUBM    +1                 	#
054405,000273: 26,3556           77605                           DMP                                    	# PD 10D        MULT BY XDOT IN 10-11D
054406,000274: 26,3557           43257                           SL*      DAD                           	# PD 8D         ADD XO IN 8-9D AFTER SHIFTING
054407,000275: 26,3560           20206                                    5,1                           	#               SUCH THAT SCALING IS B-0
054408,000276: 26,3561           67206                           PUSH     SLOAD                         	# PD 10D  SAVE PARTIAL (X0+XDOT*T) IN 8-9D
054409,000277: 26,3562           00017                                    TIMSUBM                       	#
054410,000278: 26,3563           41261                           SL       DMP                           	#
054411,000279: 26,3564           20212                                    9D                            	#
054412,000280: 26,3565           00013                                    10D                           	# XDOT
054413,000281: 26,3566           43257                           SL*      DAD                           	# PD 8D         SHIFT SUCH THAT THIS PART OF X
054414,000282: 26,3567           20213                                    10D,1                         	#               IS SCALED REVS/CSEC B-0
054415,000283: 26,3570           77600                           BOV                                    	# TURN OFF OVERFLOW IF SET BY SHIFT
054416,000284: 26,3571           55572                                    +1                            	# INSTRUCTION BEFORE EXITING
054417,000285: 26,3572           77616                           RVQ                                    	# MPAC=X= X0+(XDOT)(T+T0)       REVS B0
054418,000286: 
054420,000288:                                                                                          	# ..... EARTHMX SUBROUTINE .....
054421,000289:                                                                                          	# SUBROUTINE TO COMPUTE THE TRANSFORMATION MATRIX M FOR THE EARTH
054422,000290: 
054423,000291:                                                                                          	# CALLING SEQUENCE
054424,000292:                                                                                          	#       L       CALL
054425,000293:                                                                                          	#       L+1             EARTHMX
054426,000294: 
054427,000295:                                                                                          	# SUBROUTINES USED
054428,000296:                                                                                          	#       NEWANGLE
054429,000297: 
054430,000298:                                                                                          	# INPUT
054431,000299:                                                                                          	#       INPUT AVAILABLE FROM LAUNCH DATA        AZO REVS B-0
054432,000300:                                                                                          	#                                               TEPHEM CSEC B-42
054433,000301:                                                                                          	#       6-7D= TIME CSEC B-28
054434,000302: 
054435,000303:                                                                                          	# OUTPUT
054436,000304:                                                                                          	#       MMATRIX= 3X3 M MATRIX B-1 (STORED IN VAC AREA)
054437,000305: 
054438,000306: 26,3573           40220        EARTHMX            STQ      SETPD                         	# SET 8-9D=AZO
054439,000307: 26,3574           00051                                    EARTHMXX                      	#
054440,000308: 26,3575           00011                                    8D                            	# 10-11D=WEARTH
054441,000309: 26,3576           77770                           AXT,1                                  	# FOR SL 5, AND SL 10 IN NEWANGLE
054442,000310: 26,3577           00000                                    0                             	#
054443,000311: 26,3600           65345                           DLOAD    PDDL                          	# LEAVING PD SET AT 12D FOR NEWANGLE
054444,000312: 26,3601           01712                                    AZO                           	#
054445,000313: 26,3602           15657                                    WEARTH                        	#
054446,000314: 26,3603           45006                           PUSH     CALL                          	#
054447,000315: 26,3604           55546                                    NEWANGLE                      	#
054448,000316: 26,3605           41401                           SETPD    PUSH                          	# 18-19D=504AZ
054449,000317: 26,3606           00023                                    18D                           	#                        COS(AZ)   SIN(AZ)     0
054450,000318: 26,3607           65346                           COS      PDDL                          	# 20-37D=  MMATRIX=     -SIN(AZ)   COS(AZ)     0    B-1
054451,000319: 26,3610           00023                                    504AZ                         	#                           0         0        1
054452,000320: 26,3611           65356                           SIN      PDDL                          	#
054453,000321: 26,3612           15335                                    HI6ZEROS                      	#
054454,000322: 26,3613           73525                           PDDL     SIN                           	#
054455,000323: 26,3614           00023                                    504AZ                         	#
054456,000324: 26,3615           65276                           DCOMP    PDDL                          	#
054457,000325: 26,3616           00023                                    504AZ                         	#
054458,000326: 26,3617           63346                           COS      PDVL                          	#
054459,000327: 26,3620           15335                                    HI6ZEROS                      	#
054460,000328: 26,3621           41525                           PDDL     PUSH                          	#
054461,000329: 26,3622           15333                                    HIDPHALF                      	#
054462,000330: 26,3623           77650                           GOTO                                   	#
054463,000331: 26,3624           00051                                    EARTHMXX                      	#

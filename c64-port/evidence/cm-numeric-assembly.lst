000901,000755:                                                                                          	#                       (BIAS OF 19.775                 (USES 15 BITS FOR MAGNI-
000902,000756:                                                                                          	#                       DEGREES ADDED FOR               TUDE AND 2-S COMP.)
000903,000757:                                                                                          	#                       DISPLAY, SUBTRACTED
000904,000758:                                                                                          	#                       FOR LOAD.)

022507,000028:                                                                                          	##
022508,000029:                                                                                          	## Notations on the hardcopy document read, in part:
022509,000030:                                                                                          	##
022510,000031:                                                                                          	##    Assemble revision 055 of AGC program Comanche by NASA
022511,000032:                                                                                          	##    2021113-051.  10:28 APR. 1, 1969  
022512,000033:                                                                                          	##
022513,000034:                                                                                          	##    This AGC program shall also be referred to as
022514,000035:                                                                                          	##            Colossus 2A
022515,000036: 
022517,000038:                                                                                          	# SUBROUTINE NAME:  V82CALL
022518,000039:                                                                                          	# MOD NO: 0                                                             DATE: 16 FEB 67
022519,000040:                                                                                          	# MOD BY: RR BAIRNSFATHER                                               LOG SECTION:  R30
022520,000041:                                                                                          	# MOD NO: 1     MOD BY:  RR BAIRNSFATHER        DATE: 11 APR 67         SR30.1 CHANGED TO ALLOW MONITOR OPERN
022521,000042:                                                                                          	# MOD NO: 2     MOD  BY  ALONSO                 DATE: 11 DEC 67         VB82 PROGRAM REWRITTEN
022522,000043:                                                                                          	# MOD NO: 3     MOD  BY  ALONSO                 DATE: 26 MAR 68         PROG MOD TO HANDLE DIF EARTH/MOON SCALE
022523,000044: 
022524,000045:                                                                                          	# NEW FUNCTIONAL DESCRIPTION:   CALLED BY VERB 82 ENTER.  PRIORITY 10
022525,000046:                                                                                          	# USED THROUGHOUT.              CALCULATE AND DISPLAY ORBITAL PARAMETERS
022526,000047: 
022527,000048:                                                                                          	# 1.    IF AVERAGE G IS OFF:
022528,000049:                                                                                          	#               FLASH DISPLAY V04N06.  R2 INDICATES WHICH SHIP'S STATE VECTOR IS
022529,000050:                                                                                          	#                       TO BE UPDATED.  INITIAL CHOICE IS THIS SHIP (R2=1).  ASTRONAUT
022530,000051:                                                                                          	#                       CAN CHANGE TO OTHER SHIP BY V22EXE, WHERE X NOT EQ 1.
022531,000052:                                                                                          	#               SELECTED STATE VECTOR UPDATED BY THISPREC (OTHPREC).
022532,000053:                                                                                          	#               CALLS SR30.1 (WHICH CALLS TFFCONMU + TFFRP/RA) TO CALCULATE
022533,000054:                                                                                          	#                       RPER (PERIGEE RADIUS), RAPO (APOGEE RADIUS), HPER (PERIGEE
022534,000055:                                                                                          	#                       HEIGHT ABOVE LAUNCH PAD OR LUNAR LANDING SITE), HAPO (APOGEE
022535,000056:                                                                                          	#                       HEIGHT AS ABOVE), TPER (TIME TO PERIGEE), TFF (TIME TO
022536,000057:                                                                                          	#                       INTERSECT 300 KFT ABOVE PAD OR 35KFT ABOVE LANDING SITE).
022537,000058:                                                                                          	#               FLASH MONITOR V16N44 (HAPO, HPER, TFF).  TFF IS -59M59S IF IT WAS
022538,000059:                                                                                          	#                       NOT COMPUTABLE, OTHERWISE IT INCREMENTS ONCE PER SECOND.
022539,000060:                                                                                          	#                       ASTRONAUT HAS OPTION TO MONITOR TPER BY KEYING IN N 32 E.
022540,000061:                                                                                          	#                       DISPLAY IS IN HMS, IS NEGATIVE (AS WAS TFF), AND INCREMENTS
022541,000062:                                                                                          	#                       ONCE PER SECOND ONLY IF TFF DISPLAY WAS -59M59S.
022542,000063:                                                                                          	#       2.      IF AVERAGE G IS ON:
022543,000064:                                                                                          	#                       CALLS SR30.1 APPROX EVERY TWO SECS.  STATE VECTOR IS ALWAYS
022544,000065:                                                                                          	#                               FOR THIS VEHICLE.  V82 DOES NOT DISTURB STATE VECTOR.  RESULTS
022545,000066:                                                                                          	#                               OF SR30.1 ARE RAPO, RPER, HAPO, HPER, TPER, TFF.
022546,000067:                                                                                          	#                       FLASH MONITOR V16N44 (HAPO, HPER, TFF).
022547,000068:                                                                                          	#                       IF MODE IS P11, THEN CALL DELRSPL SO ASTRONAUT CAN MONITOR
022548,000069:                                                                                          	#                               RESULTS BY N50E.  SPLASH COMPUTATION DONE ONCE PER TWO SECS.
022549,000070:                                                                                          	#       ADDENDUM:  HAPO AND HPER SHOULD BE CHANGED TO READ HAPOX AND HPERX IN THE
022550,000071:                                                                                          	#               ABOVE REMARKS.
022551,000072: 
022552,000073:                                                                                          	# CALLING SEQUENCE: VERB 82 ENTER.
022553,000074: 
022554,000075:                                                                                          	# SUBROUTINES CALLED:   SR30.1, GOXDSPF
022555,000076:                                                                                          	#                       MAYBE - THISPREC, OTHPREC, LOADTIME, DELRSPL
022556,000077: 
022557,000078:                                                                                          	# NORMAL EXIT MODES:  TC ENDEXT
022558,000079: 
022559,000080:                                                                                          	# ALARMS:  NONE
022560,000081: 
022561,000082:                                                                                          	# OUTPUT:       HAPOX   (-29) M
022562,000083:                                                                                          	#               HPERX   (-29) M
022563,000084:                                                                                          	#               RAPO    (-29) M EARTH
022564,000085:                                                                                          	#                       (-27) M MOON
022566,000087:                                                                                          	#               RPER    (-29) M EARTH
022567,000088:                                                                                          	#                       (-27) M MOON
022568,000089:                                                                                          	#               TFF     (-28) CS        CONTAINS NEGATIVE QUANTITY
022569,000090:                                                                                          	#               -TPER   (-28) CS        CONTAINS NEGATIVE QUANTITY
022570,000091:                                                                                          	#               RSP-RREC(-29) M         IF DELRSPL CALLED
022571,000092: 
022572,000093:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:  STATE VECTOR.
022573,000094: 
022574,000095:                                                                                          	# DEBRIS:       QPRET, RONE, VONE, TFF/RTMU, HPERMIN, RPADTEM, V82EMFLG.
022575,000096:                                                                                          	#               MAYBE:  TSTART82, V82FLAGS, TDEC1.
022576,000097: 

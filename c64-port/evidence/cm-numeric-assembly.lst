061737,000112:    5501           22006                           LXCH     BB                            	# SWITCHED ERRASIBLE
061738,000113: 
061739,000114:    5502           50000                           NDX      A                             	# GET THE TIME INDIRECTLY
061740,000115:    5503           30001                           CA       1                             	#
061741,000116: 
061742,000117:    5504           22006                           LXCH     BB                            	# RESTORE THE BB AND GOLOC
061743,000118:    5505           22706                           LXCH     GOLOC      +1                 	#
061744,000119: 
061745,000120:    5506           13573                           TCF      FINDTIME                      	# FIND OUT WHEN IT SHOULD BEGIN
061746,000121: 
061747,000122:                                                                                          	# ***** YOU MAY RETURN TO SWITCHED FIXED *****
061748,000123: 

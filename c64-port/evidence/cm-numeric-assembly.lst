046419,000038: 21,3765                                           BANK     21                            	#
046420,000039: 17,2000                                           SETLOC   DAPS4                         	#
046421,000040: 17,2000                                           BANK                                   	#
046422,000041: 
046423,000042: 17,2552                                           COUNT    17/DAPJS                      	#
046424,000043: 
046425,000044: 17,2552  E6,1510                                  EBANK=   KMPAC                         	#
046426,000045: 
046427,000046:                                                                                          	# EXAMINE CHANNEL 31 FOR TRANSLATION COMMANDS
046428,000047: 
046429,000048: 17,2552           22016        JETSLECT           LXCH     BANKRUPT                      	#
046430,000049: 17,2553           32634                           CAF      DELTATT3                      	# = 60 MS  RESET TO EXECUTE PHASE1
046431,000050: 17,2554           61634                           AD       T5TIME                        	#
046432,000051: 17,2555           54030                           TS       TIME5                         	#
046433,000052: 17,2556           12561                           TCF      +3                            	#
046434,000053: 17,2557           32635                           CAF      DELATT20                      	# = 20 MS  TO ASSURE A T5RUPT
046435,000054: 17,2560           54030                           TS       TIME5                         	#
046436,000055: 17,2561           33313                           CAF      =14MS                         	# RESET T6 TO INITIALIZE THE JET CHANNELS
046437,000056: 17,2562           54031                           TS       TIME6                         	# IN 14 MS
046438,000057: 17,2563           35001                           CAF      NEGMAX                        	#
046439,000058: 17,2564           00006                           EXTEND                                 	#
046440,000059: 17,2565           05013                           WOR      CHAN13                        	#
046441,000060: 17,2566           00006                           EXTEND                                 	#
046442,000061: 17,2567           22012                           QXCH     QRUPT                         	#
046443,000062: 17,2570           32633                           CAF      XLNMASK                       	# = 7700 OCT
046444,000063: 17,2571           00006                           EXTEND                                 	# EXAMINE THE TRANSLATION
046445,000064: 17,2572           06031                           RXOR     CHAN31                        	# HAND CONTROLLER
046446,000065: 17,2573           72633                           MASK     XLNMASK                       	#
046447,000066: 17,2574           00006                           EXTEND                                 	#
046448,000067: 17,2575           12636                           BZF      NOXLNCMD                      	#
046449,000068: 17,2576           55502                           TS       T5TEMP                        	#
046450,000069: 17,2577           00006                           EXTEND                                 	#
046451,000070: 17,2600           75007                           MP       BIT9                          	#
046452,000071: 17,2601           76214                           MASK     THREE                         	#
046453,000072: 17,2602           55513                           TS       XNDX1                         	# AC QUAD  X-TRANSLATION INDEX
046454,000073: 17,2603           55514                           TS       XNDX2                         	# BD QUAD  X-TRANSLATION INDEX
046455,000074: 17,2604           31502                           CA       T5TEMP                        	#
046456,000075: 17,2605           00006                           EXTEND                                 	# 1 = + XLN
046457,000076: 17,2606           75011                           MP       BIT7                          	# 2 = - XLN
046458,000077: 17,2607           76214                           MASK     THREE                         	# 3 = NO XLN
046459,000078: 17,2610           55515                           TS       YNDX                          	# Y-TRANSLATION INDEX
046460,000079: 
046461,000080: 17,2611           31502                           CA       T5TEMP                        	#
046462,000081: 17,2612           00006                           EXTEND                                 	#
046463,000082: 17,2613           75013                           MP       BIT5                          	#
046464,000083: 17,2614           76214                           MASK     THREE                         	#
046465,000084: 17,2615           55516                           TS       ZNDX                          	# Z-TRANSLATION INDEX
046466,000085: 
046467,000086: 17,2616           31466                           CA       DAPDATR1                      	# SET ATTKALMN TO PICK UP FILTER GAINS FOR
046468,000087: 17,2617           75002                           MASK     BIT14                         	# TRANSLATIONS.
046469,000088: 17,2620           00006                           EXTEND                                 	# CHECK DAPDATR1 BIT 14 FOR LEM ATTACHED.
046471,000090: 17,2621           12624                           BZF      NOLEM                         	#
046472,000091: 17,2622           46214                           CS       THREE                         	# IF LEM IS ON, SET ATTKALMN = -3
046473,000092: 17,2623           12625                           TCF      +2                            	#
046474,000093: 17,2624           45016        NOLEM              CS       TWO                           	# IF LEM IS OFF, SET ATTKALMN = -2.
046475,000094: 17,2625           55617                           TS       ATTKALMN                      	#
046476,000095: 17,2626           11631                           CCS      XTRANS                        	# (+, -1, 0)
046477,000096: 17,2627           55513                           TS       XNDX1                         	# USING BD-X  ZERO XNDX1
046478,000097: 17,2630           12642                           TCF      PWORD                         	#
046479,000098: 17,2631           55514                           TS       XNDX2                         	# USING AC-X  ZERO XNDX2
046480,000099: 17,2632           12642                           TCF      PWORD                         	#
046481,000100: 17,2633           07700        XLNMASK            OCT      7700                          	#
046482,000101: 
046483,000102: 17,2634           37772        DELTATT3           DEC      16378      B-14               	# = 60 MS
046484,000103: 17,2635           37776        DELATT20           DEC      16382      B-14               	# = 20 MS
046485,000104: 
046486,000105: 17,2636           55513        NOXLNCMD           TS       XNDX1                         	# ZERO ALL REQUESTS FOR TRANSLATION
046487,000106: 17,2637           55514                           TS       XNDX2                         	#
046488,000107: 17,2640           55515                           TS       YNDX                          	#
046489,000108: 17,2641           55516                           TS       ZNDX                          	#
046490,000109: 
046491,000110:                                                                                          	# PITCH COMMANDS  TIMING(NO X-TRANS, NO QUAD FAILS) 32MCT
046492,000111: 
046493,000112: 17,2642           11562        PWORD              CCS      TAU1                          	# CHECK FOR PITCH COMMANDS
046494,000113: 17,2643           35017                           CAF      ONE                           	#
046495,000114: 17,2644           12646                           TCF      +2                            	#  0 = NO PITCH
046496,000115: 17,2645           35016                           CAF      TWO                           	# +1 =  + PITCH
046497,000116: 17,2646           55520                           TS       PINDEX                        	# +2 =  - PITCH
046498,000117: 
046499,000118: 17,2647           11626                           CCS      RACFAIL                       	# FLAG FOR REAL AC QUAD FAILURES
046500,000119: 17,2650           12654                           TCF      AFAILP                        	#
046501,000120: 17,2651           12664                           TCF      TABPCOM                       	# 0 = NO REAL AC FAILURES
046502,000121: 17,2652           12656                           TCF      CFAILP                        	# + = A QUAD FAILED
046503,000122: 17,2653           12664                           TCF      TABPCOM                       	# - = C QUAD FAILED
046504,000123:                                                                                          	# IF FAILURES ARE PRESENT IGNORE
046505,000124:                                                                                          	# X-TRANSLATIONS ON THIS AXIS
046506,000125: 
046507,000126: 17,2654           34334        AFAILP             CAF      NINE                          	# IF FAILURE IS PRESENT 1JET OPERATION
046508,000127: 17,2655           12666                           TCF      TABPCOM    +2                 	# IS ASSUMED.  IGNORE X-TRANSLATION
046509,000128: 17,2656           35771        CFAILP             CAF      TWELVE                        	#
046510,000129: 17,2657           12666                           TCF      TABPCOM    +2                 	#
046511,000130: 
046512,000131: 17,2660           00000        XLNNDX             DEC      0          B-14               	# INDECES FOR TRANSLATION COMMANDS
046513,000132: 17,2661           00003                           DEC      3          B-14               	# FOR USE IN TABLE LOOK UP
046514,000133: 17,2662           00006                           DEC      6          B-14               	#
046515,000134: 17,2663           00000                           DEC      0          B-14               	#
046516,000135: 
046517,000136: 17,2664     5771               TWELVE             =        OCT14                         	#
046518,000137: 
046519,000138:                                                                                          	# TABLE LOOK UP FOR PITCH COMMANDS WITH AND WITHOUT X-TRANSLATION AND AC QUAD FAILURES PRESENT.
046520,000139:                                                                                          	# BITS 9, 10 CONTAIN THE NUMBER OF PITCH JETS USED TO PERFORM THE PITCH ROTATION
046522,000141: 
046523,000142: 17,2664           51513        TABPCOM            INDEX    XNDX1                         	#
046524,000143: 17,2665           32660                           CA       XLNNDX                        	#
046525,000144: 17,2666           61520                           AD       PINDEX                        	#
046526,000145: 17,2667           50000                           INDEX    A                             	#
046527,000146: 17,2670           32714                           CA       PYTABLE                       	#
046528,000147: 17,2671           72733                           MASK     PJETS                         	# =1417 OCT
046529,000148: 17,2672           55453                           TS       PWORD1                        	#
046530,000149: 17,2673           00006                           EXTEND                                 	#
046531,000150: 17,2674           75011                           MP       BIT7                          	#
046532,000151: 17,2675           55523                           TS       NPJETS                        	# = NO. OF PITCH JETS
046533,000152: 
046534,000153:                                                                                          	# YAW JET COMMANDS  TIMING(NO X-TRANS, NO QUAD FAILURES)  32MCT
046535,000154: 

053522,000274: 01,3307           53415                           DXCH     LST2       +4                 	#
053523,000275: 01,3310           53417                           DXCH     LST2       +6                 	#
053524,000276: 01,3311           53421                           DXCH     LST2       +8D                	#
053525,000277: 01,3312           53423                           DXCH     LST2       +10D               	# AT END, CHECK THAT C(LST2 +10) IS STD
053526,000278: 01,3313           53425                           DXCH     LST2       +12D               	#
053527,000279: 01,3314           53427                           DXCH     LST2       +14D               	#
053528,000280: 01,3315           53431                           DXCH     LST2       +16D               	#
053529,000281: 01,3316           65304                           AD       ENDTASK                       	# END ITEM, AS CHECK FOR EXCEEDING
053530,000282:                                                                                          	# THE LENGTH OF THE LIST.
053531,000283: 01,3317           00006                           EXTEND                                 	# DUMMY TASK ADRES SHOULD BE IN FIXED-
053532,000284: 01,3320           15263                           BZF      LVWTLIST                      	# FIXED SO ITS ADRES ALONE DISTINGUISHES
053533,000285: 01,3321           13375                           TCF      WTABORT                       	# IT.
053534,000286: 
053535,000287:                                                                                          	# Page 1228

021605,001345: 
021606,001346: 04,2654           53575        GET+MGA            VLOAD    UNIT                          	# (PL 0D) V (+7) TO MPAC, UNITIZE UV (+1)
021607,001347: 04,2655           72441                           DOT      SL1                           	# DOT UV WITH Y(STABLE MEMBER) AND RESCALE
021608,001348: 04,2656           01744                                    REFSMMAT   +6                 	# FROM +2 TO +1 FOR ASIN ROUTINE
021609,001349: 04,2657           51136                           ARCSIN   BPL                           	#

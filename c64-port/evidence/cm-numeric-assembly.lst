025424,000507: 37,2465           61740        19.77DEG           OCT      61740                         	#
025425,000508: 
025427,000510:                                                                                          	# PROGRAM DESCRIPTION
025428,000511:                                                                                          	# MOD NO-  1
025429,000512:                                                                                          	# MOD BY-  N. BRODEUR
025430,000513: 
025431,000514:                                                                                          	# FUNCTIONAL DESCRIPTION
025432,000515: 
025433,000516:                                                                                          	# TO PERFORM SIGHTING MARKS IN CONJUNCTION WITH THE RENDEZVOUS NAVIG-
025434,000517:                                                                                          	# ATION PROGRAM.  CALLED BY ASTRONAUT VIA EXTENDED VERB
025435,000518: 
025436,000519:                                                                                          	# CALLING SEQUENCE-
025437,000520: 
025438,000521:                                                                                          	#       R21 VIA V57
025439,000522:                                                                                          	#       R23 VIA V 54
025440,000523: 
025441,000524:                                                                                          	# SUBROUTINES CALLED-
025442,000525: 
025443,000526:                                                                                          	#       FLAGUP          FLAGDOWN        BANKCALL
025444,000527:                                                                                          	#       ENDOFJOB        GOMARK2         GOMARKF
025445,000528:                                                                                          	#       INTPRET         GENTRAN         KLEENEX
025446,000529:                                                                                          	#       ENDMARK
025447,000530: 
025448,000531:                                                                                          	# NORMAL EXIT MODES-
025449,000532: 
025450,000533:                                                                                          	# MARKRUPT USED BY SXTMARK HAS BEEN MODIFIED TO STORE MARK IN MRKBUF2
025451,000534:                                                                                          	# FOR USE BY R22.  WHEN ASTRONAUT IS FINISHED TAKING MARKS, HE HITS AN
025452,000535:                                                                                          	# PROCEED, R21 IS TERMINATED THUS CAUSING THE FINAL MARK TO BE TRANSFRD
025453,000536:                                                                                          	# TO MRKBUF2 FOR PROCESSING BY R22
025454,000537: 
025455,000538:                                                                                          	# ALARM OR ABORT EXIT MODES-
025456,000539: 
025457,000540:                                                                                          	#       NONE
025458,000541: 
025459,000542:                                                                                          	# OUTPUT-
025460,000543: 

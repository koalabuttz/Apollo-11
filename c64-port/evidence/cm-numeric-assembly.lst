051380,002127: 00,2733           60000                           DOUBLE                                 	#
051381,002128: 00,2734           54000                           OVSK                                   	#
051382,002129: 00,2735           12725                           TCF      /NORM2                        	# DOUBLE AND TRY AGAIN IF NOT.
051383,002130: 
051384,002131: 00,2736           02750                           TC       V/SCDV                        	# DO X COMPONENT DIVIDE.
051385,002132: 00,2737           52160                           DXCH     MPAC       +3                 	# SUPPLY ARGUMENTS IN USUAL SEQUENCE.
051386,002133: 00,2740           52155                           DXCH     MPAC                          	#
051387,002134: 00,2741           52160                           DXCH     MPAC       +3                 	#
051388,002135: 
051389,002136: 00,2742           02750                           TC       V/SCDV                        	# Y COMPONENT.
051390,002137: 00,2743           52162                           DXCH     MPAC       +5                 	#
051391,002138: 00,2744           52155                           DXCH     MPAC                          	#
051392,002139: 00,2745           52162                           DXCH     MPAC       +5                 	#
051393,002140: 
051394,002141: 00,2746           02750                           TC       V/SCDV                        	# Z COMPONENT.
051395,002142: 00,2747           17367                           TCF      VROTATEX                      	# GO RE-ARRANGE COMPONENTS BEFORE EXIT.
051396,002143: 
051397,002144:                                                                                          	# Page 1173
051398,002145:                                                                                          	# SUBROUTINE USED BY V/SC TO DIVIDE VECTOR COMPONENT IN MPAC,+1 BY THE SCALAR GIVEN IN BUF.
051399,002146: 

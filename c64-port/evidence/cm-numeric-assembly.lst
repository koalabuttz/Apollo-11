017209,000140: 27,2106           35066                           CAF      PRIO14                        	# RESTORE ORIGINAL PRIORITY
017210,000141: 27,2107           05210                           TC       PRIOCHNG                      	#
017211,000142: 
017212,000143: 27,2110           01053                           TC       TBASE1                        	#
017213,000144: 
017214,000145: 27,2111           05412        GOREDO20           TC       PHASCHNG                      	#
017215,000146: 27,2112           00111                           OCT      111                           	# 1.11 FOR PIKUP20
017216,000147: 
017217,000148: 27,2113           05217                           TC       ENDOFJOB                      	#
017218,000149: 
017219,000150: 27,2114           31011        R61TEST            CA       MODREG                        	# ARE WE IN P00.  IF YES THIS MUST BE
017220,000151: 27,2115           00006                           EXTEND                                 	#       VERB49 OR VERB89 SO DO ENDEXT.
017221,000152: 27,2116           12052                           BZF      ENDMANU1                      	# RESET 3-AXIS & RUTURN.  USER DOES ENDEXT
017222,000153: 27,2117           30100                           CA       FLAGWRD4                      	# ARE WE IN R61 (P20)
017223,000154: 27,2120           75004                           MASK     BIT12                         	#
017224,000155: 27,2121           00006                           EXTEND                                 	#
017225,000156: 27,2122           14106                           BZF      GOTOPOOH                      	# NO
017226,000157: 27,2123           04622                           TC       GOTOV56                       	# YES
017227,000158: 
017228,000159: 27,2124           20100        BIT14+7            OCT      20100                         	#                                       -
017229,000160: 27,2125           01422        V06N18             VN       0618                          	#
017230,000161: 
017232,000163:                                                                                          	# PROGRAM DESCRIPTION - VECPOINT
017233,000164: 
017234,000165:                                                                                          	# THIS INTERPRETIVE SUBROUTINE MAY BE USED TO POINT A SPACECRAFT AXIS IN A DESIRED DIRECTION.  THE AXIS
017235,000166:                                                                                          	# TO BE POINTED MUST APPEAR AS A HALF UNIT DOUBLE PRECISION VECTOR IN SUCCESSIVE LOCATIONS OF ERASABLE MEMORY
017236,000167:                                                                                          	# BEGINNING WITH THE LOCATION CALLED SCAXIS.  THE COMPONENTS OF THIS VECTOR ARE GIVEN IN SPACECRAFT COORDINATES.
017237,000168:                                                                                          	# THE DIRECTION IN WHICH THIS AXIS IS TO BE POINTED MUST APPEAR AS A HALF UNIT DOUBLE PRECISION VECTOR IN
017238,000169:                                                                                          	# SUCCESSIVE LOCATIONS OF ERASABLE MEMORY BEGINNING WITH THE ADDRESS CALLED POINTVSM.  THE COMPONENTS OF THIS
017239,000170:                                                                                          	# VECTOR ARE GIVEN IN STABLE MEMBER COORDINATES.  WITH THIS INFORMATION VECPOINT COMPUTES A SET OF THREE GIMBAL
017240,000171:                                                                                          	# ANGLES (2S COMPLEMENT) CORRESPONDING TO THE CROSS-PRODUCT ROTATION BETWEEN SCAXIS AND POINTVSM AND STORES THEM
017241,000172:                                                                                          	# IN T(MPAC) BEFORE RETURNING TO THE CALLER.
017242,000173: 
017243,000174:                                                                                          	# THIS ROTATION, HOWEVER, MAY BRING THE S/C INTO GIMBAL LOCK.  WHEN POINTING A VECTOR IN THE Y-Z PLANE,
017244,000175:                                                                                          	# THE TRANSPONDER AXIS, OR THE AOT FOR THE LEM, THE PROGRAM WILL CORRECT THIS PROBLEM BY ROTATING THE CROSS-
017245,000176:                                                                                          	# PRODUCT ATTITUDE ABOUT POINTVSM BY A FIXED AMOUNT SUFFICIENT TO ROTATE THE DESIRED S/C ATTITUDE OUT OF GIMBAL
017246,000177:                                                                                          	# LOCK.  IF THE AXIS TO BE POINTED IS MORE THAN 40.6 DEGREES BUT LESS THAN 60.5 DEG FROM THE +X (OR -X) AXIS,
017247,000178:                                                                                          	# THE ADDITIONAL ROTATION TO AVOID GIMAL LOCK IS 35 DEGREES.  IF THE AXIS IS MORE THAN 60.5 DEGEES FROM +X (OR -X)
017248,000179:                                                                                          	# THE ADDITIONAL ROTATION IS 35 DEGREES.  THE GIMBAL ANGLES CORRESPONDING TO THIS ATTITUDE ARE THEN COMPUTED AND
017249,000180:                                                                                          	# STORED AS 2S COMPLIMENT ANGLES IN T(MPAC) BEFORE RETURNING TO THE CALLER.
017250,000181: 
017251,000182:                                                                                          	# WHEN POINTING THE X-AXIS, OR THE THRUST VECTOR, OR ANY VECTOR WITHIN 40.6 DEG OF THE X-AXIS, VECPOINT
017252,000183:                                                                                          	# CANNOT CORRECT FOR A CROSS-PRODUCT ROTATION INTO GIMBAL LOCK.  IN THIS CASE A PLATFORM REALIGNMENT WOULD BE
017253,000184:                                                                                          	# REQUIRED TO POINT THE VECTOR IN THE DESIRED DIRECTION.  AT PRESENT NO INDICATION IS GIVEN FOR THIS SITUATION
017254,000185:                                                                                          	# EXCEPT THAT THE FINAL MIDDLE GIMBAL ANGLE IN MPAC +2 IS GREATER THAN 59 DEGREES.
017255,000186: 
017256,000187:                                                                                          	# CALLING SEQUENCE -
017257,000188: 
017258,000189:                                                                                          	#       1)      LOAD SCAXIS, POINTVSM
017259,000190:                                                                                          	#       2)      CALL
017260,000191:                                                                                          	#                       VECPOINT
017261,000192: 
017262,000193:                                                                                          	# RETURNS WITH
017263,000194: 
017264,000195:                                                                                          	#       1)      DESIRED OUTER GIMBAL ANGLE IN MPAC
017265,000196:                                                                                          	#       2)      DESIRED INNER GIMBAL ANGLE IN MPAC +1
017266,000197:                                                                                          	#       3)      DESIRED MIDDLE GIMBAL ANGLE IN MPAC +2
017267,000198: 
017268,000199:                                                                                          	# ERASABLES USED -
017269,000200: 
017270,000201:                                                                                          	#       1)      SCAXIS          6
017271,000202:                                                                                          	#       2)      POINTVSM        6
017272,000203:                                                                                          	#       3)      MIS             18
017273,000204:                                                                                          	#       4)      DEL             18
017274,000205:                                                                                          	#       5)      COF             6
017275,000206:                                                                                          	#       6)      VECQTEMP        1
017276,000207:                                                                                          	#       7)      ALL OF VAC AREA 43
017277,000208: 
017278,000209:                                                                                          	#                       TOTAL   99
017279,000210: 
017280,000211: 27,2000                                           SETLOC   VECPT                         	#
017281,000212: 27,2000                                           BANK                                   	#
017283,000214: 27,2126  E6,1661                                  EBANK=   BCDU                          	#
017284,000215: 
017285,000216: 27,2126                                           COUNT    27/VECPT                      	#
017286,000217: 
017287,000218: 27,2126           40020        VECPOINT           STQ      BOV                           	# SAVE RETURN ADDRESS
017288,000219: 27,2127           03310                                    VECQTEMP                      	#
017289,000220: 27,2130           56131                                    VECLEAR                       	# AND CLEAR OVFIND
017290,000221: 27,2131           47164        VECLEAR            AXC,2    RTB                           	#
017291,000222: 27,2132           03320                                    MIS                           	# READ THE PRESENT CDU ANGLES AND
017292,000223: 27,2133           44376                                    READCDUK                      	# STORE THEM IN PD25, 26, 27
017293,000224: 27,2134           34032                           STCALL   25D                           	#
017294,000225: 27,2135           44405                                    CDUTODCM                      	# S/C AXES TO STABLE MEMBER AXES (MIS)
017295,000226: 27,2136           61375                           VLOAD    VXM                           	#
017296,000227: 27,2137           03357                                    POINTVSM                      	# RESOLVE THE POINTING DIRECTION VF INTO
017297,000228: 27,2140           03321                                    MIS                           	# INITIAL S/C AXES (VF = POINTVSM)
017298,000229: 27,2141           77656                           UNIT                                   	#
017299,000230: 27,2142           00035                           STORE    28D                           	#
017300,000231:                                                                                          	# PD 28 29 30 31 32 33
017301,000232: 27,2143           53435                           VXV      UNIT                          	# TAKE THE CROSS PRODUCT VF X VI
017302,000233: 27,2144           03351                                    SCAXIS                        	# WHERE VI = SCAXIS
017303,000234: 27,2145           57400                           BOV      VCOMP                         	#
017304,000235: 27,2146           56256                                    PICKAXIS                      	#
017305,000236: 27,2147           17343                           STODL    COF                           	# CHECK MAGNITUDE
017306,000237: 27,2150           00045                                    36D                           	# OF CROSS PRODUCT
017307,000238: 27,2151           50025                           DSU      BMN                           	# VECTOR, IF LESS
017308,000239: 27,2152           16327                                    DPB-14                        	# THAN B-14 ASSUME
017309,000240: 27,2153           56256                                    PICKAXIS                      	# UNIT OPERATION
017310,000241: 27,2154           50375                           VLOAD    DOT                           	# INVALID.
017311,000242: 27,2155           03351                                    SCAXIS                        	#
017312,000243: 27,2156           00035                                    28D                           	#
017313,000244: 27,2157           65552                           SL1      ARCCOS                        	#
017314,000245: 27,2160           77624        COMPMATX           CALL                                   	# NOW COMPUTE THE TRANSFORMATION FROM
017315,000246: 27,2161           44530                                    DELCOMP                       	# FINAL S/C AXES TO INITIAL S/C AXES MFI
017316,000247: 27,2162           75160                           AXC,1    AXC,2                         	#
017317,000248: 27,2163           03320                                    MIS                           	# COMPUTE THE TRANSFORMATION FROM FINAL
017318,000249: 27,2164           03425                                    DEL                           	# S/C AXES TO STABLE MEMBER AXES
017319,000250: 27,2165           77624                           CALL                                   	# MFS = MIS MFI
017320,000251: 27,2166           44304                                    MXM3                          	# (IN PD LIST)
017321,000252: 
017322,000253: 27,2167           51545                           DLOAD    ABS                           	#
017323,000254: 27,2170           00007                                    6                             	# MFS6 = SIN(CPSI)                      $2
017324,000255: 27,2171           50025                           DSU      BMN                           	#
017325,000256: 27,2172           16314                                    SINGIMLC                      	# = SIN(59 DEGS)                        $2
017326,000257: 27,2173           56246                                    FINDGIMB                      	# /CPSI/ LESS THAN 59 DEGS
017327,000258:                                                                                          	# I.E. DESIRED ATTITUDE NOT IN GIMBAL LOCK
017328,000259: 
017329,000260: 27,2174           51545                           DLOAD    ABS                           	# CHECK TO SEE IF WE ARE POINTING
017330,000261: 27,2175           03351                                    SCAXIS                        	# THE THRUST AXIS
017331,000262: 27,2176           51025                           DSU      BPL                           	#
017332,000263: 27,2177           16316                                    SINVEC1                       	# SIN 49.4 DEGS                         $2
017334,000265: 27,2200           56246                                    FINDGIMB                      	# IF SO, WE ARE TRYING TO POINT IT INTO
017335,000266: 27,2201           77775                           VLOAD                                  	# GIMBAL LOCK, ABORT COULD GO HERE
017336,000267: 27,2202           77626                           STADR                                  	#
017337,000268: 27,2203           50442                           STOVL    MIS        +12D               	#
017338,000269: 27,2204           77626                           STADR                                  	# STORE MFS (IN PD LIST) IN MIS
017339,000270: 27,2205           50450                           STOVL    MIS        +6                 	#
017340,000271: 27,2206           77626                           STADR                                  	#
017341,000272: 27,2207           50456                           STOVL    MIS                           	#
017342,000273: 27,2210           03327                                    MIS        +6                 	# INNER GIMBAL AXIS IN FINAL S/C AXES
017343,000274: 27,2211           57444                           BPL      VCOMP                         	# LOCATE THE IG AXIS DIRECTION CLOSEST TO
017344,000275: 27,2212           56213                                    IGSAMEX                       	# FINAL X S/C AXIS
017345,000276: 
017346,000277: 27,2213           50035        IGSAMEX            VXV      BMN                           	# FIND THE SHORTEST WAY OF ROTATING THE 
017347,000278: 27,2214           03351                                    SCAXIS                        	# S/C OUT OF GIMBAL LOCK BY A ROTATION 
017348,000279: 27,2215           56222                                    U=SCAXIS                      	# ABOUT +- SCAXIS, I.E. IF  (IG (SGN MFS3)
017349,000280:                                                                                          	# X SCAXIS . XF) LESS THAN 0, U = SCAXIS
017350,000281:                                                                                          	# OTHERWISE U = -SCAXIS
017351,000282: 
017352,000283: 27,2216           57575                           VLOAD    VCOMP                         	#
017353,000284: 27,2217           03351                                    SCAXIS                        	#
017354,000285: 27,2220           37343                           STCALL   COF                           	# ROTATE ABOUT -SCAXIS
017355,000286: 27,2221           56225                                    CHEKAXIS                      	#
017356,000287: 27,2222           77775        U=SCAXIS           VLOAD                                  	#
017357,000288: 27,2223           03351                                    SCAXIS                        	#
017358,000289: 27,2224           03343                           STORE    COF                           	# ROTATE ABOUT + SCAXIS
017359,000290: 27,2225           51545        CHEKAXIS           DLOAD    ABS                           	#
017360,000291: 27,2226           03351                                    SCAXIS                        	# SEE IF WE ARE POINTING THE AOT
017361,000292: 27,2227           51025                           DSU      BPL                           	#
017362,000293: 27,2230           16320                                    SINVEC2                       	# SIN 29.5 DEGS                         $2
017363,000294: 27,2231           56235                                    PICKANG1                      	# IF SO, ROTATE 50 DEGS ABOUT +- SCAXIS
017364,000295: 27,2232           52145                           DLOAD    GOTO                          	# IF NOT, MUST BE POINTING THE TRANSPONDER
017365,000296: 27,2233           16324                                    VECANG2                       	# OR SOME VECTOR IN THE Y, OR Z PLANE
017366,000297: 27,2234           56237                                    COMPMFSN                      	# IN THIS CASE ROTATE 35 DEGS TO GET OUT
017367,000298:                                                                                          	# OF GIMBAL LOCK (VECANG2 $360)
017368,000299: 27,2235           77745        PICKANG1           DLOAD                                  	#
017369,000300: 27,2236           16322                                    VECANG1                       	# = 50 DEGS                          $ 360
017370,000301: 27,2237           77624        COMPMFSN           CALL                                   	#
017371,000302: 27,2240           44530                                    DELCOMP                       	# COMPUTE THE ROTATION ABOUT SCAXIS TO
017372,000303: 27,2241           75160                           AXC,1    AXC,2                         	# BRING MFS OUT OF GIMBAL LOCK
017373,000304: 27,2242           03320                                    MIS                           	#
017374,000305: 27,2243           03425                                    DEL                           	#
017375,000306: 27,2244           77624                           CALL                                   	# COMPUTE THE NEW TRANSFORMATION FROM
017376,000307: 27,2245           44304                                    MXM3                          	# DESIRED S/C AXES TO STABLE MEMBER AXES
017377,000308:                                                                                          	# WHICH WILL ALIGN VI WITH VF AND AVOID
017378,000309:                                                                                          	# GIMBAL LOCK
017379,000310: 27,2246           45160        FINDGIMB           AXC,1    CALL                          	#
017380,000311: 27,2247           00000                                    0                             	# EXTRACT THE COMMANDED CDU ANGLES FROM
017381,000312: 27,2250           44655                                    DCMTOCDU                      	# THIS MATRIX
017382,000313: 27,2251           40234                           RTB      SETPD                         	#
017383,000314: 27,2252           45552                                    V1STO2S                       	# CONVERT TO 2:S COMPLEMENT
017385,000316: 27,2253           00001                                    0                             	#
017386,000317: 27,2254           77650                           GOTO                                   	#
017387,000318: 27,2255           03310                                    VECQTEMP                      	# RETURN TO CALLER
017388,000319: 
017389,000320: 27,2256           50375        PICKAXIS           VLOAD    DOT                           	# IF VF X VI = 0, FIND VF . VI
017390,000321: 27,2257           00035                                    28D                           	#
017391,000322: 27,2260           03351                                    SCAXIS                        	#
017392,000323: 27,2261           72240                           BMN      TLOAD                         	#
017393,000324: 27,2262           56266                                    ROT180                        	#
017394,000325: 27,2263           00032                                    25D                           	#
017395,000326: 27,2264           77650                           GOTO                                   	# IF VF = VI, CDU DESIRED = PRESENT CDU
017396,000327: 27,2265           03310                                    VECQTEMP                      	# PRESENT CDU ANGLES
017397,000328: 
017398,000329: 27,2266           47375        ROT180             VLOAD    VXV                           	# IF VF, VI ANTIPARALLEL, 180 DEG ROTATION
017399,000330: 27,2267           03327                                    MIS        +6                 	# IS REQUIRED.  Y STABLE MEMBER AXIS IN
017400,000331: 27,2270           15333                                    HIUNITX                       	# INITIAL S/C AXIS.
017401,000332: 27,2271           47256                           UNIT     VXV                           	# FIND Y(SM) X X(I)
017402,000333: 27,2272           03351                                    SCAXIS                        	# FIND UNIT(VI X UNIT(Y(SM) X X(I)))
017403,000334: 27,2273           40056                           UNIT     BOV                           	# I.E. PICK A VECTOR IN THE PLANE OF X(I),
017404,000335: 27,2274           56310                                    PICKX                         	# Y(SM) PERPENDICULAR TO VI
017405,000336: 27,2275           17343                           STODL    COF                           	#
017406,000337: 27,2276           00045                                    36D                           	# CHECK MAGNITUDE
017407,000338: 27,2277           50025                           DSU      BMN                           	# OF THIS VECTOR.
017408,000339: 27,2300           16327                                    DPB-14                        	# IF LESS THAN B-14,
017409,000340: 27,2301           56310                                    PICKX                         	# PICK X-AXIS.
017410,000341: 27,2302           77775                           VLOAD                                  	#
017411,000342: 27,2303           03343                                    COF                           	#
017412,000343: 27,2304           17343        XROT               STODL    COF                           	#
017413,000344: 27,2305           15333                                    HIDPHALF                      	#
017414,000345: 27,2306           77650                           GOTO                                   	#
017415,000346: 27,2307           56160                                    COMPMATX                      	#
017416,000347: 27,2310           52175        PICKX              VLOAD    GOTO                          	# PICK THE XAXIS IN THIS CASE
017417,000348: 27,2311           15333                                    HIUNITX                       	#
017418,000349: 27,2312           56304                                    XROT                          	#
017419,000350: 35,2000                                           BANK     35                            	#
017420,000351: 27,2000                                           SETLOC   MANUVER1                      	#
017421,000352: 27,2000                                           BANK                                   	#
017422,000353: 
017423,000354: 27,2313           15555 35172  SINGIMLC           2DEC     .4285836003                    	# = SIN(59)                             $2
017424,000355: 
017425,000356: 27,2315           14113 36326  SINVEC1            2DEC     .3796356537                    	# = SIN(49.4)                           $2
017426,000357: 
017427,000358: 27,2317           07701 35703  SINVEC2            2DEC     .2462117800                    	# = SIN(29.5)                           $2
017428,000359: 
017429,000360: 27,2321           04343 21616  VECANG1            2DEC     .1388888889                    	# = 50 DEGREES                        $360
017430,000361: 
017431,000362: 27,2323           03070 34344  VECANG2            2DEC     .09722222222                    	# = 35 DEGREES                        $360
017432,000363: 
017433,000364: 
017434,000365: 27,2325           00000        1BITDP             OCT      0                             	# KEEP THIS BEFORE DPB(-14)      *********
017435,000366: 27,2326           00001        DPB-14             OCT      00001                         	#
017437,000368: 27,2327           00000                           OCT      00000                         	#
017438,000369: 34,2002                                           BANK     34                            	#

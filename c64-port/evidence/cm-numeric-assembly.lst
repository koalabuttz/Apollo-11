047259,000878: 17,3662           03700                           TC       REPLACER                      	#
047260,000879: 17,3663           45017                           CS       ONE                           	#
047261,000880: 17,3664           55457                           TS       BLAST                         	#
047262,000881: 17,3665           13647                           TCF      T6L1                          	#
047263,000882: 
047264,000883: 17,3666           51462        REPLACE1           INDEX    BLAST1     +1                 	#
047266,000885: 17,3667           03700                           TC       REPLACER                      	#
047267,000886: 17,3670           45017                           CS       ONE                           	#
047268,000887: 17,3671           55461                           TS       BLAST1                        	#
047269,000888: 17,3672           13654                           TCF      T6L2                          	#
047270,000889: 

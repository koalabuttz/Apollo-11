036596,000035: 
036598,000037:                                                                                          	# PROGRAM NAME -        PREREAD, READACCS, SERVICER, AVERAGE G.
036599,000038:                                                                                          	# MOD NO. 00 BY M. HAMILTON     DEC. 12, 1966
036600,000039: 
036601,000040:                                                                                          	# FUNCTIONAL DESCRIPTION
036602,000041: 
036603,000042:                                                                                          	# THE ROUTINES DESCRIBED BELOW ARE USED TO CALCULATE VALUES OF RN, VN, AND GDT/2 DURING ACCELERATED FLIGHT.
036604,000043:                                                                                          	# THE SEVERAL ROUTINES COMPRISE A PACKAGE AND ARE NOT MEANT TO BE USED AS SEPARATE SUBROUTINES.
036605,000044: 
036606,000045:                                                                                          	# GENERAL REFERENCES TO  SERVICER  OR  AVERAGE G  ARE UNDERSTOOD TO REFER TO THE ENTIRE SET OF ROUTINES INCLUDING
036607,000046:                                                                                          	# READACCS, SERVICER, AVERAGE G, INTEREAD, SMOOTHER, AND ANY ADDITIONAL ROUTINES ATTACHED AT AVGEXIT (SEE BELOW).
036608,000047: 
036609,000048:                                                                                          	# PROGRAMS INITIATING SERVICER ARE REQUIRED TO MAKE A WAITLIST CALL FOR PREREAD (OR, IF LIFTOFF, FOR BIBIBIAS)
036610,000049:                                                                                          	# AT 2 SECONDS BEFORE THE FIRST AVERAGE G UPDATE IN ORDER TO INITIALIZE THE SEQUENCE, WHICH WILL RECUR EVERY
036611,000050:                                                                                          	# 2 SECONDS FROM THAT TIME ON AS LONG AS AVEGFLAG REMAINS SET.
036612,000051: 
036613,000052:                                                                                          	# THE USE OF ERASABLE AVGEXIT ALLOWS VARIOUS ROUTINES TO BE PERFORMED AS PART OF THE NORMAL CYCLE (SEE
036614,000053:                                                                                          	# EXPLANATION OF AVGEXIT BELOW).
036615,000054: 
036616,000055:                                                                                          	# DESCRIPTIONS OF INDIVIDUAL ROUTINES FOLLOW.
036617,000056: 
036618,000057:                                                                                          	#       PREREAD
036619,000058: 
036620,000059:                                                                                          	#               PREVIOUSLY EXTRAPOLATED VALUES COPIED FROM RN1, VN1, AND PIPTIME1 INTO RN, VN, AND PIPTIME.
036621,000060:                                                                                          	#               LASTBIAS JOB SCHEDULED.
036622,000061:                                                                                          	#               PIPS READ AND CLEARED VIA PIPASR SUBROUTINE.
036623,000062:                                                                                          	#               AVERAGE G FLAG SET ON.
036624,000063:                                                                                          	#               DRIFT FLAG SET OFF.
036625,000064:                                                                                          	#               V37 FLAG SET ON.
036626,000065:                                                                                          	#               INITIALIZATION OF       1) THRUST MONITOR (DVMON) - DVCNTR SET TO ONE.
036627,000066:                                                                                          	#                                       2) TOTAL ACCUMULATED DELV VALUE (DVTOTAL) - SET TO ZERO.
036628,000067:                                                                                          	#                                       3) AXIS VECTOR (AXIS) - SET TO (.5,0,0).
036629,000068:                                                                                          	#               NORMLIZE JOB SCHEDULED.
036630,000069:                                                                                          	#               READACCS TASK CALLED IN 2 SECONDS.
036631,000070: 
036632,000071:                                                                                          	#       NORMLIZE
036633,000072: 
036634,000073:                                                                                          	#               GDT/2 INITIALIZED VIA CALCGRAV SUBROUTINE.
036635,000074: 
036636,000075:                                                                                          	#       READACCS
036637,000076: 
036638,000077:                                                                                          	#               IF ONMON FLAG SET QUIKREAD ROUTINE IS PERFORMED BEFORE PIPASR ZEROS THE PIPA REGISTERS, AND THE 1/2 SEC
036639,000078:                                                                                          	#               ONMONITOR LOOP IS INITIATED TO PROVIDE DOWNLINK INFORMATION DURING ENTRY.
036640,000079:                                                                                          	#               PIPS READ AND CLEARED BY PIPASR SUBROUTINE.
036641,000080:                                                                                          	#               IF CM/DSTBY IS ON, ENTRY VARIABLES INITIALIZED AND SETJTAG TASK CALLED.
036643,000082: 
036644,000083:                                                                                          	#               IF AVERAGEG FLAG ON     READACCS CALLED TO RECYCLE IN 2 SECONDS.
036645,000084:                                                                                          	#               IF AVERAGEG FLAG OFF    AVERAGE G EXIT (AVGEXIT) SET TO 2CADR AVGEND FOR FINAL PASS.
036646,000085:                                                                                          	#               SERVICER JOB SCHEDULED.
036647,000086:                                                                                          	#               TEST CONNECTOR OUTBIT TURNED ON.
036648,000087: 
036649,000088:                                                                                          	#       ONMNITOR
036650,000089: 
036651,000090:                                                                                          	#               A SEQUENCE OF THREE PASSES THROUGH QUICKREAD FOLLOWING A CALL TO READACCS WITH ONMONFLG SET AT 1/2 
036652,000091:                                                                                          	#               SEC INTERVALS.  INTERVALS ARE COUNTED OUT BY PIPCTR, INITIALISED AT 3 BY READACCS
036653,000092: 
036654,000093:                                                                                          	#       QUIKREAD
036655,000094: 
036656,000095:                                                                                          	#               READS CURRENT PIPS INTO X,Y,ZPIPBUF.  READS OLD X,Y,ZPIPBUF INTO X,Y,ZOLDBUF.  VALUES ARE SENT TO
036657,000096:                                                                                          	#               DOWNLIST DURING ENTRY.
036658,000097: 
036659,000098:                                                                                          	#       SERVICER
036660,000099: 
036661,000100:                                                                                          	#               DELV VALUES CHECKED TO DETECT RUNAWAY PIP -
036662,000101:                                                                                          	#                       IF BAD PIP      1) ALARM SENT.
036663,000102:                                                                                          	#                                       2) COMPENSATION, DVTOTAL ACCUMULATION, AND DVMON BYPASSED.  CONTROL
036664,000103:                                                                                          	#                                          TRANSFERRED TO AVERAGE G.
036665,000104:                                                                                          	#               PIPS COMPENSATED VIA 1/PIPA SUBROUTINE.
036666,000105:                                                                                          	#               DVTOTAL INCREMENTED BY ABSOLUTE VALUE OF DELV.
036667,000106:                                                                                          	#               THRUST MONITOR (DVMON) PERFORMED UNLESS IDLE FLAG IS ON.
036668,000107:                                                                                          	#               CONTROL TRANSFERRED TO AVERAGE G.
036669,000108: 
036670,000109:                                                                                          	#       DVMON
036671,000110: 
036672,000111:                                                                                          	#               THRESHOLD VALUE (PLACED IN DVTHRUSH BY USER) CHECKED AGAINST ABSOLUTE VALUE OF DELV TO CHECK
036673,000112:                                                                                          	#               THRUST LEVEL.
036674,000113: 
036675,000114:                                                                                          	#                       IF THRUST       1) ULLAGE OFF ROUTINE PERFORMED.
036676,000115:                                                                                          	#                                       2) STEERING FLAG TURNED ON AT FIRST DETECTION OF THRUST.
036677,000116:                                                                                          	#                                       3) CONTROL TRANSFERRED TO AVERAGE G.
036678,000117:                                                                                          	#                       IF NO THRUST    1) ON FIRST PASS THROUGH MONITOR, CONTROL TRANSFERRED TO AVERAGE G.
036679,000118:                                                                                          	#                                       2) ON SUBSEQUENT PASSES, CONTROL TRANSFERRED TO ENGINE FAIL ROUTINE IF THRUST
036680,000119:                                                                                          	#                                          HAS FAILED FOR 3 CONSECUTIVE PASSES.
036681,000120: 
036682,000121:                                                                                          	#       ENGINE FAIL
036683,000122: 
036684,000123:                                                                                          	#               ENGFAIL1 TASK CALLED IN 2.5 SECONDS.  THIS WILL RETURN CONTROL TO TIG-5 SO THAT THE IGNITION
036685,000124:                                                                                          	#                       SEQUENCE MAY BE REPEATED.
036686,000125:                                                                                          	#               ENGINOF3 PERFORMED.
036687,000126:                                                                                          	#               DAP SET UP FOR RCS.
036688,000127:                                                                                          	#       
036689,000128:                                                                                          	#       AVERAGE G
036691,000130:                                                                                          	#               RN1, VN1, GDT1/2 CALCULATED VIA CALCRVG ROUTINE BY UPDATING RN, VN WITH DELV AND AN AVERAGED VALUE
036692,000131:                                                                                          	#                       OF GDT/2.
036693,000132:                                                                                          	#               RN1, VN1, GDT1/2, PIPTIME1 COPIED INTO RN, VN, GDT/2, PIPTIME FOR RESTART PROTECTION.
036694,000133:                                                                                          	#               CONTROL TRANSFERRED TO ADDRESS SPECIFIED BY USER (OR BY READACCS FOR LAST PASS) IN AVGEXIT.
036695,000134:                                                                                          	#               LAST PASS (AVGEND)      1) FREE FALL GYRO COMPENSATION SET UP.
036696,000135:                                                                                          	#                                       2) DRIFT FLAG TURNED ON.
036697,000136:                                                                                          	#                                       3) STATE VECTOR TRANSFERRED VIA AVETOMID ROUTINE.
036698,000137:                                                                                          	#                                       4) ONMONITOR FLAG RESET.
036699,000138:                                                                                          	#                                       5) V37 FLAG RESET.
036700,000139:                                                                                          	#                                       6) TEST CONNECTOR OUTBIT RESET.
036701,000140:                                                                                          	#                                       7) CONTROL TRANSFERRED TO CANV37 TO CONTINUE MM CHANGE ROUTINE (R00).
036702,000141: 
036703,000142:                                                                                          	# CALLING SEQUENCE
036704,000143: 
036705,000144:                                                                                          	#       PREREAD ENTERED DIRECTLY FROM TIG-30 VIA POSTJUMP.
036706,000145:                                                                                          	#       READACCS CALLED AS WAITLIST TASK.                                          .
036707,000146: 
036708,000147:                                                                                          	# SUBROUTINES CALLED
036709,000148: 
036710,000149:                                                                                          	#       UTILITY ROUTINES - PHASCHNG FLAGUP FLAGDOWN NOVAC FINDVAC WAITLIST ALARM NEWPHASE 2PHSCHNG
036711,000150: 
036712,000151:                                                                                          	#       OTHER - PIPASR 1/PIPA CALCGRAV CALCRVG AVETOMID
036713,000152: 
036714,000153:                                                                                          	# NORMAL EXIT MODES
036715,000154: 
036716,000155:                                                                                          	#       ENDOFJOB        TASKOVER        CANV37
036717,000156: 
036718,000157:                                                                                          	#       AVGEXIT -       THIS IS A DOUBLE PRECISION ERASABLE LOCATION BY WHICH CONTROL IS TRANSFERRED AT THE END
036719,000158:                                                                                          	#                               OF EACH CYCLE OF AVERAGE G.
036720,000159:                                                                                          	#                       THE 2CADR OF A ROUTINE TO BE PERFORMED AT THAT TIME (E.G., STEERING EQUATIONS TO BE PERFORMED
036721,000160:                                                                                          	#                               AT 2 SECOND INTERVALS) MAY BE SET BY THE USER INTO AVGEXIT.
036722,000161:                                                                                          	#                       ALL SUCH ROUTINES SHOULD RETURN TO SERVEXIT, WHICH IS THE NORMAL EXIT FROM AVERAGE G.
036723,000162: 
036724,000163:                                                                                          	#       SERVEXIT -      DOES A PHASE CHANGE FOR RESTART PROTECTION AND GOES TO ENDOFJOB.
036725,000164:                                                                                          	#                       THE 2CADR OF SERVEXIT IS SET INTO AVGEXIT BY THE USER IF NO OTHER ROUTINE (SEE ABOVE).
036726,000165: 
036727,000166:                                                                                          	#       AVGEND -        LAST PASS OF AVERAGE G EXITS HERE, BYPASSING SPECIAL ROUTINE (SEE ABOVE UNDER READACCS).
036728,000167:                                                                                          	#                       FINAL EXIT IS TO CANV37.                                F AVERAGE G).
036729,000168: 
036730,000169:                                                                                          	# OUTPUT
036731,000170: 
036732,000171:                                                                                          	#       DVTOTAL(2)  PIPTIME(2)  XPIPBUF(2)  YPIPBUF(2)  ZPIPBUF(2)
036733,000172:                                                                                          	#       RN(6)           REFERENCE COORD.        SCALED AT 2(+29) M/CS
036734,000173:                                                                                          	#       VN(6)           REFERENCE COORD.        SCALED AT 2(+7) M/CS
036735,000174:                                                                                          	#       GDT/2(6)        REFERENCE COORD.        SCALED AT 2(+7) M/CS
036736,000175:                                                                                          	#       DELV(6)         STABLE MEMB. COORD.     SCALED AT 2(+14)*5.85*10(-4) M/CS (KPIP1 USED TO GET DV/2 AT 2(+7))
036738,000177:                                                                                          	#       DELVREF(6)      REFERENCE COORD.        SCALED AT 2(+7) M/CS
036739,000178: 
036740,000179:                                                                                          	# INITIALIZATION
036741,000180: 
036742,000181:                                                                                          	#       ONMONITOR FLAG SET BY ENTRY TO SHOW PIPBUF VALUES REQUIRED.
036743,000182:                                                                                          	#       IDLE FLAG ON IF DVMON TO BE BYPASSED.
036744,000183:                                                                                          	#       DVTHRUSH SET TO APPROPRIATE VALUE FOR DVMON.
036745,000184:                                                                                          	#       AVGEXIT SET TO 2CADR OF ROUTINE, IF ANY, TO BE PERFORMED AFTER EACH CYCLE OF AVERAGE G.  IF NO ROUTINE
036746,000185:                                                                                          	#               TO BE DONE, AVGEXIT SET TO SERVEXIT.
036747,000186:                                                                                          	#       VALUES NEEDED
036748,000187:                                                                                          	#               REFSMMAT
036749,000188:                                                                                          	#               UNITW -  FULL UNIT VECTOR, IN REFERENCE COORD., OF EARTH S ROTATIONAL VECTOR
036750,000189:                                                                                          	#               RN1, VN1, PIPTIME1 -  IN REFERENCE COORD., CONSISTENT WITH TIME OF EXECUTION OF PREREAD
036751,000190: 
036752,000191:                                                                                          	# DEBRIS
036753,000192: 
036754,000193:                                                                                          	#       CENTRALS        A, L, Q
036755,000194:                                                                                          	#       OTHER           INTERNAL - DVCNTR(1)  PIPAGE(1)  PIPCTR(1)  AVGEXIT(2)
036756,000195:                                                                                          	#                       EXTERNAL - ITEMP1(1)  ITEMP2(1)  RUPTREG1(1)  TEMX(1)  TEMY(1)  TEMZ(1)
036757,000196:                                                                                          	#                       USEFUL DEBRIS
036758,000197:                                                                                          	#                               RN1(6)  VN1(6)  GDT1/2  PIPTIME1(2)
036759,000198:                                                                                          	#                                       THESE LOCATIONS USED AS BUFFER STORAGE FOR NEWLY CALCULATED VALUES OF RN, VN, GDT/2,
036760,000199:                                                                                          	#                                       AND PIPTIME DURING PERFORMANCE OF SERVICER ROUTINES.
036761,000200:                                                                                          	#                               UNITR - HALF UNIT VECTOR OF RN, REFERENCE COORD.
036762,000201:                                                                                          	#                               RMAG SCALED AT 2(+58) IN 36D.
036763,000202:                                                                                          	#                               RMAGSQ SCALED AT 2(+58) IN 34D.
036764,000203:                                                                                          	#                               (RE/RMAG)SQ IN 32D.
036765,000204: 
036766,000205: 27,2671                                           BANK     27                            	#
036767,000206: 37,2000                                           SETLOC   SERVICES                      	#
036768,000207: 37,2000                                           BANK                                   	#
036769,000208: 
036770,000209: 37,2701  E7,1431                                  EBANK=   DVCNTR                        	#
036771,000210:                                                                                          	# *************************************   PREREAD   **************************************************************
036772,000211: 
036773,000212: 37,2701                                           COUNT    37/SERV                       	#
036774,000213: 
036775,000214: 37,2701           35073        PREREAD            CAF      PRIO21                        	# CALLER MUST PROTECT PREREAD
036776,000215: 37,2702           05134                           TC       NOVAC                         	#
036777,000216: 37,2703  E3,1460                                  EBANK=   NBDX                          	#
036778,000217: 37,2703           03636 14063                     2CADR    LASTBIAS                      	# DO LAST GYRO COMPENSATION IN FREE FALL
036779,000218: 
036780,000219:                                                                                          	# CALL-TO AND LASTBIAS ITSELF ARE NOT
036781,000220:                                                                                          	#       PROTECTED. REREADAC SETS 1/PIPADT
036782,000221:                                                                                          	#       TO 2.0 SECS IN CASE LASTBIAS LOST.
036783,000222:                                                                                          	#       (REDUNDANT IF LASTBIAS IS AOK)
036785,000224: 37,2705           02722        REDO5.31           TC       PREREAD1                      	#
036786,000225: 
036787,000226: 37,2706           37667                           CAF      PRIO32                        	#
036788,000227: 37,2707           05147                           TC       FINDVAC                       	# SET UP NORMLIZE JOB REQUIRED PRIOR TO
036789,000228: 37,2710  E7,1431                                  EBANK=   DVCNTR                        	# FIRST AVERAGE G PASS
036790,000229: 37,2710           03236 76067                     2CADR    NORMLIZE                      	#
036791,000230: 
036792,000231: 37,2712           35042                           CAF      2SECS                         	#
036793,000232: 37,2713           05245                           TC       WAITLIST                      	#
036794,000233: 37,2714  E6,1661                                  EBANK=   AOG                           	#
036795,000234: 37,2714           02744 76066                     2CADR    READACCS                      	#
036796,000235: 
036797,000236: 37,2716           45016                           CS       TWO                           	#
036798,000237: 37,2717           04114                           TC       NEWPHASE                      	#
036799,000238: 37,2720           00005                           OCT      5                             	#
036800,000239: 
036801,000240: 37,2721           15324                           TCF      TASKOVER                      	#
036802,000241: 
036803,000242: 37,2722           00006        PREREAD1           EXTEND                                 	#
036804,000243: 37,2723           22070                           QXCH     RUPTREG1                      	#
036805,000244: 
036806,000245: 37,2724           03254                           TC       PIPASR                        	# CLEAR + READ PIPS LAST TIME IN FREE FALL
036807,000246: 
036808,000247: 37,2725           35017                           CAF      ONE                           	# SET UP PIPAGE FOR REREADAC IN CASE A
036809,000248: 37,2726           55230                           TS       PIPAGE                        	#       RESTART OCCURS BEFORE READACCS
036810,000249: 
036811,000250: 37,2727           40075                           CS       FLAGWRD1                      	# SET AVEG FLAG
036812,000251: 37,2730           75017                           MASK     BIT1                          	#
036813,000252: 37,2731           26075                           ADS      FLAGWRD1                      	#
036814,000253: 
036815,000254: 37,2732           34777                           CA       POSMAX                        	#
036816,000255: 37,2733           70076                           MASK     FLAGWRD2                      	#
036817,000256: 37,2734           54076                           TS       FLAGWRD2                      	# KNOCK DOWN DRIFT FLAG
036818,000257: 
036819,000258: 37,2735           40103                           CS       FLAGWRD7                      	# SET V37 FLAG
036820,000259: 37,2736           75012                           MASK     BIT6                          	#
036821,000260: 37,2737           26103                           ADS      FLAGWRD7                      	#
036822,000261: 
036823,000262: 37,2740           35021                           CAF      ZERO                          	#
036824,000263: 37,2741           55425                           TS       DVTOTAL                       	# CLEAR DVTOTAL
036825,000264: 37,2742           55426                           TS       DVTOTAL    +1                 	#
036826,000265: 
036827,000266: 37,2743           00070                           TC       RUPTREG1                      	#
036828,000267: 
036830,000269:                                                                                          	# *************************************   READACCS   *************************************************************
036831,000270: 37,2744  E6,1661                                  EBANK=   AOG                           	#
036832,000271: 37,2744           03254        READACCS           TC       PIPASR                        	#
036833,000272: 
036834,000273: 37,2745           35022        PIPSDONE           CAF      FIVE                          	#
036835,000274: 37,2746           54001                           TS       L                             	#
036836,000275: 37,2747           40000                           COM                                    	#
036837,000276: 37,2750           52763                           DXCH     -PHASE5                       	#
036838,000277: 
036839,000278: 37,2751           35017        REDO5.5            CAF      ONE                           	# SHOW PIPS HAVE BEEN READ
036840,000279: 37,2752           55230                           TS       PIPAGE                        	#
036841,000280: 
036842,000281: 37,2753           35016                           CA       TWO                           	# SET PIPCTR FOR ONMINTOR
036843,000282: 37,2754           55227                           TS       PIPCTR                        	# AFTER ABOVE PHASCHNG
036844,000283: 
036845,000284: 37,2755           40102                           CS       CM/FLAGS                      	#
036846,000285: 37,2756           75016                           MASK     BIT2                          	# CM/DSTBY

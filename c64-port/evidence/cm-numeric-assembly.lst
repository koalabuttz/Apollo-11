010027,000510:                                                                                          	# PROGRAM DESCRIPTION MKVB51 AND MKVB50
010028,000511: 
010029,000512:                                                                                          	# AUTHOR-BARNERT DATE-2-15-67 MOD-0
010030,000513:                                                                                          	# PURPOSE  FLASH V51N70,V51N43, OR V51 TO REQUEST MARKING,
010031,000514:                                                                                          	#          AND V50N25 R1=16 TO REQUEST TERMINATE MARKING
010032,000515: 
010033,000516:                                                                                          	# CALLING SEQUENCE   AS JOB WITHIN SXTMARK
010034,000517: 
010035,000518:                                                                                          	# EXIT TO ENDMARK UPON RECEIPT OF V33, V34 CAUSES GOTOPOOH, ENTER
010036,000519:                                                                                          	#          RECYCLES THE DISPLAY
010037,000520: 
010038,000521:                                                                                          	# NOTE- SXTMARK AUTOMATICALLY CHANGES FROM CALLING MKVB51 TO MKVB50 WHEN
010039,000522:                                                                                          	#          SUFFICIENT MARKS HAVE BEEN MADE, AND THE REVERSE WHEN A MARK
010040,000523:                                                                                          	#          REJECT REDUCES THE NUMBER MADE BELOW THAT REQUIRED
010041,000524: 
010042,000525:                                                                                          	# SUBROUTINES CALLED- BANKCALL, GOMARK2, GOODEND, ENDMARK, WAITLIST
010043,000526: 
010044,000527:                                                                                          	# ALARM OR ABORT MODES - NONE
010045,000528: 
010046,000529:                                                                                          	# ERASABLE USED-VERBREG,MARKSTAT,QPRET,DSPTEM1
010047,000530: 
010048,000531:                                                                                          	# OUTPUT MARKSTAT = VAC ADDRESS
010049,000532: 
010050,000533:                                                                                          	# QPRET = NO. MARKS
010051,000534: 
010052,000535: 07,2347           04662        MKVB51             TC       BANKCALL                      	# CLEAR DISPLAY FOR MARK VERB
010053,000536: 07,2350           20560                           CADR     KLEENEX                       	#
010054,000537: 07,2351           32427                           CAF      VB51                          	# DISPLAY MARK VB51
010055,000538: 07,2352           04662                           TC       BANKCALL                      	#
010056,000539: 07,2353           20572                           CADR     GOMARK4                       	#
010057,000540: 07,2354           12357                           TCF      TERMSXT                       	# VB34-TERMINATE
010058,000541: 07,2355           12370                           TCF      ENTANSWR                      	# V33-PROCEED-MARKING DONE
010059,000542: 07,2356           12416                           TCF      MKVB5X                        	# ENTER-RECYCLE TO INITIAL MARK DISPLAY
010060,000543: 
010061,000544: 07,2357           05536        TERMSXT            TC       CLEARMRK                      	# CLEAR MARK ACTIVITY.
010062,000545: 
010063,000546: 07,2360           05364                           TC       CHECKMM                       	#
010064,000547: 07,2361           00003                           MM       03         B-14               	#
010065,000548: 07,2362           12364                           TCF      +2                            	#
010066,000549: 07,2363           02366                           TC       TERMP03                       	#
010067,000550: 07,2364           04701                           TC       POSTJUMP                      	#
010068,000551: 07,2365           30205                           CADR     TERM52                        	#
010069,000552: 
010070,000553: 07,2366           05546        TERMP03            TC       UPFLAG                        	#
010071,000554: 07,2367           00032                           ADRES    TRM03FLG                      	#
010072,000555: 07,2370           35046        ENTANSWR           CAF      LOW9                          	# PUT VAC ADR IN MARKSTAT AND NO. OF
010073,000556: 07,2371           71330                           MASK     MARKSTAT                      	# MARKS MADE IN QPRET BEFORE LEAVING
010074,000557: 07,2372           55330                           TS       MARKSTAT                      	# SXTMARK
010075,000558: 07,2373           40000                           COM                                    	#
010076,000559: 07,2374           51330                           INDEX    MARKSTAT                      	#
010077,000560: 07,2375           60052                           AD       QPRET                         	#
010079,000562: 07,2376           00006                           EXTEND                                 	#
010080,000563: 07,2377           62403                           BZMF     JAMIT                         	# NO MARKS MADE, SHOW IT IN QPRET, R53
010081,000564: 07,2400           00006                           EXTEND                                 	#       WILL PICK IT UP AND RECYCLE
010082,000565: 07,2401           75004                           MP       BIT12                         	# THIS PUTS NUMBER MARKS-1 IN A
010083,000566: 07,2402           65017                           AD       ONE                           	#
010084,000567: 07,2403           51330        JAMIT              INDEX    MARKSTAT                      	# STORE NO OF MARKS MADE
010085,000568: 07,2404           54052                           TS       QPRET                         	#
010086,000569: 07,2405           00004                           INHINT                                 	# SERVICE OPTSTALL INTERFACE WITH
010087,000570: 07,2406           35022                           CAF      FIVE                          	#
010088,000571: 07,2407           05245                           TC       WAITLIST                      	#
010089,000572: 07,2410     1330                                  EBANK=   MARKSTAT                      	#
010090,000573: 07,2410           02413 16062                     2CADR    ENDMARKS                      	#
010091,000574: 
010092,000575: 07,2412           05534                           TC       ENDMARK                       	# KNOCKS DOWN MARKING FLAG + DOES ENDOFJOB
010093,000576: 
010094,000577: 07,2413           35017        ENDMARKS           CAF      ONE                           	#
010095,000578: 07,2414           04740                           TC       IBNKCALL                      	#
010096,000579: 07,2415           17550                           CADR     GOODEND                       	#
010097,000580: 07,2416           37671        MKVB5X             CAF      PRIO34                        	#
010098,000581: 07,2417           71330                           MASK     MARKSTAT                      	# RE-DISPLAY VB51 IF MORE MARKS WANTED
010099,000582: 07,2420           10000                           CCS      A                             	# AND VB50 IF ALL IN
010100,000583: 07,2421           12347                           TCF      MKVB51                        	#
010101,000584: 07,2422           34333        MKVB50             CAF      R1D1                          	# OCT 16
010102,000585: 07,2423           55045                           TS       DSPTEM1                       	#
010103,000586: 07,2424           32426                           CAF      V50N25                        	#

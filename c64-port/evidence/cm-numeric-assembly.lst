059307,000216: 
059309,000218:                                                                                          	# AXISGEN COMPUTES THE COORDINATES OF ONE COORDINATE SYSTEM REFERRED TO ANOTHER COORDINATE SYSTEM.
059310,000219: 
059311,000220:                                                                                          	# THE INPUTS ARE  1) THE STAR1 VECTOR REFERRED TO COORDINATE SYSTEM A STORED AT STARAD.  2) THE STAR2 VECTOR
059312,000221:                                                                                          	# REFERRED TO COORDINATE SYSTEM A STORED AT STARAD +6.  3) THE STAR1 VECTOR REFERRED TO COORDINATE SYSTEM B STORED
059313,000222:                                                                                          	# AT LOCATION 6 OF THE VAC AREA.  4) THE STAR2 VECTOR REFERRED TO COORDINATE SYSTEM B STORED AT LOCATION 12D OF
059314,000223:                                                                                          	# THE VAC AREA.
059315,000224: 
059316,000225:                                                                                          	# THE OUTPUT DEFINES COORDINATE SYSTEM A REFERRED TO COORDINATE SYSTEM B.  THE THREE HALF-UNIT VECTORS ARE STORED
059317,000226:                                                                                          	# AT LOCATIONS XDC, XDC +6, XDC +12D, AND STARAD, STARAD +6, STARAD +12D.
059318,000227: 
059319,000228: 23,3401           66370        AXISGEN            AXT,1    SSP                           	# PUSHDOWN 00-30D, 34D-37D
059320,000229: 23,3402           02743                                    STARAD     +6                 	#
059321,000230: 23,3403           00051                                    S1                            	#
059322,000231: 23,3404           02727                                    STARAD     -6                 	#

064542,001357: 
064543,001358: 10,3633           35017        PROCEED            CAF      ONE                           	# ASTRONAUT PROCEED (V33) RETURNS
064544,001359: 10,3634           13534                           TCF      ENDOUT                        	#
064545,001360: 
064546,001361:                                                                                          	# LASTPLAY CHECKS TO SEE IF (1) THE LAST NORMAL DISPLAY WAS EITHER INTERRUPTED BY A PRIO OR A MARK (MARK
064547,001362:                                                                                          	# COULD ONLY HAPPEN DURING PINBRANCH) OR IF (2) THE LAST NORMAL DISPLAY WAS REQUESTED WHILE A HIGHER PRIORITY
064548,001363:                                                                                          	# DISPLAY WAS GOING RESULTING IN THE NORMAL BEING PUT TO SLEEP.
064549,001364: 
064550,001365:                                                                                          	# IF EITHER OF THE ABOVE 2 CONDITIONS EXISTS, THE NORMAL DISPLAY IS AWAKENED TO GO TO PLAYJUM1 WHICH STARTS
064551,001366:                                                                                          	# UP THE MOST RECENT VALID NORMAL DISPLAY.  IF THESE 2 CONDITIONS DO NOT EXIST, CONTROL GOES TO PLAYJUM1 WHICH IS
064552,001367:                                                                                          	# STARTED IMMEDIATELY WITH THE ASSUMPTION THAT THE MOST RECENT NORMAL DISPLAY IS ALREADY IN-ENDIDLE(DURING A
064553,001368:                                                                                          	# PINBRANCH) OR THAT A RESTART HAS OCCURRED AND THE DISPLAY CAN BE STARTED AS A .1 RESTART.
064554,001369: 

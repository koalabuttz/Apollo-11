016530,003308:                                                                                          	# DSPMM DOES NOT DISPLAY MODREG DIRECTLY.  IT PUTS IN EXEC REQUEST WITH
016531,003309:                                                                                          	# PRIO 30000 FOR DSPMMJB AND RETURNS TO CALLER.
016532,003310: 
016533,003311:                                                                                          	# IF MODREG CONTAINS -0, DSPMMJB BLANKS THE MODE LIGHTS.
016534,003312: 
016535,003313:                                                                                          	# DSPMM MUST BE IN BANK 27 OR LOWER, SO IT CAN BE CALLED VIA BANKCALL.
016536,003314: 
016537,003315: 07,2441                                           BANK     7                             	#
016538,003316: 04,2000                                           SETLOC   PINBALL4                      	#

023871,000452:                                                                                          	# THIS SECTION PROVIDES ATTITUDE ERROR DISPLAYS TO THE FDAI DURING SONE BOOST
023872,000453: 
023873,000454:                                                                                          	#       COMPUTE DESIRED PITCH W.R.T. PAD LOCAL VERTICAL AT LIFTOFF
023874,000455:                                                                                          	#                         2    3    4    5    6
023875,000456:                                                                                          	#       PITCH = A0+A1T+A2T +A3T +A4T +A5T +A6T
023876,000457:                                                                                          	#               SCALED TO 32 REVS.                                   -14
023877,000458:                                                                                          	#       IF TL = TIME IN SECS FROM L.O., THEN    T = 100(TL-RPSTART)2
023878,000459:                                                                                          	#       WHERE   TL GE RPSTART
023879,000460:                                                                                          	#               TL LE (-POLYSTOP + RPSTART)
023880,000461:                                                                                          	#       COMPUTE DESIRED ROLL WHERE ROLL EQUALS ANGLE FROM
023881,000462:                                                                                          	#       LAUNCHAZ TO -Z(S/C) AS SEEN FROM X(S/C).
023882,000463:                                                                                          	#       ROLL = LAUNCHAZ-AZIMUTH-.5+SATRLRT*T    IN REV
023883,000464:                                                                                          	#       SATRLRT = RATE OF ROLL IN REV/CENTI-SEC
023884,000465:                                                                                          	#       T, IN CENTI-SEC, IS DEFINED AS ABOVE, INCLUSIVE OF TIME RESTRICTIONS
023885,000466: 
023886,000467:                                                                                          	#       FOR SIMPLICITY, LET     P = 2*PI*PITCH
023887,000468:                                                                                          	#                               R = 2*PI*ROLL
023888,000469: 
023889,000470:                                                                                          	#       CONSTRUCT THE TRANSFORMATION MATRIX, TSMV, GIVING DESIRED S/C AXES IN
023890,000471:                                                                                          	#       TERMS OF SM COORDINATES.  LET THE RESULTING ROWS EQUAL THE VECTORS XDC,
023891,000472:                                                                                          	#       YDC, AND ZDC.
023892,000473: 
023893,000474:                                                                                          	#        *     (    SIN(P)                 0               -COS(P)    )   (XDC)
023894,000475:                                                                                          	#       TSMV = (-SIN(R)*COS(P)          -COS(R)         -SIN(R)*SIN(P)) = (YDC)
023895,000476:                                                                                          	#              (-COS(R)*COS(P)           SIN(R)         -COS(R)*SIN(P))   (ZDC)
023896,000477: 
023897,000478:                                                                                          	#       XDC,YDC,ZDC ARE USED AS INPUT TO CALCGTA FOR THE EXTRACTION OF THE 
023898,000479:                                                                                          	#       EULER SET OF ANGLES WHICH WILL BRING THE SM INTO THE DESIRED
023899,000480:                                                                                          	#       ORIENTATION.  THIS EULER SET, OGC, IGC, AND MGC, MAY BE IDENTIFIED
023900,000481:                                                                                          	#       AS THE DESIRED CDU ANGLES.
023901,000482: 
023902,000483:                                                                                          	#       (XDC)                   (OGC)
023903,000484:                                                                                          	#       (YDC) ---) CALCGTA ---) (IGC)
023904,000485:                                                                                          	#       (ZDC)                   (MGC)
023905,000486:                                                                                          	#                          -
023906,000487:                                                                                          	#       DEFINE THE VECTOR DELTACDU.
023907,000488: 
023908,000489:                                                                                          	#        -         (OGC)   (CDUX)
023909,000490:                                                                                          	#       DELTACDU = (IGC) - (CDUY)
023910,000491:                                                                                          	#                  (MGC)   (CDUZ)
023911,000492:                                                                                          	#                                -              -    *    -
023912,000493:                                                                                          	#       COMPUTE ATTITUDE ERRORS, A, WHERE       A = TGSC*DELTACDU
023913,000494: 
023914,000495:                                                                                          	#        *     (1             SIN(CDUZ)             0    )   THE GIMBAL ANGLES
023916,000497:                                                                                          	#       TGSC = (0       COS(CDUX)*COS(CDUZ)     SIN(CDUX)) = TO SPACECRAFT AXES
023917,000498:                                                                                          	#              (0      -SIN(CDUX)*COS(CDUZ)     COS(CDUX))   CONVERSION MATRIX
023918,000499:                                                                                          	#                            -
023919,000500:                                                                                          	#       THE ATTITUDE ERRORS, A, ARE STORED ONE HALF SINGLE PRECISION IN
023920,000501:                                                                                          	#       THE REGISTERS AK, AK1, AK2 AS INPUT TO NEEDLER, THE FDAI ATTITUDE
023921,000502:                                                                                          	#       ERROR DISPLAY ROUTINE.
023922,000503: 
023923,000504: 34,2345           30102        ATERJOB            CAE      FLAGWRD6                      	# CHECK FLAGWRD6
023924,000505: 34,2346           74105                           MASK     OCT60000                      	# BITS 14, 15
023925,000506: 34,2347           00006                           EXTEND                                 	#
023926,000507: 34,2350           12352                           BZF      +2                            	# OK - CONTINUE
023927,000508: 34,2351           05217                           TC       ENDOFJOB                      	# SATURN STICK ON - KILL JOB
023928,000509: 34,2352           35006                           CAF      BIT10                         	# CHECK IF S/C CONTROL
023929,000510: 34,2353           00006                           EXTEND                                 	# OF SATURN PANEL
023930,000511: 34,2354           02030                           RAND     CHAN30                        	# SWITCH IS ON
023931,000512: 34,2355           00006                           EXTEND                                 	#
023932,000513: 34,2356           12510                           BZF      STRSAT                        	# IT IS - GO STEER
023933,000514: 34,2357           11725                           CCS      SATSW                         	# IT IS NOT - WAS IT ON LAST CYCLE
023934,000515: 34,2360           02363                           TC       ATTDISP                       	# NO - CONTINUE
023935,000516: 34,2361           02513                           TC       ATRESET                       	# YES - REINITIALIZE NEEDLER
023936,000517: 34,2362           02513                           TC       ATRESET                       	# YES - REINITIALIZE NEEDLER
023937,000518: 34,2363           41702        ATTDISP            CS       RPSTART                       	# PITCH/ROLL START TIME
023938,000519: 34,2364           60025                           AD       TIME1                         	#
023939,000520: 34,2365           00006                           EXTEND                                 	#
023940,000521: 34,2366           62615                           BZMF     NOPOLY                        	# IF MINUS THEN ATTITUDE HOLD
023941,000522: 34,2367           54154                           TS       MPAC                          	# MPAC = TIME1 - RPSTART
023942,000523: 34,2370           55707                           TS       SPOLYARG                      	# SAVE FOR USE IN ROLL CALUCLATION
023943,000524: 34,2371           61703                           AD       POLYSTOP                      	# NEG PITCHOVER TIME IN CSECS
023944,000525: 34,2372           00006                           EXTEND                                 	#
023945,000526: 34,2373           62375                           BZMF     +2                            	#
023946,000527: 34,2374           02615                           TC       NOPOLY                        	# GO TO ATTITUDE HOLD
023947,000528: 34,2375           30024                           CA       TIME2                         	#
023948,000529: 34,2376           00006                           EXTEND                                 	#
023949,000530: 34,2377           62401                           BZMF     +2                            	#
023950,000531: 34,2400           02615                           TC       NOPOLY                        	# GO TO ATTITUDE HOLD      
023951,000532: 34,2401           31661                           CAE      POLYNUM                       	#
023952,000533: 34,2402           54001                           TS       L                             	#
023953,000534: 34,2403           32621                           CAF      COEFPOLY                      	# EVALUATE PITCH POLYNOMIAL
023954,000535: 34,2404           07164                           TC       POWRSERS                      	# SCALED TO 32 REVOLUTIONS
023955,000536: 34,2405           35021                           CA       ZERO                          	# RETURN WITH PITCH(32REV)
023956,000537: 34,2406           54163                           TS       MODE                          	# STORED IN MPAC, MPAC +1
023957,000538: 34,2407           06006                           TC       INTPRET                       	#
023958,000539: 34,2410           54201                           SETPD    SL                            	# 32(PITCH(32REV)) = PITCH(REV)
023959,000540: 34,2411           00001                                    0                             	#
023960,000541: 34,2412           20206                                    5                             	#
023961,000542: 34,2413           77606                           PUSH                                   	# LET P(RAD) = 2.PI.PITCH(REV)
023962,000543: 34,2414           77650                           GOTO                                   	#
023963,000544: 34,2415           76155                                    ATTDISP1                      	# AROUND SETLOC
023965,000546:                                                                                          	#                                    *
023966,000547:                                                                                          	#       CONSTRUCT SM TO S/C MATRIX, TSMV
023967,000548: 
023968,000549: 37,2000                                           SETLOC   P11TWO                        	#
023969,000550: 37,2000                                           BANK                                   	# 36 IN COL., 34 IN DISK
023970,000551: 
023971,000552: 37,2155                                           COUNT    36/P11                        	#
023972,000553: 
023973,000554: 37,2155           57546        ATTDISP1           COS      DCOMP                         	#
023974,000555: 37,2156           14017                           STODL    14D                           	# -.5*COS(P)
023975,000556: 37,2157           77756                           SIN                                    	#
023976,000557: 37,2160           14013                           STODL    10D                           	# .5*SIN(P)
023977,000558: 37,2161           15335                                    ZEROVECS                      	#
023978,000559: 37,2162           00015                           STORE    12D                           	# 0
023979,000560: 
023980,000561:                                                                                          	#       EVALUATE ROLL = LAUNCHAZ-AZIMUTH-.5+SATRLRT*T
023981,000562: 37,2163           41335                           SLOAD    DMP                           	#
023982,000563: 37,2164           03310                                    SPOLYARG                      	# TIME1 - RPSTART, CSECS B-14.
023983,000564: 37,2165           03301                                    SATRLRT                       	#
023984,000565: 37,2166           45261                           SL       DSU                           	#
023985,000566: 37,2167           20217                                    14D                           	#
023986,000567: 37,2170           15333                                    DPHALF                        	#
023987,000568: 37,2171           45215                           DAD      DSU                           	# ASSUMING X(SM) ALONG LAUNCH AZIMUTH,
023988,000569: 37,2172           02634                                    LAUNCHAZ                      	# LAUNCHAZ = ANGLE FROM NORTH TO X(SM).
023989,000570: 37,2173           02401                                    AZIMUTH                       	# AZIMUTH = -ANGLE FROM NORTH TO Z(S/C)
023990,000571: 37,2174           77634                           RTB                                    	# DETERMINE IF ROLLOUT
023991,000572: 37,2175           70604                                    RLTST                         	# IS COMPLETED
023992,000573: 37,2176           71406        ATTDISPR           PUSH     COS                           	# CONTINUE COMPUTING TSMV
023993,000574: 37,2177           77606                           PUSH                                   	# LET R(RAD) = 2*PI*ROLL(REV)
023994,000575: 37,2200           72405                           DMP      SL1                           	#
023995,000576: 37,2201           00017                                    14D                           	#
023996,000577: 37,2202           14027                           STODL    22D                           	# -.5*COS(R)*COS(P)
023997,000578: 37,2203           77676                           DCOMP                                  	#
023998,000579: 37,2204           00023                           STORE    18D                           	# -.5*COS(R)
023999,000580: 37,2205           72405                           DMP      SL1                           	#
024000,000581: 37,2206           00013                                    10D                           	#
024001,000582: 37,2207           14033                           STODL    26D                           	# -.5*COS(R)*SIN(P)
024002,000583: 37,2210           41556                           SIN      PUSH                          	#
024003,000584: 37,2211           00031                           STORE    24D                           	# .5*SIN(R)
024004,000585: 37,2212           72405                           DMP      SL1                           	#
024005,000586: 37,2213           00017                                    14D                           	#
024006,000587: 37,2214           14021                           STODL    16D                           	# -.5*SIN(R)*COS(P)
024007,000588: 37,2215           77676                           DCOMP                                  	#
024008,000589: 37,2216           72405                           DMP      SL1                           	#
024009,000590: 37,2217           00013                                    10D                           	#
024010,000591: 37,2220           24025                           STOVL    20D                           	# -.5*SIN(R)*SIN(P)
024011,000592: 37,2221           00013                                    10D                           	#
024012,000593: 
024013,000594:                                                                                          	#       FROM TSMV FIND THE HALF UNIT VECTORS XDC,YDC,ZDC = INPUT TO CALCGTA
024015,000596: 37,2222           77656                           UNIT                                   	#
024016,000597: 37,2223           26714                           STOVL    XDC                           	# XDC = .5*UNIT(SIN(P),0,-COS(P))
024017,000598: 37,2224           00021                                    16D                           	#
024018,000599: 37,2225           77656                           UNIT                                   	#
024019,000600: 37,2226           26722                           STOVL    YDC                           	# YDC = .5*UNIT(-SIN(R)*COS(P),-COS(R),
024020,000601: 37,2227           00027                                    22D                           	#                       -SIN(R)*SIN(P))
024021,000602: 37,2230           77656                           UNIT                                   	#
024022,000603: 37,2231           36730                           STCALL   ZDC                           	# ZDC = .5*UNIT(-COS(R)*COS(P),SIN(R),
024023,000604: 37,2232           47205                                    CALCGTA                       	#                       -COS(R)*SIN(P))
024024,000605: 
024025,000606:                                                                                          	#       CALL CALCGTA TO COMPUTE DESIRED SM ORIENTATION  OGC,IGC, AND MGC
024026,000607:                                                                                          	#                                -          -   -
024027,000608:                                                                                          	#       FIND DIFFERENCE VECTOR  DELTACDU = OGC-CDUX
024028,000609:                                                                                          	#  
024029,000610:                                                                                          	#       ENTER HERE IF ATTITUDE HOLD
024030,000611: 
024031,000612: 37,2233           41575        NOPOLYM            VLOAD    PUSH                          	#        OGC      IGC
024032,000613: 37,2234           02760                                    OGC                           	# CHANGE IGC  TO  MGC FOR COMPATIBILITY
024033,000614: 37,2235           45006                           PUSH     CALL                          	#        MGC      OGC
024034,000615: 37,2236           47477                                    CDUTRIG                       	# WITH Y,Z,X ORDER OF CDUSPOT
024035,000616: 37,2237           47175                           VLOAD    RTB                           	#  -         DPHI     OGC-CDUX , PD4
024036,000617: 37,2240           00003                                    2                             	# DELTACDU = DTHETA = IGC-CDUY , 0
024037,000618: 37,2241           45552                                    V1STO2S                       	#            DPSI     MGC-CDUZ , 2
024038,000619: 37,2242           27317                           STOVL    BOOSTEMP                      	#
024039,000620: 37,2243           15335                                    ZEROVECS                      	#
024040,000621: 37,2244           24001                           STOVL    0                             	#
024041,000622: 37,2245           00767                                    CDUSPOT                       	#
024042,000623: 37,2246           47034                           RTB      RTB                           	#
024043,000624: 37,2247           45552                                    V1STO2S                       	#
024044,000625: 37,2250           70564                                    DELSTOR                       	#
024045,000626: 37,2251           14013                           STODL    10D                           	#
024046,000627: 37,2252           00741                                    SINCDUZ                       	#
024047,000628: 37,2253           72405                           DMP      SL1                           	#
024048,000629: 37,2254           00001                                    0                             	#
024049,000630: 37,2255           60415                           DAD      SR2                           	# CHANGE SCALE OF AK TO 2REVS
024050,000631: 37,2256           00005                                    4                             	#
024051,000632: 37,2257           77650                           GOTO                                   	#
024052,000633: 37,2260           70416                                    ATTDISP2                      	#
024053,000634: 
024054,000635: 34,2000                                           SETLOC   P11ONE                        	#
024055,000636: 34,2000                                           BANK                                   	#
024056,000637: 34,2416                                           COUNT    34/P11                        	#
024057,000638: 
024058,000639: 34,2416           14021        ATTDISP2           STODL    16D                           	# 16D, .5(DPHI + DTHETA*SIN(CDUZ))
024059,000640: 34,2417           00747                                    COSCDUZ                       	#
024060,000641: 34,2420           41405                           DMP      PUSH                          	#
024061,000642: 34,2421           00001                                    0                             	#
024062,000643: 34,2422           72405                           DMP      SL1                           	#
024063,000644: 34,2423           00751                                    COSCDUX                       	#
024064,000645: 34,2424           41325                           PDDL     DMP                           	#
024066,000647: 34,2425           00743                                    SINCDUX                       	#
024067,000648: 34,2426           00003                                    2                             	#
024068,000649: 34,2427           72415                           DAD      SL1                           	#
024069,000650: 34,2430           77626                           STADR                                  	#
024070,000651: 34,2431           63755                           STODL    17D                           	# 17D,  .5(DTHETA*COS(CDUX)*COS(CDUZ)
024071,000652: 34,2432           72405                           DMP      SL1                           	#                       +DPSI*SIN(CDUX))
024072,000653: 34,2433           00743                                    SINCDUX                       	#
024073,000654: 34,2434           41325                           PDDL     DMP                           	#
024074,000655: 34,2435           00751                                    COSCDUX                       	#
024075,000656: 34,2436           00003                                    2                             	#
024076,000657: 34,2437           72425                           DSU      SL1                           	#
024077,000658: 34,2440           77626                           STADR                                  	#
024078,000659: 34,2441           77754                           STORE    18D                           	# 18D,  .5(-DTHETA*SIN(CDUX)*COS(CDUZ)
024079,000660: 34,2442           77751                           TLOAD                                  	#                       +DPSI*COS(CDUX))
024080,000661: 34,2443           00021                                    16D                           	#
024081,000662: 34,2444           03077                           STORE    AK                            	# STORE ATTITUDE ERRORS IN AK,AK1,AK2
024082,000663: 34,2445           77776                           EXIT                                   	#
024083,000664: 
024084,000665: 34,2446           31725                           CA       SATSW                         	#
024085,000666: 34,2447           10000                           CCS      A                             	# CHK TAKEOVER STATUS
024086,000667: 34,2450           02471                           TC       SATOUT                        	# POS - DISPLAY ONLY
024087,000668: 34,2451           02477                           TC       AKLOAD                        	# 0     STORE BIAS
024088,000669: 34,2452           06006        STEERSAT           TC       INTPRET                       	# NEG   STEER L/V
024089,000670: 34,2453           76351                           TLOAD    TAD                           	#
024090,000671: 34,2454           03327                                    BIASAK                        	#
024091,000672: 34,2455           03077                                    AK                            	#
024092,000673: 34,2456           03077                           STORE    AK                            	# AKS = AKS - STORED BIAS
024093,000674: 34,2457           77776                           EXIT                                   	#
024094,000675: 34,2460           31476                           CA       AK                            	#
024095,000676: 34,2461           02623                           TC       RESCALES                      	#
024096,000677: 34,2462           55476                           TS       AK                            	#
024097,000678: 34,2463           31477                           CA       AK1                           	#
024098,000679: 34,2464           02623                           TC       RESCALES                      	#
024099,000680: 34,2465           55477                           TS       AK1                           	#
024100,000681: 34,2466           31500                           CA       AK2                           	#
024101,000682: 34,2467           02623                           TC       RESCALES                      	#
024102,000683: 34,2470           55500                           TS       AK2                           	#
024103,000684:                                                                                          	#       DISPLAY ATTITUDE ERRORS ON FDAI VIA NEEDLER
024104,000685: 
024105,000686: 34,2471           04662        SATOUT             TC       BANKCALL                      	#
024106,000687: 34,2472           42420                           CADR     NEEDLER                       	#
024107,000688: 34,2473           34113        ATERSET            CAF      OCT31                         	# DELAY .25 SEC
024108,000689: 34,2474           04662                           TC       BANKCALL                      	# EXECUTION + DELAY = .56SEC APPROX
024109,000690: 34,2475           01732                           CADR     DELAYJOB                      	#
024110,000691: 34,2476           02345                           TC       ATERJOB                       	# END OF ATT ERROR DISPLAY CYCLE
024111,000692: 
024112,000693: 34,2477           41476        AKLOAD             CS       AK                            	# STORE AKS
024113,000694: 34,2500           55726                           TS       BIASAK                        	# INTO BIAS
024114,000695: 34,2501           41477                           CS       AK1                           	# COMPLEMENTED
024115,000696: 34,2502           55727                           TS       BIASAK     +1                 	#
024117,000698: 34,2503           41500                           CS       AK2                           	#
024118,000699: 34,2504           55730                           TS       BIASAK     +2                 	#
024119,000700: 34,2505           45017                           CS       BIT1                          	# SET SW
024120,000701: 34,2506           55725                           TS       SATSW                         	# TO STEER
024121,000702: 34,2507           02452                           TC       STEERSAT                      	# GO STEER
024122,000703: 34,2510           31725        STRSAT             CA       SATSW                         	# CHECK IF NEEDLER
024123,000704: 34,2511           00006                           EXTEND                                 	# HAS BEEN INITIALIZED
024124,000705: 34,2512           62363                           BZMF     ATTDISP                       	# YES - CONTINUE
024125,000706: 34,2513           41501        ATRESET            CS       RCSFLAGS                      	# NO - SET
024126,000707: 34,2514           75015                           MASK     BIT3                          	# INITIALIZATION SW
024127,000708: 34,2515           27501                           ADS      RCSFLAGS                      	# FOR NEEDLER
024128,000709: 34,2516           04662                           TC       BANKCALL                      	# AND GO
024129,000710: 34,2517           42420                           CADR     NEEDLER                       	# DO IT
024130,000711: 34,2520           36211                           CAF      REVCNT                        	# OCT 6
024131,000712: 34,2521           04662                           TC       BANKCALL                      	# DELAY JOB
024132,000713: 34,2522           01732                           CADR     DELAYJOB                      	# 60 MS -WAIT TILL IMUERRCNTR ZEROED
024133,000714: 34,2523           11725                           CCS      SATSW                         	# CHECK SW STATUS
024134,000715: 34,2524           02534                           TC       TAKEON                        	# POS   STEER INIT.
024135,000716: 34,2525           02526                           TC       +1                            	# 0     RETURN TO DISPLAY
024136,000717: 34,2526           35017                           CA       BIT1                          	# NEG   RETURN TO DISPLAY
024137,000718: 34,2527           55725                           TS       SATSW                         	# SW = DISPLAY ONLY
024138,000719: 34,2530           45007                           CS       BIT9                          	# DISABLE
024139,000720: 34,2531           00006                           EXTEND                                 	# SIVB
024140,000721: 34,2532           03012                           WAND     CHAN12                        	# TAKEOVER
024141,000722: 34,2533           02471                           TC       SATOUT                        	# DISPLAY
024142,000723: 34,2534           35007        TAKEON             CAF      BIT9                          	# ENABLE
024143,000724: 34,2535           00006                           EXTEND                                 	# SIVB
024144,000725: 34,2536           05012                           WOR      CHAN12                        	# TAKEOVER
024145,000726: 34,2537           35021                           CA       ZERO                          	# INDICATE NEEDLER
024146,000727: 34,2540           55725                           TS       SATSW                         	# WAS INITIALIZED
024147,000728: 34,2541           02471                           TC       SATOUT                        	#
024148,000729: 34,2542           51575        S11.1              VLOAD    ABVAL                         	#
024149,000730: 34,2543           01177                                    VN                            	#
024150,000731: 34,2544           27723                           STOVL    VMAGI                         	# VI    SCALED 2(7) IN METERS/CSEC
024151,000732: 34,2545           01171                                    RN                            	#
024152,000733: 34,2546           50256                           UNIT     DOT                           	#
024153,000734: 34,2547           01177                                    VN                            	#
024154,000735: 34,2550           77752                           SL1                                    	#
024155,000736: 34,2551           17737                           STODL    HDOT                          	#
024156,000737: 34,2552           05152                                    RPAD                          	#
024157,000738: 34,2553           77214                           BOF      VLOAD                         	#
024158,000739: 34,2554           00355                                    AMOONFLG                      	#
024159,000740: 34,2555           70560                                    EARTHALT                      	#
024160,000741: 34,2556           02026                                    RLS                           	#
024161,000742: 34,2557           60446                           ABVAL    SR2                           	#
024162,000743: 34,2560           77621        EARTHALT           BDSU                                   	#
024163,000744: 34,2561           00045                                    36D                           	#
024164,000745: 34,2562           03735                           STORE    ALTI                          	#
024165,000746: 34,2563           77616                           RVQ                                    	#
024166,000747: 34,2564           31716        DELSTOR            CA       BOOSTEMP                      	#
024168,000749: 34,2565           00006                           EXTEND                                 	# STORE DELTACDU INTO PDL 0,2,4
024169,000750: 34,2566           20154                           MSU      MPAC                          	#
024170,000751: 34,2567           50120                           INDEX    FIXLOC                        	#
024171,000752: 34,2570           54000                           TS       0                             	#
024172,000753: 34,2571           31717                           CA       BOOSTEMP   +1                 	#
024173,000754: 34,2572           00006                           EXTEND                                 	#
024174,000755: 34,2573           20155                           MSU      MPAC       +1                 	#
024175,000756: 34,2574           50120                           INDEX    FIXLOC                        	#
024176,000757: 34,2575           54002                           TS       2                             	#
024177,000758: 34,2576           31720                           CA       BOOSTEMP   +2                 	#
024178,000759: 34,2577           00006                           EXTEND                                 	#
024179,000760: 34,2600           20156                           MSU      MPAC       +2                 	#

019063,000428: 
019065,000430:                                                                                          	# PROGRAM NAME-OPTIMUM PRELAUNCH ALIGNMENT CALIBRATION
019066,000431:                                                                                          	# DATE-  NOVEMBER 2 1966
019067,000432:                                                                                          	# BY-  GEORGE SCHMIDT IL 7-146 EXT. 126
019068,000433:                                                                                          	# MOD NO 3
019069,000434: 
019070,000435:                                                                                          	# FUNCTIONAL DESCRIPTION
019071,000436: 
019072,000437:                                                                                          	# THIS     SECTION CONSISTS OF PRELAUNCH ALIGNMENT AND GYRO DRIFT TESTS
019073,000438:                                                                                          	# INTEGRATED TOGETHER TO SAVE WORDS.  COMPASS IS COMPLETELY RESTART
019074,000439:                                                                                          	# PROOFED EXCEPT FOR THE FIRST 30 SECONDS OR SO.  PERFORMANCE TESTS OF
019075,000440:                                                                                          	# THE IRIGS IS RESTART PROOFED ENOUGH TO GIVE 75 PERCENT CONFIDENCE THAT
019076,000441:                                                                                          	# IF A RESTART OCCURS THE DATA WILL STILL BE GOOD.  GOOD PRACTICE TO RECYCL
019077,000442:                                                                                          	# WHEN A RESTART OCCURS UNLESS IT HAPPENS NEAR THE END OF A TEST-THEN WAIT
019078,000443:                                                                                          	# FOR THE DATA TO FLASH.
019079,000444: 
019080,000445:                                                                                          	# A RESTART IN GYROCOMPASS DURING GYRO TORQUING CAUSES PULSES TO BE LOST
019081,000446:                                                                                          	# THE PRELAUNCH ALIGNMENT TECHNIQUE IS BASICALLY THE SAME AS IN BLOCK 1
019082,000447:                                                                                          	# EXCEPT THAT IT HAS BEEN SIMPLIFIED IN THE SENSE THAT SMALL ANGLE APPROX.
019083,000448:                                                                                          	# HAVE BEEN USED.  THE DRIFT TESTS USE A UNIQUE IMPLEMENTATION OF THE 
019084,000449:                                                                                          	# OPTIMUM STATISTICAL FILTER.  FOR A DESCRIPTION SEE E-1973.  BOTH OF THESE
019085,000450:                                                                                          	# ROUTINES USE STANDARD SYSTEM TEST LEADIN PROCEDURES.  THE INITIALIZATION
019086,000451:                                                                                          	# PROCEDURE FOR THE DRIFT TESTS IS IN THE JDC S.  THE INITIALIZATION METHOD
019087,000452:                                                                                          	# FOR GYROCOMPASS IS AN ERAS LOAD THEN A MISSION PHASE CALL.
019088,000453:                                                                                          	# THE COMPASS ALIGNS TO Z DOWN, X DOWNRANGE, HAS THE CAPABILITY
019089,000454:                                                                                          	# CHANGE AZIMUTH WHILE RUNNING, IS COMPENSATED FOR
019090,000455:                                                                                          	# COMPONENT ERRORS, IS CAPABLE OF OPTICAL VERIFICATION (CSM ONLY).
019091,000456: 
019092,000457:                                                                                          	# COMPASS ERASABLE LOAD REQUIRED
019093,000458: 
019094,000459:                                                                                          	#       1-      LAUNCHAZ-DP AZIMUTH IN REV FROM NORTH OF XSM DESIRED    (NOM=.2)
019095,000460:                                                                                          	#       2-      LATITUDE-DP-OF LAUNCH PAD
019096,000461:                                                                                          	#       3-      AZIMUTH-DP-OF ZNB OF VEHICLE
019097,000462:                                                                                          	#       4-      IMU COMPENSATION PARAMETERS
019098,000463:                                                                                          	#       5-      AZ AND ELEVATION OF TARGETS 1,2         ****OPTIONAL****
019099,000464: 
019100,000465:                                                                                          	# TO PERFORM AS PART OF COMPASS
019101,000466: 
019102,000467:                                                                                          	#       1-      OPTICAL VERIFICATION- V 65 E
019103,000468:                                                                                          	#       2-      AZIMUTH CHANGE- V 78 E
019104,000469: 
019105,000470:                                                                                          	# SUBROUTINES CALLED
019106,000471: 
019107,000472:                                                                                          	# DURING OPTICAL VERIFICATION (CSM ONLY) ESSENTIALLY ALL OF INFLIGHT ALIGN
019108,000473:                                                                                          	# IS CALLED IN ONE WAY OR ANOTHER.  SEE THE LISTING.
019109,000474: 

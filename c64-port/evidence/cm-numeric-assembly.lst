035916,000596: 26,2562           05412                           TC       PHASCHNG                      	#
035917,000597: 26,2563           40434                           OCT      40434                         	#
035918,000598: 26,2564           05217                           TC       ENDOFJOB                      	#
035919,000599: 
035920,000600: 26,2565           35065        S61.1C             CA       PRIO13                        	#
035921,000601: 26,2566           05147                           TC       FINDVAC                       	#
035922,000602: 26,2567  E6,1661                                  EBANK=   AOG                           	#
035923,000603: 26,2567           02603 54066                     2CADR    S61.1A     -1                 	#
035924,000604: 

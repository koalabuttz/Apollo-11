043730,000705: 20,3407           10000                           CCS      A                             	#
043731,000706: 20,3410           00002                           TC       Q                             	# EXIT IF LEM OFF
043732,000707: 
043734,000709: 20,3411           35021        3CASFLTR           CAF      ZERO                          	# ***** THIRD CASCADE FILTER *****
043735,000710: 20,3412           55611                           TS       TTMP1                         	#
043736,000711: 20,3413           55613                           TS       TTMP2                         	#
043737,000712: 
043738,000713: 20,3414           31620                           CA       DAP2       +1                 	# MULTIPLY INPUT BY (1/2)
043739,000714: 20,3415           00006                           EXTEND                                 	#
043740,000715: 20,3416           71736                           MP       N10        +11D               	#       N31/2
043741,000716: 20,3417           55612                           TS       TTMP1      +1                 	#
043742,000717: 20,3420           31617                           CA       DAP2                          	#
043743,000718: 20,3421           00006                           EXTEND                                 	#
043744,000719: 20,3422           71736                           MP       N10        +11D               	#       N31/2
043745,000720: 20,3423           21612                           DAS      TTMP1                         	#
043746,000721: 
043747,000722: 20,3424           41622                           CS       DAP3       +1                 	#
043748,000723: 20,3425           00006                           EXTEND                                 	#
043749,000724: 20,3426           71740                           MP       N10        +13D               	#       D31/2
043750,000725: 20,3427           55614                           TS       TTMP2      +1                 	#
043751,000726: 20,3430           41621                           CS       DAP3                          	#
043752,000727: 20,3431           00006                           EXTEND                                 	#
043753,000728: 20,3432           71740                           MP       N10        +13D               	#       D31/2
043754,000729: 20,3433           21614                           DAS      TTMP2                         	#
043755,000730: 
043756,000731: 20,3434           53614                           DXCH     TTMP2                         	#
043757,000732: 20,3435           21612                           DAS      TTMP1                         	#
043758,000733: 20,3436           53612                           DXCH     TTMP1                         	#
043759,000734: 20,3437           20001                           DDOUBL                                 	#
043760,000735: 20,3440           21721                           DAS      TMP6                          	#
043761,000736: 
043762,000737: 20,3441           53721                           DXCH     TMP6                          	#
043763,000738: 20,3442           53717                           DXCH     TMP5                          	#
043764,000739: 
043765,000740: 20,3443           35021                           CAF      ZERO                          	#
043766,000741: 20,3444           55611                           TS       TTMP1                         	#
043767,000742: 20,3445           55720                           TS       TMP6                          	#
043768,000743: 
043769,000744: 20,3446           31620                           CA       DAP2       +1                 	# MULTIPLY INPUT BY
043770,000745: 20,3447           00006                           EXTEND                                 	#
043771,000746: 20,3450           71737                           MP       N10        +12D               	#       N32
043772,000747: 20,3451           55612                           TS       TTMP1      +1                 	#
043773,000748: 20,3452           31617                           CA       DAP2                          	#
043774,000749: 20,3453           00006                           EXTEND                                 	#
043775,000750: 20,3454           71737                           MP       N10        +12D               	#       N32
043776,000751: 20,3455           21612                           DAS      TTMP1                         	#
043777,000752: 
043778,000753: 20,3456           41622                           CS       DAP3       +1                 	#
043779,000754: 20,3457           00006                           EXTEND                                 	#
043780,000755: 20,3460           71741                           MP       N10        +14D               	#       D32
043781,000756: 20,3461           55721                           TS       TMP6       +1                 	#
043782,000757: 20,3462           41621                           CS       DAP3                          	#
043783,000758: 20,3463           00006                           EXTEND                                 	#
043785,000760: 20,3464           71741                           MP       N10        +14D               	#       D32
043786,000761: 20,3465           21721                           DAS      TMP6                          	#
043787,000762: 
043788,000763: 20,3466           53612                           DXCH     TTMP1                         	#
043789,000764: 20,3467           21721                           DAS      TMP6                          	#
043790,000765: 
043791,000766: 20,3470           00002                           TC       Q                             	#
043792,000767: 
043794,000769:                                                                                          	# CONSTANTS FOR AUTOPILOTS
043795,000770: 
043796,000771:                                                                                          	# NOTE....1 ASCREV (ACTUATOR CMD SCALING) = 85.41 ARCSEC/BIT OR 1.07975111 REVS (85.41X16384/3600/360)
043797,000772:                                                                                          	#         1 SPASCREV (SPECIAL ACTUATOR CMD SCALING) = 1.04620942 REVS
043798,000773: 
043799,000774: 20,3471           00375        ACTSAT             DEC      253        B-14               	# ACTUATOR LIMIT (6 DEG), SC.AT 1ASCREV
043800,000775: 20,3472           00101        1/ACTSAT           DEC      .0039525692                    	# RECIPROCAL (1/253)
043801,000776: 
043802,000777: 20,3473     5003               ERRLIM             EQUALS   BIT13                         	# FILTER INPUT LIMIT....B-3 REVS (45DEG),
043803,000778: 20,3473     5015               1/ERRLIM           EQUALS   BIT3                          	#       SC.AT B-1 REV, AND ITS RECIPROCAL
043804,000779: 
043805,000780: 20,3473           02530        PITCHT5            GENADR   PITCHDAP                      	# UPPER WORDS OF T5 2CADRS, LOWER WORDS
043806,000781: 20,3474           03107        DAPT5              GENADR   DAPINIT                       	#       (BBCON) ALREADY THERE.  ORDER IS
043807,000782: 20,3475           02732        YAWT5              GENADR   YAWDAP                        	#       REQUIRED.
043808,000783: 
043809,000784: 20,3476           00115        1/RTLIM            DEC      0.004715                      	# .004715(CDUDIF) = 0 IF CDUDIF < 2.33 DEG
043810,000785: 20,3477           00243        1-E(-AT)           OCT      00243                         	# AT = .01SEC....EITHER(1/A=4SEC, T=40MS),
043811,000786: 20,3500           37535        E(-AT)             OCT      37535                         	#                    OR(1/A=8SEC, T=80MS)
043812,000787: 
(End of include-file TVCDAPS.agc, resuming MAIN.agc)

036226,000906:                                                                                          	# MOD NO: 0                                             LOG SECTION:    P61-P67
036227,000907:                                                                                          	# MOD BY: MORTH / BAIRNSFATHER
036228,000908:                                                                                          	# MOD NO: 1     MOD BY: RR BAIRNSFATHER                 DATE:           11 MAY 67       INCLUDE GETERAD CALL
036229,000909: 
036230,000910:                                                                                          	# FUNCTIONAL DESCRIPTION:  GIVEN THE PRESENT POSITION, UNITR, CALCULATE A NEW UNITR THAT IS ROTATED THROUGH
036231,000911:                                                                                          	#       TRANSFER ANGLE, THETA, ALONG TRAJECTORY.  THEN CALCULATE SIN(LAT) AND USE TO OBTAIN FISCHER RADIUS.
036232,000912: 
036233,000913:                                                                                          	#       SINCE FISHCALC USES UNI (LEFT BY ENTRY) EARTH SCALING IS ASSUMED.  (WILL IMPROVE FOR SUITABLE TENNANT)
036234,000914: 
036235,000915:                                                                                          	# CALLING SEQUENCE:     CALL
036236,000916:                                                                                          	#                               FISHCALC
036237,000917:                                                                                          	#       ENTER WITH .5 SIN(THETA) IN MPAC.
036238,000918:                                                                                          	#       PUSHLOC IS AT PDL+0, AN ARBITRARY BASE VALUE IF LEQ 8D
036239,000919: 
036240,000920:                                                                                          	# SUBROUTINES CALLED:  GET ERAD
036241,000921: 
036242,000922:                                                                                          	# NORMAL EXIT MODE:  RVQ
036243,000923: 
036244,000924:                                                                                          	# EXIT MODES:   NONE
036245,000925: 
036246,000926:                                                                                          	# OUTPUT:       ERADM (-29) M IN MPAC ON RETURNING
036247,000927:                                                                                          	#               NEW UNIT VECTOR NOT SAVED.
036248,000928:                                                                                          	#               SIN(LAT) NOT SAVED.
036249,000929:                                                                                          	#               PUSHLOC AT PDL+0
036250,000930: 
036251,000931:                                                                                          	# ERASEABLE INITIALIZATION REQUIRED:
036252,000932:                                                                                          	#               SDELF/2         =SIN(THETA) / 2, IN MPAC                LEFT BY TFF/TRIG
036253,000933:                                                                                          	#               CDELF/2         =COS(THETA) / 2, STORED IN PDL 14D      LEFT BY TFF/TRIG
036254,000934:                                                                                          	#               RONE            (-29) M                                 LEFT BY USER
036255,000935:                                                                                          	#               VONE            (-7) M/CS                               LEFT BY USER
036256,000936:                                                                                          	#               URONE           UR/2                                    LEFT BY USER
036257,000937:                                                                                          	#               UNI             .5 UNIT(V*R)                            LEFT BY ENTRY / P61
036258,000938:                                                                                          	#               UNITW           UNIT NORTH POLE                         LEFT BY PAD LOAD
036259,000939: 
036260,000940:                                                                                          	# DEBRIS:       QPRET, PDL+0 ... PDL+5
036261,000941:                                                                                          	# -      -          -
036262,000942: 26,3030           47315        FISHCALC           PDVL     VXV                           	# URPR = UR CDELF + UHOR SDELF
036263,000943: 26,3031           02343                                    URONE                         	#
036264,000944: 26,3032           03502                                    UNI                           	#
036265,000945: 26,3033           76561                           VXSC     VSL1                          	#
036266,000946:                                                                                          	# SIN(THETA) / 2 FROM PDL+0
036267,000947: 26,3034           74315                           PDVL     VXSC                          	# TO PDL+0, +5
036268,000948: 26,3035           02343                                    URONE                         	#
036269,000949: 26,3036           00017                                    CDELF/2                       	# COS(THETA) / 2
036270,000950: 26,3037           45455                           VAD      STADR                         	#
036271,000951: 26,3040           74235                           STORE    URH                           	# FOR USE IN RTGO FROM EMS DISPLAY
036272,000952: 26,3041           72441                           DOT      SL1                           	#
036273,000953: 26,3042           01714                                    UNITW                         	# FULL UNIT VECTOR      UNIT NORTH
036274,000954: 26,3043           02156                           STORE    ALPHAV     +4                 	# = .5 SIN(LAT)
036275,000955: 26,3044           77650        DUMPFISH           GOTO                                   	#
036276,000956: 26,3045           26505                                    GETERAD                       	# SAVES FISCHER RAD (-29) M IN ERADM AND
036277,000957:                                                                                          	# IN MPAC.  RETURNS TO CALLER VIQ QPRET.
036278,000958: 
036280,000960:                                                                                          	# SUBROUTINE NAME:  VGAMCALC    (USED BY S61.2)                         DATE:           01.21.67
036281,000961:                                                                                          	# MOD NO: 0                                                             LOG SECTION:    P61-P67
036282,000962:                                                                                          	# MOD BY: MORTH / BAIRNSFATHER
036283,000963:                                                                                          	# MOD NO: 1     MOD BY: RR BAIRNSFATHER         DATE: 11 APR 67
036284,000964:                                                                                          	# MOD NO: 2     MOD BY: RR BAIRNSFATHER         DATE: 21 NOV 67         VARIABLE MU ADDED.
036285,000965:                                                                                          	# MOD NO: 3     MOD BY: RR BAIRNSFATHER         DATE: 21 MAR 68         ACCEPT DIFFERENT EARTH/MOON SCALE
036286,000966: 
036287,000967:                                                                                          	# FUNCTIONAL DESCRIPTION:  EARTH CENTERED VIS VIVA CALCULATION OF TERMINAL VELOCITY AND GAMMA (REL TO
036288,000968:                                                                                          	#       HORIZONTAL) GIVEN THE SCALAR QUANTITIES:  PRESENT RADIUS AND VELOCITY AND THE TERMINAL RADIUS.
036289,000969:                                                                                          	#       THE USER MUST APPEND PROPER SIGN TO GAMMA, SINCE IT IS CALCULATED AS A POSITIVE NUMBER.
036290,000970:                                                                                          	#       THE EQUATIONS ARE
036291,000971: 
036292,000972:                                                                                          	#               VGAM = SQRT(VN VN/MU + 2(RN-RTERM)/(RN RTERM) ) RTMU
036293,000973: 
036294,000974:                                                                                          	#               COSGAM = H / RTERM VGAM = SQRT (LCP) / (RTERM VGAM/RTMU)
036295,000975: 
036296,000976:                                                                                          	#       VGAMCALC ASSUMES THAT THE TERMINAL RADIUS IS LESS THAN THE PRESENT RADIUS.  BOTH CALCTFF AND CALCTPER
036297,000977:                                                                                          	#       MAKE THIS ASSUMPTION.
036298,000978: 
036299,000979:                                                                                          	# CALLING SEQUENCE:     CALL                    STCALL  RTERM
036300,000980:                                                                                          	#                               VGAMCALC                PREVGAM
036301,000981:                                                                                          	#       PUSHLOC AT PDL+0, ARBITRARY IF LEQ 12D
036302,000982:                                                                                          	#       C(MPAC) UNSPECIFIED                     C(MPAC)=NEW RTERM
036303,000983: 
036304,000984:                                                                                          	# SUBROUTINES CALLED:  NONE
036305,000985: 
036306,000986:                                                                                          	# NORMAL EXIT MODE:  RVQ
036307,000987: 
036308,000988:                                                                                          	# ALARMS:       NONE
036309,000989:                                                                                          	# 
036310,000990:                                                                                          	# OUTPUT:       GAMMA / 360 IN MPAC, POSITIVE NUMBER
036311,000991:                                                                                          	#               VGAM    E: (-7)   M: (-5)       M/CS IN PDL+0
036312,000992:                                                                                          	#               PUSHLOC AT PDL+2
036313,000993: 
036314,000994:                                                                                          	# ERASABLE INITIALIZATION REQD:
036315,000995:                                                                                          	#       TFF/RTMU  E: (17)   M: (14)     1/SQRT(MU)                              LEFT BY TFFCONIC.
036316,000996:                                                                                          	#       RMAG1     E: (-29)  M: (-27)    M  PRESENT RADIUS LENGTH                LEFT BY TFFCONIC
036317,000997:                                                                                          	#       NRMAG     E: (-29+NR)           M  NORM LENGTH OF PRESENT POSITION      LEFT BY TFFCONIC
036318,000998:                                                                                          	#                 M: (-27+NR)
036319,000999:                                                                                          	#       RTERM     E: (-29)  M: (-27)    M  TERMINAL RADIUS LENGTH               LEFT BY CALCTFF
036320,001000:                                                                                          	#       NRTERM    E: (-29+NR)           M  NORM LENGTH OF TERMINAL RADIUS       LEFT BY CALCTFF
036321,001001:                                                                                          	#                 M: (-27+NR)
036322,001002:                                                                                          	#       TFFVSQ    E: (20)   M: (18)   1/M  -(V SQ/MU): PRESENT VELOCITY, NORM   LEFT BY TFFCONIC
036323,001003:                                                                                          	#       TFFNP     E: (-38+2NR)          M  LCP, SEMI-LATUS RECTUM, WEIGHT NR    LEFT BY TFFCONIC
036324,001004:                                                                                          	#                 M: (-36+2NR)
036325,001005: 
036326,001006:                                                                                          	# DEBRIS:       QPRET, PDL+0 ... PDL+3
036327,001007:                                                                                          	#               RTERM, NRTERM IF PREVGAM ENTERED.
036329,001009: 
036330,001010: 26,3046           77657        PREVGAM            SL*                                    	# ENTER WITH NEW RTERM IN MPAC
036331,001011:                                                                                          	# E: (-29)  M: (-27)
036332,001012: 26,3047           20201                                    0,1                           	# X1 = -NR
036333,001013: 26,3050           00021                           STORE    NRTERM                        	# RTERM M               E: (-29+NR)     M: (-27+NR)
036334,001014: 
036335,001015: 26,3051           41345        VGAMCALC           DLOAD    DMP                           	#
036336,001016: 26,3052           00041                                    NRMAG                         	# RMAG M                E: (-29+NR)     M: (-27+NR)
036337,001017: 26,3053           00021                                    NRTERM                        	# RTERM M               E: (-29+NR)     M: (-27+NR)
036338,001018: 26,3054           45325                           PDDL     DSU                           	# RMAG RTERM M          E: (-58+2NR)    M: (-54+2NR)
036339,001019: 26,3055           00041                                    NRMAG                         	# RMAG M                E: (-29+NR)     M: (-27+NR)
036340,001020: 26,3056           00021                                    NRTERM                        	# RTERM M               E: (-29+NR)     M: (-27+NR)
036341,001021: 26,3057           56257                           SL*      DDV                           	# 2(RN-RTERM)           E: (-30+NR)     M: (-28+NR)
036342,001022: 26,3060           20171                                    0          -8D,1              	# (-8+NR)
036343,001023:                                                                                          	# PUSH UP PRODUCT.                                      
036344,001024: 26,3061           77625                           DSU                                    	#
036345,001025: 26,3062           00025                                    TFFVSQ                        	# -(V SQ/MU)            E: (20)         M: (18)
036346,001026: 26,3063           41566                           SQRT     PUSH                          	# SAVE VGAM/RT(MU) FOR NOW.     E: (10) M: (9)
036347,001027: 26,3064           65271                           DDV      PDDL                          	# XCH PDL+0, LEAVING VGAM FOR OUTPUT.
036348,001028:                                                                                          	# VGAM TO PDL M/CS      E: (-7)         M: (-2)
036349,001029: 26,3065           00037                                    TFF/RTMU                      	#                       E: (17)         M: (14)
036350,001030: 26,3066           65205                           DMP      PDDL                          	# RTERM VGAM/RTMU       E: (-19+NR)     M: (-18+NR)
036351,001031: 26,3067           00021                                    NRTERM                        	# RTERM M               E: (-29+NR)     M: (-27+NR)
036352,001032: 26,3070           00035                                    TFFNP                         	# LC P =H.H/MU M        E: (-38+2NR)    M: (-36+2NR)
036353,001033: 26,3071           56366                           SQRT     DDV                           	#                       E: (-19+NR)     M: (-18+NR)
036354,001034:                                                                                          	# PUSH UP DEN           E: (-19+NR)     M: (-18+NR)
036355,001035:                                                                                          	# USE DDV OVFL AS LIMITER (|COS| <1.0)
036356,001036: 26,3072           65542                           SR1      ACOS                          	#
036357,001037: 26,3073           77616        DUMPVGAM           RVQ                                    	#
036358,001038:                                                                                          	# CALLER MUST SUPPLY OWN SIGN ...
036359,001039:                                                                                          	#                       22W     27MS
036360,001040: 
036362,001042:                                                                                          	# SUBROUTINE NAME:      TFF/TRIG        (USED BY S61.2)         DATE            01.17.67
036363,001043:                                                                                          	# MOD NO: 0                                                     LOG SECTION:    P61-P67
036364,001044:                                                                                          	# MOD BY: RR BAIRNSFATHER
036365,001045:                                                                                          	# MOD NO: 1     MOD BY: RR BAIRNSFATHER         DATE: 14 APR 67
036366,001046:                                                                                          	# MOD NO: 2     MOD BY: RR BAIRNSFATHER         DATE: 21 MAR 68         ACCEPT DIFFERENT EARTH/MOON SCALE
036367,001047: 
036368,001048:                                                                                          	# FUNCTIONAL DESCRIPTION:  USED BY ENTRY DISPLAY TO CALCULATE SIN(THETA), COS(THETA) FROM DATA LEFT IN
036369,001049:                                                                                          	#       PDL BY TFF SUBROUTINES.  THE EQNS ARE
036370,001050: 
036371,001051:                                                                                          	#               COS(THETA) = 1-2 ABS(ARG) / (RN RTERM (1+X) )
036372,001052:                                                                                          	#                                               2
036373,001053:                                                                                          	#               SIN(THETA) = SGN(ARG) SQRT(1-COS (THETA) )
036374,001054: 
036375,001055:                                                                                          	#       WHERE THETA = TRANSFER ANGLE
036376,001056:                                                                                          	#       AND     ARG = P Z ABS(Z)                        IF ALFA ZZ LEQ 1
036377,001057:                                                                                          	#               ARG = (P / ALFA) SGN(Q1 + R 1/Z)        IF ALFA Z Z G 1
036378,001058:                                                                                          	#       AND  ARG  HAS BEEN AFFIXED WITH THE SIGN OF SIN(THETA).
036379,001059: 
036380,001060:                                                                                          	# CALLING SEQUENCE:     CALL
036381,001061:                                                                                          	#                               TFF/TRIG
036382,001062:                                                                                          	#               PUSHLOC AT PDL+0, ARBITRARY IF NOT EQ 14D
036383,001063:                                                                                          	#               C(MPAC) UNSPECIFIED
036384,001064: 
036385,001065:                                                                                          	# SUBROUTINES CALLED:  NONE
036386,001066: 
036387,001067:                                                                                          	# NORMAL EXIT MODES:  RVQ
036388,001068: 
036389,001069:                                                                                          	# ALARMS:       NONE
036390,001070: 
036391,001071:                                                                                          	# OUTPUT:       C(MPAC) = .5 SIN(THETA)
036392,001072:                                                                                          	#               CDELF/2 = .5 COS(THETA)         (IN PDL 14D)
036393,001073:                                                                                          	#               PUSHLOC AT PDL+0
036394,001074: 
036395,001075:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:
036396,001076:                                                                                          	#               TFFX                    X                                       LEFT BY CALCTFF OR CALCTPER
036397,001077:                                                                                          	#               TFFTEM  E: (-59+2NR)    ARG                                     LEFT BY CALCTFF OR CALCTPER
036398,001078:                                                                                          	#                       M: (-55+2NR)    WHERE ARG = LCP ZZ SGN(DELF) OR ARG = LCP/ALFA SGN(DELF)
036399,001079:                                                                                          	#               NRTERM  E: (-29+NR)     M  NORM LENGTH OF TERMINAL RADIUS       LEFT BY CALCTFF OR CALCTPER
036400,001080:                                                                                          	#                       M: (-27+NR)     
036401,001081:                                                                                          	#               NRMAG   E: (-29+NR)     M  NORM LENGTH OF PRESENT POSITION      LEFT BY TFFCONIC
036402,001082:                                                                                          	#                       M: (-27+NR)
036403,001083: 
036404,001084:                                                                                          	# DEBRIS:       QPRET, CDELF/2
036405,001085: 
036406,001086: 27,2631                                           BANK     27                            	#
036407,001087: 27,2000                                           SETLOC   P60S5                         	#
036408,001088: 27,2000                                           BANK                                   	#
036409,001089: 27,2631           70545        TFF/TRIG           DLOAD    SR1                           	#
036410,001090: 27,2632           00043                                    TFFX                          	#
036411,001091: 27,2633           41215                           DAD      DMP                           	#
036412,001092: 27,2634           15333                                    HIDPHALF                      	#
036413,001093: 27,2635           00041                                    NRMAG                         	# RMAG M                E: (-29+NR)     M: (-27+NR)
036414,001094: 27,2636           55205                           DMP      BDDV                          	#
036415,001095: 27,2637           00021                                    NRTERM                        	# RTERM M               E: (-29+NR)     M: (-27+NR)
036416,001096: 27,2640           00045                                    TFFTEM                        	# P ZSQ OR P/ALFA       E: (-59+2NR)    M: (-55+2NR)
036417,001097: 27,2641           44246                           ABS      BDSU                          	# THE SIGN IS FOR SDELF.
036418,001098: 27,2642           15333                                    HIDPHALF                      	#
036419,001099: 27,2643           00017                           STORE    CDELF/2                       	# .5 COS(THETA)
036420,001100: 27,2644           57516                           DSQ      DCOMP                         	# KEEP HONEST FOR SQRT.
036422,001102: 27,2645           75415                           DAD      SQRT                          	#
036423,001103: 27,2646           15325                                    HIDP1/4                       	#
036424,001104: 27,2647           43565        DUMPTRIG           SIGN     RVQ                           	#
036425,001105: 27,2650           00045                                    TFFTEM                        	# AFFIX SIGN(DELE/2)
036426,001106:                                                                                          	# RETURN WITH .5 SIN(THETA) IN MPAC
036427,001107: 
036428,001108:                                                                                          	#                       16W     15MS
036429,001109: 
036430,001110: 27,2651           77620        DISPTARG           STQ                                    	# C(MPAC) = TRGO ESTIMATE
036431,001111: 27,2652           03373                                    60GENRET                      	#
036432,001112: 27,2653           45205                           DMP      DSU                           	#
036433,001113: 27,2654           15003                                    KTETA1                        	#
036434,001114: 27,2655           03733                                    TTE1                          	#
036435,001115: 27,2656           37606                           STCALL   DTEAROT                       	#
036436,001116: 27,2657           46225                                    EARROT2                       	#
036437,001117: 27,2660           77624                           CALL                                   	#
036438,001118: 27,2661           56664                                    VRCALC                        	#
036439,001119: 27,2662           77650                           GOTO                                   	#
036440,001120: 27,2663           03373                                    60GENRET                      	#
036441,001121: 27,2664           50375        VRCALC             VLOAD    DOT                           	#
036442,001122: 27,2665           03542                                    URH                           	#
036443,001123: 27,2666           03474                                    RT                            	#
036444,001124: 27,2667           65512                           SL2      ACOS                          	#
036445,001125: 27,2670           77616                           RVQ                                    	#
036446,001126: 
036447,001127:                                                                                          	# END OF PROGRAM S61.2
036448,001128: 
036450,001130:                                                                                          	# PROGRAM DESCRIPTION S62.3     DATE 10JAN67
036451,001131:                                                                                          	# MOD NO 1                      LOG SECTION P60-P67
036452,001132:                                                                                          	# MOD BY ZELDIN
036453,001133:                                                                                          	# MOD NO: 2     MOD BY: RR BAIRNSFATHER         DATE: 15 MAY 67         CHANGED TO REF COORDS.
036454,001134:                                                                                          	# MOD NO: 3     MOD BY: RR BAIRNSFATHER         DATE: 17 JAN 68         ALFAPAD CHANGES MADE.
036455,001135: 
036456,001136:                                                                                          	# FUNCTIONAL DESCRIPTION
036457,001137: 
036458,001138:                                                                                          	#       COMPUTE DESIRED GIMBOL ANGLES FOR ENTRY ATTITUDE
036459,001139:                                                                                          	#       THE FOLLOWING TRAJECTORY TRIAD IS AVAILABLE IN MEMORY AND IS COMPUTED EACH 2 SECONDS BY CM/POSE IN
036460,001140:                                                                                          	#       REFERENCE COORDINATES (V = VELOCITY RELATIVE TO EARTH) :
036461,001141: 
036462,001142:                                                                                          	#               UXA = -UNIT(V)
036463,001143:                                                                                          	#               UYA =  UNIT(V*R)
036464,001144:                                                                                          	#               UZA =  UXA*UYA
036465,001145: 
036466,001146:                                                                                          	#       GENERATE A DESIRED BODY TRIAD FOR TRIMMED FLIGHT WITH RESPECT TO THE RELATIVE VELOCITY VECTOR, USING
036467,001147:                                                                                          	#       ROLL COMMAND AND TRIM ANGLE OF ATTACK:
036468,001148: 
036469,001149:                                                                                          	#               UXD = UNIT(UYD*UXA) SIN(ALFATRIM) + UXA COS(ALFATRIM)
036470,001150:                                                                                          	#               UYD = UYA COS(ROLLC) + UZA SIN(ROLLC)
036471,001151:                                                                                          	#               UZD = UXD * UYD
036472,001152: 
036473,001153:                                                                                          	#       USE THE DESIRED SET (IN REFERENCE COORDS) AND REFSMMAT TO CALL  CALCGA  AND OBTAIN GIMBAL ANGLES
036474,001154:                                                                                          	#       IN 2S, C IN MPAC, +2 AND THETAD, +2.
036475,001155: 
036476,001156:                                                                                          	# CALLING SEQUENCE
036477,001157: 
036478,001158:                                                                                          	#       L       CALL
036479,001159:                                                                                          	#       L+1             S62.3
036480,001160: 
036481,001161:                                                                                          	# NORMAL EXIT MODE
036482,001162: 
036483,001163:                                                                                          	#       RETURN VIA QPRET DIRECTLY FROM CALCGA.
036484,001164: 
036485,001165:                                                                                          	# SUBROUTINES CALLED
036486,001166: 
036487,001167:                                                                                          	#       CALCGA
036488,001168: 
036489,001169:                                                                                          	# ALARM OR ABORT MODES
036490,001170: 
036491,001171:                                                                                          	#       NONE
036492,001172: 
036493,001173:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
036494,001174: 
036495,001175:                                                                                          	#       ROLLC   ROLL COMMAND            DP 1:S COMP AT 1REV
036496,001176:                                                                                          	#       ALFAPAD SP 1S,C / 180           LEFT BY PAD LOAD        ALFATRIM IS NEGATIVE.
036497,001177:                                                                                          	#       UXA/2   REF COORDS              LEFT BY CM/POSE
036498,001178:                                                                                          	#       UYA/2   REF COORDS              LEFT BY CM/POSE
036499,001179:                                                                                          	#       UZA/2   REF COORDS              LEFT BY CM/POSE
036500,001180: 
036501,001181:                                                                                          	# OUTPUT
036502,001182:                                                                                          	#       
036503,001183:                                                                                          	#       CPHI    GIMBAL ANGLES (O,I,M) 2:S COMP TP (O,I,M)/180
036504,001184: 
036505,001185:                                                                                          	# DEBRIS
036506,001186: 
036507,001187:                                                                                          	#       QTEMP, QPRET, PUSHLIST
036508,001188: 
036509,001189: 10,2376                                           BANK     10                            	#
036510,001190: 10,2000                                           SETLOC   P60S4                         	#
036511,001191: 10,2000                                           BANK                                   	#
036513,001193: 10,2376                                           COUNT*   $$/S62.3                      	#
036514,001194: 
036515,001195: 10,2376           67201        S62.3              SETPD    SLOAD                         	#
036516,001196: 10,2377           00001                                    0                             	#
036517,001197: 10,2400           03012                                    ALFAPAD                       	# ALFATRIM / 180, ALFA IS NEG.
036518,001198: 10,2401           41542                           SR1      PUSH                          	#
036519,001199: 10,2402           65346                           COS      PDDL                          	# XCH PDL, COS TO PDL0
036520,001200: 10,2403           65356                           SIN      PDDL                          	# SIN TO PDL2
036521,001201: 10,2404           03316                                    ROLLC                         	#
036522,001202: 10,2405           74346                           COS      VXSC                          	#
036523,001203: 10,2406           03550                                    UYA/2                         	#                               REF COORDS
036524,001204: 10,2407           73525                           PDDL     SIN                           	# PUSH VECTOR INTO PDL4,.9
036525,001205: 10,2410           03316                                    ROLLC                         	#
036526,001206: 10,2411           53361                           VXSC     VAD                           	#
036527,001207: 10,2412           03556                                    UZA/2                         	#                               REF COORDS
036528,001208:                                                                                          	# VECTOR FROM PDL4, 9
036529,001209: 10,2413           77772                           VSL1                                   	#
036530,001210: 10,2414           02722                           STORE    YNB                           	# = UYD                         REF COORDS
036531,001211: 
036532,001212: 10,2415           76435                           VXV      VSL1                          	#
036533,001213: 10,2416           03542                                    UXA/2                         	#                               REF COORDS
036534,001214: 10,2417           65361                           VXSC     PDDL                          	#
036535,001215:                                                                                          	# SIN TRIM FROM PDL2
036536,001216:                                                                                          	# XCH PDL0 FOR COS TRIM
036537,001217: 10,2420           53361                           VXSC     VAD                           	#
036538,001218: 10,2421           03542                                    UXA/2                         	#                               REF COORDS
036539,001219:                                                                                          	# FROM PDL0
036540,001220: 10,2422           77772                           VSL1                                   	#
036541,001221: 10,2423           02714                           STORE    XNB                           	# X SC AXIS (.5 UNIT)           REF COORDS
036542,001222: 
036543,001223: 10,2424           76435                           VXV      VSL1                          	#
036544,001224: 10,2425           02722                                    YNB                           	#
036545,001225: 10,2426           26730                           STOVL    ZNB                           	# Z SC IN REF COOR. SCALED AT 2
036546,001226: 10,2427           01736                                    REFSMMAT                      	#
036547,001227: 10,2430           26672                           STOVL    XSM                           	#
036548,001228: 10,2431           01744                                    REFSMMAT   +6                 	#
036549,001229: 10,2432           26700                           STOVL    YSM                           	#
036550,001230: 10,2433           01752                                    REFSMMAT   +12D               	#
036551,001231: 10,2434           02706                           STORE    ZSM                           	#
036552,001232: 
036553,001233: 10,2435           52014                           CLEAR    GOTO                          	#
036554,001234: 10,2436           00260                                    CPHIFLAG                      	# CAUSE CALCGA TO STORE ANS IN TP CPHI
036555,001235: 10,2437           47311                                    CALCGA                        	#
036556,001236:                                                                                          	# CALCGA WILL RETURN TO ORIGINAL CALLER
036557,001237:                                                                                          	# VIA QPRET WITH 2,S COMP. ANGLES IN CPHI
036558,001238: 
036559,001239: 
036560,001240: 
(End of include-file P61-P67.agc, resuming MAIN.agc)

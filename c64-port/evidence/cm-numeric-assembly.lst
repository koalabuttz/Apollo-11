054742,000214: 
054744,000216:                                                                                          	#  INCORP2 -INCORPORATES THE COMPUTED STATE VECTOR DEVIATIONS INTO THE
054745,000217:                                                                                          	# ESTIMATED STATE VECTOR. THE STATE VECTOR UPDATED MAY BE FOR EITHER THE
054746,000218:                                                                                          	# LEM OR THE CSM.DETERMINED BY FLAG VEHUPFLG.(ZERO = LEM) (1 = CSM)
054747,000219: 
054748,000220:                                                                                          	# INPUT
054749,000221:                                                                                          	#       PERMANENT STATE VECTOR FOR EITHER THE LEM OR CSM
054750,000222:                                                                                          	#       VEHUPFLG = UPDATE VEHICLE 0=LEM 1=CSM
054751,000223:                                                                                          	#       W = ERROR TRANSITION MATRIX
054752,000224:                                                                                          	#       DELTAX = COMPUTED STATE VECTOR DEVIATIONS
054753,000225:                                                                                          	#       DMENFLG = SIZE OF W MATRIX (ZERO=6X6) (1=9X9)
054754,000226:                                                                                          	#       GAMMA = SCALAR FOR INCORPORATION
054755,000227:                                                                                          	#       ZI = VECTOR USED IN INCORPORATION
054756,000228:                                                                                          	#       OMEGA = WEIGHTING VECTOR
054757,000229: 
054758,000230:                                                                                          	# OUTPUT
054759,000231:                                                                                          	#       UPDATED PERMANENT STATE VECTOR
054760,000232: 
054761,000233:                                                                                          	# CALLING SEQUENCE
054762,000234:                                                                                          	#       L       CALL    INCORP2
054763,000235: 
054764,000236:                                                                                          	# NORMAL EXIT
054765,000237:                                                                                          	#       L+1 OF CALLING SEQUENCE

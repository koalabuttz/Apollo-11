051461,002208: 00,3030           03317                           TC       VSQSUB                        	# DOT MPAC WITH ITSELF.
051462,002209: 00,3031           30141                           CA       TEM1                          	#
051463,002210: 00,3032           56121                           XCH      OVFIND                        	#
051464,002211: 00,3033           00006                           EXTEND                                 	#
051465,002212: 00,3034           13036                           BZF      +2                            	#
051466,002213: 00,3035           12405                           TCF      DVOVF                         	#
051467,002214: 00,3036           00006                           EXTEND                                 	#
051468,002215: 00,3037           30155                           DCA      MPAC                          	# LEAVE THE SQUARE OF THE LENGTH OF THE
051469,002216: 00,3040           50120                           INDEX    FIXLOC                        	# ARGUMENT IN LVSQUARE.
051470,002217: 00,3041           52043                           DXCH     LVSQUARE                      	#
051471,002218: 
051472,002219: 00,3042           03343                           TC       SQRTSUB                       	# GO TAKE THE NORMALIZED SQUARE ROOT.
051473,002220: 
051474,002221: 00,3043           10154                           CCS      MPAC                          	# CHECK FOR UNIT OVERFLOW.
051475,002222: 00,3044           13051                           TCF      +5                            	# MPAC IS NOT LESS THAN .5 UNLESS
051476,002223: 00,3045           54001                           TS       L                             	#
051477,002224: 00,3046           50120                           INDEX    FIXLOC                        	#
051478,002225: 00,3047           52045                           DXCH     LV                            	#
051479,002226: 00,3050           12405                           TCF      DVOVF                         	# INPUT TO SQRTSUB WAS 0.
051480,002227: 
051481,002228: 00,3051           44333                           CS       FOURTEEN                      	# SEE IF THE INPUT WAS SO SMALL THAT THE
051482,002229: 00,3052           60135                           AD       MPTEMP                        	# FIRST TWO REGISTERS OF THE SQUARE WERE 0
051483,002230: 00,3053           10000                           CCS      A                             	#

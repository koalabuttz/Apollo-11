048039,000723:                                                                                          	# TO MAKE DAP INSENSITIVE TO PITCH ERRORS DUE TO ACCUMULATED NAV ERRORS, USE NOMINAL VALUE (-20 DEG) FOR TRIM ALFA
048040,000724:                                                                                          	# USED DURING ATMOSPHERIC COORDINATION.  OUTSIDE ATMOSPHERE, NAV ERRORS WILL BE SLIGHT, BUT ALFA CAN DIFFER GREATLY
048041,000725:                                                                                          	# FROM TRIM, SO USE ON-BOARD ESTIMATES.
048042,000726: 

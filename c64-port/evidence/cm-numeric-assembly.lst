045073,000271: 21,2353           12361                           TCF      TENTHSEK                      	#
045074,000272: 21,2354           37671                           CAF      PRIO34                        	# CALL FOR 1 SEC UPDATE OF TRANSFORMATION
045075,000273: 21,2355           05134                           TC       NOVAC                         	# MATRIX FROM GIMBAL AXES TO BODY AXES
045076,000274: 21,2356  E6,1510                                  EBANK=   KMPAC                         	#
045077,000275: 21,2356           03447 44066                     2CADR    AMBGUPDT                      	#
045078,000276: 
045079,000277: 21,2360           34334                           CAF      NINE                          	#
045080,000278: 
045081,000279: 21,2361           55560        TENTHSEK           TS       ATTSEC                        	#
045082,000280: 
045084,000282:                                                                                          	# WHEN AUTOMATIC MANEUVERS ARE BEING PERFORMED, THE FOLLOWING ANGLE ADDITION MUST BE MADE TO PROVIDE A SMOOTH
045085,000283:                                                                                          	# SEQUENCE OF ANGULAR COMMANDS TO THE AUTOPILOT--
045086,000284: 
045087,000285:                                                                                          	#       CDUXD = CDUXD + DELCDUX         (DOUBLE PRECISION)
045088,000286:                                                                                          	#       CDUYD = CDUYD + DELCDUY         (DOUBLE PRECISION)
045089,000287:                                                                                          	#       CDUZD = CDUZD + DELCDUZ         (DOUBLE PRECISION)
045090,000288: 
045091,000289:                                                                                          	# THE STEERING PROGRAMS-
045092,000290:                                                                                          	#       1) ATTITUDE MANEUVER ROUTINE
045093,000291:                                                                                          	#       2) LEM TRACKING
045094,000292: 
045095,000293:                                                                                          	# SHOULD GENERATE THE DESIRED ANGLES (CDUXD, CDUYD, CDUZD) AS WELL AS THE INCREMENTAL ANGLES (DELCDUX, DELCDUY,
045096,000294:                                                                                          	# DELCDUZ) SO THAT THE GIMBAL ANGLE COMMANDS CAN BE INTERPOLATED BETWEEN UPDATES.
045097,000295: 
045098,000296:                                                                                          	# HOLDFLAG CODING-
045099,000297: 
045100,000298:                                                                                          	#       + = GRAB PRESENT CDU ANGLES AND STORE IN THETADX, THETADY, THETADZ
045101,000299:                                                                                          	#           AND PERFORM ATTITUDE HOLD ABOUT THESE ANGLES
045102,000300:                                                                                          	#           ALSO IGNORE AUTOMATIC STEERING
045103,000301:                                                                                          	#           SET = + BY
045104,000302:                                                                                          	#               1) INITIALIZATION PHASE OF AUTOPILOT
045105,000303:                                                                                          	#               2) OCCURANCE OF RHC COMMANDS
045106,000304:                                                                                          	#               3) FREE MODE
045107,000305:                                                                                          	#               4) SWITCH OVER TO ATTITUDE HOLD FROM AUTO
045108,000306:                                                                                          	#                  WHILE DOING AUTOMATIC STEERING (IN THIS CASE
045109,000307:                                                                                          	#                  HOLDFLAG IS NOT ACTUALLY SET TO +, BUT THE LOGIC
045110,000308:                                                                                          	#                  FUNCTIONS AS IF IT WERE.)
045111,000309:                                                                                          	#               5) S/C CONTROL SWITCH IN SCS
045112,000310:                                                                                          	#               6) IMU POWER OFF
045113,000311:                                                                                          	#      +0 = IN ATTITUDE HOLD ABOUT A PREVIOUSLY ESTABLISHED REFERENCE
045114,000312:                                                                                          	#       - = PERFORMING AUTOMATIC MANEUVER
045115,000313:                                                                                          	#      -0 = NOT USED AT PRESENT
045116,000314: 
045117,000315:                                                                                          	# NOTE THAT THIS FLAG MUST BE SET = - BY THE STEERING PROGRAM IF IT IS TO COMMAND THE AUTOPILOT.
045118,000316:                                                                                          	# SINCE ASTRONAUT ACTION MAY CHANGE THE HOLDFLAG SETTING, IT SHOULD BE MONITORED BY THE STEERING PROGRAM TO
045119,000317:                                                                                          	# DETERMINE IF THE AUTOMATIC SEQUENCE HAS BEEN INTERRUPTED AND IF SO, TAKE APPROPRIATE ACTION.
045120,000318: 
045121,000319: 21,2362           41332                           CS       HOLDFLAG                      	#
045122,000320: 21,2363           00006                           EXTEND                                 	#
045123,000321: 21,2364           62411                           BZMF     DACNDLS                       	# IF HOLDFLAG +0,-0,+, BYPASS AUTOMATIC
045124,000322:                                                                                          	# COMMANDS
045125,000323: 21,2365           35016        DCDUINCR           CAF      TWO                           	#
045126,000324: 21,2366           55506        DELOOP             TS       SPNDX                         	#
045127,000325: 21,2367           60000                           DOUBLE                                 	#
045128,000326: 21,2370           55507                           TS       DPNDX                         	#
045129,000327: 21,2371           00006                           EXTEND                                 	#
045130,000328: 21,2372           50000                           INDEX    A                             	#
045131,000329: 21,2373           31647                           DCA      CDUXD                         	#
045133,000331: 21,2374           53511                           DXCH     KMPAC                         	#
045134,000332: 21,2375           00006                           EXTEND                                 	#
045135,000333: 21,2376           51507                           INDEX    DPNDX                         	#
045136,000334: 21,2377           31576                           DCA      DELCDUX                       	#
045137,000335: 21,2400           02054                           TC       DPADD                         	#
045138,000336: 21,2401           00006                           EXTEND                                 	#
045139,000337: 21,2402           31511                           DCA      KMPAC                         	#
045140,000338: 21,2403           51506                           INDEX    SPNDX                         	#
045141,000339: 21,2404           55572                           TS       THETADX                       	#
045142,000340: 21,2405           51507                           INDEX    DPNDX                         	#
045143,000341: 21,2406           53647                           DXCH     CDUXD                         	#
045144,000342: 21,2407           11506                           CCS      SPNDX                         	#
045145,000343: 21,2410           12366                           TCF      DELOOP                        	#
045146,000344: 
045148,000346:                                                                                          	# RCS-CSM AUTOPILOT ATTITUDE ERROR DISPLAY
045149,000347: 
045150,000348:                                                                                          	# THREE TYPES OF ATTITUDE ERRORS MAY BE DISPLAYED ON THE FDAI-
045151,000349: 
045152,000350:                                                                                          	#       MODE 1) AUTOPILOT FOLLOWING ERRORS              SELECTED BY V61E
045153,000351:                                                                                          	#               GENERATED INTERNALLY BY THE AUTOPILOT
045154,000352: 
045155,000353:                                                                                          	#       MODE 2) TOTAL ATTITUDE ERRORS                   SELECTED BY V62E
045156,000354:                                                                                          	#               WITH RESPECT TO THE CONTENTS OF N22
045157,000355: 
045158,000356:                                                                                          	#       MODE 3) TOTAL ASTRONAUT ATTITUDE ERRORS         SELECTED BY V63E
045159,000357:                                                                                          	#               WITH RESPECT TO THE CONTENTS OF N17
045160,000358: 
045161,000359:                                                                                          	# MODE 1 IS PROVIDED AS A MONITOR OF THE RCS DAP AND ITS ABILITY TO TRACK AUTOMATIC STEERING COMMANDS.  IN THIS
045162,000360:                                                                                          	# MODE THE ATTITUDE ERRORS WILL BE ZEROED WHEN THE CMC MODE SWITCH IS IN FREE
045163,000361: 
045164,000362:                                                                                          	# MODE 2 IS PROVIDED TO ASSIST THE CREW IN MANUALLY MANEUVERING THE S/C TO THE ATTITUDE (GIMBAL ANGLES) SPECIFIED
045165,000363:                                                                                          	# IN N22.  THE ATTITUDE ERRORS WRT THESE ANGLES AND THE CURRENT CDU ANGLES ARE RESOLVED INTO S/C CONTROL AXES
045166,000364:                                                                                          	# AS A FLY-TO INDICATOR.
045167,000365: 
045168,000366:                                                                                          	# MODE 3 IS PROVIDED TO ASSIST THE CREW IN MANUALLY MANEUVERING THE S/C TO THE ATTITUDE (GIMBAL ANGLES) SPECIFIED
045169,000367:                                                                                          	# IN N17.  THE ATTITUDE ERRORS WRT THESE ANGLES AND THE CURRENT CDU ANGLES ARE RESOLVED INTO S/C CONTROL AXES
045170,000368:                                                                                          	# AS A FLY-TO INDICATOR.
045171,000369: 
045172,000370:                                                                                          	# V60 IS PROVIDED TO LOAD N17 WITH A SNAPSHOT OF THE CURRENT CDU ANGLES, THUS SYNCHRONIZING THE MODE 3 DISPLAY
045173,000371:                                                                                          	# WITH THE CURRENT S/C ATTITUDE.  THIS VERB MAY BE USED AT ANY TIME.
045174,000372: 
045175,000373:                                                                                          	# THESE DISPLAYS WILL BE AVAILIABLE IN ANY MODE (AUTO, HOLD, FREE, G+N, OR SCS) ONCE THE RCS DAP HAS BEEN
045176,000374:                                                                                          	# INITIATED VIA V46E.  MODE 1, HOWEVER, WILL BE MEANINGFUL ONLY IN G+N AUTO OR HOLD.  THE CREW MAY PRESET (VIA
045177,000375:                                                                                          	# V25N17) AN ATTITUDE REFERENCE (DESIRED GIMBAL ANGLES) INTO N17 AT ANY TIME.
045178,000376: 
045179,000377: 21,2411           41501        DACNDLS            CS       RCSFLAGS                      	# ALTERNATE BETWEEN FDAIDSP1 AND FDAIDSP2
045180,000378: 21,2412           75014                           MASK     BIT4                          	#
045181,000379: 21,2413           00006                           EXTEND                                 	#
045182,000380: 21,2414           13160                           BZF      FDAIDSP2                      	#
045183,000381: 
045184,000382: 21,2415           27501        FDAIDSP1           ADS      RCSFLAGS                      	#
045185,000383: 21,2416           02420                           TC       NEEDLER                       	#
045186,000384: 21,2417           15333        KRESUME1           TCF      RESUME                        	# END PHASE 1
045187,000385: 
045189,000387:                                                                                          	# FDAI ATTITUDE ERROR DISPLAY SUBROUTINE
045190,000388: 
045191,000389:                                                                                          	# PROGRAM DESCRIPTION:  D. KEENE  5/24/67
045192,000390: 
045193,000391:                                                                                          	# THIS SUBROUTINE IS USED TO DISPLAY ATTITUDE ERRORS ON THE FDAI VIA THE DIGITAL TO ANALOG CONVERTERS (DACS)
045194,000392:                                                                                          	# IN THE CDUS.  CARE IS TAKEN TO METER OUT THE APPROPRIATE NUMBER OF PULSES TO THE IMU ERROR COUNTERS AND PREVENT
045195,000393:                                                                                          	# OVERFLOW, TO CONTROL THE RELAY SEQUENCING, AND TO AVOID INTERFERENCE WITH THE COARSE ALIGN LOOP WHICH ALSO USES
045196,000394:                                                                                          	# THE DACS.
045197,000395: 
045198,000396:                                                                                          	# CALLING SEQUENCE:
045199,000397: 
045200,000398:                                                                                          	# DURING THE INITIALIZATION SECTION OF THE USER'S PROGRAM, BIT3 OF RCSFLAGS SHOULD BE SET TO INITIATE THE
045201,000399:                                                                                          	# TURN-ON SEQUENCE WITHIN THE NEEDLES PROGRAM:
045202,000400: 
045203,000401:                                                                                          	#               CS      RCSFLAGS        IN EBANK6
045204,000402:                                                                                          	#               MASK    BIT3
045205,000403:                                                                                          	#               ADS     RCSFLAGS
045206,000404: 
045207,000405:                                                                                          	# THEREAFTER, THE ATTITUDE ERRORS GENERATED BY THE USER SHOULD BE TRANSFERED TO THE FOLLOWING LOCATIONS IN EBANK6:
045208,000406: 
045209,000407:                                                                                          	#               AK      SCALED 180 DEGREES      NOTE:   THESE LOCATIONS ARE SUBJECT
045210,000408:                                                                                          	#               AK1     SCALED 180 DEGREES              TO CHANGE
045211,000409:                                                                                          	#               AK2     SCALED 180 DEGREES
045212,000410: 
045213,000411:                                                                                          	# FULL SCALED DEFLECTION CORRESPONDS TO 16 7/8 DEGREES OF ATTITUDE ERROR
045214,000412:                                                                                          	#               (= 384 BITS IN IMU ERROR COUNTER)
045215,000413: 
045216,000414:                                                                                          	# A CALL TO NEEDLER WILL THEN UPDATE THE DISPLAY:
045217,000415: 
045218,000416:                                                                                          	#               INHINT
045219,000417:                                                                                          	#               TC      IBNKCALL        NOTE: EBANK SHOULD BE SET TO E6
045220,000418:                                                                                          	#               CADR    NEEDLER
045221,000419:                                                                                          	#               RELINT
045222,000420: 
045223,000421:                                                                                          	# THIS PROCESS SHOULD BE REPEATED EACH TIME THE ERRORS ARE UPDATED.  AT LEAST 3 PASSES THRU THE PROGRAM ARE
045224,000422:                                                                                          	# REQUIRED BEFORE ANYTHING IS ACTUALLY DISPLAYED ON THE ERROR METERS.
045225,000423:                                                                                          	# NOTE:  EACH CALL TO NEEDLER MUST BE SEPARATED BY AT LEAST 50MS TO ASSURE PROPER RELAY SEQUENCING.
045226,000424: 
045227,000425:                                                                                          	# ERASABLE USED:
045228,000426:                                                                                          	#               AK              CDUXCMD
045229,000427:                                                                                          	#               AK1             CDUYCMD
045230,000428:                                                                                          	#               AK2             CDUZCMD
045231,000429:                                                                                          	#               EDRIVEX         A,L,Q
045232,000430:                                                                                          	#               EDRIVEY         T5TEMP
045233,000431:                                                                                          	#               EDRIVEZ         SPNDX
045234,000432: 
045235,000433:                                                                                          	# SWITCHES:     RCSFLAGS        BITS 3,2
045236,000434: 
045237,000435:                                                                                          	# I/O CHANNELS: CHAN12          BIT 4            (COARSE ALIGN - READ ONLY)
045239,000437:                                                                                          	#               CHAN12          BIT 6           (IMU ERROR COUNTER ENABLE)
045240,000438:                                                                                          	#               CHAN14          BIT 13,14,15    (DAC ACTIVITY)
045241,000439: 
045242,000440:                                                                                          	# SIGN CONVENTION<      AK = THETAC - THETA
045243,000441:                                                                                          	#               WHERE   THETAC = COMMAND ANGLE
045244,000442:                                                                                          	#                       THETA = PRESENT ANGLE
045245,000443: 
045246,000444: 21,2420           35014        NEEDLER            CAF      BIT4                          	# CHECK FOR COARSE ALIGN ENABLE
045247,000445: 21,2421           00006                           EXTEND                                 	# IF IN COARSE ALIGN DO NOT USE IMU
045248,000446: 21,2422           02012                           RAND     CHAN12                        	# ERROR COUNTERS.  DONT USE NEEDLES
045249,000447: 21,2423           00006                           EXTEND                                 	#
045250,000448: 21,2424           12431                           BZF      NEEDLER1                      	#
045251,000449: 21,2425           41501                           CS       RCSFLAGS                      	# SET BIT3 FOR INITIALIZATION PASS
045252,000450: 21,2426           75015                           MASK     BIT3                          	#
045253,000451: 21,2427           27501                           ADS      RCSFLAGS                      	#
045254,000452: 21,2430           00002                           TC       Q                             	#
045255,000453: 
045256,000454: 21,2431           31501        NEEDLER1           CA       RCSFLAGS                      	#
045257,000455: 21,2432           76211                           MASK     SIX                           	#
045258,000456: 21,2433           00006                           EXTEND                                 	#
045259,000457: 21,2434           12471                           BZF      NEEDLES3                      	#
045260,000458: 21,2435           75015                           MASK     BIT3                          	#
045261,000459: 21,2436           00006                           EXTEND                                 	#
045262,000460: 21,2437           12462                           BZF      NEEDLER2                      	# BIT3 = 0, BIT2 = 1
045263,000461: 
045264,000462: 21,2440           45012                           CS       BIT6                          	# FIRST PASS BIT3 = 1
045265,000463: 21,2441           00006                           EXTEND                                 	# DISABLE IMU ERROR COUNTER TO ZERO DACS
045266,000464: 21,2442           03012                           WAND     CHAN12                        	# MUST WAIT AT LEAST 60 MS BEFORE
045267,000465: 21,2443           45021        NEEDLE11           CS       ZERO                          	# ENABLING COUNTERS.
045268,000466: 21,2444           55476                           TS       AK                            	# ZERO THE INPUTS ON FIRST PASS
045269,000467: 21,2445           55477                           TS       AK1                           	#
045270,000468: 21,2446           55500                           TS       AK2                           	#
045271,000469: 21,2447           55503                           TS       EDRIVEX                       	# ZERO THE DISPLAY REGISTERS
045272,000470: 21,2450           55504                           TS       EDRIVEY                       	#
045273,000471: 21,2451           55505                           TS       EDRIVEZ                       	#
045274,000472: 21,2452           54050                           TS       CDUXCMD                       	# ZERO THE OUT COUNTERS
045275,000473: 21,2453           54051                           TS       CDUYCMD                       	#
045276,000474: 21,2454           54052                           TS       CDUZCMD                       	#
045277,000475: 21,2455           46211                           CS       SIX                           	# RESET RCSFLAGS FOR PASS2
045278,000476: 21,2456           71501                           MASK     RCSFLAGS                      	#

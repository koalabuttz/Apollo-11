048642,000041: 
048644,000043:                                                                                          	# PROGRAM NAME - DOWN TELEMETRY PROGRAM
048645,000044:                                                                                          	# MOD NO. - 0           TO COMPLETELY REWRITE THE DOWN TELEMETRY PROGRAM AND DOWNLINK ERASABLE DUMP PROGRAM FOR THE
048646,000045:                                                                                          	#                       PURPOSE OF SAVING APPROXIMATELY 150 WORDS OF CORE STORAGE.
048647,000046:                                                                                          	#                       THIS CHANGE REQUIRES AN ENTIRELY NEW METHOD OF SPECIFYING DOWNLINK LISTS.  REFER TO DOWNLINK
048648,000047:                                                                                          	#                       LISTS LOG SECTION FOR MORE DETAILS.  HOWEVER THIS CHANGE WILL NOT AFFECT THE GROUND PROCESSING
048649,000048:                                                                                          	#                       OF DOWN TELEMETRY DATA.
048650,000049:                                                                                          	# MOD BY - KILROY, SMITH, DEWITT
048651,000050:                                                                                          	# DATE - 02 OCT 67
048652,000051:                                                                                          	# AUTHORS - KILROY, SMITH, DEWITT, DEWOLF, FAGIN
048653,000052:                                                                                          	# LOG SECTION - DOWN-TELEMETRY PROGRAM
048654,000053: 
048655,000054:                                                                                          	# FUNCTIONAL DESCRIPTION - THIS ROUTINE IS INITIATED BY TELEMETRY END
048656,000055:                                                                                          	#       PULSE FROM THE DOWNLINK TELEMETRY CONVERTER.  THIS PULSE OCCURS
048657,000056:                                                                                          	#       AT 50 TIMES PER SEC (EVERY 20 MS) THEREFORE DODOWNTM IS
048658,000057:                                                                                          	#       EXECUTED AT THESE RATES.  THIS ROUTINE SELECTS THE APPROPRIATE
048659,000058:                                                                                          	#       AGC DATA TO BE TRANSMITTED DOWNLINK AND LOADS IT INTO OUTPUT
048660,000059:                                                                                          	#       CHANNELS 34 AND 35.  THE INFORMATION IS THEN GATED OUT FROM THE
048661,000060:                                                                                          	#       LGC IN SERIAL FASHION.
048662,000061: 
048663,000062:                                                                                          	#       THIS PROGRAM IS CODED FOR A 2 SECOND DOWNLIST.  SINCE DOWNRUPTS
048664,000063:                                                                                          	#       OCCUR EVERY 20 MS AND 2 AGC COMPUTER WORDS CAN BE PLACED IN
048665,000064:                                                                                          	#       CHANNELS 34 AND 35 DURING EACH DOWNRUPT THE PROGRAM IS CAPABLE
048666,000065:                                                                                          	#       OF SENDING 200 AGC WORDS EVERY 2 SECONDS.
048667,000066: 
048668,000067:                                                                                          	# CALLING SEQUENCE - NONE
048669,000068:                                                                                          	#       PROGRAM IS ENTERED VIA TCF DODOWNTM WHICH IS EXECUTED AS A
048670,000069:                                                                                          	#       RESULT OF A DOWNRUPT.  CONTROL IS RETURNED VIA TCF RESUME WHICH
048671,000070:                                                                                          	#       IN EFFECT IS A RESUME.
048672,000071: 
048673,000072:                                                                                          	# SUBROUTINES CALLED - NONE
048674,000073: 
048675,000074:                                                                                          	# NORMAL EXIT MODE - TCF RESUME
048676,000075: 
048677,000076:                                                                                          	# ALARM OR ABORT EXIT MODE - NONE
048678,000077: 
048679,000078:                                                                                          	# RESTART PROTECTION:
048680,000079:                                                                                          	#       ON A FRESH START AND RESTART THE 'STARTSUB' SUBROUTINE WILL INITIALIZE THE DOWNLIST POINTER (ACTUALLY
048681,000080:                                                                                          	#       DNTMGOTO) TO THE BEGINNING OF THE CURRENT DOWNLIST (I.E. CURRENT CONTENTS OF DNLSTADR).  THIS HAS THE
048682,000081:                                                                                          	#       EFFECT OF IGNORING THE REMAINDER OF THE DOWNLIST WHICH THE DOWN-TELEMETRY PROGRAM WAS WORKING ON WHEN
048683,000082:                                                                                          	#       THE RESTART (OR FRESH START) OCCURRED AND RESUME DOWN TELEMETRY FROM THE BEGINNING OF THE CURRENT
048684,000083:                                                                                          	#       DOWNLIST.
048685,000084: 
048686,000085:                                                                                          	#       ALSO OF INTEREST IS THE FACT THAT ON A RESTART THE AGC WILL ZERO DOWNLINK CHANNELS 13, 34 AND 35.
048687,000086: 
048688,000087:                                                                                          	# DOWNLINK LIST SELECTION:
048689,000088:                                                                                          	#       THE APPROPRIATE DOWNLINK LISTS ARE SELECTED BY THE FOLLOWING:
048690,000089:                                                                                          	#       1.      FRESH START
048691,000090:                                                                                          	#       2.      V37EXXE WHERE XX = THE MAJOR MODE BEING SELECTED.
048692,000091:                                                                                          	#       3.      UPDATE PROGRAM (P27)
048693,000092:                                                                                          	#       4.      NON-V37 SELECTABLE TYPE PROGRAMS (E.G. AGS INITIALIZATION (SUNDANCE, LUMINARY) AND P61-P62
048694,000093:                                                                                          	#               TRANSITION (COLOSSUS) ETC.).
048695,000094: 
048696,000095:                                                                                          	# DOWNLINK LIST RULES AND LIMITATIONS:
048697,000096:                                                                                          	#       READ SECTION(S) WHICH FOLLOW 'DEBRIS' WRITEUP.
048698,000097: 
048699,000098:                                                                                          	# OUTPUT - EVERY 2 SECONDS 100 DOUBLE PRECISION WORDS (I.E. 200 LGC
048700,000099:                                                                                          	#       COMPUTER WORDS) ARE TRANSMITTED VIA DOWNLINK.
048701,000100: 
048702,000101:                                                                                          	# ERASABLE INITIALIZATION REQUIRED - NONE
048703,000102:                                                                                          	#       'DNTMGOTO' AND 'DNLSTADR' ARE INITIALIZED BY THE FRESH START PROGRAM.
048704,000103: 
048705,000104:                                                                                          	# DEBRIS (ERASABLE LOCATIONS DESTROYED BY THIS PROGRAM) -
048706,000105:                                                                                          	#       LDATALST, DNTMBUFF TO DNTMBUFF +21D, TMINDEX, DNQ.
048709,000108: 
048711,000110:                                                                                          	# DODOWNTM IS ENTERED EVERY 20 MS BY AN INTERRUPT TRIGGERED BY THE
048712,000111:                                                                                          	# RECEIPT OF AN ENDPULSE FROM THE SPACECRAFT TELEMETRY PROGRAMMER.
048713,000112: 
048714,000113:                                                                                          	# NOTES REGARDING DOWNLINK LISTS ASSOCIATED WITH THIS PROGRAM:
048715,000114:                                                                                          	# 1.    DOWNLISTS. - DOWNLISTS MUST BE COMPILED IN THE SAME BANK AS THE
048716,000115:                                                                                          	#       DOWN-TELEMETRY PROGRAM.  THIS IS DONE FOR EASE OF CODING, FASTER
048717,000116:                                                                                          	#       EXECUTION.
048718,000117:                                                                                          	# 2.    EACH DOWNLINK LIST CONSISTS OF A CONTROL LIST AND A NUMBER OF
048719,000118:                                                                                          	#       SUBLISTS.
048720,000119:                                                                                          	# 3.    A SUBLIST REFERS TO A SNAPSHOT OR DATA COMMON TO THE SAME OR OTHER
048721,000120:                                                                                          	#       DOWNLINK LISTS.  ANY SUBLIST CONTAINING COMMON DATA NEEDS TO BE
048722,000121:                                                                                          	#       CODED ONLY ONCE FOR THE APPLICABLE DOWNLINK LISTS.
048723,000122:                                                                                          	# 4.    SNAPSHOT SUBLISTS REFER SPECIFICALLY TO HOMOGENOUS DATA WHICH MUST BE
048724,000123:                                                                                          	#       SAVED IN A BUFFER DURING ONE DOWNRUPT.
048725,000124:                                                                                          	# 5.    THE 1DNADR FOR THE 1ST WORD OF SNAPSHOT DATA IS FOUND AT THE END
048726,000125:                                                                                          	#       OF EACH SNAPSHOT SUBLIST, SINCE THE PROGRAM CODING SENDS THIS DP WORD
048727,000126:                                                                                          	#       IMMEDIATELY AFTER STORING THE OTHERS IN THE SNAPSHOT BUFFER.
048728,000127:                                                                                          	# 6.    ALL LISTS ARE COMBINATIONS OF CODED ERASABLE ADDRESS CONSTANTS
048729,000128:                                                                                          	#       CREATED FOR THE DOWNLIST PROGRAM.
048730,000129:                                                                                          	#       A.      1DNADR                  1-WORD DOWNLIST ADDRESS.
048731,000130:                                                                                          	#               SAME AS ECADR, BUT USED WHEN THE WORD ADDRESSED IS THE LEFT
048732,000131:                                                                                          	#               HALF OF A DOUBLE-PRECISION WORD FOR DOWN TELEMETRY.
048733,000132:                                                                                          	#       B.      2DNADR - 6DNADR         N-WORD DOWNLIST ADDRESS, N = 2 - 6.
048734,000133:                                                                                          	#               SAME AS 1DNADR, BUT WITH THE 4 UNUSED BITS OF THE ECADR FORMAT
048735,000134:                                                                                          	#               FILLED IN WITH 0001-0101.  USED TO POINT TO A LIST OF N DOUBLE-
048736,000135:                                                                                          	#               PRECISION WORDS, STORED CONSECUTIVELY, FOR DOWN TELEMETRY.
048737,000136:                                                                                          	#       C.      DNCHAN                  DOWNLIST CHANNEL ADDRESS.
048738,000137:                                                                                          	#               SAME AS 1DNADR, BUT WITH PREFIX BITS 0111.  USED TO POINT TO
048739,000138:                                                                                          	#               A PAIR OF CHANNELS FOR DOWN TELEMETRY.
048740,000139:                                                                                          	#       D.      DNPTR                   DOWN TELEMETRY SUBLIST POINTER.
048741,000140:                                                                                          	#               SAME AS CAF BUT TAGGED AS A CONSTANT.  USED IN CONTROL LIST TO POINT TO A SUBLIST.
048742,000141:                                                                                          	#               CAUTION --- A DNPTR CANNOT BE USED IN A SUBLIST.
048743,000142:                                                                                          	# 7.    THE WORD ORDER CODE IS SET TO ZERO AT THE BEGINNING OF EACH DOWNLIST (I.E. CONTROL LIST) AND WHEN
048744,000143:                                                                                          	#       A '1DNADR TIME2' IS DETECTED IN THE CONTROL LIST (ONLY).
048745,000144:                                                                                          	# 8.    IN THE SNAPSHOT SUBLIST ONLY, THE DNADR'S CANNOT POINT TO THE FIRST WORD OF ANY EBANK.
048746,000145: 
048747,000146:                                                                                          	# DOWNLINK LIST RESTRICTIONS:
048748,000147:                                                                                          	# (THE FOLLOWING POINTS MAY BE LISTED ELSEWHERE BUT ARE LISTED HERE SO IT IS CLEAR THAT THESE THINGS CANNOT BE
048749,000148:                                                                                          	# DONE)
048750,000149:                                                                                          	# 1.    SNAPSHOT DOWNLIST:
048751,000150:                                                                                          	#       (A) CANNOT CONTAIN THE FOLLOWING ECADRS (I.E. 1DNADR'S): 0, 400, 1000, 1400, 2000, 2400, 3000, 3400.
048752,000151:                                                                                          	#       (B) CAN CONTAIN ONLY 1DNADR'S
048753,000152:                                                                                          	# 2.    ALL DOWNLINKED DATA (EXCEPT CHANNELS) IS PICKED UP BY A <DCA<SO DOWNLINK LISTS CANNOT CONTAIN THE
048754,000153:                                                                                          	#       EQUIVALENT OF THE FOLLOWING ECADRS (I.E. IDNADRS): 377, 777, 1377, 1777, 2377, 27777, 3377, 3777.
048755,000154:                                                                                          	#       (NOTE: THE TERM EQUIVALENT ' MEANT THAT THE IDNADR TO 6DNADR WILL BE PROCESSED LIKE 1 TO 6 ECADRS)
048756,000155:                                                                                          	# 3.    CONTROL LISTS AND SUBLISTS CANNOT HAVE ENTRIES = OCTAL 00000 OR OCTAL 77777
048758,000157:                                                                                          	# 4.    THE '1DNADR TIME2' WHICH WILL CAUSE THE DOWNLINK PROGRAM TO SET THE WORDER CODE TO 3 MUST APPEAR IN THE
048759,000158:                                                                                          	#       CONTROL SECTION OF THE DOWNLIST.
048760,000159:                                                                                          	# 5.    'DNCHAN 0' CANNOT BE USED.
048761,000160:                                                                                          	# 6.    'DNPTR 0' CANNOT BE USED.
048762,000161:                                                                                          	# 7.    DNPTR CANNOT APPEAR IN A SUBLIST.
048763,000162: 
048764,000163:                                                                                          	# EBANK SETTINGS
048765,000164:                                                                                          	#       IN THE PROCESS OF SETTING THE EBANK (WHEN PICKING UP DOWNLINK DATA) THE DOWN TELEMETRY PROGRAM PUTS
048766,000165:                                                                                          	#       'GARBAGE' INTO BITS15-12 OF EBANK.  HUGH BLAIR-SMITH WARNS US THAT BITS15-12 OF EBANK MAY BECOME
048767,000166:                                                                                          	#       SIGNIFICANT SOMEDAY IN THE FUTURE.  IF/WHEN THAT HAPPENS, THE PROGRAM SHOULD INSURE (BY MASKING ETC.)
048768,000167:                                                                                          	#       THAT BITS 15-12 OF EBANK ARE ZERO.
048769,000168: 
048770,000169:                                                                                          	# INITIALIZATION REQUIRED - TO INTERRUPT CURRENT LIST AND START A NEW ONE..
048771,000170:                                                                                          	#       1. ADRES OF DOWNLINK LIST INTO DNLSTADR
048772,000171:                                                                                          	#       2. NEGONE INTO SUBLIST
048773,000172:                                                                                          	#       3. NEGONE INTO DNECADR
048774,000173: 
048775,000174: 22,3510                                           BANK     22                            	#
048776,000175: 05,2000                                           SETLOC   DOWNTELM                      	#
048777,000176: 05,2000                                           BANK                                   	#
048778,000177: 
048779,000178: 05,3521     0340                                  EBANK=   DNTMBUFF                      	#
048780,000179: 
048781,000180: 05,3521                                           COUNT    05/DPROG                      	#
048782,000181: 
048783,000182: 05,3521           54016        DODOWNTM           TS       BANKRUPT                      	#
048784,000183: 05,3522           00006                           EXTEND                                 	#
048785,000184: 05,3523           22012                           QXCH     QRUPT                         	# SAVE Q
048786,000185: 05,3524           35011                           CA       BIT7                          	# SET WORD ORDER CODE TO 1.  EXCEPTION- AT
048787,000186: 05,3525           00006                           EXTEND                                 	# THE BEGINNING OF EACH LIST THE WORD
048788,000187: 05,3526           05013                           WOR      CHAN13                        	# CODE WILL BE SET BACK TO 0.
048789,000188: 05,3527           00335                           TC       DNTMGOTO                      	# GOTO APPROPRIATE PHASE OF PROGRAM
048790,000189: 
048791,000190: 05,3530           37716        DNPHASE1           CA       NEGONE                        	# INITIALIZE ALL CONTROL WORDS
048792,000191: 05,3531           54337                           TS       SUBLIST                       	# WORDS TO MINUS ONE
048793,000192: 05,3532           54336                           TS       DNECADR                       	#
048794,000193: 05,3533           33653                           CA       LDNPHAS2                      	# SET DNTMGOTO =O ALL SUBSEQUENT DOWNRUPTS
048795,000194: 05,3534           54335                           TS       DNTMGOTO                      	# GO TO DNPHASE2
048796,000195: 05,3535           13551                           TCF      NEWLIST                       	#
048797,000196: 05,3536           10336        DNPHASE2           CCS      DNECADR                       	# SENDING OF DATA IN PROGRESS
048798,000197: 05,3537           03666        DODNADR            TC       FETCH2WD                      	# YES - THEN FETCH THE NEXT 2 SP WORDS
048799,000198: 05,3540           77753        MINTIME2           -1DNADR  TIME2                         	# NEGATIVE OF TIME2 1DNADR
048800,000199: 05,3541           13542                           TCF      +1                            	# (ECADR OF 3776 + 74001 = 77777)
048801,000200: 
048802,000201: 05,3542           10337                           CCS      SUBLIST                       	# IS THE SUBLIST IN CONTROL
048804,000203: 05,3543           13701                           TCF      NEXTINSL                      	# YES
048805,000204: 05,3544           74001        DNADRDCR           OCT      74001                         	# DNADR COUNT AND ECADR DECREMENTER
048806,000205: 
048807,000206: 05,3545           30334        CHKLIST            CA       CTLIST                        	#
048808,000207: 05,3546           00006                           EXTEND                                 	#
048809,000208: 05,3547           63551                           BZMF     NEWLIST                       	# IT WILL BE NEGATIVE AT END OF LIST
048810,000209: 05,3550           13556                           TCF      NEXTINCL                      	#
048811,000210: 05,3551           50332        NEWLIST            INDEX    DNLSTCOD                      	#
048812,000211: 05,3552           32335                           CA       DNTABLE                       	# INITIALIZE CTLIST WITH
048813,000212: 05,3553           54334                           TS       CTLIST                        	#       STARTING ADDRESS OF NEW LIST
048814,000213: 05,3554           40332                           CS       DNLSTCOD                      	#
048815,000214: 05,3555           13771                           TCF      SENDID     +3                 	#
048816,000215: 05,3556           50334        NEXTINCL           INDEX    CTLIST                        	#
048817,000216: 05,3557           30000                           CA       0                             	#
048818,000217: 05,3560           10000                           CCS      A                             	#
048819,000218: 05,3561           24334                           INCR     CTLIST                        	# SET POINTER TO PICK UP NEXT CTLIST WORD
048820,000219: 05,3562           13566                           TCF      +4                            	# ON NEXT ENTRY TO PROG.  (A SHOULD NOT =0)
048821,000220: 05,3563           56334                           XCH      CTLIST                        	# SET CTLIST TO NEGATIVE AND PLACE(CODING)
048822,000221: 05,3564           40000                           COM                                    	# UNCOMPLEMENTED DNADR INTO A.    (FOR LA)
048823,000222: 05,3565           56334                           XCH      CTLIST                        	#                                 (ST IN )
048824,000223: 05,3566           24000                 +4        INCR     A                             	#                                 (CTLIST)
048825,000224: 05,3567           54336                           TS       DNECADR                       	# SAVE DNADR
048826,000225: 05,3570           63540                           AD       MINTIME2                      	# TEST FOR TIME2 (NEG. OF ECADR)
048827,000226: 05,3571           10000                           CCS      A                             	#
048828,000227: 05,3572           13576                           TCF      SETWO      +1                 	# DON'T SET WORD ORDER CODE
048829,000228: 05,3573           47777        MINB1314           OCT      47777                         	# MINUS BIT 13 AND 14 (CAN'T GET HERE)
048830,000229: 05,3574           13576                           TCF      SETWO      +1                 	# DON'T SET WORD ORDER CODE
048831,000230: 05,3575           03620        SETWO              TC       WOZERO                        	# GO SET WORD ORDER CODE TO ZERO.
048832,000231: 05,3576           30336                 +1        CA       DNECADR                       	# RELOAD A WITH THE DNADR.
048833,000232: 05,3577           63573                 +2        AD       MINB1314                      	# IS THIS A REGULAR DNADR?
048834,000233: 05,3600           00006                           EXTEND                                 	#
048835,000234: 05,3601           63666                           BZMF     FETCH2WD                      	# YES.  (A MUST NEVER BE ZERO)
048836,000235: 05,3602           67710                           AD       MINB12                        	# NO-  IS IT A POINTER (DNPTR) OR A
048837,000236: 05,3603           00006                           EXTEND                                 	#       CHANNEL(DNCHAN)
048838,000237: 05,3604           63624                           BZMF     DODNPTR                       	# IT'S A POINTER.  (A MUST NEVER BE ZERO)
048839,000238: 
048840,000239: 05,3605           00006        DODNCHAN           TC       6                             	# (EXECUTED AS EXTEND)  IT S A CHANNEL
048841,000240: 05,3606           50336                           INDEX    DNECADR                       	#
048842,000241: 05,3607           44000                           INDEX    0          -4000              	# (EXECUTED AS READ)
048843,000242: 05,3610           54001                           TS       L                             	#
048844,000243: 05,3611           00006                           TC       6                             	# (EXECUTED AS EXTEND)
048845,000244: 05,3612           50336                           INDEX    DNECADR                       	#
048846,000245: 05,3613           43777                           INDEX    0          -4001              	# (EXECUTED AS READ)
048847,000246: 05,3614           54336                           TS       DNECADR                       	# SET DNECADR
048848,000247: 05,3615           37716                           CA       NEGONE                        	#       TO MINUS
048849,000248: 05,3616           56336                           XCH      DNECADR                       	#               WHILE PRESERVING A.
048850,000249: 05,3617           13714                           TCF      DNTMEXIT                      	# GO SEND CHANNELS
048851,000250: 
048852,000251: 05,3620           45011        WOZERO             CS       BIT7                          	#
048853,000252: 05,3621           00006                           EXTEND                                 	#
048855,000254: 05,3622           03013                           WAND     CHAN13                        	# SET WORD ORDER CODE TO ZERO
048856,000255: 05,3623           00002                           TC       Q                             	# RETURN TO CALLER
048857,000256: 
048858,000257: 05,3624           50336        DODNPTR            INDEX    DNECADR                       	# DNECADR CONTAINS ADRES OF SUBLIST
048859,000258: 05,3625           00000                           0        0                             	# CLEAR AND ADD LIST ENTRY INTO A.
048860,000259: 05,3626           10000                           CCS      A                             	# IS THIS A SNAPSHOT SUBLIST
048861,000260: 05,3627           30336                           CA       DNECADR                       	# NO, IT IS A REGULAR SUBLIST.
048862,000261: 05,3630           13700                           TCF      DOSUBLST                      	# A MUST NOT BE ZERO.
048863,000262: 
048864,000263: 05,3631           56336                           XCH      DNECADR                       	# YES, IT IS A SNAPSHOT SUBLIST.
048865,000264: 05,3632           54337                           TS       SUBLIST                       	# C(DNECADR) INTO SUBLIST
048866,000265: 05,3633           35021                           CAF      ZERO                          	#       A    INTO     A
048867,000266: 05,3634           56336                           XCH      TMINDEX                       	# (NOTE.. TMINDEX = DNECADR)
048868,000267: 
048869,000268:                                                                                          	# THE FOLLOWING CODING (FROM SNAPLOOP TO SNAPEND) IS FOR THE PURPOSE OF TAKING A SNAPSHOT OF 12 DP REGISTERS.
048870,000269:                                                                                          	# THIS IS DONE BY SAVING 11 DP REGISTERS IN DNTMBUFF AND SENDING THE FIRST DP WORD IMMEDIATELY.
048871,000270:                                                                                          	# THE SNAPSHOT PROCESSING IS THE MOST TIME CONSUMING AND THEREFORE THE CODING AND LIST STRUCTURE WERE DESIGNED
048872,000271:                                                                                          	# TO MINIMIZE TIME.  THE TIME OPTIMIZATION RESULTS IN RULES UNIQUE TO THE SNAPSHOT PORTION OF THE DOWNLIST.
048873,000272:                                                                                          	# THESE RULES ARE ......
048874,000273:                                                                                          	#       1.      ONLY 1DNADR'S CAN APPEAR IN THE SNAPSHOT SUBLIST
048875,000274:                                                                                          	#       2.      THE 1DNADR'S CANNOT REFER TO THE FIRST LOCATION IN ANY BANK.
048876,000275: 
048877,000276: 05,3635           54003        SNAPLOOP           TS       EBANK                         	# SET EBANK
048878,000277: 05,3636           74373                           MASK     LOW8                          	# ISOLATE RELATIVE ADDRESS
048879,000278: 05,3637           00006                           EXTEND                                 	#
048880,000279: 05,3640           50000                           INDEX    A                             	#
048881,000280: 05,3641  E3,1401                                  EBANK=   1401                          	#
048882,000281: 05,3641           31402                           DCA      1401                          	# PICK UP 2 SNAPSHOT WORDS.
048883,000282: 05,3642     0340                                  EBANK=   DNTMBUFF                      	#
048884,000283: 05,3642           50336                           INDEX    TMINDEX                       	#
048885,000284: 05,3643           52341                           DXCH     DNTMBUFF                      	# STORE 2 SNAPSHOT WORDS IN BUFFER
048886,000285: 05,3644           24336                           INCR     TMINDEX                       	# SET BUFFER INDEX FOR NEXT 2 WORDS.
048887,000286: 05,3645           24336                           INCR     TMINDEX                       	#
048888,000287: 05,3646           24337        SNAPAGN            INCR     SUBLIST                       	# SET POINTER TO NEXT 2 WORDS OF SNAPSHOT
048889,000288: 05,3647           50337                           INDEX    SUBLIST                       	#
048890,000289: 05,3650           00000                           0        0                             	# = CA SSSS (SSSS = NEXT ENTRY IN SUBLIST)
048891,000290: 05,3651           10000                           CCS      A                             	# TEST FOR LAST TWO WORDS OF SNAPSHOT.
048892,000291: 05,3652           13635                           TCF      SNAPLOOP                      	# NOT LAST TWO.
048893,000292: 05,3653           03536        LDNPHAS2           GENADR   DNPHASE2                      	#
048894,000293: 05,3654           54337                           TS       SUBLIST                       	# YES, LAST.  SAVE A.
048895,000294: 05,3655           37716                           CA       NEGONE                        	# SET DNECADR AND
048896,000295: 05,3656           54336                           TS       DNECADR                       	#       SUBLIST POINTERS
048897,000296: 05,3657           56337                           XCH      SUBLIST                       	#               TO NEGATIVE VALUES.
048898,000297: 05,3660           54003                           TS       EBANK                         	#
048899,000298: 05,3661           74373                           MASK     LOW8                          	#
048900,000299: 05,3662           00006                           EXTEND                                 	#
048901,000300: 05,3663           50000                           INDEX    A                             	#
048902,000301: 05,3664  E3,1401                                  EBANK=   1401                          	#
048904,000303: 05,3664           31402                           DCA      1401                          	# PICK UP FIRST 2 WORDS OF SNAPSHOT.
048905,000304: 05,3665     0340                                  EBANK=   DNTMBUFF                      	#
048906,000305: 05,3665           13714        SNAPEND            TCF      DNTMEXIT                      	# NOW GO SEND THEM.
048907,000306: 
048908,000307: 05,3666           30336        FETCH2WD           CA       DNECADR                       	#
048909,000308: 05,3667           54003                           TS       EBANK                         	# SET EBANK
048910,000309: 05,3670           74373                           MASK     LOW8                          	# ISOLATE RELATIVE ADDRESS
048911,000310: 05,3671           54001                           TS       L                             	#
048912,000311: 05,3672           33544                           CA       DNADRDCR                      	# DECREMENT COUNT AND ECADR
048913,000312: 05,3673           26336                           ADS      DNECADR                       	#
048914,000313: 05,3674           00006                           EXTEND                                 	#
048915,000314: 05,3675           50001                           INDEX    L                             	#
048916,000315: 05,3676  E3,1400                                  EBANK=   1400                          	#
048917,000316: 05,3676           31401                           DCA      1400                          	# PICK UP 2 DATA WORDS
048918,000317: 05,3677     0340                                  EBANK=   DNTMBUFF                      	#
048919,000318: 05,3677           13714                           TCF      DNTMEXIT                      	# NOW GO SEND THEM.
048920,000319: 
048921,000320: 05,3700           54337        DOSUBLST           TS       SUBLIST                       	# SET SUBLIST POINTER
048922,000321: 05,3701           50337        NEXTINSL           INDEX    SUBLIST                       	#
048923,000322: 05,3702           00000                           0        0                             	# = CA SSSS (SSSS = NEXT ENTRY IN SUBLIST)
048924,000323: 05,3703           10000                           CCS      A                             	# IS IT THE END OF THE SUBLIST
048925,000324: 05,3704           24337                           INCR     SUBLIST                       	# NO-
048926,000325: 05,3705           13711                           TCF      +4                            	#
048927,000326: 05,3706           54337                           TS       SUBLIST                       	# SAVE A.
048928,000327: 05,3707           37716                           CA       NEGONE                        	# SET SUBLIST TO MINUS
048929,000328: 05,3710           56337                           XCH      SUBLIST                       	# RETRIEVE A.
048930,000329: 05,3711           24000                 +4        INCR     A                             	#
048931,000330: 05,3712           54336                           TS       DNECADR                       	# SAVE DNADR
048932,000331: 05,3713           13577                           TCF      SETWO      +2                 	# GO USE COMMON CODING (PROBLEMS WOULD
048933,000332:                                                                                          	# OCCUR IF THE PROGRAM ENCOUNTERED A
048934,000333:                                                                                          	# DNPTR NOW)
048935,000334: 
048936,000335: 05,3714           00006        DNTMEXIT           EXTEND                                 	# DOWN-TELEMETRY EXIT
048937,000336: 05,3715           01034                           WRITE    DNTM1                         	# TO SEND A + L TO CHANNELS 34 + 35
048938,000337: 05,3716           30001                           CA       L                             	# RESPECTIVELY
048939,000338: 05,3717           00006        TMEXITL            EXTEND                                 	#
048940,000339: 05,3720           01035                           WRITE    DNTM2                         	#
048941,000340: 05,3721           15333        TMRESUME           TCF      RESUME                        	# EXIT TELEMETRY PROGRAM VIA RESUME.
048942,000341: 
048943,000342: 05,3722     7710               MINB12             EQUALS   -1/8                          	#
048944,000343: 05,3722     0336               DNECADR            EQUALS   TMINDEX                       	#
048945,000344: 05,3722     0334               CTLIST             EQUALS   LDATALST                      	#
048946,000345: 05,3722     0337               SUBLIST            EQUALS   DNQ                           	#
048947,000346: 
048949,000348:                                                                                          	# SUBROUTINE NAME - DNDUMP
048950,000349: 
048951,000350:                                                                                          	# FUNCTIONAL DESCRIPTION - TO SEND (DUMP) ALL ERASABLE STORAGE 'N' TIMES.(N = 1 TO 4). BANKS ARE SENT ONE AT A TIME
048952,000351:                                                                                          	#       EACH BANK IS PRECEEDED BY AN ID WORD, SYNCH BITS, ECADR AND TIME1 FOLLOWED BY THE 256D WORDS OF EACH
048953,000352:                                                                                          	#       EBANK.  EBANKS ARE DUMPED IN ORDER (I.E. EBANK 0 FIRST, THEN EBANK1 ETC.)
048954,000353: 
048955,000354:                                                                                          	# CALLING SEQUENCE- THE GROUND OR ASTRONAUT BY KEYING V74E CAN INITIALIZE THE DUMP.
048956,000355:                                                                                          	#       AFTER KEYING IN V74E THE CURRENT DOWNLIST WILL BE IMMEDIATELY TERMINATED AND THE DOWNLINK ERASABLE DUMP
048957,000356:                                                                                          	#       WILL BEGIN.
048958,000357: 
048959,000358:                                                                                          	#       ONCE INITIATED THE DOWNLINK ERASABLE DUMP CAN BE TERMINATED (AND INTERRUPTED DOWNLIST REINSTATED) ONLY
048960,000359:                                                                                          	#       BY THE FOLLOWING:
048961,000360: 
048962,000361:                                                                                          	#       1.      A FRESH START
048963,000362:                                                                                          	#       2.      COMPLETION OF ALL DOWNLINK DUMPS REQUESTED (ACCORDING TO BITS SET IN DUMPCNT).  NOTE THAT DUMPCNT
048964,000363:                                                                                          	#               CAN BE ALTERED BY A V21N01.
048965,000364:                                                                                          	#       3.      AND INVOLUNTARILY BY A RESTART.
048966,000365: 
048967,000366:                                                                                          	# NORMAL EXIT MODE- TCF DNPHASE1
048968,000367: 
048969,000368:                                                                                          	# ALARM OR ABORT MODE- NONE
048970,000369: 
048971,000370:                                                                                          	# *SUBROUTINES CALLED- NONE.
048972,000371: 
048973,000372:                                                                                          	# ERASABLE INITIALIZATION REQUIRED-
048974,000373:                                                                                          	#       DUMPCNT OCT 20000       IF 4 COMPLETE ERASABLE DUMPS ARE DESIRED
048975,000374:                                                                                          	#       DUMPCNT OCT 10000       IF 2 COMPLETE ERASABLE DUMPS ARE DESIRED
048976,000375:                                                                                          	#       DUMPCNT OCT 04000       IF 1 COMPLETE ERASABLE DUMP  IS  DESIRED
048977,000376: 
048978,000377:                                                                                          	# DEBRIS- DUMPLOC, DUMPSW, DNTMGOTO, EBANK AND CENTRAL REGISTERS
048979,000378: 
048980,000379:                                                                                          	# TIMING-       TIME (IN SECS) = ((NO.DUMPS)*(NO.EBANKS)*(WDSPEREBANK + NO.IDWDS)) / NO.WDSPERSEC
048981,000380:                                                                                          	#               TIME (IN SECS) =  (   4    )*(    8    )*(    256     +     4   )  /     100
048982,000381:                                                                                          	#          THUS TIME (IN SECS TO SEND DUMP OF ERASABLE 4 TIMES VIA DOWNLINK) = 83.2 SECONDS
048983,000382: 
048984,000383:                                                                                          	# STRUCTURE OF ONE EBANK AS IT IS SENT BY DOWNLINK PROGRAM-
048985,000384:                                                                                          	#       (REMINDER-THIS ONLY DESCRIBES ONE OF THE 8 EBANKS X 4 (DUMPS) = 32 EBANKS WHICH WILL BE SENT BY DNDUMP)
048986,000385: 
048987,000386:                                                                                          	#       DOWNLIST                                W
048988,000387:                                                                                          	#         WORD  TAKEN FROM CONTENTS OF  EXAMPLE O       COMMENTS
048989,000388:                                                                                          	#           1   ERASID                   0177X  0       DOWNLIST I.D. FOR DOWNLINK ERASABLE DUMP (X=7 CSM, 6 LM)
048990,000389:                                                                                          	#           2   LOWIDCOD                 77340  1       DOWNLINK SYNCH BITS.  (SAME ONE USED IN ALL OTHER DOWNLISTS)
048991,000390:                                                                                          	#           3   DUMPLOC                  13400  1       (SEE NOTES ON DUMPLOC) 1 = 3RD ERAS DUMP, 3400=ECADR OF 5TH WD
048992,000391:                                                                                          	#           4   TIME1                    14120  1       TIME IN CENTISECONDS
048993,000392:                                                                                          	#           5   FIRST WORD OF EBANK X    03400  1       IN THIS EXAMPLE THIS WORD = CONTENTS OF E7,1400 (ECADR 3400)
048994,000393:                                                                                          	#           6   2ND   WORD OF EBANK X    00142  1       IN THIS EXAMPLE THIS WORD = CONTENTS OF E7,1401 (ECADR 3401)
048995,000394:                                                                                          	#           7   3RD   WORD OF EBANK X    00142  1       IN THIS EXAMPLE THIS WORD = CONTENTS OF E7,1402 (ECADR 3402)
048996,000395:                                                                                          	#           .                                   1
048997,000396:                                                                                          	#           .                                   1
048998,000397:                                                                                          	#           .                                   1
048999,000398:                                                                                          	#        260D   256TH WORD OF EBANK X    03777  1       IN THIS EXAMPLE THIS WORD = CONTENTS OF E7,1777 (ECADR 3777)
049000,000399: 
049001,000400:                                                                                          	# NOTE-         DUMPLOC CONTAINS THE COUNTER AND ECADR FOR EACH WORD BEING SENT.
049002,000401:                                                                                          	#               THE BIT STRUCTURE OF DUMPLOC IS FOLLOWS---
049003,000402:                                                                                          	#                                               X = NOT USED
049004,000403:                                                                                          	#               X ABC EEE RRRRRRRR            ABC = ERASABLE DUMP COUNTER (I.E. ABC = 0,1,2 OR 3 WHICH MEANS THAT
049005,000404:                                                                                          	#                                                   COMPLETE ERASABLE DUMP NUMBER 1,2,3 OR 4 RESPECTIVELY IS IN PROGRESS)
049006,000405:                                                                                          	#                                             EEE = EBANK BITS
049007,000406:                                                                                          	#                                        RRRRRRRR = RELATIVE ADDRESS WITHIN AN EBANK.
049008,000407: 
049010,000409: 05,3722           35021        DNDUMPI            CA       ZERO                          	# INITIALIZE DOWNLINK
049011,000410: 05,3723           54336                           TS       DUMPLOC                       	# ERASABLE DUMP
049012,000411: 05,3724           03766                 +2        TC       SENDID                        	# GO SEND ID AND SYNCH BITS
049013,000412: 05,3725           33734                           CA       LDNDUMP1                      	# SET DNTMGOTO
049014,000413: 05,3726           54335                           TS       DNTMGOTO                      	# TO LOCATION FOR NEXT PASS
049015,000414: 05,3727           30025                           CA       TIME1                         	# PLACE TIME1
049016,000415: 05,3730           56001                           XCH      L                             	# INTO L
049017,000416: 05,3731           30336                           CA       DUMPLOC                       	# AND ECADR OF THIS EBANK INTO A
049018,000417: 05,3732           13714                           TCF      DNTMEXIT                      	# SEND DUMPLOC AND TIME1
049019,000418: 
049020,000419: 05,3733           03735        LDNDUMP            ADRES    DNDUMP                        	#
049021,000420: 05,3734           03750        LDNDUMP1           ADRES    DNDUMP1                       	#
049022,000421: 
049023,000422: 05,3735           35016        DNDUMP             CA       TWO                           	# INCREMENT ECADR IN DUMPLOC
049024,000423: 05,3736           26336                           ADS      DUMPLOC                       	# TO NEXT DP WORD TO BE
049025,000424: 05,3737           74373                           MASK     LOW8                          	# DUMPED AND SAVE IT.
049026,000425: 05,3740           10000                           CCS      A                             	# IS THIS THE BEGINNING OF A NEW EBANK
049027,000426: 05,3741           13752                           TCF      DNDUMP2                       	# NO- THEN CONTINUE DUMPING
049028,000427: 05,3742           30336                           CA       DUMPLOC                       	# YES- IS THIS THE END OF THE
049029,000428: 05,3743           70333                           MASK     DUMPCNT                       	# N TH(N = 1 TO 4) COMPLETE ERASABLE
049030,000429: 05,3744           77671                           MASK     PRIO34                        	# DUMP(BIT14 FOR 4, BIT13 FOR 2 OR BIT12
049031,000430: 05,3745           10000                           CCS      A                             	# FOR 1 COMPLETE ERASABLE DUMP(S)).
049032,000431: 05,3746           13530                           TCF      DNPHASE1                      	# YES- START SENDING INTERRUPTED DOWNLIST
049033,000432:                                                                                          	# AGAIN
049034,000433: 05,3747           13724                           TCF      DNDUMPI    +2                 	# NO- GO BACK AND INITIALIZE NEXT BANK
049035,000434: 
049036,000435: 05,3750           33733        DNDUMP1            CA       LDNDUMP                       	# SET DNTMGOTO
049037,000436: 05,3751           54335                           TS       DNTMGOTO                      	# FOR WORDS 3 TO 256D OF CURRENT EBANK
049038,000437: 
049039,000438: 05,3752           30336        DNDUMP2            CA       DUMPLOC                       	#
049040,000439: 05,3753           54003                           TS       EBANK                         	# SET EBANK
049041,000440: 05,3754           74373                           MASK     LOW8                          	# ISOLATE RELATIVE ADDRESS.
049042,000441: 05,3755           54002                           TS       Q                             	# (NOTE: MASK INSTRUCTION IS USED TO PICK
049043,000442: 05,3756           35020                           CA       NEG0                          	# UP ERASABLE REGISTERS SO THAT EDITING
049044,000443: 05,3757           54001                           TS       L                             	# REGISTERS 20-23 WILL NOT BE ALTERED.)
049045,000444: 05,3760           50002                           INDEX    Q                             	#
049046,000445: 05,3761  E3,1400                                  EBANK=   1400                          	# PICK UP LOW ORDER REGISTER OF PAIR
049047,000446: 05,3761           71401                           MASK     1401                          	# OF ERASABLE REGISTERS.
049048,000447: 05,3762           56001                           XCH      L                             	#
049049,000448: 05,3763           50002                           INDEX    Q                             	# PICK UP HIGH ORDER REGISTER OF PAIR
049050,000449: 05,3764           71400                           MASK     1400                          	# OF ERASABLE REGISTERS.
049051,000450: 05,3765     0340                                  EBANK=   DNTMBUFF                      	#
049052,000451: 05,3765           13714                           TCF      DNTMEXIT                      	# GO SEND THEM
049053,000452: 
049054,000453: 05,3766           00006        SENDID             EXTEND                                 	# ** ENTRANCE USED BY ERASABLE DUMP PROG. **
049055,000454: 05,3767           22335                           QXCH     DNTMGOTO                      	# SET DNTMGOTO SO NEXT TIME PROG WILL GO
049056,000455: 05,3770           35054                           CAF      ERASID                        	# TO LOCATION FOLLOWING :TC SENDID:
049057,000456: 
049058,000457: 05,3771           54001                           TS       L                             	# ** ENTRANCE USED BY REGULAR DOWNLINK PG **
049060,000459: 05,3772           03620                           TC       WOZERO                        	# GO SET WORD ORDER CODE TO ZERO
049061,000460: 05,3773           32000                           CAF      LOWIDCOD                      	# PLACE SPECIAL ID CODE INTO L
049062,000461: 05,3774           56001                           XCH      L                             	# AND ID BACK INTO A
049063,000462: 05,3775           13714                           TCF      DNTMEXIT                      	# SEND DOWNLIST ID CODE(S).
(End of include-file DOWN-TELEMETRY_PROGRAM.agc, resuming MAIN.agc)
049063,000138: 
049064,000139: $INTER-BANK_COMMUNICATION.agc			        # pp. 1103-1106

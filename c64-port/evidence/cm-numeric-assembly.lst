039557,000185: 37,3651           77726                           ARCCOS                                 	#
039558,000186: 37,3652           00013                           STORE    10D                           	# (-GAMA/180)/2
039559,000187: 
039560,000188: 37,3653           77551                           TLOAD    EXIT                          	# ANGLES IN MPAC IN THE ORDER
039561,000189:                                                                                          	# -( (ROLL, BETA, ALFA) /180)/2
039562,000190: 37,3654           00007                                    6D                            	# THESE VALUES CORRECT AT PIPUP TIME.
039563,000191: 
039564,000192:                                                                                          	# SPACER
039566,000194:                                                                                          	# BASIC SUBROUTINE TO UPDATE ATTITUDE ANGLES
039567,000195: 
039568,000196: 37,3655  E6,1661                                  EBANK=   AOG                           	#
039569,000197: 
039570,000198: 37,3655           35057        CM/ATUP            CA       EBAOG                         	#
039571,000199: 37,3656           54003                           TS       EBANK                         	#
039572,000200: 37,3657           50120        CMTR1              INDEX    FIXLOC                        	#
039573,000201: 37,3660           40012                           CS       10D                           	# (GAMA/180)/2
039574,000202: 37,3661           57722                           XCH      GAMA                          	#
039575,000203: 37,3662           54001                           TS       L                             	#
039576,000204: 
039577,000205: 37,3663           00004                           INHINT                                 	#
039578,000206:                                                                                          	# MUST REMAIN INHINTED UNTIL UPDATE OF BODY
039579,000207:                                                                                          	# ANGLES, SO THAT GAMDIFSW IS VALID FIRST PASS
039580,000208:                                                                                          	# INDICATOR.
039581,000209: 
039582,000210: 37,3664           40102                           CS       CM/FLAGS                      	#
039583,000211: 37,3665           75005                           MASK     BIT11                         	# GAMDIFSW=94D BIT11    INITLY=0
039584,000212: 37,3666           00006                           EXTEND                                 	# DONT CALC GAMA DOT UNTIL HAVE FORMD
039585,000213:                                                                                          	# ONE DIFFERENCE.
039586,000214: 37,3667           13672                           BZF      DOGAMDOT                      	# IS OK, GO ON.
039587,000215: 37,3670           26102                           ADS      CM/FLAGS                      	# KNOW BIT IS 0
039588,000216: 37,3671           03705                           TC       NOGAMDOT                      	# SET GAMDOT = 0
039589,000217: 
039590,000218: 37,3672           40001        DOGAMDOT           CS       L                             	#
039591,000219: 37,3673           61722                           AD       GAMA                          	# DEL GAMA/360= T GAMDOT/360
039592,000220: 37,3674           00006                           EXTEND                                 	#
039593,000221: 37,3675           73770                           MP       TCDU                          	# TCDU = .1 SEC, T = 2 SEC.
039594,000222: 37,3676           55723                           TS       GAMDOT                        	# GAMA DOT TCDU / 180
039595,000223: 
039596,000224: 37,3677           00006                           EXTEND                                 	# IGNORE GAMDOT IF LEQ .5 DEG/SEC
039597,000225: 37,3700           63702                           BZMF     +2                            	#
039598,000226: 37,3701           40000                           COM                                    	#
039599,000227: 37,3702           65022                           AD       FIVE                          	#
039600,000228: 37,3703           00006                           EXTEND                                 	#
039601,000229: 37,3704           63707                           BZMF     +3                            	# SET GAMDOT=+0 AS TAG IF TOO SMALL.
039602,000230: 
039603,000231: 37,3705           35021        NOGAMDOT           CA       ZERO                          	# COME HERE INHINTED.
039604,000232: 37,3706           55723                           TS       GAMDOT                        	#
039605,000233:                                                                                          	# FOR NOW LEAVE IN 2S,C
039606,000234:                                                                                          	# UPDATE ANGLES BY CORRECTING EUILER ANG
039607,000235:                                                                                          	# FOR ACCRUED INCREMENT SINCE PIPUP
039608,000236:                                                                                          	# R = R EUIL + R(NOW) - R(PIPUP)
039609,000237: 37,3707           40154                           CS       MPAC                          	# GET (R EUL/180) /2
039610,000238: 37,3710           60000                           DOUBLE                                 	# POSSIBLE OVERFLOW
039611,000239: 37,3711           03760                           TC       CORANGOV                      	# CORRECT FOR OVFL IF ANY
039612,000240: 37,3712           00006                           EXTEND                                 	#
039613,000241: 37,3713           61672                           SU       ROLL/PIP                      	# GET INCR SINCE PIPUP
039614,000242: 37,3714           61664                           AD       ROLL/180                      	# ONLY SINGLE OVFL POSSIBLE.
039615,000243: 37,3715           03760                           TC       CORANGOV                      	# CORRECT FOR OVFL IF ANY
039617,000245: 37,3716           55770                           TS       TEMPROLL                      	#
039618,000246: 
039619,000247: 37,3717           40156                           CS       MPAC       +2                 	# GET (ALFA EUL/180) /2
039620,000248: 37,3720           60000                           DOUBLE                                 	# SAME AS FOR ROLL.  NEEDED FOR EXT ATM DAP
039621,000249: 37,3721           03760                           TC       CORANGOV                      	# CORRECT FOR OVFL IF ANY
039622,000250: 37,3722           00006                           EXTEND                                 	#
039623,000251: 37,3723           61673                           SU       ALFA/PIP                      	#
039624,000252: 37,3724           61665                           AD       ALFA/180                      	#
039625,000253: 37,3725           03760                           TC       CORANGOV                      	# CORRECT FOR OVFL IF ANY
039626,000254: 37,3726           55771                           TS       TEMPALFA                      	#
039627,000255: 
039628,000256: 37,3727           40155                           CS       MPAC       +1                 	# GET (BETA EUL/180) /2
039629,000257: 37,3730           60000        CMTR2              DOUBLE                                 	#
039630,000258: 37,3731           00006                           EXTEND                                 	#
039631,000259: 37,3732           61674                           SU       BETA/PIP                      	#
039632,000260: 37,3733           61666                           AD       BETA/180                      	#
039633,000261: 37,3734           57772                           XCH      TEMPBETA                      	# OVFL NOT EXPECTED.
039634,000262: 
039635,000263: 37,3735           35051                           CA       EBANK3                        	#
039636,000264: 37,3736           54003                           TS       EBANK                         	#
039637,000265: 

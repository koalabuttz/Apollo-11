040915,001236: 
040917,001238:                                                                                          	# V2(T1) COMPUTATION SUBROUTINE
040918,001239: 
040919,001240:                                                                                          	# DESCRIPTION
040920,001241:                                                                                          	#       A POST IMPULSE VELOCITY VECTOR (V2(T1)) IS COMPUTED WHICH EITHER
040921,001242:                                                                                          	#       (1)     MEETS THE INPUT VELOCITY CHANGE DESIRED (RTEDVD) IN A MINIMUM TIME      OR
040922,001243:                                                                                          	#       (2)     IF A VELOCITY CHANGE ISN:T SPECIFIED (RTEDVD) = 0), A V2(T1) IS COMPUTED WHICH MINIMIZES THE IMPULSE (DV)
040923,001244:                                                                                          	#               AND CONSEQUENTLY FUEL.
040924,001245: 
040925,001246:                                                                                          	# CALLING SEQUENCE
040926,001247:                                                                                          	#       L       CALL
040927,001248:                                                                                          	#       L+1             V2T100
040928,001249: 
040929,001250:                                                                                          	# NORMAL EXIT MODE
040930,001251:                                                                                          	#       AT L+2 OF CALLING SEQUENCE WITH MPAC = 0
040931,001252: 
040932,001253:                                                                                          	# ALARM EXIT MODE
040933,001254:                                                                                          	#       AT L+2 OF CALLING SEQUENCE WITH MPAC = OCTAL 605 FOR EXCESS ITERATIONS
040934,001255: 
040935,001256:                                                                                          	# SUBROUTINES CALLED
040936,001257:                                                                                          	#       GAMDV10
040937,001258:                                                                                          	#       XT1LIM
040938,001259:                                                                                          	#       DVCALC
040939,001260: 
040940,001261:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
040941,001262:                                                                                          	#    PUSHLIST
040942,001263:                                                                                          	#       NONE
040943,001264:                                                                                          	#    MPAC
040944,001265:                                                                                          	#       NONE
040945,001266:                                                                                          	#    OTHER
040946,001267:                                                                                          	#       R(T1)           MAGNITUDE OF INITIAL POSITION VECTOR                    DP      B29/B27 METERS
040947,001268:                                                                                          	#       RCON            MAGNITUDE OF FINAL POSITION VECTOR                      DP      B29/B27 METERS
040948,001269:                                                                                          	#       V(T1)/          INITIAL VELOCITY VECTOR                                 VECTOR  B7/B5   METERS/CS
040949,001270:                                                                                          	#       RTEDVD          DELTA VELOCITY DESIRED                                  DP      B7/B5   METERS/CS
040950,001271:                                                                                          	#       UR1/            UNIT INITIAL VECTOR                                     VECTOR  B1
040951,001272:                                                                                          	#       UH/             UNIT HORIZONTAL VECTOR                                  VECTOR  B1
040952,001273:                                                                                          	#       X(T2)           COTANGENT OF FINAL FLIGHT PATH ANGLE                    DP      B0
040953,001274:                                                                                          	#       X(T1)           COTANGENT OF INITIAL FLIGHT PATH ANGLE (INPUT FOR PREC) DP      B5
040954,001275:                                                                                          	#       CFPA            COSINE OF INITIAL FLIGHT PATH ANGLE                     DP      B1
040955,001276:                                                                                          	#       MAMAX1          MAJOR AXIS LIMIT FOR LOWER BOUND ON GAMDV ITERATOR      DP      B30/B28 METERS
040956,001277:                                                                                          	#       MAMAX2          MAJOR AXIS LIMIT FOR UPPER BOUND ON GAMDV ITERATOR      DP      B30/B28 METERS
040957,001278:                                                                                          	#       PHI2            REENTRY NEAR PERIGEE OR APOGEE INDICATE (RTE ONLY)      DP       B2     -1 PERIGEE, +1 APOGEE
040958,001279:                                                                                          	#       N1              CONIC OR PRECISION ITERATION COUNTER                    DP      B28     NEGATIVE CONIC,PLUS PREC
040959,001280: 
040960,001281:                                                                                          	# OUTPUT
040961,001282:                                                                                          	#       V2(T1)/         POST IMPULSE INITIAL VELOCITY VECTOR                    VECTOR  B7/B5   METERS/CS
040962,001283:                                                                                          	#       DV              INITIAL VELOCITY CHANGE                                 DP      B7/B5   METERS/CS
040963,001284:                                                                                          	#       X(T1)           COTANGENT OF INITIAL FLIGHT PATH ANGLE (POST IMPULSE)   DP      B5
040964,001285:                                                                                          	#       PCON            SEMI-LATUS RECTUM                                       DP      B28/B26 METERS
040965,001286:                                                                                          	#       BETA1           1+X(T2)**2                                              DP      B1
040966,001287: 
040968,001289: 
040969,001290:                                                                                          	# DEBRIS
040970,001291:                                                                                          	#    PUSHLIST
040971,001292:                                                                                          	#       00D             X(T1),,=PREVIOUS PRECISION X(T1)                        DP      B5
040972,001293:                                                                                          	#       02D             THETA1=BETA5*LAMBDA-1                                   TP      B17
040973,001294:                                                                                          	#       05D             THETA2=2*R(T1)*(LAMBDA-1)                               TP      B38/B36
040974,001295:                                                                                          	#       08D             THETA3=MU**.5/R(T1)                                     DP      B-4/B-5
040975,001296:                                                                                          	#       10D             X(T1)MIN=LOWER BOUND ON X(T1) IN GAMDV ITERATOR         DP      B5
040976,001297:                                                                                          	#       12D             DX(T1)MAX=MAXIMUM DELTA X(T1)                           DP      B5
040977,001298:                                                                                          	#       14D             X(T1)MAX=UPPER BOUND ON X(T1) IN GAMDV ITERATOR         DP      B5
040978,001299:                                                                                          	#       16D             DX(T1)=ITERATOR INCREMENT                               DP      B5
040979,001300:                                                                                          	#       31D             GAMDV10 SUBROUTINE RETURN ADDRESS
040980,001301:                                                                                          	#       32D             DVCALC SUBROUTINE RETURN ADDRESS

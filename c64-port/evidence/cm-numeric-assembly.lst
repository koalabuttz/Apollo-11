033469,000586:                                                                                          	# NAME - S50 ALIAS LOCSAM
033470,000587:                                                                                          	# NAME- LOCSAM
033471,000588: 
033472,000589:                                                                                          	# FUNCTION - TO COMPUTE QUATITIGS LISTED BELOW, USED IN THE
033473,000590:                                                                                          	#             IMU ALIGNMENT PROGRAMS
033474,000591: 
033475,000592:                                                                                          	#       DEFINE:
033476,000593: 
033477,000594:                                                                                          	#       RATT = POSITION VECTOR OF CM WRT PRIMARY BODY
033478,000595: 
033479,000596:                                                                                          	#       VATT = VELOCITY VECTOR OF CM WRT PRIMARY BODY
033480,000597: 
033481,000598:                                                                                          	#       RE = RADIUS OF EARTH
033482,000599: 
033483,000600:                                                                                          	#       RM = RADIUS OF MOON
033484,000601: 
033485,000602:                                                                                          	#       ECLIPOL = POLE OF ECLIPTIC SCALED BY TANGENTIAL VELOCITY OF EARTH
033486,000603:                                                                                          	#                 WRT TO SUN OVER THE VELOCITY OF LIGHT
033487,000604: 
033488,000605:                                                                                          	#       REM = POSITION OF MOON WRT EARTH
033489,000606: 
033490,000607:                                                                                          	#       RES = POSITION OF SUN WRT EARTH
033491,000608: 
033492,000609:                                                                                          	#       C = VELOCITY OF LIGHT
033493,000610: 
033494,000611:                                                                                          	#               EARTH IS PRIMARY                        MOON IS PRIMARY
033495,000612:                                                                                          	#                       -                                       -
033496,000613:                                                                                          	#               VEARTH=-1(RATT)                         VEARTH=-1(REM+RATT)
033497,000614:                                                                                          	#                       -                                       -
033498,000615:                                                                                          	#               VMOON = 1(REM-RATT)                     VMOON =-1(RATT)
033499,000616:                                                                                          	#                       -                                       -
033500,000617:                                                                                          	#               VSUN  = 1(RES)                          VSUN  = 1(RES-REM)
033501,000618:                                                                                          	#                             -1
033502,000619:                                                                                          	#               CEARTH=COS(SIN  (RE/RATT)+5)            CEARTH=COS 5
033503,000620:                                                                                          	#                                                                     -1
033504,000621:                                                                                          	#               CMOON =COS 5                            CMOON =COS(SIN  CRM/RATT)+5)
033505,000622: 
033506,000623:                                                                                          	#               CSUN  =COS 15                           CSUN  =COS 15
033507,000624: 
033508,000625:                                                                                          	#                           VEL/C = VSUN X ECLIPOL + VATT/C
033509,000626: 
033510,000627:                                                                                          	# CALL  -       DLOAD   CALL
033511,000628:                                                                                          	#                       DESIRED TIME
033512,000629:                                                                                          	#                       LOCSAM
033513,000630: 
033514,000631:                                                                                          	# INPUTS -      MPAC = TIME
033515,000632: 
033516,000633:                                                                                          	# OUTPUTS-      VEARTH, VMOON, VSUN, CEARTH, CMOON, CSUN, VEL/C
033517,000634: 
033518,000635:                                                                                          	# SUBROUTINES-  LSPOS, CSMCONIC
033519,000636: 
033520,000637:                                                                                          	# DEBRIS  -     VAC AREA, SEE SUBROUTINES

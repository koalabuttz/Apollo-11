044825,000023:                                                                                          	## www.ibiblio.org/apollo.  If for some reason you find that the images are
044826,000024:                                                                                          	## illegible, contact me at info@sandroid.org about getting access to the 
044827,000025:                                                                                          	## (much) higher-quality images which Paul actually created.
044828,000026:                                                                                          	##
044829,000027:                                                                                          	## Notations on the hardcopy document read, in part:
044830,000028:                                                                                          	##
044831,000029:                                                                                          	##      Assemble revision 055 of AGC program Comanche by NASA
044832,000030:                                                                                          	##      2021113-051.  10:28 APR. 1, 1969  
044833,000031:                                                                                          	##
044834,000032:                                                                                          	##      This AGC program shall also be referred to as
044835,000033:                                                                                          	##                      Colossus 2A
044836,000034: 
044838,000036:                                                                                          	# T5 INTERRUPT PROGRAM FOR THE RCS-CSM AUTOPILOT
044839,000037: 
044840,000038:                                                                                          	# START OF T5 INTERRUPT PROGRAM
044841,000039: 
044842,000040: 20,3612                                           BANK     20                            	#
044843,000041: 21,2000                                           SETLOC   DAPS3                         	#
044844,000042: 21,2000                                           BANK                                   	#
044845,000043: 
044846,000044: 21,2105                                           COUNT    21/DAPRC                      	#
044847,000045: 
044848,000046: 21,2105  E6,1510                                  EBANK=   KMPAC                         	#
044849,000047: 21,2105           22016        REDORCS            LXCH     BANKRUPT                      	# RESTART OF AUTOPILOT COMES HERE
044850,000048: 21,2106           31465                           CA       T5PHASE                       	# ON A T5 RUPT.
044851,000049: 21,2107           00006                           EXTEND                                 	#
044852,000050: 21,2110           62112                           BZMF     +2                            	# IF T5PHASE +0, -0, OR -, RESET TO -
044853,000051: 21,2111           12114                           TCF      +3                            	# IF T5PHASE +, LEAVE IT +.  DO A FRESHDAP
044854,000052: 21,2112           45017                           CS       ONE                           	#
044855,000053: 21,2113           55465                           TS       T5PHASE                       	#
044856,000054: 21,2114           00006                           EXTEND                                 	#
044857,000055: 21,2115           32121                           DCA      RCSLOC                        	#
044858,000056: 21,2116           53313                           DXCH     T5LOC                         	# HOOK UP T5RUPT TO AUTOPILOT
044859,000057: 21,2117           12123                           TCF      RCSATT     +1                 	#
044860,000058: 21,2120  E6,1510                                  EBANK=   KMPAC                         	#
044861,000059: 21,2120           02122 42066  RCSLOC             2CADR    RCSATT                        	#
044862,000060: 
044863,000061: 21,2122           22016        RCSATT             LXCH     BANKRUPT                      	# SAVE BB
044864,000062: 21,2123           00006                           EXTEND                                 	# SAVE Q
044865,000063: 21,2124           22012                           QXCH     QRUPT                         	#
044866,000064: 21,2125           35001                           CAF      BIT15                         	# BIT15 CHAN31 = 0 IF IMU POWER IS ON AND
044867,000065: 21,2126           00006                           EXTEND                                 	# S/C CONT SW IS IN CMC (I.E. IF G/C AUTO
044868,000066: 21,2127           02031                           RAND     CHAN31                        	# PILOT IS FULLY ENABLED)
044869,000067: 21,2130           00006                           EXTEND                                 	#
044870,000068: 21,2131           12160                           BZF      SETT5                         	# IF G/C AUTOPILOT IS FULLY ENABLED,
044871,000069:                                                                                          	# GO TO SETT5
044872,000070: 
044873,000071: 21,2132           41501                           CS       RCSFLAGS                      	# IF G/C AUTOPILOT IS NOT FULLY ENABLED,
044874,000072: 21,2133           75002                           MASK     BIT14                         	#
044875,000073: 21,2134           27501                           ADS      RCSFLAGS                      	# SET NORATE FLAG,
044876,000074: 21,2135           34777                           CAF      POSMAX                        	#
044877,000075: 21,2136           55332                           TS       HOLDFLAG                      	# SET HOLDFLAG +,
044878,000076: 21,2137           35021                           CAF      ZERO                          	# ZERO ERRORX, ERRORY, AND ERRORZ,
044879,000077: 21,2140           55567                           TS       ERRORX                        	#
044880,000078: 21,2141           55570                           TS       ERRORY                        	#
044881,000079: 21,2142           55571                           TS       ERRORZ                        	#
044882,000080: 21,2143           35002                           CAF      BIT14                         	#
044883,000081: 21,2144           00006                           EXTEND                                 	#
044884,000082: 21,2145           02031                           RAND     CHAN31                        	# AND CHECK FREE FUNCTION (BIT14 CHAN31).
044885,000083: 21,2146           00006                           EXTEND                                 	#
044887,000085: 21,2147           12160                           BZF      SETT5                         	# IF IN FREE MODE, GO TO SETT5.
044888,000086: 
044889,000087: 21,2150           55465                           TS       T5PHASE                       	# IF NOT IN FREE MODE,
044890,000088: 21,2151           37676                           CAF      OCT37766                      	# SCHEDULE REINITIALIZATION (FRESHDAP)
044891,000089: 21,2152           54030                           TS       TIME5                         	# IN 100 MS VIA T5RUPT
044892,000090: 
044893,000091: 21,2153           02632                           TCR      ZEROJET                       	# ZERO JET CHANNELS IN 14 MS VIA ZEROJET
044894,000092: 
044895,000093: 21,2154           12350                           TCF      KMATRIX                       	#
044896,000094: 21,2155           37770        DELTATT            OCT      37770                         	# 80MS (TIME5)
044897,000095: 21,2156           37776        DELTATT2           OCT      37776                         	# 20MS (TIME5)
044898,000096: 21,2157           37634        ONESEK             DEC      16284      B-14               	# 1 SEC(TIME5)
044899,000097: 21,2160                        CHAN5              EQUALS   5                             	#
044900,000098: 21,2160                        CHAN6              EQUALS   6                             	#
044901,000099: 21,2160     7671               PRIO34A            =        PRIO34                        	#
044902,000100: 
044903,000101:                                                                                          	# CHECK PHASE OF T5 PROGRAM
044904,000102: 
044905,000103:                                                                                          	# BECAUSE OF THE LENGTH OF THE T5 PROGRAM,IT HAS BEEN DIVIDED INTO 
044906,000104:                                                                                          	# THREE PARTS, T5PHASE1, T5PHASE2, AND THE JET SELECTION LOGIC,
044907,000105:                                                                                          	# TO ALLOW FOR THE EXECUTION OF OTHER
044908,000106:                                                                                          	# INTERRUPTS.  T5PHASE IS ALSO USED IN THE INITIALIZATION OF THE AUTOPILOT
044909,000107:                                                                                          	# VARIABLES AT TURN ON.
044910,000108: 
044911,000109:                                                                                          	# THE CODING OF T5PHASE IS...
044912,000110: 
044913,000111:                                                                                          	#               + = INITIALIZE T5 RCS-CSM AUTOPILOT
044914,000112:                                                                                          	#    T5PHASE = +0 = PHASE2 OF THE T5 PROGRAM
044915,000113:                                                                                          	#               - = RESTART DAP
044916,000114:                                                                                          	#              -0 = PHASE1 OF THE T5 PROGRAM
044917,000115: 
044918,000116: 21,2160           11465        SETT5              CCS      T5PHASE                       	#
044919,000117: 21,2161           12544                           TCF      FRESHDAP                      	# TURN ON AUTOPILOT
044920,000118: 21,2162           12661                           TCF      T5PHASE2                      	# BRANCH TO PHASE2 OF PROGRAM
044921,000119: 21,2163           12546                           TCF      REDAP                         	# RESTART AUTOPILOT
044922,000120: 
044923,000121: 21,2164           55465                           TS       T5PHASE                       	# PHASE 1  RESET  FOR PHASE 2
044924,000122: 21,2165           30030                           CA       TIME5                         	#
044925,000123: 21,2166           55634                           TS       T5TIME                        	# USED IN COMPENSATING FOR DELAYS IN T5
044926,000124: 21,2167           32156                           CAF      DELTATT2                      	# RESET FOR T5RUPT IN 20MS FOR PHASE2
044927,000125: 21,2170           54030                           TS       TIME5                         	# OF PROGRAM
044928,000126: 
044930,000128:                                                                                          	# IMU STATUS CHECK
044931,000129: 
044932,000130: 21,2171           41321                           CS       IMODES33                      	# CHECK IMU STATUS
044933,000131: 21,2172           75012                           MASK     BIT6                          	# BIT6 = 0 IMU OK
044934,000132: 21,2173           10000                           CCS      A                             	# BIT6 = 1 NO IMU
044935,000133: 21,2174           12210                           TCF      RATEFILT                      	#
044936,000134: 21,2175           41501        FREECHK            CS       RCSFLAGS                      	# BIT14 INDICATES THAT RATES HAVE NOT BEEN
044937,000135: 21,2176           75002                           MASK     BIT14                         	# INITIALIZED
044938,000136: 21,2177           27501                           ADS      RCSFLAGS                      	#
044939,000137: 21,2200           35002                           CAF      BIT14                         	# NO ATTITUDE REFERENCE
044940,000138: 21,2201           55332                           TS       HOLDFLAG                      	# STOP ANY AUTOMATIC STEERING AND PREPARE
044941,000139:                                                                                          	# TO PICK UP CDU ANGLES UPON RESUMPTION OF
044942,000140:                                                                                          	# ATTITUDE HOLD
044943,000141: 21,2202           00006                           EXTEND                                 	#
044944,000142: 21,2203           02031                           RAND     CHAN31                        	# CHECK FOR FREE MODE
044945,000143: 21,2204           00006                           EXTEND                                 	#
044946,000144: 21,2205           12417                           BZF      KRESUME1                      	# IN FREE MODE PROVIDE FREE CONTROL ONLY
044947,000145: 21,2206           12534                           TCF      REINIT                        	# .....TILT...............................
044948,000146: 21,2207           00030        BITS4,5            OCT      30                            	#
044949,000147: 
044950,000148: 21,2210           31501        RATEFILT           CA       RCSFLAGS                      	# SEE IF RATEFILTER HAS BEEN INITIALIZED
044951,000149: 21,2211           75002                           MASK     BIT14                         	#
044952,000150: 21,2212           00006                           EXTEND                                 	# IF SO, PROCEED WITH RATE DERIVATION
044953,000151: 21,2213           12215                           BZF      +2                            	#
044954,000152: 21,2214           12350                           TCF      KMATRIX                       	# IF NOT, SKIP RATE DERIVATION
044955,000153: 
044956,000154:                                                                                          	#       RATE FILTER     TIMING = 7.72 MS
044957,000155: 
044958,000156:                                                                                          	# RATE FILTER EQUATIONS
044959,000157: 
044960,000158: 
044961,000159:                                                                                          	# DRHO = DELRHO - (.1)ADOT + (1 - GAIN1)DRHO
044962,000160:                                                                                          	#                                           -1
044963,000161: 
044964,000162:                                                                                          	# ADOT = ADOT   + GAIN2 DRHO + KMJ DFT
044965,000163:                                                                                          	#            -1
044966,000164:                                                                                          	#        -       *     -     -
044967,000165:                                                                                          	# WHERE DELRHO = AMGB (CDU - CDU  )
044968,000166:                                                                                          	#                               -1
044969,000167: 
044970,000168: 21,2215           35016                           CAF      TWO                           	#
044971,000169: 21,2216           55506        DRHOLOOP           TS       SPNDX                         	#

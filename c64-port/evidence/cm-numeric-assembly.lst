066004,000246:                                                                                          	# THE SUBROUTINE SIGNMPAC SETS C(MPAC, MPAC +1) TO SIGN(MPAC).
066005,000247:                                                                                          	# FOR THIS, ONLY THE CONTENTS OF MPAC ARE EXAMINED.  ALSO +0 YIELDS POSMAX AND -0 YIELDS NEGMAX.
066006,000248: 
066007,000249:                                                                                          	# ENTRY MAY BE BY EITHER OF THE FOLLOWING:
066008,000250:                                                                                          	#       1.      LIMIT THE SIZE OF MPAC ON INTERPRETIVE OVERFLOW:
066009,000251:                                                                                          	#               ENTRY:          BOVB
066010,000252:                                                                                          	#                                       SIGNMPAC
066011,000253:                                                                                          	#       2.      GENERATE IN MPAC THE SIGNUM FUNCTION OF MPAC:
066012,000254:                                                                                          	#               ENTRY:          RTB
066013,000255:                                                                                          	#                                       SIGNMPAC
066014,000256:                                                                                          	# IN EITHER CASE, RETURN IS TO THE NEXT INTERPRETIVE INSTRUCTION IN THE CALLING SEQUENCE.
066015,000257: 
066016,000258: 22,3712           00006        SIGNMPAC           EXTEND                                 	#
066017,000259: 22,3713           34777                           DCA      DPOSMAX                       	#
066018,000260: 22,3714           52155                           DXCH     MPAC                          	#
066019,000261: 22,3715           10000                           CCS      A                             	#
066020,000262: 22,3716           35021        DPMODE             CAF      ZERO                          	# SETS MPAC +2 TO ZERO IN THE PROCESS
066021,000263: 22,3717           16026                           TCF      SLOAD2     +2                 	#
066022,000264: 22,3720           13721                           TCF      +1                            	#
066023,000265: 22,3721           00006                           EXTEND                                 	#
066024,000266: 22,3722           44777                           DCS      DPOSMAX                       	#
066025,000267: 22,3723           16024                           TCF      SLOAD2                        	#
066026,000268: 
066027,000269:                                                                                          	# RTB OP CODE NORMUNIT IS LIKE INTERPRETIVE INSTRUCTION UNIT, EXCEPT THAT IT CAN BE DEPENDED ON NOT TO BLOW
066028,000270:                                                                                          	# UP WHEN THE VECTOR BEING UNITIZED IS VERY SMALL -- IT WILL BLOW UP WHEN ALL COMPONENTS ARE ZERO.  IF NORMUNIT
066029,000271:                                                                                          	# IS USED AND THE UPPER ORDER HALVES OF ALL COMPONENTS ARE ZERO, THE MAGNITUDE RETURNED IN 36D WILL BE TOO LARGE
066030,000272:                                                                                          	# BY A FACTOR OF 2(13) AND THE SQUARED MAGNITUDE RETURNED AT 34D WILL BE TOO BIG BY A FACTOR OF 2(26).
066031,000273: 

021815,001555:                                                                                          	# PROGRAM DESCRIPTION
021816,001556: 
021817,001557:                                                                                          	# SUBROUTINE NAME       R36     OUT-OF-PLANE RENDEZVOUS ROUTINE
021818,001558:                                                                                          	# MOD NO. 2             DATE 2 JANUARY 1969
021819,001559:                                                                                          	# MOD BY A.W.BANCROFT   LOG SECTION EXTENDED VERBS
021820,001560: 
021821,001561:                                                                                          	# FUNCTIONAL DESCRIPTION
021822,001562: 
021823,001563:                                                                                          	# TO DISPLAY AT ASTRONAUT REQUEST LGC CALCULATED RENDEZVOUS
021824,001564:                                                                                          	# OUT-OF-PLANE PARAMETERS (Y, YDOT, PSI).  (REQUESTED BY DSKY).
021825,001565: 
021826,001566:                                                                                          	# CALLING SEQUENCE
021827,001567:                                                                                          	#       ASTRONAUT REQUEST THROUGH DSKY V 90 E
021828,001568: 
021829,001569:                                                                                          	# SUBROUTINES CALLED
021830,001570:                                                                                          	#       EXDSPRET
021831,001571:                                                                                          	#       GOMARKF
021832,001572:                                                                                          	#       CSMPREC
021833,001573:                                                                                          	#       LEMPREC
021834,001574:                                                                                          	#       SGNAGREE
021835,001575:                                                                                          	#       LOADTIME
021836,001576: 
021837,001577:                                                                                          	# NORMAL EXIT MODES
021838,001578:                                                                                          	#       ASTRONAUT REQUEST THROUGH DSKY TO TERMINATE PROGRAM V 34 E
021839,001579: 
021840,001580:                                                                                          	# ALARM OR ABORT EXIT MODES
021841,001581:                                                                                          	#       NONE
021842,001582: 
021843,001583:                                                                                          	# OUTPUT
021844,001584:                                                                                          	#       DECIMAL DISPLAY OF TIME, Y, YDOT AND PSI
021845,001585: 
021846,001586:                                                                                          	#       DISPLAYED VALUES Y, YDOT, AND PSI, ARE STORED IN ERASABLE
021847,001587:                                                                                          	#       REGISTERS RANGE, RRATE AND RTHETA RESPECTIVELY.
021848,001588: 
021849,001589:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
021850,001590:                                                                                          	#       CSM AND LEM STATE VECTORS

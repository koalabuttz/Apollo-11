061716,000091: 01,3563           54704                           TS       GOLOC      -1                 	#
061717,000092: 
061718,000093: 01,3564           50155                           NDX      TEMP2G                        	# DIRECTLY STORED
061719,000094: 01,3565           31054                           CA       PHSPRDT1                      	#
061720,000095: 01,3566           10000        TIMETEST           CCS      A                             	# IS IT AN IMMEDIATE RESTART
061721,000096: 01,3567           24000                           INCR     A                             	# NO.
061722,000097: 01,3570           13573                           TCF      FINDTIME                      	# FIND OUT WHEN IT SHOULD BEGIN
061723,000098: 
061724,000099: 01,3571           15500                           TCF      ITSINDIR                      	# STORED INDIRECTLY
061725,000100: 

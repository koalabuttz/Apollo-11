052140,002887: 
052141,002888:                                                                                          	# Page 1194
052142,002889:                                                                                          	# SUBROUTINE TO CONVERT AN ERASABLE ADDRESS (11 BITS) TO AN EBANK SETTING AND SUBADDRESS.
052143,002890: 
052144,002891: 01,2454           40117        15ADRERS           CS       POLISH                        	#
052145,002892: 01,2455           65034                           AD       DEC45                         	#
052146,002893: 01,2456           10000                           CCS      A                             	# DOES THE ADDRESS POINT TO THE WORK AREA?
052147,002894: 01,2457           30120                           CA       FIXLOC                        	# YES.  ADD FIXLOC.  EBANK OK AS IS.
052148,002895: 01,2460           12465                           TCF      +5                            	#
052149,002896: 
052150,002897: 01,2461           35051                           CA       OCT1400                       	# NO. SET EBANK & MAKE UP SUBADDRESS.
052151,002898: 01,2462           56117                           XCH      POLISH                        	#
052152,002899: 01,2463           54003                           TS       EBANK                         	#
052153,002900: 01,2464           74373                           MASK     LOW8                          	#
052154,002901: 01,2465           26117                 +5        ADS      POLISH                        	# FALL INTO TAGSUB, AND RETURN VIA Q.
052155,002902: 
052156,002903:                                                                                          	# SUBROUTINE WHICH SETS THE ADDRESS OF THE SPECIFIED INDEX IN INDEXLOC.  (ACTUALLY, THE ADDRESS -38D.)
052157,002904: 
052158,002905: 01,2466           30120        TAGSUB             CA       FIXLOC                        	#
052159,002906: 01,2467           54130                           TS       INDEXLOC                      	#
052160,002907: 
052161,002908: 01,2470           10020                           CCS      CYR                           	# BIT 15 SPECIFIES INDEX.
052162,002909: 01,2471           24130                           INCR     INDEXLOC                      	# 0 MEANS USE X2.
052163,002910: 01,2472           00002                           TC       Q                             	#
052164,002911: 01,2473           00002                           TC       Q                             	# 1 FOR X1.
052165,002912: 
052166,002913:                                                                                          	# Page 1195
052167,002914:                                                                                          	# MISCELLANEOUS OPERATION CODES WITH DIRECT ADDRESSES.  INCLUDED HERE ARE:
052168,002915:                                                                                          	#       1.      ITA     STORE CPRET (RETURN ADDRESS) IN ERASABLE.
052169,002916:                                                                                          	#       2.      CALL    CALL A SUBROUTINE, LEAVING RETURN IN QPRET.
052170,002917:                                                                                          	#       3.      RTB     RETURN TO BASIC LANGUAGE AT THE GIVEN ADDRESS.
052171,002918:                                                                                          	#       4.      BHIZ    BRANCH IF THE HIGHORDER OF MPAC IS ZERO (SINGLE PRECISION).
052172,002919:                                                                                          	#       5.      BOV     BRANCH ON OVERFLOW.
052173,002920:                                                                                          	#       6.      GOTO    SIMPLE SEQUENCE CHANGE.
052174,002921: 
052175,002922: 01,2474           10020        RTB/BHIZ           CCS      CYR                           	#
052176,002923: 01,2475           30117        RTB                CA       POLISH                        	#
052177,002924: 01,2476           04665                           TC       SWCALL     -1                 	# SO A "TC Q" FROM ROUTINE LEADS TO DANZIG
052178,002925: 
052179,002926: 01,2477           10154        BHIZ               CCS      MPAC                          	#
052180,002927: 01,2500           16030                           TCF      DANZIG                        	#
052181,002928: 01,2501           16615                           TCF      GOTO                          	#
052182,002929: 01,2502           16030                           TCF      DANZIG                        	#
052183,002930: 01,2503           16615                           TCF      GOTO                          	#
052184,002931: 
052185,002932: 01,2504           10121        BOV(B)             CCS      OVFIND                        	# BRANCH ON OVERFLOW TO BASIC OR INTERP.
052186,002933: 01,2505           12507                           TCF      +2                            	#
052187,002934: 01,2506           16030                           TCF      DANZIG                        	#
052188,002935: 01,2507           54121                           TS       OVFIND                        	#
052189,002936: 01,2510           10020                           CCS      CYR                           	#
052190,002937: 01,2511           12475                           TCF      RTB                           	# IF BASIC.
052191,002938: 01,2512           00360        B5TOBB             OCT      360                           	#
052192,002939: 01,2513           16615                           TCF      GOTO                          	#
052193,002940: 
052194,002941:                                                                                          	# Page 1196
052195,002942: 01,2514           10020        BZE/GOTO           CCS      CYR                           	# SEE WHICH OP-CODE IS DESIRED.
052196,002943: 01,2515           06672                           TC       BRANCH                        	# DO BZE.

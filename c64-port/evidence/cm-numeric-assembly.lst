041842,000035:                                                                                          	## Notations on the hardcopy document read, in part:
041843,000036:                                                                                          	##
041844,000037:                                                                                          	##    Assemble revision 055 of AGC program Comanche by NASA
041845,000038:                                                                                          	##    2021113-051.  10:28 APR. 1, 1969 
041846,000039:                                                                                          	##
041847,000040:                                                                                          	##    This AGC program shall also be referred to as
041848,000041:                                                                                          	##            Colossus 2A
041849,000042: 
041851,000044:                                                                                          	# NAME          TVCDAPON (TVC DAP INITIALIZATION AND STARTUP CALL)
041852,000045:                                                                                          	# LOG SECTION...TVCINITIALIZE                   SUBROUTINE...DAPCSM
041853,000046:                                                                                          	# MODIFIED BY SCHLUNDT                          21 OCTOBER 1968
041854,000047:                                                                                          	# FUNCTIONAL DESCRIPTION
041855,000048:                                                                                          	#       PERFORMS TVCDAP INITIALIZATION (GAINS, TIMING PARAMETERS, FILTER VARIABLES, ETC.)
041856,000049:                                                                                          	#       COMPUTES STEERING (S40.8) GAIN KPRIMEDT, AND ZEROES PASTDELV,+1 VARIABLE
041857,000050:                                                                                          	#       MAKES INITIALIZATION CALL TO ..NEEDLER.. FOR TVC DAP NEEDLES-SETUP
041858,000051:                                                                                          	#       PERFORMS INITIALIZATION FOR ROLL DAP
041859,000052:                                                                                          	#       CALLS TVCEXECUTIVE AT TVCEXEC, VIA WAITLIST
041860,000053:                                                                                          	#       CALLS TVCDAP CDU-RATE INITIALIZATION PKG AT DAPINIT  VIA T5
041861,000054:                                                                                          	#       PROVIDES FOR LOADING OF LOW-BANDWIDTH COEFFS AND GAINS AT SWICHOVR
041862,000055:                                                                                          	# CALLING SEQUENCE - T5LOC=2CADR(TVCDAPON,EBANK=BZERO), T5=.6SECT5
041863,000056:                                                                                          	#       IN PARTICULAR, CALLED BY ..DOTVCON.. IN P40
041864,000057:                                                                                          	#       MRCLEAN AND TVCINIT4 ARE POSSIBLE RESTART ENTRY POINTS
041865,000058:                                                                                          	# NORMAL EXIT MODE
041866,000059:                                                                                          	#       TCF RESUME
041867,000060:                                                                                          	# SUBROUTINES CALLED
041868,000061:                                                                                          	#       NEEDLER, MASSPROP
041869,000062:                                                                                          	# ALARM OR ABORT EXIT MODES
041870,000063:                                                                                          	#       NONE
041871,000064:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
041872,000065:                                                                                          	#       CSMMASS, LEMMASS, DAPDATR1 (FOR MASSPROP SUBROUTINE)
041873,000066:                                                                                          	#       TVC PAD LOADS (SEE EBANK6 IN ERASABLE ASSIGNMENTS)
041874,000067:                                                                                          	#       PACTOFF, YACTOFF, CDUX
041875,000068:                                                                                          	#       TVCPHASE AND THE T5 BITS OF FLAGWRD6 (SET AT DOTVCON IN P40)
041876,000069:                                                                                          	# OUTPUT
041877,000070:                                                                                          	#       ALL TVC AND ROLL DAP ERASABLES, FLAGWRD6 (BITS 13,14), T5, WAITLIST
041878,000071:                                                                                          	# DEBRIS
041879,000072:                                                                                          	#       NONE
041880,000073: 
041881,000074: 42,3772                                           COUNT*   $$/INIT                       	#
041882,000075: 17,2147                                           BANK     17                            	#
041883,000076: 17,2000                                           SETLOC   DAPS7                         	#
041884,000077: 17,2000                                           BANK                                   	#
041885,000078: 
041886,000079: 17,2147  E6,1702                                  EBANK=   BZERO                         	#
041887,000080: 
041888,000081: 17,2147           22016        TVCDAPON           LXCH     BANKRUPT                      	# T5 RUPT ARRIVAL (CALL BY DOTVCON - P40)
041889,000082: 17,2150           00006                           EXTEND                                 	# SAVE Q REQUIRED IN RESTARTS (MRCLEAN AND
041890,000083: 17,2151           22012                           QXCH     QRUPT                         	#       TVCINIT4 ARE ENTRIES)
041891,000084: 17,2152           32534        MRCLEAN            CAF      NZERO                         	# NUMBER TO ZERO, LESS ONE  (MUST BE ODD)
041892,000085:                                                                                          	#       TVC RESTARTS ENTER HERE  (NEW BANK)
041893,000086: 17,2153           10000                 +1        CCS      A                             	#
041894,000087: 17,2154           55447                           TS       CNTR                          	#
041895,000088: 17,2155           35021                           CAF      ZERO                          	#
041896,000089: 17,2156           54001                           TS       L                             	#
041897,000090: 17,2157           51447                           INDEX    CNTR                          	#
041898,000091: 17,2160           53530                           DXCH     OMEGAYC                       	# FIRST (LAST) TWO LOCATIONS
041899,000092: 17,2161           11447                           CCS      CNTR                          	#
041900,000093: 17,2162           12153                           TCF      MRCLEAN    +1                 	#
041902,000095: 17,2163           00006                           EXTEND                                 	# SET UP ANOTHER T5 RUPT TO CONTINUE
041903,000096: 17,2164           32551                           DCA      INITLOC2                      	#       INITIALIZATION AT TVCINIT1
041904,000097: 17,2165           53313                           DXCH     T5LOC                         	# THE PHSCHK2 ENTRY (REDOTVC) AT TVCDAPON
041905,000098: 17,2166           34777                           CAF      POSMAX                        	#       +3 IS IN ANOTHER BANK.  MUST RESET
041906,000099: 17,2167           54030                           TS       TIME5                         	#       BBCON TOO (FULL 2CADR), FOR THAT

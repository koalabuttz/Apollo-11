052013,002760: 00,3656           13240 23630                     2DEC     +.353553385                    	# COEFFICIENTS ARE C 2(+I)/PISQRT(2) WHERE
052014,002761: 00,3660           74721 47775                     2DEC*    -.0483017006 B+1*               	# I
052015,002762: 00,3662           02440 20237                     2DEC*    +.0200273085 B+2*               	# WEHRE C STANDS FOR ORIGINAL COEFFS.
052016,002763: 00,3664           75067 70742                     2DEC*    -.0112931863 B+3*               	#

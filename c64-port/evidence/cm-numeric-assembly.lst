033287,000404:                                                                                          	# NAME-         AUTOMATIC OPTICS POSITIONING ROUTINE
033288,000405: 
033289,000406:                                                                                          	# FUNCTION-     (1) TO POINT THE STAR LOS OF THE OPTICS AT A STAR OR LANDMARK DEFINED BY THE PROGRAM OR BY DSKY INPUT.
033290,000407:                                                                                          	#               (2) TO POINT THE STAR LOS OF THE OPTICS AT THE LEM DURING RENDEZVOUS TRACKING OPERATIONS.
033291,000408: 
033292,000409:                                                                                          	# CALLING SEQUENCE- CALL R52
033293,000410: 
033294,000411:                                                                                          	# INPUT-        1.  TARG1FLG AND TARG2FLG- PRESET BY CALLER
033295,000412:                                                                                          	#               2.  RNDVZFLG AND TRACKFLG- PRESET BY CALLER
033296,000413:                                                                                          	#               3.  STAR CODE- PRESET BY CALLER. ALSO INPUT THROUGH DSKY
033297,000414:                                                                                          	#               4.  LAT, LONG AND ALT OF LANDMARK- INPUT THROUGH DSKY
033299,000416:                                                                                          	#               5.  NO. OF MARKS (MARKINDX)- PRESET BY CALLER
033300,000417: 
033301,000418:                                                                                          	# OUTPUT-       DRIVE SHAFT AND TRUNNION CDUS
033302,000419: 

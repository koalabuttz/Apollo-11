054467,000335:                                                                                          	# SUBROUTINE TO COMPUTE L VECTOR FOR EARTH
054468,000336: 
054469,000337:                                                                                          	# CALLING SEQUENCE
054470,000338:                                                                                          	#       L       CALL
054471,000339:                                                                                          	#       L+1             EARTHL
054472,000340: 
054473,000341:                                                                                          	# INPUT
054474,000342:                                                                                          	#       AXO,AYO SET AT LAUNCH TIME WITH AYO IMMEDIATELY FOLLOWING AXO IN CORE
054475,000343: 
054476,000344:                                                                                          	# OUTPUT
054477,000345:                                                                                          	#               -AX
054478,000346:                                                                                          	#       MPAC=   -AY     RADIANS B-0
054479,000347:                                                                                          	#                 0

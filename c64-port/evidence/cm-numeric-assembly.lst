049085,000021: 
049086,000022:                                                                                          	## The contents of the "Comanche055" files, in general, are transcribed 
049087,000023:                                                                                          	## from scanned documents. 
049088,000024:                                                                                          	##
049089,000025:                                                                                          	##       Assemble revision 055 of AGC program Comanche by NASA
049090,000026:                                                                                          	##       2021113-051.  April 1, 1969.  
049091,000027:                                                                                          	##
049092,000028:                                                                                          	##       This AGC program shall also be referred to as Colossus 2A
049093,000029:                                                                                          	##
049094,000030:                                                                                          	##       Prepared by
049095,000031:                                                                                          	##                       Massachusetts Institute of Technology
049096,000032:                                                                                          	##                       75 Cambridge Parkway
049097,000033:                                                                                          	##                       Cambridge, Massachusetts
049098,000034:                                                                                          	##
049099,000035:                                                                                          	##       under NASA contract NAS 9-4065.
049100,000036:                                                                                          	##
049101,000037:                                                                                          	## Refer directly to the online document mentioned above for further
049102,000038:                                                                                          	## information.  Please report any errors to info@sandroid.org.
049103,000039: 
049105,000041:                                                                                          	# THE FOLLOWING ROUTINE CAN BE USED TO CALL A SUBROUTINE IN ANOTHER BANK. IN THE BANKCALL VERSION, THE
049106,000042:                                                                                          	# CADR OF THE SUBROUTINE IMMEDIATELY FOLLOWS THE TC BANKCALL INSTRUCTION, WITH C(A) AND C(L) PRESERVED.
049107,000043: 
049108,000044:    4662                                           BLOCK    02                            	#
049109,000045:    4662                                           COUNT    02/BANK                       	#
049110,000046: 
049111,000047:    4662           52134        BANKCALL           DXCH     BUF2                          	# SAVE INCOMING A,L.
049112,000048:    4663           50002                           INDEX    Q                             	# PICK UP CADR.
049113,000049:    4664           30000                           CA       0                             	#
049114,000050:    4665           24002                           INCR     Q                             	# SO WE RETURN TO THE LOC. AFTER THE CADR.
049115,000051: 
049116,000052:                                                                                          	# SWCALL IS  IDENTICAL TO BANKCALL, EXCEPT THAT THE CADR ARRIVES IN A.
049117,000053: 
049118,000054:    4666           54001        SWCALL             TS       L                             	#
049119,000055:    4667           22004                           LXCH     FBANK                         	# SWITCH BANKS, SAVING RETURN.
049120,000056:    4670           75054                           MASK     LOW10                         	# GET SUB-ADDRESS OF CADR.
049121,000057:    4671           56002                           XCH      Q                             	# A,L NOW CONTAINS DP RETURN.
049122,000058:    4672           52134                           DXCH     BUF2                          	# RESTORING INPUTS IF THIS IS A BANKCALL.
049123,000059:    4673           50002                           INDEX    Q                             	#
049124,000060:    4674           02000                           TC       10000                         	# SETTING Q TO SWRETURN.
049125,000061: 
049126,000062:    4675           56134        SWRETURN           XCH      BUF2       +1                 	# COMES HERE TO RETURN TO CALLER. C(A,L)
049127,000063:    4676           56004                           XCH      FBANK                         	# ARE PRESERVED FOR RETURN.
049128,000064:    4677           56134                           XCH      BUF2       +1                 	#
049129,000065:    4700           00133                           TC       BUF2                          	#
049130,000066: 
049131,000067:                                                                                          	# THE FOLLOWING ROUTINE CAN BE USED AS A UNILATERAL JUMP WITH C(A,L) PRESERVED AND THE CADR IMMEDIATELY
049132,000068:                                                                                          	# FOLLOWING THE TC POSTJUMP INSTRUCTION.
049133,000069: 
049134,000070:    4701           56002        POSTJUMP           XCH      Q                             	# SAVE INCOMING C(A).
049135,000071:    4702           50000                           INDEX    A                             	# GET CADR.
049136,000072:    4703           30000                           CA       0                             	#
049137,000073: 
049138,000074:                                                                                          	# BANKJUMP IS THE SAME AS POSTJUMP, EXCEPT THAT THE CADR ARRIVES IN A.
049139,000075: 
049140,000076:    4704           54004        BANKJUMP           TS       FBANK                         	#
049141,000077:    4705           75054                           MASK     LOW10                         	#
049142,000078:    4706           56002                           XCH      Q                             	# RESTORING INPUT C(A) IF THIS WAS A
049143,000079:    4707           50002        Q+10000            INDEX    Q                             	# POSTJUMP.
049144,000080:    4710           12000        PRIO12             TCF      10000                         	# PRIO12 = TCF  10000 = 12000
049145,000081: 
049147,000083:                                                                                          	# THE FOLLOWING ROUTINE GETS THE RETURN CADR SAVED BY SWCALL OR BANKCALL AND LEAVES IT IN A.
049148,000084: 
049149,000085:    4711           35054        MAKECADR           CAF      LOW10                         	#
049150,000086:    4712           70133                           MASK     BUF2                          	#
049151,000087:    4713           60134                           AD       BUF2       +1                 	#
049152,000088:    4714           00002                           TC       Q                             	#
049153,000089: 
049154,000090:    4715           54135        SUPDACAL           TS       MPTEMP                        	#
049155,000091:    4716           56004                           XCH      FBANK                         	# SET FBANK FOR DATA.
049156,000092:    4717           00006                           EXTEND                                 	#
049157,000093:    4720           04007                           ROR      SUPERBNK                      	# SAVE FBANK IN BITS 15-11, AND
049158,000094:    4721           56135                           XCH      MPTEMP                        	# SUPERBANK IN BITS 7-5.
049159,000095:    4722           75054                           MASK     LOW10                         	#
049160,000096:    4723           56001                           XCH      L                             	# SAVE REL. ADR. IN BANK, FETCH SUPERBITS.
049161,000097:    4724           00004                           INHINT                                 	# BECAUSE RUPT DOES NOT SAVE SUPERBANK.
049162,000098:    4725           00006                           EXTEND                                 	#
049163,000099:    4726           01007                           WRITE    SUPERBNK                      	# SET SUPERBANK FOR DATA.
049164,000100:    4727           50001                           INDEX    L                             	#
049165,000101:    4730           32000                           CA       10000                         	# PINBALL (FIX MEM DISP) PREVENTS DCA HERE
049166,000102:    4731           56135                           XCH      MPTEMP                        	# SAVE 1ST WD, FETCH OLD FBANK AND SBANK.
049167,000103:    4732           00006                           EXTEND                                 	#
049168,000104:    4733           01007                           WRITE    SUPERBNK                      	# RESTORE SUPERBANK.
049169,000105:    4734           00003                           RELINT                                 	#
049170,000106:    4735           54004                           TS       FBANK                         	# RESTORE FBANK.
049171,000107:    4736           30135                           CA       MPTEMP                        	# RECOVER FIRST WORD OF DATA.
049172,000108:    4737           00002                           RETURN                                 	# 24 WDS. DATACALL 516 MU, SUPDACAL 432 MU
049173,000109: 
049175,000111:                                                                                          	# THE FOLLOWING ROUTINES ARE IDENTICAL TO BANKCALL AND SWCALL EXCEPT THAT THEY ARE USED IN INTERRUPT.
049176,000112: 
049177,000113:    4740           52073        IBNKCALL           DXCH     RUPTREG3                      	# USES RUPTREG3,4 FOR DP RETURN ADDRESS.
049178,000114:    4741           50002                           INDEX    Q                             	#
049179,000115:    4742           30000                           CAF      0                             	#
049180,000116:    4743           24002                           INCR     Q                             	#
049181,000117: 
049182,000118:    4744           54001        ISWCALL            TS       L                             	#
049183,000119:    4745           22004                           LXCH     FBANK                         	#
049184,000120:    4746           75054                           MASK     LOW10                         	#
049185,000121:    4747           56002                           XCH      Q                             	#
049186,000122:    4750           52073                           DXCH     RUPTREG3                      	#
049187,000123:    4751           50002                           INDEX    Q                             	#
049188,000124:    4752           02000                           TC       10000                         	#
049189,000125: 
049190,000126:    4753           56073        ISWRETRN           XCH      RUPTREG4                      	#
049191,000127:    4754           56004                           XCH      FBANK                         	#
049192,000128:    4755           56073                           XCH      RUPTREG4                      	#
049193,000129:    4756           00072                           TC       RUPTREG3                      	#
049194,000130: 
049195,000131:                                                                                          	# 2. USPRCADR ACCESSES INTERPRETIVE CODING IN OTHER THAN THE USER'S FBANK.  THE CALLING SEQUENCE IS AS FOLLOWS:
049196,000132:                                                                                          	#       L       TC      USPRCADR
049197,000133:                                                                                          	#       L+1     CADR    INTPRETX        INTPRETX IS THE INTERPRETIVE CODING
049198,000134:                                                                                          	#                                       RETURN IS TO L+2
049199,000135: 
049200,000136:    4757           54164        USPRCADR           TS       LOC                           	# SAVE A
049201,000137:    4760           35010                           CA       BIT8                          	#
049202,000138:    4761           54023                           TS       EDOP                          	# EXIT INSTRUCTION TO EDOP
049203,000139:    4762           30006                           CA       BBANK                         	#
049204,000140:    4763           54165                           TS       BANKSET                       	# USER'S BBANK TO BANKSET
049205,000141:    4764           50002                           INDEX    Q                             	#
049206,000142:    4765           30000                           CA       0                             	#
049207,000143:    4766           54004                           TS       FBANK                         	# INTERPRETIVE BANK TO FBANK
049208,000144:    4767           75054                           MASK     LOW10                         	# YIELDS INTERPRETIVE RELATIVE ADDRESS
049209,000145:    4770           56002                           XCH      Q                             	# INTERPRETIVE ADDRESS TO Q, FETCHING L+1
049210,000146:    4771           56164                           XCH      LOC                           	# L+1 TO LOC, RETRIEVING ORIGINAL A
049211,000147:    4772           14707                           TCF      Q+10000                       	#
049212,000148: 
049214,000150:                                                                                          	# THERE ARE FOUR POSSIBLE SETTINGS FOR CHANNEL 07.  (CHANNEL 07 CONTAINS THE SUPERBANK SETTING.)
049215,000151: 
049216,000152:                                                                                          	#                                       PSEUDO-FIXED     OCTAL PSEUDO
049217,000153:                                                                                          	# SUPERBANK     SETTING S-REG. VALUE    BANK NUMBERS     ADDRESSES
049218,000154:                                                                                          	# ----------    ------- ------------     ------------     ------------
049219,000155:                                                                                          	# SUPERBANK 3     0XX    2000 - 3777       30 - 37       70000 - 107777         (WHERE XX CAN BE ANYTHING AND
049220,000156:                                                                                          	#                                                                               WILL USUALLY BE SEEN AS 11)
049221,000157:                                                                                          	# SUPERBANK 4     100    2000 - 3777       40 - 47      110000 - 127777         (AS FAR AS IT CAN BE SEEN,
049222,000158:                                                                                          	#                                                                               ONLY BANKS 40-43 WILL EVER BE
049223,000159:                                                                                          	#                                                                               AND ARE PRESENTLY AVAILABLE)
049224,000160:                                                                                          	# SUPERBANK 5     101    2000 - 3777       50 - 57      130000 - 147777         (PRESENTLY NOT AVAILABLE TO
049225,000161:                                                                                          	#                                                                               THE USER)
049226,000162:                                                                                          	# SUPERBANK 6     110    2000 - 3777       60 - 67      150000 - 167777         (PRESENTLY NOT AVAILABLE TO
049227,000163:                                                                                          	#                                                                               THE USER)
049228,000164:                                                                                          	# *** THIS ROUTINE MAY BE CALLED BY ANY PROGRAM LOCATED IN BANKS 00 - 27.  I.E., NO PROGRAM LIVING IN ANY
049229,000165:                                                                                          	# SUPERBANK SHOULD USE SUPERSW. ***
049230,000166: 
049231,000167:                                                                                          	# SUPERSW MAY BE CALLED IN THIS FASHION:
049232,000168:                                                                                          	#       CAF     ABBCON          WHERE -- ABBCON  BBCON  SOMETHIN --
049233,000169:                                                                                          	#       TCR     SUPERSW         (THE SUPERBNK BITS ARE IN THE BBCON)
049234,000170:                                                                                          	#       ...       ...
049235,000171:                                                                                          	#        .         .
049236,000172:                                                                                          	#        .         .
049237,000173:                                                                                          	# OR IN THIS FASHION:
049238,000174:                                                                                          	#       CAF     SUPERSET        WHERE SUPERSET IS ONE OF THE FOUR AVAILABLE
049239,000175:                                                                                          	#       TCR     SUPERSW         SUPERBANK BIT CONSTANTS:
049240,000176:                                                                                          	#       ...       ...                   SUPER011 OCTAL  60
049241,000177:                                                                                          	#        .         .                    SUPER100 OCTAL 100
049242,000178:                                                                                          	#        .         .                    SUPER101 OCTAL 120
049243,000179:                                                                                          	#                                       SUPER110 OCTAL 140
049244,000180: 
049245,000181:    4773           00006        SUPERSW            EXTEND                                 	#
049246,000182:    4774           01007                           WRITE    SUPERBNK                      	# WRITE BITS 7-6-5 OF THE ACCUMULATOR INTO
049247,000183:                                                                                          	# CHANNEL 07
049248,000184:    4775           00002                           TC       Q                             	# TC TO INSTRUCTION FOLLOWING
049249,000185:                                                                                          	#       TC SUPERSW
049250,000186: 
049251,000187: 
049252,000188: 
(End of include-file INTER-BANK_COMMUNICATION.agc, resuming MAIN.agc)
049252,000139: 
049253,000140: $INTERPRETER.agc				        # pp. 1107-1199
049254,000001:                                                                                          	# Copyright:    Public domain.
049255,000002:                                                                                          	# Filename:     INTERPRETER.agc
049256,000003:                                                                                          	# Purpose:      Part of the source code for Colossus 2A, AKA Comanche 055.
049257,000004:                                                                                          	#               It is part of the source code for the Command Module's (CM)
049258,000005:                                                                                          	#               Apollo Guidance Computer (AGC), for Apollo 11.
049259,000006:                                                                                          	# Assembler:    yaYUL
049260,000007:                                                                                          	# Contact:      Ron Burkey <info@sandroid.org>.
049261,000008:                                                                                          	# Website:      www.ibiblio.org/apollo.
049262,000009:                                                                                          	# Pages:        1107-1199
049263,000010:                                                                                          	# Mod history:  2009-05-08 RSB  Adapted from the Luminary131/ file of the
049264,000011:                                                                                          	#                               same name, using Comanche055 page images.
049265,000012:                                                                                          	#               2009-05-20 RSB  Corrections:  P00D00 -> P00DOO, fixed a
049266,000013:                                                                                          	#                               "Page N" reference.
049267,000014:                                                                                          	#               2009-05-21 RSB  Corrected definition of 5B10, which overflowed
049268,000015:                                                                                          	#                               integer arithmetic.
049269,000016: 
049270,000017:                                                                                          	# This source code has been transcribed or otherwise adapted from digitized
049271,000018:                                                                                          	# images of a hardcopy from the MIT Museum.  The digitization was performed
049272,000019:                                                                                          	# by Paul Fjeld, and arranged for by Deborah Douglas of the Museum.  Many
049273,000020:                                                                                          	# thanks to both.  The images (with suitable reduction in storage size and
049274,000021:                                                                                          	# consequent reduction in image quality as well) are available online at
049275,000022:                                                                                          	# www.ibiblio.org/apollo.  If for some reason you find that the images are
049276,000023:                                                                                          	# illegible, contact me at info@sandroid.org about getting access to the
049277,000024:                                                                                          	# (much) higher-quality images which Paul actually created.
049278,000025: 
049279,000026:                                                                                          	# Notations on the hardcopy document read, in part:
049280,000027: 
049281,000028:                                                                                          	#       Assemble revision 055 of AGC program Comanche by NASA
049282,000029:                                                                                          	#       2021113-051.  10:28 APR. 1, 1969
049283,000030: 
049284,000031:                                                                                          	#       This AGC program shall also be referred to as
049285,000032:                                                                                          	#                       Colossus 2A
049286,000033: 
049287,000034:                                                                                          	# Page 1107
049288,000035:                                                                                          	# SECTION 1:  DISPATCHER
049289,000036: 
049290,000037:                                                                                          	# ENTRY TO THE INTERPRETER.  INTPRET SETS LOC TO THE FIRST INSTRUCTION, BANKSET TO THE BBANK OF THE
049291,000038:                                                                                          	# OBJECT INTERPRETIVE PROGRAM, AND INTBIT15 TO THE BIT15 CONTENTS OF FBANK.  INTERPRETIVE PROGRAMS MAY BE IN
049292,000039:                                                                                          	# VIRTUALLY ALL BANKS PRESENT UNDER ANY SUPER-BANK SETTING, WITH THE RESTRICTION THAT PROGRAMS IN HIGH BANKS
049293,000040:                                                                                          	# (BIT15 OF FBANK = 1) DO NOT REFER TO LOWBANKS, AND VICE-VERSA.  THE INTERPRETER DOES NOT SWITCH SUPERBANKS.
049294,000041:                                                                                          	# E-BANK SWITCHING OCCURS WHENEVER GENERAL ERASABLE (100-3777) IS ADDRESSED.
049295,000042: 
049296,000043:    6006                                           BLOCK    03                            	#
049297,000044: 
049298,000045:    6006                                           COUNT    03/INTER                      	#
049299,000046: 
049300,000047:    6006           00003        INTPRET            RELINT                                 	#
049301,000048:    6007           00006                           EXTEND                                 	# SET LOC TO THE WORD FOLLOWING THE TC.
049302,000049:    6010           22164                           QXCH     LOC                           	#
049303,000050: 
049304,000051:    6011           30006                 +2        CA       BBANK                         	# INTERPRETIVE BRANCHES FINISH HERE.
049305,000052:    6012           54165                           TS       BANKSET                       	#
049306,000053:    6013           75001                           MASK     BIT15                         	# GET 15TH BIT FOR INDEXABLE ADDRESSES.
049307,000054:    6014           54115                           TS       INTBIT15                      	#
049308,000055: 
049309,000056:    6015           54023                           TS       EDOP                          	# MAKE SURE NO INSTRUCTIONS LEFT OVER
049310,000057: 
049311,000058:    6016           16037                           TCF      NEWOPS                        	# PICK UP OP CODE PAIR AND BEGIN.
049312,000059: 
049313,000060: 
049314,000061:    6017           22006        INTRSM             LXCH     BBANK                         	# RESUME SUSPENDED INTERPRETIVE JOB
049315,000062:    6020           16011                           TCF      INTPRET    +3                 	#
049316,000063:                                                                                          	# DLOAD LOADS MPAC, MPAC +1, LEAVING ZERO IN MPAC +2.
049317,000064: 
049318,000065:    6021           00006        DLOAD              EXTEND                                 	#
049319,000066:    6022           50116                           INDEX    ADDRWD                        	#
049320,000067:    6023           30001                           DCA      0                             	# LOAD DP C(C(ADDRWD)) INTO MPAC,MPAX +1
049321,000068:    6024           52155        SLOAD2             DXCH     MPAC                          	#
049322,000069:    6025           35021                           CAF      ZERO                          	# ZERO MPAC +2
049323,000070: 
049324,000071:                                                                                          	# Page 1108
049325,000072:                                                                                          	# AT THE END OF MOST INSTRUCTIONS, CONTROL IS GIVEN TO DANZIG TO DISPATCH THE NEXT OPERATION.
049326,000073: 
049327,000074:    6026           54156                           TS       MPAC       +2                 	# AND DECLARE DP MODE
049328,000075: 
049329,000076:    6027           54163        NEWMODE            TS       MODE                          	# PROLOGUE FOR MODE-CHANGING INSTRUCTIONS.
049330,000077: 
049331,000078:    6030           30165        DANZIG             CA       BANKSET                       	# SET BBANK BEFORE TESTING NEWJOB SO THAT
049332,000079:    6031           54006                           TS       BBANK                         	# IT MAY BE SAVED DIRECTLY BY CHANJOB.
049333,000080: 
049334,000081:    6032           10023        NOIBNKSW           CCS      EDOP                          	# SEE IF AN ORDER CODE IS LEFT OVER FROM
049335,000082:    6033           16046                           TCF      OPJUMP                        	# THE LAST PAIR RETRIEVED.  IF SO, EXECUTE.
049336,000083:                                                                                          	# EDOP IS SET TO ZERO ON ITS RE-EDITING.
049337,000084: 
049338,000085:    6034           10067                           CCS      NEWJOB                        	# SEE IF A JOB OF HIGHER PRIORITY IS
049339,000086:    6035           15170                           TCF      CHANG2                        	# PRESENT, AND IF SO, CHANGE JOBS.
049340,000087: 
049341,000088:    6036           24164                           INCR     LOC                           	# ADVANCE THE LOCATION COUNTER.
049342,000089: 
049343,000090:                                                                                          	# ITRACE (1) REFERS TO "NEWOPS".
049344,000091:    6037           50164        NEWOPS             INDEX    LOC                           	# ENTRY TO BEGIN BY PICKING OP CODE PAIR.
049345,000092:    6040           30000                           CA       0                             	# MAY BE AN OPCODE PAIR OR A STORE CODE.
049346,000093:    6041           10000                           CCS      A                             	# TEST SIGN AND GET DABS(A).
049347,000094:    6042           16331                           TCF      DOSTORE                       	# PROCESS STORE CODE.
049348,000095: 
049349,000096:    6043           00177        LOW7               OCT      177                           	#
049350,000097: 
049351,000098:    6044           54023                           TS       EDOP                          	# OP CODE PAIR.  LEAVE THE OTHER IN EDOP
049352,000099:    6045           76043                           MASK     LOW7                          	# WHERE CCS EDOP WILL HONOR IT NEXT.
049353,000100: 
049354,000101:    6046           54020        OPJUMP             TS       CYR                           	# LOWWD ENTERS HERE IF A RIGHT-HAND OP
049355,000102:    6047           10020                           CCS      CYR                           	# CODE IS TO BE PROCESSED.  TEST PREFICES.
049356,000103:    6050           16216                           TCF      OPJUMP2                       	# TEST SECOND PREFIX BIT.
049357,000104: 
049358,000105:    6051           16712                           TCF      EXIT                          	# +0 OP CODE IS EXIT
049359,000106: 
049360,000107:                                                                                          	# Page 1109
049361,000108:                                                                                          	# PROCESS ADDRESSES WHICH MAY BE DIRECT, INDEXED, OR REFERENCE THE PUSHDOWN LIST.
049362,000109: 
049363,000110:    6052           75017        ADDRESS            MASK     BIT1                          	# SEE IF ADDRESS IS INDEXED.  CYR CONTAINED
049364,000111:    6053           10000                           CCS      A                             	# 400XX, SO BIT 1 IS NOW AS IT WAS IN CYR.
049365,000112:    6054           16115                           TCF      INDEX                         	# FORM INDEXED ADDRESS.
049366,000113: 
049367,000114:    6055           50164        DIRADRES           INDEX    LOC                           	# LOOK AHEAD TO NEXT WORD TO SEE IF
049368,000115:    6056           40001        OCT40001           CS       1                             	# ADDRESS IS GIVEN.
049369,000116:    6057           10000                           CCS      A                             	#
049370,000117:    6060           16164                           TCF      PUSHUP                        	# IF NOT.
049371,000118: 
049372,000119:    6061           77773        NEG4               DEC      -4         B-14               	#
049373,000120: 
049374,000121:    6062           24164                           INCR     LOC                           	# IF SO, TO SHOW WE PICKED UP A WORD.
049375,000122:    6063           54116                           TS       ADDRWD                        	#
049376,000123: 
049377,000124:                                                                                          	# Page 1110
049378,000125:                                                                                          	# FINAL DIGESTION OF DIRECT ADDRESSES OF OP CODES WITH 01 PREFIX IS DONE HERE.  IN EACH CASE, THE
049379,000126:                                                                                          	# REQUIRED 12-BIT SUB-ADDRESS IS LEFT IN ADDRWD, WITH ANY REQUIRED E OR F BANK SWITCHING DONE.  ADDRESSES LESS
049380,000127:                                                                                          	# THAN 45D ARE TAKEN TO BE RELATIVE TO THE WORK AREA.  THE OP CODE IS NOW IN BITS 1-5 OF CYR WITH BIT 14 = 1.
049381,000128: 
049382,000129:    6064           66220                           AD       -ENDVAC                       	# SEE IF ADDRESS RELATIVE TO WORK AREA.
049383,000130:    6065           10000                           CCS      A                             	#
049384,000131:    6066           67712                           AD       -ENDERAS                      	# IF NOT, SEE IF IN GENERAL ERASABLE.
049385,000132:    6067           16074                           TCF      IERASTST                      	#
049386,000133: 
049387,000134:    6070           30120        NETZERO            CA       FIXLOC                        	# IF SO, LEAVE THE MODIFIED ADDRESS IN
049388,000135:    6071           26116                           ADS      ADDRWD                        	# ADDRWD AND DISPATCH.
049389,000136:    6072           50020        ITR15              INDEX    CYR                           	# THIS INDEX MAKES THE NEXT INSTRUCTION
049390,000137:    6073           76242                           7        INDJUMP    -1                 	# TCF INDJUMP + OP, EDITING CYR.
049391,000138: 
049392,000139:    6074           00006        IERASTST           EXTEND                                 	#
049393,000140:    6075           66105                           BZMF     GEADDR                        	# GO PROCESS GENERAL-ERASABLE ADDRESS.
049394,000141: 
049395,000142:    6076           75054                           MASK     LOW10                         	# FIXED BANK ADDRESS. RESTORE AND ADD B15.
049396,000143:    6077           65054                           AD       LOW10                         	# SWITCH BANKS AND LEAVE SUBADDRESS IN
049397,000144:    6100           56116                           XCH      ADDRWD                        	# ADDRWD FOR OPERAND RETRIEVAL. (THIS
049398,000145:    6101           60115                           AD       INTBIT15                      	# METHOD PRECLUDES USE OF THE LAST
049399,000146:    6102           54004                           TS       FBANK                         	# LOCATION IN EACH FBANK.)
049400,000147:    6103           50020        ITR12              INDEX    CYR                           	#
049401,000148:    6104           76242                           7        INDJUMP    -1                 	#
049402,000149: 
049403,000150:    6105           74373        GEADDR             MASK     LOW8                          	#
049404,000151:    6106           65051                           AD       OCT1400                       	#
049405,000152:    6107           56116                           XCH      ADDRWD                        	#
049406,000153:    6110           54003                           TS       EBANK                         	#
049407,000154:    6111           50020        ITR10              INDEX    CYR                           	#
049408,000155:    6112           76242                           7        INDJUMP    -1                 	#
049409,000156: 
049410,000157:                                                                                          	# Page 1111
049411,000158:                                                                                          	# THE FOLLOWING ROUTINE PROCESSES INTERPRETIVE INDEXED ADDRESSES.  AN INTERPRETER INDEX REGISTER MAY
049412,000159:                                                                                          	# CONTAIN THE ADDRESS OF ANY ERASABLE REGISTER (0-42 BEING RELATIVE TO THE VAC AREA) OR ANY INTERPRETIVE PROGRAM
049413,000160:                                                                                          	# BANK, OR ANY INTEGER IN THAT RANGE.
049414,000161: 
049415,000162:    6113           37702        DODLOAD*           CAF      DLOAD*                        	# STODL* COMES HERE TO PROCESS LOAD ADR.
049416,000163:    6114           54020                           TS       CYR                           	# (STOVL* ENTERS HERE).
049417,000164: 
049418,000165:    6115           30120        INDEX              CA       FIXLOC                        	# SET UP INDEX LOCATION.
049419,000166:    6116           54130                           TS       INDEXLOC                      	#
049420,000167:    6117           24164                           INCR     LOC                           	# (ADDRESS ALWAYS GIVEN).
049421,000168:    6120           50164                           INDEX    LOC                           	#
049422,000169:    6121           40000                           CS       0                             	#
049423,000170:    6122           10000                           CCS      A                             	# INDEX 2 IF ADDRESS STORED COMPLEMENTED.
049424,000171:    6123           24130                           INCR     INDEXLOC                      	#
049425,000172:    6124           16125                           NOOP                                   	#
049426,000173: 
049427,000174:    6125           54116                           TS       ADDRWD                        	# 14 BIT ADDRESS TO ADDRWD.
049428,000175:    6126           77711                           MASK     HIGH4                         	# IF ADDRESS GREATER THAN 2K, ADD INTBIT15
049429,000176:    6127           00006                           EXTEND                                 	#
049430,000177:    6130           16133                           BZF      INDEX2                        	#
049431,000178:    6131           30115                           CA       INTBIT15                      	#
049432,000179:    6132           26116                           ADS      ADDRWD                        	#
049433,000180: 
049434,000181:    6133           50130        INDEX2             INDEX    INDEXLOC                      	#
049435,000182:    6134           40046                           CS       X1                            	#
049436,000183:    6135           26116                           ADS      ADDRWD                        	# DO AUGMENT, IGNORING AND CORRECTING OVF.
049437,000184: 
049438,000185:    6136           77713                           MASK     HIGH9                         	# SEE IF ADDRESS IS IN WORK AREA.
049439,000186:    6137           00006                           EXTEND                                 	#
049440,000187:    6140           16153                           BZF      INDWORK                       	#
049441,000188:    6141           77711                           MASK     HIGH4                         	# SEE IF IN FIXED BANK.
049442,000189:    6142           00006                           EXTEND                                 	#
049443,000190:    6143           16155                           BZF      INDERASE                      	#
049444,000191: 
049445,000192:    6144           30116                           CA       ADDRWD                        	# IN FIXED -- SWITCH BANKS AND CREATE
049446,000193:    6145           54004                           TS       FBANK                         	# SUB-ADDRESS
049447,000194:    6146           75054                           MASK     LOW10                         	#
049448,000195:    6147           65005                           AD       2K                            	#
049449,000196:    6150           54116                           TS       ADDRWD                        	#
049450,000197:    6151           50020        ITR11              INDEX    CYR                           	#
049451,000198:    6152           36242                           3        INDJUMP    -1                 	#
049452,000199: 
049453,000200:    6153           30120        INDWORK            CA       FIXLOC                        	# MAKE ADDRWD RELATIVE TO WORK AREA.
049454,000201:    6154           16161                           TCF      ITR13      -1                 	#
049455,000202: 
049456,000203:    6155           35051        INDERASE           CA       OCT1400                       	#
049457,000204:    6156           56116                           XCH      ADDRWD                        	#
049458,000205:    6157           54003                           TS       EBANK                         	#
049459,000206:    6160           74373                           MASK     LOW8                          	#
049460,000207:    6161           26116                 -1        ADS      ADDRWD                        	#
049461,000208:                                                                                          	# Page 1112
049462,000209:    6162           50020        ITR13              INDEX    CYR                           	#
049463,000210:    6163           36242                           3        INDJUMP    -1                 	#
049464,000211: 
049465,000212:                                                                                          	# Page 1113
049466,000213:                                                                                          	# PUSH-UP ROUTINES.  WHEN NO OPERAND ADDRESS IS GIVEN, THE APPROPRIATE OPERAND IS TAKEN FROM THE PUSH-DOWN
049467,000214:                                                                                          	# LIST.  IN MOST CASES THE MODE OF THE RESULT (VECTOR OR SCALAR) OF THE LAST ARITHMETIC OPERATION PERFORMED
049468,000215:                                                                                          	# IS THE SAME AS THE TYPE OF OPERAND DESIRED (ALL ADD/SUBTRACT ETC.).  EXCEPTIONS TO THIS GENERAL RULE ARE LISTED
049469,000216:                                                                                          	# BELOW (NOTE THAT IN EVERY CASE THE MODE REGISTER IS LEFT INTACT):
049470,000217: 
049471,000218:                                                                                          	#       1.      VXSC AND V/SC WANT THE OPPOSITE TYPE OF OPERAND, E.G., IF THE LAST OPERATION YIELDED A VECTOR
049472,000219:                                                                                          	#               RESULT, VXSC WANTS A SCALAR.
049473,000220: 
049474,000221:                                                                                          	#       2.      THE LOAD CODES SHOULD LOAD THE ACCUMULATOR INDEPENDENT OF THE RESULT OF THE LAST OPERATION.  THIS
049475,000222:                                                                                          	#               INCLUDES VLOAD, DLOAD, TLOAD, PDDL, AND PDVL (NO PUSHUP WITH SLOAD).
049476,000223: 
049477,000224:                                                                                          	#       3.      SOME ARITHMETIC OPERATIONS REQUIRE A STANDARD TYPE OF OPERAND REGARDLESS OF THE PREVIOUS OPERATION.
049478,000225:                                                                                          	#               THIS INCLUDES SIGN WANTING DP AND TAD REQUIRING TP.
049479,000226: 
049480,000227:    6164           34374        PUSHUP             CAF      OCT23                         	# IF THE LOW 5 BITS OF CYR ARE LESS THAN
049481,000228:    6165           70020                           MASK     CYR                           	# 20, THIS OP REQUIRES SPECIAL ATTENTION.
049482,000229:    6166           66171                           AD       -OCT10                        	# (NO -0).
049483,000230:    6167           10000                           CCS      A                             	#
049484,000231:    6170           16202                           TCF      REGUP                         	# FOR ALL CODES GREATER THAN OCT 7.
049485,000232: 
049486,000233:    6171           77767        -OCT10             OCT      -10                           	#
049487,000234: 
049488,000235:    6172           66061                           AD       NEG4                          	# WE NOW HAVE 7 -- OP CODE (MOD4).  SEE IF
049489,000236:    6173           10000                           CCS      A                             	# THE OP CODE (MOD4) IS THREE (REVERSE).
049490,000237:    6174           50000                           INDEX    A                             	# NO -- THE MODE IS DEFINITE.  PICK UP THE
049491,000238:    6175           46213                           CS       NO.WDS                        	#
049492,000239:    6176           16204                           TCF      REGUP      +2                 	#
049493,000240: 
049494,000241:    6177           50163                           INDEX    MODE                          	# FOR VXSC AND V/SC WE WANT THE REQUIRED
049495,000242:    6200           46211                           CS       REVCNT                        	# PUSHLOC DECREMENT WITHOUT CHANGING THE
049496,000243:    6201           16204                           TCF      REGUP      +2                 	# MODE AT THIS TIME.
049497,000244: 
049498,000245:    6202           50163        REGUP              INDEX    MODE                          	# MOST ALL OP CODES PUSHUP HERE.
049499,000246:    6203           46213                           CS       NO.WDS                        	#
049500,000247:    6204           26166                 +2        ADS      PUSHLOC                       	#
049501,000248:    6205           54116                           TS       ADDRWD                        	#
049502,000249:    6206           50020        ITR14              INDEX    CYR                           	#
049503,000250:    6207           76242                           7        INDJUMP    -1                 	# (THE INDEX MAKES THIS A TCF.)
049504,000251: 
049505,000252:    6210           00002                           OCT      2                             	# REVERSE PUSHUP DECREMENT. VECTOR TAKES 2
049506,000253:    6211           00006        REVCNT             OCT      6                             	# WORDS, SCALAR TAKES 6.
049507,000254:    6212           00006                           OCT      6                             	#
049508,000255:    6213           00002        NO.WDS             OCT      2                             	# CONVENTIONAL DECREMENT IS 6 WORDS VECTOR
049509,000256:    6214           00003        OCTAL3             OCT      3                             	# 2 IN DP, AND 3 IN TP.
049510,000257:    6215           00006                           OCT      6                             	#
049511,000258: 
049512,000259:                                                                                          	# Page 1114
049513,000260:                                                                                          	# TEST THE SECOND PREFIX BIT TO SEE IF THIS IS A MISCELLANEOUS OR A UNARY/SHORT SHIFT OPERATION.
049514,000261: 
049515,000262:    6216           10020        OPJUMP2            CCS      CYR                           	# TEST SECOND PREFIX BIT.
049516,000263:    6217           16232                           TCF      OPJUMP3                       	# TEST THIRD BIT TO SEE IF UNARY OR SHIFT.
049517,000264: 
049518,000265:    6220           77722        -ENDVAC            DEC      -45        B-14               	#
049519,000266: 
049520,000267:                                                                                          	# THE FOLLOWING ROUTINE PROCESSES ADDRESSES OF SUFFIX CLASS 10.  THEY ARE BASICALLY WORK AREA ADDRESSES
049521,000268:                                                                                          	# IN THE RANGE 0-52, ERASABLE ECADR CONSTANTS FROM 100-3777, AND FCADRS ABOVE THAT.  ALL 15 BITS ARE AVAILABLE
049522,000269:                                                                                          	# IN CONTRAST TO SUFFIX 1, IN WHICH ONLY THE LOW ORDER 14 ARE AVAILABLE.
049523,000270: 
049524,000271:    6221           24164        15BITADR           INCR     LOC                           	# (ENTRY HERE FROM STCALL).
049525,000272:    6222           50164                           INDEX    LOC                           	# PICK UP ADDRESS WORD.
049526,000273:    6223           30000                           CA       0                             	#
049527,000274:    6224           54117                           TS       POLISH                        	# WE MAY NEED A SUBADDRESS LATER.

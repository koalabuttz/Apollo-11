027659,002742:                                                                                          	# PROGRAM NAME-  P23 CISLUNAR MIDCOURSE NAVIGATION
027660,002743:                                                                                          	# MOD NO
027661,002744:                                                                                          	# MOD BY-  TOM KNATT
027662,002745:                                                                                          	# FUNCTIONAL DESCRIPTION-  DO MIDCOURSE NAVIGATION BY INCORPORATION OF STAR
027663,002746:                                                                                          	# /EARTH AND STAR/MOON OPTICAL MEASUREMENTS.
027664,002747:                                                                                          	# CALLING SEQUENCE-  ASTRONAUT OPERATED
027665,002748:                                                                                          	# SUBROUTINES CALLED-  R52,R53,R57,R60,ORBITAL INTEGRATION (INTEGRV)
027666,002749:                                                                                          	# INCORP1,INCORP2,LALOTORV,LUNLMKLD, AND DISPLAY INTERFACE ROUTINES.
027667,002750:                                                                                          	# NORMAL EXIT MODES-  VIA ROO
027668,002751:                                                                                          	# ALARMS-  NONE
027669,002752:                                                                                          	# ABORT MODES-  NONE
027670,002753:                                                                                          	# ERASABLE INITIALIZATION REQUIRED-  PAD-LOADED ERASABLES, ORBWFLAG RESET,
027671,002754:                                                                                          	# REFSMFLG=0 IF IMU OFF AND REFSMFLG=1 IF IMU ON
027672,002755:                                                                                          	# INPUTS BY USER REQUIRED-  STAR NUMBER, LANDMARK LAT, LONG/2, ALT OR ID NUMB.
027673,002756:                                                                                          	# IF LANDMARK IS USED, NEAR OR FAR HORIZON IF HORIZON IS USED, AND 
027674,002757:                                                                                          	# BODY TO BE MARKED ON (EARTH OR MOON).  SEE GSOP CHAPT 4.
027675,002758:                                                                                          	# OUTPUT-  UPDATED CMC STATE VECTOR.  VECTOR FROM S/C TO HORIZON OR LANDMARK
027676,002759:                                                                                          	# IN POINTAXS.  POINTAXS CAN BE USED TO GENERATE THIS VECTOR APART FROM
027677,002760:                                                                                          	# P23 IF DESIRED.
027678,002761:                                                                                          	# DEBRIS-  NO USABLE DEBRIS IS GENERATED.  RENDWFLG IS RESET FOR P20 UPON
027679,002762:                                                                                          	# COMPLETION OF P23.  RUPTREGS AND ERASABLES USED BY DISPLAYS ARE DEBRIS

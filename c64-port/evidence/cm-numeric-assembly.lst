046874,000493: 17,3201           63306                           AD       =-.1SEC                       	#
046875,000494: 17,3202           00006                           EXTEND                                 	#
046876,000495: 17,3203           63214                           BZMF     AD14MSP                       	#
046877,000496: 17,3204           51523                           INDEX    NPJETS                        	#
046878,000497: 17,3205           33307                           CA       DFTMAX                        	# THE PITCH ON-TIME IS GREATER THAN .1 SEC
046879,000498: 17,3206           55550                           TS       DFT1                          	#
046880,000499: 17,3207           40000                           COM                                    	#

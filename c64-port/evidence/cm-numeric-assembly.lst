008715,001244:                                                                                          	# MAJOR MODE THAT CAN BE STARTED FROM THE KEYBOARD.  THE ENTRIES ARE PUT
008716,001245:                                                                                          	# INTO THE TABLE WITH THE ENTRY FOR THE HIGHEST MAJOR MODE COMING FIRST,
008717,001246:                                                                                          	# Page 206
008718,001247:                                                                                          	# TO THE LOWEST MAJOR MODE WHICH IS THE LAST ENTRY IN EACH TABLE.
008719,001248: 
008720,001249:                                                                                          	#       THE FCADRMM TABLE CONTAINS THE FCADR OF THE STARTING JOB OF
008721,001250:                                                                                          	# THE MAJOR MODE.  FOR EXAMPLE,
008722,001251: 
008723,001252:                                                                                          	#       FCADRMM1        FCADR   P79             # START OF P 79
008724,001253:                                                                                          	#                       FCADR   PROG18          # START OF P 18
008725,001254:                                                                                          	#                       FCADR   P01             # START OF P 01
008726,001255: 
008727,001256: 04,2416                        FCADRMM1           EQUALS                                 	#
008728,001257: 04,2416           11172                           FCADR    P79                           	#
008729,001258: 04,2417           10744                           FCADR    P78                           	#
008730,001259: 04,2420           73153                           FCADR    P77                           	#
008731,001260: 04,2421           26071                           FCADR    P76                           	#
008732,001261: 04,2422           72163                           FCADR    P75                           	#
008733,001262: 04,2423           72002                           FCADR    P74                           	#
008734,001263: 04,2424           11441                           FCADR    P73                           	#
008735,001264: 04,2425           11305                           FCADR    P72                           	#
008736,001265: 04,2426           54320                           FCADR    P62                           	#
008737,001266: 04,2427           54217                           FCADR    P61                           	#
008738,001267: 04,2430           32000                           FCADR    P54                           	#
008739,001268: 04,2431           31067                           FCADR    P53                           	#
008740,001269: 04,2432           32000                           FCADR    PROG52                        	#
008741,001270: 04,2433           31067                           FCADR    P51                           	#
008742,001271: 04,2434           50463                           FCADR    P47CSM                        	#
008743,001272: 04,2435           56614                           FCADR    P41CSM                        	#
008744,001273: 04,2436           50073                           FCADR    P40CSM                        	#
008745,001274: 04,2437           11166                           FCADR    P39                           	#
008746,001275: 04,2440           10742                           FCADR    P38                           	#
008747,001276: 04,2441           74466                           FCADR    P37                           	#
008748,001277: 04,2442           72157                           FCADR    P35                           	#
008749,001278: 04,2443           72000                           FCADR    P34                           	#

009424,000472:                                                                                          	# PROGRAM DESCRIPTION: NEWPHASE                                         DATE:  11 NOV 1966
009425,000473:                                                                                          	# MOD: 1                                                                ASSEMBLY:  SUNBURST REV
009426,000474:                                                                                          	# MOD BY: COPPS                                                         LOG SECTION: PHASE TABLE MAINTENANCE
009427,000475: 
009428,000476:                                                                                          	# FUNCTIONAL DESCRIPTION:
009429,000477: 
009430,000478:                                                                                          	#       NEWPHASE IS THE QUICK WAY TO MAKE A NON VARIABLE PHASE CHANGE.  IT INCLUDES THE OPTION OF SETTING
009431,000479:                                                                                          	#       TBASE OF THE GROUP.  IF TBASE IS TO BE SET, -C(TIME1) IS STORED IN THE TBASE TABLE AS FOLLOWS:
009432,000480: 
009433,000481:                                                                                          	#               (L-1)   TBASE0
009434,000482:                                                                                          	#               (L)     TBASE1  (IF GROUP=1)
009435,000483:                                                                                          	#               (L+1)
009436,000484:                                                                                          	#               (L+2)   TBASE2  (IF GROUP=2)
009437,000485:                                                                                          	#               -----
009438,000486:                                                                                          	#               (L+6)   TBASE4  (IF GROUP=4)
009439,000487:                                                                                          	#               (L+7)
009440,000488:                                                                                          	#               (L+8)   TBASE5  (IF GROUP=5)
009441,000489: 
009442,000490:                                                                                          	#       IN ANY CASE, THE NEGATIVE OF THE PHASE, FOLLOWED (IN THE NEXT REGISTER) BY THE PHASE, IS STORED IN THE
009443,000491:                                                                                          	#       PHASE TABLE AS FOLLOWS:
009444,000492: 
009445,000493:                                                                                          	#               (L)     -PHASE1 (IF GROUP=1)
009446,000494:                                                                                          	#               (L+1)   PHASE1
009447,000495:                                                                                          	#               (L+2)   -PHASE2 (IF GROUP=2)
009448,000496:                                                                                          	#               (L+3)   PHASE2
009449,000497:                                                                                          	#               -----
009450,000498:                                                                                          	#               (L+7)   PHASE4
009451,000499:                                                                                          	#               (L+8)   -PHASE5 (IF GROUP=5)
009452,000500:                                                                                          	#               (L+9)   PHASE5
009453,000501: 
009454,000502:                                                                                          	# CALLING SEQUENCE:
009455,000503: 
009456,000504:                                                                                          	#       EXAMPLE IS FOR PLACING A PHASE OF FIVE INTO GROUP THREE:
009457,000505: 
009458,000506:                                                                                          	#       1)      IF TBASE IS NOT TO BE SET:
009459,000507:                                                                                          	#                       L-1     CA      FIVE
009460,000508:                                                                                          	#                       L       TC      NEWPHASE
009461,000509:                                                                                          	#                       L+1     OCT     00003
009462,000510: 
009463,000511:                                                                                          	#       2)      IF TBASE IS TO BE SET:
009464,000512:                                                                                          	#                       L-1     CS      FIVE
009465,000513:                                                                                          	#                       L       TC      NEWPHASE
009466,000514:                                                                                          	#                       L+1     OCT     00003
009467,000515: 
009468,000516:                                                                                          	# SUBROUTINES CALLED:  NONE
009469,000517: 
009470,000518:                                                                                          	# NORMAL EXIT MODE:  AT L+2 OF CALLING SEQUENCE
009471,000519: 
009472,000520:                                                                                          	# ALARM OR ABORT EXITS:  NONE
009473,000521: 
009474,000522:                                                                                          	# OUTPUT:  PHASE TABLE AND TBASE TABLE UPDATED
009475,000523: 
009476,000524:                                                                                          	# ERASABLE INITIALIZATION REQ,D:  NONE
009478,000526:                                                                                          	# DEBRIS:  A,L,TEMPG
009479,000527: 
009480,000528:                                                                                          	# *** WARNING *** THIS PROGRAM IS TO BE PLACED IN FIXED-FIXED AND UNSWITCHED ERASABLE.
009481,000529: 
009482,000530:    4114                                           BLOCK    02                            	#
009483,000531:    4000                                           SETLOC   FFTAG1                        	#
009484,000532:    4000                                           BANK                                   	#
009485,000533: 
009486,000534:    4114                                           COUNT*   $$/PHASE                      	#
009487,000535: 
009488,000536:    4114           00004        NEWPHASE           INHINT                                 	#
009489,000537: 
009490,000538:    4115           54001                           TS       L                             	# SAVE FOR FURTHER USE
009491,000539: 
009492,000540:    4116           50002                           NDX      Q                             	# OBTAIN THE GROUP NUMBER
009493,000541:    4117           30000                           CA       0                             	#
009494,000542:    4120           24002                           INCR     Q                             	# OBTAIN THE RETURN ADDRESS
009495,000543:    4121           60000                           DOUBLE                                 	# SAVE THE GROUP IN A FORM USED FOR
009496,000544:    4122           54061                           TS       TEMPG                         	# INDEXING
009497,000545: 
009498,000546:    4123           10001                           CCS      L                             	# SEE IF WE ARE TO SET TBASE
009499,000547:    4124           14133                           TCF      +7                            	# NO, THE DELTA T WAS POSITIVE
009500,000548:    4125           14133                           TCF      +6                            	#
009501,000549: 
009502,000550:    4126           24000        NUFAZ+10           INCR     A                             	# SET TBASE AND STORE PHASE CORRECTLY
009503,000551:    4127           54001                           TS       L                             	#
009504,000552: 
009505,000553:    4130           40025                           CS       TIME1                         	# SET TBASE
009506,000554:    4131           50061                           NDX      TEMPG                         	#
009507,000555:    4132           55051                           TS       TBASE1     -2                 	#
009508,000556: 
009509,000557:    4133           40001                           CS       L                             	# NOW PUT THE PHASE IN THE RIGHT TABLE LOC
009510,000558:    4134           50061                           NDX      TEMPG                         	#
009511,000559:    4135           52751                           DXCH     -PHASE1    -2                 	#
009512,000560: 
009513,000561:    4136           00003                           RELINT                                 	#
009514,000562:    4137           00002                           TC       Q                             	# NOW RETURN TO CALLER
009515,000563: 
009516,000564: 
(End of include-file RESTART_TABLES.agc, resuming MAIN.agc)
009516,000082: 

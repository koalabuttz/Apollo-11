005302,003667: E7,1426  E7,1703               RM                 EQUALS   S22RTNEX                      	# DOWNLINK OF VHF RANGE
005303,003668: 
005304,003669:                                                                                          	# S22.1                                 (1D)
005305,003670: E7,1426  E7,1703               S22RTNEX           EQUALS   MARKDOWN   +7                 	# B(1)
005306,003671: 
005307,003672:                                                                                          	# P22 STORAGE                           (6D)
005308,003673: E7,1426  E7,1704               STARSAV3           EQUALS   S22RTNEX   +1                 	# I(6)TMP
005309,003674: 
005310,003675:                                                                                          	# CRS61.1 STORAGE.  -A SUBSET OF P20-   (14D)
005311,003676: E7,1426  E7,1704               Q611               EQUALS   RM         +1                 	# I(1)TMP QSAVE
005312,003677: E7,1426  E7,1705               Q6111              EQUALS   Q611       +1                 	# I(1)TMP QSAVE
005313,003678: E7,1426  E7,1706               SAVEPOS            EQUALS   Q6111      +1                 	# I(6)TMP LEM POSITION VECTOR-
005315,003680: E7,1426  E7,1714               SAVEVEL            EQUALS   SAVEPOS    +6                 	# I(6)TMP LEM VELOCITY VECTOR-
005316,003681: 
005317,003682:                                                                                          	# ATTITUDE MANEUVER -CALLED BY P20,R61,R63,CRS61.1      (3D)
005318,003683: E7,1426  E7,1722               PRAXIS             EQUALS   SAVEVEL    +6                 	# B(3) S-S DISP RES FOR PREF AXIS N95
005319,003684: 
005320,003685:                                                                                          	# MARK ROUTINE (R21) STORAGE.  -IS SUBSET OF R22-       (14D)
005321,003686: E7,1426  E7,1725               MRKBUF1            EQUALS   PRAXIS     +3                 	# B(7)TMP R21 MARK BUFFER
005322,003687: E7,1426  E7,1734               MRKBUF2            EQUALS   MRKBUF1    +7                 	# B(7)TMP R21 MARK BUFFER
005323,003688: 
005324,003689:                                                                                          	# MORE CONICS STORAGE.                  (4)
005325,003690: E7,1426                        COGA               EQUALS   3774                          	# I(2) COTAN OF INITIAL FLIGHT PATH ANGLE
005326,003691: E7,1426  E7,1774               INDEP              EQUALS   COGA                          	# I(1) USED BY SUBROUTINE :ITERATOR:
005327,003692: E7,1426  E7,1776               EPSILONL           EQUALS   COGA       +2                 	# I(2)TMP
005328,003693: 
005329,003694:                                                                                          	# RENDEZVOUS GUIDANCE STORAGE.  - P32...P35 -   (10D)
005330,003695: E7,1426  E7,1743               ELEV               EQUALS   MRKBUF2    +7                 	# I(2)TMP
005331,003696: E7,1426  E7,1745               RTX1               EQUALS   ELEV       +2                 	#  (1)
005332,003697: E7,1426  E7,1746               RTX2               EQUALS   RTX1       +1                 	#  (1)
005333,003698: E7,1426  E7,1747               RTMU               EQUALS   RTX2       +1                 	#  (2)
005334,003699: E7,1426  E7,1751               RTSR1/MU           EQUALS   RTMU       +2                 	#  (2)
005335,003700: E7,1426  E7,1753               CENTANG            EQUALS   RTSR1/MU   +2                 	# I(2) S-S CENTRAL ANGLE COVERED (TPI-TPF)
005336,003701: 
005337,003702:                                                                                          	# TPI SEARCH (S17.1, S17.2) P17 STORAGE.(10D)
005338,003703: E7,1426  E7,1743               DELTEE             EQUALS   MRKBUF2    +7                 	# I(2)
005339,003704: E7,1426  E7,1745               XRS                EQUALS   DELTEE     +2                 	# I(2)
005340,003705: E7,1426  E7,1747               THETL              EQUALS   XRS        +2                 	# I(2)
005341,003706: E7,1426  E7,1751               TF                 EQUALS   THETL      +2                 	# I(2)
005342,003707: E7,1426  E7,1753               DELHITE            EQUALS   TF         +2                 	#  (2)
005343,003708: 
005345,003710:                                                                                          	# *-*-*-*- OVERLAY 5 IN EBANK 7 -*-*-*-*
005346,003711: 
005347,003712:                                                                                          	# P17,P34                               (2D)
005348,003713: E7,1426  E7,1765               NN1                =        NN                            	# I(2)DSP NOUN 55,R1
005349,003714: 
005350,003715:                                                                                          	# ************ THE FOLLOWING ARE FOR FLIGHT 504 ONLY ********************
005351,003716: 
005352,003717:                                                                                          	# RETURN-TO-EARTH STORAGE.              (93D)
005353,003718: E7,1426  E7,1631               RTEDVD             EQUALS   END-IN/M                      	# I(2)IN DELTA VELOCITY DESIRED         M/CS B7
005354,003719: E7,1426  E7,1633               RTEGAM2D           EQUALS   RTEDVD     +2                 	# I(2)IN REENTRY ANGLE DESIRED          REVS B0
005355,003720: E7,1426  E7,1635               RCON               EQUALS   RTEGAM2D   +2                 	# I(2)TMP CONIC R2 RADIUS               M B29
005356,003721: E7,1426  E7,1637               R(T1)/             EQUALS   RCON       +2                 	# I(6)TMP POSITION VECTOR AT TIG        M B29/B27
005357,003722: E7,1426  E7,1645               R(T1)              EQUALS   R(T1)/     +6                 	# I(2)TMP MAGNITUDE OF R(T1)/           M B29/B27
005358,003723: E7,1426  E7,1647               DT21PR             EQUALS   R(T1)      +2                 	# I(2)TMP PREVOUS DT21                  CS B30
005359,003724: E7,1426  E7,1651               MAMAX1             EQUALS   DT21PR     +2                 	# I(2)TMP MAJ AXIS LOW BOUND LMT        M B30
005360,003725: E7,1426  E7,1653               MAMAX2             EQUALS   MAMAX1     +2                 	# I(2)TMP MAJ AXIS UP BOUND LMT         M B30
005361,003726: E7,1426  E7,1655               R(T2)/             EQUALS   MAMAX2     +2                 	# I(6)TMP FINAL POSITION VECTOR         M B29/B27
005362,003727: E7,1426  E7,1663               RD                 EQUALS   R(T2)/     +6                 	# I(2)TMP FINAL R DESIRED               M B29/B27
005363,003728: E7,1426  E7,1665               DRCON              EQUALS   RD         +2                 	# I(2)TMP RCON SLOPE ITERATOR           M B29/B27
005364,003729: E7,1426  E7,1667               RPRE'              EQUALS   DRCON      +2                 	# I(2)TMP PREVISOUS RPRE                M B29/B27
005365,003730: E7,1426  E7,1671               V(T1)/             EQUALS   RPRE'      +2                 	# I(6)TMP VEL VECTOR AT TIG             M/CS B7/B5
005366,003731: E7,1426  E7,1677               V2(T1)/            EQUALS   V(T1)/     +6                 	# I(6)TMP POST IMP VEL AT TIG           M/CS B7/B5
005367,003732: E7,1426  E7,1705               DV                 EQUALS   V2(T1)/    +6                 	# I(2)TMP DELTA VELOCITY AT TIG         M/CS B7/B5
005368,003733: E7,1426  E7,1707               V(T2)/             EQUALS   DV         +2                 	# I(6)TMP FINAL VELOCITY VECTOR         M/CS B7/B5
005369,003734: E7,1426  E7,1715               T1                 EQUALS   V(T2)/     +6                 	# I(2)TMP INITIAL VECTOR TIME           CS B28
005370,003735: E7,1426  E7,1717               PCON               EQUALS   T1         +2                 	# I(2)TMP SEMI-LATUS RECTUM             M B29
005371,003736: E7,1426  E7,1721               X(T1)              EQUALS   PCON       +2                 	# I(2)TMP COTANGENT GAMMA1              B5
005372,003737: E7,1426  E7,1723               T12                EQUALS   X(T1)      +2                 	# I(2)TMP INIT TO FINL POSIT TIME       CS B28
005373,003738: E7,1426  E7,1725               DELTAT             EQUALS   T12        +2                 	# I(2)TMP DELTA T IN SAFE PERILUNE      CS B28
005374,003739: E7,1426  E7,1727               NN1A               EQUALS   DELTAT     +2                 	# I(2)TMP ITERATION COUNTER 1
005375,003740: E7,1426  E7,1731               NN2                EQUALS   NN1A       +2                 	# I(2)TMP ITERATION COUNTER 2
005376,003741: E7,1426  E7,1733               RTENCKEX           EQUALS   NN2        +2                 	# I(1)TMP RTENCK RETURN ADDRESS
005377,003742: E7,1426  E7,1734               CONICX1            EQUALS   RTENCKEX   +1                 	# I(1)TMP CONICS MU TABLE INDEX
005378,003743: E7,1426  E7,1735               T2                 EQUALS   CONICX1    +1                 	# I(2)TMP FINAL TIME                    CS B28
005379,003744: E7,1426  E7,1737               UR1/               EQUALS   T2         +2                 	# I(6)TMP UNIT R(T1)/                   B1
005380,003745: E7,1426  E7,1745               UV1/               EQUALS   UR1/       +6                 	# I(6)TMP UNIT V(T1)/                   B1
005381,003746: E7,1426  E7,1753               BETA1              EQUALS   UV1/       +6                 	# I(2)TMP 1+X(T2)**2                    B1
005382,003747: E7,1426  E7,1755               P(T1)              EQUALS   BETA1      +2                 	# I(1)TMP PRIMARY BODY STATE TIME 1     B14
005383,003748: E7,1426  E7,1756               CFPA               EQUALS   P(T1)      +1                 	# I(2)TMP COSINE FLIGHT PATH ANGLE     B1
005384,003749: E7,1426  E7,1760               PHI2               EQUALS   CFPA       +2                 	# I(2)TMP PERI OR APO INDICATOR         B2
005385,003750: E7,1426  E7,1762               SPRTEX             EQUALS   PHI2       +2                 	# I(1)TMP ROUTINE RETURN ADDRESS
005386,003751: E7,1426  E7,1763               VNSTORE            EQUALS   SPRTEX     +1                 	# I(1)TMP VERBNOUN STORAGE
005387,003752: E7,1426  E7,1764               BETA12             EQUALS   VNSTORE    +1                 	# I(2)TMP SIGN FOR TIMERAD
005388,003753: 
005389,003754:                                                                                          	# OVERLAYS WITHIN RETURN-TO-EARTH STORAGE.
005391,003756: E7,1426                        RPRE               EQUALS   24D                           	# I(2)TMP COMPUTED PREC RADIUS          M B29/B27
005392,003757: E7,1426                        P/RPRE             EQUALS   26D                           	# I(2)TMP P/R                           B4
005393,003758: E7,1426                        R/APRE             EQUALS   28D                           	# I(2)TMP R/A                           B6
005394,003759: E7,1426  E7,1723               X(T2)PRE           EQUALS   T12                           	# I(2)TMP PREC COTAN GAMMA2             B0
005395,003760: E7,1426  E7,1725               X(T2)              EQUALS   DELTAT                        	# I(2)TMP COTAN GAMMA2                  B0
005396,003761: E7,1426  E7,1745               UH/                EQUALS   UV1/                          	# I(2)TMP UNIT HORIZONTAL VECTOR.       B1
005397,003762: E7,1426  E7,1412               SPRTETIG           EQUALS   TIG                           	# I(2)IN TIME OF IGNITION               CS B28

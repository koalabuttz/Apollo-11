020567,000307: 
020569,000309:                                                                                          	# RENDEZVOUS MID-COURSE MANEUVER PROGRAMS (P35 AND P75)
020570,000310:                                                                                          	# MOD NO -1                     LOG SECTION - P32-P35, P72-P75
020571,000311:                                                                                          	# MOD BY WHITE.P                DATE  1JUNE67
020572,000312: 
020573,000313:                                                                                          	# PURPOSE
020574,000314:                                                                                          	#       (1)     TO CALCULATE THE REQUIRED DELTA V AND OTHER INITIAL CONDITIONS
020575,000315:                                                                                          	#               REQUIRED BY THE ACTIVE VEHICLE FOR EXECUTION OF THE NEXT
020576,000316:                                                                                          	#               MIDCOURSE CORRECTION OF THE TRANSFER PHASE OF AN ACTIVE
020577,000317:                                                                                          	#               VEHICLE RENDEZVOUS.
020578,000318:                                                                                          	#       (2)     TO DISPLAY TO THE ASTRONAUT AND THE GROUND CERTAIN DEPENDENT
020579,000319:                                                                                          	#               VARIABLES ASSOCIATED WITH THE MANEUVER FOR APPROVAL BY THE
020580,000320:                                                                                          	#               ASTRONAUT/GROUND.
020581,000321:                                                                                          	#       (3)     TO STORE THE TPM TARGET PARAMETERS FOR USE BY THE DESIRED
020582,000322:                                                                                          	#               THRUSTING PROGRAM.
020583,000323: 
020584,000324:                                                                                          	# ASSUMPTIONS
020585,000325:                                                                                          	#       (1)     THE ISS NEED NOT BE ON TO COMPLETE THIS PROGRAM.
020586,000326:                                                                                          	#       (2)     STATE VECTOR UPDATES BY P27 ARE DISALLOWED DURING AUTOMATIC
020587,000327:                                                                                          	#               STATE VECTOR UPDATING INITIATED BY P20 (SEE ASSUMPTION (3)).
020588,000328:                                                                                          	#       (3)     THE RENDEZVOUS RADAR IS ON AND IS LOCKED ON THE CSM.  THIS WAS
020589,000329:                                                                                          	#               DONE DURING PREVIOUS SELECTION OF P20.  RADAR SIGHTING MARKS
020590,000330:                                                                                          	#               WILL BE MADE AUTOMATICALLY APPROXIMATELY ONCE A MINUTE WHEN
020591,000331:                                                                                          	#               ENABLED BY THE TRACK AND UPDATE FLAGS (SEE P20).  THE
020592,000332:                                                                                          	#               RENDEZVOUS TRACKING MARK COUNTER IS ZEROED BY THE SELECTION OF
020593,000333:                                                                                          	#               P20 AND AFTER EACH THRUSTING MANEUVER.
020594,000334:                                                                                          	#       (4)     THE OPERATION OF THE PROGRAM UTILIZES THE FOLLOWING FLAGS -
020595,000335: 
020596,000336:                                                                                          	#                       ACTIVE VEHICLE FLAG - DESIGNATES THE VEHICLE WHICH IS
020597,000337:                                                                                          	#                       DOING RENDEZVOUS THRUSTING MANEUVERS TO THE PROGRAM WHICH
020598,000338:                                                                                          	#                       CALCULATES THE MANEUVER PARAMETERS.  SET AT THE START OF
020599,000339:                                                                                          	#                       EACH RENDEZVOUS PRE-THRUSTING PROGRAM.
020600,000340: 
020601,000341:                                                                                          	#                       FINAL FLAG - SELECTS FINAL PROGRAM DISPLAYS AFTER CREW HAS
020602,000342:                                                                                          	#                       SELECTED THE FINAL MANEUVER COMPUTATION CYCLE.
020603,000343: 
020604,000344:                                                                                          	#                       EXTERNAL DELTA V FLAG - DESIGNATES THE TYPE OF STEERING
020605,000345:                                                                                          	#                       REQUIRED FOR EXECUTION OF THIS MANEUVER BY THE THRUSTING
020606,000346:                                                                                          	#                       PROGRAM SELECTED AFTER COMPLETION OF THIS PROGRAM.
020607,000347: 
020608,000348:                                                                                          	#       (5)     THE TIME OF INTERCEPT (T(INT)) WAS DEFINED BY PREVIOUS
020609,000349:                                                                                          	#               COMPLETION OF THE TRANSFER PHASE INITIATION (TPI) PROGRAM
020610,000350:                                                                                          	#               (P34/P74) AND IS PRESENTLY AVAILABLE IN STORAGE.
020612,000352:                                                                                          	#       (6)     ONCE THE PARAMETERS REQUIRED FOR COMPUTION OF THE MANEUVER
020613,000353:                                                                                          	#               HAVE BEEN COMPLETELY SPECIFIED, THE VALUE OF THE ACTIVE
020614,000354:                                                                                          	#               VEHICLE CENTRAL ANGLE OF TRANSFER IS COMPUTED AND STORED.
020615,000355:                                                                                          	#               THIS NUMBER WILL BE AVAILABLE FOR DISPLAY TO THE ASTRONAUT
020616,000356:                                                                                          	#               THROUGH THE USE OF V06N52.
020617,000357: 
020618,000358:                                                                                          	#               THE ASTRONAUT WILL CALL THIS DISPLAY TO VERIFY THAT THE
020619,000359:                                                                                          	#               CENTRAL ANGLE OF TRANSFER OF THE ACTIVE VEHICLE IS NOT WITHIN
020620,000360:                                                                                          	#               170 TO 190 DEGREES.  IF THE ANGLE IS WITHIN THIS ZONE THE
020621,000361:                                                                                          	#               ASTRONAUT SHOULD REASSESS THE INPUT TARGETING PARAMETERS BASED
020622,000362:                                                                                          	#               UPON DELTA V AND EXPECTED MANEUVER TIME.
020623,000363:                                                                                          	#       (7)     THIS PROGRAM IS SELECTED BY THE ASTRONAUT BY DSKY ENTRY -
020624,000364: 
020625,000365:                                                                                          	#                       P35 IF THIS VEHICLE IS ACTIVE VEHICLE.
020626,000366: 
020627,000367:                                                                                          	#                       P75 IF THIS VEHICLE IS PASSIVE VEHICLE.
020628,000368: 
020629,000369:                                                                                          	# INPUT
020630,000370:                                                                                          	#       (1)     TPASS4          TIME OF INTERCEPT - SAVED FROM P34/P74
020631,000371: 
020632,000372:                                                                                          	# OUTPUT
020633,000373:                                                                                          	#       (1)     TRKMKCNT        NUMBER OF MARKS
020634,000374:                                                                                          	#       (2)     TTOGO           TIME TO GO
020635,000375:                                                                                          	#       (3)     +MGA            MIDDLE GIMBAL ANGLE
020636,000376:                                                                                          	#       (4)     DVLOS           DELTA VELOCITY AT MID - LINE OF SIGHT
020637,000377:                                                                                          	#       (5)     DELVLVC         DELTA VELOCITY AT MID - LOCAL VERTICAL COORDINATES
020638,000378: 
020639,000379:                                                                                          	# DOWNLINK
020640,000380:                                                                                          	#       (1)     TIG             TIME OF THE TPM MANEUVER
020641,000381:                                                                                          	#       (2)     DELVEET3        DELTA VELOCITY AT TPM - REFERENCE COORDINATES
020642,000382:                                                                                          	#       (3)     TPASS4          TIME OF INTERCEPT
020643,000383: 
020644,000384:                                                                                          	# COMMUNICATION TO THRUSTING PROGRAMS
020645,000385:                                                                                          	#       (1)     TIG             TIME OF THE TPM MANEUVER
020646,000386:                                                                                          	#       (2)     RTARG           OFFSET TARGET POSITION
020647,000387:                                                                                          	#       (3)     TPASS4          TIME OF INTERCEPT
020648,000388:                                                                                          	#       (4)     XDELVFLG        RESET TO INDICATE LAMBERT (AIMPOINT) VG COMPUTATION
020649,000389: 

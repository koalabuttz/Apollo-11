057549,000580: 
057550,000581:                                                                                          	# INTEGRV IS AN ENTRY TO ORBIT INTEGRATION WHICH PERMITS THE CALLER,
057551,000582:                                                                                          	# NORMALLY THE NAVIGATION PROGRAM, TO SET THE INTEG. FLAGS.  THE ROUTINE
057552,000583:                                                                                          	# IS ENTERED AT INTEGRV1 BY CSMPREC ET. AL. AND AT ALOADED BY INTEGRVS.
057553,000584:                                                                                          	# THE ROUTINE SETS UP A-MEMORY IF ENTERED AT INTEGRV,1 AND SETS THE INTEG.
057554,000585:                                                                                          	# PROGRAM FOR PRECISION OR CONIC
057555,000586: 
057556,000587:                                                                                          	# THE CALLER MUST FIRST CALL INTSTALL TO CHECK IF INTEG. IS IN USE BEFORE
057557,000588:                                                                                          	# SETTING ANY FLAGS.
057558,000589: 
057559,000590:                                                                                          	# THE FLAGS WHICH SHOULD BE SET OR CLEARED ARE
057560,000591:                                                                                          	#       VINTFLAG        (IGNORED WHEN ENTERED FROM INTEGRVS)
057561,000592:                                                                                          	#       INTYPFLG
057562,000593:                                                                                          	#       DIM0FLAG
057563,000594:                                                                                          	#       D6OR9FLG
057564,000595: 
057565,000596:                                                                                          	# CALLING SEQUENCE
057566,000597:                                                                                          	#       L-X     CALL
057567,000598:                                                                                          	#       L-Y             INTSTALL
057568,000599:                                                                                          	#       L-1     SET OR CLEAR ALL FOUR FLAGS.  ALSO CAN SET STATEFLG IF DESIRED
057569,000600:                                                                                          	#               AND DIM0FLAG IS CLEAR.
057570,000601:                                                                                          	#       L       CALL
057571,000602:                                                                                          	#       L+1             INTEGRV
057572,000603: 
057573,000604:                                                                                          	# INITIALIZATION
057574,000605:                                                                                          	#       FLAGS AS ABOVE
057575,000606:                                                                                          	#       STORE TIME TO INTEGRATE TO IN TDEC1
057576,000607: 
057578,000609:                                                                                          	# OUTPUT
057579,000610:                                                                                          	#       RATT    AS
057580,000611:                                                                                          	#       VATT          DEFINED
057581,000612:                                                                                          	#       TAT                     BEFORE
057582,000613: 

060407,000634: 
060409,000636:                                                                                          	# PROGRAM NAME:  T(X)                           DATE:  01.17.67
060410,000637:                                                                                          	# MOD NO:  0                                    LOG SECTION:  TIME OF FREE FALL
060411,000638:                                                                                          	# MOD BY:  RR BAIRNSFATHER
060412,000639: 
060413,000640:                                                                                          	# FUNCTIONAL DESCRIPTION:  THE POLYNOMIAL T(X) IS USED BY TIME OF FLIGHT SUBROUTINES CALCTFF AND
060414,000641:                                                                                          	#       CALCTPER TO APPROXIMATE THE SERIES
060415,000642:                                                                                          	#                          2     3
060416,000643:                                                                                          	#               1/3 -X/5 +X /7 -X /9 ...
060417,000644: 
060418,000645:                                                                                          	#       WHERE   X = ALFA Z Z            IF ALFA Z Z LEQ 1
060419,000646:                                                                                          	#               X = 1/(ALFA Z Z)        IF ALFA Z Z G 1
060420,000647: 
060421,000648:                                                                                          	#       ALSO    X IS NEG FOR HYPERBOLIC ORBITS
060422,000649:                                                                                          	#               X = 0 FOR PARABOLIC ORBITS
060423,000650:                                                                                          	#               X IS POSITIVE FOR ELLIPTIC ORBITS
060424,000651: 
060425,000652:                                                                                          	#       FOR FLIGHT 278, THE POLYNOMIAL T(X) IS FITTED OVER THE RANGE (0,+1) AND HAS A MAXIMUM
060426,000653:                                                                                          	#       DEVIATION FROM THE SERIES OF 2 E-5       (T(X) IS A CHEBYCHEV TYPE FIT AND WAS OBTAINED USING
060427,000654:                                                                                          	#       MAC PROGRAM AUTCURFIT294RRB AND IS VALID TO THE SAME TOLERANCE OVER THE RANGE (-.08,+1).)
060428,000655: 
060429,000656:                                                                                          	# CALLING SEQUENCE:     RTB
060430,000657:                                                                                          	#                               T(X)
060431,000658:                                                                                          	#       C(MPAC) = X
060432,000659: 
060433,000660:                                                                                          	# SUBROUTINES CALLED:  NONE
060434,000661: 
060435,000662:                                                                                          	# NORMAL EXIT MODE:  TC DANZIG
060436,000663: 
060437,000664:                                                                                          	# ALARMS:  NONE
060438,000665: 
060439,000666:                                                                                          	# OUTPUT:  C(MPAC) = T(X)
060440,000667: 
060441,000668:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:
060442,000669:                                                                                          	#       C(MPAC) = X
060443,000670: 
060444,000671:                                                                                          	# DEBRIS:  NONE
060445,000672: 
060446,000673: 27,3334           07171        T(X)               TC       POLY                          	#
060447,000674: 27,3335           00004                           DEC      4          B-14               	# N-1
060448,000675: 27,3336           12525 12525                     2DEC     3.333333333 E-1                	#
060449,000676: 27,3340           71463 57703                     2DEC*    -1.999819135 E-1*               	#
060450,000677: 27,3342           04423 17645                     2DEC*    1.418148467 E-1*               	#
060451,000678: 27,3344           74604 43667                     2DEC*    -1.01310997 E-1*               	#
060452,000679: 27,3346           01626 37256                     2DEC*    5.609004986 E-2*               	#
060453,000680: 27,3350           77404 52071                     2DEC*    -1.536156925 E-2*               	#
060454,000681: 
060455,000682: 27,3352           06030        ENDT(X)            TC       DANZIG                        	#
060456,000683: 
060457,000684: 27,3353  27,3352               TCDANZIG           =        ENDT(X)                       	#

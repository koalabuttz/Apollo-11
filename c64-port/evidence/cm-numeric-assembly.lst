027547,002630: 
027549,002632:                                                                                          	# SUBROUTINE NAME:  V89CALL
027550,002633:                                                                                          	# MOD NO:  0                                    DATE: 8 FEB 1968
027551,002634:                                                                                          	# MOD BY:  DIGITAL DEVEL GROUP                  LOG SECTION:  P20-P25
027552,002635: 
027553,002636:                                                                                          	# FUNCTIONAL DESCRIPTION:
027554,002637: 
027555,002638:                                                                                          	# CALLED BY VERB 89 ENTER DURING P00.  PRIO 10 USED.  CALCULATES AND
027556,002639:                                                                                          	# DISPLAYS FINAL GIMBAL ANGLES TO POINT CSM +X AXIS OR PREFERRED AXIS
027557,002640:                                                                                          	# (UNIT(Z)COS55 DEG + UNIT(X)SIN55 DEG) AT LM.
027558,002641: 
027559,002642:                                                                                          	# 1. KEY IN V89 E ONLY IF IN PROG 00. IF NOT IN P00, OPERATOR ERROR AND
027560,002643:                                                                                          	# EXIT R63, OTHERWISE CONTINUE.
027561,002644: 
027562,002645:                                                                                          	# 2. IF IN P00, DO IMU STATUS CHECK (R02BOTH).  IF IMU ON AND ITS
027563,002646:                                                                                          	# ORIENTATION KNOWN TO CGC, CONTINUE.
027564,002647: 
027565,002648:                                                                                          	# 3. FLASH DISPLAY V 04 N 06.  R2 INDICATES WHICH SPACECRAFT AXIS IS TO
027566,002649:                                                                                          	# BE POINTED AT LM.  INITIAL CHOICE IS PREFERRED AXIS.  (R2=1).
027567,002650:                                                                                          	# ASTRONAUT CAN CHANGE TO (+X) AXIS (R2 NOT= 1) BY V22 E 2 E.  CONTINUE
027568,002651:                                                                                          	# AFTER KEYING IN PROCEED.
027569,002652: 
027570,002653:                                                                                          	# 4. SET PREFERRED ATTITUDE FLAG ACCORDING TO OPTION DESIRED.  SET FLAG
027571,002654:                                                                                          	# FOR PREFERRED AXIS.  RESET FLAG FOR X AXIS.
027572,002655: 
027573,002656:                                                                                          	# 5. CURRENT TIME IS STORED AND R63COMP IS CALLED
027574,002657: 
027575,002658:                                                                                          	#       R63COMP JOB:
027576,002659:                                                                                          	#       
027577,002660:                                                                                          	#               UPDATES CSM AND LM STATE VECTORS USING CONIC EQUATIONS
027578,002661: 
027579,002662:                                                                                          	#               CALCULATES BOTH PREFERRED AND X AXIS TRACKING ATT FROM 3SM TO LM.
027580,002663: 
027581,002664:                                                                                          	#               DESIRED GIMBAL ANGLES AS INDICATED BY PREFERRED ATTITUDE FLAG
027582,002665:                                                                                          	#               ARE STORED FOR LATER R60CSM CALL.
027583,002666: 
027584,002667:                                                                                          	# 6. FLASH DISPLAY V 06 N18 AND AWAIT RESPONSE.
027585,002668: 
027586,002669:                                                                                          	# 7. RECYCLE-  RETURN TO STEP 5.
027587,002670:                                                                                          	#    TERMINATE- EXIT R63 ROUTINE
027588,002671:                                                                                          	#    PROCEED-  RESET 3AXISFLG AND CALL R60CSM FOR ATTITUDE MANEUVER.

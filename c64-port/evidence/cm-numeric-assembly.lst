049984,000731:                                                                                          	# Page 1130
049985,000732:                                                                                          	# TRIPLE PRECISION BRANCHING ROUTINE.  IF CALLING TC IS AT L, RETURN IS AS FOLLOWS:
049986,000733:                                                                                          	#       L+1     IF MPAC IS GREATER THAN ZERO.
049987,000734:                                                                                          	#       L+2     IF MPAC IS EQUAL TO +0 OR -0.
049988,000735:                                                                                          	#       L+3     IF MPAC IS LESS THAN ZERO.
049989,000736: 
049990,000737:    6672           10154        BRANCH             CCS      MPAC                          	#
049991,000738:    6673           00002                           TC       Q                             	#
049992,000739:    6674           16676                           TCF      +2                            	# ON ZERO.
049993,000740:    6675           16710                           TCF      NEG                           	#
049994,000741: 
049995,000742:    6676           10155                           CCS      MPAC       +1                 	#
049996,000743:    6677           00002                           TC       Q                             	#
049997,000744:    6700           16702                           TCF      +2                            	#

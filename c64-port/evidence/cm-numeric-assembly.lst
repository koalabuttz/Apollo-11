053579,000331: 01,3366           10000                 +4        CCS      A                             	#
053580,000332: 01,3367           61407                           AD       LST1       +7                 	#
053581,000333: 01,3370           13374                           TCF      +4                            	#
053582,000334: 01,3371           65017                           AD       ONE                           	#
053583,000335: 01,3372           03403                           TC       WTLST2                        	#
053584,000336: 01,3373           00007                           OCT      7                             	#
053585,000337: 
053586,000338: 01,3374           10000                 +4        CCS      A                             	#
053587,000339: 01,3375           07755        WTABORT            TC       BAILOUT                       	# NO ROOM IN THE INN.
053588,000340: 01,3376           01203                           OCT      1203                          	#
053589,000341: 
053590,000342: 01,3377           65017                           AD       ONE                           	#
053591,000343: 01,3400           03403                           TC       WTLST2                        	#
053592,000344: 01,3401           00010                           OCT      10                            	#
053593,000345: 
053594,000346: 01,3402           40201        OCT40201           OCT      40201                         	#
053595,000347: 
053596,000348:                                                                                          	# Page 1230
053597,000349:                                                                                          	# THE ENTRY TO WTLST2 JUST PRECEDING OCT N IS FOR T  LE TD LE T   -1.
053598,000350:                                                                                          	#                                                  N           N+1
053599,000351: 
053600,000352:                                                                                          	# (LE MEANS LESS THAN OR EQUAL TO).  AT ENTRY, C(A) = -(TD - T   + 1)
053601,000353:                                                                                          	#                                                             N+1
053602,000354: 
053603,000355:                                                                                          	# THE LST1 ENTRY-(T   -T +1) IS TO BE REPLACED BY -(TD - T  + 1), AND
053604,000356:                                                                                          	#                  N+1  N                                 N
053605,000357: 
053606,000358:                                                                                          	# THE ENTRY-(T   - TD + 1) IS TO BE INSERTED IMMEDIATELY FOLLOWING.
053607,000359:                                                                                          	#             N+1
053608,000360: 
053609,000361: 01,3403           54064        WTLST2             TS       WAITTEMP                      	#       C(A) = -(TD - T + 1)
053610,000362: 01,3404           50002                           INDEX    Q                             	#
053611,000363: 01,3405           30000                           CAF      0                             	#
053612,000364: 01,3406           54002                           TS       Q                             	# INDEX VALUE INTO Q.
053613,000365: 
053614,000366: 01,3407           35017                           CAF      ONE                           	#
053615,000367: 01,3410           60064                           AD       WAITTEMP                      	#
053616,000368: 01,3411           50002                           INDEX    Q                             	# C(A) = -(TD - T ) + 1.
053617,000369: 01,3412           27377                           ADS      LST1       -1                 	#                N
053618,000370: 
053619,000371: 01,3413           40064                           CS       WAITTEMP                      	#
053620,000372: 01,3414           50002                           INDEX    Q                             	#
053621,000373: 01,3415           13272                           TCF      WTLST4                        	#
053622,000374: 
053623,000375:                                                                                          	# Page 1231
053624,000376:                                                                                          	# ENTERS HERE ON T3 RUPT TO DISPATCH WAITLISTED TASK.
053625,000377: 
053626,000378: 01,3416           00006        T3RUPT             EXTEND                                 	#
053627,000379: 01,3417           04007                           ROR      SUPERBNK                      	# READ CURRENT SUPERBANK VALUE AND
053628,000380: 01,3420           54016                           TS       BANKRUPT                      	# SAVE WITH E AND F BANK VALUES.
053629,000381: 01,3421           00006                           EXTEND                                 	#
053630,000382: 01,3422           22012                           QXCH     QRUPT                         	#
053631,000383: 
053632,000384: 01,3423           35000        T3RUPT2            CAF      NEG1/2                        	# DISPATCH WAITLIST TASK.
053633,000385: 01,3424           57407                           XCH      LST1       +7                 	#
053634,000386: 01,3425           57406                           XCH      LST1       +6                 	#
053635,000387: 01,3426           57405                           XCH      LST1       +5                 	#
053636,000388: 01,3427           57404                           XCH      LST1       +4                 	# 1. MOVE UP LST1 CONTENTS, ENTERING
053637,000389: 01,3430           57403                           XCH      LST1       +3                 	#    A VALUE OF 1/2 +1 AT THE BOTTOM
053638,000390: 01,3431           57402                           XCH      LST1       +2                 	#    FOR T6-T5, CORRESPONDING TO THE
053639,000391: 01,3432           57401                           XCH      LST1       +1                 	#    INTERVAL 81.91 SEC FOR ENDTASK.
053640,000392: 01,3433           57400                           XCH      LST1                          	#
053641,000393: 01,3434           64777                           AD       POSMAX                        	# 2. SET T3 = 1.0 - T2 - T USING LIST 1.
053642,000394: 01,3435           26026                           ADS      TIME3                         	#    SO T3 WONT TICK DURING UPDATE.
053643,000395: 01,3436           54734                           TS       RUPTAGN                       	#
053644,000396: 01,3437           45021                           CS       ZERO                          	#
053645,000397: 01,3440           54734                           TS       RUPTAGN                       	# SETS RUPTAGN TO +1 ON OVERFLOW.
053646,000398: 
053647,000399: 01,3441           00006                           EXTEND                                 	# DISPATCH TASK.
053648,000400: 01,3442           45305                           DCS      ENDTASK                       	#
053649,000401: 01,3443           53431                           DXCH     LST2       +16D               	#
053650,000402: 01,3444           53427                           DXCH     LST2       +14D               	#
053651,000403: 01,3445           53425                           DXCH     LST2       +12D               	#
053652,000404: 01,3446           53423                           DXCH     LST2       +10D               	#
053653,000405: 01,3447           53421                           DXCH     LST2       +8D                	#
053654,000406: 01,3450           53417                           DXCH     LST2       +6                 	#
053655,000407: 01,3451           53415                           DXCH     LST2       +4                 	#
053656,000408: 01,3452           53413                           DXCH     LST2       +2                 	#
053657,000409: 01,3453           53411                           DXCH     LST2                          	#
053658,000410: 
053659,000411: 01,3454           56001                           XCH      L                             	#
053660,000412: 01,3455           00006                           EXTEND                                 	#
053661,000413: 01,3456           01007                           WRITE    SUPERBNK                      	# SET SUPERBANK FROM BBCON OF 2CADR
053662,000414: 01,3457           56001                           XCH      L                             	# RESTORE TO L FOR DXCH Z.
053663,000415: 01,3460           52006                           DTCB                                   	#
053664,000416: 
053665,000417:                                                                                          	# Page 1232
053666,000418:                                                                                          	# RETURN, AFTER EXECUTION OF T3 OVERFLOW TASK:
053667,000419: 
053668,000420:    5324                                           BLOCK    02                            	#
053669,000421:    5324                                           COUNT    02/WAIT                       	#
053670,000422: 
053671,000423:    5324           10734        TASKOVER           CCS      RUPTAGN                       	# IF +1 RETURN TO T3RUPT, IF -0 RESUME.
053672,000424:    5325           35266                           CAF      WAITBB                        	#
053673,000425:    5326           54006                           TS       BBANK                         	#
053674,000426:    5327           13423                           TCF      T3RUPT2                       	# DISPATCH NEXT TASK IF IT WAS DUE.
053675,000427: 
053676,000428:    5330           30016                           CA       BANKRUPT                      	#
053677,000429:    5331           00006                           EXTEND                                 	#
053678,000430:    5332           01007                           WRITE    SUPERBNK                      	# RESTORE SUPERBANK BEFORE RESUME IS DONE
053679,000431: 
053680,000432:    5333           00006        RESUME             EXTEND                                 	#
053681,000433:    5334           22012                           QXCH     QRUPT                         	#
053682,000434:    5335           30016        NOQRSM             CA       BANKRUPT                      	#
053683,000435:    5336           56006                           XCH      BBANK                         	#
053684,000436:    5337           52011        NOQBRSM            DXCH     ARUPT                         	#
053685,000437:    5340           00003                           RELINT                                 	#
053686,000438:    5341           50017                           RESUME                                 	#
053687,000439: 
053688,000440:                                                                                          	# Page 1233
053689,000441:                                                                                          	# LONGCALL
053690,000442: 
053691,000443:                                                                                          	# PROGRAM DESCRIPTION                                 DATE- 17 MARCH 1967
053692,000444:                                                                                          	# PROGRAM WRITTEN BY W.H. VANDEVER                   LOG SECTION WAITLIST
053693,000445:                                                                                          	# MOD BY- R. MELANSON TO ADD DOCUMENTATION      ASSEMBLY SUNDISK REV. 100
053694,000446: 
053695,000447:                                                                                          	# FUNCTIONAL DESCRIPTION-
053696,000448:                                                                                          	# LONGCALL IS CALLED WITH THE DELTA TIME ARRIVING IN A,L SCALED AS TIME2,TIME1 WITH THE 2CADR OF THE TASK
053697,000449:                                                                                          	# IMMEDIATELY FOLLOWING THE TC LONGCALL.  FOR EXAMPLE, IT MIGHT BE DONE AS FOLLOWS WHERE TIMELOC IS THE NAME OF
053698,000450:                                                                                          	# A DP REGISTER CONTAINING A DELTA TIME AND WHERE TASKTODO IS THE NAME OF THE LOCATION AT WHICH LONGCALL IS TO
053699,000451:                                                                                          	# START
053700,000452: 
053701,000453:                                                                                          	# CALLING SEQUENCE-
053702,000454:                                                                                          	#               EXTEND
053703,000455:                                                                                          	#               DCA     TIMELOC
053704,000456:                                                                                          	#               TC      LONGCALL
053705,000457:                                                                                          	#               2CADR   TASKTODO
053706,000458: 
053707,000459:                                                                                          	# NORMAL EXIT MODE-
053708,000460:                                                                                          	#       1). TC          WAITLIST
053709,000461:                                                                                          	#       2). DTCB        (TC L+3 OF CALLING ROUTINE 1ST PASS THRU LONGCYCL)
053710,000462:                                                                                          	#       3). DTCB        (TO TASKOVER ON SUBSEQUENT PASSES THRU LONGCYCL)
053711,000463: 
053712,000464:                                                                                          	# ALARM OR ABORT EXIT MODE-
053713,000465:                                                                                          	#       NONE
053714,000466: 
053715,000467:                                                                                          	# OUTPUT-
053716,000468:                                                                                          	#       LONGTIME AND LONGTIME+1 = DELTA TIME
053717,000469:                                                                                          	#       LONGEXIT AND LONGEXIT+1 = RETURN 2CADR
053718,000470:                                                                                          	#       LONGCADR AND LONGCADR+1 = TASK 2CADR
053719,000471:                                                                                          	#       A = SINGLE PRECISION TIME FOR WAITLIST
053720,000472: 
053721,000473:                                                                                          	# ERASABLE INITIALIZATION-
053722,000474:                                                                                          	#       A = MOST SIGNIFICANT PART OF DELTA TIME
053723,000475:                                                                                          	#       L = LEAST SIGNIFICANT PART OF DELTA TIME
053724,000476:                                                                                          	#       Q = ADDRESS OF 2CADR TASK VALUE
053725,000477: 
053726,000478:                                                                                          	# DEBRIS-
053727,000479:                                                                                          	#       A,Q,L
053728,000480:                                                                                          	#       LONGCADR AND LONGCADR+1
053729,000481:                                                                                          	#       LONGEXIT AND LONGEXIT+1
053730,000482:                                                                                          	#       LONGTIME AND LONGTIME+1
053731,000483: 
053732,000484:                                                                                          	# *** THE FOLLOWING IS TO BE IN FIXED-FIXED AND UNSWITCHED ERRASIBLE ***
053733,000485: 
053734,000486:    5342                                           BLOCK    02                            	#
053735,000487:    5342  E3,1400                                  EBANK=   LST1                          	#
053736,000488:    5342           53140        LONGCALL           DXCH     LONGTIME                      	# OBTAIN THE DELTA TIME
053737,000489: 
053738,000490:    5343           00006                           EXTEND                                 	# OBTAIN THE 2CADR
053739,000491:                                                                                          	# Page 1234
053740,000492:    5344           50002                           NDX      Q                             	#
053741,000493:    5345           30001                           DCA      0                             	#
053742,000494:    5346           53134                           DXCH     LONGCADR                      	#
053743,000495: 
053744,000496:    5347           00006                           EXTEND                                 	# NOW GO TO THE APPROPRIATE SWITCHED BANK
053745,000497:    5350           35353                           DCA      LGCL2CDR                      	# FOR THE REST OF LONGCALL
053746,000498:    5351           52006                           DTCB                                   	#
053747,000499: 
053748,000500:    5352  E3,1400                                  EBANK=   LST1                          	#
053749,000501:    5352           03461 02063  LGCL2CDR           2CADR    LNGCALL2                      	#
053750,000502: 
053751,000503:                                                                                          	# *** THE FOLLOWING MAY BE IN A SWITCHED BANK, INCLUDING ITS ERASABLE ***
053752,000504: 
053753,000505: 01,3461                                           BANK     01                            	#
053754,000506: 01,3461                                           COUNT    01/WAIT                       	#
053755,000507: 
053756,000508: 01,3461           23435        LNGCALL2           LXCH     LONGEXIT   +1                 	# SAVE THE CORRECT BB FOR RETURN
053757,000509: 01,3462           35016                           CA       TWO                           	# OBTAIN THE RETURN ADDRESS
053758,000510: 01,3463           26002                           ADS      Q                             	#
053759,000511: 01,3464           55434                           TS       LONGEXIT                      	#
053760,000512: 
053761,000513:                                                                                          	# *** WAITLIST TASK LONGCYCL ***
053762,000514: 01,3465           00006        LONGCYCL           EXTEND                                 	# CAN WE SUCCESFULLY TAKE ABOUT 1.25
053763,000515: 01,3466           43477                           DCS      DPBIT14                       	# MINUTES OFF OF LONGTIME
053764,000516: 01,3467           21140                           DAS      LONGTIME                      	#
053765,000517: 
053766,000518: 01,3470           11140                           CCS      LONGTIME   +1                 	# THE REASONING BEHIND THIS PART IS
053767,000519: 01,3471           13510                           TCF      MUCHTIME                      	# INVOLVED, TAKING INTO ACCOUNT THAT THE
053768,000520:                                                                                          	# WORDS MAY NOT BE SIGNED CORRECTED (DP
053769,000521:                                                                                          	# BASIC INSTRUCTIONS
053770,000522:                                                                                          	# DO NOT SIGN CORRECT) AND THAT WE SUBTRAC-
053771,000523:                                                                                          	# TED BIT14 (1 OVER HALF THE POS. VALUE
053772,000524:                                                                                          	# REPRESENTABLE IN SINGLE WORD)
053773,000525: 01,3472           13473                           NOOP                                   	# CAN'T GET HERE **********
053774,000526: 01,3473           13474                           TCF      +1                            	#
053775,000527: 01,3474           11137                           CCS      LONGTIME                      	#
053776,000528: 01,3475           13510                           TCF      MUCHTIME                      	#
053777,000529: 01,3476           00000        DPBIT14            OCT      00000                         	#
053778,000530: 01,3477           20000                           OCT      20000                         	#
053779,000531: 
053780,000532:                                                                                          	# LONGCALL
053781,000533: 01,3500           35002        LASTTIME           CA       BIT14                         	# GET BACK THE CORRECT DELTA TFOR WAITLIST
053782,000534: 01,3501           27140                           ADS      LONGTIME   +1                 	#
053783,000535: 01,3502           05245                           TC       WAITLIST                      	#
053784,000536: 01,3503  E3,1400                                  EBANK=   LST1                          	#
053785,000537: 01,3503           03515 02063                     2CADR    GETCADR                       	# THE ENTRY TO OUR LONGCADR
053786,000538: 
053787,000539: 01,3505           33517        LONGRTRN           CA       TSKOVCDR                      	# SET IT UP SO THAT ONLY THE FIRST EXIT IS
053788,000540:                                                                                          	# Page 1235
053789,000541: 01,3506           53435                           DXCH     LONGEXIT                      	# TO THE CALLER OF LONGCALL
053790,000542: 01,3507           52006                           DTCB                                   	# THE REST ARE TO TASKOVER
053791,000543: 
053792,000544: 01,3510           35002        MUCHTIME           CA       BIT14                         	# WE HAVE OVER OUR ABOUT 1.25 MINUTES
053793,000545: 01,3511           05245                           TC       WAITLIST                      	# SO SET UP FOR ANOTHER CYCLE THROUGH HERE
053794,000546: 01,3512  E3,1400                                  EBANK=   LST1                          	#
053795,000547: 01,3512           03465 02063                     2CADR    LONGCYCL                      	#
053796,000548: 
053797,000549: 
053798,000550: 01,3514           13505                           TCF      LONGRTRN                      	# NOW EXIT PROPERLY
053799,000551: 
053800,000552:                                                                                          	# *** WAITLIST TASK GETCADR ***
053801,000553: 01,3515           53134        GETCADR            DXCH     LONGCADR                      	# GET THE LONGCALL THAT WE WISHED TO START
053802,000554: 01,3516           52006                           DTCB                                   	# AND TRANSFER CONTROL TO IT
053803,000555: 
053804,000556: 01,3517           05324        TSKOVCDR           GENADR   TASKOVER                      	#
(End of include-file WAITLIST.agc, resuming MAIN.agc)
053804,000145: 
053805,000146: $LATITUDE_LONGITUDE_SUBROUTINES.agc		        # pp. 1236-1242

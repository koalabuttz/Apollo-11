028501,000089:                                                                                          	# PROGRAM DESCRIPTION P30       DATE 3-6-67
028502,000090:                                                                                          	# MOD. I BY S. ZELDIN-  TO ADD P31 AND ADAPT P30 FOR P31 USE.   22DEC67
028503,000091: 
028504,000092:                                                                                          	# FUNCTIONAL DESCRIPTION
028505,000093:                                                                                          	#       +30     (EXTERNAL DELTA-V TARGETTING PROGRAM)
028506,000094:                                                                                          	#               ACCEPTS ASTRONAUT INPUTS OF TIG,DELV(LV) AND COMPUTES, FOR DISPLAY,
028507,000095:                                                                                          	#               APOGEE, PERIGEE, DELV(MAG), MGA ASSOCIATED WITH DESIRED MANEUVER
028508,000096:                                                                                          	#       P31     (GENERAL LAMBERT AIMPOINT GUIDANCE)
028509,000097:                                                                                          	#               A GROUND RULE FOR P31 IS THE ANGLE BETWEEN THE TARGET VECTOR AND
028510,000098:                                                                                          	#               POSITION VECTOR AT TIG IS NOT 165-195 DEGREES APART
028511,000099:                                                                                          	#               BASED ON STORED INPUT OF OFFSET TARGET(B+29) AND DELTA T TRANS, AND
028512,000100:                                                                                          	#               ASTRONAUT ENTRY OF TIG, P31 COMPUTES REQUIRED VELOCITY FOR MANEUVER
028513,000101:                                                                                          	#               AND, FOR DISPLAY, APOGEE, PERIGEE, DELV(7AG), +MGA ASSOCIATED WITH
028514,000102:                                                                                          	#               DESIRED MANEUVER
028515,000103: 

062646,000683: 07,3506           56071                           XCH      RUPTREG2                      	#
062647,000684: 07,3507           40000                           COM                                    	#
062648,000685: 07,3510           13363                           TCF      GMERGE                        	#
062649,000686: 
062650,000687: 07,3511           01700        GDESELCT           OCT      1700                          	# TURN OFF SELECT AND ACTIVITY BITS.

049752,000499:                                                                                          	# Page 1123
049753,000500:                                                                                          	# ROUTINES TO BEGIN PROCESSING OF THE SECOND ADDRESS ASSOCIATED WITH ALL STORE-TYPE CODES EXCEPT STORE
049754,000501:                                                                                          	# ITSELF.
049755,000502: 
049756,000503:    6427           37701        DODLOAD            CAF      DLOADCOD                      	#
049757,000504:    6430           54020                           TS       CYR                           	#

046744,000363: 
046746,000365:                                                                                          	#                               TABLE FOR ROLL, Y AND Z-TRANSLATION COMMANDS
046747,000366: 
046748,000367:                                                                                          	# EITHER AC OR BD ROLL MAY BE SELECTED.  IF AC ROLL IS SELECTED, Y-TRANSLATIONS MAY BE SATISFIED SIMULTANEOUSLY
046749,000368:                                                                                          	# PROVIDED THAT THERE ARE NO AC QUAD FAILURES.  IF THERE ARE AC FAILURES, Y-TRANSLATION COMMANDS WILL BE IGNORED,
046750,000369:                                                                                          	# IN WHICH CASE THE ASTRONAUT SHOULD SWITCH TO BD ROLL.
046751,000370: 
046752,000371:                                                                                          	# IF BDROLL IS SELECTED, Z-TRANSLATIONS MAY BE SATISFIED SIMULTANEOUSLY PROVIDED THAT THERE ARE NO BD QUAD
046753,000372:                                                                                          	# FAILURES.  IF THERE ARE BD FAILURES, Z-TRANSLATION COMMANDS WILL BE IGNORED, IN WHICH CASE THE ASTRONAUT SHOULD
046754,000373:                                                                                          	# SWITCH TO AC ROLL.
046755,000374: 
046756,000375:                                                                                          	# NOTE THAT IF ONE QUAD FAILS (E.G. B FAILED), Z-TRANSLATION IS STILL POSSIBLE AND THAT THE UNDESIREABLE ROLL
046757,000376:                                                                                          	# INTRODUCED BY THIS TRANSLATION WILL BE COMPENSATED BY THE TWO AC ROLL JETS ACTUATED BY THE AUTOPILOT LOGIC.
046758,000377: 
046759,000378:                                                                                          	#                                          WORD MAKE UP....RTABLE
046760,000379: 
046761,000380:                                                                                          	# TWO WORDS, CORRESPONDING TO AC OR BD ROLL SELECTION, HAVE BEEN COMBINED INTO ONE TABLE.  THE WORD CORRESPOND-
046762,000381:                                                                                          	# ING TO AC ROLL HAS THE FOLLOWING INTERPRETATION..
046763,000382: 
046764,000383:                                                                                          	#       BITS 9,10,11 ARE CODED TO GIVE THE NET ROLL TORQUE FOR THE WORD SELECTED.  THE CODING IS..
046765,000384: 
046766,000385:                                                                                          	#               BIT NO. 11  10   9              NO. OF ROLL JETS
046767,000386: 
046768,000387:                                                                                          	#                        0   0   0                      -2
046769,000388:                                                                                          	#                        0   0   1                      -1
046770,000389:                                                                                          	#                        0   1   0                       0
046771,000390:                                                                                          	#                        0   1   1                      +1
046772,000391:                                                                                          	#                        1   0   0                      +2
046773,000392: 
046774,000393:                                                                                          	# THIS WORD MAY THEN BE ADDED TO THE WORD SELECTED FROM THE YZ-TRANSLATION TABLE, WHICH HAS THE SAME TYPE OF
046775,000394:                                                                                          	# CODING AS ABOVE, AND THE NET ROLL DETERMINED BY SHIFTING THE RESULTANT WORD RIGHT 8 PLACES AND SUBTRACTING FOUR.
046776,000395: 
046777,000396:                                                                                          	# THE WORD CORRESPONDING TO BD ROLL HAS A SIMILIAR INTERPRETATION, EXCEPT THAT BITS 12, 13, 14 ARE CODED
046778,000397:                                                                                          	# (AS ABOVE) TO GIVE THE NET ROLL TORQUE.
046779,000398: 
046780,000399:                                                                                          	# ROLL          TRANS           QUADFAIL        BIAS
046781,000400: 
046782,000401: 17,3130           11000        RTABLE             OCT      11000                         	#   0                                             0
046783,000402: 17,3131           22125                           OCT      22125                         	#   +                                             0
046784,000403: 17,3132           00252                           OCT      00252                         	#   -                                             0
046785,000404: 17,3133           11231                           OCT      11231                         	#   0           +Y(+Z)                            3
046786,000405: 17,3134           15421                           OCT      15421                         	#   +           +Y(+Z)                            3
046787,000406: 17,3135           04610                           OCT      04610                         	#   -           +Y(+Z)                            3
046788,000407: 17,3136           11146                           OCT      11146                         	#   0           -Y(-Z)                            6
046789,000408: 17,3137           15504                           OCT      15504                         	#   +           -Y(-Z)                            6
046790,000409: 17,3140           04442                           OCT      04442                         	#   -           -Y(-Z)                            6
046791,000410: 17,3141           11000                           OCT      11000                         	#   0                             A(B)            9
046792,000411: 17,3142           15504                           OCT      15504                         	#   +                             A(B)            9
046793,000412: 17,3143           04610                           OCT      04610                         	#   -                             A(B)            9
046794,000413: 17,3144           11000                           OCT      11000                         	#   0                             C(D)           12
046795,000414: 17,3145           15421                           OCT      15421                         	#   +                             C(D)           12
046796,000415: 17,3146           04442                           OCT      04442                         	#   -                             C(D)           12
046797,000416: 
046799,000418:                                                                                          	# RTABLE MASKS-
046800,000419: 
046801,000420: 17,3147           03760        ACRJETS            OCT      03760                         	#
046802,000421: 17,3150           34017        BDRJETS            OCT      34017                         	#
046803,000422: 
046805,000424:                                                                                          	#                                        Y, Z TRANSLATION TABLE
046806,000425: 
046807,000426:                                                                                          	#    ONCE AC OR BD ROLL IS SELECTED THE QUAD PAIR WHICH IS NOT BEING USED TO SATISFY THE ROLL COMMANDS MAY BE
046808,000427:                                                                                          	# USED TO SATISFY THE REMAINING TRANSLATION COMMANDS.  HOWEVER, WE MUST MAKE SURE THAT ROLL COMMANDS ARE SATISFIED
046809,000428:                                                                                          	# WHEN THEY OCCUR.  THEREFORE, THE Y-Z TRANSLATIONS FROM THIS TABLE WILL BE IGNORED IF THE NET ROLL TORQUE OF THE
046810,000429:                                                                                          	# COMBINED WORD IS ZERO AND THE ROLL COMMANDS ARE NON-ZERO.  THIS SITUATION WOULD OCCUR, FOR EXAMPLE, IF WE EN-
046811,000430:                                                                                          	# COUNTER SIMULTANEOUS +R +Y -Z COMMANDS AND A QUAD D FAILURE WHILE USING AC FOR ROLL.
046812,000431:                                                                                          	#    TO FACILITATE THE LOGIC, THE Y-Z TRANSLATION TABLE HAS BEEN CODED IN A MANNER SIMILIAR TO THE ROLL TABLE
046813,000432:                                                                                          	# ABOVE.
046814,000433:                                                                                          	#    BITS 9,10,11 ARE CODED TO GIVE THE NET ROLL TORQUE INCURRED BY Z-TRANSLATIONS.  THE WORD SELECTED CAN THEN BE
046815,000434:                                                                                          	# ADDED TO THE AC-ROLL WORD AND THE RESULTANT ROLL TORQUE DETERMINED FROM THE COMBINED WORD.  SIMILIARLY BITS
046816,000435:                                                                                          	# 12,13,14 ARE CODED TO GIVE THE NET ROLL TORQUE INCURRED BY Y-TRANSLATIONS WHEN BD-ROLL IS SELECTED.
046817,000436: 
046818,000437:                                                                                          	# TRANSLATION   QUADFAIL        BIAS
046819,000438: 
046820,000439: 17,3151           11000        YZTABLE            OCT      11000                         	#       0                       0
046821,000440: 17,3152           11231                           OCT      11231                         	#    +Z(+Y)                     0
046822,000441: 17,3153           11146                           OCT      11146                         	#    -Z(-Y)                     0
046823,000442: 17,3154           11000                           OCT      11000                         	#       0         B(A)          3
046824,000443: 17,3155           04610                           OCT      04610                         	#    +Z(+Y)       B(A)          3
046825,000444: 17,3156           15504                           OCT      15504                         	#    -Z(-Y)       B(A)          3
046826,000445: 17,3157           11000                           OCT      11000                         	#       0         D(C)          6
046827,000446: 17,3160           15421                           OCT      15421                         	#    +Z(+Y)       D(C)          6
046828,000447: 17,3161           04442                           OCT      04442                         	#    -Z(-Y)       D(C)          6
046829,000448: 
046830,000449:                                                                                          	# YZ-TABLE MASKS-
046831,000450: 
046832,000451: 17,3162           03417        BDZJETS            OCT      03417                         	#
046833,000452: 17,3163           34360        ACYJETS            OCT      34360                         	#
046834,000453: 
046835,000454:                                                                                          	# ADDITIONAL CONSTANTS
046836,000455: 
046837,000456: 17,3164     7715               =-2                =        NEG2                          	#
046838,000457: 17,3164     6061               =-4                =        NEG4                          	#
046839,000458: 
046841,000460:                                                                                          	#                                       CALCULATION OF JET ON-TIMES
046842,000461: 
046843,000462:                                                                                          	#    THE ROTATION COMMANDS (TAU:S), WHICH WERE DETERMINED FROM THE JET SWITCHING LOGIC ON THE BASIS OF SINGLE JET
046844,000463:                                                                                          	# OPERATION, MUST NOW BE UPDATED BY THE ACTUAL NUMBER OF JETS TO BE USED IN SATISFYING THESE COMMANDS.  TAU MUST
046845,000464:                                                                                          	# ALSO BE DECREMENTED ACCORDING TO THE EXPECTED TORQUE GENERATED BY THE NEW COMMANDS ACTING OVER THE NEXT T5 INT-
046846,000465:                                                                                          	# ERVAL.
046847,000466:                                                                                          	#    IN ORDER TO MAINTAIN ACCURATE KNOWLEDGE OF VEHICLE ANGULAR RATES, WE MUST ALSO PROVIDE EXPECTED FIRING TIMES
046848,000467:                                                                                          	# (DFT:S, ALSO IN TERMS OF 1-JET OPERATION) FOR THE RATE FILTER.
046849,000468:                                                                                          	#    NOTE THAT TRANSLATIONS CAN PRODUCE ROTATIONS EVEN THOUGH NO ROTATIONS WERE CALLED FOR.  NEVERTHELESS, WE MUST
046850,000469:                                                                                          	# UPDATE DFT.
046851,000470:                                                                                          	#    WHEN THE ROTATIONS HAVE FINISHED, WE MUST PROVIDE CHANNEL INFORMATION TO THE T6 PROGRAM TO CONTINUE ON WITH
046852,000471:                                                                                          	# THE TRANSLATIONS.  THIS WILL BE DONE IN THE NEXT SECTION.  HOWEVER, TO INSURE THAT JETS ARE NOT FIRED FOR LESS
046853,000472:                                                                                          	# THAN A MINIMUM IMPULSE (14MS), ALL JET CHANNEL COMMANDS WILL BE HELD FIXED FROM THE START OF THE T5 PROGRAM FOR
046854,000473:                                                                                          	# AT LEAST 14MS UNTIL THE INITIALIZATION OF NEW COMMANDS.  MOREOVER, A 14MS ON-TIME WILL BE ADDED TO ANY ROTATIONAL
046855,000474:                                                                                          	# COMMANDS GENERATED BY THE MANUAL CONTROLS OR THE JET SWITCHING LOGIC, AND ALL TRANSLATION COMMANDS WILL BE
046856,000475:                                                                                          	# ACTIVE FOR AT LEAST ONE CYCLE OF THE T5 PROGRAM (.1SEC)
046857,000476: 
046858,000477:                                                                                          	#          PITCH JET ON-TIME CALCULATION
046859,000478: 
046860,000479: 17,3164           11562        PITCHTIM           CCS      TAU1                          	#
046861,000480: 17,3165           13174                           TCF      PTAUPOS                       	#
046862,000481: 17,3166           13170                           TCF      +2                            	#
046863,000482: 17,3167           13172                           TCF      PTAUNEG                       	#
046864,000483: 17,3170           55550                           TS       DFT1                          	# NO PITCH ROTATION
046865,000484: 17,3171           13372                           TCF      PBYPASS                       	# COMMANDS
046866,000485: 
046867,000486: 17,3172           41523        PTAUNEG            CS       NPJETS                        	#
046868,000487: 17,3173           55523                           TS       NPJETS                        	#
046869,000488: 17,3174           31562        PTAUPOS            CA       TAU1                          	#
046870,000489: 17,3175           00006                           EXTEND                                 	#
046871,000490: 17,3176           51523                           INDEX    NPJETS                        	#
046872,000491: 17,3177           73353                           MP       NJET                          	#

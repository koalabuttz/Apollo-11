061284,000076: 
061285,000077: 10,2451  40,3441               DSPMMJOB           EQUALS   DSPMMJB                       	#
061286,000078: 
061287,000079:    5372                                           BLOCK    02                            	#
061288,000080:                                                                                          	# Page 1405
061289,000081:    4000                                           SETLOC   FFTAG1                        	#
061290,000082:    4000                                           BANK                                   	#
061291,000083: 
061292,000084:                                                                                          	# Page 1406
061293,000085:                                                                                          	# PHASCHNG IS THE MAIN WAY OF MAKING PHASE CHANGES FOR RESTARTS.  THERE ARE THREE FORMS OF PHASCHNG, KNOWN AS TYPE
061294,000086:                                                                                          	# A, TYPE B, AND TYPE C.  THEY ARE ALL CALLED AS FOLLOWS, WHERE OCT XXXXX CONTAINS THE PHASE INFORMATION,
061295,000087: 
061296,000088:                                                                                          	#               TC      PHASCHNG
061297,000089:                                                                                          	#               OCT     XXXXX
061298,000090: 
061299,000091:                                                                                          	# TYPE A IS CONCERNED WITH FIXED PHASE CHANGES, THAT IS, PHASE INFORMATION THAT IS STORED PERMANENTLY.  THESE
061300,000092:                                                                                          	# OPTIONS ARE, WHERE G STANDS FOR A GROUP AND .X FOR THE PHASE,
061301,000093: 
061302,000094:                                                                                          	#       G.0             INACTIVE, WILL NOT PERMIT A GROUP G RESTART
061303,000095:                                                                                          	#       G.1             WILL CAUSE THE LAST DISPLAY TO BE REACTIVATED, USED MAINLY IN MANNED FLIGHTS
061304,000096:                                                                                          	#       G.EVEN          A DOUBLE TABLE RESTART, CAN CAUSE ANY COMBINATION OF TWO JOBS, TASKS, AND/OR
061305,000097:                                                                                          	#                       LONGCALL TO BE RESTARTED.
061306,000098:                                                                                          	#       G.ODD NOT .1    A SINGLE TABLE RESTART, CAN CAUSE EITHER A JOB, TASK, OR LONGCALL RESTART.
061307,000099: 
061308,000100:                                                                                          	# THIS INFORMATION IS PUT INTO THE OCTAL WORD AFTER TC PHASCHNG AS FOLLOWS
061309,000101: 
061310,000102:                                                                                          	#       TL0 00P PPP PPP GGG
061311,000103: 
061312,000104:                                                                                          	# WHERE EACH LETTER OR NUMBER STANDS FOR A BIT.  THE G:S STAND FOR THE GROUP, OCTAL 1-7, THE P:S FOR THE PHASE,
061313,000105:                                                                                          	# OCTAL 0 - 127.  0:S MUST BE 0.  IF ONE WISHES TO HAVE THE TBASE OF GROUP G TO BE SET AT THIS TIME,
061314,000106:                                                                                          	# T IS SET TO 1, OTHERWISE IT IS SET TO 0.  SIMILARLY IF ONE WISHES TO SET LONGBASE, THEN L IS SET TO 1, OTHERWISE
061315,000107:                                                                                          	# IT IS SET TO 0.  SOME EXAMPLES,
061316,000108: 
061317,000109:                                                                                          	#               TC      PHASCHNG        # THIS WILL CAUSE GROUP 3 TO BE SET TO 0,
061318,000110:                                                                                          	#               OCT     00003           # MAKING GROUP 3 INACTIVE
061319,000111: 
061320,000112:                                                                                          	#               TC      PHASCHNG        # IF A RESTART OCCURS THIS WOULD CAUSE
061321,000113:                                                                                          	#               OCT     00012           # GROUP 2 TO RESTART THE LAST DISPLAY
061322,000114: 
061323,000115:                                                                                          	#               TC      PHASCHNG        # THIS SETS THE TBASE OF GROUP 4 AND IN
061324,000116:                                                                                          	#               OCT     40064           # CASE OF A RESTART WOULD START UP THE TWO
061325,000117:                                                                                          	#                                       # THINGS LOCATED IN THE DOUBLE 4.6 RESTART
061326,000118:                                                                                          	#                                       # LOCATION.
061327,000119:                                                                                          	#               TC      PHASCHNG        # THIS SETS LONGBASE AND UPON A RESTART
061328,000120:                                                                                          	#               OCT     20135           # CAUSES 5.13 TO BE RESTARTED (SINCE
061329,000121:                                                                                          	#                                       # LONGBASE WAS SET THIS SINGLE ENTRY
061330,000122:                                                                                          	#                                       # SHOULD BE A LONGCALL)
061331,000123:                                                                                          	#               TC      PHASCHNG        # SINCE BOTH TBASE4 AND LONGBASE ARE SET,
061332,000124:                                                                                          	#               OCT     60124           # 4.12 SHOULD CONTAIN BOTH A TASK AND A
061333,000125:                                                                                          	#                                       # LONGCALL TO BE RESTARTED
061334,000126: 
061335,000127:                                                                                          	# TYPE C PHASCHNG CONTAINS THE VARIABLE TYPE OF PHASCHNG INFORMATION.  INSTEAD OF THE INFORMATION BEING IN A
061336,000128:                                                                                          	# PERMANENT FORM, ONE STORES THE DESIRED RESTART INFORMATION IN A VARIABKE LOCATION.  THE BITS ARE AS FOLLOWS,
061337,000129: 
061338,000130:                                                                                          	#       TL0 1AD XXX CJW GGG
061339,000131: 
061340,000132:                                                                                          	# WHERE EACH LETTER OR NUMBER STANDS FOR A BIT.  THE G:S STAND FOR THE GROUP, OCTAL 1 - 7.  IF THE RESTART IS TO
061341,000133:                                                                                          	# BE BY WAITLIST, W IS SET TO 1, IF IT IS A JOB, J IS SET TO 1, IF IT IS A LONGCALL, C IS SET TO 1.  ONLY ONE OF
061342,000134:                                                                                          	# THESE THREE BITS MAY BE SET.  X:S ARE IGNORED  1 MUST BE 1, AND 0 MUST BE 0.  AGAIN T STANDS FOR THE TBASE,
061343,000135:                                                                                          	# Page 1407
061344,000136:                                                                                          	# AND L FOR LONGBASE.  THE BITS A AND D ARE CONCERNED WITH THE VARIABLE INFORMATION.  IF D IS SET TO 1, A PRIORITY
061345,000137:                                                                                          	# OR DELTA TIME WILL BE READ FROM THE NEXT LOCATION AFTER THE OCTAL INFORMATION, IF THIS IS TO BE INDIRECT, THAT
061346,000138:                                                                                          	# IS, THE NAME OF A LOCATION COMT+INING THE INFORMATION (DELTA TIME ONLY), THEN THIS IS GIVEN AS THE -GENADR OF
061347,000139:                                                                                          	# THAT LOCATION WHICH CONTAINS THE DELTA TIME.  IF THE OLD PRIORITY OR DELTA TIME IS TO BE USED, THAT WHICH IS
061348,000140:                                                                                          	# ALREADY IN THE VARIABLE STORAGE, THEN D IS SET TO 0.  NEXT THE A BIT IS USED.  IF IT IS SET TO 0, THE ADDRESS
061349,000141:                                                                                          	# THAT WOULD BE RESTARTED DURING A RESTART IS THE NEXT LOCATION AFTER THE PHASE INFORMATION, THAT IS, EITHER
061350,000142:                                                                                          	# (TC PHASCHNG) +2 OR +3, DEPENDING ON WHETHER D HAD BEEN SET OR NOT.  IF A IS SET TO 1, THEN THE ADDRESS THAT
061351,000143:                                                                                          	# WOULD BE RESTARTED IS THE 2CADR THAT IS READ FROM THE NEXT TWO LOCATIONS.  EXAMPLES,
061352,000144: 
061353,000145:                                                                                          	#       AD      TC      PHASCHNG        # THIS WOULD CAUSE LOCATION AD +3 TO BE
061354,000146:                                                                                          	#       AD+1    OCT     05023           # RESTARTED BY GROUP THREE WITHA PRIORITY
061355,000147:                                                                                          	#       AD+2    OCT     23000           # OF 23.  NOTE UPON RETURNING IT WOULD
061356,000148:                                                                                          	#       AD+3                            # ALSO GO TO AD+3
061357,000149: 
061358,000150:                                                                                          	#       AD      TC      PHASCHNG        # GROUP 1 WOULD CAUSE CALLCALL TO BE
061359,000151:                                                                                          	#       AD+1    OCT     27441           # BE STARTED AS A LONGCALL FROM THE TIME
061360,000152:                                                                                          	#       AD+2    -GENADR DELTIME         # STORED IN LONGBASE (LONGBASE WAS SET) BY
061361,000153:                                                                                          	#       AD+3    2CADR   CALLCALL        # A DELTATIME STORED IN DELTIME.  THE
061362,000154:                                                                                          	#       AD+4                            # BBCON OF THE 2CADR SHOULD CONTAIN THE E
061363,000155:                                                                                          	#       AD+5                            # BANK OF DELTIME.  PHASCHNG RETURNS TO
061364,000156:                                                                                          	#                                       # LOCATION AD+5
061365,000157: 
061366,000158:                                                                                          	# NOTE THAT IF A VARIABLE PRIORITY IS GIVEN FOR A JOB, THE JOB WILL BE RESTARTED AS A NOVAC IF THE PRIORITY IS
061367,000159:                                                                                          	# NEGATIVE, AS A FINDVAC IF THE PRIORITY IS POSITIVE.
061368,000160: 
061369,000161:                                                                                          	# TYPE B PHASCHNG IS A COMBINATION OF VARIABLE AND FIXED PHASE CHANGES.  IT WILL START UP A JOB AS INDICATED
061370,000162:                                                                                          	# BELOW AND ALSO START UP ONE FIXED RESTART, THAT IS EITHER AN G.1 OR A G.ODD OR THE FIRST ENTRY OF G.EVEN
061371,000163:                                                                                          	# DOUBLE ENTRY.  THE BIT INFORMATION IS AS FOLLOWS,
061372,000164: 
061373,000165:                                                                                          	#       TL1 DAP PPP PPP GGG
061374,000166: 
061375,000167:                                                                                          	# WHERE EACH LETTER OR NUMBER STANDS FOR A BIT.  THE G:S STAND FOR THE GROUP, OCTAL 1 - 7. THE P:S FOR THE FIXED
061376,000168:                                                                                          	# PHASE INFORMATION, OCTAL 0 - 127.  1 MUST BE 1.  AND AGAIN T STANDS FOR THE TBASE AND L FOR LONGBASE.  D THIS
061377,000169:                                                                                          	# TIME STANDS ONLY FOR PRIORITY SINCE THIS WILL BE CONSIDERED A JOB, AND IT MUST BE GIVEN DIRECTLY IF GIVEN.
061378,000170:                                                                                          	# AGAIN A STANDS FOR THE ADDRESS OF THE LOCATION TO BE RESTARTED, 1 IF THE 2CADR IS GIVEN, OR 0 IF IT IS TO BE
061379,000171:                                                                                          	# THE NEXT LOCATION.(THE RETURN LOCATION OF PHASCHNG) EXAMPLES,
061380,000172:                                                                                          	#       AD      TC      PHASCHNG        # TBASE IS SET AND A RESTART CAUSE GROUP 3
061381,000173:                                                                                          	#       AD+1    OCT     56043           # TO START THE JOB AJOBAJOB WITH PRIORITY
061382,000174:                                                                                          	#       AD+2    OCT     31000           # 31 AND THE FIRST ENTRY OF 3.4SPOT (WE CAN
061383,000175:                                                                                          	#       AD+3    2CADR   AJOBAJOB        # ASSUME IT IS A TASK SINCE WE SET TBASE3)
061384,000176:                                                                                          	#       AD+4                            # UPON RETURN FROM PHASCHNG CONTROL WOULD
061385,000177:                                                                                          	#       AD+5                            # GO TO AD+5
061386,000178: 
061387,000179:                                                                                          	#       AD      TC      PHASCHNG        # UPON A RESTART THE LAST DISPLAY WOULD BE
061388,000180:                                                                                          	#       AD+1    OCT     10015           # RESTARTED AND A JOB WITH THE PREVIOUSLY
061389,000181:                                                                                          	#       AD+2                            # STORED PRIORITY WOULD BE BEGUN AT AD+2
061390,000182:                                                                                          	#                                       # BY MEANS OF GROUP 5
061391,000183:                                                                                          	# Page 1408
061392,000184:                                                                                          	# THE NOVAC-FINDVAC CHOICE FOR JOBS HOLDS HERE ALSO - NEGATIVE PRIORITY CAUSES A NOVAC CALL, POSITIVE A FINDVAC.
061393,000185: 
061394,000186: 
061395,000187:                                                                                          	# SUMMARY OF BITS:
061396,000188:                                                                                          	#       TYPE A          TL0 00P PPP PPP GGG
061397,000189:                                                                                          	#       TYPE B          TL1 DAP PPP PPP GGG
061398,000190:                                                                                          	#       TYPE C          TL0 1AD XXX CJW GGG
061399,000191: 
061400,000192:                                                                                          	# Page 1409
061401,000193:                                                                                          	# 2PHSCHNG IS USED WHEN ONE WISHES TO START UP A GROUP OR CHANGE A GROUP WHILE UNDER THE CONTROL OF A DIFFERENT
061402,000194:                                                                                          	# GROUP.  FOR EXAMPLE, CHANGE THE PHASE OF GROUP 3 WHILE THE PORTION OF THE PROGRAM IS UNDER GROUP 5.  ALL 2PHSCHNG
061403,000195:                                                                                          	# CALLS ARE MADE IN THE FOLLOWING MANNER,
061404,000196: 
061405,000197:                                                                                          	#               TC      2PHSCHNG
061406,000198:                                                                                          	#               OCT     XXXXX
061407,000199:                                                                                          	#               OCT     YYYYY
061408,000200: 
061409,000201:                                                                                          	# WHERE OCT XXXXX MUST BE OF TYPE A AND OCT YYYYY MAY BE OF EITHER TYPE A OR TYPE B OR TYPEC.  THERE IS ONE
061410,000202:                                                                                          	# DIFFERENCE --- NOTE- IF LONGBASE IS TO BE SET THIS INFORMATION IS GIVEN IN THE OCT YYYYY INFORMATION, IT WILL
061411,000203:                                                                                          	# BE DISREGARDED IF GIVEN WITH THE OCT XXXXX INFORMATION.  A COUPLE OF EXAMPLES MAY HELP.
061412,000204: 
061413,000205:                                                                                          	#       AD      TC      2PHACHNG        # SET TBASE3 AND IF A RESTART OCCURS START
061414,000206:                                                                                          	#       AD+1    OCT     40083           # THE TWO ENTRIES IN 3.8 TABLE LOCATION
061415,000207:                                                                                          	#       AD+2    OCT     05025           # THIS IS OF TYPE C. SET THE JOB TO BE
061416,000208:                                                                                          	#       AD+3    OCT     18000           # TO BE LOCATION AD+4, WITH A PRIORITY 18,
061417,000209:                                                                                          	#       AD+4                            # FOR GROUP 5 PHASE INFORMATION.
061418,000210: 
061419,000211:    5372                                           COUNT    02/PHASE                      	#
061420,000212: 
061421,000213:    5372           00004        2PHSCHNG           INHINT                                 	# THE ENTRY FOR A DOUBLE PHASE CHANGE
061422,000214:    5373           50002                           NDX      Q                             	#
061423,000215:    5374           30000                           CA       0                             	#
061424,000216:    5375           24002                           INCR     Q                             	#
061425,000217:    5376           54072                           TS       TEMPP2                        	#
061426,000218: 
061427,000219:    5377           75023                           MASK     OCT7                          	#
061428,000220:    5400           60000                           DOUBLE                                 	#
061429,000221:    5401           54071                           TS       TEMPG2                        	#
061430,000222: 
061431,000223:    5402           30072                           CA       TEMPP2                        	#
061432,000224:    5403           75072                           MASK     OCT17770                      	# NEED ONLY 1770, BUT WHY GET A NEW CONST.
061433,000225:    5404           00006                           EXTEND                                 	#
061434,000226:    5405           75004                           MP       BIT12                         	#
061435,000227:    5406           56072                           XCH      TEMPP2                        	#
061436,000228: 
061437,000229:    5407           75001                           MASK     BIT15                         	#
061438,000230:    5410           54066                           TS       TEMPSW2                       	# INDICATES WHETHER TO SET TBASE OR NOT
061439,000231: 
061440,000232:    5411           15415                           TCF      PHASCHNG   +3                 	#
061441,000233: 
061442,000234:    5412           00004        PHASCHNG           INHINT                                 	#
061443,000235:    5413           35017                           CA       ONE                           	# INDICATESWE CAME FROM A PHASCHNG ENTRY
061444,000236:    5414           54066                           TS       TEMPSW2                       	#
061445,000237: 
061446,000238:    5415           50002                           NDX      Q                             	#
061447,000239:    5416           30000                           CA       0                             	#
061448,000240:    5417           24002                           INCR     Q                             	#
061449,000241:    5420           54065                           TS       TEMPSW                        	#
061450,000242:                                                                                          	# Page 1410
061451,000243:    5421           00006                           EXTEND                                 	#
061452,000244:    5422           35425                           DCA      ADRPCHN2                      	# OFF TO SWITCHED BANK
061453,000245:    5423           52006                           DTCB                                   	#
061454,000246: 
061455,000247:    5424  E3,1400                                  EBANK=   LST1                          	#
061456,000248:    5424           02451 20063  ADRPCHN2           2CADR    PHSCHNG2                      	#
061457,000249: 
061458,000250:    5426           22073        ONEORTWO           LXCH     TEMPBBCN                      	#
061459,000251:    5427           22006                           LXCH     BBANK                         	#
061460,000252:    5430           22073                           LXCH     TEMPBBCN                      	#
061461,000253: 
061462,000254:    5431           75066                           MASK     OCT14000                      	# SEE WHAT KIND OF PHASE CHANGE IT IS
061463,000255:    5432           10000                           CCS      A                             	#
061464,000256:    5433           15474                           TCF      CHECKB                        	# IT IS OF TYPE :B:
061465,000257: 
061466,000258:    5434           30062                           CA       TEMPP                         	#
061467,000259:    5435           75011                           MASK     BIT7                          	#
061468,000260:    5436           10000                           CCS      A                             	# SHALL WE USE THE OLD PRIORITY
061469,000261:    5437           15461                           TCF      GETPRIO                       	# NO GET A NEW PRIORITY (OR DELTA T)
061470,000262: 
061471,000263:    5440           50061        OLDPRIO            NDX      TEMPG                         	# USE THE OLD PRIORITY (OR DELTA T)
061472,000264:    5441           31052                           CA       PHSPRDT1   -2                 	#
061473,000265:    5442           54070                           TS       TEMPPR                        	#
061474,000266: 
061475,000267:    5443           30062        CON1               CA       TEMPP                         	# SEE IF A 2CADR IS GIVEN
061476,000268:    5444           75010                           MASK     BIT8                          	#
061477,000269:    5445           10000                           CCS      A                             	#
061478,000270:    5446           15465                           TCF      GETNEWNM                      	#
061479,000271: 
061480,000272:    5447           30002                           CA       Q                             	#
061481,000273:    5450           54063                           TS       TEMPNM                        	#
061482,000274:    5451           30006                           CA       BB                            	#
061483,000275:    5452           00006                           EXTEND                                 	# PICK UP USERS SUPERBANK
061484,000276:    5453           04007                           ROR      SUPERBNK                      	#
061485,000277:    5454           54064                           TS       TEMPBB                        	#
061486,000278: 
061487,000279:    5455           35460        TOCON2             CA       CON2ADR                       	# BACK TO SWITCHED BANK
061488,000280:    5456           22073                           LXCH     TEMPBBCN                      	#
061489,000281:    5457           52006                           DTCB                                   	#
061490,000282: 
061491,000283:    5460           02537        CON2ADR            GENADR   CON2                          	#
061492,000284: 
061493,000285:    5461           50002        GETPRIO            NDX      Q                             	# DON:T CARE IF DIRECT OR INDIRECT
061494,000286:    5462           30000                           CA       0                             	# LEAVE THAT DECISION TO RESTARTS
061495,000287:    5463           24002                           INCR     Q                             	# OBTAIN RETURN ADDRESS
061496,000288:    5464           15442                           TCF      CON1       -1                 	#
061497,000289: 
061498,000290:    5465           00006        GETNEWNM           EXTEND                                 	#
061499,000291:                                                                                          	# Page 1411
061500,000292:    5466           50002                           INDEX    Q                             	#
061501,000293:    5467           30001                           DCA      0                             	#
061502,000294:    5470           52064                           DXCH     TEMPNM                        	#
061503,000295:    5471           35016                           CA       TWO                           	#
061504,000296:    5472           26002                           ADS      Q                             	# OBTAIN RETURN ADDRESS
061505,000297: 
061506,000298:    5473           15455                           TCF      TOCON2                        	#
061507,000299: 
061508,000300:    5474     5066               OCT14000           EQUALS   PRIO14                        	#
061509,000301:    5474     0061               TEMPG              EQUALS   ITEMP1                        	#
061510,000302:    5474     0062               TEMPP              EQUALS   ITEMP2                        	#
061511,000303:    5474     0063               TEMPNM             EQUALS   ITEMP3                        	#
061512,000304:    5474     0064               TEMPBB             EQUALS   ITEMP4                        	#
061513,000305:    5474     0065               TEMPSW             EQUALS   ITEMP5                        	#
061514,000306:    5474     0066               TEMPSW2            EQUALS   ITEMP6                        	#
061515,000307:    5474     0070               TEMPPR             EQUALS   RUPTREG1                      	#
061516,000308:    5474     0071               TEMPG2             EQUALS   RUPTREG2                      	#
061517,000309:    5474     0072               TEMPP2             EQUALS   RUPTREG3                      	#
061518,000310: 
061519,000311:    5474     0073               TEMPBBCN           EQUALS   RUPTREG4                      	#
061520,000312:    5474  0000006               BB                 EQUALS   BBANK                         	#
061521,000313: 
061522,000314: 14,3761                                           BANK     14                            	#
061523,000315: 10,2000                                           SETLOC   PHASETAB                      	#
061524,000316: 10,2000                                           BANK                                   	#
061525,000317: 
061526,000318: 10,2451  E3,1436                                  EBANK=   PHSNAME1                      	#
061527,000319: 10,2451                                           COUNT    10/PHASE                      	#
061528,000320: 
061529,000321: 10,2451           22073        PHSCHNG2           LXCH     TEMPBBCN                      	#
061530,000322: 10,2452           30065                           CA       TEMPSW                        	#
061531,000323: 10,2453           75023                           MASK     OCT7                          	#
061532,000324: 10,2454           60000                           DOUBLE                                 	#
061533,000325: 10,2455           54061                           TS       TEMPG                         	#
061534,000326: 
061535,000327: 10,2456           30065                           CA       TEMPSW                        	#
061536,000328: 10,2457           75072                           MASK     OCT17770                      	#
061537,000329: 10,2460           00006                           EXTEND                                 	#
061538,000330: 10,2461           75004                           MP       BIT12                         	#
061539,000331: 10,2462           54062                           TS       TEMPP                         	#
061540,000332: 
061541,000333: 10,2463           30065                           CA       TEMPSW                        	#
061542,000334: 10,2464           74105                           MASK     OCT60000                      	#
061543,000335: 10,2465           56065                           XCH      TEMPSW                        	#
061544,000336: 10,2466           75066                           MASK     OCT14000                      	#
061545,000337: 10,2467           10000                           CCS      A                             	#
061546,000338: 10,2470           15426                           TCF      ONEORTWO                      	#
061547,000339: 
061548,000340:                                                                                          	# Page 1412
061549,000341: 10,2471           30062                           CA       TEMPP                         	# START STORING THE PHASE INFORMATION
061550,000342: 10,2472           50061                           NDX      TEMPG                         	#
061551,000343: 10,2473           54751                           TS       PHASE1     -2                 	#
061552,000344: 
061553,000345: 10,2474           10066        BELOW1             CCS      TEMPSW2                       	# IS IT A PHASCHNG OR A 2PHSCHNG
061554,000346: 10,2475           12511                           TCF      BELOW2                        	# IT:S A PHASCHNG
061555,000347: 
061556,000348: 10,2476           12477                           TCF      +1                            	# IT:S A 2PHSCHNG
061557,000349: 10,2477           40072                           CS       TEMPP2                        	#
061558,000350: 10,2500           22072                           LXCH     TEMPP2                        	#
061559,000351: 10,2501           50071                           NDX      TEMPG2                        	#
061560,000352: 10,2502           52751                           DXCH     -PHASE1    -2                 	#
061561,000353: 
061562,000354: 10,2503           10066                           CCS      TEMPSW2                       	#
061563,000355: 10,2504           12505                           NOOP                                   	# CAN:T GET HERE
061564,000356: 10,2505           12511                           TCF      BELOW2                        	#
061565,000357: 
061566,000358: 10,2506           40025                           CS       TIME1                         	#
061567,000359: 10,2507           50071                           NDX      TEMPG2                        	#
061568,000360: 10,2510           55051                           TS       TBASE1     -2                 	#
061569,000361: 
061570,000362: 10,2511           10065        BELOW2             CCS      TEMPSW                        	# SEE IF WE SHOULD SET TBASE OR LONGBASE
061571,000363: 10,2512           12525                           TCF      BELOW3                        	# SET LONGBASE ONLY
061572,000364: 10,2513           12530                           TCF      BELOW4                        	# SET NEITHER
061573,000365: 
061574,000366: 10,2514           40025                           CS       TIME1                         	# SET TBASE TO BEGIN WITH
061575,000367: 10,2515           50061                           NDX      TEMPG                         	#
061576,000368: 10,2516           55051                           TS       TBASE1     -2                 	#
061577,000369: 
061578,000370: 10,2517           30065                           CA       TEMPSW                        	# SHALL WE NOW SET LONGBASE
061579,000371: 10,2520           62523                           AD       BIT14COM                      	#
061580,000372: 10,2521           10000                           CCS      A                             	#
061581,000373: 10,2522           12523                           NOOP                                   	# ***** CAN'T GET HERE *****
061582,000374: 10,2523           17777        BIT14COM           OCT      17777                         	# ***** CAN'T GET HERE *****
061583,000375: 10,2524           12530                           TCF      BELOW4                        	# NO WE NEED ONLY SET TBASE
061584,000376: 
061585,000377: 10,2525           00006        BELOW3             EXTEND                                 	# SET LONGBASE
061586,000378: 10,2526           30025                           DCA      TIME2                         	#
061587,000379: 10,2527           53136                           DXCH     LONGBASE                      	#
061588,000380: 
061589,000381: 10,2530           40062        BELOW4             CS       TEMPP                         	# AND STORE THE FINAL PART OF THE PHASE
061590,000382: 10,2531           50061                           NDX      TEMPG                         	#
061591,000383: 10,2532           54750                           TS       -PHASE1    -2                 	#
061592,000384: 
061593,000385: 10,2533           30002                           CA       Q                             	#
061594,000386: 10,2534           22073                           LXCH     TEMPBBCN                      	#
061595,000387: 10,2535           00003                           RELINT                                 	#
061596,000388: 10,2536           52006                           DTCB                                   	#
061597,000389: 10,2537           22073        CON2               LXCH     TEMPBBCN                      	#
061598,000390:                                                                                          	# Page 1413
061599,000391: 10,2540           30062                           CA       TEMPP                         	#
061600,000392: 10,2541           50061                           NDX      TEMPG                         	#
061601,000393: 10,2542           54751                           TS       PHASE1     -2                 	#
061602,000394: 
061603,000395: 10,2543           30070                           CA       TEMPPR                        	#
061604,000396: 10,2544           50061                           NDX      TEMPG                         	#
061605,000397: 10,2545           55052                           TS       PHSPRDT1   -2                 	#
061606,000398: 
061607,000399: 10,2546           00006                           EXTEND                                 	#
061608,000400: 10,2547           30064                           DCA      TEMPNM                        	#
061609,000401: 10,2550           50061                           NDX      TEMPG                         	#
061610,000402: 10,2551           53435                           DXCH     PHSNAME1   -2                 	#
061611,000403: 
061612,000404: 10,2552           12474                           TCF      BELOW1                        	#
061613,000405: 
061614,000406:    5474                                           BLOCK    02                            	#
061615,000407:    4000                                           SETLOC   FFTAG1                        	#
061616,000408:    4000                                           BANK                                   	#
061617,000409: 
061618,000410:    5474                                           COUNT    02/PHASE                      	#
061619,000411: 
061620,000412:    5474           75004        CHECKB             MASK     BIT12                         	# SINCE THIS IS OF TYPE B, THIS BIT SHOULD
061621,000413:    5475           10000                           CCS      A                             	# BE HERE IF WE ARE TO GET A NEW PRIORITY
061622,000414:    5476           15461                           TCF      GETPRIO                       	# IT IS, SO GET NEW PRIORITY
061623,000415: 
061624,000416:    5477           15440                           TCF      OLDPRIO                       	# IT ISN:T, USE THE OLD PRIORITY
(End of include-file PHASE_TABLE_MAINTENANCE.agc, resuming MAIN.agc)

032929,000046: 
032931,000048:                                                                                          	# PROGRAM NAME - PROG52                 DATE - NOV 30, 1966
032932,000049:                                                                                          	# MOD NO - 2                                    LOG SECTION - P51-P53
032933,000050:                                                                                          	# MODIFICATION BY - LONSKE                      ASSEMBLY - SUNDISK REV 30
032934,000051: 
032935,000052:                                                                                          	# FUNCTIONAL DESCRIPTION -
032936,000053: 
032937,000054:                                                                                          	#       ALIGNS THE IMU TO ONE OF THREE ORIENTATIONS SELECTED BY THE ASTRONAUT.  THE PRESENT IMU ORIENTATION IS KNOWN
032938,000055:                                                                                          	#       AND IS STORED IN REFSMMAT.  THE THREE POSSIBLE ORIENTATIONS MAY BE_
032939,000056: 
032940,000057:                                                                                          	#       (A)     PREFERRED ORIENTATION
032941,000058: 
032942,000059:                                                                                          	#               AN OPTIMUM ORIENTATION FOR A PREVIOUSLY CALCULATED MANUEVER.  THIS ORIENTATION MUST BE CALCULATED AND
032943,000060:                                                                                          	#               STORED BY A PREVIOUSLY SELECTED PROGRAM.
032944,000061: 
032945,000062:                                                                                          	#       (B)     NOMINAL ORIENTATION
032946,000063: 
032947,000064:                                                                                          	#               X   = UNIT ( Y   X Z   )
032948,000065:                                                                                          	#               -SM          -SM   -SM
032949,000066: 
032950,000067:                                                                                          	#               Y   = UNIT (V X R)
032951,000068:                                                                                          	#               -SM         -   -
032952,000069: 
032953,000070:                                                                                          	#               Z   = UNIT ( -R )
032954,000071:                                                                                          	#               -SM           -
032955,000072: 
032956,000073:                                                                                          	#               WHERE_
032957,000074: 
032958,000075:                                                                                          	#               R = THE GEOCENTRIC RADIUS VECTOR AT TIME T(ALIGN) SELECTED BY THE ASTRONAUT
032959,000076:                                                                                          	#               -
032960,000077: 
032961,000078:                                                                                          	#               V = THE INERTIAL VELOCITY VECTOR AT TIME T(ALIGN) SELECTED BY THE ASTRONAUT
032962,000079:                                                                                          	#               -
032963,000080: 
032964,000081:                                                                                          	#       (C)     REFSMMAT ORIENTATION
032965,000082: 
032966,000083:                                                                                          	#               THIS SELECTION CORRECTS THE PRESENT IMU ORIENTATION.  THE PRESENT ORIENTATION DIFFERS FROM THAT TO WHICH IT
032967,000084:                                                                                          	#               WAS LAST ALIGNED ONLY DUE TO GYRO DRIFT (I.E. NEITHER GIMBAL LOCK NOR IMU POWER INTERRUPTION HAS OCCURED
032968,000085:                                                                                          	#               SINCE THE LAST ALIGNMENT).
032969,000086: 
032970,000087:                                                                                          	#       AFTER A IMU ORIENTATION HAS BEEN SELECTED ROUTINE S52.2 IS OPERATED TO COMPUTE THE GIMBAL ANGLES USING THE
032971,000088:                                                                                          	#       NEW ORIENTATION AND THE PRESENT VEHICLE ATTITUDE.  CAL52A THEN USES THESE ANGLES, STORED IN THETAD,+1,+2, TO
032972,000089:                                                                                          	#       COARSE ALIGN THE IMU.  THE STAR SELECTION ROUTINE, R56, IS THEN OPERATED.  IF 2 STARS ARE NOT AVAILABLE AN ALARM
032973,000090:                                                                                          	#       IS FLASHED TO NOTIFY THE ASTRONAUT.  AT THIS POINT THE ASTRONAUT WILL MANUEVER THE VEHICLE AND SELECT 2 STARS
032974,000091:                                                                                          	#       EITHER MANUALLY OR AUTOMATICALLY.  AFTER 2 STARS HAVE BEEN SELECTED THE IMU IS FINE ALIGNED USING ROUTINE R51.  IF
032975,000092:                                                                                          	#       THE RENDEZVOUS NAVIGATION PROCESS IS OPERATING (INDICATED BY RNDVZFLG) P20 IS DISPLAYED.  OTHERWISE P00 IS
032976,000093:                                                                                          	#       REQUESTED.
032977,000094: 
032978,000095:                                                                                          	# CALLING SEQUENCE -
032979,000096: 
032980,000097:                                                                                          	#       THE PROGRAM IS CALLED BY THE ASTRONAUT BY DSKY ENTRY.
032982,000099: 
032983,000100:                                                                                          	# SUBROUTINES CALLED -
032984,000101: 
032985,000102:                                                                                          	#       1. FLAGDOWN              7. S52.2               13. NEWMODEX
032986,000103:                                                                                          	#       2. R02BOTH               8. CAL53A              14. PRIOLARM
032987,000104:                                                                                          	#       3. GOPERF4               9. FLAGUP
032988,000105:                                                                                          	#       4. MATMOVE              10. R56
032989,000106:                                                                                          	#       5. GOFLASH              11. R51
032990,000107:                                                                                          	#       6. S52.3                12. GOPERF3
032991,000108: 
032992,000109:                                                                                          	# NORMAL EXIT MODES -
032993,000110: 
032994,000111:                                                                                          	#       EXITS TO ENDOFJOB
032995,000112: 
032996,000113:                                                                                          	# ALARM OR ABORT EXIT MODES -
032997,000114: 
032998,000115:                                                                                          	#       NONE
032999,000116: 
033000,000117:                                                                                          	# OUTPUT -
033001,000118: 
033002,000119:                                                                                          	#       THE FOLLOWING MAY BE FLASHED ON THE DSKY
033003,000120:                                                                                          	#               1. IMU ORIENTATION CODE
033004,000121:                                                                                          	#               2. ALARM CODE 215 - PREFERRED IMU ORIENTATION NOT SPECIFIED
033005,000122:                                                                                          	#               3. TIME OF NEXT IGNITION
033006,000123:                                                                                          	#               4. GIMBAL ANGLES
033007,000124:                                                                                          	#               5. ALARM CODE 405 - TWO STARS NOT AVAILABLE
033008,000125:                                                                                          	#               6. PLEASE PERFORM P00
033009,000126:                                                                                          	#       THE MODE DISPLAY MAY BE CHANGED TO 20
033010,000127: 
033011,000128:                                                                                          	# ERASABLE INITIALIZATION REQUIRED -
033012,000129: 
033013,000130:                                                                                          	#       PFRATFLG SHOULD BE SET IF A PREFERRED ORIENTATION HAS BEEN COMPUTED.  IF IT HAS BEEN COMPUTED IT IS STORED IN
033014,000131:                                                                                          	#       XSMD, YSMD, ZSMD.
033015,000132: 
033016,000133:                                                                                          	#       RNDVZFLG INDICATES WHETHER THE RENDEZVOUS NAVIGATION PROCESS IS OPERATING.

062657,000694: 07,3514           00006        ENDIMU             EXTEND                                 	# MODE IS BAD IF CAGE HAS OCCURED OR IF
062658,000695: 07,3515           00011                           READ     DSALMOUT                      	# ISS WARNING IS ON.
062659,000696: 07,3516           75017                           MASK     BIT1                          	#
062660,000697: 07,3517           10000                           CCS      A                             	#
062661,000698: 07,3520           13522                           TCF      IMUBAD                        	#
062662,000699: 
062663,000700: 07,3521           13550        IMUGOOD            TCF      GOODEND                       	# WITH C(A) = 0.
062664,000701: 
062665,000702: 07,3522           35021        IMUBAD             CAF      ZERO                          	#
062666,000703: 07,3523           13545                           TCF      BADEND                        	#
062667,000704: 
062668,000705: 07,3524           35012        CAGETEST           CAF      BIT6                          	# SUBROUTINE TO TERMINATE IMU MODE
062669,000706: 07,3525           71320                           MASK     IMODES30                      	# SWITCH IF IMU HAS BEEN CAGED.
062670,000707: 07,3526           10000                           CCS      A                             	#

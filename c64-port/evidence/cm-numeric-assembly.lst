055060,000025: 
055061,000026:                                                                                          	## This source code has been transcribed or otherwise adapted from digitized
055062,000027:                                                                                          	## images of a hardcopy from the MIT Museum.  The digitization was performed
055063,000028:                                                                                          	## by Paul Fjeld, and arranged for by Deborah Douglas of the Museum.  Many
055064,000029:                                                                                          	## thanks to both.  The images (with suitable reduction in storage size and
055065,000030:                                                                                          	## consequent reduction in image quality as well) are available online at
055066,000031:                                                                                          	## www.ibiblio.org/apollo.  If for some reason you find that the images are
055067,000032:                                                                                          	## illegible, contact me at info@sandroid.org about getting access to the 
055068,000033:                                                                                          	## (much) higher-quality images which Paul actually created.
055069,000034:                                                                                          	##
055070,000035:                                                                                          	## Notations on the hardcopy document read, in part:
055071,000036:                                                                                          	##
055072,000037:                                                                                          	##      Assemble revision 055 of AGC program Comanche by NASA
055073,000038:                                                                                          	##      2021113-051.  10:28 APR. 1, 1969  
055074,000039:                                                                                          	##
055075,000040:                                                                                          	##      This AGC program shall also be referred to as
055076,000041:                                                                                          	##                      Colossus 2A
055077,000042: 
055079,000044:                                                                                          	# PROGRAM DESCRIPTION - ENTIRE CONIC SUBROUTINE LOG SECTION     DATE - 1 SEPTEMBER 1967
055080,000045:                                                                                          	# MOD NO. - 0                                                   LOG SECTION - CONIC SUBROUTINES
055081,000046:                                                                                          	# MOD BY KRAUSE                                                 ASSEMBLY - COLOSSUS REVISION 88
055082,000047: 
055083,000048:                                                                                          	# FUNCTIONAL DESCRIPTION -
055084,000049:                                                                                          	#       THE FOLLOWING SET OF SUBROUTINES SOLVE VARIOUS PROBLEMS INVOLVING THE TRAJECTORY PRODUCED BY A CENTRAL
055085,000050:                                                                                          	#       INVERSE-SQUARE FORCE ACTING ON A POINT MASS, AS OUTLINED IN THE CMC AND LGC LUNAR LANDING MISSION GSOP, SECTION
055086,000051:                                                                                          	#       5.5.1.2.  A GENERAL USAGE POINT-OF-VIEW WAS TAKEN IN FORMULATING, MECHANIZING, AND SCALING THE SUBROUTINES,
055087,000052:                                                                                          	#       RATHER THAN OPTIMIZING EACH FOR A PARTICULAR USE.  THEREFORE, MULTIPLE USAGE CAN BE MADE OF THE SUBROUTINES
055088,000053:                                                                                          	#       INVOLVING ANY REALISTIC SET OF CONSTRAINTS.  IT SHOULD BE NOTED THAT ONLY ONE SET OF CODING IS USED, WHETHER THE
055089,000054:                                                                                          	#       EARTH, MOON, OR ANY OTHER CELESTIAL BODY IS SPECIFIED AS THE CENTRAL BODY OF THE PROBLEM, PROVIDED ONE OBSERVES
055090,000055:                                                                                          	#       THE INHERENT SCALE CHANGE REQUIRED IN POSITION, VELOCITY, MU, AND TIME, AS OUTLINED IN MISSION PROGRAMMING
055091,000056:                                                                                          	#       DEFINITION MEMO NO. 10.  THIS CAN BE ACCOMPLISHED BY SIMPLY ADDING TO THE MUTABLE AND INITIALIZING THE SUBROU-
055092,000057:                                                                                          	#       TINES APPROPRIATELY.
055093,000058: 
055094,000059:                                                                                          	#       DUE TO THE UNIFORMITY OF THE EQUATIONS INVOLVED, CODING WAS MINIMIZED BY TREATING INDIVIDUAL EQUATIONS AND
055095,000060:                                                                                          	#       BLOCKS OF EQUATIONS AS SUBROUTINES OF LOWER RANK WHENEVER POSSIBLE.  AS A RESULT, THREE BY-PRODUCTS SUBROUTINES,
055096,000061:                                                                                          	#       DIRECTLY USABLE AS INDEPENDENT SUBROUTINES, WERE GENERATED.
055097,000062: 
055098,000063:                                                                                          	# RESTRICTIONS -
055099,000064:                                                                                          	#       THE ONLY LIMITATION IN THE SCOPE OF PROBLEM WHICH CAN BE SOLVED BY A PARTICULAR SUBROUTINE IS THE SCALING
055100,000065:                                                                                          	#       LIMIT OF EACH PARAMETER AS SPECIFIED IN THE GSOP.  THESE SCALING LIMITS WERE CHOSEN SO THAT ALL FEASIBLE TRAJEC-
055101,000066:                                                                                          	#       TORIES COULD BE HANDLED.
055102,000067: 
055103,000068:                                                                                          	#       SINCE THE SUBROUTINES (EXCEPT KEPLER) USE COMMON SUBROUTINES OF LOWER RANK WHICH USE ERASABLE OTHER THAN
055104,000069:                                                                                          	#       THE PUSHLIST (DUE TO ITS LIMITED SIZE) AND COMMON INTERPRETIVE SWITCHES, THE CONIC SUBROUTINES CANNOT BE ALLOWED
055105,000070:                                                                                          	#       TO INTERRUPT EACH OTHER.  IT IS UP TO THE USER TO GUARANTEE THIS CONDITION.
055106,000071: 
055108,000073:                                                                                          	# PROGRAM DESCRIPTION - KEPLER SUBROUTINE                       DATE - 11 OCTOBER 1967
055109,000074:                                                                                          	# MOD NO. - 1                                                   LOG SECTION - CONIC SUBROUTINES
055110,000075:                                                                                          	# MOD BY KRAUSE                                                 ASSEMBLY - COLOSSUS 103 AND SUNDANCE 222
055111,000076:                                                                                          	# MOD NO. - 2 (AUGUST 1968) BY ROBERTSON: TO PERMIT BACKDATING BY MORE THAN ONE ORBITAL PERIOD.
055112,000077:                                                                                          	# MOD NO. - 3 (DEC 1968) BY ROBERTSON: SUPPRESSION OF X-MODULO-ING
055113,000078:                                                                                          	# MOD. NO. - 4 (JAN 1969) BY ROBERTSON: CLEAR OVFIND AT KEPLER ENTRY
055114,000079: 
055115,000080:                                                                                          	# FUNCTIONAL DESCRIPTION -
055116,000081:                                                                                          	#       THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR AND THE DESIRED TRANSFER TIME THROUGH WHICH THE STATE IS TO
055117,000082:                                                                                          	#       BE UPDATED ALONG A CONIC TRAJECTORY, COMPUTES THE NEW, UPDATED STATE VECTOR.  THE TRAJECTORY MAY BE ANY CONIC
055118,000083:                                                                                          	#       SECTION - CIRCULAR, ELLIPTIC, PARABOLIC, HYPERBOLIC, OR RECTILINEAR WITH RESPECT TO THE EARTH OR THE MOON. THE
055119,000084:                                                                                          	#       USE OF THE SUBROUTINE CAN BE EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WITHOUT
055120,000085:                                                                                          	#       INTRODUCING ANY CODING CHANGES, ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.  AN ITERA-
055121,000086:                                                                                          	#       TION TECHNIQUE IS UTILIZED IN THE COMPUTATION.
055122,000087: 
055123,000088:                                                                                          	#       IF A NEGATIVE TIME-OF-FLIGHT IS INPUT, THE PROGRAM WILL SOLVE FOR THE STATE WHICH WOULD BE PRODUCED BY
055124,000089:                                                                                          	#       EXTRAPOLATING THE POSITION BACKWARD IN TIME.
055125,000090: 
055126,000091:                                                                                          	#       IF THE ABSOLUTE VALUE OF THE DESIRED TRANSFER TIME EXCEEDS THE ORBITAL PERIOD, THE SUBROUTINE, THROUGH A 
055127,000092:                                                                                          	#       MODULAR TECHNIQUE, WILL COMPUTE THE STATE CORRESPONDING TO THE DESIRED TIME (WHETHER POSITIVE OR NEGATIVE).
055128,000093: 
055129,000094:                                                                                          	# THE RESTRICTIONS ARE -
055130,000095:                                                                                          	#       1.      (PREVIOUS RESTRICTION ON THE NEGATIVE DESIRED TRANSFER TIME IS NOW DELETED.)
055131,000096:                                                                                          	#       2.      THE PARAMETERS IN THE PROBLEM CANNOT EXCEED THEIR SCALING LIMITS AS SPECIFIED IN THE GSOP.  IF
055132,000097:                                                                                          	#               ANY OF THESE LIMITS ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
055133,000098: 
055134,000099:                                                                                          	#       THE NUMBER OF ITERATIONS AND, THEREFORE, THE COMPUTATION SPEED IS DEPENDENT ON THE ACCURACY OF THE
055135,000100:                                                                                          	#       GUESS, XKFPNEW.  THE AGC COMPUTATION TIME IS APPROXIMATELY .061 SECONDS FOR INITIALIZATION, .065 SECONDS FOR THE
055136,000101:                                                                                          	#       FINAL COMPUTATIONS, PLUS .083 SECONDS FOR EACH ITERATION.
055137,000102: 
055138,000103:                                                                                          	# REFERENCES -
055139,000104:                                                                                          	#       R-479, MISSION PROGRAMMING DEFINITION MEMO NO. 10, LUNAR LANDING MISSION GSOP, SECTION 5.5, SGA
055140,000105:                                                                                          	#       MEMO 67-4.
055141,000106: 
055142,000107:                                                                                          	# INPUT - ERASABLE INITIALIZATION REQUIRED
055143,000108:                                                                                          	#               * SCALE FACTOR *
055144,000109:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055145,000110:                                                                                          	#       --------*--------------*                         -----------------------
055146,000111:                                                                                          	#       RRECT   * +29 FOR EARTH*DP INITIAL POSITION VECTOR IN METERS
055147,000112:                                                                                          	#               * +27 FOR MOON *
055149,000114:                                                                                          	#       VRECT   * +7 FOR EARTH *DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
055150,000115:                                                                                          	#               * +5 FOR MOON  *
055151,000116:                                                                                          	#       X1 (38D)* NONE         *INDEX REGISTER SET TO -2D OR -10D ACCORDING TO WHETHER THE EARTH OR MOON,
055152,000117:                                                                                          	#               *              *RESPECTIVELY, IS THE CENTRAL BODY
055153,000118:                                                                                          	#       TAU.    * +28          *DESIRED TRANSFER TIME IN CENTISECONDS (DP)
055154,000119:                                                                                          	#               *              *    MAY BE POS OR NEG AND ABSOLUTE VALUE MAY BE GREATER OR LESS THAN ONE ORBITAL PERIOD.
055155,000120:                                                                                          	#       XKEPNEW * +17 FOR EARTH*DP GUESS OF ROOT X OF KEPLERS EQN IN SQRT(METERS).SIGN SHOULD AGREE WITH THAT OF TAU.
055156,000121:                                                                                          	#               * +16 FOR MOON *    AND ABS VALUE SHOULD BE LESS THAN THAT CORRESPONDING TO A PERIOD, VIZ, 2PI SQRT(SEMI-
055157,000122:                                                                                          	#               *              *    MAJOR AXIS), FOR SPEED OF CONVERGENCE, BUT IF EITHER CONDITION FAILS, XKEPNEW IS RESET
055158,000123:                                                                                          	#               *              *    BY KEPLER TO A POOR BUT VALID GUESS.
055159,000124:                                                                                          	#       TC      * +28          *DP PREV. VALUE OF TIME IN CENTISECS. MUST BE LESS THAN ONE ORBITAL PERIOD.
055160,000125:                                                                                          	#       XPREV   * +17 FOR EARTH*DP PREV. VALUE OF X IN SQRT(METERS).  MUST BE LESS THAN AN X CORRESPONDING TO ONE
055161,000126:                                                                                          	#               * +16 FOR MOON *    ORBITAL PERIOD, VIZ, 2PI SQRT(SEMI-MAJOR AXIS)
055162,000127: 
055163,000128:                                                                                          	# SUBROUTINES CALLED -
055164,000129:                                                                                          	#       DELTIME
055165,000130: 
055166,000131:                                                                                          	# CALLING SEQUENCE AND NORMAL EXIT MODES -
055167,000132:                                                                                          	#       KEPRTN-2        GOTO                    MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
055168,000133:                                                                                          	#       KEPRTN-1                KEPLER          RETURNS WITH XPREV IN MPAC.  PL IS AT 0.
055169,000134:                                                                                          	#       KEPRTN          ...                     CONTINUE
055170,000135: 
055171,000136:                                                                                          	#       KEPLER MUST NOT BE CALLED DIRECTLY SINCE AN INTERRUPTION OF IT WOULD DESTROY THE ERASABLES IT NEEDS TO COMPLETE
055172,000137:                                                                                          	#       THE INTERRUPTED JOB.  THEREFORE THE USER MUST CALL CSMCONIC OR LEMCONIC WHICH GUARANTEES NO INTERRUPTS AND WHICH
055173,000138:                                                                                          	#       ALSO CALLS KEPPREP TO COMPUTE A GUESS OF XKEPNEW.
055174,000139: 
055175,000140:                                                                                          	# ABORT EXIT MODES -
055176,000141:                                                                                          	#       NONE
055177,000142: 
055178,000143:                                                                                          	# OUTPUT -
055179,000144:                                                                                          	#               * SCALE FACTOR *
055180,000145:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055181,000146:                                                                                          	#       --------*--------------*                         -----------------------
055182,000147:                                                                                          	#       RCV     * +29 FOR EARTH*DP TERMINAL POSITION VECTOR IN METERS
055183,000148:                                                                                          	#               * +27 FOR MOON *
055184,000149:                                                                                          	#       VCV     * +7 FOR EARTH *DP TERMINAL VELOCITY VECTOR IN METERS/CENTISEC
055185,000150:                                                                                          	#               * +5 FOR MOON  *
055186,000151:                                                                                          	#       TC      * +28          *DP TRANSFER TIME IN CENTISECS TO WHICH KEPLER CONVERGED.  ALWAYS LESS THAN ONE PERIOD.
055187,000152:                                                                                          	#       XPREV   * +17 FOR EARTH*DP VALUE OF X IN SQRT(METERS) TO WHCIH KEPLER CONVERGED. ALWAYS LESS THAN THE X
055188,000153:                                                                                          	#               * +16 FOR MOON *    CORRESPONDING TO ONE PERIOD.
055190,000155:                                                                                          	#       FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
055191,000156: 
055192,000157:                                                                                          	# DEBRIS -
055193,000158:                                                                                          	#       PARAMETERS WHICH MAY BE OF USE -
055194,000159:                                                                                          	#               * SCALE FACTOR *
055195,000160:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055196,000161:                                                                                          	#       --------*--------------*                         -----------------------
055197,000162:                                                                                          	#       URRECT  * +1           *DP UNIT VECTOR OF INITIAL POSITION
055198,000163:                                                                                          	#       R1      * +29 FOR EARTH*DP MAGNITUDE OF INITIAL POSITION IN METERS
055199,000164:                                                                                          	#               * +27 FOR MOON *
055200,000165:                                                                                          	#       ALPHA   * -22 FOR EARTH*DP INVERSE OF SEMIMAJOR AXIS IN 1/METERS
055201,000166:                                                                                          	#               * -20 FOR MOON *
055202,000167:                                                                                          	#       TMODULO * +28          *DP INTEGRAL NUMBER OF PERIODS IN CENTISECS. WHICH WAS SUBTRACTED FROM TAU. TO PRODUCE A
055203,000168:                                                                                          	#               *              *TAU. OF LESS THAN ONE PERIOD.
055204,000169: 
055205,000170:                                                                                          	# PARAMETERS OF NO USE -
055206,000171:                                                                                          	#       DP PARAMETERS - EPSILONT, DELX, DELT, RCNORM, XMODULO, PLUS PUSHLIST REGISTERS 0 THROUGH 39D.
055207,000172: 
055209,000174:                                                                                          	# PROGRAM DESCRIPTION - LAMBERT SUBROUTINE                      DATE - 1 SEPTEMBER 1967
055210,000175:                                                                                          	# MOD NO. - 0                                                   LOG SECTION - CONIC SUBROUTINES
055211,000176:                                                                                          	# MOD BY KRAUSE                                                 ASSEMBLY - COLOSSUS REVISION 88
055212,000177: 
055213,000178:                                                                                          	# FUNCTIONAL DESCRIPTION -
055214,000179:                                                                                          	#       THIS SUBROUTINE CALCULATES THE INITIAL VELOCITY REQUIRED TO TRANSFER A POINT-MASS ALONG A CONIC TRAJECTORY
055215,000180:                                                                                          	#       FROM AN INITIAL POSITION TO A TERMINAL POSITION IN A PRESCRIBED TIME INTERVAL.  THE RESULTING TRAJECTORY MAY BE
055216,000181:                                                                                          	#       A SECTION OF A CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO THE EARTH OR THE MOON.  THE USE OF THE
055217,000182:                                                                                          	#       SUBROUTINE CAN BE EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WITHOUT INTRODUCING ANY
055218,000183:                                                                                          	#       CODING CHANGES, ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.  AN ITERATION TECHNIQUE IS
055219,000184:                                                                                          	#       UTILIZED IN THE COMPUTATION.
055220,000185: 
055221,000186:                                                                                          	# THE RESTRICTIONS ARE -
055222,000187:                                                                                          	#       1. RECTILINEAR TRAJECTORIES CANNOT BE COMPUTED.
055223,000188:                                                                                          	#       2. AN ACCURACY DEGRADATION OCCURS AS THE COSINE OF THE TRUE ANOMALY DIFFERENCE APPROACHES +1.0.
055224,000189:                                                                                          	#       3. THE ANGLE BETWEEN ANY POSITION VECTOR AND ITS VELOCITY VECTOR MUST BE GREATER THAN 1 DEGREE 47.5 MINUTES
055225,000190:                                                                                          	#          AND LESS THAN 178 DEGREES 12.5 MINUTES.
055226,000191:                                                                                          	#       4. NEGATIVE TRANSFER TIME IS AMBIGUOUS AND WILL RESULT IN NO SOLUTION.
055227,000192:                                                                                          	#       5. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE
055228,000193:                                                                                          	#          LIMITS ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
055229,000194: 
055230,000195:                                                                                          	#       THE NUMBER OF ITERATIONS AND, THEREFORE, THE COMPUTATIONS SPEED IS DEPENDENT ON THE ACCURACY OF THE FIRST
055231,000196:                                                                                          	#       GUESS OF THE INDEPENDENT VARIABLE, COGA.                           THE AGC COMPUTATION TIME IS APPROXIMATE-
055232,000197:                                                                                          	#       LY .105 SECONDS FOR INITIALIZATION, .069 SECONDS FOR FINAL COMPUTATIONS, PLUS .205 SECONDS FOR EACH ITERATION.
055233,000198: 
055234,000199:                                                                                          	# REFERENCES -
055235,000200:                                                                                          	#       R-479, MISSION PROGRAMMING DEFINITION MEMO NO. 10, LUNAR LANDING MISSION GSOP - SECTION 5.5, SGA MEMO 67-8,
055236,000201:                                                                                          	#       SGA MEMO 67-4.
055237,000202: 
055238,000203:                                                                                          	# INPUT - ERASABLE INITIALIZATION REQUIRED
055239,000204:                                                                                          	#               * SCALE FACTOR *
055240,000205:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055241,000206:                                                                                          	#       --------*--------------*                         -----------------------
055242,000207:                                                                                          	#       R1VEC   * +29 FOR EARTH*DP INITIAL POSITION VECTOR IN METERS
055243,000208:                                                                                          	#               * +27 FOR MOON *
055244,000209:                                                                                          	#       R2VEC   * +29 FOR EARTH*DP TARGET OR TERMINAL POSITION VECTOR IN METERS
055245,000210:                                                                                          	#               * +27 FOR MOON *
055246,000211:                                                                                          	#       TDESIRED* +28          *DP DESIRED TRANSFER TIME IN CENTISECONDS
055247,000212:                                                                                          	#       X1 (38D)* NONE         *INDEX REGISTER SET TO -2D OR -10D ACCORDING TO WHETHER THE EARTH OR MOON,
055248,000213:                                                                                          	#               *              *RESPECTIVELY, IS THE CENTRAL BODY
055249,000214:                                                                                          	#       GEOMSGN * NONE         *SP +.5 IF DESIRED TRANSFER ANGLE IS LESS THAN 180 DEGREES, -.5 IF GREATER THAN 180 DEG.
055250,000215:                                                                                          	#       GUESSW  * NONE         *AN INTERPRETER SWITCH TO BE SET IF NO GUESS OF COGA IS AVAILABLE, CLEAR IF A GUESS OF
055252,000217:                                                                                          	#               *              *COGA IS TO BE USED BY LAMBERT
055253,000218:                                                                                          	#       COGA    * +5           *DP GUESS OF COTANGNT OF FLIGHT PATH ANGLE (MEASURED FROM VERTICAL).  THIS WILL BE
055254,000219:                                                                                          	#                              *IGNORED IF GUESSW IS SET.
055255,000220:                                                                                          	#       NORMSW  * NONE         *AN INTERPRETER SWITCH TO BE SET IF UN IS TO BE AN INPUT TO THE SUBROUTINE, CLEAR IF
055256,000221:                                                                                          	#               *              *LAMBERT IS TO COMPUTE ITS OWN NORMAL (UN).
055257,000222:                                                                                          	#       UN      * +1           *DP UNIT NORMAL TO THE DESIRED ORBIT PLANE IN THE DIRECTION OF THE RESULTING ANGULAR
055258,000223:                                                                                          	#               *              *MOMENTUM VECTOR.  THIS WILL BE IGNORED IF NORMSW IS CLEAR.
055259,000224:                                                                                          	#       VTARGTAG* NONE         *A S.P. TAG TO BE SET TO ZERO IF LAMBERT IS TO COMPUTE THE VELOCITY AT R2VEC AS WELL AS
055260,000225:                                                                                          	#               *              *AT R1VEC.
055261,000226: 
055262,000227:                                                                                          	# SUBROUTINES CALLED -
055263,000228:                                                                                          	#       GEOM, GETX, DELTIME, ITERATOR, LAMENTER (PART OF NEWSTATE)
055264,000229: 
055265,000230:                                                                                          	# CALLING SEQUENCE AND NORMAL EXIT MODES -
055266,000231:                                                                                          	#       L       CALL                    MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
055267,000232:                                                                                          	#       L+1             LAMBERT         RETURNS WITH PL AT 0 AND WITH VVEC IN MPAC IF VTARGTAG WAS NON-ZERO OR VTARGET
055268,000233:                                                                                          	#                                       IN MPAC IF VTARGTAG WAS ZERO
055269,000234:                                                                                          	#       L+2     BON                     CONTINUE IF SOLNSW CLEAR SINCE SOLUTION IS ACCEPTABLE
055270,000235:                                                                                          	#       L+3             SOLNSW
055271,000236:                                                                                          	#       L+4             LAMABORT
055272,000237: 
055273,000238:                                                                                          	#       IF A LAMBERT RESULT IS TO BE A FIRST GUESS FOR THE NEXT LAMBERT CALCULATION, COGA MUST BE PRESERVED AND
055274,000239:                                                                                          	#       GUESSW MUST BE CLEAR FOR EACH SUCCEEDING LAMBERT CALL.
055275,000240: 
055276,000241:                                                                                          	# ABORT EXIT MODES -
055277,000242:                                                                                          	#       IF SOLNSW WAS SET UPON EXITING, EITHER LAMBERT WAS ASKED TO COMPUTE A TRANSFER TOO NEAR 0 OR 360 DEG, OR T
055278,000243:                                                                                          	#       WAS TOO SMALL TO PRODUCE A REALISTIC TRANSFER BETWEEN R1VEC AND R2VEC.  IN EITHER CASE THE FIX MUST BE MADE
055279,000244:                                                                                          	#       ACCORDING TO THE NEEDS OF THE PARTICULAR USER.  THE ABORT EXIT MODE MAY BE CODED AS ...
055280,000245:                                                                                          	#       LAMABORT        DLOAD   ABS             A MEASURE OF PROXIMITY TO 0 OR
055281,000246:                                                                                          	#                               1-CSTH          360 DEGREES.
055282,000247:                                                                                          	#                       DSU     BMN
055283,000248:                                                                                          	#                               ONEBIT
055284,000249:                                                                                          	#                               CHANGER2        CHANGE R2VEC DIRECTION SLIGHTLY.
055285,000250:                                                                                          	#                       DLOAD   DAD
055286,000251:                                                                                          	#                               TDESIRED
055287,000252:                                                                                          	#                               SOMETIME
055288,000253:                                                                                          	#                       STCALL  TDESIRED        INCREASE TDESIRED
055289,000254:                                                                                          	#                               LAMBERT
055290,000255: 
055291,000256:                                                                                          	# OUTPUT -
055292,000257:                                                                                          	#               * SCALE FACTOR *
055293,000258:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055295,000260:                                                                                          	#       --------*--------------*                         -----------------------
055296,000261:                                                                                          	#       VVEC    * +7 FOR EARTH *DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND REQUIRED TO SATISFY THE BOUNDARY VALUE
055297,000262:                                                                                          	#               * +5 FOR MOON  *PROBLEM.
055298,000263:                                                                                          	#       VTARGET * +7 FOR EARTH *DP RESULTANT VELOCITY VECTOR AT R2VEC IN METERS/CENTISECOND.
055299,000264:                                                                                          	#               * +5 FOR MOON  *
055300,000265:                                                                                          	#       SOLNSW  * NONE         *INTERPRETER SWITCH WHICH IS SET IF THE SUBROUTINE CANNOT SOLVE THE PROBLEM, CLEAR IF THE
055301,000266:                                                                                          	#               *              *SOLUTION EXISTS.
055302,000267: 
055303,000268:                                                                                          	#       FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
055304,000269: 
055305,000270:                                                                                          	# DEBRIS -
055306,000271:                                                                                          	#       PARAMETERS WHICH MAY BE OF USE -
055307,000272:                                                                                          	#               * SCALE FACTOR *
055308,000273:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055309,000274:                                                                                          	#       --------*--------------*                         -----------------------
055310,000275:                                                                                          	#       SNTH    * +1           *DP SIN OF ANGLE BETWEEN R1VEC AND R2VEC
055311,000276:                                                                                          	#       CSTH    * +1           *DP COSINE OF ANGLE
055312,000277:                                                                                          	#       1-CSTH  * +2           *DP 1-CSTH
055313,000278:                                                                                          	#       COGA    * +5           *DP COTAN OF INITIAL REQUIRED FLIGHT PATH ANGLE MEASURED FROM VERTICAL
055314,000279:                                                                                          	#       P       * +4           *DP RATIO OF SEMILATUS RECTUM TO INITIAL RADIUS
055315,000280:                                                                                          	#       R1A     * +6           *DP RATIO OF INITIAL RADIUS TO SEMIMAJOR AXIS
055316,000281:                                                                                          	#       R1 (32D)* +29 FOR EARTH*DP INITIAL RADIUS IN METERS
055317,000282:                                                                                          	#               * +27 FOR MOON *
055318,000283:                                                                                          	#       UR1     * +1           *DP UNIT VECTOR OF R1VEC
055319,000284:                                                                                          	#       U2      * +1           *DP UNIT VECTOR OF R2VEC
055320,000285: 
055321,000286:                                                                                          	#       PARAMETERS OF NO USE
055322,000287:                                                                                          	#               DP PARAMETERS - EPSILONL, CSTH-RHO, TPREV, TERRLAMB, R2, RTNLAMB (SP), PLUS PUSHLIST REGISTER 0 THROUGH 41D
055323,000288:                                                                                          	#               ADDITIONAL INTERPRETIVE SWITCHES USED - INFINFLG, 360SW, SLOPESW, ORDERSW
055324,000289: 
055326,000291:                                                                                          	# PROGRAM DESCRIPTION - TIME-THETA SUBROUTINE                   DATE - 1 SEPTEMBER 1967
055327,000292:                                                                                          	# MOD NO. - 0                                                   LOG SECTION - CONIC SUBROUTINES
055328,000293:                                                                                          	# MOD BY KRAUSE                                                 ASSEMBLY - COLOSSUS REVISION 88
055329,000294: 
055330,000295:                                                                                          	# FUNCTIONAL DESCRIPTION -
055331,000296:                                                                                          	#       THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR AND A DESIRED TRUE-ANOMALY-DIFFERENCE THROUGH WHICH THE
055332,000297:                                                                                          	#       STATE IS TO BE UPDATED ALONG A CONIC TRAJECTORY, CALCULATES THE CORRESPONDING TIME-OF-FLIGHT AND, IN ADDITION,
055333,000298:                                                                                          	#       PROVIDES THE OPTION OF COMPUTING THE NEW UPDATED STATE VECTOR.  THE RESULTING TRAJECTORY MAY BE A SECTION OF A
055334,000299:                                                                                          	#       CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO THE EARTH OR THE MOON.  THE USE OF THE SUBROUTINE CAN BE
055335,000300:                                                                                          	#       EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WITHOUT INTRODUCING ANY CODING CHANGES,
055336,000301:                                                                                          	#       ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.
055337,000302: 
055338,000303:                                                                                          	# THE RESTRICTIONS ARE -
055339,000304:                                                                                          	#       1. THE ANGLE BETWEEN ANY POSITION VECTOR AND ITS VELOCITY VECTOR MUST BE GREATER THAN 1 DEGREE 47.5 MINUTES
055340,000305:                                                                                          	#          AND LESS THAN 178 DEGREES 12.5 MINUTES.
055341,000306:                                                                                          	#       2. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE LIMITS
055342,000307:                                                                                          	#          ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
055343,000308: 
055344,000309:                                                                                          	#       THE AGC COMPUTATION TIME IS APPROXIMATELY .292 SECONDS.
055345,000310: 
055346,000311:                                                                                          	# REFERENCES -
055347,000312:                                                                                          	#       R-479, MISSION PROGRAMMING DEFINITION MEMO NO. 10, LUNAR LANDING MISSION GSOP-SECTION 5.5, SGA MEMO 67-8.
055348,000313: 
055349,000314:                                                                                          	# INPUT - ERASABLE INITIALIZATION REQUIRED
055350,000315:                                                                                          	#               * SCALE FACTOR *
055351,000316:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055352,000317:                                                                                          	#       --------*--------------*                         -----------------------
055353,000318:                                                                                          	#       RVEC    * +29 FOR EARTH*DP INITIAL POSITION VECTOR IN METERS
055354,000319:                                                                                          	#               * +27 FOR MOON *
055355,000320:                                                                                          	#       VVEC    * +7 FOR EARTH *DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
055356,000321:                                                                                          	#               * +5 FOR MOON  *
055357,000322:                                                                                          	#       SNTH    * +1           *DP SINE OF TRUE-ANOMALY-DIFFERENCE THROUGH WHICH THE STATE IS TO BE UPDATED
055358,000323:                                                                                          	#       CSTH    * +1           *DP COSINE OF THE ANGLE
055359,000324:                                                                                          	#       RVSW    * NONE         *AN INTERPRETIVE SWITCH TO BE SET IF ONLY TIME IS TO BE AN OUTPUT, CLEAR IF THE NEW STATE
055360,000325:                                                                                          	#               *              *IS TO BE COMPUTED ALSO.
055361,000326:                                                                                          	#       X1 (38D)* NONE         *INDEX REGISTER TO BE SET TO -2D OR -10D ACCORDING TO WHETHER THE EARTH OR MOON,
055362,000327:                                                                                          	#               *              *RESPECTIVELY, IS THE CENTRAL BODY.
055363,000328: 
055364,000329:                                                                                          	# SUBROUTINES CALLED -
055366,000331:                                                                                          	#       PARAM, GEOM, GETX, DELTIME, NEWSTATE
055367,000332: 
055368,000333:                                                                                          	# CALLING SEQUENCE AND NORMAL EXIT MODES -
055369,000334:                                                                                          	#       IF ONLY TIME IS DESIRED AS OUTPUT -
055370,000335:                                                                                          	#       L       SET     CALL            MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
055371,000336:                                                                                          	#       L+1             RVSW
055372,000337:                                                                                          	#       L+2             TIMETHET        RETURN WITH PL AT 0 AND T IN MPAC
055373,000338:                                                                                          	#       L+3     ...                     CONTINUE
055374,000339: 
055375,000340:                                                                                          	#       IF THE UPDATE STATE VECTOR IS DESIRED AS WELL -
055376,000341:                                                                                          	#       L       CLEAR   CALL            MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
055377,000342:                                                                                          	#       L+1             RVSW
055378,000343:                                                                                          	#       L+2             TIMETHET        RETURNS WITH PL AT 6.  THE INITIAL POSITION VECTOR IS IN 0D OF THE PUSHLIST AND
055379,000344:                                                                                          	#                                       THE INITIAL VELOCITY VECTOR IN MPAC.
055380,000345:                                                                                          	#       L+3     STOVL   NEWVVEC
055381,000346:                                                                                          	#       L+4     STADR
055382,000347:                                                                                          	#       L+5     STORE   NEWRVEC         NEWVVEC AND NEWRVEC ARE SYMBOLIC REPRESENTATIONS OF THE USERS LOCATIONS.
055383,000348:                                                                                          	#       L+6     ...                     CONTINUE
055384,000349: 
055385,000350:                                                                                          	# ABORT EXIT MODES -
055386,000351:                                                                                          	#       IF COGAFLAG AND/OR INFINFLG IS SET AT THE EXIT TO TIME-THETA, TIME-THETA WILL TRANSFER TO POODOO WITH
055387,000352:                                                                                          	#       AN ALARM CODE (ORIGINALLY 00607), AND NOT RETURN TO THE CALLING PROGRAM.  (PCR 692 AND 721).
055388,000353: 
055389,000354:                                                                                          	# OUTPUT -
055390,000355:                                                                                          	#               * SCALE FACTOR *
055391,000356:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055392,000357:                                                                                          	#       --------*--------------*                         -----------------------
055393,000358:                                                                                          	#       T(30D)  * +28          *DP TRANSFER TIME IN CENTISECONDS
055394,000359:                                                                                          	#       INFINFLG* NONE         *AN INTERPRETIVE SWITCH WHICH IS SET IF THE TRANSFER ANGLE REQUIRES CLOSURE THROUGH
055395,000360:                                                                                          	#               *              *INFINITY (NO SOLUTION), CLEAR IF A PHYSICAL SOLUTION IS POSSIBLE.
055396,000361:                                                                                          	#       COGAFLAG* NONE         *AN INTERPRETIVE SWITCH WHICH IS SET IF RESTRICTION 1 HAS BEEN VIOLATED (NO SOLUTION),
055397,000362:                                                                                          	#               *              *CLEAR IF NOT.
055398,000363: 
055399,000364:                                                                                          	#       IN ADDITION, IF RVSW IS CLEAR, THE FOLLOWING ARE OUTPUT -
055400,000365:                                                                                          	#       MPAC -  * +7 FOR EARTH *DP TERMINAL VELOCITY VECTOR IN METERS/CENTISEC.
055401,000366:                                                                                          	#        MPAC +5* +5 FOR MOON  *
055402,000367:                                                                                          	#       0D - 5D * +29 FOR EARTH*DP TERMINAL POSITION VECTOR IN METERS (PL AT 6D)
055403,000368:                                                                                          	#               * +27 FOR MOON *
055404,000369: 
055405,000370:                                                                                          	#       FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
055407,000372: 
055408,000373:                                                                                          	# DEBRIS -
055409,000374:                                                                                          	#       PARAMETERS WHICH MAY BE OF USE -
055410,000375:                                                                                          	#               * SCALE FACTOR *
055411,000376:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055412,000377:                                                                                          	#       --------*--------------*                         -----------------------
055413,000378:                                                                                          	#       R1 (32D)* +29 FOR EARTH*DP MAGNITUDE OF INITIAL POSITION VECTOR, RVEC, IN METERS
055414,000379:                                                                                          	#               * +27 FOR MOON *
055415,000380:                                                                                          	#       R1A     * +6           *DP RATIO OF R1 TO SEMIMAJOR AXIS (NEG. FOR HYPERBOLIC TRAJECTORIES)
055416,000381:                                                                                          	#       P       * +4           *DP RATIO OF SEMILATUS RECTUM TO R1
055417,000382:                                                                                          	#       COGA    * +5           *DP COTAN OF ANGLE BETWEEN RVEC AND VVEC
055418,000383:                                                                                          	#       UR1     * +1           *DP UNIT VECTOR OF RVEC
055419,000384:                                                                                          	#       U2      * +1           *DP UNIT VECTOR OF VVEC
055420,000385:                                                                                          	#       UN      * +1           *DP UNIT VECTOR OF UR1*U2
055421,000386: 
055422,000387:                                                                                          	# PARAMETERS OF NO USE -
055423,000388:                                                                                          	#       SP PARAMETERS - RTNTT, GEOMSGN, RTNPRM, MAGVEC2=R2 (DP), PLUS PUSHLIST LOCATIONS 0-11D, 14D-21D, 24D-39D, 41D
055424,000389:                                                                                          	#       ADDITIONAL INTERPRETIVE SWITCHES USED - NORMSW, 360SW
055425,000390: 
055427,000392:                                                                                          	# PROGRAM DESCRIPTION - TIME-RADIUS SUBROUTINE          DATE - 11 OCTOBER 1967
055428,000393:                                                                                          	# MOD NO. -1                                            LOG SECTION - CONIC SUBROUTINES
055429,000394:                                                                                          	# MOD BY KRAUSE                                         ASSEMBLY - COLOSSUS REVISION 88
055430,000395: 
055431,000396:                                                                                          	# FUNCTIONAL DESCRIPTION -
055432,000397:                                                                                          	#       THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR AND A DESIRED RADIUS TO WHICH THE
055433,000398:                                                                                          	#       STATE IS TO BE UPDATED ALONG A CONIC TRAJECTORY, CALCULATES THE CORRESPONDING TIME-OF-FLIGHT AND, IN ADDITION,
055434,000399:                                                                                          	#       PROVIDES THE OPTION OF COMPUTING THE NEW UPDATED STATE VECTOR.  THE RESULTING TRAJECTORY MAY BE A SECTION OF A
055435,000400:                                                                                          	#       CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO THE EARTH OR THE MOON.  THE USE OF THE SUBROUTINE CAN BE
055436,000401:                                                                                          	#       EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WITHOUT INTRODUCING ANY CODING CHANGES,
055437,000402:                                                                                          	#       ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.
055438,000403: 
055439,000404:                                                                                          	#       IF THE DESIRED RADIUS IS BEYOND THE RADIUS OF APOCENTER OF THE CONIC OR BELOW THE RADIUS OF PERICENTER,
055440,000405:                                                                                          	#       APSESW WILL BE SET AND THE SUBROUTINE WILL RETURN THE APOCENTER OR PERICENTER SOLUTION, RESPECTIVELY.
055441,000406: 
055442,000407:                                                                                          	# THE RESTRICTIONS ARE -
055443,000408:                                                                                          	#       1. THE ANGLE BETWEEN ANY POSITION VECTOR AND ITS VELOCITY VECTOR MUST BE GREATER THAN 1 DEGREE 47.5 MINUTES
055444,000409:                                                                                          	#          AND LESS THAN 178 DEGREES 12.5 MINUTES.
055445,000410:                                                                                          	#       2. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE LIMITS
055446,000411:                                                                                          	#          ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
055447,000412:                                                                                          	#       3. AN ACCURACY DEGRADATION OCCURS AS THE SENSITIVITIES OF TIME AND UPDATED STATE VECTOR TO CHANGES IN
055448,000413:                                                                                          	#          RDESIRED INCREASE.  THIS WILL OCCUR NEAR EITHER APSIS OF THE CONIC AND WHEN THE CONIC IS NEARLY CIRCULAR.  IN
055449,000414:                                                                                          	#          PARTICULAR, IF THE CONIC IS AN EXACT CIRCLE, THE PROBLEM IS UNDEFINED AND THE SUBROUTINE WILL ABORT.
055450,000415: 
055451,000416:                                                                                          	#       THE AGC COMPUTATION TIME IS APPROXIMATELY .363 SECONDS
055452,000417: 
055453,000418:                                                                                          	# REFERENCES -
055454,000419:                                                                                          	#       R-479, MISSION PROGRAMMING DEFINITION MEMO NO. 10, LUNAR LANDING MISSION GSOP-SECTION 5.5, SGA MEMO 67-8.
055455,000420: 
055456,000421:                                                                                          	# INPUT - ERASABLE INITIALIZATION REQUIRED
055457,000422:                                                                                          	#               * SCALE FACTOR *
055458,000423:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055459,000424:                                                                                          	#       --------*--------------*                         -----------------------
055460,000425:                                                                                          	#       RVEC    * +29 FOR EARTH*DP INITIAL POSITION VECTOR IN METERS
055461,000426:                                                                                          	#               * +27 FOR MOON *
055462,000427:                                                                                          	#       VVEC    * +7 FOR EARTH *DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
055463,000428:                                                                                          	#               * +5 FOR MOON  *
055464,000429:                                                                                          	#       RDESIRED* +29 FOR EARTH*DP TERMINAL RADIAL DISTANCE ON CONIC TRAJECTORY FOR WHICH TRANSFER TIME IS TO BE
055465,000430:                                                                                          	#               * +27 FOR MOON *COMPUTED.
055466,000431:                                                                                          	#       SGNRDOT * NONE         *SP TAG SET TO +.5 OR -.5 ACCORDING TO WHETHER THE RADIAL VELOCITY AT RDESIRED IS TO BE
055467,000432:                                                                                          	#               *              *POSITIVE OR NEGATIVE, RESPECTIVELY.   THIS TAG REDUCES THE DOUBLE-VALUED PROBLEM TO A
055469,000434:                                                                                          	#               *              *SINGLE-VALUED PROBLEM.
055470,000435:                                                                                          	#       X1 (38D)* NONE         *INDEX REGISTER TO BE SET TO -2D OR -10D ACCORDING TO WHETHER THE EARTH OR MOON,
055471,000436:                                                                                          	#               *              *RESPECTIVELY, IS THE CENTRAL BODY.
055472,000437:                                                                                          	#       RVSW    * NONE         *AN INTERPRETIVE SWITCH TO BE SET IF ONLY TIME IS TO BE AN OUTPUT, CLEAR IF THE NEW STATE
055473,000438:                                                                                          	#               *              *IS TO BE COMPUTED ALSO.
055474,000439: 
055475,000440:                                                                                          	# SUBROUTINES CALLED -
055476,000441:                                                                                          	#       PARAM, GEOM, GETX, DELTIME, NEWSTATE
055477,000442: 
055478,000443:                                                                                          	# CALLING SEQUENCE AND NORMAL EXIT MODES -
055479,000444:                                                                                          	#       IF ONLY TIME IS DESIRED AS OUTPUT -
055480,000445:                                                                                          	#       L       SET     CALL            MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
055481,000446:                                                                                          	#       L+1             RVSW
055482,000447:                                                                                          	#       L+2             TIMERAD         RETURN WITH PL AT 0 AND T IN MPAC
055483,000448:                                                                                          	#       L+3     ...                     CONTINUE
055484,000449: 
055485,000450:                                                                                          	#       IF THE UPDATE STATE VECTOR IS DESIRED AS WELL -
055486,000451:                                                                                          	#       L       CLEAR   CALL            MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
055487,000452:                                                                                          	#       L+1             RVSW
055488,000453:                                                                                          	#       L+2             TIMERAD         RETURNS WITH PL AT 6.  THE INITIAL POSITION VECTOR IS IN 0D OF THE PUSHLIST AND
055489,000454:                                                                                          	#                                       THE INITIAL VELOCITY VECTOR IN MPAC.
055490,000455:                                                                                          	#       L+3     STOVL   NEWVVEC
055491,000456:                                                                                          	#       L+4     STADR
055492,000457:                                                                                          	#       L+5     STORE   NEWRVEC         NEWVVEC AND NEWRVEC ARE SYMBOLIC REPRESENTATIONS OF THE USERS LOCATIONS.
055493,000458:                                                                                          	#       L+6     ...                     CONTINUE
055494,000459: 
055495,000460:                                                                                          	# ABORT EXIT MODES -
055496,000461:                                                                                          	#       IF SOLNSW AND/OR COGAFLAG AND/OR INFINFLG IS SET AT THE EXIT TO TIME-RADIUS, TIME-RADIUS WILL TRANSFER
055497,000462:                                                                                          	#       TO POODOO WITH AN ALARM CODE (ORIGINALLY 00607), AND NOT RETURN TO THE CALLING PROGRAM.  (PCR 692 & 721)
055498,000463: 
055499,000464:                                                                                          	# OUTPUT -
055500,000465:                                                                                          	#               * SCALE FACTOR *
055501,000466:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055502,000467:                                                                                          	#       --------*--------------*                         -----------------------
055503,000468:                                                                                          	#       T (30D) * +28          *DP TRANSFER TIME IN CENTISECONDS
055504,000469:                                                                                          	#       INFINFLG* NONE         *AN INTERPRETIVE SWITCH WHICH IS SET IF RDESIRED AND SGNRDOT REQUIRE CLOSURE THROUGH
055505,000470:                                                                                          	#               *              *INFINITY (NO SOLUTION), CLEAR IF A PHYSICAL SOLUTION IS POSSIBLE.
055506,000471:                                                                                          	#       COGAFLAG* NONE         *AN INTERPRETIVE SWITCH WHICH IS SET IF RESTRICTION 1 HAS BEEN VIOLATED (NO SOLUTION),
055507,000472:                                                                                          	#               *              *CLEAR IF NOT.
055508,000473:                                                                                          	#       APSESW  * NONE         *AN INTERPRETIVE SWITCH WHICH IS SET IF RDESIRED WAS GREATER THAN RADIUS OF APOCENTER OR
055510,000475:                                                                                          	#               *              *LESS THAN RADIUS OF PERICENTER.  THE APOCENTER OR PERICENTER SOLUTION, RESPECTIVELY,
055511,000476:                                                                                          	#               *              *WILL THEN BE RETURNED.  THE SWITCH IS CLEAR IF RDESIRED WAS BETWEEN PERICENTER AND
055512,000477:                                                                                          	#               *              *APOCENTER.
055513,000478:                                                                                          	#       SOLNSW  * NONE         *AN INTERPRETIVE SWITCH WHICH IS SET IF THE CONIC IS SO CLOSE TO A CIRCLE THAT THE TERMIN
055514,000479:                                                                                          	#                              *POINT IS AMBIGUOUS, VIOLATING RESTRICTION 3.  IF ECCENTRICITY IS GREATER THAN 2-TO-THE-
055515,000480:                                                                                          	#                              *MINUS-18, THE SWITCH IS CLEAR.
055516,000481: 
055517,000482:                                                                                          	#       IN ADDITION, IF RVSW IS CLEAR, THE FOLLOWING ARE OUTPUT -
055518,000483:                                                                                          	#       MPAC -  * +7 FOR EARTH *DP TERMINAL VELOCITY VECTOR IN METERS/CENTISEC.
055519,000484:                                                                                          	#        MPAC +5* +5 FOR MOON  *
055520,000485:                                                                                          	#       0D - 5D * +29 FOR EARTH*DP TERMINAL POSITION VECTOR IN METERS (PL AT 6D)
055521,000486:                                                                                          	#               * +27 FOR MOON *
055522,000487: 
055523,000488:                                                                                          	#       FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
055524,000489: 
055525,000490:                                                                                          	# DEBRIS -
055526,000491:                                                                                          	#       PARAMETERS WHICH MAY BE OF USE -
055527,000492:                                                                                          	#               * SCALE FACTOR *
055528,000493:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055529,000494:                                                                                          	#       --------*--------------*                         -----------------------
055530,000495:                                                                                          	#       R1 (32D)* +29 FOR EARTH*DP MAGNITUDE OF INITIAL POSITION VECTOR, RVEC, IN METERS
055531,000496:                                                                                          	#               * +27 FOR MOON *
055532,000497:                                                                                          	#       R1A     * +6           *DP RATIO OF R1 TO SEMIMAJOR AXIS (NEG. FOR HYPERBOLIC TRAJECTORIES)
055533,000498:                                                                                          	#       P       * +4           *DP RATIO OF SEMILATUS RECTUM TO R1
055534,000499:                                                                                          	#       COGA    * +5           *DP COTAN OF ANGLE BETWEEN RVEC AND VVEC
055535,000500:                                                                                          	#       UR1     * +1           *DP UNIT VECTOR OF RVEC
055536,000501:                                                                                          	#       U2      * +1           *DP UNIT VECTOR OF VVEC
055537,000502:                                                                                          	#       UN      * +1           *DP UNIT VECTOR OF UR1*U2
055538,000503:                                                                                          	#       CSTH    * +1           *DP COSINE OF TRUE ANOMALY DIFFERENCE BETWEEN RVEC AND RDESIRED.
055539,000504:                                                                                          	#       SNTH    * +1           *DP SINE OF TRUE ANOMALY DIFFERENCE.
055540,000505: 
055541,000506:                                                                                          	#       PARAMETERS OF NO USE -
055542,000507:                                                                                          	#               SP PARAMETERS - RTNTT, GEOMSGN, RTNPRM, MAGVEC2=R2 (DP), PLUS PUSHLIST LOCATIONS 0-11D, 14D-21D, 24D-39D, 41D
055543,000508:                                                                                          	#               ADDITIONAL INTERPRETIVE SWITCHES USED - NORMSW, 360SW
055544,000509: 
055545,000510: 
055547,000512:                                                                                          	# PROGRAM DESCRIPTION - APSIDES SUBROUTINE              DATE - 1 SEPTEMBER 1967
055548,000513:                                                                                          	# MOD NO. - 0                                           LOG SECTION - CONIC SUBROUTINES
055549,000514:                                                                                          	# MOD BY KRAUSE                                         ASSEMBLY - COLOSSUS REVISION 88
055550,000515: 
055551,000516:                                                                                          	# FUNCTIONAL DESCRIPTION -
055552,000517:                                                                                          	#       THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR CALCULATES THE RADIUS OF PERICENTER AND OF APOCENTER AND THE
055553,000518:                                                                                          	#       ECCENTRICITY OF THE RESULTING CONIC TRAJECTORY, WHICH MAY BE A STRAIGHT LINE,
055554,000519:                                                                                          	#       CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO THE EARTH OR THE MOON.  THE USE OF THE SUBROUTINE CAN BE
055555,000520:                                                                                          	#       EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WITHOUT INTRODUCING ANY CODING CHANGES,
055556,000521:                                                                                          	#       ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.
055557,000522: 
055558,000523:                                                                                          	# THE RESTRICTIONS ARE -
055559,000524:                                                                                          	#       1. IF APOCENTER IS BEYOND THE SCALING OF POSITION, THE SCALE FACTOR LIMIT (536,870,910 METERS WITH RESPECT
055560,000525:                                                                                          	#          TO THE EARTH OR 134,217,727.5 METERS WITH RESPECT TO THE MOON) WILL BE RETURNED.
055561,000526:                                                                                          	#       2. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE LIMITS
055562,000527:                                                                                          	#          ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
055563,000528: 
055564,000529:                                                                                          	#       THE AGC COMPUTATION TIME IS APPROXIMATELY .103 SECONDS.
055565,000530: 
055566,000531:                                                                                          	# REFERENCES -
055567,000532:                                                                                          	#       MISSION PROGRAMMING DEFINITION MEMO NO. 10, LUNAR LANDING MISSION GSOP-SECTION 5.5
055568,000533: 
055569,000534:                                                                                          	# INPUT - ERASABLE INITIALIZATION REQUIRED
055570,000535:                                                                                          	#               * SCALE FACTOR *
055571,000536:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055572,000537:                                                                                          	#       --------*--------------*                         -----------------------
055573,000538:                                                                                          	#       RVEC    * +29 FOR EARTH*DP INITIAL POSITION VECTOR IN METERS
055574,000539:                                                                                          	#               * +27 FOR MOON *
055575,000540:                                                                                          	#       VVEC    * +7 FOR EARTH *DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
055576,000541:                                                                                          	#               * +5 FOR MOON  *
055577,000542:                                                                                          	#       X1 (38D)* NONE         *INDEX REGISTER TO BE SET TO -2D OR -10D ACCORDING TO WHETHER THE EARTH OR MOON,
055578,000543:                                                                                          	#               *              *RESPECTIVELY, IS THE CENTRAL BODY.
055579,000544: 
055580,000545:                                                                                          	# SUBROUTINES CALLED -
055581,000546:                                                                                          	#       PARAM, GEOM
055582,000547: 
055583,000548:                                                                                          	# CALLING SEQUENCE AND NORMAL EXIT MODES -
055585,000550:                                                                                          	#       IF ONLY TIME IS DESIRED AS OUTPUT -
055586,000551:                                                                                          	#       L       CALL                    MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
055587,000552:                                                                                          	#       L+1             APSIDES         RETURNS WITH PL AT 0, RADIUS OF APOCENTER IN MPAC AND RADIUS OF PERICENTER IN 0D
055588,000553:                                                                                          	#       L+2     STODL   APOAPSE
055589,000554:                                                                                          	#       L+3             0D
055590,000555:                                                                                          	#       L+4     STORE   PERIAPSE        APOAPSE AND PERIAPSE ARE SYMBOLIC REPRESENTATIONS OF THE USERS LOCATIONS
055591,000556:                                                                                          	#       L+5     ...                     CONTINUE
055592,000557: 
055593,000558:                                                                                          	# OUTPUT -
055594,000559:                                                                                          	#               * SCALE FACTOR *
055595,000560:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055596,000561:                                                                                          	#       --------*--------------*                         -----------------------
055597,000562:                                                                                          	#       MPAC    * +29 FOR EARTH*DP RADIUS OF APOCENTER IN METERS
055598,000563:                                                                                          	#               * +27 FOR MOON *
055599,000564:                                                                                          	#       0D-1D   * +29 FOR EARTH*DP RADIUS OF PERICENTER IN METERS
055600,000565:                                                                                          	#               * +27 FOR MOON *
055601,000566:                                                                                          	#       ECC     * +3           *DP ECCENTRICITY OF CONIC TRAJECTORY.
055602,000567: 
055603,000568:                                                                                          	#       FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
055604,000569: 
055605,000570:                                                                                          	# DEBRIS -
055606,000571:                                                                                          	#       PARAMETERS WHICH MAY BE OF USE -
055607,000572:                                                                                          	#               * SCALE FACTOR *
055608,000573:                                                                                          	#       VARIABLE*IN POWERS OF 2*                         DESCRIPTION AND REMARKS
055609,000574:                                                                                          	#       --------*--------------*                         -----------------------
055610,000575:                                                                                          	#       R1 (32D)* +29 FOR EARTH*DP MAGNITUDE OF INITIAL POSITION VECTOR, RVEC, IN METERS
055611,000576:                                                                                          	#               * +27 FOR MOON *
055612,000577:                                                                                          	#       R1A     * +6           *DP RATIO OF R1 TO SEMIMAJOR AXIS (NEG. FOR HYPERBOLIC TRAJECTORIES)
055613,000578:                                                                                          	#       P       * +4           *DP RATIO OF SEMILATUS RECTUM TO R1
055614,000579:                                                                                          	#       COGA    * +5           *DP COTAN OF ANGLE BETWEEN RVEC AND VVEC
055615,000580:                                                                                          	#       UR1     * +1           *DP UNIT VECTOR OF RVEC
055616,000581:                                                                                          	#       U2      * +1           *DP UNIT VECTOR OF VVEC
055617,000582:                                                                                          	#       UN      * +1           *DP UNIT VECTOR OF UR1*U2
055618,000583:                                                                                          	#       MAGVEC2 * +7 FOR EARTH *DP MAGNITUDE OF VVEC
055619,000584:                                                                                          	#               * +5 FOR MOON  *
055620,000585: 
055621,000586:                                                                                          	#       PARAMETERS OF NO USE -
055622,000587:                                                                                          	#               SP PARAMETERS - RTNAPSE, GEOMSGN, RTNPRM, PLUS PUSHLIST LOCATIONS 0-5, 10D-11D, 14D-21D, 31D-38D.

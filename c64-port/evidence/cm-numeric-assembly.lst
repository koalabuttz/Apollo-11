035738,000418: 26,2461           32473                           CA       V16N69                        	# ROLLC         DL (Q7)         VL
035739,000419: 26,2462           04662                           TC       BANKCALL                      	# XXX.XX DEG    XXX.XX G        XXXXX. FPS
035740,000420: 26,2463           21057                           CADR     GOFLASHR                      	#
035741,000421: 26,2464           02461                           TC       -3                            	# NODOFLAG IS SET..
035742,000422: 26,2465           02470                           TC       +3                            	#
035743,000423: 26,2466           02461                           TC       -5                            	#
035744,000424: 26,2467           02232                           TC       P61.3                         	# EST. GRP 4 FOR DSPLAY AND DO ENDOFJOB
035745,000425:                                                                                          	# IF PROCEED, CONTINUE.
035746,000426: 26,2470           05546                           TC       UPFLAG                        	#
035747,000427: 26,2471           00134                           ADRES    ENTRYDSP                      	# ENTRYDSP = 92D BIT 13 FLAG 6
035748,000428: 
035749,000429: 26,2472           02421                           TC       P63.1                         	# DISABLE GRP 4,START UP ENTRY DISPLAY
035750,000430:                                                                                          	# N06V68 VIA OVERNOUT, AS USED IN P64.

016386,003164: 
016387,003165:                                                                                          	# LOADSTAT      +0      INACTIVE (WAITING FOR DATA).  SET BY NVSUB
016388,003166:                                                                                          	#               +1      PROCEED NO DATA.  SET BY SPECIAL VERB
016389,003167:                                                                                          	#               -1      TERMINATE       SET BY SPECIAL VERB
016390,003168:                                                                                          	#               -0      DATA IN         SET BY END OF LOAD ROUTINE
016391,003169:                                                                                          	#                       OR RESEQUENCE   SET BY VERB 32
016392,003170: 
016393,003171:                                                                                          	# L TC ENDIDLE (FIXED FIXED)
016394,003172:                                                                                          	# ROUTINES THAT REQUEST LOADS THROUGH NVSUB SHOULD USE ENDIDLE WHILE
016395,003173:                                                                                          	# WAITING FOR THE DATA TO BE LOADED.  ENDIDLE PUTS CURRENT JOB TO SLEEP.
016396,003174:                                                                                          	# ENDIDLE CANNOT BE CALLED FROM ERASABLE OR F/F MEMORY,
016397,003175:                                                                                          	# SINCE JOB SLEEP AND JOBWAKE CAN HANDLE ONLY FIXED BANKS.
016398,003176:                                                                                          	# RECALTST TESTS LOADSTAT AND WAKES JOB UP TO,
016399,003177:                                                                                          	#       L+1     FOR TERMINATE
016400,003178:                                                                                          	#       L+2     FOR PROCEED WITHOUT DATA
016401,003179:                                                                                          	#       L+3     FOR DATA IN, OR RESEQUENCE
016402,003180:                                                                                          	# IT DOES NOTHING IF LOADSTAT INDICATES WAITING FOR DATA.
016404,003182: 
016405,003183:                                                                                          	# ENDIDLE ABORTS (WITH CODE 01206) IF A SECOND JOB ATTEMPTS TO GO TO SLEEP
016406,003184:                                                                                          	# IN PINBALL.  IN PARTICULAR, IF AN ATTEMPT IS MADE TO GO TO ENDIDLE WHEN
016407,003185:                                                                                          	#       1)      CADRSTOR NOT= +0.  THIS IS THE CASE WHERE THE CAPACITY OF ENDIDLE IS
016408,003186:                                                                                          	#               EXCEEDED.  (+-NZ INDICATE A JOB IS ALREADY ASLEEP DUE TO ENDIDLE.)
016409,003187:                                                                                          	#       2)      DSPLIST NOT= +0.  THIS INDICATES A JOB IS ALREADY ASLEEP DUE TO
016410,003188:                                                                                          	#               NVSUBUSY.
016411,003189: 
016412,003190:    4223           22002        ENDIDLE            LXCH     Q                             	# RETURN ADDRESS INTO L.
016413,003191:    4224           04234                           TC       ISCADR+0                      	# ABORT IF CADRSTOR NOT= +0
016414,003192:    4225           04240                           TC       ISLIST+0                      	# ABORT IF DSPLIST NOT= +0
016415,003193:    4226           30001                           CA       L                             	# DONT SET DSPLOCK TO 1 SO CAN USE
016416,003194:    4227           75054                           MASK     LOW10                         	# ENDIDLE WITH NVSUB INITIATED MONITOR.
016417,003195:    4230           60004                           AD       FBANK                         	# SAME STRATEGY FOR CADR AS MAKECADR.
016418,003196:    4231           55042                           TS       CADRSTOR                      	#

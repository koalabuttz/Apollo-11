016572,003350: 
016573,003351:                                                                                          	# RECALTST IS ENTERED DIRECTLY AFTER DATA IS LOADED (OR RESEQUENCE VERB IS
016574,003352:                                                                                          	# EXECUTED), TERMINATE VERB IS EXECUTED, OR PROCEED WITHOUT DATA VERB IS
016575,003353:                                                                                          	# EXECUTED.  IT WAKES UP JOB THAT DID TC ENDIDLE.
016576,003354:                                                                                          	# 
016577,003355:                                                                                          	# IF CADRSTOR NOT= +0, IT PUTS +0 INTO DSPLOCK, AND TURNS OFF KEY RLSE
016578,003356:                                                                                          	# LIGHT IF DSPLIST IS EMPTY (LEAVES KEY RLSE LIGHT ALONE IF NOT EMPTY).
016579,003357: 

051979,002726: 00,3627           13720                           TCF      ACOSOVF                       	# THIS IS PROBABLY AN OVERFLOW CASE.
051980,002727: 
051981,002728: 00,3630           13706        LASINEX            TCF      ASINEX                        	#
051982,002729: 
051983,002730: 00,3631           13641                           TCF      ACOSST2                       	# NO OVERFLOW -- PROCEED.
051984,002731: 
051985,002732: 00,3632           10155                           CCS      MPAC       +1                 	# IF MAJOR PART IS .5, CALL ANSWER 0
051986,002733: 00,3633           35021                           CAF      ZERO                          	# UNLESS MINOR PART NEGATIVE.
051987,002734: 00,3634           13636                           TCF      ACOS=0                        	#
051988,002735: 
051989,002736: 00,3635           13641                           TCF      ACOSST2                       	#
051990,002737: 
051991,002738: 00,3636           54155        ACOS=0             TS       MPAC       +1                 	#
051992,002739: 00,3637           54154                           TS       MPAC                          	#
051993,002740: 00,3640           00136                           TC       ESCAPE                        	#
051994,002741: 
051995,002742: 00,3641           00006        ACOSST2            EXTEND                                 	# NOW THAT ARGUMENT IS IN PROPER RANGE,
051996,002743: 00,3642           40155                           DCS      MPAC                          	# BEGIN COMPUTATION.  USE HASTINGS
051997,002744: 00,3643           65002                           AD       HALF                          	# APPROXIMATION ARCCOS(X) = SQRT(1-X)P(X)
051998,002745: 00,3644           52155                           DXCH     MPAC                          	# IN A SCALED VERSION WHERE P(X) IS A
051999,002746: 00,3645           52134                           DXCH     BUF2                          	# SEVENTH ORDER POLYNOMIAL.
052000,002747: 
052001,002748: 00,3646           03343                           TC       SQRTSUB                       	# RETURNS WITH NORMALIZED SQUARE ROOT.
052002,002749: 
052003,002750: 00,3647           10135                           CCS      MPTEMP                        	# SEE IF UN-NORMALIZATION REQUIRED.
052004,002751: 00,3650           13713                           TCF      ACOSSHR                       	#
052005,002752: 

000887,000741:                                                                                          	#                       (MAX 179.99)
000888,000742: 
000889,000743:                                                                                          	# -G-
000890,000744:                                                                                          	# DP DEGREES (90)       XX.XXX DEGREES          DP      BIT 1 OF LOW REGISTER =
000891,000745:                                                                                          	#                                                            28
000892,000746:                                                                                          	#                                                       360/2   DEGREES
000893,000747: 
000894,000748:                                                                                          	# -H-
000895,000749:                                                                                          	# DP DEGREES (360)      XXX.XX DEGREES          DP      BIT 1 OF LOW REGISTER =
000896,000750:                                                                                          	#                                                            28
000897,000751:                                                                                          	#                       (MAX 359.99)                    360/2   DEGREES
000898,000752: 

021668,001408: 
021670,001410:                                                                                          	# ..... PERIAPO .....
021671,001411:                                                                                          	# MOD NO -1                     LOG SECTION - P34-P35, P74-P75
021672,001412:                                                                                          	# MOD BY WHITE.P                DATE 18JAN68
021673,001413: 
021674,001414:                                                                                          	# FUNCTIONAL DESCRIPTION
021675,001415: 
021676,001416:                                                                                          	#       THIS SUBROUTINE COMPUTES THE TWO BODY APOCENTER AND PERICENTER
021677,001417:                                                                                          	#       ALTITUDES GIVEN THE POSITION AND VELOCITY VECTORS FOR A POINT ON
021678,001418:                                                                                          	#       THE TRAJECTORY AND THE PRIMARY BODY.
021679,001419: 
021680,001420:                                                                                          	#       SETRAD IS CALLED TO DETERMINE THE RADIUS OF THE PRIMARY BODY.
021681,001421: 
021682,001422:                                                                                          	#       APSIDES IS CALLED TO SOLVE FOR THE TWO BODY RADII OF APOCENTER AND
021683,001423:                                                                                          	#       PERICENTER AND THE ECCENTRICITY OF THE TRAJECTORY.
021684,001424: 
021685,001425:                                                                                          	# CALLING SEQUENCE
021686,001426:                                                                                          	#       L       CALL
021687,001427:                                                                                          	#       L+1             PERIAPO
021688,001428:                                                                                          	#       L+2     (RETURN - ALWAYS)
021689,001429: 
021690,001430:                                                                                          	# INPUT
021691,001431:                                                                                          	#       (1)     RVEC    POSITION VECTOR IN METERS
021692,001432:                                                                                          	#                       SCALE FACTOR - EARTH +29, MOON +27
021693,001433:                                                                                          	#       (2)     VVEC    VELOCITY VECTOR IN METERS/CENTISECOND
021694,001434:                                                                                          	#                       SCALE FACTOR - EARTH +7, MOON +5
021695,001435:                                                                                          	#       (3)     X1      PRIMARY BODY INDICATOR

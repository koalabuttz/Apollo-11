064764,000079: 
064765,000080:    7755     5023               OCT7               EQUALS   SEVEN                         	#
064766,000081: 10,3766                                           BANK     10                            	#
064767,000082: 
064769,000084:                                                                                          	# UPFLAG AND DOWNFLAG ARE ENTIRELY GENERAL FLAG SETTING AND CLEARING SUBROUTINES.  USING THEM, WHETHER OR
064770,000085:                                                                                          	# NOT IN INTERRUPT, ONE MAY SET OR CLEAR ANY SINGLE, NAMED BIT IN ANY ERASABLE REGISTER, SUBJECT OF COURSE TO
064771,000086:                                                                                          	# EBANK SETTING.  A "NAMED" BIT, AS THE WORD IS USED HERE, IS ANY BIT WITH A NAME FORMALLY ASSIGNED BY THE YUL
064772,000087:                                                                                          	# ASSEMBLER.
064773,000088: 
064774,000089:                                                                                          	# AT PRESENT THE ONLY NAMED BITS ARE THOSE IN THE FLAGWORDS.  ASSEMBLER CHANGES WILL MAKE IT POSSIBLE TO
064775,000090:                                                                                          	# NAME ANY BIT IN ERASABLE MEMORY.
064776,000091: 
064777,000092:                                                                                          	# CALLING SEQUENCES ARE AS FOLLOWS:-
064778,000093:                                                                                          	#               TC      UPFLAG                  TC      DOWNFLAG
064779,000094:                                                                                          	#               ADRES   NAME OF FLAG            ADRES   NAME OF FLAG
064780,000095: 
064781,000096:                                                                                          	# RETURN IS TO THE LOCATION FOLLOWING THE "ADRES" ABOUT .58 MS AFTER THE "TC".
064782,000097:                                                                                          	# UPON RETURN A CONTAINS THE CURRENT FLAGWRD SETTING.
064783,000098: 
064784,000099:    5546                                           BLOCK    02                            	#
064785,000100:    4000                                           SETLOC   FFTAG1                        	#
064786,000101:    4000                                           BANK                                   	#
064787,000102:    5546                                           COUNT*   $$/FLAG                       	#

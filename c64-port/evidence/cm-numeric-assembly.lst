039546,000174: 37,3637           00001                                    0                             	# UL/2
039547,000175: 37,3640           24023                           STOVL    SINTH                         	# -SIN(ALFA)/4
039548,000176: 37,3641           77641                           DOT                                    	# UL/2 FROM PDL 0
039549,000177: 37,3642           03600                                    UBZ/2                         	#

011584,000038: 
011586,000040:                                                                                          	# THE FOLLOWING REFERS TO THE NOUN TABLES
011587,000041: 
011588,000042:                                                                                          	#       COMPONENT CODE NUMBER   INTERPRETATION
011589,000043: 
011590,000044:                                                                                          	#       00000                   1 COMPONENT
011591,000045:                                                                                          	#       00001                   2 COMPONENT
011592,000046:                                                                                          	#       00010                   3 COMPONENT
011593,000047:                                                                                          	#       X1XXX                   BIT 4 = 1.  DECIMAL ONLY
011594,000048:                                                                                          	#       1XXXX                   BIT 5 = 1.  NO LOAD
011595,000049: 
011596,000050:                                                                                          	#       END OF COMPONENT CODE NUMBERS
011597,000051: 
011598,000052:                                                                                          	#       SF ROUTINE CODE NUMBER  INTERPRETATION
011599,000053: 
011600,000054:                                                                                          	#       00000                   OCTAL ONLY
011601,000055:                                                                                          	#       00001                   STRAIGHT FRACTIONAL
011602,000056:                                                                                          	#       00010                   CDU DEGREES (XXX.XX)
011603,000057:                                                                                          	#       00011                   ARITHMETIC SF
011604,000058:                                                                                          	#       00100                   ARITH DP1       OUT (MULT BY 2EXP14 AT END)     IN (STRAIGHT)
011605,000059:                                                                                          	#       00101                   ARITH DP2       OUT (STRAIGHT)                  IN (SL 7 AT END)
011606,000060:                                                                                          	#       00110                   Y OPTICS DEGREES (XX.XXX MAX 89.999)
011607,000061:                                                                                          	#       00111                   ARITH DP3       OUT (SL 7 AT END)               IN (STRAIGHT)
011608,000062:                                                                                          	#       01000                   WHOLE HOURS IN R1, WHOLE MINUTES (MOD 60) IN R2,
011609,000063:                                                                                          	#                                       SECONDS (MOD 60) 0XX.XX IN R3.  *** ALARMS IF USED WITH OCTAL
011610,000064:                                                                                          	#       01001                   MINUTES (MOD 60) IN D1D2, D3 BLANK, SECONDS (MOD 60) IN D4D5
011611,000065:                                                                                          	#                                       LIMITS TO 59B59 IF MAG EXCEEDS THIS VALUE.
011612,000066:                                                                                          	#                                       ALARMS IF USED WITH OCTAL ******** IN (ALARM)
011613,000067:                                                                                          	#       01010                   ARITH DP4       OUT (STRAIGHT)                  IN (SL 3 AT END)
011614,000068:                                                                                          	#       01011                   ARITH1 SF       OUT (MULT BY 2EXP14 AT END)     IN (STRAIGHT)
011615,000069:                                                                                          	#       01100                   2 INTEGERS IN D1D2, D4D5, D3 BLANK.
011616,000070:                                                                                          	#                                       ALARMS IF USED WITH OCTAL ******** IN (ALARM)
011617,000071:                                                                                          	#       01101                   DP STRAIGHT FRACTIONAL
011618,000072: 
011619,000073:                                                                                          	#       END OF SF ROUTINE CODE NUMBERS
011620,000074: 
011621,000075:                                                                                          	#       SF CONSTANT CODE NUMBER INTERPRETATION
011622,000076: 
011623,000077:                                                                                          	#       00000                   WHOLE                           USE ARITH
011624,000078:                                                                                          	#       00000                   DP TIME SEC (XXX.XX SEC)        USE ARITHDP1
011625,000079:                                                                                          	#       00001                   SPARE
011626,000080:                                                                                          	#       00010                   CDU DEGREES                     USE CDU DEGREES
011627,000081:                                                                                          	#       00010                   Y OPTICS DEGREES                USE Y OPTICS DEGREES
011628,000082:                                                                                          	#       00011                   DP DEGREES (90) XX.XXX DEG      USE ARITHDP3
011629,000083:                                                                                          	#       00100                   DP DEGREES (360) XXX.XX DEG     USE ARITHDP4
011630,000084:                                                                                          	#       00101                   DEGREES (180) XXX.XX DEG        USE ARITH
011631,000085:                                                                                          	#       00110                   WEIGHT2 (XXXXX. LBS)            USE ARITH1
011632,000086:                                                                                          	#       00111                   POSITION5 (XXX.XX NAUTICAL MILES)
011633,000087:                                                                                          	#                                                               USE ARITHDP3
011634,000088:                                                                                          	#       01000                   POSITION4 (XXXX.X NAUTICAL MILES)
011636,000090:                                                                                          	#                                                               USE ARITHDP3
011637,000091:                                                                                          	#       01001                   VELOCITY2 (XXXXX. FT/SEC)       USE ARITHDP4
011638,000092:                                                                                          	#       01010                   VELOCITY3 (XXXX.X FT/SEC)       USE ARITHDP3
011639,000093:                                                                                          	#       01011                   ELEVATION DEGREES (89.999 MAX)  USE ARITH
011640,000094:                                                                                          	#       01100                   TRIM DEGREES (XXX.XX DEG)       USE ARITH
011641,000095:                                                                                          	#       01101                   INERTIA (XXXXXBB. SLUG FT FT)   USE ARITH
011642,000096:                                                                                          	#       01101                   THRUST MOMENT (XXXXXBB. FT LBS) USE ARITH
011643,000097:                                                                                          	#       01110                   VELOCITY/2VS (XXXXX. FT/SEC)    USE ARITHDP4
011644,000098:                                                                                          	#       01111                   POSITION6 (XXXX.X NAUT MI)      USE ARITHDP3
011645,000099:                                                                                          	#       10000                   DRAG ACCELERATION (XXX.XX G)    USE ARITHDP2
011646,000100:                                                                                          	#       10001                   POSITION8 (XXXX.X NAUT MI)      USE ARITHDP3
011647,000101:                                                                                          	#       10010                   POSITION9 (XXXXX. FT)           USE ARITHDP4
011648,000102:                                                                                          	#       10011                   VELOCITY4 (XXXX.X FT/SEC)       USE ARITHDP2
011649,000103: 
011650,000104:                                                                                          	#       END OF SF CONSTANT CODE NUMBERS
011651,000105: 
011652,000106:                                                                                          	# FOR GREATER THAN SINGLE PRECISION SCALES, PUT ADDRESS OF MAJOR PART INTO
011653,000107:                                                                                          	# NOUN TABLES.
011654,000108: 
011655,000109:                                                                                          	# OCTAL LOADS PLACE +0 INTO MAJOR PART, DATA INTO MINOR PART.
011656,000110: 
011657,000111:                                                                                          	# OCTAL DISPLAYS SHOW MINOR PART ONLY.
011658,000112: 
011659,000113:                                                                                          	# TO GET AT BOTH MAJOR AND MINOR PARTS (IN OCTAL), USE NOUN 01.
011660,000114: 
011661,000115:                                                                                          	# A NOUN MAY BE DECLARED :DECIMAL ONLY: BY MAKING BIT4=1 OF ITS COMPONENT
011662,000116:                                                                                          	# CODE NUMBER.  IF THIS NOUN IS USED WITH ANY OCTAL DISPLAY VERB, OR IF
011663,000117:                                                                                          	# DATA IS LOADED IN OCTAL, IT ALARMS.
011664,000118: 
011665,000119:                                                                                          	# IN LOADING AN :HOURS, MINUTES, SECONDS: NOUN, ALL 3 WORDS MUST BE
011666,000120:                                                                                          	# LOADED, OR ALARM.
011667,000121: 
011668,000122:                                                                                          	# ALARM IF AN ATTEMPT IS MADE TO LOAD :SPLIT MINUTES/SECONDS: (MMBSS).
011669,000123:                                                                                          	# THIS IS USED FOR DISPLAY ONLY.
011670,000124: 
011672,000126:                                                                                          	# THE FOLLOWING ROUTINES ARE FOR READING THE NOUN TABLES AND THE SF TABLES
011673,000127:                                                                                          	# (WHICH ARE IN A SEPARATE BANK FROM THE REST OF PINBALL).  THESE READING
011674,000128:                                                                                          	# ROUTINES ARE IN THE SAME BANK AS THE TABLES.  THEY ARE CALLED BY DXCH Z.
011675,000129: 
011676,000130:                                                                                          	# LODNNTAB LOADS NNADTEM WITH THE NNADTAB ENTRY, NNTYPTEM WITH THE
011677,000131:                                                                                          	# NNTYPTAB ENTRY.  IF THE NOUN IS MIXED, IDAD1TEM IS LOADED WITH THE FIRST
011678,000132:                                                                                          	# IDADDTAB ENTRY, IDAD2TEM THE SECOND IDADDTAB ENTRY, IDAD3TEM THE THIRD
011679,000133:                                                                                          	# IDADDTAB ENTRY, RUTMXTEM WITH THE RUTMXTAB ENTRY.  MIXBR IS SET FOR
011680,000134:                                                                                          	# MIXED OR NORMAL NOUN.
011681,000135: 
011682,000136: 06,3262                                           BANK     06                            	#
011683,000137: 42,2000                                           SETLOC   PINBALL3                      	#
011684,000138: 42,2000                                           BANK                                   	#
011685,000139: 
011686,000140: 42,2062                                           COUNT    42/NOUNS                      	#
011687,000141: 
011688,000142: 42,2062           52152        LODNNTAB           DXCH     IDAD2TEM                      	# SAVE RETURN INFO IN IDAD2TEM, IDAD3TEM.
011689,000143: 42,2063           51002                           INDEX    NOUNREG                       	#
011690,000144: 42,2064           32133                           CAF      NNADTAB                       	#
011691,000145: 42,2065           54146                           TS       NNADTEM                       	#
011692,000146: 42,2066           51002                           INDEX    NOUNREG                       	#
011693,000147: 42,2067           32277                           CAF      NNTYPTAB                      	#
011694,000148: 42,2070           54147                           TS       NNTYPTEM                      	#
011695,000149: 42,2071           41002                           CS       NOUNREG                       	#
011696,000150: 42,2072           65033                           AD       MIXCON                        	#
011697,000151: 42,2073           00006                           EXTEND                                 	#
011698,000152: 42,2074           62100                           BZMF     LODMIXNN                      	# NOUN NUMBER G/E FIRST MIXED NOUN
011699,000153: 42,2075           35017                           CAF      ONE                           	# NOUN NUMBER L/ FIRST MIXED NOUN
011700,000154: 42,2076           54140                           TS       MIXBR                         	# NORMAL.  +1 INTO MIXBR.
011701,000155: 42,2077           02116                           TC       LODNLV                        	#
011702,000156: 42,2100           35016        LODMIXNN           CAF      TWO                           	# MIXED.  +2 INTO MIXBR.
011703,000157: 42,2101           54140                           TS       MIXBR                         	#
011704,000158: 42,2102           51002                           INDEX    NOUNREG                       	#
011705,000159: 42,2103           32777                           CAF      RUTMXTAB   -40D               	# FIRST MIXED NOUN = 40.
011706,000160: 42,2104           54153                           TS       RUTMXTEM                      	#
011707,000161: 42,2105           35054                           CAF      LOW10                         	#
011708,000162: 42,2106           70146                           MASK     NNADTEM                       	#
011709,000163: 42,2107           54002                           TS       Q                             	# TEMP
011710,000164: 42,2110           50000                           INDEX    A                             	#
011711,000165: 42,2111           32563                           CAF      IDADDTAB                      	#
011712,000166: 42,2112           54150                           TS       IDAD1TEM                      	# LOAD IDAD1TEM WITH FIRST IDADDTAB ENTRY
011713,000167: 42,2113           00006                           EXTEND                                 	#
011714,000168: 42,2114           50002                           INDEX    Q                             	# LOAD IDAD2TEM WITH 2ND IDADDTAB ENTRY
011715,000169: 42,2115           32565                           DCA      IDADDTAB   +1                 	# LOAD IDAD3TEM WITH 3RD IDADDTAB ENTRY.
011716,000170: 42,2116           52152        LODNLV             DXCH     IDAD2TEM                      	# PUT RETURN INFO INTO A, L.
011717,000171: 42,2117           52006                           DXCH     Z                             	#
011718,000172: 
011719,000173: 42,2120     5033               MIXCON             =        OCT50                         	# FIRST MIXED NOUN =40.  (DEC 40)
011720,000174: 
011721,000175:                                                                                          	# GTSFOUT LOADS SFTEMP1, SFTEMP2 WITH THE DP SFOUTAB ENTRIES.
011723,000177: 
011724,000178: 42,2120           52124        GTSFOUT            DXCH     SFTEMP1                       	# 2X (SFCONUM) ARRIVES IN SFTEMP1.
011725,000179: 42,2121           00006                           EXTEND                                 	#
011726,000180: 42,2122           50000                           INDEX    A                             	#
011727,000181: 42,2123           32514                           DCA      SFOUTAB                       	#
011728,000182: 42,2124           52124        SFCOM              DXCH     SFTEMP1                       	#
011729,000183: 42,2125           52006                           DXCH     Z                             	#

001100,000954:                                                                                          	# 00612         STATE VECTOR IN WRONG SPHERE OF INFLUENCE       P37                                     VARALARM
001101,000955:                                                                                          	# 00613         REENTRY ANGLE OUT OF LIMITS                     P37                                     VARALARM

051494,002241: 00,3063           35021                           CAF      ZERO                          	#
051495,002242: 00,3064           13112                           TCF      LARGE2                        	# GO TO STORE LENGTH AND PROCEED.
051496,002243: 
051497,002244: 00,3065           10135        LARGE              CCS      MPTEMP                        	# MOST ALL CASES COME HERE.
051498,002245: 00,3066           13074                           TCF      LARGE3                        	# SEE IF NO NORMALIZATION WAS REQUIRED BY
051499,002246: 00,3067           42024                           CS       SRDDV                         	# SQRT, AND IF SO, SET UP FOR A SHIFT
051500,002247: 00,3070           54135                           TS       MPTEMP                        	# RIGHT 1 BEFORE DIVIDING TO PRODUCE
051501,002248: 00,3071           00006                           EXTEND                                 	# THE DESIRED HALF UNIT VECTOR.
051502,002249: 00,3072           30155                           DCA      MPAC                          	#
051503,002250:                                                                                          	# Page 1176
051504,002251: 00,3073           13112                           TCF      LARGE2                        	#
051505,002252: 
051506,002253:                                                                                          	# Page 1177

061786,000161: 01,3626           52706                           DXCH     GOLOC                         	#
061787,000162: 
061788,000163: 01,3627           50155        ITSAJOB            NDX      TEMP2G                        	# NOW ADD THE PRIORITY AND LET:S GO
061789,000164: 01,3630           31054                           CA       PHSPRDT1                      	#
061790,000165: 01,3631           54704        CHKNOVAC           TS       GOLOC      -1                 	# SAVE PRIO UNTIL WE SEE IF ITS
061791,000166: 01,3632           00006                           EXTEND                                 	# A FINDVAC OR A NOVAC
061792,000167: 01,3633           63637                           BZMF     ITSNOVAC                      	#
061793,000168: 
061794,000169: 01,3634           33765                           CAF      FVACCADR                      	# POSITIVE, SET UP FINDVAC CALL.
061795,000170: 01,3635           56704                           XCH      GOLOC      -1                 	# PICK UP PRIO,
061796,000171: 01,3636           00704                           TC       GOLOC      -1                 	# AND GO
061797,000172: 
061798,000173: 01,3637           33767        ITSNOVAC           CAF      NOVACADR                      	# NEGATIVE,
061799,000174: 01,3640           56704                           XCH      GOLOC      -1                 	# SET UP NOVAC CALL,
061800,000175: 01,3641           40000                           COM                                    	# CORRECT PRIO,
061801,000176: 01,3642           00704                           TC       GOLOC      -1                 	# AND GO
061802,000177: 

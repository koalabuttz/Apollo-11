051404,002151: 00,2753           12767                           TCF      /MPAC+                        	#
051405,002152: 00,2754           12756                           TCF      +2                            	#
051406,002153: 00,2755           12763                           TCF      /MPAC-                        	#
051407,002154: 
051408,002155: 00,2756           10155                           CCS      MPAC       +1                 	#
051409,002156: 00,2757           12767                           TCF      /MPAC+                        	#
051410,002157: 00,2760           00002                           TC       Q                             	#
051411,002158: 00,2761           12763                           TCF      /MPAC-                        	#
051412,002159: 00,2762           00002                           TC       Q                             	#
051413,002160: 
051414,002161: 00,2763           00006        /MPAC-             EXTEND                                 	# USUAL COMPLEMENTING AND SETTING OF SIGN.
051415,002162: 00,2764           40155                           DCS      MPAC                          	#
051416,002163: 00,2765           52155                           DXCH     MPAC                          	#
051417,002164: 00,2766           24136                           INCR     DVSIGN                        	#
051418,002165: 
051419,002166: 00,2767           45017        /MPAC+             CS       ONE                           	# INITIALIZE NEAR-ONE SWITCH.
051420,002167: 00,2770           54140                           TS       MAXDVSW                       	#
051421,002168: 
051422,002169: 00,2771           40154                           CS       MPAC                          	# CHECK POSSIBLE OVERFLOW.
051423,002170: 00,2772           60133                           AD       BUF2                          	# UNNORMALIZED INPUT DIVISOR.
051424,002171: 00,2773           10000                           CCS      A                             	#
051425,002172: 00,2774           13004                           TCF      DDVCALL                       	# NOT NEAR-ONE
051426,002173: 00,2775           12777                           TCF      +2                            	# +0 IS JUST POSSIBLE
051427,002174: 00,2776           12405                           TCF      DVOVF                         	# NO HOPE
051428,002175: 00,2777           54140                           TS       MAXDVSW                       	# SIGNAL POSSIBLE NEAR-ONE CASE
051429,002176: 00,3000           40155                           CS       MPAC       +1                 	# SEE IF DIVISION CAN BE DONE
051430,002177: 00,3001           60134                           AD       BUF2       +1                 	#
051431,002178: 00,3002           00006                           EXTEND                                 	#

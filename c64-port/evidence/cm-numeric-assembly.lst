004976,003341: E6,1541  E6,1535               ZPIPBUF            EQUALS   YPIPBUF    +1                 	# B(1) ON DOWNLIST ONCE PER SECOND DURING
004977,003342: E6,1541  E6,1536               XOLDBUF            EQUALS   ZPIPBUF    +1                 	# B(1) ENTRY AFTER RCS DAP HAS BEEN DIS-
004978,003343: E6,1541  E6,1537               YOLDBUF            EQUALS   XOLDBUF    +1                 	# B(1) ABLED.  NEWEST PIP VALUE REPLACES
004979,003344: E6,1541  E6,1540               ZOLDBUF            EQUALS   YOLDBUF    +1                 	# B(1) PIPBUF, WHICH IS MOVED INTO OLDBUF.

002035,000400:                                                                                          	# INTERPRETIVE SWITCH BIT ASSIGNMENTS
002036,000401: 37,2001     0074               FLAGWRD0           =        STATE      +0                 	# (000-014)
002037,000402:                                                                                          	# (SET)                 (RESET)
002038,000403:                                                                                          	# BIT 15 FLAG 0
002039,000404: 37,2001                        CPHIFLAG           =        000D                          	# OUTPUT OF CALCGA IS   OUTPUT OF CALCGA IS
002040,000405:                                                                                          	# CPHIX                 THETAD
002041,000406: 37,2001     5001               CPHIBIT            =        BIT15                         	#
002042,000407: 
002043,000408:                                                                                          	# BIT 14 FLAG 0

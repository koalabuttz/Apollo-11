051518,002265: 00,3106           70154                           MP       MPAC                          	#
051519,002266: 00,3107           56001                           XCH      L                             	#
051520,002267: 00,3110           60130                           AD       BUF                           	#
051521,002268: 00,3111           56001                           XCH      L                             	#
051522,002269: 
051523,002270: 00,3112           50120        LARGE2             INDEX    FIXLOC                        	#
051524,002271: 00,3113           52045                           DXCH     LV                            	# LENGTH NOW STORED IN WORK AREA.
051525,002272: 
051526,002273: 00,3114           45017                           CS       ONE                           	#
051527,002274: 00,3115           54140                           TS       MAXDVSW                       	# NO MAXDV CASES IN UNIT.
051528,002275: 
051529,002276: 00,3116           52123                           DXCH     VBUF                          	# PREPARE X COMPONENT FOR DIVIDE, SETTING
051530,002277: 00,3117           52155                           DXCH     MPAC                          	# LENGTH OF VECTOR AS DIVISOR IN BUF.
051531,002278: 00,3120           52131                           DXCH     BUF                           	#
051532,002279: 00,3121           03151                           TC       UNITDV                        	#
051533,002280: 
051534,002281: 00,3122           52125                           DXCH     VBUF       +2                 	# DO Y AND Z IN USUAL FASHION SO WE CAN
051535,002282: 00,3123           52155                           DXCH     MPAC                          	# EXIT THROUGH VROTATEX.
051536,002283: 00,3124           52160                           DXCH     MPAC       +3                 	#
051537,002284: 00,3125           03151                           TC       UNITDV                        	#
051538,002285: 
051539,002286: 00,3126           52127                           DXCH     VBUF       +4                 	#
051540,002287: 00,3127           52155                           DXCH     MPAC                          	#
051541,002288: 00,3130           52162                           DXCH     MPAC       +5                 	#
051542,002289: 00,3131           03151                           TC       UNITDV                        	#
051543,002290: 00,3132           17367                           TCF      VROTATEX                      	# AND EXIT.
051544,002291: 
051545,002292:                                                                                          	# Page 1178
051546,002293:                                                                                          	# IF THE LENGTH OF THE ARGUMENT VECTOR WAS LESS THAN 2(-28), EACH COMPONENT MUST BE SHIFTED LEFT AT LEAST
051547,002294:                                                                                          	# 14 PLACES BEFORE THE DIVIDE, NOTE THAT IN THIS CASE, THE MAJOR PART OF EACH COMPONENT IS ZERO.
051548,002295: 
051549,002296: 00,3133           54135        SMALL              TS       MPTEMP                        	# NEGATIVE OF PRE-DIVIDE SHIFT COUNT.
051550,002297: 
051551,002298: 00,3134           35021                           CAF      ZERO                          	# SHIFT EACH COMPONENT LEFT 14.
051552,002299: 00,3135           56123                           XCH      VBUF       +1                 	#
051553,002300: 00,3136           56122                           XCH      VBUF                          	#
051554,002301: 00,3137           56125                           XCH      VBUF       +3                 	#
051555,002302: 00,3140           56124                           XCH      VBUF       +2                 	#
051556,002303: 00,3141           56127                           XCH      VBUF       +5                 	#
051557,002304: 00,3142           56126                           XCH      VBUF       +4                 	#
051558,002305: 
051559,002306: 00,3143           40135                           CS       MPTEMP                        	#
051560,002307: 00,3144           50000                           INDEX    A                             	#
051561,002308: 00,3145           35002                           CAF      BIT14                         	#
051562,002309: 00,3146           00006                           EXTEND                                 	#
051563,002310: 00,3147           70154                           MP       MPAC                          	#
051564,002311: 00,3150           13062                           TCF      SMALL2                        	#
051565,002312: 
051566,002313: 00,3151     5025               THIRTEEN           =        OCT15                         	#
051567,002314: 00,3151     4333               FOURTEEN           =        OCT16                         	#
051568,002315: 00,3151     4333               OCT16              =        R1D1                          	#
051569,002316: 
051570,002317:                                                                                          	# Page 1179
051571,002318:                                                                                          	# THE FOLLOWING ROUTINE SETS UP THE CALL TO THE DIVIDE ROUTINES.
051572,002319: 
051573,002320: 00,3151           10154        UNITDV             CCS      MPAC                          	# FORCE MPAC POSITIVE IF POSSIBLE, SETTING
051574,002321: 00,3152           13170                           TCF      UMPAC+                        	# DVSIGN ACCORDING TO THE SIGN OF MPAC
051575,002322: 00,3153           13155                           TCF      +2                            	# SINCE THE DIVISOR IS ALWAYS POSITIVE
051576,002323: 00,3154           13162                           TCF      UMPAC-                        	# HERE.
051577,002324: 
051578,002325: 00,3155           10155                           CCS      MPAC       +1                 	#
051579,002326: 00,3156           13170                           TCF      UMPAC+                        	#
051580,002327: 00,3157           00002                           TC       Q                             	# EXIT IMMEDIATELY ON ZERO.
051581,002328: 00,3160           13162                           TCF      UMPAC-                        	#
051582,002329: 00,3161           00002                           TC       Q                             	#
051583,002330: 
051584,002331: 00,3162           45021        UMPAC-             CS       ZERO                          	# IF NEGATIVE, SET -0 IN DVSIGN FOR FINAL
051585,002332: 00,3163           54136                           TS       DVSIGN                        	# COMPLEMENT.
051586,002333: 00,3164           00006                           EXTEND                                 	#
051587,002334: 00,3165           40155                           DCS      MPAC                          	# PICK UP ABSOLUTE VALUE OF ARG AND JUMP.
051588,002335: 00,3166           50135                           INDEX    MPTEMP                        	#
051589,002336: 00,3167           12564                           TCF      MAXTEST    -1                 	#
051590,002337: 
051591,002338: 00,3170           54136        UMPAC+             TS       DVSIGN                        	# SET DVSIGN FOR POSITIVE QUOTIENT.
051592,002339: 00,3171           52155                           DXCH     MPAC                          	#
051593,002340: 00,3172           50135                           INDEX    MPTEMP                        	#
051594,002341: 00,3173           12564                           TCF      MAXTEST    -1                 	#
051595,002342: 
051596,002343:                                                                                          	# Page 1180
051597,002344:                                                                                          	# MISCELLANEOUS UNARY OPERATIONS.
051598,002345: 
051599,002346: 00,3174           03300        DSQ                TC       DSQSUB                        	# SQUARE THE DP CONTENTS OF MPAC.
051600,002347: 00,3175           16030                           TCF      DANZIG                        	#
051601,002348: 
051602,002349: 00,3176           10163        ABVALABS           CCS      MODE                          	# ABVAL OR ABS INSTRUCTION.
051603,002350: 00,3177           13226                           TCF      ABS                           	# DO ABS ON SCALAR.
051604,002351: 00,3200           13226                           TCF      ABS                           	#
051605,002352: 
051606,002353: 00,3201           03317        ABVAL              TC       VSQSUB                        	# DOT MPAC WITH ITSELF.
051607,002354: 00,3202           22163                           LXCH     MODE                          	# MODE IS NOW DP (L ZERO AFTER DAS).
051608,002355: 
051609,002356: 00,3203           00006                           EXTEND                                 	# STORE SQUARE OF LENGTH IN WORK AREA.
051610,002357: 00,3204           30155                           DCA      MPAC                          	#
051611,002358: 00,3205           50120                           INDEX    FIXLOC                        	#
051612,002359: 00,3206           52043                           DXCH     LVSQUARE                      	#
051613,002360: 
051614,002361:                                                                                          	# Page 1181
051615,002362:                                                                                          	# PROGRAM DESCRIPTION -- SUBROUTINE SQRT
051616,002363: 
051617,002364:                                                                                          	# FUNCTIONAL DESCRIPTION -- DOUBLE PRECISION SQUARE ROOT ROUTINE
051618,002365:                                                                                          	#       THIS PROGRAM TAKES THE SQUARE ROOT OF THE 27 OR 28 MOST SIGNIFICANT BITS IN THE TRIPLE PRECISION SET OF
051619,002366:                                                                                          	#       NUMBERS -- MPAC, MPAC+1, AND MPAC+2.  THE ROOT IS RETURNED DOUBLE PRECISION IN MPAC AND MPAC+1.
051620,002367: 
051621,002368:                                                                                          	# WARNING -- THIS SUBROUTINE USES A TRIPLE PRECISION INPUT.  THE PROGRAMMER MUST ASSURE THE CONTENTS OF MPAC+2
051622,002369:                                                                                          	#       ESPECIALLY IF THE CONTENTS OF MPAC IS SMALL OR ZERO.  FOR DETAILS SEE STG MEMO NO.949.
051623,002370: 
051624,002371:                                                                                          	# CALLING SEQUENCE -- IN INTERPRETIVE MODE, I.E., FOLLOWING `TC INTPRET', `SQRT', NO ADDRESS IS ALLOWED.
051625,002372:                                                                                          	#       INPUT SCALING: THE BINARY POINT IS ASSUMED TO THE RIGHT OF BIT 15.  THE ANSWER IS RETURNED WITH THE SAME SCALING.
051626,002373: 
051627,002374:                                                                                          	# SUBROUTINES -- GENSCR, MPACSHR, SQRTSUB, ABORT
051628,002375: 
051629,002376:                                                                                          	# ABORT EXIT MODE -- ABORTS ON NEGATIVE INPUT -1.2X10E-4 (77775 OCTAL) OR LESS.
051630,002377:                                                                                          	#       DISPLAYS ERROR CODE 1302
051631,002378:                                                                                          	#               TC      ABORT
051632,002379:                                                                                          	#               OCT     1302
051633,002380: 
051634,002381:                                                                                          	# DEBRIS -- LOCATIONS BUF, MPTEMP, ADDRWD ARE USED
051635,002382: 
051636,002383: 00,3207           03343        SQRT               TC       SQRTSUB                       	# TAKE THE SQUARE ROOT OF MPAC.
051637,002384: 00,3210           10135                           CCS      MPTEMP                        	# RETURNED NORMALIZED SQUARE ROOT.  SEE IF
051638,002385: 00,3211           13213                           TCF      +2                            	# ANY UN-NORMALIZATION REQUIRED AND EXIT
051639,002386: 00,3212           16030                           TCF      DANZIG                        	# IF NOT.
051640,002387: 
051641,002388: 00,3213           63730                           AD       NEG12                         	# A RIGHT SHIFT OF MORE THAN 13 COULD BE
051642,002389: 00,3214           00006                           EXTEND                                 	# REQUIRED IF INPUT WAS ZERO IN MPAC,+1.
051643,002390: 00,3215           63221                           BZMF     SQRTSHFT                      	# GOES HERE IN MOST CASES.
051644,002391: 00,3216           22007                           ZL                                     	# IF A LONG SHIFT IS REQUIRED, GO TO
051645,002392: 00,3217           22116                           LXCH     ADDRWD                        	# GENERAL RIGHT SHIFT ROUTINES.
051646,002393: 00,3220           12303                           TCF      GENSCR     +4                 	# ADDRWD WAS ZERO TO PREVENT ROUND.
051647,002394: 
051648,002395: 00,3221           50135        SQRTSHFT           INDEX    MPTEMP                        	# SELECT SHIFTING BIT AND EXIT THROUGH
051649,002396: 00,3222           35001                           CAF      BIT15                         	# SHIFT ROUTINES.
051650,002397: 00,3223           54135                           TS       MPTEMP                        	#
051651,002398: 00,3224           35021                           CAF      ZERO                          	# TO ZERO MPAC +2 IN THE PROCESS.
051652,002399: 00,3225           12036                           TCF      MPACSHR    +3                 	#
051653,002400: 
051654,002401: 00,3226           06672        ABS                TC       BRANCH                        	# TEST SIGN OF MPAC AND COMPLEMENT IF
051655,002402: 00,3227           16030                           TCF      DANZIG                        	#
051656,002403: 00,3230           16030                           TCF      DANZIG                        	#
051657,002404: 00,3231           17637                           TCF      COMP                          	#
051658,002405: 
051659,002406:                                                                                          	# Page 1182
051660,002407: 00,3232           45015        VDEF               CS       FOUR                          	# VECTOR DEFINE -- ESSENTIALLY TREATS
051661,002408: 00,3233           26166                           ADS      PUSHLOC                       	# SCALAR IN MPAC AS X COMPONENT, PUSHES UP
051662,002409: 00,3234           00006                           EXTEND                                 	# FOR Y AND THEN AGAIN FOR Z.
051663,002410: 00,3235           50000                           INDEX    A                             	#
051664,002411: 00,3236           30003                           DCA      2                             	#
051665,002412: 00,3237           52160                           DXCH     MPAC       +3                 	#
051666,002413: 00,3240           00006                           EXTEND                                 	#
051667,002414: 00,3241           50166                           INDEX    PUSHLOC                       	#
051668,002415: 00,3242           30001                           DCA      0                             	#
051669,002416: 00,3243           52162                           DXCH     MPAC       +5                 	#
051670,002417: 00,3244           16470                           TCF      VMODE                         	# MODE IS NON VECTOR.
051671,002418: 
051672,002419: 00,3245           03317        VSQ                TC       VSQSUB                        	# DOT MPAC WITH ITSELF.
051673,002420: 00,3246           17301                           TCF      DMODE                         	# MODE IS NOW DP.
051674,002421: 
051675,002422: 00,3247           00006        PUSH               EXTEND                                 	# PUSH DOWN MPAC LEAVING IT LOADED.
051676,002423: 00,3250           30155                           DCA      MPAC                          	#
051677,002424: 00,3251           50166                           INDEX    PUSHLOC                       	# PUSH DOWN FIRST TWO REGISTERS IN EACH
051678,002425: 00,3252           52001                           DXCH     0                             	#
051679,002426: 
051680,002427: 00,3253           50163                           INDEX    MODE                          	# INCREMENT PUSHDOWN POINTER.
051681,002428: 00,3254           36213                           CAF      NO.WDS                        	#
051682,002429: 00,3255           26166                           ADS      PUSHLOC                       	#
051683,002430: 
051684,002431: 00,3256           10163                           CCS      MODE                          	#
051685,002432: 00,3257           13272                           TCF      TPUSH                         	# PUSH DOWN MPAC +2.
051686,002433: 00,3260           16030                           TCF      DANZIG                        	# DONE FOR DP.
051687,002434: 
051688,002435: 00,3261           00006                           EXTEND                                 	# ON VECTOR, PUSH DOWN Y AND Z COMPONENTS.
051689,002436: 00,3262           30160                           DCA      MPAC       +3                 	#
051690,002437: 00,3263           50166                           INDEX    PUSHLOC                       	#
051691,002438: 00,3264           51775                           DXCH     0          -4                 	#
051692,002439: 00,3265           00006                           EXTEND                                 	#
051693,002440: 00,3266           30162                           DCA      MPAC       +5                 	#
051694,002441: 00,3267           50166                           INDEX    PUSHLOC                       	#
051695,002442: 00,3270           51777                           DXCH     0          -2                 	#
051696,002443: 00,3271           16030                           TCF      DANZIG                        	#
051697,002444: 
051698,002445: 00,3272           30156        TPUSH              CA       MPAC       +2                 	#
051699,002446: 00,3273           16523                           TCF      ENDTPUSH   +2                 	#
051700,002447: 
051701,002448: 00,3274           50120        RVQ                INDEX    FIXLOC                        	# RVQ -- RETURN IVA QPRET.
051702,002449: 00,3275           30052                           CA       QPRET                         	#
051703,002450: 00,3276           54117                           TS       POLISH                        	#
051704,002451: 00,3277           16621                           TCF      GOTO       +4                 	# (ASSUME QPRET POINTS TO FIXED ONLY.)
051705,002452: 
051706,002453:                                                                                          	# Page 1183
051707,002454:                                                                                          	# THE FOLLOWING SUBROUTINES ARE USED IN SQUARING MPAC, IN BOTH THE SCALAR AND VECTOR SENSE.  THEY ARE
051708,002455:                                                                                          	# SPECIAL CASES OF DMPSUB AND DOTSUB, PUT IN TO SAVE SOME TIME.
051709,002456: 
051710,002457: 00,3300           30155        DSQSUB             CA       MPAC       +1                 	# SQUARES THE SCALAR CONTENTS OF MPAC.
051711,002458: 00,3301           00006                           EXTEND                                 	#
051712,002459: 00,3302           70000                           SQUARE                                 	#
051713,002460: 00,3303           54156                           TS       MPAC       +2                 	#
051714,002461: 00,3304           35021                           CAF      ZERO                          	# FORM 2(CROSS TERM).
051715,002462: 00,3305           56155                           XCH      MPAC       +1                 	#
051716,002463: 00,3306           00006                           EXTEND                                 	#
051717,002464: 00,3307           70154                           MP       MPAC                          	#
051718,002465: 00,3310           20001                           DDOUBL                                 	# AND MAYBE OVEFLOW.
051719,002466: 00,3311           20156                           DAS      MPAC       +1                 	# AND SET A TO NET OVERFLOW.
051720,002467: 00,3312           56154                           XCH      MPAC                          	#
051721,002468: 00,3313           00006                           EXTEND                                 	#
051722,002469: 00,3314           70000                           SQUARE                                 	#
051723,002470: 00,3315           20155                           DAS      MPAC                          	#
051724,002471: 00,3316           00002                           TC       Q                             	#
051725,002472: 
051726,002473: 00,3317           00006        VSQSUB             EXTEND                                 	# DOTS THE VECTOR IN MPAC WITH ITSELF.
051727,002474: 00,3320           22137                           QXCH     DOTRET                        	#
051728,002475: 00,3321           03300                           TC       DSQSUB                        	# SQUARE THE X COMPONENT.
051729,002476: 00,3322           52160                           DXCH     MPAC       +3                 	#
051730,002477: 00,3323           52155                           DXCH     MPAC                          	#
051731,002478: 00,3324           52131                           DXCH     BUF                           	# SO WE CAN END IN DOTSUB.
051732,002479: 00,3325           30156                           CA       MPAC       +2                 	#
051733,002480: 00,3326           54132                           TS       BUF        +2                 	#
051734,002481: 
051735,002482: 00,3327           03300                           TC       DSQSUB                        	# SQUARE Y COMPONENT.
051736,002483: 00,3330           52156                           DXCH     MPAC       +1                 	#
051737,002484: 00,3331           20132                           DAS      BUF        +1                 	#
051738,002485: 00,3332           60154                           AD       MPAC                          	#
051739,002486: 00,3333           60130                           AD       BUF                           	#
051740,002487: 00,3334           54130                           TS       BUF                           	#
051741,002488: 00,3335           13337                           TCF      +2                            	#
051742,002489: 00,3336           54121                           TS       OVFIND                        	# IF OVERFLOW.
051743,002490: 
051744,002491: 00,3337           52162                           DXCH     MPAC       +5                 	#
051745,002492: 00,3340           52155                           DXCH     MPAC                          	#
051746,002493: 00,3341           03300                           TC       DSQSUB                        	# SQUARE Z COMPONENT.
051747,002494: 00,3342           17154                           TCF      ENDDOT                        	# END AS IN DOTSUB.
051748,002495: 
051749,002496:                                                                                          	# Page 1184
051750,002497:                                                                                          	# DOUBLE PRECISION SQUARE ROOT ROUTINE.  TAKE THE SQUARE ROOT OF THE TRIPLE PRECISION (MPAC +2 USED ONLY
051751,002498:                                                                                          	# IN NORMALIZATION) CONTENTS OF MPAC AND LEAVE THE NORMALIZED RESULT IN MPAC (C(MPAC) GREATER THAN OR EQUAL TO
051752,002499:                                                                                          	# .5).  THE RIGHT SHIFT COUNT (TC UNNORMALIZE) IS LEFT IN MPTEMP.
051753,002500: 
051754,002501: 00,3343           35021        SQRTSUB            CAF      ZERO                          	# START BY ZEROING RIGHT SHIFT COUNT.
051755,002502: 00,3344           54135                           TS       MPTEMP                        	#
051756,002503: 
051757,002504: 00,3345           10154                           CCS      MPAC                          	# CHECK FOR POSITIVE ARGUMENT, SHIFTING
051758,002505: 00,3346           13404                           TCF      SMPAC+                        	# FIRST SIGNIFICANT MPAC REGISTER INTO
051759,002506: 00,3347           13351                           TCF      +2                            	# MPAC ITSELF.
051760,002507: 00,3350           13373                           TCF      SQRTNEG                       	# SEE IF MAG OF ARGUMENT LESS THAN 10(-4).
051761,002508: 
051762,002509: 00,3351           56156                           XCH      MPAC       +2                 	# MPAC IS ZERO -- SHIFT LEFT 14.
051763,002510: 00,3352           56155                           XCH      MPAC       +1                 	#
051764,002511: 00,3353           54154                           TS       MPAC                          	#
051765,002512: 00,3354           35023                           CAF      SEVEN                         	# AUGMENT RIGHT SHIFT COUNTER.
051766,002513: 00,3355           54135                           TS       MPTEMP                        	#
051767,002514: 
051768,002515: 00,3356           10154                           CCS      MPAC                          	# SEE IF MPAC NOW PNZ.
051769,002516: 00,3357           13404                           TCF      SMPAC+                        	#
051770,002517: 00,3360           13362                           TCF      +2                            	#
051771,002518: 00,3361           13376                           TCF      ZEROANS                       	# NEGATIVE BUT LESS THAN 10(-4) IN MAG.
051772,002519: 
051773,002520: 00,3362           56155                           XCH      MPAC       +1                 	# XERO -- SHIFT LEFT 14 AGAIN.
051774,002521: 00,3363           54154                           TS       MPAC                          	#
051775,002522: 00,3364           35023                           CAF      SEVEN                         	# AUGMENT RIGHT SHIFT COUNTER.
051776,002523: 00,3365           26135                           ADS      MPTEMP                        	#
051777,002524: 
051778,002525: 00,3366           10154                           CCS      MPAC                          	#
051779,002526: 00,3367           13404                           TCF      SMPAC+                        	#
051780,002527: 00,3370           00002                           TC       Q                             	# SQRT(0) = 0.
051781,002528: 00,3371           13376                           TCF      ZEROANS                       	#
051782,002529: 00,3372           13452                           TCF      FIXROOT                       	# DO NOT LEAVE SQRTSUB WITH -0 IN MPAC.
051783,002530: 
051784,002531: 00,3373           10000        SQRTNEG            CCS      A                             	# ARGUMENT IS NEGATIVE, BUT SEE IF SIGN-
051785,002532: 00,3374           13402                           TCF      SQRTABRT                      	# CORRECTED ARGUMENT IS LESS THAN 10(-4)
051786,002533: 
051787,002534: 00,3375           10155                           CCS      MPAC       +1                 	# IN MAGNITUDE.  IF SO, CALL ANSWER ZERO.
051788,002535: 00,3376           35021        ZEROANS            CAF      ZERO                          	# FORCE ANSWER TO ZERO HERE.
051789,002536: 00,3377           13452                           TCF      FIXROOT                       	#
051790,002537: 00,3400           13402                           TCF      SQRTABRT                      	#
051791,002538: 00,3401           13452                           TCF      FIXROOT                       	#
051792,002539: 
051793,002540: 00,3402           05721        SQRTABRT           TC       POODOO                        	#
051794,002541: 00,3403           01302                           OCT      1302                          	#
051795,002542: 
051796,002543:                                                                                          	# Page 1185
051797,002544: 00,3404           62444        SMPAC+             AD       -1/2+2                        	# SEE IF ARGUMENT GREATER THAN OR EQUAL TO
051798,002545: 00,3405           00006                           EXTEND                                 	# .5.
051799,002546: 00,3406           63455                           BZMF     SRTEST                        	# IF SO, SEE IF LESS THAN .25.
051800,002547: 
051801,002548: 00,3407           52155                           DXCH     MPAC                          	# WE WILL TAKE THE SQUARE ROOT OF MPAC/2.
051802,002549: 00,3410           22021                           LXCH     SR                            	# SHIFT RIGHT 1 AND GO TO THE SQRT ROUTINE
051803,002550: 00,3411           00006                           EXTEND                                 	#
051804,002551: 00,3412           75002                           MP       HALF                          	#
051805,002552: 00,3413           52155                           DXCH     MPAC                          	#
051806,002553: 00,3414           56021                           XCH      SR                            	#
051807,002554: 00,3415           26155                           ADS      MPAC       +1                 	# GUARANTEED NO OVERFLOW.
051808,002555: 
051809,002556: 00,3416           32314        ARGHI              CAF      SLOPEHI                       	# ARGUMENT BETWEEN .25 AND .5, GET A
051810,002557: 00,3417           00006                           EXTEND                                 	# LINEAR APPROXIMATION FOR THIS RANGE.
051811,002558: 00,3420           70154                           MP       MPAC                          	#
051812,002559: 00,3421           62566                           AD       BIASHI                        	# X0/2 = (MPAC/2)(SLOPHI) + BIASHI/2.
051813,002560: 
051814,002561: 00,3422           54130                 +4        TS       BUF                           	# X0/2 (ARGLO ENTERS HERE).
051815,002562: 00,3423           30154                           CA       MPAC                          	# SINGLE-PRECISION THROUGHOUT.
051816,002563: 00,3424           22007                           ZL                                     	#
051817,002564: 00,3425           00006                           EXTEND                                 	#
051818,002565: 00,3426           10130                           DV       BUF                           	# (MPAC/2)/(X0/2)
051819,002566: 00,3427           00006                           EXTEND                                 	#
051820,002567: 00,3430           75002                           MP       HALF                          	#
051821,002568: 00,3431           26130                           ADS      BUF                           	# X1 = X0/2 + .5(MPAX/2)/(X0/2)
051822,002569: 
051823,002570: 00,3432           00006                           EXTEND                                 	#
051824,002571: 00,3433           75002                           MP       HALF                          	# FORM UP X1/2.
051825,002572: 00,3434           52155                           DXCH     MPAC                          	# SAVE AND BRING OUT ARGUMENT.
051826,002573: 00,3435           00006                           EXTEND                                 	# TAKE DP QUOTIENT WITH X1.
051827,002574: 00,3436           10130                           DV       BUF                           	#
051828,002575: 00,3437           54131                           TS       BUF        +1                 	# SAVE MAJOR PART OF QUOTIENT.
051829,002576: 00,3440           35021                           CAF      ZERO                          	# FORM MINOR PART OF QUOTIENT USING
051830,002577: 00,3441           56001                           XCH      L                             	# (REMAINDER,0).
051831,002578: 00,3442           00006                           EXTEND                                 	#
051832,002579: 00,3443           10130                           DV       BUF                           	#
051833,002580: 00,3444           54001                           TS       L                             	# IN PREPARATION FOR DAS.
051834,002581: 00,3445           30131                           CA       BUF        +1                 	#
051835,002582: 00,3446           20155                           DAS      MPAC                          	# X2 = X1/2 + (MPAC/2)X1
051836,002583: 
051837,002584: 00,3447           00006                           EXTEND                                 	# OVERFLOWS IF ARG. NEAR POSMAX.
051838,002585: 00,3450           13454                           BZF      TCQBNK00                      	#
051839,002586: 00,3451           34777                           CAF      POSMAX                        	#
051840,002587: 00,3452           54154        FIXROOT            TS       MPAC                          	#
051841,002588: 00,3453           54155                           TS       MPAC       +1                 	#
051842,002589: 00,3454           00002        TCQBNK00           TC       Q                             	# RETURN TO CALLER TO UNNORMALIZE, ETC.
051843,002590: 
051844,002591:                                                                                          	# Page 1186
051845,002592: 00,3455           65003        SRTEST             AD       QUARTER                       	# ARGUMENT WAS LESS THAN .5, SEE IF LESS
051846,002593: 00,3456           00006                           EXTEND                                 	# THAN .25.
051847,002594: 00,3457           63501                           BZMF     SQRTNORM                      	# IF SO, BEGIN NORMALIZATION.
051848,002595: 
051849,002596: 00,3460           52155                           DXCH     MPAC                          	# IF BETWEEN .5 AND .25, SHIFT RIGHT 1 AND
051850,002597: 00,3461           22021                           LXCH     SR                            	# START AT ARGLO.
051851,002598: 00,3462           00006                           EXTEND                                 	#
051852,002599: 00,3463           75002                           MP       HALF                          	#
051853,002600: 00,3464           52155                           DXCH     MPAC                          	#
051854,002601: 00,3465           56021                           XCH      SR                            	#
051855,002602: 00,3466           26155                           ADS      MPAC       +1                 	# NO OVERFLOW.
051856,002603: 
051857,002604: 00,3467           33007        ARGLO              CAF      SLOPELO                       	# (NORMALIZED) ARGUMENT BETWEEN .125 AND
051858,002605: 00,3470           00006                           EXTEND                                 	# .25
051859,002606: 00,3471           70154                           MP       MPAC                          	#
051860,002607: 00,3472           62270                           AD       BIASLO                        	#
051861,002608: 00,3473           13422                           TCF      ARGHI      +4                 	# BEGIN SQUARE ROOT.
051862,002609: 
051863,002610: 00,3474           00006        SQRTNM2            EXTEND                                 	# SHIFT LEFT 2 AND INCREMENT RIGHT SHIFT
051864,002611: 00,3475           30156                           DCA      MPAC       +1                 	# COUNT (FOR TERMINAL UNNORMALIZATION).
051865,002612: 00,3476           20156                           DAS      MPAC       +1                 	#
051866,002613: 00,3477           60154                           AD       MPAC                          	#
051867,002614: 00,3500           26154                           ADS      MPAC                          	# (NO OVERFLOW).
051868,002615: 
051869,002616: 00,3501           24135        SQRTNORM           INCR     MPTEMP                        	# FIRST TIME THROUGH, JUST SHIFT LEFT 1
051870,002617: 00,3502           00006                           EXTEND                                 	# (PUTS IN EFFECTIVE RIGHT SHIFT SINCE
051871,002618: 00,3503           30156                           DCA      MPAC       +1                 	# WE WANT MPAC/2).
051872,002619: 00,3504           20156                           DAS      MPAC       +1                 	#
051873,002620: 00,3505           60154                           AD       MPAC                          	#
051874,002621: 00,3506           26154                           ADS      MPAC                          	# (AGAIN NO OVERFLOW).
051875,002622: 00,3507           60000                           DOUBLE                                 	#
051876,002623: 00,3510           54022                           TS       CYL                           	#
051877,002624: 
051878,002625: 00,3511           10022        NORMTEST           CCS      CYL                           	# SEE IF ARGUMENT NOW NORMALIZED AT
051879,002626: 00,3512           10022                           CCS      CYL                           	# GREATER THAN .125.
051880,002627: 00,3513           13474                           TCF      SQRTNM2                       	# NO -- SHIFT LEFT 2 MORE AND TRY AGAIN.
051881,002628: 00,3514           13416                           TCF      ARGHI                         	# YES -- NOW BETWEEN .5 AND .25.
051882,002629: 00,3515           13467                           TCF      ARGLO                         	# ARGUMENT NOW BETWEEN .25 AND .125.
051883,002630: 
051884,002631:                                                                                          	# Page 1187
051885,002632:                                                                                          	# TRIGONOMETRIC FUNCTION PACKAGE.
051886,002633:                                                                                          	#       THE FOLLOWING TRIGONOMETRIC FUNCTIONS ARE AVAILABLE AS INTERPRETIVE OPERATIONS:
051887,002634:                                                                                          	#       1.      SIN             COMPUTES (1/2)SINE(2 PI MPAC).
051888,002635:                                                                                          	#       2.      COS             COMPUTES (1/2)COSINE(2 PI MPAC).
051889,002636:                                                                                          	#       3.      ASIN            COMPUTES (1/2PI)ARCSINE(2 MPAC).
051890,002637:                                                                                          	#       4.      ACOS            COMPUTES (1/2PI)ARCCOSINE(2 MPAC).
051891,002638: 
051892,002639:                                                                                          	# SIN-ASIN AND COS-ACOS ARE MUTUALLY INVERSE, I.E., SIN(ASIN(X)) = X.
051893,002640: 
051894,002641: 00,3516           06672        COSINE             TC       BRANCH                        	# FINDS COSINE USING THE IDENTITY
051895,002642: 00,3517           13522                           TCF      +3                            	# COS(X) = SIN(PI/2 - ABS(X)).
051896,002643: 00,3520           13525                           TCF      PRESINE                       	#
051897,002644: 00,3521           13525                           TCF      PRESINE                       	#
051898,002645: 
051899,002646: 00,3522           00006                 +3        EXTEND                                 	#
051900,002647: 00,3523           40155                           DCS      MPAC                          	#
051901,002648: 00,3524           52155                           DXCH     MPAC                          	#
051902,002649: 
051903,002650: 00,3525           35003        PRESINE            CAF      QUARTER                       	# PI/2 SCALED.
051904,002651: 00,3526           26154                           ADS      MPAC                          	#
051905,002652: 
051906,002653: 00,3527           52155        SINE               DXCH     MPAC                          	# DOUBLE ARGUMENT.
051907,002654: 00,3530           20001                           DDOUBL                                 	#
051908,002655: 00,3531           54000                           OVSK                                   	# SEE IF OVERFLOW PRESENT.
051909,002656: 00,3532           13535                           TCF      +3                            	# IF NOT, ARGUMENT OK AS IS.
051910,002657: 
051911,002658: 00,3533           00006                           EXTEND                                 	# IF SO, WE LOST (OR GAINED) PI, SO
051912,002659: 00,3534           40001                           DCOM                                   	# COMPLEMENT MPAC USING THE IDENTITY
051913,002660:                                                                                          	# SIN(X-(+)PI) = SIN(-X).
051914,002661: 00,3535           52155                 +3        DXCH     MPAC                          	#
051915,002662: 00,3536           30154                           CA       MPAC                          	# SEE IF ARGUMENT GREATER THAN .5 IN
051916,002663: 00,3537           60000                           DOUBLE                                 	# MAGNITUDE.  IF SO, REDUCE IT TO LESS THAN
051917,002664: 00,3540           54001                           TS       L                             	# .5 (+-PI/2 SCALED) AS FOLLOWS:
051918,002665: 00,3541           13552                           TCF      SN1                           	#
051919,002666: 

037674,000307:                                                                                          	# VRCONTRL      RDOT TO START INTO HUNTEST                              700     FPS
037675,000308:                                                                                          	#               VRCONT=COMPUTER NAME
037676,000309:                                                                                          	# 25NM          TOLERANCE TO STOP RANGE ITERATION                       25      NM
037677,000310:                                                                                          	# VQUIT         VELOCITY TO STOP STEERING                               1000    FPS

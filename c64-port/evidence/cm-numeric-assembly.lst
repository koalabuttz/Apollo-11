014358,001136: 
014360,001138:                                                                                          	#          NOUN   TABLES
014361,001139:                                                                                          	# NOUN CODE L/40, NORMAL NOUN CASE.  NOUN CODE G/E 40, MIXED NOUN CASE.
014362,001140:                                                                                          	# FOR NORMAL CASE, NNADTAB CONTAINS ONE       ECADR FOR EACH NOUN.
014363,001141:                                                                                          	# +0 INDICATES NOUN NOT USED.   - ENTRY INDICATES MACHINE CADR(E OR F) TO
014364,001142:                                                                                          	# BE SPECIFIED. -1 INDICATES CHANNEL TO BE SPECIFIED. -0 INDICATES AUGMENT
014365,001143:                                                                                          	# OF LAST MACHINE CADR SUPPLIED.
014366,001144: 
014367,001145:                                                                                          	# FOR MIXED CASE, NNADTAB CONTAINS ONE INDIRECT ADDRESS(IDADDREL) IN LOW
014368,001146:                                                                                          	# 10 BITS, AND THE COMPONENT CODE NUMBER IN THE HIGH 5 BITS.
014369,001147: 
014370,001148:                                                                                          	# NNTYPTAB IS A PACKED TABLE OF THE FORM MMMMMNNNNNPPPPP.
014371,001149: 
014372,001150:                                                                                          	# FOR THE NORMAL CASE,  M-S ARE THE COMPONENT CODE NUMBER.
014373,001151:                                                                                          	#                       N-S ARE THE SF ROUTINE CODE NUMBER.
014374,001152:                                                                                          	#                       P-S ARE THE SF CONSTANT CODE NUMBER.
014375,001153: 
014376,001154:                                                                                          	# MIXED-CASE,M-S ARE THE SF CONSTANT3 CODE NUMBER      3 COMPONENT CASE
014377,001155:                                                                                          	#            N-S ARE THE SF CONSTANT2 CODE NUMBER
014378,001156:                                                                                          	#            P-S ARE THE SF CONSTANT1 CODE NUMBER
014379,001157:                                                                                          	#            N-S ARE THE SF CONSTANT2 CODE NUMBER      2 COMPONENT CASE
014380,001158:                                                                                          	#            P-S ARE THE SF CONSTANT1 CODE NUMBER
014381,001159:                                                                                          	#            P-S ARE THE SF CONSTANT1 CODE NUMBER       1 COMPONENT CASE
014382,001160: 
014383,001161:                                                                                          	# THERE IS ALSO AN INDIRECT ADDRESS TABLE(IDADDTAB) FOR MIXED CASE ONLY
014384,001162:                                                                                          	# EACH ENTRY CONTAINS ONE ECADR.    IDADDREL IS THE RELATIVE ADDRESS OF
014385,001163:                                                                                          	# THE FIRST OF THESE ENTRIES.
014386,001164:                                                                                          	# THERE IS ONE ENTRY IN THIS TABEL FOR EACH COMPONENT OF A MIXED NOUN
014387,001165:                                                                                          	# THEY ARE LISTED IN ORDER OF ASCENDING K.
014388,001166: 
014389,001167:                                                                                          	# THERE IS ALSO A SCALE FACTOR ROUTINE NUMBER TABLE( RUTMXTAB ) FOR MIXED
014390,001168:                                                                                          	# CASE ONLY. THERE IS ONE ENTRY PER MIXED NOUN. THE FORM IS,
014391,001169:                                                                                          	#       QQQQQRRRRRSSSSS
014392,001170:                                                                                          	# Q-S ARE THE SF ROUTINE 3 CODE NUMBER     3 COMPONENT CASE
014393,001171:                                                                                          	# R-S ARE THE SF ROUTINE 2 CODE NUMBER
014394,001172:                                                                                          	# S-S ARE THE SF ROUTINE 1 CODE NUMBER
014395,001173:                                                                                          	# R-S ARE THE SF ROUTINE 2 CODE NUMBER     2 COMPONENT CASE
014396,001174:                                                                                          	# S-S ARE THE SF ROUTINE 1 CODE NUMBER
014397,001175: 
014398,001176: 
014399,001177:                                                                                          	# IN OCTAL DISPLAY AND LOAD (OCT OR DEC) VERBS, EXCLUDE USE OF VERBS WHOSE
014400,001178:                                                                                          	# COMPONENT NUMBER IS GREATER THAN THE NUMBER OF COMPONENTS IN NOUN.
014401,001179:                                                                                          	# (ALL MACHINE ADDRESS TO BE SPECIFIED NOUNS ARE 3 COMPONENT.)
014402,001180: 
014403,001181: 
014404,001182:                                                                                          	# IN MULTI-COMPONENT LOAD VERBS, NO MIXING OF OCTAL AND DECIMAL DATA
014405,001183:                                                                                          	# COMPONENT WORDS IS ALLOWED.  ALARM IF VIOLATION.
014406,001184: 
014407,001185:                                                                                          	# IN DECIMAL LOADS OF DATA, 5 NUMERICAL CHARACTERS MUST BE KEYED IN
014408,001186:                                                                                          	# BEFORE EACH ENTER. IF NOT, ALARM.
014409,001187: 

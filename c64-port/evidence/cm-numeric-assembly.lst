061911,000286: 01,3734           54706                           TS       GOLOC      +1                 	#
061912,000287:                                                                                          	# Page 1419
061913,000288: 01,3735           50156                           NDX      POINTER                       	# GET THE DT AND FIND OUT IF IT WAS STORED
061914,000289: 01,3736           32000                           CA       PRDTTAB                       	# DIRECTLY OR INDIRECTLY
061915,000290: 

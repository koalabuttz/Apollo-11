037312,000751: 37,3405           41455                           VAD      PUSH                          	#
037313,000752: 37,3406           01760                                    UNITR                         	#
037314,000753: 37,3407           60345        ITISMOON           DLOAD    NORM                          	#
037315,000754: 37,3410           00043                                    34D                           	#
037316,000755: 37,3411           00050                                    X2                            	#
037317,000756: 37,3412           53663                           BDDV*    SLR*                          	#
037319,000758: 37,3413           37453                                    -MUDT(E),1                    	#
037320,000759: 37,3414           56623                                    0          -21D,2             	#
037321,000760: 37,3415           45561                           VXSC     STADR                         	#
037322,000761: 37,3416           76527                           STORE    GDT1/2                        	# SCALED AT 2(+7) M/CS
037323,000762: 37,3417           77616                           RVQ                                    	#
037324,000763: 
037325,000764: 37,3420           74375        CALCRVG            VLOAD    VXSC                          	#
037326,000765: 37,3421           01163                                    DELV                          	#
037327,000766: 37,3422           37451                                    KPIP1                         	#
037328,000767: 37,3423           76505                           VXM      VSL1                          	#
037329,000768: 37,3424           01736                                    REFSMMAT                      	#
037330,000769: 37,3425           03433                           STORE    DELVREF                       	# DELV IN REF COORDS AT 2(+7)
037331,000770: 37,3426           41562                           VSR1     PUSH                          	#

054492,000360:                                                                                          	# CONSTANTS AND ERASABLE ASSIGNMENTS
054493,000361: 
054494,000362: 26,3636  04,3563               1B1                =        DP1/2                         	# 1 SCALED B-1
054495,000363: 26,3636           17775 02052  COSI               2DEC     .99964173  B-1                	# COS(5521.5 SEC) B-1
054496,000364: 
054497,000365: 26,3640           00333 10374  SINI               2DEC     .02676579  B-1                	# SIN(5521.5 SEC) B-1
054498,000366: 
054499,000367: 26,3642  0000050               RPREXIT            =        S1                            	# R-TO-RP AND RP-TO-R SUBR EXIT
054500,000368: 26,3642  0000051               EARTHMXX           =        S2                            	# EARTHMX, MOONMX SUBR. EXITS
054501,000369: 26,3642                        504RPR             =        0D                            	# 6 REGS        R OR RP VECTOR
054502,000370: 26,3642                        SINNODI            =        8D                            	# 2             SIN(NODI)
054503,000371: 26,3642                        DVECTR             =        8D                            	# 6             D VECTOR MOON
054504,000372: 26,3642                        CVECTR             =        8D                            	# 6             C VECTR MOON
054505,000373: 26,3642                        504AZ              =        18D                           	# 2             AZ
054506,000374: 26,3642                        TIMSUBM            =        14D                           	# 3             TIME SUB M (MOON) T+T0 IN GETAZ
054507,000375: 26,3642                        504LPL             =        14D                           	# 6             L OR LP VECTOR
054508,000376: 26,3642                        AVECTR             =        20D                           	# 6             A VECTOR (MOON)
054509,000377: 26,3642                        BVECTR             =        26D                           	# 6             B VECTOR (MOON)
054510,000378: 26,3642                        MMATRIX            =        20D                           	# 18            M MATRIX
054511,000379: 26,3642                        COB                =        32D                           	# 2             COS(B) B-1
054512,000380: 26,3642                        SOB                =        34D                           	# 2             SIN(B) B-1
054513,000381: 26,3642                        504F               =        6D                            	# 2             F(MOON)
054514,000382: 26,3642           77665 42175  NODDOT             2DEC     -.457335121 E-2                	# REVS/CSEC B+28=-1.07047011 E-8  RAD/SEC
054515,000383: 
054516,000384: 26,3644           22211 00625  FDOT               2DEC     .570863327                    	# REVS/CSEC B+27= 2.67240410 E-6  RAD/SEC
054517,000385: 
054518,000386: 26,3646           77777 77767  BDOT               2DEC     -3.07500686 E-8                	# REVS/CSEC B+28=-7.19757301 E-14 RAD/SEC
054519,000387: 
054520,000388: 26,3650           37436 01613  NODIO              2DEC     .986209434                    	# REVS B-0      = 6.19653663041   RAD
054521,000389: 
054522,000390: 26,3652           32417 32160  FSUBO              2DEC     .829090536                    	# REVS B-0      = 5.20932947829   RAD
054523,000391: 
054524,000392: 26,3654           02052 35552  BSUBO              2DEC     .0651201393                    	# REVS B-0      = 0.40916190299   RAD
054525,000393: 
054526,000394: 26,3656           37116 32523  WEARTH             2DEC     .973561595                    	# REVS/CSEC B+23= 7.29211494 E-5  RAD/SEC

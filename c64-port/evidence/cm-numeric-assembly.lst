029331,000304: 
029333,000306:                                                                                          	# CONSTANT DELTA HEIGHT (CDH) PROGRAMS (P33 AND P73)
029334,000307:                                                                                          	# MOD NO -1                     LOG SECTION - P32-P35, P72-P75
029335,000308:                                                                                          	# MOD BY WHITE.P                DATE  1JUNE67
029336,000309: 
029337,000310:                                                                                          	# PURPOSE
029338,000311: 
029339,000312:                                                                                          	#       (1)     TO CALCULATE PARAMETERS ASSOCIATED WITH THE CONSTANT DELTA
029340,000313:                                                                                          	#               ALTITUDE MANEUVER (CDH).
029341,000314: 
029342,000315:                                                                                          	#       (2)     TO CALCULATE THESE PARAMETERS BASED UPON MANEUVER DATA
029343,000316:                                                                                          	#               APPROVED AND KEYED INTO THE DSKY BY THE ASTRONAUT.
029344,000317: 
029345,000318:                                                                                          	#       (3)     TO DISPLAY TO THE ASTRONAUT AND THE GROUND DEPENDENT VARIABLES
029346,000319:                                                                                          	#               ASSOCIATED WITH THE CDH MANEUVER FOR APPROVAL BY THE
029347,000320:                                                                                          	#               ASTRONAUT/GROUND.
029348,000321: 
029349,000322:                                                                                          	#       (4)     TO STORE THE CDH TARGET PARAMETERS FOR USE BY THE DESIRED
029350,000323:                                                                                          	#               THRUSTING PROGRAM.
029351,000324: 
029352,000325:                                                                                          	# ASSUMPTIONS
029353,000326: 
029354,000327:                                                                                          	#       (1)     THIS PROGRAM IS BASED UPON PREVIOUS COMPLETION OF THE
029355,000328:                                                                                          	#               CO-ELLIPTIC SEQUENCE INITIATION (CSI) PROGRAM (P32/P72).
029356,000329:                                                                                          	#               THERFORE -
029357,000330: 
029358,000331:                                                                                          	#               (A)     AT A SELECTED TPI TIME (NOW IN STORAGE) THE LINE OF SIGHT
029359,000332:                                                                                          	#                       BETWEEN THE ACTIVE AND PASSIVE VEHICLES WAS SELECTED TO BE
029360,000333:                                                                                          	#                       A PRESCRIBED ANGLE (E) (NOW IN STORAGE) FROM THE
029361,000334:                                                                                          	#                       HORIZONTAL PLANE DEFINED BY THE ACTIVE VEHICLE POSITION.
029362,000335: 
029363,000336:                                                                                          	#               (B)     THE TIME BETWEEN CSI IGNITION AND CDH IGNITION WAS
029364,000337:                                                                                          	#                       COMPUTED TO BE GREATER THAN 10 MINUTES.
029365,000338: 
029366,000339:                                                                                          	#               (C)     THE TIME BETWEEN CDH IGNITION AND TPI IGNITION WAS
029367,000340:                                                                                          	#                       COMPUTED TO BE GREATER THAN 10 MINUTES.
029368,000341: 
029369,000342:                                                                                          	#               (D)     THE VARIATION OF THE ALTITUDE DIFFERENCE BETWEEN THE
029370,000343:                                                                                          	#                       ORBITS WAS MINMIZED.
029371,000344: 
029372,000345:                                                                                          	#               (E)     CSI BURN WAS DEFINED SUCH THAT THE IMPULSIVE DELTA V WAS
029373,000346:                                                                                          	#                       IN THE HORIZONTAL PLANE DEFINED BY ACTIVE VEHICLE
029374,000347:                                                                                          	#                       POSITION AT CSI IGNITION.
029375,000348: 
029376,000349:                                                                                          	#               (F)     THE PERICENTER ALTITUDES OF THE ORBITS FOLLOWING CSI AND
029377,000350:                                                                                          	#                       CDH WERE COMPUTED TO BE GREATER THAN 35,000 FT FOR LUNAR
029378,000351:                                                                                          	#                       ORBIT OR 85 NM FOR EARTH ORBIT.
029379,000352: 
029380,000353:                                                                                          	#               (G)     THE CSI AND CDH MANEUVERS WERE ASSUMED TO BE PARALLEL TO
029381,000354:                                                                                          	#                       THE PLANE OF THE PASSIVE VEHICLE ORBIT.  HOWEVER, CREW
029383,000356:                                                                                          	#                       MODIFICATION OF DELTA V (LV) COMPONENTS MAY HAVE RESULTED
029384,000357:                                                                                          	#                       IN AN OUT-OF-PLANE MANEUVER.
029385,000358: 
029386,000359:                                                                                          	#       (2)     STATE VECTOR UPDATES BY P27 ARE DISALLOWED DURING AUTOMATIC
029387,000360:                                                                                          	#               STATE VECTOR UPDATING INITIATED BY P20 (SEE ASSUMPTION 4).
029388,000361: 
029389,000362:                                                                                          	#       (3)     COMPUTED VARIABLES MAY BE STORED FOR LATER VERIFICATION BY
029390,000363:                                                                                          	#               THE GROUND.  THESE STORAGE CAPABILITES ARE NORMALLY LIMITED
029391,000364:                                                                                          	#               ONLY TO THE PARAMETERS FOR ONE THRUSTING MANEUVER AT A TIME
029392,000365:                                                                                          	#               EXCEPT FOR CONCENTRIC FLIGHT PLAN MANEUVER SEQUENCES.
029393,000366: 
029394,000367:                                                                                          	#       (4)     THE RENDEZVOUS RADAR MAY OR MAY NOT BE USED TO UPDATE THE LM
029395,000368:                                                                                          	#               OR CSM STATE VECTORS FOR THIS PROGRAM.  IF RADAR USE IS
029396,000369:                                                                                          	#               DESIRED THE RADAR WAS TURNED ON AND LOCKED ON THE CSM BY
029397,000370:                                                                                          	#               PREVIOUS SELECTION OF P20.  RADAR SIGHTING MARKS WILL BE MADE
029398,000371:                                                                                          	#               AUTOMATICALLY APPROXIMATELY ONCE A MINUTE WHEN ENABLED BY THE
029399,000372:                                                                                          	#               TRACK AND UPDATE FLAGS (SEE P20).  THE RENDEZVOUS TRACKING
029400,000373:                                                                                          	#               MARK COUNTER IS ZEROED BY THE SELECTION OF P20 AND AFTER EACH
029401,000374:                                                                                          	#               THRUSTING MANEUVER.
029402,000375: 
029403,000376:                                                                                          	#       (5)     THE ISS NEED NOT BE ON TO COMPLETE THIS PROGRAM.
029404,000377: 
029405,000378:                                                                                          	#       (6)     THE OPERATION OF THE PROGRAM UTILIZES THE FOLLOWING FLAGS -
029406,000379: 
029407,000380:                                                                                          	#                       ACTIVE VEGICLE FLAG - DESIGNATES THE VEHICLE WHICH IS
029408,000381:                                                                                          	#                       DOING RENDEZVOUS THRUSTING MANEUVERS TO THE PROGRAM WHICH
029409,000382:                                                                                          	#                       CALCULATES THE MANEUVER PARAMETERS.  SET AT THE START OF
029410,000383:                                                                                          	#                       EACH RENDEZVOUS PRE-THRUSTING PROGRAM.
029411,000384: 
029412,000385:                                                                                          	#                       FINAL FLAG - SELECTS FINAL PROGRAM DISPLAYS AFTER CREW HAS
029413,000386:                                                                                          	#                       COMPLETED THE FINAL MANEUVER COMPUTATION AND DISPLAY
029414,000387:                                                                                          	#                       CYCLE.
029415,000388: 
029416,000389:                                                                                          	#                       EXTERNAL DELTA V STEERING FLAG - DESIGNATES THE TYPE OF
029417,000390:                                                                                          	#                       STEERING REQUIRED FOR EXECUTION OF THIS MANEUVER BY THE
029418,000391:                                                                                          	#                       THRUSTING PROGRAM SELECTED AFTER COMPLETION OF THIS
029419,000392:                                                                                          	#                       PROGRAM.
029420,000393: 
029421,000394:                                                                                          	#       (7)     IT IS NORMALLY REQUIRED THAT THE ISS BE ON FOR 1 HOUR PRIOR TO
029422,000395:                                                                                          	#               A THRUSTING MANEUVER.
029423,000396: 
029424,000397:                                                                                          	#       (8)     THIS PROGRAM IS SELECTED BY THE ASTRONAUT BY DSKY ENTRY -
029425,000398: 
029426,000399:                                                                                          	#                       P33 IF THIS VEHICLE IS ACTIVE VEHICLE.
029427,000400: 
029428,000401:                                                                                          	#                       P73 IF THIS VEHICLE IS PASSIVE VEHICLE.
029429,000402: 
029430,000403:                                                                                          	# INPUT
029431,000404: 
029432,000405:                                                                                          	#       (1)     TTPI0   TIME OF THE TPI MANEUVER - SAVED FROM P32/P72
029434,000407:                                                                                          	#       (2)     ELEV    DESIRED LOS ANGLE AT TPI - SAVED FROM P32/P72
029435,000408:                                                                                          	#       (3)     TCDH    TIME OF THE CDH MANEUVER
029436,000409: 
029437,000410:                                                                                          	# OUTPUT
029438,000411: 
029439,000412:                                                                                          	#       (1)     TRKMKCNT        NUMBER OF MARKS
029440,000413:                                                                                          	#       (2)     TTOGO           TIME TO GO
029441,000414:                                                                                          	#       (3)     +MGA            MIDDLE GIMBAL ANGLE
029442,000415:                                                                                          	#       (4)     DIFFALT         DELTA ALTITUDE AT CDH
029443,000416:                                                                                          	#       (5)     T2TOT3          DELTA TIME FROM CDH TO COMPUTED TPI
029444,000417:                                                                                          	#       (6)     NOMTPI          DELTA TIME FROM NOMINAL TPI TO COMPUTED TPI
029445,000418:                                                                                          	#       (7)     DELVLVC         DELTA VELOCITY AT CDH - LOCAL VERTICAL COORDINATES
029446,000419: 
029447,000420:                                                                                          	# DOWNLINK
029448,000421: 
029449,000422:                                                                                          	#       (1)     TCDH            TIME OF THE CDH MANEUVER
029450,000423:                                                                                          	#       (2)     TTPI            TIME OF THE TPI MANEUVER
029451,000424:                                                                                          	#       (3)     TIG             TIME OF THE CDH MANEUVER
029452,000425:                                                                                          	#       (4)     DELVEET2        DELTA VELOCITY AT CDH - REFERENCE COORDINATES
029453,000426:                                                                                          	#       (5)     DIFFALT         DELTA ALTITUDE AT CDH
029454,000427:                                                                                          	#       (6)     ELEV            DESIRED LOS ANGLE AT TPI
029455,000428: 
029456,000429:                                                                                          	# COMMUNICATION TO THRUSTING PROGRAMS
029457,000430: 
029458,000431:                                                                                          	#       (1)     TIG             TIME OF THE CDH MANEUVER
029459,000432:                                                                                          	#       (2)     RTIG            POSITION OF ACTIVE VEHICLE AT CDH - BEFORE ROTATION
029460,000433:                                                                                          	#                               INTO PLANE OF PASSIVE VEHICLE
029461,000434:                                                                                          	#       (3)     VTIG            VELOCITY OF ACTIVE VEHICLE AT CDH - BEFORE ROTATION
029462,000435:                                                                                          	#                               INTO PLANE OF PASSIVE VEHICLE
029463,000436:                                                                                          	#       (4)     DELVSIN         DELTA VELOCITY AT CDH - REFERENCE COORDINATES
029464,000437:                                                                                          	#       (5)     DELVSAB         MAGNITUDE OF DELTA VELOCITY AT CDH
029465,000438:                                                                                          	#       (6)     XDELVFLG        SET TO INDICATE EXTERNAL DELTA V VG COMPUTATION
029466,000439: 
029467,000440:                                                                                          	# SUBROUTINES USED
029468,000441: 

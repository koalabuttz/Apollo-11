035848,000528:                                                                                          	# SUBROUTINE NAME:      S61.1   
035849,000529:                                                                                          	# MOD NO:       0                                       DATE:           21 FEB 67
035850,000530:                                                                                          	# MOD BY:       RR BAIRNSFATHER                         LOG SECTION:    P61-P67
035851,000531:                                                                                          	# MOD NO:       1       MOD BY: RR BAIRNSFATHER         DATE:           22 JUN 67       RESTARTS.
035852,000532: 
035853,000533:                                                                                          	# FUNCTIONAL DESCRIPTION:       CALLED BY BOTH P61 AND P62
035854,000534:                                                                                          	#       FIRST, TEST TO SEE IF  AVERAGEG  IS ON.  IF NOT, UPDATE THE STATE VECTOR TO PRESENT TIME + TOLERANCE
035855,000535:                                                                                          	#       AND TURN ON  AVERAGEG  AT THAT TIME, AND CONTINUE.  OTHERWISE CONTINUE:  SEE IF IMU Y AXIS IS
035856,000536:                                                                                          	#       WITHIN 30 DEG OF V*R.  IF YES, EXIT SUBROUTINE S61.1.  IF NO, SEE IF -Y AXIS OF IMU IS WITHIN
035857,000537:                                                                                          	#       30 DEG OF V*R.  IF YES, DISPLAY ALARM:  01427   IMU REVERSED.
035858,000538:                                                                                          	#                       IF NO, DISPLAY ALARM:   01426   IMU UNSATISFACTORY.
035859,000539:                                                                                          	#       IN EITHER OF THESE LAST 2 CASES, WAIT 10 SEC AND THEN EXIT SUBROUTINE S61.1.
035860,000540: 
035861,000541:                                                                                          	# REMARK:       THERE WILL BE A SHORT 10 SEC DELAY IF AN ALARM EXIT IS TAKEN.  THE DELAY FOR INTEGRATION IS
035862,000542:                                                                                          	#               AS SHORT AS CAN BE MADE, BUT IS ARBITRARY SINCE IT DEPENDS ON THE AGE OF THE STATE VECTOR.
035863,000543: 
035864,000544:                                                                                          	# CALLING SEQUENCE:     CALL
035865,000545:                                                                                          	#                               S61.1
035866,000546: 
035867,000547:                                                                                          	#                       C(MPAC) UNSPECIFIED
035868,000548:                                                                                          	#                       PUSHLOC UNSPECIFIED
035869,000549: 
035870,000550:                                                                                          	# SUBROUTINES CALLED:   LOADTIME, CSMPREC, TPAGREE,
035871,000551:                                                                                          	#                       WAITLIST, JOBSLEEP, JOBWAKE, PREREAD, ALARM, GODSPR, BANKCALL, DELAYJOB
035872,000552: 
035873,000553:                                                                                          	# NORMAL EXIT MODES:    RVQ
035874,000554: 
035875,000555:                                                                                          	# ALARMS:       01426   IMU UNSATISFACTORY
035876,000556:                                                                                          	#               01427   IMU REVERSED
035877,000557: 
035878,000558:                                                                                          	# OUTPUT:       POSSIBLE ALARMS
035879,000559:                                                                                          	#               POSSIBLY TDEC1, RATT, VATT, RN, VN
035880,000560: 
035881,000561:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:
035882,000562:                                                                                          	#       AVEGFLAG                AVERAGEG ON OR OFF                              LEFT BY SERVICER
035883,000563:                                                                                          	#       PIPTIME   (-28) CS      TIME OF PIPA UPDATE                             LEFT BY READACCS
035884,000564:                                                                                          	#       RN        (-29) M       STATE VECTOR                                    LEFT BY AVERAGEG
035885,000565:                                                                                          	#       VN        (-7) M/CS     STATE VECTOR                                    LEFT BY AVERAGEG
035886,000566:                                                                                          	#       REFSMMAT  (-1)          .5 REF TO SM MATRIX                             LEFT BY LAST IMU ALIGNMENT
035887,000567: 
035888,000568:                                                                                          	# DEBRIS:       QPRET
035889,000569:                                                                                          	#               POSSIBLY PIPTIME1, RATT, VATT, TDEC1, RN1, VN1, QTEMP, X1       IF UPDATED
035890,000570:                                                                                          	#               PUSH LIST LOCS USED BY CSMPREC
035891,000571: 
035892,000572: 26,2544  E6,1661                                  EBANK=   AOG                           	# FOR 60GENRET, S61DT
035893,000573: 26,2544                                           BANK     26                            	#
035894,000574: 26,2000                                           SETLOC   P60S3                         	#
035895,000575: 26,2000                                           BANK                                   	#
035896,000576: 
035897,000577: 26,2544                                           COUNT*   $$/S61.1                      	#
035898,000578: 
035899,000579: 26,2544           00006        S61.1              EXTEND                                 	#
035900,000580: 26,2545           23773                           QXCH     60GENRET                      	# SAVE RET ADDR IN EB 6
035901,000581: 26,2546           04662                           TC       BANKCALL                      	#
035902,000582: 26,2547           17653                           CADR     R02BOTH                       	#
035903,000583: 26,2550           06006                           TC       INTPRET                       	#
035905,000585: 26,2551           45014                           BON      CALRB                         	#
035906,000586: 26,2552           00716                                    AVEGFLAG                      	# IS AVERAGEG ON
035907,000587: 26,2553           54604                                    S61.1A                        	# YES
035908,000588: 26,2554           27543                                    MIDTOAV2                      	# GET FUTURE STATE VECTOR SOON AS CAN
035909,000589: 
035910,000590: 26,2555           30155                           CA       MPAC       +1                 	# RETURN INHINTED ***
035911,000591: 26,2556           55774                           TS       S61DT                         	# FOR RESTART.

050147,000894:                                                                                          	# Page 1136
050148,000895:                                                                                          	# ARITHMETIC SUBROUTINES REQUIRED IN FIXED-FIXED.
050149,000896:                                                                                          	#       1.  DMPSUB      DOUBLE PRECISION MULTIPLY, MULTIPLY THE CONTENTS OF MPAC,+1 BY THE DP WORD WHOSE ADDRESS
050150,000897:                                                                                          	#                       IS IN ADDRWD AND LEAVE A TRIPLE-PRECISION RESULT IN MPAC.
050151,000898:                                                                                          	#       2.  ROUNDSUB    ROUND THE TRIPLE PRECISION CONTENTS OF MPAC TO DOUBLE PRECISION.
050152,000899:                                                                                          	#       3.  DOTSUB      TAKE THE DOT PRODUCT OF THE VECTOR IN MPAC AND THE VECTOR WHOSE ADDRESS IS IN ADDRWD
050153,000900:                                                                                          	#                       AND LEAVE THE TRIPLE PRECISION RESULT IN MPAC.
050154,000901:                                                                                          	#       4.  POLY        USING THE CONTENTS OF MPAC AS A DP ARGUMENT, EVALUATE THE POLYNOMIAL WHOSE DEGREE AND
050155,000902:                                                                                          	#                       COEFFICIENTS IMMEDIATELY FOLLOW THE TC POLY INSTRUCTION (SEE ROUTINE FOR DETAILS).
050156,000903: 
050157,000904:    7052           50002        DMP                INDEX    Q                             	# BASIC SUBROUTINE FOR USE BY PINBALL, ETC
050158,000905:                                                                                          	# Was CAF --- RSB 2009.
050159,000906:    7053           30000                           CA       0                             	#
050160,000907:    7054           24002                           INCR     Q                             	#
050161,000908:    7055           54116                 -1        TS       ADDRWD                        	# (PROLOGUE FOR SETTING ADDRWD.)
050162,000909: 
050163,000910:    7056           50116        DMPSUB             INDEX    ADDRWD                        	# GET MINOR PART OF OPERAND AT C(ADDRWD).
050164,000911:    7057           30001                           CA       1                             	#
050165,000912:    7060           54156                           TS       MPAC       +2                 	# THIS WORKS FOR SQUARING MPAC AS WELL.
050166,000913:    7061           35021                           CAF      ZERO                          	# SET MPAC +1 TO ZERO SO WE CAN ACCUMULATE
050167,000914:    7062           56155                           XCH      MPAC       +1                 	# THE PARTIAL PRODUCTS WITH DAS
050168,000915:    7063           54135                           TS       MPTEMP                        	# INSTRUCTIONS.
050169,000916:    7064           00006                           EXTEND                                 	#
050170,000917:    7065           70156                           MP       MPAC       +2                 	# MINOR OF MPAC X MINOR OF C(ADDRWD).
050171,000918: 
050172,000919:    7066           56156                           XCH      MPAC       +2                 	# DISCARD MINOR PART OF ABOVE RESULT AND
050173,000920:    7067           00006                           EXTEND                                 	# FORM MAJOR OF MPAC X MINOR OF C(ADDRWD).
050174,000921:    7070           70154                           MP       MPAC                          	#
050175,000922:    7071           20156                           DAS      MPAC       +1                 	# GUARANTEED NO OVERFLOW.
050176,000923: 
050177,000924:    7072           50116                           INDEX    ADDRWD                        	# GET MAJOR PART OF ARGUMENT AT C(ADDRWD).
050178,000925:    7073           30000                           CA       0                             	#
050179,000926:    7074           56135                           XCH      MPTEMP                        	# SAVE AND BRING OUT MINOR OF MPAC.
050180,000927:    7075           00006        DMPSUB2            EXTEND                                 	#
050181,000928:    7076           70135                           MP       MPTEMP                        	# MAJOR OF C(ADDRWD) X MINOR OF MPAC.
050182,000929:    7077           20156                           DAS      MPAC       +1                 	# ACCUMULATE, SETTING A TO NET OVERFLOW.
050183,000930: 
050184,000931:    7100           56154                           XCH      MPAC                          	# SETTING MPAC TO 0 OR +-1.
050185,000932:    7101           00006                           EXTEND                                 	#
050186,000933:    7102           70135                           MP       MPTEMP                        	# MAJOR OF MPAC X MAJOR OF C(ADDRWD).
050187,000934:    7103           20155                           DAS      MPAC                          	# GUARANTEED NO OVERFLOW.
050188,000935:    7104           00002                           TC       Q                             	# 49 MCT = .573 MS. INCLUDING RETURN.
050189,000936: 
050190,000937:                                                                                          	# Page 1137
050191,000938:                                                                                          	# ROUND MPAC TO DOUBLE PRECISION, SETTING OVFIND ON THE RARE EVENT OF OVERFLOW.
050192,000939: 
050193,000940:    7105           35021        ROUNDSUB           CAF      ZERO                          	# SET MPAC +2 = 0 FOR SCALARS AND CHANGE
050194,000941:    7106           54163                 +1        TS       MODE                          	# MODE TO DP.
050195,000942: 
050196,000943:    7107           56156        VROUND             XCH      MPAC       +2                 	# BUT WE NEEDN'T TAKE THE TIME FOR VECTORS.
050197,000944:    7110           60000                           DOUBLE                                 	#
050198,000945:    7111           54001                           TS       L                             	#
050199,000946:    7112           00002                           TC       Q                             	#
050200,000947: 
050201,000948:    7113           60155                           AD       MPAC       +1                 	# ADD ROUDING BIT IF MPAC +2 WAS GREATER
050202,000949:    7114           54155                           TS       MPAC       +1                 	# THAN .5 IN MAGNITUDE.
050203,000950:    7115           00002                           TC       Q                             	#
050204,000951: 
050205,000952:    7116           60154                           AD       MPAC                          	# PROPAGATE INTERFLOW.
050206,000953:    7117           54154                           TS       MPAC                          	#
050207,000954:    7120           00002                           TC       Q                             	#
050208,000955: 
050209,000956:    7121           54121        SETOVF2            TS       OVFIND                        	# (RARE).
050210,000957:    7122           00002                           TC       Q                             	#
050211,000958: 
050212,000959:                                                                                          	# Page 1138
050213,000960:                                                                                          	# THE DOT PRODUCT SUBROUTINE USUALLY FORMS THE DOT PRODUCT OF THE VECTOR IN MPAC WITH A STANDARD SIX
050214,000961:                                                                                          	# REGISTER VECTOR WHOSE ADDRESS IS IN ADDRWD.  IN THIS CASE C(DOTINC) ARE SET TO 2. VXM, HOWEVER, SETS C(DOTINC) TO
050215,000962:                                                                                          	# 6 SO THAT DOTSUB DOTS MPAC WITH A COLUMN VECTOR OF THE MATRIX IN QUESTION IN THIS CASE.
050216,000963: 
050217,000964:    7123           35016        PREDOT             CAF      TWO                           	# PROLOGUE TO SET DOTINC TO 2.
050218,000965:    7124           54136                           TS       DOTINC                        	#
050219,000966: 
050220,000967:    7125           00006        DOTSUB             EXTEND                                 	#
050221,000968:    7126           22137                           QXCH     DOTRET                        	# SAVE RETURN
050222,000969:    7127           07056                           TC       DMPSUB                        	# DOT X COMPONENTS.
050223,000970:    7130           52160                           DXCH     MPAC       +3                 	# POSITION Y COMPONENT OF MPAC FOR
050224,000971:    7131           52155                           DXCH     MPAC                          	# MULTIPLICATION WHILE SAVING RESULT IN
050225,000972:    7132           52131                           DXCH     BUF                           	# THREE WORD BUFFER, BUF.
050226,000973:    7133           30156                           CA       MPAC       +2                 	#
050227,000974:    7134           54132                           TS       BUF        +2                 	#
050228,000975: 
050229,000976:    7135           30136                           CA       DOTINC                        	# ADVANCE ADDRWD TO Y COMPONENT OF
050230,000977:    7136           26116                           ADS      ADDRWD                        	# OTHER ARGUMENT.
050231,000978:    7137           07056                           TC       DMPSUB                        	#
050232,000979:    7140           52156                           DXCH     MPAC       +1                 	# ACCUMULATE PARTIAL PRODUCTS.
050233,000980:    7141           20132                           DAS      BUF        +1                 	#
050234,000981:    7142           60154                           AD       MPAC                          	#
050235,000982:    7143           60130                           AD       BUF                           	#
050236,000983:    7144           54130                           TS       BUF                           	#
050237,000984:    7145           17147                           TCF      +2                            	#
050238,000985:    7146           54121                           TS       OVFIND                        	# IF OVERFLOW OCCURS.
050239,000986: 
050240,000987:    7147           52162                           DXCH     MPAC       +5                 	# MULTIPLY Z COMPONENTS.
050241,000988:    7150           52155                           DXCH     MPAC                          	#
050242,000989:    7151           30136                           CA       DOTINC                        	#
050243,000990:    7152           26116                           ADS      ADDRWD                        	#
050244,000991:    7153           07056                           TC       DMPSUB                        	#
050245,000992:    7154           52132        ENDDOT             DXCH     BUF        +1                 	# LEAVE FINAL ACCUMULATION IN MPAC.
050246,000993:    7155           20156                           DAS      MPAC       +1                 	#
050247,000994:    7156           60154                           AD       MPAC                          	#
050248,000995:    7157           60130                           AD       BUF                           	#
050249,000996:    7160           54154                           TS       MPAC                          	#
050250,000997:    7161           00137                           TC       DOTRET                        	#
050251,000998: 
050252,000999:    7162           06766                           TC       OVERFLOW                      	# ON OVERFLOW HERE.
050253,001000:    7163           00137                           TC       DOTRET                        	#
050254,001001: 
050255,001002:                                                                                          	# Page 1139
050256,001003:                                                                                          	# DOUBLE PRECISION POLYNOMIAL EVALUATOR
050257,001004:                                                                                          	#                                 N        N-1
050258,001005:                                                                                          	#       THIS ROUTINE EVALUATES A X  + A   X    + ... + A  X + A  LEAVING THE DP RESULT IN MPAC ON EXIT.
050259,001006:                                                                                          	#                               N      N-1              1      0
050260,001007: 
050261,001008:                                                                                          	# THE ROUTINE HAS TWO ENTRIES
050262,001009: 
050263,001010:                                                                                          	#       1       ENTRY THRU POWRSERS.  THE COEFFICIENTS MAY BE EITHER IN FIXED OR ERASABLE E.  THE CALL IS BY
050264,001011:                                                                                          	#               TC POWRSERS, AND THE RETURN IS TO LOC(TC POWRSERS)+1.  THE ENTERING DATA MUST BE AS FOLLOWS:
050265,001012:                                                                                          	#                       A       SP      LOC-3           ADDRESS FOR REFERENCING COEF TABLE
050266,001013:                                                                                          	#                       L       SP      N-1             N IS THE DEGREE OF THE POWER SERIES
050267,001014:                                                                                          	#                       MPAC    DP      X               ARGUMENT
050268,001015:                                                                                          	#                       LOC-2N  DP      A(0)
050269,001016:                                                                                          	#                               ...
050270,001017:                                                                                          	#                       LOC     DP      A(N)
050271,001018: 
050272,001019:                                                                                          	#       2.      ENTRY THRU POLY.  THE CALL TO POLY AND THE ENTERING DATA MUST BE AS FOLLOWS
050273,001020:                                                                                          	#                       MPAC            DP              X               ARGUMENT
050274,001021:                                                                                          	#                       LOC             TC              POLY
050275,001022:                                                                                          	#                       LOC+1           DP              A(0)
050276,001023:                                                                                          	#                                       ...
050277,001024:                                                                                          	#                       LOC+2N+2        DP              A(N)            RETURN IS TO LOC+2N+4
050278,001025: 
050279,001026:    7164           00006        POWRSERS           EXTEND                                 	#
050280,001027:    7165           22141                           QXCH     POLYRET                       	# RETURN ADDRESS
050281,001028:    7166           54117                           TS       POLISH                        	# POWER SERIES ADDRESS
050282,001029:    7167           22140                           LXCH     POLYCNT                       	# N-1 TO COUNTER
050283,001030:    7170           17201                           TCF      POLYCOM                       	# SKIP SET UP BY POLY
050284,001031: 
050285,001032:    7171           50002        POLY               INDEX    Q                             	#
050286,001033:                                                                                          	# Was CAF --- RSB 2009.
050287,001034:    7172           30000                           CA       0                             	#
050288,001035:    7173           54140                           TS       POLYCNT                       	# N-1 TO COUNTER
050289,001036:    7174           60000                           DOUBLE                                 	#
050290,001037:    7175           60002                           AD       Q                             	#
050291,001038:    7176           54117                           TS       POLISH                        	# L(A(N))-3 TO POLISH
050292,001039:    7177           65022                           AD       FIVE                          	#
050293,001040:    7200           54141                           TS       POLYRET                       	# STORE RETURN ADDRESS
050294,001041: 
050295,001042:    7201           36242        POLYCOM            CAF      LVBUF                         	# INCOMING X WILL BE MOVED TO VBUF, SO
050296,001043:    7202           54116                           TS       ADDRWD                        	# SET ADDRWD SO DMPSUB WILL MPY BY VBUF.
050297,001044: 
050298,001045:    7203           00006                           EXTEND                                 	#
050299,001046:    7204           50117                           INDEX    POLISH                        	#
050300,001047:    7205           30004                           DCA      3                             	#
050301,001048: 
050302,001049:                                                                                          	# Page 1140
050303,001050:    7206           52155                           DXCH     MPAC                          	# LOAD A(N) INTO MPAC
050304,001051:    7207           52123                           DXCH     VBUF                          	# SAVING X IN VBUF
050305,001052:    7210           17214                           TCF      POLY2                         	#
050306,001053: 
050307,001054:    7211           54140        POLYLOOP           TS       POLYCNT                       	# SAVE DECREMENTED LOOP COUNTER
050308,001055:    7212           45016                           CS       TWO                           	#
050309,001056:    7213           26117                           ADS      POLISH                        	# REGRESS COEFFICIENT POINTER
050310,001057: 
050311,001058:    7214           07056        POLY2              TC       DMPSUB                        	# MULTIPLY BY X
050312,001059:    7215           00006                           EXTEND                                 	#
050313,001060:    7216           50117                           INDEX    POLISH                        	#
050314,001061:    7217           30002                           DCA      1                             	# ADD IN NEXT COEFFICIENT
050315,001062:    7220           20155                           DAS      MPAC                          	# USER'S RESPONSIBILITY TO ASSURE NO OVFLOW
050316,001063: 
050317,001064:    7221           10140                           CCS      POLYCNT                       	#
050318,001065:    7222           17211                           TCF      POLYLOOP                      	#
050319,001066:    7223           00141                           TC       POLYRET                       	# RETURN CALLER
050320,001067: 
050321,001068:                                                                                          	# Page 1141
050322,001069:                                                                                          	# MISCELLANEOUS MULTI-PRECISION ROUTINES REQUIRED IN FIXED-FIXED BUT NOT USED BY THE INTERPRETER.
050323,001070: 
050324,001071:    7224           35021        DPAGREE            CAF      ZERO                          	# DOUBLE PRECISION ENTRY --
050325,001072:    7225           54156                           TS       MPAC       +2                 	# ZERO LOW-ORDER WORD
050326,001073: 
050327,001074:    7226           22002        TPAGREE            LXCH     Q                             	# FORCE SIGN AGREEMENT AMONG THE TRIPLE
050328,001075:    7227           06672                           TC       BRANCH                        	# PRECISION CONTENTS OF MPAC.  RETURNING
050329,001076:    7230           17234                           TCF      ARG+                          	# WITH SIGNUM OF THE INPUT IN A.
050330,001077:    7231           17254                           TCF      ARGZERO                       	#
050331,001078: 
050332,001079:    7232           44777                           CS       POSMAX                        	# IF NEGATIVE.
050333,001080:    7233           17235                           TCF      +2                            	#
050334,001081: 
050335,001082:    7234           34777        ARG+               CAF      POSMAX                        	#
050336,001083:    7235           54002                           TS       Q                             	#
050337,001084:    7236           00006                           EXTEND                                 	#
050338,001085:    7237           24000                           AUG      A                             	# FORMS +-1.0.
050339,001086:    7240           60156                           AD       MPAC       +2                 	#
050340,001087:    7241           54156                           TS       MPAC       +2                 	#
050341,001088:    7242           35021                           CAF      ZERO                          	#
050342,001089:    7243           60002                           AD       Q                             	#
050343,001090:    7244           60155                           AD       MPAC       +1                 	#
050344,001091:    7245           54155                           TS       MPAC       +1                 	#
050345,001092:    7246           35021                           CAF      ZERO                          	#
050346,001093:    7247           60002                           AD       Q                             	# Q STILL HAS POSMAX OR NEGMAX IN IT.
050347,001094:    7250           60154                           AD       MPAC                          	#
050348,001095:    7251           54154        ARGZERO2           TS       MPAC                          	# ALWAYS SKIPPING UNLESS ARGZERO.
050349,001096:    7252           54155                           TS       MPAC       +1                 	#
050350,001097:    7253           00001                           TC       L                             	# RETURN VIA L.
050351,001098: 
050352,001099:    7254           54156        ARGZERO            TS       MPAC       +2                 	# SET ALL THREE MPAC REGISTERS TO ZERO.
050353,001100:    7255           17251                           TCF      ARGZERO2                      	#
050354,001101: 
050355,001102:                                                                                          	# SHORTMP MULTIPLIES THE TP CONTENTS OF MPAC BY THE SINGLE PRECISION NUMBER ARRIVING IN A.
050356,001103: 
050357,001104:    7256           54135        SHORTMP            TS       MPTEMP                        	#
050358,001105:    7257           00006                           EXTEND                                 	#
050359,001106:    7260           70156                           MP       MPAC       +2                 	#
050360,001107:    7261           54156                           TS       MPAC       +2                 	#
050361,001108:    7262           35021        SHORTMP2           CAF      ZERO                          	# SO SUBSEQUENT DAS WILL WORK.
050362,001109:    7263           56155                           XCH      MPAC       +1                 	#
050363,001110:    7264           17075                           TCF      DMPSUB2                       	#
050364,001111: 
050365,001112:                                                                                          	# Page 1142
050366,001113:                                                                                          	# DMPNSUB MULTIPLIES THE DP FRACTION ARRIVING IN MPAC BY THE SP
050367,001114:                                                                                          	# INTEGER ARRIVING IN A.  THE DP PRODUCT DEPARTS BOTH IN MPAC AND IN
050368,001115:                                                                                          	# A AND L.  NOTE THAT DMPNSUB NORMALLY INCREASES THE MAGNITUDE OF THE
050369,001116:                                                                                          	# CONTENTS OF MPAC.  THE CUSTOMER MUST INSURE THAT B(A) X B(MPAC,MPAC+1)
050370,001117:                                                                                          	# AND B(A) X B(MPAC) ARE LESS THAN 1 IN MAGNITUDE, WHERE B, AS IS OBVIOUS,
050371,001118:                                                                                          	# INDICATES THE ARRIVING CONTENTS.
050372,001119: 
050373,001120:    7265           54135        DMPNSUB            TS       DMPNTEMP                      	#
050374,001121:    7266           00006                           EXTEND                                 	#
050375,001122:    7267           70155                           MP       MPAC       +1                 	#
050376,001123:    7270           52155                           DXCH     MPAC                          	# LOW PRODUCT TO MPAC, HIGH FACTOR TO A
050377,001124:    7271           00006                           EXTEND                                 	#
050378,001125:    7272           70135                           MP       DMPNTEMP                      	#
050379,001126:    7273           30001                           CA       L                             	#
050380,001127:    7274           26154                           ADS      MPAC                          	# COMPLETING THE PRODUCT IN MPAC
050381,001128:    7275           00006                           EXTEND                                 	#
050382,001129:    7276           30155                           DCA      MPAC                          	# BRINGING THE PRODUCT INTO A AND L
050383,001130:    7277           00002                           TC       Q                             	#
050384,001131: 
050385,001132:                                                                                          	# Page 1143
050386,001133:                                                                                          	# MISCELLANEOUS VECTOR OPERATIONS.  INCLUDED HERE ARE THE FOLLOWING.
050387,001134:                                                                                          	#       1.      DOT     DP VECTOR DOT PRODUCT.
050388,001135:                                                                                          	#       2.      VXV     DP VECTOR CROSS PRODUCT.
050389,001136:                                                                                          	#       3.      VXSC    DP VECTOR TIMES SCALAR.
050390,001137:                                                                                          	#       4.      V/SC    DP VECTOR DIVIDED BY SCALAR.
050391,001138:                                                                                          	#       5.      VPROJ   DP VECTOR PROJECTION.  ( (MPAC.X)MPAC ).
050392,001139:                                                                                          	#       6.      VXM     DP VECTOR POST-MULTIPLIED BY MATRIX.
050393,001140:                                                                                          	#       7.      MXV     DP VECTOR PRE-MULTIPLIED BY MATRIX.
050394,001141: 
050395,001142:    7300           07123        DOT                TC       PREDOT                        	# DO THE DOT PRODUCT AND EXIT, CHANGING
050396,001143:    7301           35021        DMODE              CAF      ZERO                          	# THE MODE TO DP SCALAR.
050397,001144:    7302           16027                           TCF      NEWMODE                       	#
050398,001145: 
050399,001146:    7303           35016        MXV                CAF      TWO                           	# SET UP MATINC AND DOTINC FOR ROW
050400,001147:    7304           54140                           TS       MATINC                        	# VECTORS.
050401,001148:    7305           17311                           TCF      VXM/MXV                       	# GO TO COMMON PORTION.
050402,001149: 
050403,001150:    7306           44377        VXM                CS       TEN                           	# SET MATINC AND DOTINC TO REFER TO MATRIX
050404,001151:    7307           54140                           TS       MATINC                        	# AS THREE COLUMN VECTORS.
050405,001152:    7310           36211                           CAF      SIX                           	#
050406,001153: 
050407,001154:                                                                                          	# Page 1144
050408,001155:                                                                                          	# COMMON PORTION OF MXV AND VXM.
050409,001156: 
050410,001157:    7311           54136        VXM/MXV            TS       DOTINC                        	#
050411,001158: 
050412,001159:                                                                                          	# ITRACE (2) REFERS TO "VXM/MXV".
050413,001160: 
050414,001161:    7312           07501                           TC       MPACVBUF                      	# SAVE VECTOR IN MPAC FOR FURTHER USE.
050415,001162: 
050416,001163:    7313           07125                           TC       DOTSUB                        	# GO DOT TO GET X COMPONENT OF ANSWER.
050417,001164:    7314           00006                           EXTEND                                 	#
050418,001165:    7315           30123                           DCA      VBUF                          	# MOVE MPAC VECTOR BACK INTO MPAC, SAVING
050419,001166:    7316           52155                           DXCH     MPAC                          	# NEW X COMPONENT IN BUF2.
050420,001167:    7317           52134                           DXCH     BUF2                          	#
050421,001168:    7320           00006                           EXTEND                                 	#
050422,001169:    7321           30125                           DCA      VBUF       +2                 	#
050423,001170:    7322           52160                           DXCH     MPAC       +3                 	#
050424,001171:    7323           00006                           EXTEND                                 	#
050425,001172:    7324           30127                           DCA      VBUF       +4                 	#
050426,001173:    7325           52162                           DXCH     MPAC       +5                 	#
050427,001174:    7326           30140                           CA       MATINC                        	# INITIALIZE ADDRWD FOR NEXT DOT PRODUCT.
050428,001175:    7327           26116                           ADS      ADDRWD                        	# FORMS HAS ADDRESS OF NEXT COLUMN(ROW).
050429,001176: 
050430,001177:    7330           07125                           TC       DOTSUB                        	#
050431,001178:    7331           52123                           DXCH     VBUF                          	# MORE GIVEN VECTOR BACK TO MPAC, SAVING Y
050432,001179:    7332           52155                           DXCH     MPAC                          	# COMPONENT OF ANSWER IN VBUF +2.
050433,001180:    7333           52125                           DXCH     VBUF       +2                 	#
050434,001181:    7334           52160                           DXCH     MPAC       +3                 	#
050435,001182:    7335           52127                           DXCH     VBUF       +4                 	#
050436,001183:    7336           52162                           DXCH     MPAC       +5                 	#
050437,001184:    7337           30140                           CA       MATINC                        	# FORM ADDRESS OF LAST COLUMN OR ROW.
050438,001185:    7340           26116                           ADS      ADDRWD                        	#
050439,001186: 
050440,001187:    7341           07125                           TC       DOTSUB                        	#
050441,001188:    7342           52134                           DXCH     BUF2                          	# ANSWER NOW COMPLETE. PUT COMPONENTS INTO
050442,001189:    7343           52155                           DXCH     MPAC                          	# PROPER MPAC REGISTERS.
050443,001190:    7344           52162                           DXCH     MPAC       +5                 	#
050444,001191:    7345           52125                           DXCH     VBUF       +2                 	#
050445,001192:    7346           52160                           DXCH     MPAC       +3                 	#
050446,001193:    7347           16030                           TCF      DANZIG                        	# EXIT.
050447,001194: 
050448,001195:                                                                                          	# Page 1145
050449,001196:                                                                                          	# VXSC -- VECTOR TIMES SCALAR.
050450,001197: 
050451,001198:    7350           10163        VXSC               CCS      MODE                          	# TEST PRESENT MODE.

034672,001789:                                                                                          	# PROGRAM NAME - SR52.1                         DATE  DEC 20 66
034673,001790:                                                                                          	# MOD 1                                         LOG SEC  P51-P53
034674,001791:                                                                                          	# BY KEN VINCENT                                ASSEMBLY  SUNDISK REV 40
034675,001792: 
034676,001793:                                                                                          	# FUNCTION
034677,001794: 
034678,001795:                                                                                          	# TARG1 AND TARG2 FLAGS ARE LOOKED AT TO DETERMINE IF THE TARGET IS THE
034679,001796:                                                                                          	# LEM, STAR OR LANDMARK.  IN CASE OF LEM OR LMK, THE PRESENT TIME PLUS
034680,001797:                                                                                          	# 2 SECONDS IS SAVED IN AOPTIME (ALIAS STARAD, +1).  IF THE LEM IS 
034681,001798:                                                                                          	# THE TARGET THEN CONIC UPDATES      OF THE CSM AND LEM ARE MADE TO
034682,001799:                                                                                          	# THE TIME IN AOPTIME.  THE UNIT OF THE DIFFERENCE OF LEM AND CSM
034683,001800:                                                                                          	# POSITION VECTORS BECOMES THE REFERENCE SIGHTING VECTOR USED IN THE
034684,001801:                                                                                          	# COMMON PART OF THIS PROGRAM.
034685,001802: 
034686,001803:                                                                                          	# IN THE CASE OF LANDMARK, THE CSM IS UPDATED CONICALLY.  THE RADIUS
034687,001804:                                                                                          	# VECTOR FOR THE LANDMARK IS OBTAINED FROM LALOTORV.  BOTH OF THESE ARE
034688,001805:                                                                                          	# FOUND FOR THE TIME IN AOPTIME.  THE UNIT OF THE DIFFERENCE BETWEEN
034689,001806:                                                                                          	# THE LANDMARK AND CSM RADIUS VECTORS BECOMES THE REFERENCE SIGHTING
034690,001807:                                                                                          	# VECTOR FOR THE COMMON PART OF THIS ROUTINE.
034691,001808: 
034692,001809:                                                                                          	# IF A STAR IS THE TARGET, THE PROPER STAR IS OBTAINED FROM THE CATALOG
034693,001810:                                                                                          	# AND THIS VECTOR BECOMES THE REFERENCE SIGHTING VECTOR.
034694,001811: 
034695,001812:                                                                                          	# THE COMMON PART OF THIS PROGRAM TRANSFORMS THE REFERENCE SIGHTING
034696,001813:                                                                                          	# VECTOR INTO STABLE MEMBER COORDINATES.  IT READS THE IMU-CDUS AND USES
034697,001814:                                                                                          	# THIS DATA IN A CALL TO CALCSXA.  ON RETURN FROM CALCSXA A TEST IS
034698,001815:                                                                                          	# MADE TO SEE IF THE TRUNNION ANGLE IS GREATER THAN  90DEG OR 38DEG.
034699,001816:                                                                                          	# MADE TO SEE IF THE TRUNNION ANGLE IS GREATER THAN 90DEG. OR 50DEG.
034700,001817: 
034701,001818:                                                                                          	# CALLING SEQUENCE
034702,001819: 
034703,001820:                                                                                          	#       L+4     RETURN WHEN SHAFT OR TRUNION NOT WITHIN 5 DEG OF DESIRED
034704,001821:                                                                                          	#       L       TC      BANKCALL
034705,001822:                                                                                          	#       L+1     CADR    SR52.1
034706,001823:                                                                                          	#       L+2     ERROR RETURN    TRUNNION GREATER THAN 90 DEG
034707,001824:                                                                                          	#       L&3     ERROR RETURN    TRUNNION GREATER THAN 50 DEG
034708,001825:                                                                                          	#       L+4     NORMAL RETURN
034709,001826: 
034710,001827:                                                                                          	# OUTPUT
034711,001828: 
034712,001829:                                                                                          	#       SAC -SINGLE PREC, 2S COMP, SCALED AT HALF REVS - SHAFT ANGLE DESIRED
034713,001830:                                                                                          	#       PAC -SINGLE PREC, 2S COMP  SCALED AT EIGTH REVS - TRUNNION ANGLE DESIRED
034714,001831: 
034715,001832:                                                                                          	# INITIALIZATION
034716,001833: 
034717,001834:                                                                                          	#       IF TARG1FLG =1 THEN TARGET IS LEM - NO OTHER INPUT REQUIRED
034718,001835: 
034719,001836:                                                                                          	#       IF TARG1FLG =0 AND TARG2FLG =0 THE TARGET IS STAR, STARIND SHOULD
034720,001837:                                                                                          	#       0 OR 1 DENOTING BESTI OR BESTJ RESPECTIVELY AS STAR CODE.  STAR CODES
034721,001838:                                                                                          	#       ARE 6 TIMES STAR NUMBER.
034722,001839: 
034723,001840:                                                                                          	#       IF TARG1FLG =0 AND TARG2FLG =1 THEN TARGET IS LANDMARK.  SEE ROUTINE
034724,001841:                                                                                          	#       LALOTORV FOR INPUT REQUIREMENTS.  HERE FIXERAD=1 FOR CONSTANT EARTH
034725,001842:                                                                                          	#       RADIUS
034726,001843: 
034727,001844:                                                                                          	# DEBRIS
034728,001845: 
034729,001846:                                                                                          	#       WORK AREA
034730,001847:                                                                                          	#       STARAD - STAR+5 (STAR IS DESIRED LOS IN STABLE MEMBER COORDINATES)
034731,001848: 

023363,000387: 04,3240           36746                           STCALL   VVEC                          	# GET TRANSFER TIME BASED ON CENTANG OF
023364,000388: 04,3241           24744                                    TIMETHET                      	#       PASSIVE VEHICLE
023365,000389: 04,3242           77624                           CALL                                   	#
023366,000390: 04,3243           74000                                    S34/35.1                      	# GET UNIT NORMAL
023367,000391: 04,3244           52145                           DLOAD    GOTO                          	#
023368,000392: 04,3245           00037                                    T                             	#
023369,000393: 04,3246           02367                                    RTRN                          	#
023370,000394: 
023371,000395:                                                                                          	# .... INTRPVP ....

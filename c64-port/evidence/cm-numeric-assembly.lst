052127,002874: 
052128,002875: 01,2442           02466        TIX                TC       TAGSUB                        	# BRANCH AND DECREMENT ON INDEX.
052129,002876: 01,2443           50130                           INDEX    INDEXLOC                      	#
052130,002877: 01,2444           40050                           CS       S1                            	#
052131,002878: 01,2445           50130                           INDEX    INDEXLOC                      	#
052132,002879: 01,2446           60046                           AD       X1                            	#
052133,002880: 01,2447           00006                           EXTEND                                 	# NO OPERATION IF DECREMENTED INDEX IS
052134,002881: 01,2450           66030                           BZMF     DANZIG                        	# NEGATIVE OR ZERO.
052135,002882: 
052136,002883: 01,2451           50130        DOTIXBR            INDEX    INDEXLOC                      	#

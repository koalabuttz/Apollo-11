018244,000036:                                                                                          	# GENERATION OF STEERING COMMANDS FOR DIGITAL AUTOPILOT FREE FALL MANEUVERS
018245,000037: 
018246,000038:                                                                                          	# NEW COMMANDS WILL BE GENERATED EVERY ONE SECOND DURING THE MANEUVER
018247,000039: 
018248,000040: 15,2000                                           BANK     15                            	#
018249,000041: 
018250,000042: 22,2000                                           SETLOC   KALCMON1                      	#
018251,000043: 22,2000                                           BANK                                   	#
018252,000044: 
018253,000045: 22,3026  E6,1661                                  EBANK=   BCDU                          	#
018254,000046: 
018255,000047: 22,3026                                           COUNT    22/KALC                       	#
018256,000048: 
018257,000049: 22,3026           41332        NEWDELHI           CS       HOLDFLAG                      	# SEE IF MANEUVER HAS BEEN INTERRUPTED
018258,000050: 22,3027           00006                           EXTEND                                 	# BY ASTRONAUT
018259,000051: 22,3030           62726                           BZMF     NOGO       -2                 	# IF SO, TERMINATE KALCMANU
018260,000052: 22,3031           06006        NEWANGL            TC       INTPRET                       	#
018261,000053: 22,3032           75160                           AXC,1    AXC,2                         	#
018262,000054: 22,3033           03320                                    MIS                           	# COMPUTE THE NEW MATRIX FROM S/C TO
018263,000055: 22,3034           03425                                    DEL                           	# STABLE MEMBER AXES
018264,000056: 22,3035           77624                           CALL                                   	#
018265,000057: 22,3036           44304                                    MXM3                          	#
018266,000058: 22,3037           45575                           VLOAD    STADR                         	#
018267,000059: 22,3040           50442                           STOVL    MIS        +12D               	# CALCULATE NEW DESIRED CDU ANGLES
018268,000060: 22,3041           77626                           STADR                                  	#
018269,000061: 22,3042           50450                           STOVL    MIS        +6D                	#
018270,000062: 22,3043           77626                           STADR                                  	#
018271,000063: 22,3044           74456                           STORE    MIS                           	#
018272,000064: 22,3045           45160                           AXC,1    CALL                          	#
018273,000065: 22,3046           03320                                    MIS                           	#
018274,000066: 22,3047           44655                                    DCMTOCDU                      	# PICK UP THE NEW CDU ANGLES FROM MATRIX
018275,000067: 22,3050           77634                           RTB                                    	#
018276,000068: 22,3051           45552                                    V1STO2S                       	#
018277,000069: 22,3052           03267                           STORE    NCDU                          	# NEW CDU ANGLES
018278,000070: 22,3053           77414                           BONCLR   EXIT                          	#

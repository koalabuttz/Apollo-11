022383,000074: 13,2100           02073                           TC       -5                            	# STORE DATA AND REPEAT FLASHING
022384,000075: 13,2101           32221                           CAF      V06N84     +1                 	# FLASH VERB 06 NOUN 33, DISPLAY LAST TIG,
022385,000076: 13,2102           04662                           TC       BANKCALL                      	# AND WAIT FOR KEYBOARD ACTION.
022386,000077: 13,2103           20720                           CADR     GOFLASH                       	#

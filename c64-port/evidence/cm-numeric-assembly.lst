005790,000222: 06,2144           12154                           TCF      NODSPY                        	# NOUT=0 OR BAD RETURN FROM DSPOUTSB
005791,000223: 06,2145           45002                           CS       BIT14                         	# GOOD RETURN (WE DISPLAYED SOMETHING)

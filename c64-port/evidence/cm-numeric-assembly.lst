028794,000382:                                                                                          	# SUBROUTINE NAME:      DELRSPL         (CONTINUATION OF V 82 IN CSM IF P11 ACTI
028795,000383:                                                                                          	# TRANSFERRED COMPLETELY FROM SUNDISK, P30S REV 33.  9 SEPT 67.
028796,000384:                                                                                          	# MOD NO: 0     MOD BY: ZELDIN          DATE:
028797,000385:                                                                                          	# MOD NO: 1     MOD BY: RR BAIRNSFATHER DATE: 11 APR 67
028798,000386:                                                                                          	# MOD NO: 2     MOD BY: RR BAIRNSFATHER DATE: 12 MAY 67         ADD UR.RT CALC WHEN BELOW 300K FT
028799,000387:                                                                                          	# MOD NO: 2.1   MOD BY: RR BAIRNSFATHER DATE: 5 JULY 67         FIX ERROR IN MOD. 2.
028800,000388:                                                                                          	# MOD NO: 3     MOD BY: RR BAIRNSFATHER DATE: 12 JUL 67         CHANGE SIGN OF DISPLAYED ERROR.
028801,000389:                                                                                          	# MOD 4         MOD BY  S.ZELDIN        DATE  3 APRIL 68        CHANGE EQUATIONS FOR L/D=.18 WHICH REPLA
028802,000390: 
028803,000391:                                                                                          	# FUNCTION:     CALCULATE (FOR DISPLAY ON CALL) AN APPROXIMATE MEASURE OF IN-PLANE SPLASH DOWN
028804,000392:                                                                                          	#               ERROR.  IF THE FREE-FALL TRANSFER ANGLE TO 300K FT ABOVE PAD RADIUS IS POSITIVE:
028805,000393:                                                                                          	#               SPLASH ERROR= -RANGE TO TARGET + FREE-FALL TRANSFER ANGLE + ESTIMATED ENTRY ANGLE.
028806,000394:                                                                                          	#               THE TARGET LOCATION AT ESTIMATED TIME OF IMPACT IS USED.  IF THE FREE-FALL TRANSFER
028807,000395:                                                                                          	#               ANGLE IS NEGATIVE:  SPLASH ERROR= -RANGE TO TARGET
028808,000396:                                                                                          	#               THE PRESENT TARGET LOCATION IS USED.
028809,000397: 
028810,000398:                                                                                          	# CALLING SEQUENCE  CALLED AFTER SR30.1 IF IN CSM AND IF P11 OPERATING (UNDER CONTROL OF V82)
028811,000399: 
028812,000400:                                                                                          	# SUBROUTINES CALLED:  VGAMCALC, TFF/TRIG, LALOTORV.
028813,000401: 
028814,000402:                                                                                          	# EXIT          RETURN DIRECTLY TO V 82 PROG. AT SPLRET
028815,000403: 
028816,000404:                                                                                          	# ERASABLE INITIALIZATION   LEFT BY SR30.1 AND V82GON1
028817,000405: 
028818,000406:                                                                                          	# OUTPUT:       RSP-RREC RANGE IN REVOLUTIONS                   DSKY DISPLAY IN N. MI.
028819,000407: 
028820,000408:                                                                                          	# DEBRIS:       QPRET, PDL0 ... PDL7, PDL10
028821,000409: 
028822,000410:                                                                                          	# THETA(1)
028823,000411: 
028824,000412: 32,2017                                           BANK     32                            	#
028825,000413: 32,2000                                           SETLOC   DELRSPL1                      	#
028826,000414: 32,2000                                           BANK                                   	#
028827,000415: 32,2017                                           COUNT*   $$/P30                        	# PROGRAMS: P30 EXTERNAL DELTA V
028828,000416: 
028829,000417: 32,2017           00011        DELRSPL            STORE    8D                            	#
028830,000418: 32,2020           45244                           BPL      DSU                           	#
028831,000419: 32,2021           64067                                    CANTDO                        	# GONE PAST 300K FT ALT
028832,000420: 32,2022           16326                                    1BITDP                        	#
028833,000421: 32,2023           45000                           BOV      CALL                          	#
028834,000422: 32,2024           64067                                    CANTDO                        	# POSMAX INDICATES NO 300K FT SOLUTION.
028835,000423: 32,2025           55051                                    VGAMCALC                      	# +GAMMA(REV) IN PMAC,V300 MAG(B-7)=PDL 0
028836,000424: 32,2026           45006                           PUSH     CALL                          	#

013254,000032: 
013255,000033:                                                                                          	## This source code has been transcribed or otherwise adapted from digitized
013256,000034:                                                                                          	## images of a hardcopy from the MIT Museum.  The digitization was performed
013257,000035:                                                                                          	## by Paul Fjeld, and arranged for by Deborah Douglas of the Museum.  Many
013258,000036:                                                                                          	## thanks to both.  The images (with suitable reduction in storage size and
013259,000037:                                                                                          	## consequent reduction in image quality as well) are available online at
013260,000038:                                                                                          	## www.ibiblio.org/apollo.  If for some reason you find that the images are
013261,000039:                                                                                          	## illegible, contact me at info@sandroid.org about getting access to the 
013262,000040:                                                                                          	## (much) higher-quality images which Paul actually created.
013263,000041:                                                                                          	##
013264,000042:                                                                                          	## Notations on the hardcopy document read, in part:
013265,000043:                                                                                          	##
013266,000044:                                                                                          	##      Assemble revision 055 of AGC program Comanche by NASA
013267,000045:                                                                                          	##      2021113-051.  10:28 APR. 1, 1969  
013268,000046:                                                                                          	##
013269,000047:                                                                                          	##      This AGC program shall also be referred to as
013270,000048:                                                                                          	##                      Colossus 2A
013271,000049: 
013273,000051:                                                                                          	# PROGRAM NAME - KEYBOARD AND DISPLAY PROGRAM
013274,000052:                                                                                          	# MOD NO - 4      DATE - 27 APRIL 1967      ASSEMBLY - PINDISK REV 17
013275,000053:                                                                                          	# MOD BY - FILENE
013276,000054:                                                                                          	# LOG SECTION - PINBALL GAME  BUTTONS AND LIGHTS
013277,000055: 
013278,000056:                                                                                          	# FUNCTIONAL DESCRIPTION-
013279,000057: 
013280,000058:                                                                                          	#    THE KEYBOARD AND DISPLAY SYSTEM PROGRAM OPERATES UNDER EXECUTIVE
013281,000059:                                                                                          	# CONTROL AND PROCESSES INFORMATION EXCHANGED BETWEEN THE AGC AND THE
013282,000060:                                                                                          	# COMPUTER OPERATOR.  THE INPUTS TO THE PROGRAM ARE FROM THE KEYBOARD,
013283,000061:                                                                                          	# FROM INTERNAL PROGRAMS, AND FROM THE UPLINK.
013284,000062:                                                                                          	#    THE LANGUAGE OF COMMUNICATION WITH THE PROGRAM IS A PAIR OF WORDS
013285,000063:                                                                                          	# KNOWN AS VERB AND NOUN.  EACH OF THESE IS REPRESENTED BY A 2 CHARACTER
013286,000064:                                                                                          	# DECIMAL NUMBER.  THE VERB CODE INDICATES WHAT ACTION IS TO BE TAKEN, THE
013287,000065:                                                                                          	# NOUN CODE INDICATES TO WHAT THIS ACTION IS APPLIED.  NOUNS USUALLY
013288,000066:                                                                                          	# REFER TO A GROUP OF ERASABLE REGISTERS.
013289,000067: 
013290,000068:                                                                                          	# VERBS ARE GROUPED INTO DISPLAYS, LOADS, MONITORS (DISPLAYS THAT ARE
013291,000069:                                                                                          	# UPDATED ONCE PER SECOND), SPECIAL FUNCTIONS, AND EXTENDED VERBS(THESE
013292,000070:                                                                                          	# ARE OUTSIDE OF THE DOMAIN OF PINBALL AND CAN BE FOUND UNDER LOG SECTION
013293,000071:                                                                                          	# :EXTENDED VERBS:).
013294,000072:                                                                                          	# A LIST OF VERBS AND NOUNS IS GIVEN IN LOG SECTION :ASSEMBLY AND
013295,000073:                                                                                          	# OPERATION INFORMATION:.
013296,000074: 
013297,000075:                                                                                          	# CALLING SEQUENCES-
013298,000076: 
013299,000077:                                                                                          	# KEYBOARD:
013300,000078:                                                                                          	#    EACH DEPRESSION OF A MAIN (NAVIGATION) KEYBOARD BUTTON ACTIVATES
013301,000079:                                                                                          	# INTERRUPT KEYRUPT1 (KEYRUPT2) AND PLACES THE 5 BIT KEY CODE INTO
013302,000080:                                                                                          	# CHANNEL 15 (CHANNEL 16).  KEYRUPT1 (KEYRUPT2) PLACES THE KEY
013303,000081:                                                                                          	# CODE INTO MPAC, ENTERS AN EXECUTIVE REQUEST FOR THE KEYBOARD AND DISPLAY
013304,000082:                                                                                          	# PROGRAM (AT :CHARIN:), AND EXECUTES A RESUME.
013305,000083: 
013306,000084:                                                                                          	# UPLINK:
013307,000085:                                                                                          	#    EACH WORD RECEIVED BY THE UPLINK ACTIVATES INTERRUPT UPRUPT WHICH
013308,000086:                                                                                          	# PLACES THE 5 BIT KEY CODE INTO MPAC, ENTERS AN EXECUTIVE REQUEST FOR THE
013309,000087:                                                                                          	# KEYBOARD AND DISPLAY PROGRAM (AT:CHARIN:) AND EXECUTES A RESUME.
013310,000088: 
013311,000089:                                                                                          	# INTERNAL PROGRAMS:
013312,000090:                                                                                          	#    INTERNAL PROGRAMS CALL PINBALL AT :NVSUB: WITH THE DESIRED VERB/NOUN
013313,000091:                                                                                          	# CODE IN A (LOW 7 BITS FOR NOUN, NEXT 7 BITS FOR VERB).  DETAILS
013314,000092:                                                                                          	# DESCRIBED ON REMARKS CARDS JUST BEFORE :NVSUB: AND :NVSBWAIT: (SEE
013315,000093:                                                                                          	# SYMBOL TABLE FOR PAGE NUMBERS).
013316,000094: 
013317,000095:                                                                                          	# NORMAL EXIT MODES-
013318,000096: 
013319,000097:                                                                                          	#    IF PINBALL WAS CALLED BY EXTERNAL ACTION, THERE ARE FOUR EXITS:
013320,000098:                                                                                          	#          1) ALL BUT (2), (3), AND (4) EXIT DIRECTLY TO ENDOFJOB.
013322,000100:                                                                                          	#          2) EXTENDED VERBS GO TO THE EXTENDED VERB FAN AS PART OF THE
013323,000101:                                                                                          	#             PINBALL EXECUTIVE JOB WITH PRIORITY 30000.  IT IS THE
013324,000102:                                                                                          	#             RESPONSIBILITY OF THE EXTENDED VERB CALLED TO EVENTUALLY
013325,000103:                                                                                          	#             CHANGE PRIORITY (IF NECESSARY) AND DO AN ENDOFJOB.
013326,000104:                                                                                          	#             ALSO PINBALL IS A NOVAC JOB. EBANK SET FOR COMMON.
013327,000105:                                                                                          	#          3) VERB 37. CHANGE OF PROGRAM (MAJOR MODE) CALLS :V37: IN THE
013328,000106:                                                                                          	#             SERVICE ROUTINES AS PART OF THE PINBALL EXEC JOB WITH PRIO
013329,000107:                                                                                          	#             30000.  THE NEW PROGRAM CODE (MAJOR MODE) IS LEFT IN A.
013330,000108:                                                                                          	#          4) KEY RELEASE BUTTON CALLS :PINBRNCH: IN THE DISPLAY INTERFACE
013331,000109:                                                                                          	#             ROUTINES AS PART OF THE PINBALL EXEC JOB WITH PRIO 30000 IF
013332,000110:                                                                                          	#             THE KEY RELEASE LIGHT IS OFF AND :CADRSTOR: IS NOT +0.
013333,000111: 
013334,000112:                                                                                          	#    IF PINBALL WAS CALLED BY INTERNAL PROGRAMS, EXIT FROM PINBALL IS BACK
013335,000113:                                                                                          	# TO CALLING ROUTINE.  DETAILS DESCRIBED IN REMARKS CARDS JUST BEFORE
013336,000114:                                                                                          	# :NVSUB: AND :NVSBWAIT: (SEE SYMBOL TABLE FOR PAGE NUMBERS).
013337,000115: 
013338,000116: 
013339,000117:                                                                                          	# ALARM OR ABORT EXIT MODES-
013340,000118: 
013341,000119:                                                                                          	# EXTERNAL INITIATION:
013342,000120:                                                                                          	#    IF SOME IMPROPER SEQUENCE OF KEY CODES IS DETECTED, THE OPERATOR
013343,000121:                                                                                          	# ERROR LIGHT IS TURNED ON AND EXIT IS TO :ENDOFJOB:.
013344,000122: 
013345,000123:                                                                                          	# INTERNAL PROGRAM INITIATION:
013346,000124:                                                                                          	#    IF AN ILLEGAL V/N COMBINATION IS ATTEMPTED, AN ABORT IS CAUSED
013347,000125:                                                                                          	# (WITH OCTAL 01501).
013348,000126:                                                                                          	#    IF A SECOND ATTEMPT IS MADE TO GO TO SLEEP IN PINBALL, AN ABORT IS
013349,000127:                                                                                          	# CAUSED (WITH OCTAL 01206). THERE ARE TWO WAYS TO GO TO SLEEP IN PINBALL:
013350,000128:                                                                                          	#          1) ENDIDLE OR DATAWAIT.
013351,000129:                                                                                          	#          2) NVSBWAIT, PRENVBSY, OR NVSUBUSY.
013352,000130: 
013353,000131:                                                                                          	# CONDITIONS LEADING TO THE ABOVE ARE DESCRIBED IN FORTHCOMING MIT/IL
013354,000132:                                                                                          	# E-REPORT DESCRIBING KEYBOARD AND DISPLAY OPERATION FOR 278.
013355,000133: 
013356,000134: 
013357,000135:                                                                                          	# OUTPUT-
013358,000136: 
013359,000137:                                                                                          	#    INFORMATION TO BE SENT TO THE DISPLAY PANEL IS LEFT IN THE :DSPTAB:
013360,000138:                                                                                          	# BUFFERS REGISTERS (UNDER EXEC CONTROL).  :DSPOUT: (A PART OF T4RUPT)
013361,000139:                                                                                          	# HANDLES THE PLACING OF THE :DSPTAB: INFORMATION INTO OUTPUT CHANNEL 10
013362,000140:                                                                                          	# IN INTERRUPT.
013363,000141: 
013364,000142: 
013365,000143:                                                                                          	# ERASABLE INITIALIZATION-
013366,000144: 
013367,000145:                                                                                          	#    FRESH START AND RESTART INITIALIZE THE NECESSARY E REGISTERS FOR
013368,000146:                                                                                          	# PINBALL IN :STARTSUB:.   REGISTERS ARE:  DSPTAB BUFFER, CADRSTOR,
013369,000147:                                                                                          	# REQRET, CLPASS, DSPLOCK, MONSAVE, MONSAVE1, VERBREG, NOUNREG, DSPLIST,
013370,000148:                                                                                          	# DSPCOUNT, NOUT.
013371,000149: 
013373,000151:                                                                                          	# A COMPLETE LIST OF ALL THE ERASABLES (BOTH RESERVED AND TEMPORARIES) FOR
013374,000152:                                                                                          	# PINBALL IS GIVEN BELOW.
013375,000153: 
013376,000154: 
013377,000155:                                                                                          	# THE FOLLOWING ARE OF GENERAL INTEREST-
013378,000156: 
013379,000157:                                                                                          	#    REMARKS CARDS PRECEDE THE REFERENCED SYMBOL DEFINITION.  SEE SYMBOL
013380,000158:                                                                                          	# TABLE TO FIND APPROPRIATE PAGE NUMBERS.
013381,000159: 
013382,000160:                                                                                          	#    NVSUB   CALLING POINT FOR INTERNAL USE OF PINBALL.
013383,000161:                                                                                          	#              OF RELATED INTEREST   NVSBWAIT
013384,000162:                                                                                          	#                                    NVSUBUSY
013385,000163:                                                                                          	#                                    PRENVBSY
013386,000164: 
013387,000165:                                                                                          	#    ENDIDLE   ROUTINE FOR INTERNAL PROGRAMS WISHING TO TO SLEEP WHILE
013388,000166:                                                                                          	#              AWAITING OPERATORS RESPONSE.
013389,000167: 
013390,000168:                                                                                          	#    DSPMM   ROUTINE BY WHICH AN INTERNAL PROGRAM MAY DISPLAY A DECIMAL
013391,000169:                                                                                          	#            PROGRAM CODE (MAJOR MODE) IN THE PROGRAM (MAJOR MODE) LIGHTS.
013392,000170:                                                                                          	#            (DSPMM DOES NOT DISPLAY DIRECTLY BUT ENTERS EXEC REQUEST
013393,000171:                                                                                          	#            FOR DSPMMJB WITH PRIO 30000 AND RETURNS TO CALLER.)
013394,000172: 
013395,000173:                                                                                          	#    BLANKSUB   ROUTINE BY WHICH AN INTERNAL PROGRAM MAY BLANK ANY
013396,000174:                                                                                          	#               COMBINATION OF THE DISPLAY REGISTERS R1, R2, R3.
013397,000175: 
013398,000176:                                                                                          	#    JAMTERM   ROUTINES BY WHICH AN INTERNAL PROGRAM MAY PERFORM THE
013399,000177:                                                                                          	#    JAMPROC   TERMINATE (V 34) OR PROCEED (V 33) FUNCTION.
013400,000178: 
013401,000179:                                                                                          	#    MONITOR   VERBS FOR PERIODIC ( 1 PER SEC) DISPLAY.
013402,000180: 
013403,000181:                                                                                          	#    PLEASE PERFORM, PLEASE MARK SITUATIONS
013404,000182:                                                                                          	#                 REMARKS DESCRIBING HOW AN INTERNAL ROUTINE SHOULD HANDLE
013405,000183:                                                                                          	#                 THESE SITUATIONS CAN BE FOUND JUST BEFORE :NVSUB: (SEE
013406,000184:                                                                                          	#                 SYMBOL TABLE FOR PAGE NUMBER).
013407,000185: 
013408,000186:                                                                                          	#    THE NOUN TABLE FORMAT IS DESCRIBED ON A PAGE OF REMARKS CARDS JUST
013409,000187:                                                                                          	#    BEFORE :DSPABC: (SEE SYMBOL TABLE FOR PAGE NUMBER).
013410,000188: 
013411,000189:                                                                                          	#    THE NOUN TABLES THEMSELVES ARE FOUND IN LOG SECTION :PINBALL NOUN
013412,000190:                                                                                          	#    TABLES:.
013413,000191: 
013414,000192: 
013415,000193:                                                                                          	# FOR FURTHER DETAILS ABOUT OPERATION OF THE KEYBOARD AND DISPLAY SYSTEM
013416,000194:                                                                                          	# PROGRAM, SEE THE MISSION PLAN AND/OR MIT/IL E-2129
013417,000195:                                                                                          	# DESCRIBING KEYBOARD AND DISPLAY OPERATION FOR 278.
013418,000196: 
013419,000197: 
013420,000198:                                                                                          	# THE FOLLOWING QUOTATION IS PROVIDED THROUGH THE COURTESY OF THE AUTHORS.
013421,000199: 
013422,000200:                                                                                          	#       ::IT WILL BE PROVED TO THY FACE THAT THOU HAST MEN ABOUT THEE THAT
013424,000202:                                                                                          	# USUALLY TALK OF A NOUN AND A VERB. AND SUCH ABOMINABLE WORDS AS NO
013425,000203:                                                                                          	# CHRISTIAN EAR CAN ENDURE TO HEAR.::
013426,000204: 
013427,000205:                                                                                          	#                      HENRY 6, ACT 2, SCENE 4
013428,000206: 
013429,000207: 
013430,000208:                                                                                          	# THE FOLLOWING ASSIGNMENTS FOR PINBALL ARE MADE ELSEWHERE
013431,000209: 
013432,000210: 
013433,000211:                                                                                          	# RESERVED FOR PINBALL EXECUTIVE ACTION
013434,000212: 
013435,000213:                                                                                          	# DSPCOUNT ERASE                  DISPLAY POSITION INDICATOR
013436,000214:                                                                                          	# DECBRNCH ERASE                  +DEC, - DEC, OCT INDICATOR
013437,000215:                                                                                          	# VERBREG  ERASE                  VERB CODE
013438,000216:                                                                                          	# NOUNREG  ERASE                  NOUN CODE
013439,000217:                                                                                          	# XREG     ERASE                  R1 INPUT BUFFER
013440,000218:                                                                                          	# YREG     ERASE                  R2 INPUT BUFFER
013441,000219:                                                                                          	# ZREG     ERASE                  R3 INPUT BUFFER
013442,000220:                                                                                          	# XREGLP   ERASE                  LO PART OF XREG (FOR DEC CONV ONLY)
013443,000221:                                                                                          	# YREGLP   ERASE                  LO PART OF YREG (FOR DEC CONV ONLY)
013444,000222:                                                                                          	# HITEMOUT =      YREGLP          TEMP FOR DISPLAY OF HRS, MIN, SEC
013445,000223:                                                                                          	#                                          MUST = LOTEMOUT-1.
013446,000224:                                                                                          	# ZREGLP   ERASE                  LO PART OF ZREG (FOR DEC CONV ONLY)
013447,000225:                                                                                          	# LOTEMOUT =      ZREGLP          TEMP FOR DISPLAY OF HRS, MIN, SEC
013448,000226:                                                                                          	#                                          MUST = HITEMOUT+1.
013449,000227:                                                                                          	# MODREG   ERASE                  MODE CODE
013450,000228:                                                                                          	# DSPLOCK  ERASE                  KEYBOARD/SUBROUTINE CALL INTERLOCK
013451,000229:                                                                                          	# REQRET   ERASE                  RETURN REGISTER FOR LOAD
013452,000230:                                                                                          	# LOADSTAT ERASE                  STATUS INDICATOR FOR LOADTST
013453,000231:                                                                                          	# CLPASS   ERASE                  PASS INDICATOR CLEAR
013454,000232:                                                                                          	# NOUT     ERASE                  ACTIVITY COUNTER FOR DSPTAB
013455,000233:                                                                                          	# NOUNCADR ERASE                  MACHINE CADR FOR NOUN
013456,000234:                                                                                          	# MONSAVE  ERASE                  N/V CODE FOR MONITOR. (= MONSAVE1-1)
013457,000235:                                                                                          	# MONSAVE1 ERASE                  NOUNCADR FOR MONITOR(MATBS1) =MONSAVE +1
013458,000236:                                                                                          	# MONSAVE2 ERASE                  NVMONOPT OPTIONS
013459,000237:                                                                                          	# DSPTAB   ERASE         +13D     0-10,DISPLAY PANEL BUFFER.11-13,C RELAYS.
013460,000238:                                                                                          	# CADRSTOR ERASE                  ENDIDLE STORAGE
013461,000239:                                                                                          	# NVQTEM   ERASE                  NVSUB STORAGE FOR CALLING ADDRESS
013462,000240:                                                                                          	#                                 MUST = NVBNKTEM-1
013463,000241:                                                                                          	# NVBNKTEM ERASE                  NVSUB STORAGE FOR CALLING BANK
013464,000242:                                                                                          	#                                 MUST = NVQTEM+1
013465,000243:                                                                                          	# VERBSAVE ERASE                  NEEDED FOR RECYCLE
013466,000244:                                                                                          	# DSPLIST  ERASE                  WAITING REG FOR DSP SYST INTERNAL USE
013467,000245:                                                                                          	# EXTVBACT ERASE                  EXTENDED VERB ACTIVITY INTERLOCK
013468,000246:                                                                                          	# DSPTEM1  ERASE         +2       BUFFER STORAGE AREA 1 (MOSTLY FOR TIME)
013469,000247:                                                                                          	# DSPTEM2  ERASE         +2       BUFFER STORAGE AREA 2 (MOSTLY FOR DEG)
013470,000248:                                                                                          	# END OF ERASABLES RESERVED FOR PINBALL EXECUTIVE ACTION.
013471,000249: 
013472,000250: 
013473,000251:                                                                                          	# TEMPORARIES FOR PINBALL EXECUTIVE ACTION
013475,000253:                                                                                          	# DSEXIT   =      INTB15+         RETURN FOR DSPIN
013476,000254:                                                                                          	# EXITEM   =      INTB15+         RETURN FOR SCALE FACTOR ROUTINE SELECT
013477,000255:                                                                                          	# BLANKRET =      INTB15+         RETURN FOR 2BLANK
013478,000256: 
013479,000257:                                                                                          	# WRDRET   =      INTBIT15        RETURN FOR 5BLANK
013480,000258:                                                                                          	# WDRET    =      INTBIT15        RETURN FOR DSPWD
013481,000259:                                                                                          	# DECRET   =      INTBIT15        RETURN FOR PUTCOM(DEC LOAD)
013482,000260:                                                                                          	# 21/22REG =      INTBIT15        TEMP FOR CHARIN
013483,000261: 
013484,000262:                                                                                          	# UPDATRET =      POLISH          RETURN FOR UPDATNN, UPDATVB
013485,000263:                                                                                          	# CHAR     =      POLISH          TEMP FOR CHARIN
013486,000264:                                                                                          	# ERCNT    =      POLISH          COUNTER FOR ERROR LIGHT RESET
013487,000265:                                                                                          	# DECOUNT  =      POLISH          COUNTER FOR SCALING AND DISPLAY (DEC)
013488,000266: 
013489,000267:                                                                                          	# SGNON    =      VBUF            TEMP FOR +,- ON
013490,000268:                                                                                          	# NOUNTEM  =      VBUF            COUNTER FOR MIXNOUN FETCH
013491,000269:                                                                                          	# DISTEM   =      VBUF            COUNTER FOR OCTAL DISPLAY VERBS
013492,000270:                                                                                          	# DECTEM   =      VBUF            COUNTER FOR FETCH (DEC DISPLAY VERBS)
013493,000271: 
013494,000272:                                                                                          	# SGNOFF   =      VBUF    +1      TEMP FOR +,- ON
013495,000273:                                                                                          	# NVTEMP   =      VBUF    +1      TEMP FOR NVSUB
013496,000274:                                                                                          	# SFTEMP1  =      VBUF    +1      STORAGE FOR SF CONST HI PART(=SFTEMP2-1)
013497,000275:                                                                                          	# HITEMIN  =      VBUF    +1      TEMP FOR LOAD OF HRS, MIN, SEC
013498,000276:                                                                                          	#                                          MUST = LOTEMIN-1.
013499,000277:                                                                                          	# CODE     =      VBUF    +2      FOR DSPIN
013500,000278:                                                                                          	# SFTEMP2  =      VBUF    +2      STORAGE FOR SF CONST LO PART(=SFTEMP1+1)
013501,000279:                                                                                          	# LOTEMIN  =      VBUF    +2      TEMP FOR LOAD OF HRS, MIN, SEC
013502,000280:                                                                                          	#                                          MUST = HITEMIN+1.
013503,000281:                                                                                          	# MIXTEMP  =      VBUF    +3      FOR MIXNOUN DATA
013504,000282:                                                                                          	# SIGNRET  =      VBUF    +3      RETURN FOR +,- ON
013505,000283: 
013506,000284:                                                                                          	# ALSO MIXTEMP+1 = VBUF+4, MIXTEMP+2 = VBUF+5.
013507,000285: 
013508,000286:                                                                                          	# ENTRET   =      DOTINC          EXIT FROM ENTER
013509,000287: 
013510,000288:                                                                                          	# WDCNT    =      DOTRET          CHAR COUNTER FOR DSPWD
013511,000289:                                                                                          	# INREL    =      DOTRET          INPUT BUFFER SELECTOR ( X,Y,Z, REG )
013512,000290: 
013513,000291:                                                                                          	# DSPMMTEM =      MATINC          DSPCOUNT SAVE FOR DSPMM
013514,000292:                                                                                          	# MIXBR    =      MATINC          INDICATOR FOR MIXED OR NORMAL NOUN
013515,000293: 
013516,000294:                                                                                          	# TEM1     ERASE                  EXEC TEMP
013517,000295:                                                                                          	# DSREL    =      TEM1            REL ADDRESS FOR DSPIN
013518,000296: 
013519,000297:                                                                                          	# TEM2     ERASE                  EXEC TEMP
013520,000298:                                                                                          	# DSMAG    =      TEM2            MAGNITUDE STORE FOR DSPIN
013521,000299:                                                                                          	# IDADDTEM =      TEM2            MIXNOUN INDIRECT ADDRESS STORAGE
013522,000300: 
013523,000301:                                                                                          	# TEM3     ERASE                  EXEC TEMP
013524,000302:                                                                                          	# COUNT    =      TEM3            FOR DSPIN
013526,000304:                                                                                          	# TEM4     ERASE                  EXEC TEMP
013527,000305:                                                                                          	# LSTPTR   =      TEM4            LIST POINTER FOR GRABUSY
013528,000306:                                                                                          	# RELRET   =      TEM4            RETURN FOR RELDSP
013529,000307:                                                                                          	# FREERET  =      TEM4            RETURN FOR FREEDSP
013530,000308:                                                                                          	# DSPWDRET =      TEM4            RETURN FOR DSPSIGN
013531,000309:                                                                                          	# SEPSCRET =      TEM4            RETURN FOR SEPSEC
013532,000310:                                                                                          	# SEPMNRET =      TEM4            RETURN FOR SEPMIN
013533,000311: 
013534,000312:                                                                                          	# TEM5     ERASE                  EXEC TEMP
013535,000313:                                                                                          	# NOUNADD  =      TEM5            TEMP STORAGE FOR NOUN ADDRESS
013536,000314: 
013537,000315:                                                                                          	# NNADTEM  ERASE                  TEMP FOR NOUN ADDRESS TABLE ENTRY
013538,000316:                                                                                          	# NNTYPTEM ERASE                  TEMP FOR NOUN TYPE TABLE ENTRY
013539,000317:                                                                                          	# IDAD1TEM ERASE                  TEMP FOR INDIR ADRESS TABLE ENTRY(MIXNN)
013540,000318:                                                                                          	#                                 MUST = IDAD2TEM-1, = IDAD3TEM-2
013541,000319:                                                                                          	# IDAD2TEM ERASE                  TEMP FOR INDIR ADRESS TABLE ENTRY(MIXNN)
013542,000320:                                                                                          	#                                 MUST = IDAD1TEM+1, = IDAD3TEM-1.
013543,000321:                                                                                          	# IDAD3TEM ERASE                  TEMP FOR INDIR ADRESS TABLE ENTRY(MIXNN)
013544,000322:                                                                                          	#                                 MUST = IDAD1TEM+2, = IDAD2TEM+1.
013545,000323:                                                                                          	# RUTMXTEM ERASE                  TEMP FOR SF ROUT TABLE ENTRY(MIXNN ONLY)
013546,000324:                                                                                          	# END OF TEMPORARIES FOR PINBALL EXECUTIVE ACTION.
013547,000325: 
013548,000326: 
013549,000327:                                                                                          	# ADDITIONAL TEMPORARIES FOR PINBALL EXECUTIVE ACTION
013550,000328: 
013551,000329:                                                                                          	# MPAC, THRU MPAC +6
013552,000330:                                                                                          	# BUF, +1, +2
013553,000331:                                                                                          	# BUF2, +1, +2
013554,000332:                                                                                          	# MPTEMP
013555,000333:                                                                                          	# ADDRWD
013556,000334:                                                                                          	#   END OF ADDITIONAL TEMPS FOR PINBALL EXEC ACTION
013557,000335: 
013558,000336: 
013559,000337:                                                                                          	# RESERVED FOR PINBALL INTERRUPT ACTION
013560,000338: 
013561,000339:                                                                                          	# DSPCNT   ERASE                  COUNTER FOR DSPOUT
013562,000340:                                                                                          	# UPLOCK   ERASE                  BIT1 = UPLINK INTERLOCK (ACTIVATED BY
013563,000341:                                                                                          	#                                                                         RECEPTION OF A BAD MESSAGE IN UPLINK)
013564,000342:                                                                                          	# END OF ERASABLES RESERVED FOR PINBALL INTERRUPT ACTION
013565,000343: 
013566,000344: 
013567,000345:                                                                                          	# TEMPORARIES FOR PINBALL INTERRUPT ACTION
013568,000346: 
013569,000347:                                                                                          	# KEYTEMP1 =      WAITEXIT        TEMP FOR KEYRUPT, UPRUPT
013570,000348:                                                                                          	# DSRUPTEM =      WAITEXIT        TEMP FOR DSPOUT
013571,000349:                                                                                          	# KEYTEMP2 =      RUPTAGN         TEMP FOR KEYRUPT, UPRUPT
013572,000350:                                                                                          	# END OF TEMPORARIES FOR PINBALL INTERRUPT ACTION
013573,000351: 
013575,000353:                                                                                          	# THE INPUT CODES ASSUMED FOR THE KEYBOARD ARE,
013576,000354:                                                                                          	# 0        10000
013577,000355:                                                                                          	# 1        00001
013578,000356:                                                                                          	# 9        01001
013579,000357:                                                                                          	# VERB     10001
013580,000358:                                                                                          	# ERROR RES10010
013581,000359:                                                                                          	# KEY RLSE 11001
013582,000360:                                                                                          	# +        11010
013583,000361:                                                                                          	# -        11011
013584,000362:                                                                                          	# ENTER    11100
013585,000363:                                                                                          	# CLEAR    11110
013586,000364:                                                                                          	# NOUN     11111
013587,000365: 
013588,000366: 
013589,000367:                                                                                          	# OUTPUT FORMAT FOR DISPLAY PANEL.  SET OUT0 TO AAAABCCCCCDDDDD.
013590,000368:                                                                                          	# A-S SELECT A RELAYWORD. THIS DETERMINES WHICH PAIR OF CHARACTERS ARE
013591,000369:                                                                                          	# ENERGIZED.
013592,000370:                                                                                          	# B FOR SPECIAL RELAYS SUCH AS SIGNS ETC.
013593,000371:                                                                                          	# C-S  5 BIT RELAY CODE FOR LEFT CHAR OF PAIR SELECTED BY RELAYWORD.
013594,000372:                                                                                          	# D-S  5 BIT RELAY CODE FOR RIGHTCHAR OF PAIR SELECTED BY RELAYWORD.
013595,000373: 
013596,000374:                                                                                          	# THE PANEL APPEARS AS FOLLOWS,
013597,000375:                                                                                          	# MD1    MD2                         (MAJOR MODE)
013598,000376:                                                                                          	# VD1    VD2 (VERB)    ND1    ND2    (NOUN)
013599,000377:                                                                                          	# R1D1   R1D2   R1D3   R1D4   R1D5   (R1)
013600,000378:                                                                                          	# R2D1   R2D2   R2D3   R2D4   R2D5   (R2)
013601,000379:                                                                                          	# R3D1   R3D2   R3D3   R3D4   R3D5   (R3)
013602,000380: 
013603,000381:                                                                                          	# EACH OF THESE IS GIVEN A DSPCOUNT NUMBER FOR USE WITHIN COMPUTATION ONLY
013604,000382:                                                                                          	# MD1   25     R2D1  11         ALL ARE OCTAL
013605,000383:                                                                                          	# MD2   24     R2D2  10
013606,000384:                                                                                          	# VD1   23     R2D3   7
013607,000385:                                                                                          	# VD2   22     R2D4   6
013608,000386:                                                                                          	# ND1   21     R2D5   5
013609,000387:                                                                                          	# ND2   20     R3D1   4
013610,000388:                                                                                          	# R1D1  16     R3D2   3
013611,000389:                                                                                          	# R1D2  15     R3D3   2
013612,000390:                                                                                          	# R1D3  14     R3D4   1
013613,000391:                                                                                          	# R1D4  13     R3D5   0
013614,000392:                                                                                          	# R1D5  12
013615,000393: 
013616,000394: 
013617,000395:                                                                                          	# THERE IS AN 11 REGISTER TABLE (DSPTAB) FOR THE DISPLAY PANEL.
013618,000396: 
013619,000397:                                                                                          	# DSPTAB RELAYWD       BIT11     BITS 10-6     BITS 5-1
013620,000398:                                                                                          	# RELADD
013621,000399:                                                                                          	# 10     1011                    MD1  (25)     MD2  (24)
013622,000400:                                                                                          	# 9      1010                    VD1  (23)     VD2  (22)
013623,000401:                                                                                          	# 8      1001                    ND1  (21)     ND2  (20)
013624,000402:                                                                                          	# 7      1000                                  R1D1 (16)
013626,000404:                                                                                          	# 6      0111          +R1       R1D2 (15)     R1D3 (14)
013627,000405:                                                                                          	# 5      0110          -R1       R1D4 (13)     R1D5 (12)

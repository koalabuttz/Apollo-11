050003,000750:    6705           16710                           TCF      NEG                           	#
050004,000751: 
050005,000752:    6706           50002        Q+1                INDEX    Q                             	#
050006,000753:    6707           00001                           TC       1                             	#
050007,000754: 
050008,000755:    6710           50002        NEG                INDEX    Q                             	# IF FIRST NON-ZERO REGISTER WAS NEGATIVE.
050009,000756:    6711           00002                           TC       2                             	#
050010,000757: 
050011,000758:    6712     6710               Q+2                =        NEG                           	#
050012,000759: 
050013,000760:                                                                                          	# ITRACE (3) REFERS TO "EXIT".
050014,000761: 
050015,000762:    6712           30165        EXIT               CA       BANKSET                       	# RESTORE USER'S BANK SETTING, AND LEAVE
050016,000763:    6713           54006                           TS       BBANK                         	# INTERPRETIVE MODE.
050017,000764:    6714           50164                           INDEX    LOC                           	#

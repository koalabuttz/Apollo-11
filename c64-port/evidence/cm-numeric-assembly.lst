018280,000072: 22,3055           40065                                    MANUSTAT                      	# TO START MANEUVER
018281,000073: 22,3056           35016                           CAF      TWO                           	#          +0 OTHERWISE
018282,000074: 22,3057           55664        INCRDCDU           TS       KSPNDX                        	#
018283,000075: 22,3060           60000                           DOUBLE                                 	#
018284,000076: 22,3061           55665                           TS       KDPNDX                        	#
018285,000077: 22,3062           51664                           INDEX    KSPNDX                        	#
018286,000078: 22,3063           31666                           CA       NCDU                          	# NEW DESIRED CDU ANGLES
018287,000079: 22,3064           00006                           EXTEND                                 	#
018288,000080: 22,3065           51664                           INDEX    KSPNDX                        	#
018289,000081: 22,3066           21661                           MSU      BCDU                          	# INITIAL S/C ANGLE OR PREVIOUS DESIRED
018290,000082: 22,3067           00006                           EXTEND                                 	# CDU ANGLES
018291,000083: 22,3070           73002                           MP       QUADROT                       	#
018292,000084: 22,3071           51665                           INDEX    KDPNDX                        	#
018293,000085: 22,3072           53576                           DXCH     DELCDUX                       	# ANGLE INCREMENTS TO BE ADDED TO
018295,000087: 22,3073           51664                           INDEX    KSPNDX                        	# DCDU EVERY TENTH SEC
018296,000088: 22,3074           31666                           CA       NCDU                          	# BY LEM DAP
018297,000089: 22,3075           51664                           INDEX    KSPNDX                        	#
018298,000090: 22,3076           57661                           XCH      BCDU                          	#

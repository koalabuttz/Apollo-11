011012,000815:                                                                                          	# V82PERF       VERB82          DESCRIPTION
011013,000816:                                                                                          	#       REQUEST ORBIT PARAMETERS DISPLAY (R30)
011014,000817: 
011015,000818:                                                                                          	#       1.      IF AVERAGE G IS OFF:
011016,000819:                                                                                          	#                       FLASH DISPLAY V04N06.  R2 INDICATES WHICH SHIP'S STATE VECTOR IS
011017,000820:                                                                                          	#                        TO BE UPDATED.  INITIAL CHOICE IS THIS SHIP (R2=1).  ASTRONAUT
011018,000821:                                                                                          	#                        CAN CHANGE TO OTHER SHIP BY V22EXE, WHERE X NOT EQ 1.
011019,000822:                                                                                          	#                       SELECTED STATE VECTOR UPDATED BY THISPREC (OTHPREC).
011020,000823:                                                                                          	#                       CALLS SR30.1 (WHICH CALLS TFFCONMU + TFFRP/RA) TO CALCULATE
011022,000825:                                                                                          	#                        RPER (PERIGEE RADIUS), RAPO (APOGEE RADIUS), HPER (PERIGEE
011023,000826:                                                                                          	#                        HEIGHT ABOVE LAUNCH PAD OR LUNAR LANDING SITE), HAPO (APOGEE
011024,000827:                                                                                          	#                        HEIGHT AS ABOVE), TPER (TIME TO PERIGEE), TFF (TIME TO 
011025,000828:                                                                                          	#                        INTERSECT 300 KFT ABOVE PAD OR 35KFT ABOVE LANDING SITE).
011026,000829:                                                                                          	#                       FLASH MONITOR V16N44 (HAPO, HPER, TFF).  TFF IS -59M59S IF IT WAS
011027,000830:                                                                                          	#                        NOT COMPUTABLE, OTHERWISE IT INCREMENTS ONCE PER SECOND.
011028,000831:                                                                                          	#                        ASTRONAUT HAS OPTION TO MONITOR TPER BY KEYING IN N 32 E.
011029,000832:                                                                                          	#                        DISPLAY IS IN HMS, IS NEGATIVE (AS WAS TFF), AND INCREMENTS
011030,000833:                                                                                          	#                        ONCE PER SECOND ONLY IF TFF DISPLAY WAS -59M59S.
011031,000834: 
011032,000835:                                                                                          	#       2.      IF AVERAGE G IS ON:
011033,000836:                                                                                          	#                       CALLS SR30.1 APPROX EVERY TWO SECS.  STATE VECTOR IS ALWAYS
011034,000837:                                                                                          	#                        FOR THIS VEHICLE.  V82 DOES NOT DISTURB STATE VECTOR.  RESULTS
011035,000838:                                                                                          	#                        OF SR30.1 ARE RAPO, RPER, HAPO, HPER, TPER, TFF.
011036,000839:                                                                                          	#                       FLASH MONITOR V16N44 (HAPO, HPER, TFF).
011037,000840:                                                                                          	#                        IF MODE IS P11, THEN CALL DELRSPL SO ASTRONAUT CAN MONITOR
011038,000841:                                                                                          	#                        RESULTS BY N50E.  SPLASH COMPUTATION DONE ONCE PER TWO SECS.
011039,000842: 
011040,000843:                                                                                          	# ADDENDUM:     HAPO AND HPER SHOULD BE CHANGED TO READ HAPOX AND HPERX IN THE
011041,000844:                                                                                          	#               ABOVE REMARKS.
011042,000845: 
011043,000846: 43,2562           02076        V82PERF            TC       TESTXACT                      	#
011044,000847: 
011045,000848: 43,2563           35063                           CAF      PRIO7                         	#
011046,000849: 43,2564           05210                           TC       PRIOCHNG                      	#
011047,000850: 43,2565           04701                           TC       POSTJUMP                      	#
011048,000851: 43,2566           46332                           CADR     V82CALL                       	# ***** V82CALL MUST NOT BE A FINDVAC JOB.

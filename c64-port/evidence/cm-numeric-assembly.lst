004906,003271: E6,1541  E6,1674               KV2                EQUALS   TMIS       +6                 	# I(6)TMP
004907,003272: E6,1541  E6,1674               BIASTEMP           EQUALS   TMIS       +6                 	# B   TMP
004908,003273: E6,1541  E6,1702               KV3                EQUALS   TMIS       +12D               	# I(6)TMP
004909,003274: E6,1541  E6,1702               OGF                EQUALS   TMIS       +12D               	# I   TMP
004910,003275: 

061926,000301: 01,3745           54707                           TS       GOLOC      +2                 	# TABLE, OR A RETURN FOR THE NEXT GROUP
061927,000302: 
061928,000303: 01,3746           50155                           NDX      TEMP2G                        	# SET UP POINTER FOR OUR LOCATION WITHIN
061929,000304: 01,3747           32000                           CA       SIZETAB                       	# THE TABLE

034199,001316: 
034200,001317:                                                                                          	# NAME - P51 - IMU ORIENTATION DETERMINATION
034201,001318:                                                                                          	# MOD. NO. 2    21 DEC 66                               LOG SECTION - P51-P53
034203,001320:                                                                                          	# MOD BY STURLAUGSON                                    ASSEMBLY SUNDISK REV15
034204,001321: 
034205,001322:                                                                                          	# FUNCTIONAL DESCRIPTION
034206,001323:                                                                                          	#       DETERMINES THE INERTIAL ORIENTATION OF THE IMU.  THE PROGRAM IS SELECTED BY DSKY ENTRY.  THE SIGHTING
034207,001324:                                                                                          	#       ROUTINE IS CALLED TO COLLECT THE CDU COUNTERS AND SHAFT AND TRUNNION ANGLES FOR A SIGHTED STAR.  THE DATA IS
034208,001325:                                                                                          	#       THEN PROCESSED AS FOLLOWS.
034209,001326: 
034210,001327:                                                                                          	#       1.  SEXTANT ANGLES ARE COMPUTED IN TERMS OF NAVIGATIONAL BASE COORDINATES.  LET SA AND TA BE THE SHAFT AND
034211,001328:                                                                                          	#       TRUNNION ANGLES, RESPECTIVELY.  THEN,
034212,001329:                                                                                          	#       -
034213,001330:                                                                                          	#       V  = (SIN(TA)*COS(SA), SIN(TA)*SIN(SA), COS(TA))        (A COLUMN VECTOR)
034214,001331:                                                                                          	#        NB
034215,001332:                                                                                          	#       THE OUTPUT IS A HALF-UNIT VECTOR STORED IN STARM.
034216,001333: 
034217,001334:                                                                                          	#       2.  THIS VECTOR IN NAV. BASE COORDS. IS THEN TRANSFORMED TO ONE IN STABLE MEMBER COORDINATES.
034218,001335:                                                                                          	#       -    T  T  T -
034219,001336:                                                                                          	#       V = Q *Q *Q *V  ,       WHERE
034220,001337:                                                                                          	#            1  2  3  NB
034221,001338: 
034222,001339:                                                                                          	#            ( COS(IG)   0    -SIN(IG) )
034223,001340:                                                                                          	#            (                         )                                        THE GIMBAL ANGLES ARE COMPUTED FROM
034224,001341:                                                                                          	#       Q  = (   0       1       0     ), IG= INNER GIMBAL ANGLE                THE CDU COUNTERS AT NBSM (USING AXIS-
034225,001342:                                                                                          	#        1   (                         )                                        ROT AND CDULOGIC)
034226,001343:                                                                                          	#            ( SIN(IG)   0     COS(IG) )
034227,001344: 
034228,001345:                                                                                          	#            ( COS(MG) SIN(MG)   0     )
034229,001346:                                                                                          	#            (                         )
034230,001347:                                                                                          	#       Q  = (-SIN(MG) COS(MG)   0     ), MG= MIDDLE GIMBAL ANGLE
034231,001348:                                                                                          	#        2   (                         )
034232,001349:                                                                                          	#            (   0       0       1     )
034233,001350: 
034234,001351:                                                                                          	#            (   1       0       0     )
034235,001352:                                                                                          	#            (                         )
034236,001353:                                                                                          	#       Q  = (   0     COS(OG) SIN(OG) ), OG= OUTER GIMBAL ANGLE
034237,001354:                                                                                          	#        3   (                         )
034238,001355:                                                                                          	#            (   0    -SIN(OG) COS(OG) )
034239,001356: 
034240,001357:                                                                                          	#       3.  THE STAR NUMBER IS SAVED AND THE SECOND STAR IS THEN SIMILARLY PROCESSED.
034241,001358: 
034242,001359:                                                                                          	#       4.  THE ANGLE BETWEEN THE TWO STARS IS THEN CHECKED AT CKSDATA.
034243,001360: 
034244,001361:                                                                                          	#       5.  REFSMMAT IS THEN COMPUTED AT AXISGEN AS FOLLOWS.
034245,001362:                                                                                          	#                   -      -
034246,001363:                                                                                          	#               LET S  AND S  BE TWO STAR VECTORS EXPRESSED IN TWO COORDINATE SYSTEMS, A AND B (BASIC AND STABLE MEMBER).
034247,001364:                                                                                          	#                    1      2
034249,001366:                                                                                          	#               DEFINE, -    -
034250,001367:                                                                                          	#                       U  = S
034251,001368:                                                                                          	#                        A    A1
034252,001369:                                                                                          	#                       -         -    -
034253,001370:                                                                                          	#                       V  = UNIT(S  X S  )
034254,001371:                                                                                          	#                        A         A1   A2
034255,001372:                                                                                          	#                       -    -   -
034256,001373:                                                                                          	#                       W  = U X V
034257,001374:                                                                                          	#                        A    A   A
034258,001375: 
034259,001376:                                                                                          	#               AND
034260,001377:                                                                                          	#                       -    -
034261,001378:                                                                                          	#                       U  = S
034262,001379:                                                                                          	#                        B    B1
034263,001380:                                                                                          	#                       -         -    -
034264,001381:                                                                                          	#                       V  = UNIT(S  X S  )
034265,001382:                                                                                          	#                        B         B1   B2
034266,001383:                                                                                          	#                       -    -   -
034267,001384:                                                                                          	#                       W  = U X V
034268,001385:                                                                                          	#                        B    B   B
034269,001386: 
034270,001387:                                                                                          	#               THEN    -        -       -       -
034271,001388:                                                                                          	#                       X  = U  *U + V  *V + W  *W
034272,001389:                                                                                          	#                             B1  A   B1  A   B1  A
034273,001390:                                                                                          	#                       -        -       -       -              (REFSMMAT)
034274,001391:                                                                                          	#                       Y  = U  *U + V  *V + W  *W
034275,001392:                                                                                          	#                             B2  A   B2  A   B2  A
034276,001393:                                                                                          	#                       -        -       -       -
034277,001394:                                                                                          	#                       Z  = U  *U + V  *V + W  *W
034278,001395:                                                                                          	#                             B3  A   B3  A   B3  A
034279,001396: 
034280,001397:                                                                                          	# THE INPUTS CONSIST OF THE FOUR HALF-UNIT VECTORS STORED AS FOLLOWS
034281,001398:                                                                                          	#                       -
034282,001399:                                                                                          	#                       S   IN 6-11 OF THE VAC AREA
034283,001400:                                                                                          	#                        A1
034284,001401:                                                                                          	#                       -
034285,001402:                                                                                          	#                       S   IN 12-17 OF THE VAC AREA
034286,001403:                                                                                          	#                        A2
034287,001404:                                                                                          	#                       -

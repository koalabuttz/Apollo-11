047225,000844: 17,3623           15333                           TCF      RESUME                        	# AFTER T6RUPT OCCURED (IN T5RUPT)
047226,000845: 17,3624           13626                           TCF      +2                            	# IF SO WAIT FOR NEXT T6RUPT BEFORE
047227,000846: 17,3625           15333                           TCF      RESUME                        	# TAKING ACTION
047228,000847: 

051969,002716: 00,3616           00006                           EXTEND                                 	# IF NEGATIVE, USE THE IDENTITY
051970,002717: 00,3617           40155                           DCS      MPAC                          	# ARCCOS(X) = PI - ARCCOS(-X), FORCING
051971,002718: 00,3620           52155                           DXCH     MPAC                          	# ARGUMENT POSITIVE.
051972,002719: 00,3621           33731                           CAF      TCSUBTR                       	# SET EXIT TO DO ABOVE BEFROE
051973,002720: 00,3622           56136                           XCH      ESCAPE                        	# ARCSIN/ARCCOS CONSIDERATIONS.
051974,002721: 00,3623           54137                           TS       ESCAPE2                       	#
051975,002722: 

037269,000708:                                                                                          	# *************************************************************************************************************
037270,000709: 
037271,000710:                                                                                          	#          ROUTINE CALCRVG INTEGRATES THE EQUATIONS OF MOTION BY AVERAGING THE THRUST AND GRAVITATIONAL
037272,000711:                                                                                          	# ACCELERATIONS OVER A TIME INTERVAL OF 2 SECONDS.
037273,000712: 
037274,000713:                                                                                          	#          FOR THE EARTH-CENTERED GRAVITATIONAL FIELD, THE PERTURBATION DUE TO OBLATENESS IS COMPUTED TO THE FIRST
037275,000714:                                                                                          	# HARMONIC COEFFICIENT J.
037276,000715: 
037277,000716:                                                                                          	# ROUTINE CALCRVG REQUIRES...
037278,000717:                                                                                          	#       1) THRUST ACCELERATION INCREMENTS IN DELV SCALED SAME AS PIPAX,Y,Z IN STABLE MEMBER COORDS.
037279,000718:                                                                                          	#       2) VN SCALED 2(+7) M/CS IN REFERENCE COORDS.
037280,000719:                                                                                          	#       3) RN SCALED AT 2(+29) METERS IN REFERENCE COORDS.
037281,000720:                                                                                          	#       4) UNITW THE EARTH S UNIT ROTATIONAL VECTOR (SCALED AS A FULL UNIT VECTOR) IN REFERENCE COORDS.
037282,000721: 
037283,000722:                                                                                          	# IT LEAVES RN1 UPDATED (SCALED AT 2(+29)M, VN1 (SCALED AT 2(+7)M/CS), AND GDT1/2 (SCALED AT 2(+7)M/CS). ALSO HALF
037284,000723:                                                                                          	# UNIT VECTOR UNITR, RMAG IN 36D SCALED AT 2(+29)M, R MAG SQ. IN 34D SCALED AT 2(+58) M SQ.
037285,000724: 
037286,000725: 37,3353           41456        CALCGRAV           UNIT     PUSH                          	# ENTER WITH RN IN MPAC
037287,000726: 37,3354           01760                           STORE    UNITR                         	#
037288,000727: 37,3355           67340                           LXC,1    SLOAD                         	#
037289,000728: 37,3356           03746                                    RTX2                          	#
037290,000729: 37,3357           00047                                    X1                            	#
037291,000730: 37,3360           77240                           BMN      VLOAD                         	#
037292,000731: 37,3361           77407                                    ITISMOON                      	#
037293,000732: 37,3362           41441                           DOT      PUSH                          	#
037294,000733: 37,3363           01714                                    UNITW                         	#
037295,000734: 37,3364           44316                           DSQ      BDSU                          	#
037296,000735: 37,3365           37461                                    DP1/20                        	#
037297,000736: 37,3366           56325                           PDDL     DDV                           	#
037298,000737: 37,3367           37463                                    RESQ                          	#
037299,000738: 37,3370           00043                                    34D                           	# (RN)SQ
037300,000739: 37,3371           00041                           STORE    32D                           	# TEMP FOR (RE/RN)SQ
037301,000740: 37,3372           41205                           DMP      DMP                           	#
037302,000741: 37,3373           37465                                    20J                           	#
037303,000742: 37,3374           65361                           VXSC     PDDL                          	#
037304,000743: 37,3375           01760                                    UNITR                         	#
037305,000744: 37,3376           41205                           DMP      DMP                           	#
037306,000745: 37,3377           37467                                    2J                            	#

042504,000124: 
042505,000125: $TVCMASSPROP.agc				        # pp. 951-955
042507,000002:                                                                                          	## Copyright:   Public domain.
042508,000003:                                                                                          	## Filename:    TVCMASSPROP.agc
042509,000004:                                                                                          	## Purpose:     Part of the source code for Colossus 2A, AKA Comanche 055.
042510,000005:                                                                                          	##              It is part of the source code for the Command Module's (CM)
042511,000006:                                                                                          	##              Apollo Guidance Computer (AGC), for Apollo 11.
042512,000007:                                                                                          	## Assembler:   yaYUL
042513,000008:                                                                                          	## Contact:     Ron Burkey <info@sandroid.org>.
042514,000009:                                                                                          	## Website:     www.ibiblio.org/apollo.
042515,000010:                                                                                          	## Pages:       951-955
042516,000011:                                                                                          	## Mod history: 2009-05-13 RSB  Adapted from the Colossus249/ file of the
042517,000012:                                                                                          	##                              same name, using Comanche055 page images.
042518,000013:                                                                                          	##              2016-12-21 RSB  Proofed comment text using octopus/ProoferComments
042519,000014:                                                                                          	##                              and corrected the errors found.
042520,000015:                                                                                          	##              2017-01-20 RSB  Fixed comment-text errors noted while diff'ing
042521,000016:                                                                                          	##                              vs Colossus 249.
042522,000017:                                                                                          	##
042523,000018:                                                                                          	## This source code has been transcribed or otherwise adapted from digitized
042524,000019:                                                                                          	## images of a hardcopy from the MIT Museum.  The digitization was performed
042525,000020:                                                                                          	## by Paul Fjeld, and arranged for by Deborah Douglas of the Museum.  Many
042526,000021:                                                                                          	## thanks to both.  The images (with suitable reduction in storage size and
042527,000022:                                                                                          	## consequent reduction in image quality as well) are available online at
042528,000023:                                                                                          	## www.ibiblio.org/apollo.  If for some reason you find that the images are
042529,000024:                                                                                          	## illegible, contact me at info@sandroid.org about getting access to the 
042530,000025:                                                                                          	## (much) higher-quality images which Paul actually created.
042531,000026:                                                                                          	##
042532,000027:                                                                                          	## Notations on the hardcopy document read, in part:
042533,000028:                                                                                          	##
042534,000029:                                                                                          	##      Assemble revision 055 of AGC program Comanche by NASA
042535,000030:                                                                                          	##      2021113-051.  10:28 APR. 1, 1969  
042536,000031:                                                                                          	##
042537,000032:                                                                                          	##      This AGC program shall also be referred to as
042538,000033:                                                                                          	##                      Colossus 2A
042539,000034: 
042541,000036:                                                                                          	# PROGRAM NAME....MASSPROP
042542,000037:                                                                                          	# LOG SECTION....TVCMASSPROP            PROGRAMMER...MELANSON (ENGEL, SCHLUNDT)
042543,000038: 
042544,000039:                                                                                          	# FUNCTIONAL DESCRIPTION:
042545,000040: 
042546,000041:                                                                                          	#       MASSPROP OPERATES IN TWO MODES: (1) IF LEM MASS OR CONFIGURATION ARE UPDATED (MASSPROP DOES NOT TEST
042547,000042:                                                                                          	#       FOR THIS) THE ENTIRE PROGRAM MUST BE RUN THROUGH, BREAKPOINT VALUES AND DERIVATIVES OF THE OUTPUTS WITH
042548,000043:                                                                                          	#       RESPECT TO CSM MASS BEING CALCULATED PRIOR TO CALCULATION OF THE OUTPUTS.  (2) OTHERWISE, THE OUTPUTS CAN BE
042549,000044:                                                                                          	#       CALCULATED USING PREVIOUSLY COMPUTED BREAKPOINT VALUES AND DERIVATIVES.
042550,000045: 
042551,000046:                                                                                          	# CALLING SEQUENCES
042552,000047: 
042553,000048:                                                                                          	#       IF LEM MASS OR CONFIGURATION HAS BEEN UPDATED, TRANSFER TO MASSPROP, OTHERWISE TRANSFER TO FIXCW.
042554,000049:                                                                                          	#               L       TC      BANKCALL OR IBNKCALL
042555,000050:                                                                                          	#               L+1     CADR    MASSPROP
042556,000051:                                                                                          	#                       OR
042557,000052:                                                                                          	#               L+1     CADR    FIXCW
042558,000053:                                                                                          	#               L+2     RETURNS VIA Q
042559,000054: 
042560,000055:                                                                                          	# CALLED   IN PARTICULAR BY DONOUN47 (JOB) AND TVCEXECUTIVE (TASK)
042561,000056: 
042562,000057:                                                                                          	# JOBS OR TASKS INITIATED - NONE
042563,000058: 
042564,000059:                                                                                          	# SUBROUTINES CALLED - NONE
042565,000060: 
042566,000061:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
042567,000062: 
042568,000063:                                                                                          	#       LEMMASS MUST CONTAIN LEM MASS SCALED AT B+16 IN KILOGRAMS
042569,000064:                                                                                          	#       CSMMASS MUST CONTAIN CSM MASS SCALED AT B+16 IN KILOGRAMS
042570,000065:                                                                                          	#       DAPDATR1 MUST BE SET TO INDICATE VEHICLE CONFIGURATION.
042571,000066:                                                                                          	#               BITS (15,14,13)  =  ( 0 , 0 , 1 )       LEM OFF
042572,000067:                                                                                          	#                                   ( 0 , 1 , 0 )       LEM ON (ASCNT,DSCNT)
042573,000068:                                                                                          	#                                   ( 1 , 1 , 0 )       LEM ON (ASCNT ONLY)
042574,000069: 
042575,000070:                                                                                          	# ALARMS - NONE
042576,000071: 
042577,000072:                                                                                          	# EXIT -   TC   Q
042578,000073: 
042579,000074:                                                                                          	# OUTPUTS:
042580,000075: 
042581,000076:                                                                                          	#       (1)     IXX, SINGLE PRECISION SCALED AT B+20 IN KG-M SQ.
042582,000077:                                                                                          	#       (2)     IAVG, SINGLE PRECISION SCALED AT B+20 IN KG-M SQ.
042583,000078:                                                                                          	#       (3)     IAVG/TLX, SINGLE PRECISION, SCALED AT B+2 SEC-SQD
042584,000079:                                                                                          	#       
042585,000080:                                                                                          	#       THEY ARE STORED IN CONSECUTIVE REGISTERS IXX0, IXX1, IXX2
042586,000081:                                                                                          	#       CONVERSION FACTOR:  (SLUG-FTSQ) = 0.737562 (KG-MSQ)
042588,000083: 
042589,000084:                                                                                          	# OUTPUTS ARE CALCULATED AS FOLLOWS:
042590,000085: 
042591,000086:                                                                                          	#       (1)     IF LEM DOCKED, LEMMASS IS FIRST ELIMINATED AS A PARAMETER
042592,000087: 
042593,000088:                                                                                          	#               VARST0 = INTVALUE0 + LEMMASS(SLOPEVAL0)         IXX             BREAKPOINT VALUE
042594,000089:                                                                                          	#               VARST1 = INTVALUE1 + LEMMASS(SLOPEVAL1)         IAVG            BREAKPOINT VALUE
042595,000090:                                                                                          	#               VARST2 = INTVALUE2 + LEMMASS(SLOPEVAL2)         IAVG/TLX        BREAKPOINT VALUE
042596,000091: 
042597,000092:                                                                                          	#               VARST3 = INTVALUE3 + LEMMASS(SLOPEVAL3)         IAVG/TLX        SLOPE FOR CSMMASS > 33956 LBS (SPS > 10000 LBS)
042598,000093:                                                                                          	#               VARST4 = INTVALUE4 + LEMMASS(SLOPEVAL4)         IAVG            SLOPE FOR CSMMASS > 33956 LBS (SPS > 10000 LBS)
042599,000094: 
042600,000095:                                                                                          	#               VARST5 = INTVALUE5 + LEMMASS(SLOPEVAL5)         IXX             SLOPE FOR ALL VALUES OF CSMMASS
042601,000096: 
042602,000097:                                                                                          	#               VARST6 = INTVALUE6 + LEMMASS(SLOPEVAL6)         IAVG            SLOPE FOR CSMMASS < 33956 LBS (SPS < 10000 LBS)
042603,000098:                                                                                          	#               VARST7 = INTVALUE7 + LEMMASS(SLOPEVAL7)         IAVG/TLX        SLOPE FOR CSMMASS < 33956 LBS (SPS < 10000 LBS)
042604,000099: 
042605,000100:                                                                                          	#               VARST8 = INTVALUE8 + LEMMASS(SLOPEVAL8)         IAVG            DECREMENT TO BRKPT VALUE WHEN LEM DSCNT STAGE OFF
042606,000101:                                                                                          	#               VARST9 = INTVALUE9 + LEMMASS(SLOPEVAL9)         IAVG/TLX        DECREMENT TO BRKPT VALUE WHEN LEM DSCNT STAGE OFF
042607,000102: 
042608,000103:                                                                                          	#       (2)     IF LEM NOT DOCKED
042609,000104: 
042610,000105:                                                                                          	#               VARST0 = NOLEMVAL0      WHERE THE MEANING AND SCALING OF VARST0
042611,000106:                                                                                          	#                  .          .         TO VARST9 ARE THE SAME AS GIVEN ABOVE
042612,000107:                                                                                          	#                  .          .
042613,000108:                                                                                          	#                  .          .         NOTE... FOR THIS CASE, VARST8,9 HAVE NO
042614,000109:                                                                                          	#               VARST9 = NOLEMVAL9      MEANING (THEY ARE COMPUTED BUT NOT USED)
042615,000110: 
042616,000111:                                                                                          	#       (3)     THE FINAL OUTPUT CALCULATIONS ARE THEN DONE
042617,000112: 
042618,000113:                                                                                          	#               IXX0 = VARST0 + (CSMMASS + NEGBPW)VARST5                IXX
042619,000114: 
042620,000115:                                                                                          	#               IXX1 = VARST1 + (CSMMASS + NEGBPW)VARST(4 OR 6)         IAVG
042621,000116: 
042622,000117:                                                                                          	#               IXX2 = VARST2 + (CSMMASS + NEGBPW)VARST(3 OR 7)         IAVG/TLX
042623,000118: 
042624,000119:                                                                                          	#       THE DATA USED CAME FROM CSM/LM SPACECRAFT OPERATIONAL DATA BOOK.
042625,000120:                                                                                          	#               VOL. 3, NASA DOCUMENT SNA-8-D-027 (MARCH 1968)
042626,000121: 
042627,000122:                                                                                          	#       PERTINENT MASS DATA:            CSM WEIGHT      (FULL)  64100 LBS
042628,000123:                                                                                          	#                                                       (EMPTY) 23956 LBS
042629,000124:                                                                                          	#                                       LEM WEIGHT      (FULL)  32000 LBS
042630,000125:                                                                                          	#                                                       (EMPTY) 14116 LBS
042631,000126: 
042632,000127:                                                                                          	#       (WEIGHTS ARE FROM AMENDMENT #1 (APRIL 24, 1968) TO ABOVE DATA BOOK)
042634,000129: 
042635,000130: 25,3774                                           BANK     25                            	#
042636,000131: 05,2000                                           SETLOC   DAPMASS                       	#
042637,000132: 05,2000                                           BANK                                   	#
042638,000133: 05,3366  E6,1702                                  EBANK=   BZERO                         	#
042639,000134: 05,3366                                           COUNT*   $$/MASP                       	#
042640,000135: 
042641,000136: 05,3366           34334        MASSPROP           CAF      NINE                          	# MASSPROP USES TVC/RCS INTERUPT TEMPS
042642,000137: 05,3367           55506                           TS       PHI333                        	# SET UP TEN PASSES
042643,000138: 
042644,000139: 05,3370           31466        LEMTEST            CAE      DAPDATR1                      	# DETERMINE LEM STATUS
042645,000140: 05,3371           75003                           MASK     BIT13                         	#
042646,000141: 05,3372           00006                           EXTEND                                 	#
042647,000142: 05,3373           13377                           BZF      LEMYES                        	#
042648,000143: 
042649,000144: 05,3374           51506        LEMNO              INDEX    PHI333                        	# LEM NOT ATTACHED
042650,000145: 05,3375           33463                           CAF      NOLEMVAL                      	#
042651,000146: 05,3376           13407                           TCF      STOINST                       	#
042652,000147: 
042653,000148: 05,3377           31473        LEMYES             CAE      LEMMASS                       	# LEM IS ATTACHED
042654,000149: 05,3400           60000                           DOUBLE                                 	#
042655,000150: 05,3401           00006                           EXTEND                                 	#
042656,000151: 05,3402           51506                           INDEX    PHI333                        	#
042657,000152: 05,3403           73505                           MP       SLOPEVAL                      	#
042658,000153: 05,3404           20001                           DDOUBL                                 	#
042659,000154: 05,3405           51506                           INDEX    PHI333                        	#
042660,000155: 05,3406           63473                           AD       INTVALUE                      	#
042661,000156: 
042662,000157: 05,3407           51506        STOINST            INDEX    PHI333                        	# STORAGE INST BEGIN HERE
042663,000158: 05,3410           55511                           TS       VARST0                        	#
042664,000159: 05,3411           11506                           CCS      PHI333                        	# ARE ALL TEN PASSES COMPLETED
042665,000160: 05,3412           13367                           TCF      MASSPROP   +1                 	# NO - GO DECREMENT PHI333
042666,000161: 
042667,000162: 05,3413           11466        DXTEST             CCS      DAPDATR1                      	# IF NEG, BIT15 IS 1, LEM DSCNT STAGE OFF
042668,000163: 05,3414           13422                           TCF      FIXCW                         	#
042669,000164: 05,3415           13422                           TCF      FIXCW                         	#
042670,000165: 05,3416           53522                           DXCH     VARST0     +8D                	#
042671,000166: 05,3417           21513                           DAS      VARST0     +1                 	#
042672,000167: 05,3420           33520                           CA       DXITFIX                       	#
042673,000168: 05,3421           27520                           ADS      VARST0     +7                 	#
042674,000169: 
042675,000170: 05,3422           35016        FIXCW              CAF      BIT2                          	# COMPUTATION PHASE BEGINS HERE. SET UP
042676,000171: 05,3423           55506                           TS       PHI333                        	# THREE PASSES
042677,000172: 05,3424           55507                           TS       PSI333                        	#
042678,000173: 
042679,000174: 05,3425           31474                           CAE      CSMMASS                       	# GET DELTA CSM WEIGHT - SIGN DETERMINES
042680,000175: 05,3426           63517                           AD       NEGBPW                        	# SLOPE LOCATIONS.
042681,000176: 05,3427           60000                           DOUBLE                                 	#
042682,000177: 05,3430           55510                           TS       TEMP333                       	#
042684,000179: 05,3431           00006                           EXTEND                                 	#
042685,000180: 05,3432           63435                           BZMF     PEGGY                         	# DETERMINE CORRECT SLOPE
042686,000181: 05,3433           37715                           CAF      NEG2                          	#
042687,000182: 05,3434           55506                           TS       PHI333                        	#
042688,000183: 
042689,000184: 05,3435           51506        PEGGY              INDEX    PHI333                        	# ALL IS READY - CALCULATE OUTPUTS NOW
042690,000185: 05,3436           31516                           CAE      VARST5                        	# GET SLOPE
042691,000186: 05,3437           00006                           EXTEND                                 	#
042692,000187: 05,3440           71510                           MP       TEMP333                       	# MULT BY DELTA CSM WEIGHT
042693,000188: 05,3441           60000                           DOUBLE                                 	#
042694,000189: 05,3442           51507                           INDEX    PSI333                        	#
042695,000190: 05,3443           61511                           AD       VARST0                        	# ADD BREAKPOINT VALUE
042696,000191: 05,3444           51507                           INDEX    PSI333                        	#
042697,000192: 05,3445           55470                           TS       IXX                           	# ****** OUTPUTS (IXX0, IXX1, IXX2) ******
042698,000193: 
042699,000194: 05,3446           11507                           CCS      PSI333                        	# BOOKKEEPING - MASSPROP FINISHED OR NOT
042700,000195: 05,3447           13457                           TCF      BOKKEP2                       	# NO - GO TAKE CARE OF INDEXING REGISTERS
042701,000196: 
042702,000197: 05,3450           31466                           CAE      DAPDATR1                      	# UPDATE WEIGHT/G
042703,000198: 05,3451           75002                           MASK     BIT14                         	#
042704,000199: 05,3452           10000                           CCS      A                             	#
042705,000200: 05,3453           31473                           CA       LEMMASS                       	#
042706,000201: 05,3454           61474                           AD       CSMMASS                       	#
042707,000202: 05,3455           55475                           TS       WEIGHT/G                      	# SCALED AT B+16 IN KILOGRAMS
042708,000203: 05,3456           00002        ENDMASSP           TC       Q                             	#
042709,000204: 
042710,000205: 05,3457           55507        BOKKEP2            TS       PSI333                        	# REDUCE PSI BY ONE
042711,000206: 05,3460           00006                           EXTEND                                 	#
042712,000207: 05,3461           27506                           DIM      PHI333                        	#
042713,000208: 05,3462           13435                           TCF      PEGGY                         	#
042714,000209: 
042716,000211: 05,3463           00616        NOLEMVAL           DEC      25445      B-20               	#
042717,000212: 05,3464           02526                           DEC      87450      B-20               	#
042718,000213: 05,3465           02352                           DEC      .30715     B-2                	#
042719,000214: 05,3466           01471                           DEC      1.22877    E-5        B+12    	#
042720,000215: 05,3467           00634                           DEC      1.6096     B-6                	#
042721,000216: 05,3470           00612                           DEC      1.54       B-6                	#
042722,000217: 05,3471           03706                           DEC      7.77177    B-6                	#
042723,000218: 05,3472           04425                           DEC      3.46458    E-5        B+12    	#
042724,000219: 
042725,000220: 05,3473           00644        INTVALUE           DEC      26850      B-20               	#
042726,000221: 05,3474           03710                           DEC      127518     B-20               	#
042727,000222: 05,3475           04246                           DEC      .54059     B-2                	#
042728,000223: 05,3476           02011                           DEC      .153964    E-4        B+12    	#
042729,000224: 05,3477           77501                           DEC      -.742923   B-6                	#
042730,000225: 05,3500           00612                           DEC      1.5398     B-6                	#
042731,000226: 05,3501           04656                           DEC      9.68       B-6                	#
042732,000227: 05,3502           10372                           DEC      .647625    E-4        B+12    	#
042733,000228: 05,3503           77126                           DEC      -27228     B-20               	#
042734,000229: 05,3504           76261                           DEC      -.206476   B-2                	#
042735,000230: 
042736,000231: 05,3505           00767        SLOPEVAL           DEC      1.96307    B-6                	#
042737,000232: 05,3506           15624                           DEC      27.5774    B-6                	#
042738,000233: 05,3507           03054                           DEC      2.3548     E-5        B+12    	#
042739,000234: 05,3510           04532                           DEC      2.1777     E-9        B+26    	#
042740,000235: 05,3511           10433                           DEC      1.044      E-3        B+8     	#
042741,000236: 05,3512           00000                           DEC      0          B-14               	#
042742,000237: 05,3513           22070                           DEC      2.21068    E-3        B+8     	#
042743,000238: 05,3514           03204                           DEC      1.5166     E-9        B+26    	#
042744,000239: 05,3515           77266                           DEC      -1.284     B-6                	#
042745,000240: 05,3516           02476                           DEC      2          E-5        B+12    	#
042746,000241: 
042747,000242: 05,3517           70364        NEGBPW             DEC      -15402.17  B-16               	#
042748,000243: 05,3520           75420        DXITFIX            DEC*     -1.88275   E-5        B+12*   	#
042749,000244: 
(End of include-file TVCMASSPROP.agc, resuming MAIN.agc)
042749,000125: 

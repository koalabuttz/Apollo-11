025335,000418:                                                                                          	# PROGRAM NAME-  OPTICS CALIBRATION ROUTINE
025336,000419:                                                                                          	# MOD NO-  1
025337,000420:                                                                                          	# MOD BY-  TOM KNATT
025338,000421: 
025339,000422:                                                                                          	# FUNCTIONAL DESCRIPTION-  TO MEASURE THE EFFECT OF SOLAR RADIATION ON
025340,000423:                                                                                          	#       THE SXT TRUNNION ANGLE AND TO STORE THE MEASURED TRUNNION BIAS FOR P23
025341,000424: 
025342,000425:                                                                                          	# CALLING SEQUENCE-     CALL
025343,000426:                                                                                          	#                               R57
025344,000427: 
025345,000428:                                                                                          	# SUBROUTINES CALLED-  DISPLAY ROUTINES
025346,000429: 
025347,000430:                                                                                          	# NORMAL EXIT MODES-  VIA EGRESS
025348,000431: 
025349,000432:                                                                                          	# ALARMS-  NONE
025350,000433: 
025351,000434:                                                                                          	# ABORT MODES-  P23 ABORT IF MARKING SYSTEM OR EXTENDED VERB ACTIVE
025352,000435: 
025353,000436:                                                                                          	# INPUT-  NONE REQUIRED, NORMALLY CALLED BY P23
025354,000437: 
025355,000438:                                                                                          	# OUTPUT-  TRUNNION BIAS ANGLE- ANGLE DETERMINED WHEN SHAFT LINE OF SIGHT
025356,000439:                                                                                          	#       (SLOS) AND LANDMARK LINE OF SIGHT (LLOS) ARE SUPERIMPOSED.  THIS ANGLE
025357,000440:                                                                                          	#       MAY NOT BE EXACTLY ZERO BECAUSE OF UNEVEN HEATING OF THE OPTICS, FOR
025358,000441:                                                                                          	#       EXAMPLE.
025359,000442: 
025360,000443:                                                                                          	# ERASABLE INITIALIZATION REQUIRED-  MRKBUF1, EXTVBACT
025361,000444: 
025362,000445:                                                                                          	# DEBRIS-  RUPTREGS USED BY MARKRUPT AND ERASABLES USED BY DISPLAYS
025363,000446: 
025364,000447: 33,3776                                           BANK     33                            	#
025365,000448: 37,2000                                           SETLOC   P20S                          	#
025366,000449: 37,2000                                           BANK                                   	#
025367,000450: 37,2401                                           COUNT*   $$/R57                        	#
025368,000451: 37,2401  E7,1725                                  EBANK=   MRKBUF1                       	#
025369,000452: 37,2401           77420        R57                STQ      EXIT                          	#
025370,000453: 37,2402           02317                                    EGRESS                        	#
025371,000454: 37,2403           35060                           CAF      EBANK7                        	#
025372,000455: 37,2404           54003                           TS       EBANK                         	#
025373,000456: 37,2405           36211                           CAF      SIX                           	# BIT2 = MARKING SYSTEM IN USE
025374,000457: 37,2406           71044                           MASK     EXTVBACT                      	# BIT3 = EXTENDED VERB IN PROGRESS
025375,000458: 37,2407           10000                           CCS      A                             	#
025376,000459: 37,2410           02460                           TC       P23ABRT                       	# SET, THEREFORE ABORT
025377,000460: 37,2411           35016                           CAF      BIT2                          	# NOT SET
025378,000461: 37,2412           27044                           ADS      EXTVBACT                      	# SET IT
025379,000462: 37,2413           05546        R57A               TC       UPFLAG                        	# SET V59FLAG (BIT 12 FLAG 5) TO INDICATE
025380,000463: 37,2414           00116                           ADRES    V59FLAG                       	# CALIBRATION MARK
025381,000464: 37,2415           32463                           CAF      V59NB                         	#
025382,000465: 37,2416           04662                           TC       BANKCALL                      	#
025383,000466: 37,2417           20600                           CADR     GOMARKFR                      	#
025384,000467: 37,2420           04106                           TC       GOTOPOOH                      	# TERMINATE
025385,000468: 37,2421           02445                           TC       ENDR57                        	#
025386,000469: 37,2422           02445                           TC       ENDR57                        	#
025387,000470: 37,2423           35023                           CAF      SEVEN                         	#
025389,000472: 37,2424           05526                           TC       BLANKET                       	# BLANK OUT R1,R2,R3
025390,000473: 37,2425           05217                           TC       ENDOFJOB                      	#
025391,000474:                                                                                          	# STORE TRUNNION ANGLE (OCDU)
025392,000475: 37,2426           32462        MARKDISP           CAF      V06N87NB                      	#
025393,000476: 37,2427           04662                           TC       BANKCALL                      	#
025394,000477: 37,2430           20600                           CADR     GOMARKFR                      	#
025395,000478: 37,2431           04106                           TC       GOTOPOOH                      	# TERMINATE
025396,000479: 37,2432           02437                           TC       R57B                          	# PROCEED
025397,000480: 37,2433           02413                           TC       R57A                          	# ENTER (RECYCLE)
025398,000481: 37,2434           35022                           CAF      FIVE                          	#
025399,000482: 37,2435           05526                           TC       BLANKET                       	# BLANK OUT R1,R3
025400,000483: 37,2436           05217                           TC       ENDOFJOB                      	#
025401,000484: 37,2437           32465        R57B               CA       19.77DEG                      	# PUT FIXED INTO ERASABLE FOR MSU
025402,000485: 37,2440           54001                           TS       L                             	# INSTRUCTION COMING UP
025403,000486: 37,2441           31732                           CA       MRKBUF1    +5                 	# CONTAINS TRUNNION
025404,000487: 37,2442           00006                           EXTEND                                 	#
025405,000488: 37,2443           20001                           MSU      L                             	# CORRECTS TRUNBIAS FROM 2'S TO 1'S
025406,000489: 37,2444           55342                           TS       TRUNBIAS                      	#
025407,000490: 37,2445           05560        ENDR57             TC       DOWNFLAG                      	# RESET V59FLAG
025408,000491: 37,2446           00116                           ADRES    V59FLAG                       	# BIT 12 FLAG 5
025409,000492: 37,2447           35056                           CAF      EBANK5                        	#
025410,000493: 37,2450           54003                           TS       EBANK                         	#
025411,000494: 37,2451           35066                           CAF      PRIO14                        	#
025412,000495: 37,2452           05134                           TC       NOVAC                         	# THIS JOB CLEARS BIT IN
025413,000496: 37,2453     1330                                  EBANK=   MARKSTAT                      	#
025414,000497: 37,2453           05534 04062                     2CADR    ENDMARK                       	# MARKING IN R57 SO R53 CAN TAKE OVER
025415,000498: 
025416,000499: 37,2455           06006                           TC       INTPRET                       	#
025417,000500: 37,2456           77650                           GOTO                                   	#
025418,000501: 37,2457           02317                                    EGRESS                        	#
025419,000502: 37,2460           07755        P23ABRT            TC       BAILOUT                       	#
025420,000503: 37,2461           01211                           OCT      01211                         	#
025421,000504: 37,2462           01527        V06N87NB           VN       0687                          	#
025422,000505: 37,2463           16600        V59NB              VN       5900                          	#

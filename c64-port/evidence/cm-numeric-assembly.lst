045830,000044: 21,3251           00031                           READ     CHAN31                        	#
045831,000045: 21,3252           75002                           MASK     BIT14                         	#
045832,000046: 21,3253           00006                           EXTEND                                 	#
045833,000047: 21,3254           63272                           BZMF     FREECONT                      	#

037538,000171:                                                                                          	# ROLLC         ROLL COMMAND                            1 REVOLUTION
037539,000172: 
037540,000173:                                                                                          	# RTOGO         RANGE TO GO (FINAL PHASE)               2700 NM                 = FX +2
037541,000174: 
037542,000175:                                                                                          	# SL            SINE OF LATITUDE                        1                       NOT SAVED
037543,000176: 
037544,000177:                                                                                          	# T             TIME                                    B 28 CENTISEC           = TIME2,TIME1
037545,000178: 
037546,000179:                                                                                          	# THETA         DESIRED RANGE (RADIANS)                 2 PI RADIANS            = THETAH
037547,000180: 
037548,000181:                                                                                          	# THETNM        DESIRED RANGE (NM)                      21600 NM                NON EXISTENT
037549,000182: 
037550,000183:                                                                                          	# V             VELOCITY MAGNITUDE                      2 VSAT
037551,000184:                                                                                          	# 
037552,000185:                                                                                          	# V1            INITIAL VELOCITY FOR UPCONTROL          2 VSAT
037553,000186: 
037554,000187:                                                                                          	# VL            EXIT VELOCITY FOR UPCONTROL             2 VSAT
037555,000188: 
037556,000189:                                                                                          	# VREF          REFERENCE VELOCITY FOR UPCONTROL        2 VSAT
037557,000190: 
037558,000191:                                                                                          	# VS1           VSAT OR V1, WHICHEVER IS SMALLER        2 VSAT
037559,000192:                                                                                          	#                 2     2
037560,000193:                                                                                          	# VBARS         VL /VSAT                                4
037561,000194:                                                                                          	#                                          2     2
037562,000195:                                                                                          	# VSQ           NORMALISED VEL. SQUARED = V /VSAT       4                       = VSQUARE
037563,000196: 
037564,000197:                                                                                          	# WT            EARTH RATE TIMES TIME                   1 REVOLUTION            NOT SAVED
037565,000198:                                                                                          	#                                                                               = WIE (DTEAROT)
037566,000199:                                                                                          	# X             INTERMEDIATE VARIABLE IN G-LIMITER      2 VSAT                  NOT SAVED
037567,000200: 
037568,000201:                                                                                          	# Y             LATERAL MISS LIMIT                      4 RADIANS               NOT SAVED
037569,000202: 
037571,000204:                                                                                          	# EXTRA COMPUTER ERASABLE LOCATIONS NOT SHOWN ON FLOW CHARTS
037572,000205:                                                                                          	# -----------------------------------------------------------
037573,000206: 
037574,000207:                                                                                          	# VARIABLE      DESCRIPTION                             MAXIMUM VALUE
037575,000208:                                                                                          	# --------      -----------                             ------- -----
037576,000209: 
037577,000210:                                                                                          	# GOTOADDR      ADDRESS SELECTED BY SEQUENCER
037578,000211: 
037579,000212:                                                                                          	# XPIPBUF       BUFFER TO STORE X PIPA COUNTS
037580,000213: 
037581,000214:                                                                                          	# YPIPBUF       BUFFER TO STORE Y PIPA COUNTS
037582,000215: 
037583,000216:                                                                                          	# ZPIPBUF       BUFFER TO STORE Z PIPA COUNTS
037584,000217: 

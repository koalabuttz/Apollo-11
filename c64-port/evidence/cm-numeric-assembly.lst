035718,000398: 26,2442           00101                           MM       65         B-14               	# TARGET.
035719,000399: 
035720,000400: 26,2443           35065                           CA       PRIO13                        	#
035721,000401: 26,2444           05134                           TC       NOVAC                         	#
035722,000402: 26,2445     1263                                  EBANK=   ENTRYVN                       	#
035723,000403: 26,2445           02457 54062                     2CADR    P65.1                         	#
035724,000404: 
035725,000405: 26,2447           05372                           TC       2PHSCHNG                      	# 2 PHASE CHG REQUIRED TO PREVENT RE-
035726,000406: 26,2450           00554                           OCT      00554                         	# STARTING FLASHING DISPLAY TWICE.
035727,000407: 26,2451           10035                           OCT      10035                         	# 4.55 SPOT AND SERVICER, HERE.
035728,000408: 26,2452           06006                           TC       INTPRET                       	#
035729,000409: 26,2453           47131                           SSP      RTB                           	#
035730,000410: 26,2454           03646                                    GOTOADDR                      	# CHANGE ENTRY MODE TO UPCONTRL.
035731,000411: 26,2455           53035                                    UPCONTRL                      	#
035732,000412: 26,2456           52120                                    REFAZE10                      	# GO HERE TO REESTABLISH ENTRY SEQUENCER.
035733,000413:                                                                                          	# AND CONTINUE AT UPCONTRL...
035734,000414: 
035735,000415: 26,2457           05560        P65.1              TC       DOWNFLAG                      	#
035736,000416: 26,2460           00134                           ADRES    ENTRYDSP                      	# ENTRYDSP = 92D BIT 13 FLAG 6

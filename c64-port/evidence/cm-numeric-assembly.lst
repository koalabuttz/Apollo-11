049637,000384:                                                                                          	# Page 1119
049638,000385:                                                                                          	# SECTION 2     LOAD AND STORE PACKAGE.
049639,000386: 
049640,000387:                                                                                          	# A SET OF EIGHT STORE CODES IS PROVIDED AS THE PRIMARY METHOD OF STORING THE MULTI-PURPOSE
049641,000388:                                                                                          	# ACCUMULATOR (MPAC).  IF IN THE DANZIG SECTION LOC REFERS TO AN ALGEBRAICALLY POSITIVE WORD, IT IS TAKEN AS A
049642,000389:                                                                                          	# STORE CODE WITH A CORRESPONDING ERASABLE ADDRESS.  MOST OF THESE CODES ARE TWO ADDRESS, SPECIFYING THAT THE WORD
049643,000390:                                                                                          	# FOLLOWING THE STORE CODE IS TO BE USED AS AN ADDRESS FROM WHICH TO RE-LOAD MPAC.  FOUR OPTIONS ARE AVAILABLE:
049644,000391: 
049645,000392:                                                                                          	#       1. STORE        STORE MPAC.  THE E ADDRESS MAY BE INDEXED.
049646,000393:                                                                                          	#       2. STODL        STORE MPAC AND RE-LOAD IT IN DP WITH THE NEXT ADDRESS (THE LOAD MAY BE INDEXED).
049647,000394:                                                                                          	#       3. STOVL        STORE MPAC AND RE-LOAD A VECTOR (AS ABOVE).
049648,000395:                                                                                          	#       4. STCALL       STORE AND DO A CALL (BOTH ADDRESSES MUST BE DIRECT HERE).
049649,000396: 
049650,000397:                                                                                          	# STODL AND STOVL WILL TAKE FROM THE PUSH-DOWN LIST IF NO LOAD ADDRESS IS GIVEN.
049651,000398: 
049652,000399:    6323                                           BLOCK    3                             	#
049653,000400: 
049654,000401:    6323                                           COUNT    03/INTER                      	#
049655,000402: 
049656,000403:    6323           30165        STADR              CA       BANKSET                       	# THE STADR CODE (PUSHUP UP ON STORE
049657,000404:    6324           54004                           TS       FBANK                         	# ADDRESS) ENTERS HERE.
049658,000405:    6325           24164                           INCR     LOC                           	#
049659,000406:    6326           50164        ITR1               INDEX    LOC                           	# THE STORECODE WAS STORED COMPLEMENTED TO
049660,000407:    6327           40000                           CS       0                             	# MAKE IT LOOK LIKE AN OPCODE PAIR.
049661,000408:    6330           67716                           AD       NEGONE                        	# (YUL CANT REMOVE 1 BECAUSE OF EARLY CCS)
049662,000409: 
049663,000410:    6331           54116        DOSTORE            TS       ADDRWD                        	#
049664,000411:    6332           74372                           MASK     LOW11                         	# ENTRY FROM DISPATCHER.  SAVE THE ERASABLE
049665,000412:    6333           56116                           XCH      ADDRWD                        	# ADDRESS AND JUMP ON THE STORE CODE NO.
049666,000413:    6334           77671                           MASK     B12T14                        	#
049667,000414:    6335           00006                           EXTEND                                 	#
049668,000415:    6336           75013                           MP       BIT5                          	# EACH TRANSFER VECTOR ENTRY IS TWO WORDS.
049669,000416:    6337           50000        ITR0               INDEX    A                             	#
049670,000417:    6340           16341                           TCF      STORJUMP                      	#
049671,000418: 
049672,000419:                                                                                          	# Page 1120
049673,000420:                                                                                          	# STORE CODE JUMP TABLE.  CALLS THE APPROPRIATE STORING ROUTINE AND EXITS TO DANZIG OR TO ADDRESS WITH
049674,000421:                                                                                          	# A SUPPLIED OPERATION CODE.
049675,000422: 
049676,000423:                                                                                          	# STORE STORE,1 AND STORE,2 RETURN TO DANZIG, THUS RESETTING THE EBANK TO ITS STATE AT INTPRET.
049677,000424: 
049678,000425:    6341           06371        STORJUMP           TC       STORE                         	# STORE.
049679,000426:    6342           16030                           TCF      DANZIG                        	# PICK UP NEW OP CODE(S).
049680,000427:    6343           06363                           TC       STORE,1                       	#
049681,000428:    6344           16030                           TCF      DANZIG                        	#
049682,000429:    6345           06366                           TC       STORE,2                       	#
049683,000430:    6346           16030                           TCF      DANZIG                        	#
049684,000431: 
049685,000432:    6347           06371                           TC       STORE                         	# STODL.
049686,000433:    6350           16427                           TCF      DODLOAD                       	#
049687,000434: 
049688,000435:    6351           06371                           TC       STORE                         	# STODL WITH INDEXED LOAD ADDRESS.
049689,000436:    6352           16113                           TCF      DODLOAD*                      	#
049690,000437: 
049691,000438:    6353           06371                           TC       STORE                         	# STOVL.
049692,000439:    6354           16432                           TCF      DOVLOAD                       	#
049693,000440: 
049694,000441:    6355           06371                           TC       STORE                         	# STOVL WITH INDEXED LOAD ADDRESS.
049695,000442:    6356           16435                           TCF      DOVLOAD*                      	#
049696,000443:    6357           06371                           TC       STORE                         	# STOTC.
049697,000444:    6360           35030                           CAF      CALLCODE                      	#
049698,000445:    6361           54020                           TS       CYR                           	#
049699,000446:    6362           16221                           TCF      15BITADR                      	# GET A 15 BIT ADDRESS.
049700,000447: 

016991,003769:                                                                                          	# ERROR LIGHT RESET (RSET) TURNS OFF,
016992,003770:                                                                                          	# UPLINK ACTIVITY, AUTO, HOLD, FREE, OPERATOR ERROR,
016993,003771:                                                                                          	# PROG ALM, TRACKER FAIL.
016994,003772: 
016995,003773:                                                                                          	# LEAVES GIMBAL LOCK AND NO ATT ALONE.
016996,003774:                                                                                          	# 
016997,003775:                                                                                          	# IT ALSO ZEROES THE :TEST ALARM: OUT BIT, WHICH TURNS OFF STBY, RESTART.
016998,003776:                                                                                          	# IT ALSO SETS :CAUTION RESET: TO 1.
016999,003777:                                                                                          	# IT ALSO FORCES BIT 12 OF ALL DSPTAB ENTRIES TO 1.
017000,003778: 
017001,003779: 40,3510                                           SETLOC   DOPROC     +2                 	#
017002,003780: 40,3510                                           COUNT    40/PIN                        	#

018420,000212: 21,2005           04526                           TC       STOPRATE                      	#
018421,000213: 21,2006           31327        ENDMANU            CA       ATTPRIO                       	# RESTORE USERS PRIORITY
018422,000214: 21,2007           54063                           TS       NEWPRIO                       	#
018423,000215: 
018424,000216: 21,2010           35021                           CA       ZERO                          	# ZERO ATTCADR

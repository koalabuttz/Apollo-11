048052,000736: 
048054,000738:                                                                                          	# RCS           THIS SECTION IS ENTERED EACH 2 SEC BY WAITLIST CALL FOLLOWING A DELAY OF 1.2 SEC AFTER PIPUP.
048055,000739:                                                                                          	# THE TASK  SETJTAG  SETS A FLAG IN  JETAG  TO SIGNIFY THAT ROLL UPDATE IS DUE.  IN ROUGHLY 5 CS  BPDYRATE  WILL BE
048056,000740:                                                                                          	# EXECUTED AND JETAG WILL CAUSE  CM/RCS  TO ACT ON ROLLC IMMEDIATELY THEREAFTER.  THE
048057,000741:                                                                                          	# TASK SAVES THE CALL TIME SO THAT CM/RCS CAN DETERMINE HOW MUCH OF THE 2 SEC INTERVAL REMAINS BEFORE THE
048058,000742:                                                                                          	# NEXT UPDATE.
048059,000743: 
048060,000744: 15,3207           40025        SETJTAG            CS       TIME1                         	# SAVE NOMINAL UPDATE TIME FOR SYNCH
048061,000745: 15,3210           55712                           TS       TUSED                         	#
048062,000746:                                                                                          	# THE 5 CS APPEARS IN TIMETST.
048063,000747: 15,3211           35017                           CA       ONE                           	# RATHER THAN INCR, FOR SAFETY
048064,000748: 15,3212           55711                           TS       JETAG                         	# SET JETAG=1 TO CAUSE CM/RCS TO BE
048065,000749: 15,3213           05412                           TC       PHASCHNG                      	#
048066,000750: 15,3214           00001                           OCT      00001                         	#
048067,000751: 
048068,000752: 15,3215           05324                           TC       TASKOVER                      	# EXECUTED AFTER NEXT BODYRATE UPDATE
048069,000753: 
048070,000754:                                                                                          	# PREDICTIVE ROLL SYSTEM        ENTRY STEERING PROVIDES ROLL COMMAND IN LOC ROLLC.  THE FOLLOWING CALCULATES THE
048071,000755:                                                                                          	# TRAJECTORY TO THE ORIGIN IN PHASE PLANE (X,V).  PROGRAM ENTERS JET ON AND OFF CALLS INTO WTLST TO PRODUCE
048072,000756:                                                                                          	# THE DESIRED TRAJECTORY.  ONLY THOSE CALLS WHICH CAN BE EXECUTED WITHIN THE INTERVAL  T  (2 SEC) ARE ENTERED IN
048073,000757:                                                                                          	# WTLST, THE REMAINDER ARE RECONSIDERED AT NEXT UPDATE.
048074,000758: 
048075,000759: 15,3216     5001               HALFPR             EQUALS   NEG1/2     +1                 	#
048076,000760: 
048077,000761:                                                                                          	# CLEAR JETAG BEFORE TIMETST.  SET TO +0 TO SHOW
048078,000762:                                                                                          	# ROLL DAP CALLED.  IN EVENT OF RESTART, BODYRATE
048079,000763:                                                                                          	# MAY MISS A CYCLE.  CM/RCS WILL MISS A CYCLE ONLY
048080,000764:                                                                                          	# IF A RESTART OCCURS AFTER TIMETST COMMENCES.
048081,000765: 
048082,000766: 15,3216           45017        CM/RCS             CS       ONE                           	#
048083,000767: 15,3217           55617                           TS       JNDX                          	# SET NDX FOR POS ROLL, AND CHANGE LATER
048084,000768: 
048085,000769: 15,3220           45033                           CS       2T/TCDU                       	# ROLLDOT = DELAOG + DELAIG SINM =DELR
048086,000770: 15,3221           00006                           EXTEND                                 	#
048087,000771: 15,3222           71701                           MP       PREL                          	# DELR/180 = RDOT TCDU/180 = RDOT/1800
048088,000772: 15,3223           60001                           AD       L                             	# -2 RDOT T/180 IN L
048089,000773: 15,3224           55613                           TS       -VT/180                       	# SAVE -2VT/180 HERE
048090,000774: 
048091,000775: 15,3225           41664                           CS       ROLL/180                      	#
048092,000776: 15,3226           54021                           TS       SR                            	# SAVE (-R/180) /2
048093,000777: 
048094,000778: 15,3227           40102                           CS       CM/FLAGS                      	#
048095,000779: 15,3230           75014                           MASK     BIT4                          	# LATSW = 101D BIT4
048096,000780: 15,3231           00006                           EXTEND                                 	# ROLL OVER TOP $
048097,000781: 15,3232           13240                           BZF      GETLCX                        	# NO, TAKE SHORTEST PATH
048098,000782: 15,3233           26102                           ADS      CM/FLAGS                      	# YES, ENFORCE ROLL OVER TOP.. (BIT =0)
048099,000783: 15,3234           31715                           CA       ROLLC                         	# (ROLLC/180) /2
048100,000784: 15,3235           60021                           AD       SR                            	# -(R/180) /2
048101,000785: 15,3236           57614                           XCH      LCX/360                       	# DIFFERENT X REQD HERE.  DISCONT AT 180.
048102,000786: 15,3237           13300                           TCF      COMPAT                        	# POSSIBLE OVFL ABOVE.
048103,000787: 
048105,000789: 15,3240           35002        GETLCX             CA       POS1/2                        	# FORM RCOM/360
048106,000790: 15,3241           60000                           DOUBLE                                 	#
048107,000791: 15,3242           61715                           AD       ROLLC                         	#
048108,000792: 15,3243           57614                           XCH      LCX/360                       	# IGNORE POSSIBLE OVFL.
048109,000793: 
048110,000794: 15,3244           30021                           CA       SR                            	# FORM -R/360
048111,000795: 15,3245           65000                           AD       NEG1/2                        	#
048112,000796: 15,3246           65000                           AD       NEG1/2                        	# IGNORE OVFL
048113,000797: 15,3247           57614                           XCH      LCX/360                       	# -R/360
048114,000798: 15,3250           27614                           ADS      LCX/360                       	# LCX/360 = RCOM/360 - R/360  RANGE (-1,1)

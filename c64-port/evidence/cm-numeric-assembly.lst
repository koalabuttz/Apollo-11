051453,002200:                                                                                          	# Page 1175
051454,002201:                                                                                          	# THE FOLLOWING ROUTINE EXECUTES THE UNIT INSTRUCTION, WHICH TAKES THE UNIT OF THE VECTOR IN MPAC.
051455,002202: 
051456,002203: 00,3023           03010        UNIT               TC       VECAGREE                      	# FORCE SIGN AGREEMENT IN VECTOR
051457,002204: 00,3024           07501                           TC       MPACVBUF                      	# SAVE ARGUMENT IN VBUF
051458,002205: 00,3025           35021                           CAF      ZERO                          	# MUST SENSE OVERFLOW IN FOLLOWING DOT.
051459,002206: 00,3026           56121                           XCH      OVFIND                        	#

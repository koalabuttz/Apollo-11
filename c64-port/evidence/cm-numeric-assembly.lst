022589,000110: 23,2337           77776        V82GOFF            EXIT                                   	# ALLOW ASTRONAUT TO SELECT VEHICLE
022590,000111: 23,2340           35016                           CAF      TWO                           	# DESIRED FOR ORBITAL PARAMETERS
022591,000112: 23,2341           55051                           TS       OPTIONX                       	#

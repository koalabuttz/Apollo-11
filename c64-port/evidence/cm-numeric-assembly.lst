037634,000267:                                                                                          	# -------------------                                                   -----
037635,000268: 
037636,000269:                                                                                          	# C1            FACTOR IN ALP COMPUTATION                               1.25
037637,000270:                                                                                          	# C16           CONSTD GAIN ON DRAG                                     .01
037638,000271:                                                                                          	# C17           CONSTD GAIN ON RDOT                                     .001
037639,000272:                                                                                          	# C18           BIAS VEL. FOR FINAL PHASE START                         500     FPS
037640,000273:                                                                                          	# C20           MAX DRAG FOR DOWN-LIFT                                  175     FPSS
037641,000274:                                                                                          	# CHOOK         FACTOR IN AHOOK COMPUTATION                             .25
037642,000275:                                                                                          	# CH1           FACTOR IN GAMMAL COMPUTATION                            1.0
037643,000276:                                                                                          	# COS15         COS( 15 DEG )                                           .965
037644,000277:                                                                                          	# DLEWD0        INITIAL VARIATION IN LEWD                               -.05
037645,000278:                                                                                          	# D2            DRAG TO CHANGE LEWD                                     175     FPSS
037646,000279:                                                                                          	# DT            COMPUTATION CYCLE TIME INTERVAL                         2       SEC.
037647,000280:                                                                                          	# GMAX          MAXIMUM ACCELERATION                                    257.6   FPSS    (8 G-S)
037648,000281:                                                                                          	# KA1           FACTOR IN KA CALC                                       1.3     GS
037649,000282:                                                                                          	# KA2           FACTOR IN KA CALC                                       .2      GS
037650,000283:                                                                                          	# KA3           FACTOR IN D0 CALC                                       90 FPSS
037651,000284:                                                                                          	# KA4           FACTOR IN D0 CALC                                       40 FPSS
037652,000285:                                                                                          	# KB1           OPTIMIZED UPCONTROL GAIN                                3.4
037653,000286:                                                                                          	# KB2           OPTIMIZED UPCONTROL GAIN                                .0034
037654,000287:                                                                                          	# KDMIN         INCREMENT ON Q7 TO DETECT END OF KEPLER PHASE           .5      FPSS
037655,000288:                                                                                          	# KTETA         TIME OF FLIGHT CONSTANT                                 1000
037656,000289:                                                                                          	# KLAT1         FACTOR IN KLAT CALC                                     1/24
037657,000290:                                                                                          	# K44           GAIN USED IN INITIAL ROLL SECTION                       19749550 FPS
037658,000291:                                                                                          	# LATBIAS       LATERAL SWITCH BIAS TERM                                .41252961 NM
037659,000292:                                                                                          	# LEWD1         NOMINAL UPCONTROL L/D                                   .15
037660,000293:                                                                                          	# POINT1        FACTOR TO REDUCE UPCONTROL GAIN                         .1
037661,000294:                                                                                          	# Q2            FINAL PHASE RANGE - 23500 Q3                            -1002   NM
037662,000295:                                                                                          	# Q3            FINAL PHASE DRANGE/D V                                  .07     NM/FPS
037663,000296:                                                                                          	# Q5            FINAL PHASE DRANGE/D GAMMA                              7050    NM/RAD
037664,000297:                                                                                          	# Q6            FINAL PHASE INITIAL FLIGHT PATH ANGLE                   .0349   RAD
037665,000298:                                                                                          	# Q7F           MIN DRAG FOR UPCONTROL                                  6       FPSS
037666,000299:                                                                                          	# Q7MIN         MIN VALUE FOR Q7 IN FACTOR CALCULATION                  40      FPSS
037667,000300:                                                                                          	# Q19           FACTOR IN GAMMAL1 CALCULATION                           .5
037668,000301:                                                                                          	# Q21           FACTOR IN Q2 CALCULATION.                               1000    NM
037669,000302:                                                                                          	# Q22           FACTOR IN Q2 CALCULATION.                               -1302   NM
037670,000303:                                                                                          	# VFINAL1       VELOCITY TO START FINAL PHASE ON INITIAL ENTRY          27000   FPS
037671,000304:                                                                                          	# VFINAL        FACTOR IN INITIAL UP-DOWN CALC                          26600   FPS
037672,000305:                                                                                          	# VLMIN         MINIMUM VL                                              18000   FPS

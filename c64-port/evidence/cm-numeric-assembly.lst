021625,001365: 04,2673           03570                                    RINIT                         	#
021626,001366: 04,2674           77676                           VCOMP                                  	# U(-R)
021627,001367: 04,2675           00023                           STORE    18D                           	# U(-R) TO 18D
021628,001368: 04,2676           53435                           VXV      UNIT                          	# U(-R)*V EQ V*U(R), U(V*R)
021629,001369: 04,2677           03576                                    VINIT                         	#
021630,001370: 04,2700           00015                           STORE    12D                           	# U(V*R) TO 12D
021631,001371: 04,2701           53435                           VXV      UNIT                          	# U(V*R)*U(-R), U((V*R)*(-R))
021632,001372: 04,2702           00023                                    18D                           	#
021633,001373: 04,2703           24007                           STOVL    6D                            	# TRANSFORMATION MATRIX IS IN 6D (+1)
021634,001374: 04,2704           00001                                    0D                            	# DELTA V (+7) IN 0D
021635,001375: 04,2705           76521                           MXV      VSL1                          	# CONVERT FROM INER COOR TO LV COOR (+8)
021636,001376: 04,2706           00007                                    6D                            	# AND SCALE +7 IN MPAC
021637,001377: 04,2707           03405                           STORE    DELVLVC                       	# STORE IN DELVLVC (+7)
021638,001378: 04,2710           43414                           SET      RVQ                           	# SET MGLVFLAG TO INDICATE LVC CALC
021639,001379: 04,2711           02475                                    MGLVFLAG                      	# AND EXIT
021640,001380: 
021641,001381:                                                                                          	# ..... END OF MIDGIM ROUTINE .....
021642,001382: 

033205,000322: 
033206,000323:                                                                                          	# NAME - P52LS
033207,000324: 
033208,000325:                                                                                          	# FUNCTION - TO DISPLAY THE LANDING SITE LATITUDE,
033209,000326:                                                                                          	# LONGTITUDE AND ALTITUDE.  TO ACCEPT NEW DATA VIA
033210,000327:                                                                                          	# THE KEYBOARD.  TO COMPUTE THE LANDING SITE
033211,000328:                                                                                          	# ORIENTATION FOR P52 OR P54
033212,000329: 
033213,000330:                                                                                          	# LET:
033214,000331:                                                                                          	#       RLS  = LANDING SITE VECTOR IN REF COORDINATES
033215,000332:                                                                                          	#       R    = CSM POSITION VECTOR IN REF COORDINATES
033216,000333:                                                                                          	#       V    = CSM VELOCITY VECTOR IN REF COORDINATES
033217,000334:                                                                                          	# THEN THE LANDING SITE ORIENTATION IS:
033218,000335:                                                                                          	#       XSMD = UNIT(RLS)
033219,000336:                                                                                          	#       YSMD = UNIT(ZSMD*XSMD)
033220,000337:                                                                                          	#       ZSMD = UNIT((R*V)*RLS)
033221,000338: 
033222,000339:                                                                                          	# CALL -        CALL
033223,000340:                                                                                          	#                       P52LS
033224,000341: 
033225,000342:                                                                                          	# INPUTS-       DSPTEM1 = TIME OF ALIGNMENT
033226,000343:                                                                                          	#               RLS = LANDING SITE VECTOR IN MOON FIXED COORINATES
033227,000344: 
033228,000345:                                                                                          	# OUTPUTS-      XSMD, YSMD, ZSMD
033229,000346: 
033230,000347:                                                                                          	# SUBROUTINES-  RP-TO-R, LAT-LONG, LLASRD, LLASRDA, CSMPREC
033231,000348: 

061809,000184: 01,3650           54707                           TS       GOLOC      +2                 	# TYPE B RESTART, WE NEED PROPER EXIT
061810,000185:                                                                                          	# Page 1417
061811,000186: 01,3651           30154                           CA       TEMPPHS                       	# SET UP POINTER FOR FINDING OUR PLACE IN
061812,000187: 01,3652           54021                           TS       SR                            	# THE RESTART TABLES

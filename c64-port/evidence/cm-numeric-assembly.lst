011366,001169: 
011367,001170: 43,3027           06006        RESETVHF           TC       INTPRET                       	#
011368,001171: 43,3030           77414                           CLEAR    EXIT                          	#
011369,001172: 43,3031           04666                                    VHFRFLAG                      	#
011370,001173: 43,3032           05631                           TC       TRFAILOF                      	# TRACKER FAIL LIGHT
011371,001174: 
011372,001175: 43,3033           02121                           TC       GOPIN                         	#
011373,001176: 
011374,001177:                                                                                          	# VERB 66.      VEHICLES ARE ATTACHED.- MOVE THIS VEHICLE STATE VECTOR TO
011375,001178:                                                                                          	#               OTHER VEHICLE STATE VECTOR.
011376,001179: 
011377,001180:                                                                                          	# USE SUBROUTINE GENTRAN.
011378,001181: 

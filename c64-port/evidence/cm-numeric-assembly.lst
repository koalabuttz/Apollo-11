035140,000035: 
035142,000037:                                                                                          	# LUNAR AND SOLAR EPHEMERIDES SUBROUTINES
035143,000038: 
035144,000039:                                                                                          	# FUNCTIONAL DESCRIPTION
035145,000040: 
035146,000041:                                                                                          	#       THESE SUBROUTINES ARE USED TO DETERMINE THE POSITION AND VELOCITY
035147,000042:                                                                                          	#       VECTORS OF THE SUN AND THE MOON RELATIVE TO THE EARTH AT THE
035148,000043:                                                                                          	#       SPECIFIED GROUND ELAPSED TIME INPUT BY THE USER.
035149,000044: 
035150,000045:                                                                                          	#       THE POSITION OF THE MOON IS STORED IN THE COMPUTER IN THE FORM OF
035151,000046:                                                                                          	#       A NINTH DEGREE POLYNOMIAL APPROXIMATION WHICH IS VALID OVER A 15
035152,000047:                                                                                          	#       DAY INTERVAL BEGINNING SHORTLY BEFORE LAUNCH.  THEREFORE THE TIME
035153,000048:                                                                                          	#       INPUT BY THE USER SHOULD FALL WITHIN THIS 15 DAY INTERVAL.
035161,000056: 
035162,000057:                                                                                          	#       LSPOS COMPUTES THE POSITION VECTORS OF THE SUN AND THE MOON.
035163,000058: 
035164,000059:                                                                                          	#       LUNPOS COMPUTES THE POSITION VECTOR OF THE MOON.
035165,000060: 
035166,000061:                                                                                          	#       LUNVEL COMPUTES THE VELOCITY VECTOR OF THE MOON.
035167,000062: 
035168,000063:                                                                                          	#       SOLPOS COMPUTES THE POSITION VECTOR OF THE SUN.
035169,000064: 
035170,000065:                                                                                          	# CALLING SEQUENCE
035171,000066: 
035172,000067:                                                                                          	#       DLOAD   CALL
035173,000068:                                                                                          	#               TIME            GROUND ELAPSED TIME
035174,000069:                                                                                          	#               SUBROUTINE      LSPOS OR LUNPOS OR LUNVEL OR SOLPOS
035175,000070: 
035176,000071:                                                                                          	# INPUT
035177,000072: 
035178,000073:                                                                                          	#       1) SPECIFIED GROUND ELAPSED TIME IN CS X B-28 LOADED IN MPAC.
035179,000074: 
035180,000075:                                                                                          	#       2) TIMEMO - TIME AT THE CENTER OF THE RANGE OVER WHICH THE LUNAR
035181,000076:                                                                                          	#       POSITION POLYNOMIAL IS VALID IN CS X B-42.
035182,000077: 
035183,000078:                                                                                          	#       3) VECOEM - VECTOR COEFFICIENTS OF THE LUNAR POSITION POLYNOMIAL
035184,000079:                                                                                          	#       LOADED IN DESCENDING SEQUENCE IN METERS/CS**N X B-2
035185,000080: 
035186,000081:                                                                                          	#       4) RESO - POSITION VECTOR OF THE SUN RELATIVE TO THE EARTH AT
035187,000082:                                                                                          	#       TIMEMO IN METERS X B-38.
035188,000083: 
035189,000084:                                                                                          	#       5) VESO - VELOCITY VECTOR OF THE SUN RELATIVE TO THE EARTH AT
035190,000085:                                                                                          	#       TIMEMO IN METERS/CS X B-9.
035191,000086:                                                                                          	# 
035192,000087:                                                                                          	#       6) OMEGAES - ANGULAR VELOCITY OF THE VECTOR RESO AT TIMEMO IN
035193,000088:                                                                                          	#       REV/CS X B+26.
035194,000089: 
035195,000090:                                                                                          	#       ALL EXCEPT THE FIRST INPUT ARE INCLUDED IN THE PRE-LAUNCH
035196,000091:                                                                                          	#       ERASABLE DATA LOAD.
035197,000092: 
035198,000093:                                                                                          	# OUTPUT - LSPOS
035200,000095: 
035201,000096:                                                                                          	#       1) 2D OF VAC AREA CONTAINS THE POSITION VECTOR OF THE SUN RELATIVE
035202,000097:                                                                                          	#       TO THE EARTH AT TIME INPUT BY THE USER IN METERS X B-38.
035203,000098: 
035204,000099:                                                                                          	#       2) MPAC CONTAINS THE POSITION VECTOR OF THE MOON RELATIVE TO THE
035205,000100:                                                                                          	#       EARTH AT TIME INPUT BY THE USER IN METERS X B-29.
035206,000101: 
035207,000102:                                                                                          	# OUTPUT - LUNPOS
035208,000103: 
035209,000104:                                                                                          	#       MPAC CONTAINS THE POSITION VECTOR OF THE MOON RELATIVE TO THE
035210,000105:                                                                                          	#       EARTH AT THE TIME INPUT BY USER IN METERS X B-29.
035211,000106: 
035212,000107:                                                                                          	# OUTPUT - LUNVEL
035213,000108: 
035214,000109:                                                                                          	#       MPAC CONTAINS THE VELOCITY VECTOR OF THE MOON RELATIVE TO THE
035215,000110:                                                                                          	#       EARTH AT TIME INPUT BY THE USER IN METERS/CS X B-7.
035216,000111: 
035217,000112:                                                                                          	# OUTPUT - SOLPOS
035218,000113: 
035219,000114:                                                                                          	#       MPAC CONTAINS THE POSITION VECTOR OF THE SUN RELATIVE TO THE EARTH
035220,000115:                                                                                          	#       AT TIME INPUT BY THE USER IN METERS X B-38.
035221,000116: 
035222,000117:                                                                                          	# SUBROUTINES USED
035223,000118: 
035224,000119:                                                                                          	#       NONE
035225,000120: 
035226,000121:                                                                                          	# REMARKS
035227,000122: 
035228,000123:                                                                                          	#       THE VAC AREA IS USED FOR STORAGE OF INTERMEDIATE AND FINAL RESULTS
035229,000124:                                                                                          	#       OF COMPUTATIONS.
035230,000125: 
035231,000126:                                                                                          	#       S1, X1 AND X2 ARE USED BY THESE SUBROUTINES.
035232,000127: 
035233,000128:                                                                                          	#       PRELAUNCH ERASABLE DATA LOAD ARE ONLY ERASABLE STORAGE USED BY
035234,000129:                                                                                          	#       THESE SUBROUTINES.
035235,000130: 
035236,000131:                                                                                          	#       RESTARTS DURING OPERATION OF THESE SUBROUTINES MUST BE HANDLED BY
035237,000132:                                                                                          	#       THE USER.
035238,000133: 
035239,000134: 36,2466                                           BANK     36                            	#
035240,000135: 26,2000                                           SETLOC   EPHEM                         	#
035241,000136: 26,2000                                           BANK                                   	#
035242,000137: 
035243,000138: 26,2110                                           COUNT*   $$/EPHEM                      	#
035244,000139: 26,2110  E7,1777                                  EBANK=   END-E7                        	#
035245,000140: 26,2110           77774        LSPOS              AXT,2                                  	# COMPUTES POSITION VECTORS OF BOTH THE
035246,000141: 26,2111           54161                                    RESA                          	# SUN AND THE MOON.  THE POSITION VECTOR
035247,000142: 26,2112           52170                           AXT,1    GOTO                          	# OF THE SUN IS STORED IN 2D OF THE VAC
035248,000143: 26,2113           54143                                    RES                           	# AREA.  THE POSITION VECTOR OF THE MOON
035249,000144: 26,2114           54126                                    LSTIME                        	# IS STORED IN MPAC.
035250,000145: 26,2115           52170        LUNPOS             AXT,1    GOTO                          	# COMPUTES THE POSITION VECTOR OF THE MOON
035251,000146: 26,2116           54162                                    REM                           	# AND STORES IT IN MPAC.
035252,000147: 26,2117           54126                                    LSTIME                        	#
035254,000149: 26,2120           52170        LUNVEL             AXT,1    GOTO                          	# COMPUTES THE VELOCITY VECTOR OF THE MOON
035255,000150: 26,2121           54173                                    VEM                           	# AND STORES IT IN MPAC.
035256,000151: 26,2122           54126                                    LSTIME                        	#
035257,000152: 26,2123           76020        SOLPOS             STQ      AXT,1                         	# COMPUTES THE POSITION VECTOR OF THE SUN

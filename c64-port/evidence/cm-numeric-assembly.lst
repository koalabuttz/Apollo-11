065792,000034: 
065794,000036: 22,3510                                           BANK     22                            	#
065795,000037: 22,2000                                           SETLOC   RTBCODES                      	#
065796,000038: 22,2000                                           BANK                                   	#
065797,000039: 
065798,000040: 22,3510  E5,1713                                  EBANK=   XNB                           	#
065799,000041: 22,3510                                           COUNT*   $$/RTB                        	#
065800,000042: 
065801,000043:                                                                                          	# LOAD TIME2, TIME1 INTO MPAC:
065802,000044: 
065803,000045: 22,3510           00006        LOADTIME           EXTEND                                 	#
065804,000046: 22,3511           30025                           DCA      TIME2                         	#
065805,000047: 22,3512           16024                           TCF      SLOAD2                        	#
065806,000048: 
065807,000049:                                                                                          	# CONVERT THE SINGLE PRECISION 2'S COMPLEMENT NUMBER ARRIVING IN MPAC (SCALED IN HALF-REVOLUTIONS) TO A
065808,000050:                                                                                          	# DP 1'S COMPLEMENT NUMBER SCALED IN REVOLUTIONS.
065809,000051: 
065810,000052: 22,3513           10154        CDULOGIC           CCS      MPAC                          	#
065811,000053: 22,3514           35021                           CAF      ZERO                          	#

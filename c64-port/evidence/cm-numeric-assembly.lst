015710,002488:                                                                                          	# DSPFMEM IS USED TO DISPLAY (IN OCTAL) ANY FIXED REGISTER.
015711,002489:                                                                                          	# IT IS USED WITH NOUN = MACHINE CADR TO BE SPECIFIED.  THE FCADR OF THE 
015712,002490:                                                                                          	# DESIRED LOCATION IS THEN PUNCHED IN.  IT HANDLES F/F (FCADR 4000-7777)
015713,002491:                                                                                          	# 
015714,002492:                                                                                          	# FOR BANKS L/E 27, THIS IS ENOUGH.
015715,002493: 
015716,002494:                                                                                          	# FOR BANKS G/E 30, THE THIRD COMPONENT OF NOUN 26 (PRIO, ADRES, BBCON)
015717,002495:                                                                                          	# MUST BE PRELOADED WITH THE DESIRED SUPERBANK BITS (BITS 5,6,7).
015718,002496:                                                                                          	#       V23N26 SHOULD BE USED.
015719,002497: 
015720,002498:                                                                                          	# SUMMARY
015721,002499:                                                                                          	# FOR BANKS L/E 27,                             V27N01E(FCADR)E
015722,002500:                                                                                          	# FOR BANKS G/E 30,     V23N26E(SUPERBITS)E     V27N01E(FCADR)E
015723,002501: 
015724,002502: 41,3353           34333        DSPFMEM            CAF      R1D1                          	# IF F/F, DATACALL USES BANK 02 OR 03.
015725,002503: 41,3354           54777                           TS       DSPCOUNT                      	#
015726,002504: 41,3355           31047                           CA       DSPTEM1    +2                 	# SUPERBANK BITS WERE PRELOADED INTO
015727,002505: 41,3356           54001                           TS       L                             	# 3RD COMPONENT OF NOUN 26.
015728,002506: 41,3357           31017                           CA       NOUNCADR                      	# ORIGINAL FCADR LOADED STILL IN NOUNCADR.
015729,002507: 41,3360           04715                           TC       SUPDACAL                      	# CALL WITH FCADR IN A, SUPERBITS IN L.
015730,002508: 41,3361           03363                           TC       DSPOCTWD                      	#
015731,002509: 41,3362           05217        ENDSPF             TC       ENDOFJOB                      	#

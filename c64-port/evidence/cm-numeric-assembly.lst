033627,000744:                                                                                          	# PROGRAM NAME - PICAPAR        DATE DEC 20 66
033628,000745:                                                                                          	# MOD 1                         LOG SECTION P51-P53
033629,000746:                                                                                          	#                               ASSEMBLY  SUNDISK  REV40
033630,000747:                                                                                          	# BY KEN VINCENT
033631,000748: 
033632,000749:                                                                                          	# FUNCTION
033633,000750:                                                                                          	#       THIS PROGRAM READ THE IMU-CDUS AND COMPUTES THE VEHICLE ORIENTATION
033634,000751:                                                                                          	#       WITH RESPECT TO INERTIAL SPACE.  IT THEN COMPUTES THE SHAFT AXIS (SAX)
033635,000752:                                                                                          	#       WITH RESPECT TO REFERENCE INERTIAL.  EACH STAR IN THE CATALOG IS TESTED
033636,000753:                                                                                          	#       TO DETERMINE IF IT IS OCCULTED BY EITHER THE EARTH, SUN OR MOON.  IF A
033637,000754:                                                                                          	#       STAR IS NOT OCCULTED THEN IT IS PAIRED WITH ALL STAR OF LOWER INDEX.
033638,000755:                                                                                          	#       THE PAIRED STAR IS TESTED FOR OCCULTATION.  PAIRS OF STARS THAT PASS
033639,000756:                                                                                          	#       THE OCCULTATION TESTS ARE TESTED FOR GOOD SEPARATION.  A PAIR OF STARS
033640,000757:                                                                                          	#       HAVE GOOD SEPARATION IF THE ANGLE BETWEEN THEM IS LESS THAN 66 DEGREES
033641,000758:                                                                                          	#       AND MORE THAN 40 DEGREES.  THOSE PAIRS OF STARS WITH GOOD SEPARATION
033642,000759:                                                                                          	#       ARE THEN TESTED TO SEE IF THEY LIE IN CURRENT FIELD OF VIEW.  (WITHIN
033643,000760:                                                                                          	#       33 DEGREES OF SAX).  THE PAIR WITH MAXIMUM SEPARATION IS CHOSEN FROM
033644,000761:                                                                                          	#       THOSE WITH GOOD SEPARATION, AND IN FIELD OF VIEW.
033645,000762: 
033646,000763:                                                                                          	# CALLING SEQUENCE
033647,000764:                                                                                          	#       L       TC      BANKCALL
033648,000765:                                                                                          	#       L+1     CADR    PICAPAR
033649,000766:                                                                                          	#       L+2     ERROR RETURN - NO STARS IN FIELD OF VIEW
033650,000767:                                                                                          	#       L+3     NORMAL RETURN
033651,000768: 
033652,000769:                                                                                          	# OUTPUT
033653,000770:                                                                                          	#       BESTI, BESTJ - SINGLE PREC, INTEGERS, STAR NUMBERS TIMES 6
033654,000771:                                                                                          	#       VFLAG - FLAG BIT SET IMPLIES NO STARS IN FIELD OF VIEW
033655,000772: 
033656,000773:                                                                                          	# INITIALIZATION
033657,000774:                                                                                          	#       1)      A CALL TO LOCSAM MUST BE MADE
033658,000775:                                                                                          	#       2)      VEARTH = -UNIT(R) WHERE R HAS BEEN UPDATED TOO APPROXIMATE TIME OF
033659,000776:                                                                                          	#               SIGHTINGS.
033660,000777: 
033661,000778:                                                                                          	# DEBRIS
033662,000779:                                                                                          	#       WORK AREA
033663,000780:                                                                                          	#       X,Y,ZNB
033664,000781:                                                                                          	#       SINCDU, COSCDU
033665,000782:                                                                                          	#       STARAD - STAR +5

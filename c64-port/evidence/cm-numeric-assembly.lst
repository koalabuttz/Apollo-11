042213,000406: 17,2543           00232        FREPFRAC           DEC      .0375      B-2                	# CSM/LM (LB), 0.0375 SCALED AT B+2
042214,000407: 
042215,000408: 17,2544     4374               NINETEEN           =        VD1                           	#
042216,000409: 17,2544           33074        2PI/M              DEC      .00331017  B+8                	# 2PI/M, SCALED AT 1/(B+8 N-M)
042217,000410: 
042218,000411: 17,2545           03720        ONETHOU            DEC      1000       B-13               	# KG/CS B3 TO KG/10SEC B16 CONVERSION
042219,000412: 
042220,000413: 17,2546  E6,1702                                  EBANK=   BZERO                         	#
042221,000414: 17,2546           03107 40066  DAPINIT5           2CADR    DAPINIT                       	#
042222,000415: 
042223,000416: 17,2550  E6,1702                                  EBANK=   BZERO                         	#
042224,000417: 17,2550           02171 36066  INITLOC2           2CADR    TVCINIT1                      	#

018513,000034: 
018514,000035: 
018516,000037: 22,3151  E5,1671                                  EBANK=   XSM                           	#
018517,000038: 
018518,000039: 33,2000                                           BANK     33                            	#
018519,000040: 13,2000                                           SETLOC   E/PROG1                       	#
018520,000041: 13,2000                                           BANK                                   	#
018521,000042: 
018522,000043: 13,2036                                           COUNT*   $$/P07                        	#
018523,000044: 
018524,000045:                                                                                          	# SPECIAL PROGRAMS TO EASE THE PANGS OF ERASABLE MEMORY PROGRAMS.
018525,000046: 
018526,000047:                                                                                          	# E/BKCALL      FOR DOING BANKCALLS FROM AND RETURNING TO ERASABLE.
018527,000048: 
018528,000049:                                                                                          	# THIS ROUTINE IS CALLABLE FROM ERASABLE OR FIXED.  LIKE BANKCALL, HOWEVER, SWITCHING BETWEEN S3 AND S4
018529,000050:                                                                                          	# IS NOT POSSIBLE.
018530,000051: 
018531,000052:                                                                                          	# THE CALLING SEQUENCE IS:
018532,000053: 
018533,000054:                                                                                          	#       TC      BANKCALL
018534,000055:                                                                                          	#       CADR    E/BKCALL
018535,000056:                                                                                          	#       CADR    ROUTINE         WHERE YOU WANT TO GO IN FIXED.
018536,000057:                                                                                          	#       RETURN HERE FROM DISPLAY TERMINATE, BAD STALL OR TC Q.
018537,000058:                                                                                          	#       RETURN HERE FROM DISPLAY PROCEED OR GOOD RETURN FROM STALL.
018538,000059:                                                                                          	#       RETURN HERE FROM DISPLAY ENTER OR RECYCLE.
018539,000060: 
018540,000061:                                                                                          	# THIS ROUTINE REQUIRES TWO ERASABLES (EBUF2, +1) IN UNSWITCHED WHICH ARE UNSHARED BY INTERRUPTS AND
018541,000062:                                                                                          	# OTHER EMEMORY PROGRAMS.
018542,000063: 
018543,000064:                                                                                          	# A + L ARE PRESERVED THROUGH BANKCALL AND E/BKCALL.
018544,000065: 
018545,000066: 13,2036           52134        E/BKCALL           DXCH     BUF2                          	# SAVE A,L AND GET DP RETURN.
018546,000067: 13,2037           52365                           DXCH     EBUF2                         	# SAVE DP RETURN.
018547,000068: 13,2040           24364                           INCR     EBUF2                         	# RETURN +1 BECAUSE DOUBLE CADR.
018548,000069: 13,2041           30006                           CA       BBANK                         	#
018549,000070: 13,2042           75054                           MASK     LOW10                         	# GET CURRENT EBANK.  (SBANK SOMEDAY)
018550,000071: 13,2043           26365                           ADS      EBUF2      +1                 	# FORM BBCON.  (WAS FBANK)
018551,000072: 13,2044           50364                           NDX      EBUF2                         	#
018552,000073: 13,2045           27777                           CA       0          -1                 	# GET CADR OF ROUTINE.
018553,000074: 13,2046           04666                           TC       SWCALL                        	# GO TO ROUTINE, SETTING Q TO SWRETURN
018554,000075:                                                                                          	# AND RESTORING A + L.
018555,000076: 13,2047           02053                           TC       +4                            	# TX Q, V34, OR BAD STALL RETURN.
018556,000077: 13,2050           02052                           TC       +2                            	# PROCEED OR GOOD STALL RETURN.
018557,000078: 13,2051           24364                           INCR     EBUF2                         	# ENTER OR RECYCLE RETURN.
018558,000079: 13,2052           24364                           INCR     EBUF2                         	#
018559,000080: 13,2053           52365        E/SWITCH           DXCH     EBUF2                         	#
018560,000081: 13,2054           52006                           DTCB                                   	#
018561,000082: 
018563,000084:                                                                                          	# E/CALL        FOR CALLING A FIXED MEMORY INTERPRETIVE SUBROUTINE FROM ERASABLE AND RETURNING TO ERASABLE.
018564,000085: 
018565,000086:                                                                                          	# THE CALLING SEQUENCE IS...
018566,000087: 
018567,000088:                                                                                          	#       RTB
018568,000089:                                                                                          	#               E/CALL
018569,000090:                                                                                          	#       CADR    ROUTINE                 THE INTERPRETIVE SUBROUTINE YOU WANT.
018570,000091:                                                                                          	#                                       RETURNS HERE IN INTERPRETIVE.
018571,000092: 
018572,000093: 13,2055           22164        E/CALL             LXCH     LOC                           	# ADRES -1 OF CADR.
018573,000094: 13,2056           50001                           INDEX    L                             	#
018574,000095: 13,2057           30001                           CA       L                             	# CADR IN A.
018575,000096: 13,2060           24001                           INCR     L                             	#
018576,000097: 13,2061           24001                           INCR     L                             	# RETURN ADRES IN L.
018577,000098: 13,2062           52365                           DXCH     EBUF2                         	# STORE CADR AND RETURN.
018578,000099: 13,2063           06006                           TC       INTPRET                       	#
018579,000100: 13,2064           77624                           CALL                                   	#
018580,000101: 13,2065           00364                                    EBUF2                         	# INDIRECTLY EXECUTE ROUTINE.  IT MUST
018581,000102: 13,2066           77776                           EXIT                                   	# LEAVE VIA RVQ OR EQUIVALENT.
018582,000103: 13,2067           22365                           LXCH     EBUF2      +1                 	# PICK UP RETURN.
018583,000104: 13,2070           16010                           TCF      INTPRET    +2                 	# SET LOC AND RETURB TO CALLER
018584,000105: 
018586,000107:                                                                                          	# E/JOBWAK      FOR WAKING UP ERASABLE MEMORY JOBS.
018587,000108: 
018588,000109:                                                                                          	# THIS ROUTINE MUST BE CALLED IN INTERRUPT OR WITH INTERRUPTS INHIBITED.
018589,000110: 
018590,000111:                                                                                          	# THE CALLING SEQUENCE IS:
018591,000112: 
018592,000113:                                                                                          	#       INHINT
018593,000114:                                                                                          	#         .
018594,000115:                                                                                          	#         .
018595,000116:                                                                                          	#       CA      WAKEADR         ADDRESS OF SLEEPING JOB
018596,000117:                                                                                          	#       TC      IBNKCALL
018597,000118:                                                                                          	#       CADR    E/JOBWAK
018598,000119:                                                                                          	#         .                     RETURNS HERE
018599,000120:                                                                                          	#         .
018600,000121:                                                                                          	#         .
018601,000122:                                                                                          	#       RELINT                  IF YOU DID AN INHINT.
018602,000123: 
018603,000124: 33,2000                                           BANK     33                            	#
018604,000125: 04,2000                                           SETLOC   E/PROG                        	#
018605,000126: 04,2000                                           BANK                                   	#
018606,000127: 
018607,000128: 04,2606                                           COUNT*   $$/P07                        	#
018608,000129: 
018609,000130: 04,2606           05201        E/JOBWAK           TC       JOBWAKE                       	# ARRIVE IWTH ADRES IN A.
018610,000131: 04,2607           45005                           CS       BIT11                         	#
018611,000132: 04,2610           50064                           NDX      LOCCTR                        	#
018612,000133: 04,2611           26164                           ADS      LOC                           	# KNOCK FIXED MEMORY BIT OUT OF ADRES.
018613,000134: 04,2612           00072                           TC       RUPTREG3                      	# RETURN
018614,000135: 
018615,000136: 
018616,000137:                                                                                          	# THESE PROGRAMS ARE PROVIDED TO ALLOW OVERLAY OF BANKS 30 THRU 33 OF THE 205 VERSIONS OF SYSTEM TESTS AND
018617,000138:                                                                                          	# PRELAUNCH ALIGN.  THE INTENT IS TO ALLOW THE STG AND HYBRID LABS TO RUN ALL THE TESTS WITH COLOSSUS.
018618,000139: 
018619,000140: 
018620,000141: 33,2000                                           BANK     33                            	#
018621,000142: 33,2000                                           SETLOC   TESTLEAD                      	#
018622,000143: 33,2000                                           BANK                                   	#
018623,000144: 
018624,000145: 33,2000                                           COUNT    33/COMST                      	#
018625,000146: 
018626,000147: 33,2000  E5,1425                                  EBANK=   QPLACE                        	#
018627,000148: 
018628,000149: 33,2000           03436        COMPVER            TC       GCOMPVER                      	# MUST BE 33,2000.
018629,000150: 
018630,000151: 33,2001           03131        GTSCPSS1           TC       GTSCPSS                       	# MUST BE AT 33,2001
018631,000152: 
018632,000153: 33,2002           05354        REDO               TC       NEWMODEX                      	# DISPLAY MM 07.
018633,000154: 33,2003           00007                           MM       07         B-14               	# FALL INTO IMUTEST
018634,000155: 
(End of include-file SYSTEM_TEST_STANDARD_LEAD_INS.agc, resuming MAIN.agc)

057938,000969:                                                                                          	# MIDTOAV1
057939,000970: 
057940,000971:                                                                                          	# THIS ROUTINE INTEGRATES (PRECISION) TO THE TIME SPECIFIED IN TDEC1.
057941,000972:                                                                                          	# IF, AT THE END OF AN INTEGRATION TIME STEP, CURRENT TIME PLUS A DELTA
057942,000973:                                                                                          	# TIME (SEE TIMEDELT.....BASED ON THE COMPUTATUON TIME FOR ONE TIME STEP)
057943,000974:                                                                                          	# IS GREATER THAN THE DESIRED TIME, ALARM 1703 IS SET AND THE INTEGRATION
057944,000975:                                                                                          	# IS DONE AS IT IS FOR MIDTOAV2.
057945,000976:                                                                                          	# RETURN IS IN BASIC TO THE RETURN ADDRESS PLUS ONE.
057946,000977: 
057947,000978:                                                                                          	# IF THE INTEGRATION IS FINISHED TO THE DESIRED TIME, RETURN IS IN BASIC
057948,000979:                                                                                          	# TO THE RETURN ADDRESS
057949,000980: 
057950,000981:                                                                                          	# IN EITHER CASE, BEFORE RETURNING, THE EXTRAPOLATED STATE VECTOR IS TRAN
057951,000982:                                                                                          	# FERRED FROM R,VATT TO R,VN1-PIPTIME1 IS SET TO THE FINISHING INTEGRA-
057952,000983:                                                                                          	# TION TIME AND MPAC IS SET TO THE DELTA TIME---
057953,000984:                                                                                          	#                                   TAT MINUS CURRENT TIME.
057954,000985: 
057955,000986:                                                                                          	# MIDTOAV2
057956,000987: 
057957,000988:                                                                                          	# THIS ROUTINE INTEGRATES THE CSM STATE VECTOR TO CURRENT TIME PLUS
057958,000989:                                                                                          	# INCREMENTS OF TIMEDELT SUCH THAT THE DIFFERENCE BETWEEN CURRENT TIME
057959,000990:                                                                                          	# AND THE STATE VECTOR TIME AT THE END OF THE LAST STEP IS AT LEAST 5.6
057960,000991:                                                                                          	# SECS.
057961,000992:                                                                                          	# NO INPUTS ARE REQUIRED OF THE CALLER.  RETURN IS IN BASIC TO THE RETURN
057962,000993:                                                                                          	# ADDRESS WITH THE ABOVE TRANSFERS TO R,VN1-PIPTIME1-AND MPAC DONE
057963,000994: 

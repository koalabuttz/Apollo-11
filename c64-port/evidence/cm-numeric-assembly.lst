015552,002330: 42,3520           04161                           TC       ALMCYCLE                      	#  VERB.  ALARM AND RECYCLE.
015553,002331: 42,3521                        ENDHMSS            EQUALS                                 	#
015554,002332: 
015556,002334:                                                                                          	# MONITOR ALLOWS OTHER KEYBOARD ACTIVITY.  IT IS ENDED BY VERB TERMINATE,
015557,002335:                                                                                          	# VERB PROCEED WITHOUT DATA, VERB RESEQUENCE,
015558,002336:                                                                                          	# ANOTHER MONITOR, OR ANY NVSUB CALL THAT PASSES THE DSPLOCK (PROVIDED
015559,002337:                                                                                          	# THAT THE OPERATOR HAS SOMEHOW ALLOWED THE ENDING OF A MONITOR WHICH
015560,002338:                                                                                          	# HE HAS INITIATED THROUGH THE KEYBOARD).
015561,002339: 
015562,002340:                                                                                          	# MONITOR ACTION IS SUSPENDED, BUT NOT ENDED, BY ANY KEYBOARD ACTION,
015563,002341:                                                                                          	# EXCEPT ERROR LIGHT RESET.  IT BEGINS AGAIN WHEN KEY RELEASE IS PERFORMED.
015564,002342:                                                                                          	# MONITOR SAVES THE NOUN AND APPROPRIATE DISPLAY VERB IN MONSAVE.  IT SAVES
015565,002343:                                                                                          	# NOUNCADR IN MONSAVE1, IF NOUN = MACHINE CADR TO BE SPECIFIED.  BIT 15 OF
015566,002344:                                                                                          	# MONSAVE1 IS THE KILL MONITOR SIGNAL (KILLER BIT).  BIT 14 OF MONSAVE1
015567,002345:                                                                                          	# INDICATES THE CURRENT MONITOR WAS EXTERNALLY INITIATED (EXTERNAL
015568,002346:                                                                                          	# MONITOR BIT).  IT IS TURNED OFF BY RELDSP AND KILMONON.
015569,002347: 
015570,002348:                                                                                          	# MONSAVE INDICATES IF MONITOR IS ON (+=ON, +0=OFF)
015571,002349:                                                                                          	# IF MONSAVE IS +, MONITOR ENTERS NO REQUEST, BUT TURNS KILLER BIT OFF.
015572,002350:                                                                                          	# IF MONSAVE IS +0, MONITOR ENTERS REQUEST AND TURNS KILLER BIT OFF.
015573,002351: 
015574,002352:                                                                                          	# NVSUB (IF EXTERNAL MONITOR BIT IS OFF), VB=PROCEED WITHOUT DATA,
015575,002353:                                                                                          	# VB=RESEQUENCE, AND VB=TERMINATE TURN KILL MONITOR BIT ON.
015576,002354: 
015577,002355:                                                                                          	# IF KILLER BIT IS ON, MONREQ ENTERS NO FURTHER REQUESTS, ZEROS MONSAVE
015578,002356:                                                                                          	# AND MONSAVE1 (TURNING OFF KILLER BIT AND EXTERNAL MONITOR BIT).
015579,002357: 
015580,002358:                                                                                          	# MONITOR DOSENT TEST FOR MATBS SINCE NVSUB CAN HANDLE INTERNAL MATBS NOW
015581,002359: 

029027,000109: $P32-P33,_P72-P73.agc				        # pp. 649-683
029029,000002:                                                                                          	## Copyright:   Public domain.
029030,000003:                                                                                          	## Filename:    P32-P33_P72-P73.agc
029031,000004:                                                                                          	## Purpose:     Part of the source code for Colossus 2A, AKA Comanche 055.
029032,000005:                                                                                          	##              It is part of the source code for the Command Module's (CM)
029033,000006:                                                                                          	##              Apollo Guidance Computer (AGC), for Apollo 11.
029034,000007:                                                                                          	## Assembler:   yaYUL
029035,000008:                                                                                          	## Contact:     Ron Burkey <info@sandroid.org>.
029036,000009:                                                                                          	## Website:     www.ibiblio.org/apollo.
029037,000010:                                                                                          	## Pages:       649-683
029038,000011:                                                                                          	## Mod history: 2009-05-09 RSB  Adapted from the Luminary131/ file
029039,000012:                                                                                          	##                              P32-P35_P72-P75.agc and Comanche055 page 
029040,000013:                                                                                          	##                              images.
029041,000014:                                                                                          	##              2009-05-20 RSB  Corrected CSI/COM3 -> CSI/CDH3,
029042,000015:                                                                                          	##                              CSI/CDHI -> CSI/CDH1, CDHTAB -> CDHTAG,
029043,000016:                                                                                          	##                              changed a SETLOC from CSI/CDH to CSI/CDH1,
029044,000017:                                                                                          	##                              a SETLOC CSI/CDH1 to CSIPROG.
029045,000018:                                                                                          	##              2009-05-21 RSB  Changed a P32/P72D to P32/P72E in 
029046,000019:                                                                                          	##                              P32/P72D.  DP1/4TH changed to DP1/4 in 
029047,000020:                                                                                          	##                              CDHMVR.
029048,000021:                                                                                          	##              2016-12-10 RSB  All of the GOTOPOOH's should have been
029049,000022:                                                                                          	##                              GOTOPOOH, and I've changed them back.
029050,000023:                                                                                          	##              2016-12-11 RSB  Proofed comments with octopus/ProoferComments
029051,000024:                                                                                          	##                              and fixed the errors found.
029052,000025:                                                                                          	##              2017-01-28 RSB  WTIH -> WITH.
029053,000026:                                                                                          	##              2017-02-07 RSB  Comment-text corrections identified while 
029054,000027:                                                                                          	##                              proofing Artemis 72.
029055,000028:                                                                                          	##              2017-03-09 RSB  Comment-text fixes noted in proofing Luminary 116.
029056,000029:                                                                                          	##
029057,000030:                                                                                          	## This source code has been transcribed or otherwise adapted from digitized
029058,000031:                                                                                          	## images of a hardcopy from the MIT Museum.  The digitization was performed
029059,000032:                                                                                          	## by Paul Fjeld, and arranged for by Deborah Douglas of the Museum.  Many
029060,000033:                                                                                          	## thanks to both.  The images (with suitable reduction in storage size and
029061,000034:                                                                                          	## consequent reduction in image quality as well) are available online at
029062,000035:                                                                                          	## www.ibiblio.org/apollo.  If for some reason you find that the images are
029063,000036:                                                                                          	## illegible, contact me at info@sandroid.org about getting access to the 
029064,000037:                                                                                          	## (much) higher-quality images which Paul actually created.
029065,000038:                                                                                          	##
029066,000039:                                                                                          	## Notations on the hardcopy document read, in part:
029067,000040:                                                                                          	##
029068,000041:                                                                                          	##      Assemble revision 055 of AGC program Comanche by NASA
029069,000042:                                                                                          	##      2021113-051.  10:28 APR. 1, 1969  
029070,000043:                                                                                          	##
029071,000044:                                                                                          	##      This AGC program shall also be referred to as
029072,000045:                                                                                          	##                      Colossus 2A
029073,000046: 
029075,000048:                                                                                          	# COELLIPTIC SEQUENCE INITIATION (CSI) PROGRAMS (P32 AND P72)
029076,000049: 
029077,000050:                                                                                          	# MOD NO -1             LOG SECTION - P32-P35, P72-P75
029078,000051:                                                                                          	# MOD BY WHITE.P        DATE 1 JUNE 67
029079,000052: 
029080,000053:                                                                                          	# PURPOSE
029081,000054:                                                                                          	#       (1)     TO CALCULATE PARAMETERS ASSOCIATED WITH THE FOLLOWING
029082,000055:                                                                                          	#               CONCENTRIC FLIGHT PLAN MANEUVERS - THE CO-ELLIPTIC SEQUENCE
029083,000056:                                                                                          	#               INITIATION (CSI) MANEUVER AND THE CONSTANT DELTA ALTITUDE
029084,000057:                                                                                          	#               (CDH) MANEUVER.
029085,000058:                                                                                          	#       (2)     TO CALCULATE THESE PARAMETERS BASED UPON MANEUVER DATA
029086,000059:                                                                                          	#               APPROVED AND KEYED INTO THE DSKY BY THE ASTRONAUT.
029087,000060:                                                                                          	#       (3)     TO DISPLAY TO THE ASTRONAUT AND THE GROUND DEPENDENT VARIABLES
029088,000061:                                                                                          	#               ASSOCIATED WITH THE CONCENTRIC FLIGNT PLAN MANEUVERS FOR
029089,000062:                                                                                          	#               APPROVAL BY THE ASTRONAUT/GROUND.
029090,000063:                                                                                          	#       (4)     TO STORE THE CSI TARGET PARAMETERS FOR USE BY THE DESIRED
029091,000064:                                                                                          	#               THRUSTING PROGRAM.
029092,000065: 
029093,000066:                                                                                          	# ASSUMPTIONS
029094,000067:                                                                                          	#       (1)     AT A SELECTED TPI TIME THE LINE OF SIGHT BETWEEN THE ACTIVE
029095,000068:                                                                                          	#               AND PASSIVE VEHICLES IS SELECTED TO BE A PRESCRIBED ANGLE (E)
029096,000069:                                                                                          	#               FROM THE HORIZONTAL PLANE DEFINED BY THE ACTIVE VEHICLE
029097,000070:                                                                                          	#               POSITION.
029098,000071:                                                                                          	#       (2)     THE TIME BETWEEN CSI IGNITION AND CDH IGNITION MUST BE
029099,000072:                                                                                          	#               COMPUTED TO BE GREATER THAN 10 MINUTES FOR SUCCESSFUL
029100,000073:                                                                                          	#               COMPLETION OF THE PROGRAM.
029101,000074:                                                                                          	#       (3)     THE TIME BETWEEN CDH IGNITION AND TPI IGNITION MUST BE
029102,000075:                                                                                          	#               COMPUTED TO BE GREATER THAN 10 MINUTES FOR SUCCESSFUL
029103,000076:                                                                                          	#               COMPLETION OF THE PROGRAM.
029104,000077:                                                                                          	#       (4)     CDH DELTA V IS SELECTED TO MINIMIZE THE VARIATION OF THE
029105,000078:                                                                                          	#               ALTITUDE DIFFERENCE BETWEEN THE ORBITS.
029106,000079:                                                                                          	#       (5)     CSI BURN IS DEFINED SUCH THAT THE IMPULSIVE DELTA V IS IN THE
029107,000080:                                                                                          	#               HORIZONTAL PLANE DEFINED BY THE ACTIVE VEHICLE POSITION AT CSI
029108,000081:                                                                                          	#               IGNITION.
029109,000082:                                                                                          	#       (6)     THE PERICENTER ALTITUDE OF THE ORBIT FOLLOWING CSI AND CDH
029110,000083:                                                                                          	#               MUST BE GREATER THAN 35,000 FT (LUNAR ORBIT) OR 85 NM (EARTH
029111,000084:                                                                                          	#               ORBIT) FOR SUCCESSFUL COMPLETION OF THIS PROGRAM.
029112,000085:                                                                                          	#       (7)     THE CSI AND CDH MANEUVERS ARE ORIGINALLY ASSUMED TO BE
029113,000086:                                                                                          	#               PARALLEL TO THE PLANE OF THE CSM ORBIT.  HOWEVER CREW
029115,000088:                                                                                          	#               MODIFICATION OF DELTA V (LV) COMPONENTS MAY RESULT IN AN
029116,000089:                                                                                          	#               OUT-OF-PLANE CSI MANEUVER.
029117,000090:                                                                                          	#       (8)     STATE VECTOR UPDATES BY P27 ARE DISALLOWED DURING AUTOMATIC
029118,000091:                                                                                          	#               STATE VECTOR UPDATING INITIATED BY P20 (SEE ASSUMPTION 10).
029119,000092:                                                                                          	#       (9)     COMPUTED VARIABLES MAY BE STORED FOR LATER VERIFICATION BY
029120,000093:                                                                                          	#               THE GROUND.  THESE STORAGE CAPABILITIES ARE NORMALLY LIMITED
029121,000094:                                                                                          	#               ONLY TO THE PARAMETERS FOR ONE THRUSTING MANEUVER AT A TIME
029122,000095:                                                                                          	#               EXCEPT FOR CONCENTRIC FLIGHT PLAN MANEUVER SEQUENCES.
029123,000096:                                                                                          	#       (10)    THE RENDEZVOUS RADAR MAY OR MAY NOT BE USED TO UPDATE THE LM
029124,000097:                                                                                          	#               OR CSM STATE VECTORS FOR THIS PROGRAM.  IF RADAR USE IS
029125,000098:                                                                                          	#               DESIRED THE RADAR WAS TURNED ON AND LOCKED ON THE CSM BY
029126,000099:                                                                                          	#               PREVIOUS SELECTION OF P20.  RADAR SIGHTING MARKS WILL BE MADE
029127,000100:                                                                                          	#               AUTOMATICALLY APPROXIMATELY ONCE A MINUTE WHEN ENABLED BY THE
029128,000101:                                                                                          	#               TRACK AND UPDATE FLAGS (SEE P20).  THE RENDEZVOUS TRACKING
029129,000102:                                                                                          	#               MARK COUNTER IS ZEROED BY THE SELECTION OF P20 AND AFTER EACH
029130,000103:                                                                                          	#               THRUSTING MANEUVER.
029131,000104:                                                                                          	#       (11)    THE ISS NEED NOT BE ON TO COMPLETE THIS PROGRAM.
029132,000105:                                                                                          	#       (12)    THE OPERATION OF THE PROGRAM UTILIZES THE FOLLOWING FLAGS -
029133,000106: 
029134,000107:                                                                                          	#                       ACTIVE VEHICLE FLAG - DESIGNATES THE VEHICLE WHICH IS
029135,000108:                                                                                          	#                       DOING RENDEZVOUS THRUSTING MANEUVERS TO THE PROGRAM WHICH
029136,000109:                                                                                          	#                       CALCULATES THE MANEUVER PARAMETERS.  SET AT THE START OF
029137,000110:                                                                                          	#                       EACH RENDEZVOUS PRE-THRUSTING PROGRAM.
029138,000111: 
029139,000112:                                                                                          	#                       FINAL FLAG - SELECTS FINAL PROGRAM DISPLAYS AFTER CREW HAS
029140,000113:                                                                                          	#                       COMPLETED THE FINAL MANEUVER COMPUTATION AND DISPLAY
029141,000114:                                                                                          	#                       CYCLE.
029142,000115: 
029143,000116:                                                                                          	#                       EXTERNAL DELTA V STEERING FLAG - DESIGNATES THE TYPE OF
029144,000117:                                                                                          	#                       STEERING REQUIRED FOR EXECUTION OF THIS MANEUVER BY THE
029145,000118:                                                                                          	#                       THRUSTING PROGRAM SELECTED AFTER COMPLETION OF THIS
029146,000119:                                                                                          	#                       PROGRAM.
029147,000120: 
029148,000121:                                                                                          	#       (13)    IT IS NORMALLY REQUIRED THAT THE ISS BE ON FOR 1 HOUR PRIOR TO
029149,000122:                                                                                          	#               A THRUSTING MANEUVER.
029150,000123: 
029151,000124:                                                                                          	#       (14)    THIS PROGRAM IS SELECTED BY THE ASTRONAUT BY DSKY ENTRY -
029152,000125: 
029153,000126:                                                                                          	#                       P32 IF THIS VEHICLE IS ACTIVE VEHICLE.
029154,000127: 
029155,000128:                                                                                          	#                       P72 IF THIS VEHICLE IS PASSIVE VEHICLE.
029156,000129: 
029157,000130:                                                                                          	# INPUT
029158,000131:                                                                                          	#       (1)     TCSI            TIME OF THE CSI MANEUVER
029160,000133:                                                                                          	#       (2)     NN              NUMBER OF APSIDAL CROSSINGS THRU WHICH THE ACTIVE
029161,000134:                                                                                          	#                               VEHICLE ORBIT CAN BE ADVANCED TO OBTAIN THE CDH
029162,000135:                                                                                          	#                               MANEUVER POINT
029163,000136:                                                                                          	#       (3)     ELEV            DESIRED LOS ANGLE AT TPI
029164,000137:                                                                                          	#       (4)     TTPI            TIME OF THE TPI MANEUVER
029165,000138: 
029166,000139:                                                                                          	# OUTPUT
029167,000140:                                                                                          	#       (1)     TRKMKCNT        NUMBER OF MARKS
029168,000141:                                                                                          	#       (2)     TTOGO           TIME TO GO
029169,000142:                                                                                          	#       (3)     +MGA            MIDDLE GIMBAL ANGLE
029170,000143:                                                                                          	#       (4)     DIFFALT         DELTA ALTITUDE AT CDH
029171,000144:                                                                                          	#       (5)     T1TOT2          DELTA TIME FROM CSI TO CDH
029172,000145:                                                                                          	#       (6)     T2TOT3          DELTA TIME FROM CDH TO TPI
029173,000146:                                                                                          	#       (7)     DELVLVC         DELTA VELOCITY AT CSI - LOCAL VERTICAL COORDINATES
029174,000147:                                                                                          	#       (8)     DELVLVC         DELTA VELOCITY AT CDH - LOCAL VERTICAL COORDINATES
029175,000148: 
029176,000149:                                                                                          	# DOWNLINK
029177,000150:                                                                                          	#       (1)     TCSI            TIME OF THE CSI MANEUVER
029178,000151:                                                                                          	#       (2)     TCDH            TIME OF THE CDH MANEUVER
029179,000152:                                                                                          	#       (3)     TTPI            TIME OF THE TPI MANEUVER
029180,000153:                                                                                          	#       (4)     TIG             TIME OF THE CSI MANEUVER
029181,000154:                                                                                          	#       (5)     DELVEET1        DELTA VELOCITY AT CSI - REFERENCE COORDINATES
029182,000155:                                                                                          	#       (6)     DELVEET2        DELTA VELOCITY AT CDH - REFERENCE COORDINATES
029183,000156:                                                                                          	#       (7)     DIFFALT         DELTA ALTITUDE AT CDH
029184,000157:                                                                                          	#       (8)     NN              NUMBER OF APSIDAL CROSSINGS THRU WHICH THE ACTIVE
029185,000158:                                                                                          	#                               VEHICLE ORBIT CAN BE ADVANCED TO OBTAIN THE CDH
029186,000159:                                                                                          	#                               MANEUVER POINT
029187,000160:                                                                                          	#       (9)     ELEV            DESIRED LOS ANGLE AT TPI
029188,000161: 
029189,000162:                                                                                          	# COMMUNICATION TO THRUSTING PROGRAMS
029190,000163:                                                                                          	#       (1)     TIG             TIME OF THE CSI MANEUVER
029191,000164:                                                                                          	#       (2)     RTIG            POSITION OF ACTIVE VEHICLE AT CSI - BEFORE ROTATION
029192,000165:                                                                                          	#                               INTO PLANE OF PASSIVE VEHICLE
029193,000166:                                                                                          	#       (3)     VTIG            VELOCITY OF ACTIVE VEHICLE AT CSE - BEFORE ROTATION
029194,000167:                                                                                          	#                               INTO PLANE OF PASSIVE VEHICLE
029195,000168:                                                                                          	#       (4)     DELVSIN         DELTA VELOCITY AT CSI - REFERENCE COORDINATES
029196,000169:                                                                                          	#       (5)     DELVSAB         MAGNITUDE OF DELTA VELOCITY AT CSI
029197,000170:                                                                                          	#       (6)     XDELVFLG        SET TO INDICATE EXTERNAL DELTA V VG COMPUTATION
029198,000171: 

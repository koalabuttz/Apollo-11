001052,000906: 
001053,000907:                                                                                          	# 00110         NO MARK SINCE LAST MARK REJECT                  SXTMARK                                 ALARM
001054,000908:                                                                                          	# 00112         MARK NOT BEING ACCEPTED                         SXTMARK                                 ALARM
001055,000909:                                                                                          	# 00113         NO INBITS                                       SXTMARK                                 ALARM
001056,000910:                                                                                          	# 00114         MARK MADE BUT NOT DESIRED                       SXTMARK                                 ALARM

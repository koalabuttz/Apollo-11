048403,001087: 
048404,001088:                                                                                          	# SECTION  JETCALL  EXAMINES CONTENTS OF JET TIMES IN LIST, ESTABLISHES WTLST ENTRIES, AND EXECUTES CORRESPONDING
048405,001089:                                                                                          	# JET CODES.  A POSITIVE NZ NUMBER IN A TIME REGISTER INDICATES THAT A WTLST CALL IS TO BE MADE, AND ITS JET BITS
048406,001090:                                                                                          	# EXECUTED.  A +0 INDICATES THAT THE TIME INTERVAL DOES NOT APPLY, BUT THE CORRESPONDING JET BITS ARE TO BE
048407,001091:                                                                                          	# EXECUTED.  A NEG NUMBER INDICATES THAT THE TIME INTERVAL HAS BEEN PROCESSED.  IN EVENT OF +0 OR -1, THE 
048408,001092:                                                                                          	# SUBSEQUENT TIME REGISTER IS EXAMINED FOR POSSIBLE ACTION.  THUS JET BITS TO BE EXECUTED MAY COME FROM MORE
048409,001093:                                                                                          	# THAN ONE REGISTER.
048410,001094: 
048411,001095: 15,3610           35021        JETCALL1           CA       ZERO                          	#
048412,001096: 15,3611           55611                           TS       OUTTAG                        	#
048413,001097: 15,3612           55612                           TS       NUJET                         	#
048414,001098: 15,3613           55606                           TS       TBITS                         	#
048415,001099: 15,3614           53622                           DXCH     TON1                          	#
048416,001100: 15,3615           10000                           CCS      A                             	#
048417,001101: 15,3616           13633                           TCF      JETCALL2                      	# CALL WTLST
048418,001102: 15,3617           23612        JETCALL3           LXCH     NUJET                         	# WTLST ENTRIES COME HERE FROM JETCALL
048419,001103: 15,3620           45017                           CS       ONE                           	#
048420,001104: 15,3621           53606                           DXCH     TOFF                          	#
048421,001105: 15,3622           10000                           CCS      A                             	#
048422,001106: 15,3623           13633                           TCF      JETCALL2                      	# CALL WTLST
048423,001107: 15,3624           23612                           LXCH     NUJET                         	#
048424,001108: 15,3625           45017                           CS       ONE                           	#
048425,001109: 15,3626           53610                           DXCH     TON2                          	#
048426,001110: 15,3627           10000                           CCS      A                             	#
048427,001111: 15,3630           13633                           TCF      JETCALL2                      	# CALL WTLST
048428,001112: 15,3631           23612                           LXCH     NUJET                         	#
048429,001113: 15,3632           03642                           TC       JETACTN                       	# C(A) = +0
048430,001114: 15,3633           56001        JETCALL2           XCH      L                             	# SAVE JET BITS FOR AFTER WTLST CALL
048431,001115: 15,3634           27612                           ADS      NUJET                         	#
048432,001116: 15,3635           56001                           XCH      L                             	#
048433,001117: 15,3636           65017                           AD       ONE                           	# RESTORE FOR CCS
048434,001118: 15,3637           05245                           TC       WAITLIST                      	#
048435,001119: 15,3640  E6,1661                                  EBANK=   AOG                           	#
048436,001120: 15,3640           03650 32066                     2CADR    JETCALL                       	#
048437,001121: 
048438,001122: 15,3642           31612        JETACTN            CA       NUJET                         	# COME HERE WHEN DESIRED JET CODE IS KNOWN
048440,001124: 15,3643           00006                           EXTEND                                 	# NO NEED TO SAVE OLD CODES
048441,001125: 15,3644           01006                           WRITE    ROLLJETS                      	# SET RCHAN TO NEW BIT CONFIG.
048442,001126: 
048443,001127: 15,3645           11611                           CCS      OUTTAG                        	#
048444,001128: 15,3646           05324                           TC       TASKOVER                      	#
048445,001129: 15,3647           03705        ROLLDUMP           TC       CM/FDAIR                      	#
048446,001130: 
048447,001131:                                                                                          	# EDIT DUMP AT ABOVE LOCATION.
048448,001132: 
048449,001133:                                                                                          	# WAITLIST ENTRIES COME HERE.
048450,001134: 
048451,001135: 15,3650           35016        JETCALL            CAF      BIT2                          	# CM/DSTBY =103D BIT2
048452,001136: 15,3651           55611                           TS       OUTTAG                        	# SIGNIFY WTLST ENTRY
048453,001137: 15,3652           70102                           MASK     CM/FLAGS                      	# IS SYSTEM DISABLED  $
048454,001138: 15,3653           00006                           EXTEND                                 	#
048455,001139: 15,3654           13643                           BZF      JETACTN    +1                 	# YES, QUENCH ROLL JETS, IF ON AND EXIT.
048456,001140: 15,3655           22007                           ZL                                     	# NO, CONTINUE.
048457,001141: 15,3656           13617                           TCF      JETCALL3                      	# C(A) POS, C(L) = +0
048458,001142: 
048459,001143:                                                                                          	# DEAD ZONE ENTRIES COME HERE.
048460,001144: 
048461,001145: 15,3657           41700        DZCALL             CS       CMDAPMOD                      	# POSSIBLE VALUES OF CMDAPMOD: -1, +0, -0.
048462,001146: 15,3660           75017                           MASK     BIT1                          	#
048463,001147: 15,3661           54001                           TS       L                             	# C(L)=0 FOR -0; C(L)=1 FOR -1 OR +0.
048464,001148: 15,3662           50000                           INDEX    A                             	# ERASBLE ORDER:  ROLLTM,ROLLC,ROLLC +1.
048465,001149: 15,3663           31714                           CA       ROLLTM                        	# GET ROLL/180 OR ROLLC (/360).
048466,001150: 15,3664           50001                           INDEX    L                             	#
048467,001151: 15,3665           54000                           TS       A                             	# IF C(L)=1, STORE 'ROLLC' IN 'L'.
048468,001152: 15,3666           60001                           AD       L                             	# (BOTH MUST BE SCALED DEG/180)
048469,001153: 15,3667           02522                           TC       ANGOVCOR                      	# C(A)=ROLL/180 OR 2 ROLLC  .
048470,001154: 15,3670           55717                           TS       ROLLHOLD                      	# IF CMDAPMOD =-0, SAVE ROLL ANGLE,
048471,001155:                                                                                          	#       OTHERWISE, SAVE ROLL COMMAND.
048472,001156: 
048473,001157: 15,3671           35021                           CA       ZERO                          	# COME HERE IF IN DZ, AND CANCEL JETS.
048474,001158: 15,3672           00006                           EXTEND                                 	# INHINT NOT NEEDED HERE.
048475,001159: 15,3673           01006                           WRITE    ROLLJETS                      	# TURN OFF ALL ROLL JETS.
048476,001160: 15,3674           55567                           TS       VDT/180                       	# SET =0 TO SHOW IN DEAD ZONE.
048477,001161: 15,3675           55711        DZCALL1            TS       JETAG                         	# COME HERE WITH C(A)=0.
048478,001162: 15,3676           03647                           TC       ROLLDUMP                      	#
048479,001163: 
048481,001165:                                                                                          	# CM ENTRY FDAI DISPLAY
048482,001166: 
048483,001167:                                                                                          	# CALCULATE BY INTEGRATION THE ROLL ERROR BETWEEN THE 2 SEC CM/RCS UPDATES.  DISPLAY ATTITUDE ERRORS AS FOLLOWS:
048484,001168:                                                                                          	#       ATM DAP:        DISPLAY ONLY ROLL ATTITUDE ERROR.
048485,001169:                                                                                          	#       EXT ATM DAP:    PRESENT 3 ATTITUDE ERRORS RELATIVE TO THE APPROPRIATE BODY AXES EACH .1 SEC.
048486,001170:                                                                                          	#                               ROLL    ROLLC-ROLL
048487,001171:                                                                                          	#                               PITCH   ALFAC-ALFA
048488,001172:                                                                                          	#                               YAW     BETAC-BETA
048489,001173: 
048490,001174:                                                                                          	# DURING ENTRY, THE FDAI NEEDLES HAVE FULL SCALE OF 67.5 DEG IN ROLL AND 16.875 DEG IN PITCH AND YAW.
048491,001175:                                                                                          	# THE SUBROUTINE  NEEDLER  EXPECTS (ANGLE/180) AND SCALES TO 16.875 DEG FULL SCALE.
048492,001176: 
048493,001177:                                                                                          	# COME HERE EACH .1 SEC.  (CMDAPMOD=+1 COMES BELOW)
048494,001178: 15,3677           41705        CM/FDAI            CS       PHIDOT                        	# INTEGRATE ROLL ERROR 'TWEEN 2SEC UPDATES
048495,001179: 15,3700           00006                           EXTEND                                 	#
048496,001180: 15,3701           71506                           MP       CALFA                         	# FOR ASSUMED COORDINATION.
048497,001181: 15,3702           00006                           EXTEND                                 	#
048498,001182: 15,3703           75002                           MP       HALF                          	#
048499,001183: 15,3704           27713                           ADS      PAXERR1                       	# ROLL ERROR/360.  OVFL OK.
048500,001184: 
048501,001185:                                                                                          	# EDIT DUMP AT ABOVE LOCATION.
048502,001186: 15,3705           35002        CM/FDAIR           CA       HALF                          	#
048503,001187: 15,3706           00006                           EXTEND                                 	#
048504,001188: 15,3707           71713                           MP       PAXERR1                       	# FULL SCALE FOR FDAI (ROLL) IS 67.5 D
048505,001189: 15,3710           55476                           TS       PAXERR                        	# .25 (ROLL ERROR/180) FOR FDAI NEEDLE.
048506,001190: 
048507,001191:                                                                                          	# PROGRAM TO FILE BODY RATES FOR TM ON ONE PASS AND
048508,001192:                                                                                          	# TO UPDATE THE NEEDLE DISPLAY ON THE NEXT.
048509,001193:                                                                                          	# SYNCHRONIZATION WITH CM/RCS IS USED SO THAT THE TM
048510,001194:                                                                                          	# IS DONE WITH THE ROLL SYSTEM AND NEEDLES START ON
048511,001195:                                                                                          	# THE SUBSEQUENT PASS.
048512,001196: 
048513,001197: 15,3711           40305        CM/DUMPR           CS       SW/NDX                        	# COMBINED ALTERNATION SWITCH AND FILE
048514,001198: 15,3712           54305                           TS       SW/NDX                        	#
048515,001199: 15,3713           00006                           EXTEND                                 	# INDEX.
048516,001200: 15,3714           63720                           BZMF     CMTMFILE                      	# FILE STARTS WITH SW/NDX +1 AND GOES TO
048517,001201:                                                                                          	# ENDBUF.                       
048518,001202:                                                                                          	# INDEX IS POS FOR NEEDLES
048519,001203: 
048520,001204: 15,3715           04740                           TC       IBNKCALL                      	#
048521,001205: 15,3716           42420                           CADR     NEEDLER                       	#
048522,001206: 
048523,001207: 15,3717           03736                           TC       CM/END                        	#
048524,001208: 
048525,001209:                                                                                          	# INDEX IS NEG FOR TM FILE
048526,001210: 
048527,001211: 15,3720           66214        CMTMFILE           AD       THREE                         	#
048528,001212: 15,3721           00006                           EXTEND                                 	#
048529,001213: 15,3722           63726                           BZMF     SAVENDX                       	#
048530,001214: 
048532,001216: 15,3723           30025                           CA       TIME1                         	# INITIALIZE THE TM LIST IN UPBUFF.
048533,001217: 15,3724           54304                           TS       CMTMTIME                      	#
048534,001218: 15,3725           45025                           CS       THIRTEEN                      	# INITIALIZE COUNTER
048535,001219: 15,3726           54305        SAVENDX            TS       SW/NDX                        	# A NEGATIVE NUMBER.
048536,001220: 15,3727           00006                           EXTEND                                 	#
048537,001221: 15,3730           31702                           DCA      PREL                          	#
048538,001222: 15,3731           50305                           INDEX    SW/NDX                        	#
048539,001223: 15,3732           52324                           DXCH     ENDBUF     -1                 	#
048540,001224: 15,3733           31703                           CA       RREL                          	#
048541,001225: 15,3734           50305                           INDEX    SW/NDX                        	#
048542,001226: 15,3735           54325                           TS       ENDBUF     +1                 	#
048543,001227: 
048544,001228: 15,3736           31623        CM/END             CA       CM/SAVE                       	#
048545,001229: 15,3737           54021                           TS       SR                            	#
048546,001230:                                                                                          	# DOES NOT PROTECT TEMK, SQ IN SPSIN/COS
048547,001231: 
048548,001232: 15,3740           00006                           EXTEND                                 	#
048549,001233: 15,3741           33745                           DCA      T5IDLER2                      	#
048550,001234: 15,3742           53313                           DXCH     T5LOC                         	#
048551,001235: 15,3743           05333                           TC       RESUME                        	#
048552,001236: 
048553,001237: 15,3744     1312                                  EBANK=   T5LOC                         	#
048554,001238: 15,3744           03153 12062  T5IDLER2           2CADR    T5IDLOC                       	#
048555,001239: 
048556,001240:                                                                                          	# DEFINE THE FOLLOWING 17D REGISTERS IN UPBUFF TO BE
048557,001241:                                                                                          	# USED TO TELEMETER CM VEHICLE BODY RATE INFORMATION.
048558,001242:                                                                                          	# THE INFORMATION IS FILED EACH 0.2 SEC, GIVING 15D
048559,001243:                                                                                          	# DATA POINTS EACH 1 SEC.  TM LIST IS READ TWICE
048560,001244:                                                                                          	# EACH 2 SECONDS.
048561,001245: 
048562,001246:                                                                                          	# THE SEQUENCE IS:      SP TIME         INITIAL TIME
048563,001247:                                                                                          	#                       SWITCH          ALSO INDEX.
048564,001248:                                                                                          	#                       P               ROLL RATE
048565,001249:                                                                                          	#                       Q               PITCH RATE
048566,001250:                                                                                          	#                       R               YAW RATE
048567,001251:                                                                                          	#                       ETC.
048568,001252: 
048569,001253:                                                                                          	#CMTMTIME       =       UPBUFF
048570,001254:                                                                                          	#SW/NDX         =       UPBUFF +1
048571,001255:                                                                                          	#ENDBUF         =       UPBUFF +16D
048572,001256: 
048574,001258:                                                                                          	# SPACER
048575,001259: 
048576,001260:                                                                                          	# CONSTANTS USED IN THE ROLL CONTROL SYSTEM:    
048577,001261:                                                                                          	# CONSTANTS ARE THE FOLLOWING:  A = 9.1 DEG/SECSQ, VM = 20 DEG/SEC, T = 2 SEC, TCDU = .1 SEC,
048578,001262:                                                                                          	# XMIN = 4 DEG, VMIN = 2 DEG/SEC, K = .25, A1 = 4.55 DEG/SECSQ, VI = 1 DEG/SEC, INTERCEPT WITH DZ SIDE
048579,001263:                                                                                          	# XBUF = 4DEG
048580,001264: 
048581,001265: 15,3746           77464        -T-3               DEC      -203       B-14               	# CS
048582,001266: 15,3747           00012        VSQMIN             DEC      .61050061  E-3                	# VSQ MIN/4 A PI = 4/(4 (9.1) 180)
048583,001267: 15,3750     5033               2T/TCDU            =        OCT50                         	# T/TCDU EXP-14    TCDU = .1SEC
048584,001268: 15,3750           23617        180/8ATT           DEC      .61813187                     	# 180/(8 (9.1) 4)=(180/ATT)     EXP -3
048585,001269: 15,3751  15,3753               -VMT/180           =        -VM/360K                      	# = 20 (2) / 180
048586,001270: 15,3751     5045               2JETT              =        4SECS                         	# CS            2 (2) 100       INTEGER
048587,001271: 15,3751           01440        4JETT              DEC      800        B-14               	# CS            4 (2) 100       INTEGER
048588,001272: 15,3752           00266        XMIN/360           DEC      182        B-14               	# XMIN/360 = 4/ 360  EXP 14  = 182 INTEGER
048589,001273: 15,3753           70706        -VM/360K           DEC      -.22222222                    	# =-20/( 360 (.25))
048590,001274: 15,3754  15,3750               1/16A1             =        180/8ATT                      	#
048591,001275:                                                                                          	# 1/16A1   = 180/(16 A1 TT)
048592,001276:                                                                                          	#          = 180/(16 4.55 4)
048593,001277: 15,3754           00133        XS/360             DEC      91         B-14               	# = (XMIN +VI (T-1/K))/360 = 2/360 EXP 14
048594,001278: 15,3755  15,3754               BUFLIM             =        XS/360                        	# 4/(2 360)
048595,001279: 
048596,001280: 15,3755     5002               KTRCS              =        HALF                          	#    KT = (.25) 2 = .5
048597,001281: 
048598,001282: 
(End of include-file CM_ENTRY_DIGITAL_AUTOPILOT.agc, resuming MAIN.agc)

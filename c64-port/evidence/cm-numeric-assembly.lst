018161,000056: 22,2753           55605                           DMP      DDV*                          	#
018162,000057: 22,2754           05001                                    ANGLTIME                      	#
018163,000058: 22,2755           04771                                    ARATE,1                       	#
018164,000059: 22,2756           77661                           SR                                     	#
018165,000060: 22,2757           20606                                    5                             	#
018166,000061: 22,2760           27317                           STOVL    TM                            	#
018167,000062: 22,2761           03311                                    BRATE                         	#
018168,000063: 22,2762           77761                           VXSC                                   	#
018169,000064: 22,2763           05025                                    BIASCALE                      	#
018170,000065: 22,2764           03275                           STORE    BIASTEMP                      	# ATTITUDE ERROR BIAS TO PREVENT OVERSHOOT
018171,000066:                                                                                          	# IN SYSTEM
018172,000067: 22,2765           77614                           SETGO                                  	# STATE SWITCH CALCMAN2 (43D)
018173,000068: 22,2766           01035                                    CALCMAN2                      	# 0(OFF) = BYPASS STARTING PROCEDURE
018174,000069: 22,2767           45032                                    NEWANGL    +1                 	# 1(ON) = START MANEUVER
018175,000070: 
018176,000071: 
018177,000072: 22,2770           00044 15053  ARATE              2DEC     .0022222222                    	# = .05 DEG/SEC
018178,000073: 
018179,000074: 22,2772           00221 24255                     2DEC     .0088888889                    	# = .2 DEG/SEC
018180,000075: 
018181,000076: 22,2774           00554 02660                     2DEC     .0222222222                    	# = .5 DEG/SEC
018182,000077: 
018183,000078: 22,2776           02660 13301                     2DEC     .0888888889                    	# = 2 DEG/SEC                $22.5 DEG/SEC
018184,000079: 
018185,000080: 22,3000           00003 04000  ANGLTIME           2DEC     .000190735                    	# = 100B - 19
018186,000081: 
018187,000082:                                                                                          	# MANEUVER ANGLE TO MANEUVER TIME
018188,000083: 22,3002           03146 14632  QUADROT            2DEC     .1                            	# ROTATION MATRIX FROM S/C AXES TO CONTROL
018189,000084: 
018191,000086: 22,3004           00000 00000                     2DEC     0          B-28               	# AXES (X ROT = -7.25 DEG)
018192,000087: 
018193,000088: 22,3006           00000 00000                     2DEC     0          B-28               	#
018194,000089: 
018195,000090: 22,3010           00000 00000                     2DEC     0          B-28               	#
018196,000091: 
018197,000092: 22,3012           03131 11275                     2DEC     .099200                       	# =(.1)COS7.25
018198,000093: 
018199,000094: 22,3014           77461 47370                     2DEC     -.012620                      	# =-(.1)SIN7.25
018200,000095: 
018201,000096: 22,3016           00000 00000                     2DEC     0          B-28               	#
018202,000097: 
018203,000098: 22,3020           00316 30407                     2DEC     .012620                       	# (.1)SIN7.25
018204,000099: 
018205,000100: 22,3022           03131 11275                     2DEC     .099200                       	# (.1)COS7.25
018206,000101: 
018207,000102: 22,3024           00004 05253  BIASCALE           2DEC     .0002543132                    	# = (450/180)(1/0.6)(1/16384)
(End of include-file GIMBAL_LOCK_AVOIDANCE.agc, resuming MAIN.agc)

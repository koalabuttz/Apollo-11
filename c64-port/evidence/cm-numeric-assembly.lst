004965,003330: 
004966,003331:                                                                                          	# ENTRY RESTART PROTECTION STORAGE.  -KEEP TEMPS IN ORDER-      (12D)
004967,003332: E6,1541  E6,1770               TEMPROLL           EQUALS   GENRET                        	# B(1)TMP COPY CYCLE REGISTER
004968,003333: E6,1541  E6,1771               TEMPALFA           EQUALS   TEMPROLL   +1                 	# B(1)TMP COPY CYCLE REGISTER
004969,003334: E6,1541  E6,1772               TEMPBETA           EQUALS   TEMPALFA   +1                 	# B(1)TMP COPY CYCLE REGISTER
004970,003335: E6,1541  E6,1773               60GENRET           EQUALS   TEMPBETA   +1                 	# B(1)TMP QSAVE FOR S61.1 AND ENTRY.
004971,003336: E6,1541  E6,1774               S61DT              EQUALS   60GENRET   +1                 	# B(1)TMP VARIABLE DT FOR S61.1 RESTART.
004972,003337: 
004973,003338:                                                                                          	# ENTRY TM SHARING FOR ACCELERATION PROFILE.
004974,003339: E6,1541  E6,1533               XPIPBUF            EQUALS   ADOT                          	# B(1) PIPA BUFFER FOR TM DURING ENTRY.

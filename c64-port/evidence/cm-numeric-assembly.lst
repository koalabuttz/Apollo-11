020116,000070:                                                                                          	# DECIMAL DISPLAY OF LAT,LONG,ALT
020117,000071:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
020118,000072: 
020119,000073:                                                                                          	# AX0    2DEC   4.652459653 E-5   RADIANS       %68-69 CONSTANTS"
020120,000074: 
020121,000075:                                                                                          	# -AY0   2DEC   2.147535898 E-5   RADIANS
020122,000076: 
020123,000077:                                                                                          	# AZ0    2DEC   .7753206164       REVOLUTIONS
020124,000078:                                                                                          	# FOR LUNAR ORBITS 504LM VECTOR IS NEEDED
020125,000079: 
020126,000080:                                                                                          	# 504LM  2DEC   -2.700340600 E-5  RADIANS
020127,000081: 
020128,000082:                                                                                          	# 504LM _2 2DEC -7.514128400 E-4  RADIANS
020129,000083: 
020130,000084:                                                                                          	# 504LM _4 2DEC _2.553198641 E-4  RADIANS
020131,000085: 
020132,000086:                                                                                          	# NONE
020133,000087:                                                                                          	# DEBRIS
020134,000088: 
020136,000090:                                                                                          	# CENTRALS-A,Q,L
020137,000091:                                                                                          	# OTHER-THOSE USED BY THE ABOVE LISTED SUBROUTINES
020138,000092:                                                                                          	# SEE LEMPREC, LAT-LONG
020139,000093: 

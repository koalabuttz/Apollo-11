049967,000714:    6653           30001                           CA       1                             	# LIST
049968,000715:    6654           50116                           INDEX    ADDRWD                        	# ADD MODIFIER.
049969,000716:    6655           60000                           AD       0                             	#
049970,000717:    6656           54004                           TS       FBANK                         	# SELECT GOTO ADDRESS
049971,000718:    6657           75054                           MASK     LOW10                         	#
049972,000719:    6660           50000                           INDEX    A                             	#
049973,000720:    6661           32000                           CA       10000                         	#
049974,000721:    6662           54117                           TS       POLISH                        	#
049975,000722:    6663           16616                           TCF      GOTO       +1                 	# WITH ADDRESS IN A.
049976,000723: 
049977,000724:    6664           30165        SWBRANCH           CA       BANKSET                       	# SWITCH INSTRUCTIONS WHICH ELECT TO
049978,000725:    6665           54004                           TS       FBANK                         	# BRANCH COME HERE TO DO SO.
049979,000726:    6666           50164                           INDEX    LOC                           	#

018386,000178: 20,2135           65017                           AD       ONE                           	#
018387,000179: 20,2136           12141                           TCF      MANUCALL                      	#
018388,000180: 20,2137           65001                           AD       NEGMAX                        	#
018389,000181: 20,2140           40000                           COM                                    	#
018390,000182: 20,2141           05245        MANUCALL           TC       WAITLIST                      	#

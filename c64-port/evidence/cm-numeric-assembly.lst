000864,000718: 
000865,000719:                                                                                          	# -A-
000866,000720:                                                                                          	# OCTAL                 XXXXX                   SP      OCTAL
000867,000721: 
000868,000722:                                                                                          	# -B-                                                            -14
000869,000723:                                                                                          	# FRACTIONAL            .XXXXX                  SP      BIT 1 = 2    UNITS
000870,000724:                                                                                          	#                       (MAX .99996)
000871,000725: 
000872,000726:                                                                                          	# -C-
000873,000727:                                                                                          	# WHOLE                 XXXXX.                  SP      BIT 1 = 1 UNIT
000874,000728:                                                                                          	#                       (MAX 16383.)
000875,000729: 
000876,000730:                                                                                          	# -D-                                                                15
000877,000731:                                                                                          	# CDU DEGREES           XXX.XX DEGREES          SP      BIT 1 = 360/2   DEGREES
000878,000732:                                                                                          	#                       (MAX 359.99)                    (USES 15 BITS FOR MAGNI-
000879,000733:                                                                                          	#                                                       TUDE AND 2-S COMP.)
000880,000734: 
000881,000735:                                                                                          	# -E-                                                               14
000882,000736:                                                                                          	# ELEVATION DEGREES     XX.XXX DEGREES          SP      BIT 1 = 90/2   DEGREES
000883,000737:                                                                                          	#                       (MAX 89.999)
000884,000738: 

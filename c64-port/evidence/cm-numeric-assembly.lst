050715,001462: 
050716,001463:                                                                                          	# Page 1152
050717,001464:                                                                                          	# THE FOLLOWING SHORT SHIFT CODES REQUIRE NO ADDRESS WORD:
050718,001465:                                                                                          	#       1.      SR1 TO SR4      SCALAR SHIFT RIGHT.
050719,001466:                                                                                          	#       2.      SR1R TO SR4R    SCALAR SHIFT RIGHT AND ROUND.
050720,001467:                                                                                          	#       3.      SL1 TO SL4      SCALAR SHIFT LEFT.
050721,001468:                                                                                          	#       4.      SL1R TO SL4R    SCALAR SHIFT LEFT AND ROUND.
050722,001469:                                                                                          	#       5.      VSR1 TO VSR8    VECTOR SHIFT RIGHT (ALWAYS ROUNDS).
050723,001470:                                                                                          	#       6.      VSL1 TO VSL8    VECTOR SHIFT LEFT (NEVER ROUNDS).
050724,001471:                                                                                          	# THE FOLLOWING CODES REQUIRE AN ADDRESS WHICH MAY BE INDEXED:*
050725,001472:                                                                                          	#       1.      SR              SCALAR SHIFT RIGHT.
050726,001473:                                                                                          	#       2.      SRR             SCALAR SHIFT RIGHT AND ROUND.
050727,001474:                                                                                          	#       3.      SL              SCALAR SHIFT LEFT.
050728,001475:                                                                                          	#       4.      SLR             SCALAR SHIFT LEFT AND ROUND.
050729,001476:                                                                                          	#       5.      VSR             VECTOR SHIFT RIGHT.
050730,001477:                                                                                          	#       6.      VSL             VECTOR SHIFT LEFT.
050731,001478:                                                                                          	# * IF THE ADDRESS IS INDEXED, AND THE INDEX MODIFICATION RESULTS IN A NEGATIVE SHIFT COUNT, A SHIFT OF THE
050732,001479:                                                                                          	# ABSOLUTE VALUE OF THE COUNT IS DONE IN THE OPPOSITE DIRECTION.
050733,001480: 
050734,001481: 00,2017                                           BANK     00                            	#
050735,001482: 
050736,001483: 00,2017                                           COUNT    00/INTER                      	#
050737,001484: 
050738,001485: 00,2017           36211        SHORTT             CAF      SIX                           	# SCALAR SHORT SHIFTS COME HERE.  THE SHIFT
050739,001486: 00,2020           70020                           MASK     CYR                           	# COUNT-1 IS NOW IN BITS 2-3 OF CYR.  THE
050740,001487: 00,2021           54021                           TS       SR                            	# ROUNDING BIT IS IN BIT1 AT THIS POINT.
050741,001488: 
050742,001489: 00,2022           10020                           CCS      CYR                           	# SEE IF RIGHT OR LEFT SHIFT DESIRED.
050743,001490: 00,2023           12101                           TCF      TSSL                          	# SHIFT LEFT.
050744,001491: 
050745,001492: 00,2024           00024        SRDDV              DEC      20         B-14               	# MPTEMP SETTING FOR SR BEFORE DDV.
050746,001493: 
050747,001494: 00,2025           50021        TSSR               INDEX    SR                            	# GET SHIFTING BIT.
050748,001495: 00,2026           35002                           CAF      BIT14                         	#
050749,001496: 00,2027           54135                           TS       MPTEMP                        	#
050750,001497: 
050751,001498: 00,2030           10020                           CCS      CYR                           	# SEE IF A ROUND IS DESIRED.
050752,001499: 00,2031           02050        RIGHTR             TC       MPACSRND                      	# YES -- SHIFT RIGHT AND ROUND.
050753,001500: 00,2032           16027                           TCF      NEWMODE                       	# SET MODE TO DP (C(A) = 0).
050754,001501: 00,2033           30135        MPACSHR            CA       MPTEMP                        	# DO A TRIPLE PRECISION SHIFT RIGHT.
050755,001502: 00,2034           00006                           EXTEND                                 	#
050756,001503: 00,2035           70156                           MP       MPAC       +2                 	#
050757,001504: 00,2036           54156                 +3        TS       MPAC       +2                 	# (EXIT FROM SQRT AND ABVAL).
050758,001505: 00,2037           30135                           CA       MPTEMP                        	#
050759,001506: 00,2040           00006                           EXTEND                                 	#
050760,001507:                                                                                          	# Page 1153
050761,001508: 00,2041           70154                           MP       MPAC                          	# SHIFT MAJOR PART INTO A,L AND PLACE IN
050762,001509: 00,2042           52155                           DXCH     MPAC                          	# MPAC,+1.
050763,001510: 00,2043           30135                           CA       MPTEMP                        	#
050764,001511: 00,2044           00006                           EXTEND                                 	#
050765,001512: 00,2045           70001                           MP       L                             	# ORIGINAL C(MPAC +1).
050766,001513: 00,2046           20156                           DAS      MPAC       +1                 	# GUARANTEED NO OVERFLOW.
050767,001514: 00,2047           16030                           TCF      DANZIG                        	#
050768,001515: 
050769,001516:                                                                                          	# MPAC SHIFT RIGHT AND ROUND SUBROUTINES
050770,001517: 
050771,001518: 00,2050           30156        MPACSRND           CA       MPAC       +2                 	# WE HAVE TO DO ALL THREE MULTIPLIES SINCE
050772,001519: 00,2051           00006                           EXTEND                                 	# MPAC +1 AND MPAC +2 MIGHT HAVE SIGN
050773,001520: 00,2052           70135                           MP       MPTEMP                        	# DISAGREEMENT WITH A SHIFT RIGHT OF L.
050774,001521: 00,2053           56155                           XCH      MPAC       +1                 	#
050775,001522: 00,2054           00006                           EXTEND                                 	#
050776,001523: 00,2055           70135                           MP       MPTEMP                        	#
050777,001524: 00,2056           56155                           XCH      MPAC       +1                 	# TRIAL MINOR PART.
050778,001525: 00,2057           60001                           AD       L                             	#
050779,001526: 
050780,001527: 00,2060           60000        VSHR2              DOUBLE                                 	# (FINISH VECTOR COMPONENT SHIFT RIGHT
050781,001528: 00,2061           54156                           TS       MPAC       +2                 	# AND ROUND.)
050782,001529: 00,2062           12064                           TCF      +2                            	#
050783,001530: 00,2063           26155                           ADS      MPAC       +1                 	# GUARANTEED NO OVERFLOW.
050784,001531: 
050785,001532: 00,2064           35021                           CAF      ZERO                          	#
050786,001533: 00,2065           54156                           TS       MPAC       +2                 	#
050787,001534: 00,2066           56154                           XCH      MPAC                          	# SETTING TO ZERO SO FOLLOWING DAS WORKS.
050788,001535: 00,2067           00006                           EXTEND                                 	#
050789,001536: 00,2070           70135                           MP       MPTEMP                        	#
050790,001537: 00,2071           20155                           DAS      MPAC                          	# AGAIN NO OVERFLOW.
050791,001538: 00,2072           00002                           TC       Q                             	#
050792,001539: 
050793,001540: 00,2073           30135        VSHRRND            CA       MPTEMP                        	# ENTRY TO SHIFT RIGHT AND ROUND MPAC WHEN
050794,001541: 00,2074           00006                           EXTEND                                 	# MPAC CONTAINS A VECTOR COMPONENT.
050795,001542: 00,2075           70155                           MP       MPAC       +1                 	#
050796,001543: 00,2076           54155                           TS       MPAC       +1                 	#
050797,001544: 00,2077           56001                           XCH      L                             	#
050798,001545: 00,2100           12060                           TCF      VSHR2                         	# GO ADD ONE IF NECESSARY AND FINISH.
050799,001546: 
050800,001547:                                                                                          	# Page 1154
050801,001548:                                                                                          	# ROUTINE FOR SHORT SCALAR SHIFT LEFT (AND MAYBE ROUND).
050802,001549: 
050803,001550: 00,2101           30021        TSSL               CA       SR                            	# GET SHIFT COUNT FOR SR.
050804,001551: 00,2102           54135                 +1        TS       MPTEMP                        	#
050805,001552: 
050806,001553: 00,2103           00006                 +2        EXTEND                                 	# ENTRY HERE FROM SL FOR SCALARS.
050807,001554: 00,2104           30156                           DCA      MPAC       +1                 	# SHIFTING LEFT ONE PLACE AT A TIME IS
050808,001555: 00,2105           20156                           DAS      MPAC       +1                 	# FASTER THAN DOING THE WHOLE SHIFT WITH
050809,001556: 00,2106           60154                           AD       MPAC                          	# MULTIPLIES ASSUMING THAT FREQUENCY OF
050810,001557: 00,2107           60154                           AD       MPAC                          	# SHIFT COUNTS GOES DOWN RAPIDLY AS A
050811,001558: 00,2110           54154                           TS       MPAC                          	# FUNCTION OF THEIR MAGNITUDE.
050812,001559: 00,2111           12113                           TCF      +2                            	#
050813,001560: 00,2112           54121                           TS       OVFIND                        	# OVERFLOW.  (LEAVES OVERFLOW-CORRECTED
050814,001561:                                                                                          	# RESULT ANYWAY).
050815,001562: 00,2113           10135                           CCS      MPTEMP                        	# LOOP ON DECREMENTED SHIFT COUNT.
050816,001563: 00,2114           12102                           TCF      TSSL       +1                 	#
050817,001564: 
050818,001565: 00,2115           10020                           CCS      CYR                           	# SEE IF ROUND WANTED.
050819,001566: 00,2116           07105        ROUND              TC       ROUNDSUB                      	# YES -- ROUND AND EXIT.
050820,001567: 00,2117           16030                           TCF      DANZIG                        	# SL LEAVES A ZERO IN CYR FOR NO ROUND.
050821,001568: 00,2120           16030                           TCF      DANZIG                        	# NO -- EXIT IMMEDIATELY
050822,001569: 
050823,001570:                                                                                          	# Page 1155
050824,001571:                                                                                          	# VECTOR SHIFTING ROUTINES.
050825,001572: 
050826,001573: 00,2121           35023        SHORTV             CAF      LOW3                          	# SAVE 3 BIT SHIFT COUNT -- 1 WITHOUT
050827,001574: 00,2122           70020                           MASK     CYR                           	# EDITING CYR.
050828,001575: 00,2123           54135                           TS       MPTEMP                        	#
050829,001576: 00,2124           10020                           CCS      CYR                           	# SEE IF LEFT OR RIGHT SHIFT.
050830,001577: 00,2125           12145                           TCF      VSSL                          	# VECTOR SHIFT LEFT.
050831,001578: 00,2126           00176        OCT176             OCT      176                           	# USED IN PROCESSED SHIFTS WITH - COUNT.
050832,001579: 
050833,001580: 00,2127           50135        VSSR               INDEX    MPTEMP                        	# (ENTRY FROM SR).  PICK UP SHIFTING BIT.
050834,001581: 00,2130           35002                           CAF      BIT14                         	# MPTEMP CONTAINS THE SHIFT COUNT - 1.
050835,001582: 00,2131           54135                           TS       MPTEMP                        	#
050836,001583: 00,2132           02073                           TC       VSHRRND                       	# SHIFT X COMPONENT.
050837,001584: 
050838,001585: 00,2133           52155                           DXCH     MPAC                          	# SWAP X AND Y COMPONENTS.
050839,001586: 00,2134           52160                           DXCH     MPAC       +3                 	#
050840,001587: 00,2135           52155                           DXCH     MPAC                          	#
050841,001588: 00,2136           02073                           TC       VSHRRND                       	# SHIFT Y COMPONENT.
050842,001589: 
050843,001590: 00,2137           52155                           DXCH     MPAC                          	# SWAP Y AND Z COMPONENTS.
050844,001591: 00,2140           52162                           DXCH     MPAC       +5                 	#
050845,001592: 00,2141           52155                           DXCH     MPAC                          	#
050846,001593: 00,2142           02073                           TC       VSHRRND                       	# SHIFT Z COMPONENT.
050847,001594: 
050848,001595: 00,2143           17367                           TCF      VROTATEX                      	# RESTORE COMPONENTS TO PROPER PLACES.
050849,001596: 
050850,001597:                                                                                          	# Page 1156
050851,001598:                                                                                          	# VECTOR SHIFT LEFT -- DONE ONE PLACE AT A TIME.
050852,001599: 
050853,001600: 00,2144           54135                 -1        TS       MPTEMP                        	# SHIFTING LOOP.
050854,001601: 
050855,001602: 00,2145           00006        VSSL               EXTEND                                 	#
050856,001603: 00,2146           30155                           DCA      MPAC                          	#
050857,001604: 00,2147           20155                           DAS      MPAC                          	#
050858,001605: 00,2150           00006                           EXTEND                                 	#
050859,001606: 00,2151           12153                           BZF      +2                            	#
050860,001607: 00,2152           06766                           TC       OVERFLOW                      	#
050861,001608: 
050862,001609: 00,2153           00006                           EXTEND                                 	#
050863,001610: 00,2154           30160                           DCA      MPAC       +3                 	#
050864,001611: 00,2155           20160                           DAS      MPAC       +3                 	#
050865,001612: 00,2156           00006                           EXTEND                                 	#
050866,001613: 00,2157           12161                           BZF      +2                            	#
050867,001614: 00,2160           06763                           TC       OVERFLWY                      	#
050868,001615: 
050869,001616: 00,2161           00006                           EXTEND                                 	#
050870,001617: 00,2162           30162                           DCA      MPAC       +5                 	#
050871,001618: 00,2163           20162                           DAS      MPAC       +5                 	#
050872,001619: 00,2164           00006                           EXTEND                                 	#
050873,001620: 00,2165           12167                           BZF      +2                            	#
050874,001621: 00,2166           06760                           TC       OVERFLWZ                      	#
050875,001622: 
050876,001623: 00,2167           10135                           CCS      MPTEMP                        	# LOOP ON DECREMENTED SHIFT COUNTER.
050877,001624: 00,2170           12144                           TCF      VSSL       -1                 	#
050878,001625: 00,2171           16030                           TCF      DANZIG                        	# EXIT.
050879,001626: 
050880,001627:                                                                                          	# Page 1157
050881,001628:                                                                                          	# TSLC -- TRIPLE SHIFT LEFT AND COUNT.  SHIFTS MPAC LEFT UNTIL GREATER THAN .5 IN MAGNITUDE, LEAVING
050882,001629:                                                                                          	# THE COMPLEMENT OF THE NUMBER OF SHIFTS REQUIRED IN X.
050883,001630: 
050884,001631: 00,2172           54135        TSLC2              TS       MPTEMP                        	# START BY ZEROING SHIFT COUNT (IN A NOW).
050885,001632: 00,2173           06672                           TC       BRANCH                        	# EXIT WITH NO SHIFTING IF ARGUMENT ZERO.
050886,001633: 00,2174           12176                           TCF      +2                            	#
050887,001634: 00,2175           12212                           TCF      ENDTSLC                       	# STORES ZERO SHIFT COUNT IN THIS CASE.
050888,001635: 
050889,001636: 00,2176           07226                           TC       TPAGREE                       	# MAY CAUSE UPSHIFT OF ONE EXTRA PLACE.
050890,001637: 
050891,001638: 00,2177           30154                           CA       MPAC                          	# BEGIN NORMALIZATION LOOP.
050892,001639: 00,2200           12207                           TCF      TSLCTEST                      	#
050893,001640: 
050894,001641: 00,2201           24135        TSLCLOOP           INCR     MPTEMP                        	# INCREMENT SHIFT COUNTER.
050895,001642: 00,2202           00006                           EXTEND                                 	#
050896,001643: 00,2203           30156                           DCA      MPAC       +1                 	#
050897,001644: 00,2204           20156                           DAS      MPAC       +1                 	#
050898,001645: 00,2205           60154                           AD       MPAC                          	#
050899,001646: 00,2206           26154                           ADS      MPAC                          	#
050900,001647: 00,2207           60000        TSLCTEST           DOUBLE                                 	# SEE IF (ANOTHER) SHIFT IS REQUIRED
050901,001648: 00,2210           54000                           OVSK                                   	#
050902,001649: 00,2211           12201                           TCF      TSLCLOOP                      	# YES -- INCREMENT COUNT AND SHIFT AGAIN.
050903,001650: 
050904,001651: 00,2212           40135        ENDTSLC            CS       MPTEMP                        	#
050905,001652: 00,2213           16572                           TCF      STORE1                        	# STORE SHIFT COUNT AND RETURN TO DANZIG.
050906,001653: 
050907,001654:                                                                                          	# Page 1158
050908,001655:                                                                                          	# THE FOLLOWING ROUTINE PROCESSES THE GENERAL SHIFT INSTRUCTIONS SR, SRR, SL, AND SLR.
050909,001656:                                                                                          	# THE GIVEN ADDRESS IS DECODED AS FOLLOWS:
050910,001657:                                                                                          	#       BITS 1-7        SHIFT COUNT (SUBADDRESS) LESS THAN 125 DECIMAL.
050911,001658:                                                                                          	#       BIT 8           PSEUDO SIGN BIT (DETECTS CHANGE IN SIGN IN INDEXED SHIFTS).
050912,001659:                                                                                          	#       BIT 9           0 FOR LEFT SHIFT, AND 1 FOR RIGHT SHIFT.
050913,001660:                                                                                          	#       BIT 10          1 FOR TERMINAL ROUND ON SCALAR SHIFTS, 0 OTHERWISE
050914,001661:                                                                                          	#       BITS 11-13      0.
050915,001662:                                                                                          	#       BIT 14          1.
050916,001663:                                                                                          	#       BIT 15          0.
050917,001664:                                                                                          	# THE ABOVE ENCODING IS DONE BY THE YUL SYSTEM.
050918,001665: 
050919,001666: 00,2214           70116        GENSHIFT           MASK     ADDRWD                        	# GET SHIFT COUNT, TESTING FOR ZERO.
050920,001667: 00,2215           10000                           CCS      A                             	# (ARRIVES WITH C(A) = LOW7).
050921,001668: 00,2216           12224                           TCF      GENSHFT2                      	# IF NON-ZERO, PROCEED WITH DECREMENTED CT
050922,001669: 
050923,001670: 00,2217           35006                           CAF      BIT10                         	# ZERO SHIFT COUNT.  NO SHIFTS NEEDED BUT
050924,001671: 00,2220           70116                           MASK     ADDRWD                        	# WE MIGHT HAVE TO ROUND MPAC ON SLR AND
050925,001672: 00,2221           10000                           CCS      A                             	# SRR (SCALAR ONLY).
050926,001673: 00,2222           07105                           TC       ROUNDSUB                      	#
050927,001674: 00,2223           16030                           TCF      DANZIG                        	#
050928,001675: 
050929,001676: 00,2224           54135        GENSHFT2           TS       MPTEMP                        	# DECREMENTED SHIFT COUNT TO MPTEMP.
050930,001677: 00,2225           35010                           CAF      BIT8                          	# TEST MEANING OF LOW SEVEN BIT COUNT IN
050931,001678: 00,2226           00006                           EXTEND                                 	# MPTEMP NOW.
050932,001679: 00,2227           70116                           MP       ADDRWD                        	#
050933,001680: 00,2230           76214                           MASK     LOW2                          	# JUMPS ON SHIFT DIRECTION (BIT8) AND
050934,001681: 00,2231           50000                           INDEX    A                             	#
050935,001682: 00,2232           12233                           TCF      +1                            	# ORIGINAL SHIFT DIRECTION (BIT 9)
050936,001683: 00,2233           12332                           TCF      RIGHT-                        	# NEGATIVE SHIFT COUNT FOR SL OR SLR.
050937,001684: 00,2234           12342                           TCF      LEFT                          	# SL OR SLR.
050938,001685: 00,2235           12336                           TCF      LEFT-                         	# NEGATIVE SHIFT COUNT WITH SR OR SRR.
050939,001686: 
050940,001687:                                                                                          	# Page 1159
050941,001688:                                                                                          	# GENERAL SHIFT RIGHT
050942,001689: 
050943,001690: 00,2236           10163        RIGHT              CCS      MODE                          	# SET IF VECTOR OR SCALAR.
050944,001691: 00,2237           12277                           TCF      GENSCR                        	#
050945,001692: 00,2240           12277                           TCF      GENSCR                        	#
050946,001693: 
050947,001694: 00,2241           30135                           CA       MPTEMP                        	# SEE IF SHIFT COUNT LESS THAN 14D.
050948,001695: 00,2242           63730        VRIGHT2            AD       NEG12                         	#
050949,001696: 00,2243           00006                           EXTEND                                 	#
050950,001697: 00,2244           62127                           BZMF     VSSR                          	# IF SO, BRANCH AND SHIFT IMMEDIATELY.
050951,001698: 
050952,001699: 00,2245           67716                           AD       NEGONE                        	# IF NOT, REDUCE MPTEMP BY A TOTAL OF 14.
050953,001700: 00,2246           54135                           TS       MPTEMP                        	# AND DO A SHIFT RIGHT AND ROUND BY 14.
050954,001701: 00,2247           35021                           CAF      ZERO                          	# THE ROUND AT THIS STAGE MAY INTRODUCE A
050955,001702: 00,2250           54001                           TS       L                             	# ONE BIT ERROR IN A SHIFT RIGHT 15D.
050956,001703: 00,2251           56154                           XCH      MPAC                          	#
050957,001704: 00,2252           56155                           XCH      MPAC       +1                 	#
050958,001705: 00,2253           02272                           TC       SETROUND                      	# X COMPONENT NOW SHIFTED, SO MAKE UP THE
050959,001706: 00,2254           20155                           DAS      MPAC                          	# ROUNDING QUANTITY (0 IN A AND 0 OR +-1
050960,001707:                                                                                          	# IN L).
050961,001708: 00,2255           56157                           XCH      MPAC       +3                 	# REPEAT THE ABOVE PROCESS FOR Y AND Z/
050962,001709: 00,2256           56160                           XCH      MPAC       +4                 	#
050963,001710: 00,2257           02272                           TC       SETROUND                      	#
050964,001711: 00,2260           20160                           DAS      MPAC       +3                 	# NO OVERFLOW ON THESE ADDS.
050965,001712: 
050966,001713: 00,2261           56161                           XCH      MPAC       +5                 	#
050967,001714: 00,2262           56162                           XCH      MPAC       +6                 	#
050968,001715: 00,2263           02272                           TC       SETROUND                      	#
050969,001716: 00,2264           20162                           DAS      MPAC       +5                 	#
050970,001717: 
050971,001718: 00,2265           10135                           CCS      MPTEMP                        	# SEE IF DONE, DOING FINAL DECREMENT.
050972,001719: 00,2266           54135                           TS       MPTEMP                        	#
050973,001720: 00,2267           12242                           TCF      VRIGHT2                       	#
050974,001721: 00,2270           04604        BIASLO             DEC      .2974      B-1                	# SQRT CONSTANT
050975,001722: 
050976,001723: 00,2271           16030                           TCF      DANZIG                        	#
050977,001724: 
050978,001725: 00,2272           60000        SETROUND           DOUBLE                                 	# MAKES UP ROUNDING QUANTITY FROM ARRIVING
050979,001726: 00,2273           54156                           TS       MPAC       +2                 	# C(A).  L IS ZERO INITIALLY.
050980,001727: 00,2274           35021                           CAF      ZERO                          	#
050981,001728: 00,2275           56001                           XCH      L                             	#
050982,001729: 00,2276           00002                           TC       Q                             	# RETURN AND DO THE DAS, RESETTING L TO 0.
050983,001730: 
050984,001731:                                                                                          	# Page 1160
050985,001732:                                                                                          	# PROCESS SR AND SRR FOR SCALARS.
050986,001733: 
050987,001734: 00,2277           30135        GENSCR             CA       MPTEMP                        	# SEE IF THE ORIGINAL SHIFT COUNT WAS LESS
050988,001735: 00,2300           63730                 +1        AD       NEG12                         	# THAN 14D.
050989,001736: 00,2301           00006                           EXTEND                                 	#
050990,001737: 00,2302           62322                           BZMF     DOSSHFT                       	# DO THE SHIFT IMMEDIATELY IF SO.
050991,001738: 
050992,001739: 00,2303           67716                 +4        AD       NEGONE                        	# IF NOT, DECREMENT SHIFT COUNT BY 14D AND
050993,001740: 00,2304           54135                           TS       MPTEMP                        	# SHIFT MPAC RIGHT 14 PLACES.
050994,001741: 00,2305           35021                           CAF      ZERO                          	#
050995,001742: 00,2306           56154                           XCH      MPAC                          	#
050996,001743: 00,2307           56155                           XCH      MPAC       +1                 	#
050997,001744: 00,2310           54156                           TS       MPAC       +2                 	#
050998,001745: 00,2311           10135                           CCS      MPTEMP                        	# SEE IF FINISHED, DO FINAL DECREMENT.
050999,001746: 00,2312           54135                           TS       MPTEMP                        	#
051000,001747: 00,2313           02300                           TC       GENSCR     +1                 	#
051001,001748: 00,2314           22650        SLOPEHI            DEC      .5884                         	# SQRT CONSTANT.
051002,001749: 00,2315           35006                           CAF      BIT10                         	# FINISHED WITH SHIFT.  SEE IF ROUND
051003,001750: 00,2316           70116                           MASK     ADDRWD                        	# WANTED.
051004,001751: 00,2317           10000                           CCS      A                             	#
051005,001752: 00,2320           07105                           TC       ROUNDSUB                      	#
051006,001753: 00,2321           16030                           TCF      DANZIG                        	# DO SO AND/OR EXIT.
051007,001754: 
051008,001755: 00,2322           50135        DOSSHFT            INDEX    MPTEMP                        	# PICK UP SHIFTING BIT.
051009,001756: 00,2323           35002                           CAF      BIT14                         	#
051010,001757: 00,2324           54135                           TS       MPTEMP                        	#
051011,001758: 00,2325           35006                           CAF      BIT10                         	# SEE IF TERMINAL ROUND DESIRED.
051012,001759: 00,2326           70116                           MASK     ADDRWD                        	#
051013,001760: 00,2327           10000                           CCS      A                             	#
051014,001761: 00,2330           12031                           TCF      RIGHTR                        	# YES.
051015,001762: 00,2331           12033                           TCF      MPACSHR                       	# JUST SHIFT RIGHT.
051016,001763: 
051017,001764:                                                                                          	# Page 1161
051018,001765:                                                                                          	# PROCESS THE RIGHT- (SL(R) WITH A NEGATIVE COUNT), LEFT-, AND LEFT OPTIONS.
051019,001766: 
051020,001767: 00,2332           40135        RIGHT-             CS       MPTEMP                        	# GET ABSOLUTE VALUE - 1 OF SHIFT COUNT
051021,001768: 00,2333           62126                           AD       OCT176                        	# UNDERSTANDING THAT BIT8 (PSEUDO-SIGN)
051022,001769: 00,2334           54135                           TS       MPTEMP                        	# WAS 1 INITIALLY.
051023,001770: 00,2335           12236                           TCF      RIGHT                         	# DO NORMAL SHIFT RIGHT.
051024,001771: 
051025,001772: 00,2336           42126        LEFT-              CS       OCT176                        	# SAME PROLOGUE TO LEFT FOR INDEXED RIGHT
051026,001773: 00,2337           60135                           AD       MPTEMP                        	# SHIFT WHOSE NET SHIFT COUNT IS NEGATIVE
051027,001774: 00,2340           40000                           COM                                    	#
051028,001775: 00,2341           54135                           TS       MPTEMP                        	#
051029,001776: 
051030,001777: 00,2342           10163        LEFT               CCS      MODE                          	# SINCE LEFT SHIFTING IS DONE ONE PLACE AT
051031,001778: 00,2343           12346                           TCF      GENSCL                        	# A TIME, NO COMPARISON WITH 14 NEED BE
051032,001779: 00,2344           12346                           TCF      GENSCL                        	# DONE.  FOR SCALARS, SEE IF TERMINAL ROUND
051033,001780: 00,2345           12145                           TCF      VSSL                          	# DESIRED.  FOR VECTORS, SHIFT IMMEDIATELY.
051034,001781: 
051035,001782: 00,2346           40116        GENSCL             CS       ADDRWD                        	# PUT ROUNDING BIT (BIT 10 OF ADDRWD) INTO
051036,001783: 00,2347           00006                           EXTEND                                 	# BIT 15 OF CYR WHERE THE ROUNDING BIT OF
051037,001784: 00,2350           75012                           MP       BIT6                          	# A SHORT SHIFT LEFT WOULD BE
051038,001785: 00,2351           54020                           TS       CYR                           	#
051039,001786: 00,2352           12103                           TCF      TSSL       +2                 	# DO THE SHIFT.
051040,001787: 
051041,001788:                                                                                          	# Page 1162
051042,001789:                                                                                          	# SCALAR DIVISION INSTRUCTIONS, DDV AND BDDV, ARE EXECUTED HERE.  AT THIS POINT, THE DIVIDEND IS IN MPAC
051043,001790:                                                                                          	# AND THE DIVISOR IS IN BUF.
051044,001791: 
051045,001792: 00,2353           45017        DDV/BDDV           CS       ONE                           	# INITIALIZATION
051046,001793: 00,2354           54136                           TS       DVSIGN                        	# +-1 FOR POSITIVE QUOTIENT -- -0 FOR NEG.
051047,001794: 00,2355           54137                           TS       DVNORMCT                      	# DIVIDEND NORMALIZATION COUNT.
051048,001795: 00,2356           54140                           TS       MAXDVSW                       	# NEAR-ONE DIVIDE FLAG.
051049,001796: 
051050,001797: 00,2357           10130                           CCS      BUF                           	# FORCE BUF POSITIVE WITH THE MAJOR PART
051051,001798: 00,2360           12516                           TCF      BUFPOS                        	# NON-ZERO.
051052,001799: 00,2361           12363                           TCF      +2                            	#
051053,001800: 00,2362           12531                           TCF      BUFNEG                        	#
051054,001801: 
051055,001802: 00,2363           54156        BUFZERO            TS       MPAC       +2                 	# ZERO THIS.
051056,001803: 00,2364           07226                           TC       TPAGREE                       	# FORCE SIGN AGREEMENT BEFORE OVERFLOW
051057,001804: 
051058,001805: 00,2365           10154                           CCS      MPAC                          	# TEST TO SEE IF MPAC NON-ZERO.  (TOO BIG)
051059,001806: 00,2366           12414                           TCF      OVF+                          	# MAJOR PART OF DIVIDEND IS POSITIVE NON-0
051060,001807: 00,2367           12371                           TCF      +2                            	#
051061,001808: 00,2370           12413                           TCF      OVF+       -1                 	# MAJOR PART OF DIVIDEND IS NEG. NON-ZERO
051062,001809: 
051063,001810: 00,2371           56131                           XCH      BUF        +1                 	# SHIFT DIVIDEND AND DIVISOR LEFT 14
051064,001811: 00,2372           56130                           XCH      BUF                           	#
051065,001812: 00,2373           56155                           XCH      MPAC       +1                 	#
051066,001813: 00,2374           56154                           XCH      MPAC                          	#
051067,001814: 00,2375           10130                           CCS      BUF                           	# TRY AGAIN ON FORMER MINOR PART.
051068,001815: 00,2376           12422                           TCF      BUF+                          	#
051069,001816: 00,2377           12401                           TCF      +2                            	# OVERFLOW ON ZERO DIVISOR.
051070,001817: 00,2400           12416                           TCF      BUF-                          	#
051071,001818: 
051072,001819: 00,2401           40154                           CS       MPAC                          	# SIGN OF MPAC DETERMINES SIGN OF RESULT.
051073,001820: 00,2402           00006        SGNDVOVF           EXTEND                                 	#
051074,001821: 00,2403           62405                           BZMF     +2                            	#
051075,001822: 00,2404           24136                           INCR     DVSIGN                        	# NEGMAX IN MPAC PERHAPS.
051076,001823: 00,2405           34777        DVOVF              CAF      POSMAX                        	# ON DIVISION OVERFLOW OF ANY SORT, SET
051077,001824: 00,2406           54154                           TS       MPAC                          	# SET DP MPAC TO +-POSMAX.
051078,001825: 00,2407           02630                           TC       FINALDV    +3                 	#
051079,001826: 00,2410           35017                           CAF      ONE                           	# SET OVERFLOW INDICATOR AND EXIT.
051080,001827: 00,2411           54121                           TS       OVFIND                        	#
051081,001828: 00,2412           06030                           TC       DANZIG                        	#
051082,001829: 
051083,001830: 00,2413           24136                 -1        INCR     DVSIGN                        	#
051084,001831: 00,2414           40131        OVF+               CS       BUF        +1                 	# LOAD LOWER ORDER PART OF DIVISOR.
051085,001832: 00,2415           12402                           TCF      SGNDVOVF                      	# GET SIGN OF RESULT.
051086,001833: 
051087,001834: 00,2416           00006        BUF-               EXTEND                                 	# IF BUF IS NEGATIVE, COMPLEMENT IT AND
051088,001835: 00,2417           40131                           DCS      BUF                           	# MAINTAIN DVSIGN FOR FINAL QUOTIENT SIGN.
051089,001836: 00,2420           52131                           DXCH     BUF                           	#
051090,001837: 00,2421           24136                           INCR     DVSIGN                        	# NOW -0.
051091,001838: 
051092,001839:                                                                                          	# Page 1163
051093,001840: 00,2422           10154        BUF+               CCS      MPAC                          	# FORCE MPAC POSITIVE, CHECKING FOR ZERO
051094,001841: 00,2423           12437                           TCF      MPAC+                         	# DIVIDEND IN THE PROCESS.
051095,001842: 00,2424           12426                           TCF      +2                            	#
051096,001843: 00,2425           12433                           TCF      MPAC-                         	#
051097,001844: 00,2426           10155                           CCS      MPAC       +1                 	#
051098,001845: 00,2427           12437                           TCF      MPAC+                         	#
051099,001846: 00,2430           16030                           TCF      DANZIG                        	# EXIT IMMEDIATELY ON ZERO DIVIDEND.
051100,001847: 00,2431           12433                           TCF      MPAC-                         	#
051101,001848: 00,2432           16030                           TCF      DANZIG                        	#
051102,001849: 
051103,001850: 00,2433           00006        MPAC-              EXTEND                                 	# FORCE MPAC POSITIVE AS BUF IN BUF-.
051104,001851: 00,2434           40155                           DCS      MPAC                          	#
051105,001852: 00,2435           52155                           DXCH     MPAC                          	#
051106,001853: 00,2436           24136                           INCR     DVSIGN                        	# NOW +1 OR -0.
051107,001854: 
051108,001855:                                                                                          	# Page 1164
051109,001856: 00,2437           40154        MPAC+              CS       MPAC                          	# CHECK FOR DIVISION OVERFLOW.  IF THE
051110,001857: 00,2440           67716                           AD       NEGONE                        	# MAJOR PART OF THE DIVIDEND IS LESS THAN
051111,001858: 00,2441           60130                           AD       BUF                           	# THE MAJOR PART OF THE DIVISOR BY AT
051112,001859: 00,2442           10000                           CCS      A                             	# LEAST TWO, WE CAN PROCEED IMMEDIATELY
051113,001860: 00,2443           12505                           TCF      DVNORM                        	# WITHOUT NORMALIZATION PRODUCING A DVMAX.
051114,001861: 00,2444           60001        -1/2+2             OCT      60001                         	# USED IN SQRTSUB.
051115,001862: 
051116,001863: 00,2445           12446                           TCF      +1                            	# IF THE ABOVE DOES NOT HOLD, FORCE SIGN
051117,001864: 00,2446           35002                           CAF      HALF                          	# AGREEMENT IN NUMERATOR AND DENOMINATOR
051118,001865: 00,2447           60000                           DOUBLE                                 	# TO FACILITATE OVERFLOW AND NEAR-ONE
051119,001866: 00,2450           60155                           AD       MPAC       +1                 	# CHECKING.
051120,001867: 00,2451           54155                           TS       MPAC       +1                 	#
051121,001868: 00,2452           35021                           CAF      ZERO                          	#
051122,001869: 00,2453           64777                           AD       POSMAX                        	#
051123,001870: 00,2454           26154                           ADS      MPAC                          	#
051124,001871: 
051125,001872: 00,2455           35002                           CAF      HALF                          	# SAME FOR BUF.
051126,001873: 00,2456           60000                           DOUBLE                                 	#
051127,001874: 00,2457           60131                           AD       BUF        +1                 	#
051128,001875: 00,2460           54131                           TS       BUF        +1                 	#
051129,001876: 00,2461           35021                           CAF      ZERO                          	#
051130,001877: 00,2462           64777                           AD       POSMAX                        	#
051131,001878: 00,2463           26130                           ADS      BUF                           	#
051132,001879: 
051133,001880: 00,2464           40154                           CS       MPAC                          	# CHECK MAGNITUDE OF SIGN-CORRECTED
051134,001881: 00,2465           60130                           AD       BUF                           	# OPERANDS.
051135,001882: 00,2466           10000                           CCS      A                             	#
051136,001883: 00,2467           12505                           TCF      DVNORM                        	# DIVIDE OK -- WILL NOT BECOME MAXOV CASE.
051137,001884: 00,2470           00133        LBUF2              ADRES    BUF2                          	#
051138,001885: 00,2471           12405                           TCF      DVOVF                         	# DIVISOR NOT LESS THAN DIVIDEND -- OVF.
051139,001886: 
051140,001887: 00,2472           54140                           TS       MAXDVSW                       	# IF THE MAJOR PARTS OF THE DIVIDEND AND
051141,001888: 00,2473           40155                           CS       MPAC       +1                 	# DIVISOR ARE EQUAL, A SPECIAL APPROXIMA-
051142,001889: 00,2474           60131                           AD       BUF        +1                 	# TION IS USED (PROVIDED THE DIVISION IS
051143,001890: 00,2475           00006                           EXTEND                                 	# POSSIBLE, OF COURSE).
051144,001891: 00,2476           62405                           BZMF     DVOVF                         	#
051145,001892: 00,2477           12505                           TCF      DVNORM                        	# IF NO OVERFLOW.
051146,001893: 
051147,001894:                                                                                          	# Page 1165
051148,001895: 00,2500           00006        BUFNORM            EXTEND                                 	# ADD -1 TO AUGMENT SHIFT COUNT AND SHIFT
051149,001896: 00,2501           24137                           AUG      DVNORMCT                      	# LEFT ONE PLACE.
051150,001897: 00,2502           00006                           EXTEND                                 	#
051151,001898: 00,2503           30131                           DCA      BUF                           	#
051152,001899: 00,2504           20131                           DAS      BUF                           	#
051153,001900: 
051154,001901: 00,2505           30130        DVNORM             CA       BUF                           	# SEE IF DIVISOR NORMALIZED YET.
051155,001902: 00,2506           60000                           DOUBLE                                 	#
051156,001903: 00,2507           54000                           OVSK                                   	#
051157,001904: 00,2510           12500                           TCF      BUFNORM                       	# NO -- SHIFT LEFT ONE AND TRY AGAIN.
051158,001905: 
051159,001906: 00,2511           52155                           DXCH     MPAC                          	# CALL DIVIDEND NORMALIZATION SEQUENCE
051160,001907: 00,2512           50137                           INDEX    DVNORMCT                      	# PRIOR TO DOING THE DIVIDE.
051161,001908: 00,2513           02565                           TC       MAXTEST                       	#
051162,001909: 
051163,001910: 00,2514           54156                           TS       MPAC       +2                 	# RETURNS WITH DIVISION DONE AND C(A) = 0.
051164,001911: 00,2515           16030                           TCF      DANZIG                        	#
051165,001912: 
051166,001913: 00,2516           10000        BUFPOS             CCS      A                             	#
051167,001914: 00,2517           12422                           TCF      BUF+                          	# TO BUF+ IF BUF IS GREATER THAN +1.
051168,001915: 
051169,001916: 00,2520           40131                           CS       BUF        +1                 	# IF BUF IS +1, FORCING SIGN AGREEMENT
051170,001917: 00,2521           00006                           EXTEND                                 	# MAY CAUSE BUF TO BECOME ZERO.
051171,001918: 00,2522           62422                           BZMF     BUF+                          	# BRANCH IF SIGNS AGREE.
051172,001919: 
051173,001920: 00,2523           35002                           CA       HALF                          	# SIGNS DISAGREE.  FORCE AGREEMENT.
051174,001921: 00,2524           60000                 +6        DOUBLE                                 	#
051175,001922: 00,2525           26131                           ADS      BUF        +1                 	#
051176,001923: 00,2526           35021                           CA       ZERO                          	#
051177,001924: 00,2527           54130                           TS       BUF                           	#
051178,001925: 00,2530           12363                           TCF      BUFZERO                       	#
051179,001926: 
051180,001927: 00,2531           10000        BUFNEG             CCS      A                             	#
051181,001928: 00,2532           12416                           TCF      BUF-                          	# TO BUF- IF BUF IS LESS THAN -1.
051182,001929: 
051183,001930: 00,2533           30131                           CA       BUF        +1                 	# IF BUF IS -1, FORCING SIGN AGREEMENT
051184,001931: 00,2534           00006                           EXTEND                                 	# MAY CAUSE BUF TO BECOME ZERO.
051185,001932: 00,2535           62416                           BZMF     BUF-                          	# BRANCH IF SIGNS AGREE.
051186,001933: 
051187,001934: 00,2536           45002                           CS       HALF                          	# SIGNS DISAGREE.  FORCE AGREEMENT.
051188,001935: 00,2537           12524                           TCF      BUFPOS     +6                 	#
051189,001936: 
051190,001937:                                                                                          	# Page 1166
051191,001938:                                                                                          	# THE FOLLOWING ARE PROLOGUES TO SHIFT THE DIVIDEND ARRIVING IN A AND L BEFORE THE DIVIDE.
051192,001939: 
051193,001940: 00,2540           22021                 -21D      LXCH     SR                            	# SPECIAL PROLOGUE FOR UNIT WHEN THE
051194,001941: 00,2541           00006                           EXTEND                                 	# LENGTH OF THE ARGUMENT WAS NOT LESS THAN
051195,001942: 00,2542           75002                           MP       HALF                          	# .5.  IN THIS CASE, EACH COMPONENT MUST BE
051196,001943: 00,2543           56001                           XCH      L                             	# SHIFTED RIGHT ONE TO PRODUCE A HALF-UNIT
051197,001944: 00,2544           60021                           AD       SR                            	# VECTOR.
051198,001945: 00,2545           56001                           XCH      L                             	#
051199,001946: 00,2546           12571                           TCF      GENDDV     +1                 	# WITH DP DIVIDEND IN A,L.
051200,001947: 
051201,001948: 00,2547           20001                           DDOUBL                                 	# PROLOGUE WHICH NORMALIZES THE DIVIDEND
051202,001949: 00,2550           20001                           DDOUBL                                 	# WHEN IT IS KNOWN THAT NO DIVISION
051203,001950: 00,2551           20001                           DDOUBL                                 	# OVERFLOW WILL OCCUR.
051204,001951: 00,2552           20001                           DDOUBL                                 	#
051205,001952: 00,2553           20001                           DDOUBL                                 	#
051206,001953: 00,2554           20001                           DDOUBL                                 	#
051207,001954: 00,2555           20001                           DDOUBL                                 	#
051208,001955: 00,2556           20001                           DDOUBL                                 	#
051209,001956: 00,2557           20001                           DDOUBL                                 	#
051210,001957: 00,2560           20001                           DDOUBL                                 	#
051211,001958: 00,2561           20001                           DDOUBL                                 	#
051212,001959: 00,2562           20001                           DDOUBL                                 	#
051213,001960: 00,2563           20001                           DDOUBL                                 	#
051214,001961: 00,2564           52155                           DXCH     MPAC                          	#
051215,001962: 
051216,001963: 00,2565           10140        MAXTEST            CCS      MAXDVSW                       	# 0 IF MAJORS MIGHT BE =, -1 OTHERWISE.
051217,001964: 00,2566           06552        BIASHI             DEC      .4192      B-1                	# SQRT CONSTANTS.
051218,001965: 
051219,001966: 00,2567           12642                           TCF      MAXDV                         	# CHECK TO SEE IF THEY ARE NOW EQUAL.
051220,001967: 
051221,001968:                                                                                          	# Page 1167
051222,001969:                                                                                          	# THE FOLLOWING IS A GENERAL PURPOSE DOUBLE PRECISION DIVISION ROUTINE.  IT DIVIDES MPAC BY BUF AND LEAVES
051223,001970:                                                                                          	# THE RESULT IN MPAC.  THE FOLLOWING CONDITIONS MUST BE SATISFIED:
051224,001971: 
051225,001972:                                                                                          	#       1.      THE DIVISOR (BUF) MUST BE POSITIVE AND NOT LESS THAN .5.
051226,001973: 
051227,001974:                                                                                          	#       2.      THE DIVIDEND (MPAC) MUST BE POSITIVE WITH THE MAJOR PART OF MPAC STRICTLY LESS THAN THAT OF BUF
051228,001975:                                                                                          	#               (A SPECIAL APPROXIMATION, MAXDV, IS USED WHEN THE MAJOR PARTS ARE EQUAL).
051229,001976: 
051230,001977:                                                                                          	# UNDERSTANDING THAT A/B = Q + S(R/B) WHERE S = 2(-14) AND Q AND R ARE QUOTIENT AND REMAINDER, RESPEC-
051231,001978:                                                                                          	# TIVELY, THE FOLLOWING APPROXIMATION IS OBTAINED BY MULTIPLYING ABOVE AND BELOW BY C - SD AND NEGLECTING TERMS OF
051232,001979:                                                                                          	# ORDER S-SQUARED (POSSIBLY INTRODUCING ERROR INTO THE LOW TWO BITS OF THE RESULT).  SIGN AGREEMENT IS UNNECESSARY.
051233,001980: 
051234,001981:                                                                                          	#       A + SB .      (R - CD)                                             A + SB
051235,001982:                                                                                          	#       ------ = Q + S(------) WHERE Q AND R ARE QUOTIENT AND REMAINDER OF ------ RESPECTIVELY.
051236,001983:                                                                                          	#       C + SD        (  C   }                                                C
051237,001984: 
051238,001985: 00,2570           52155        GENDDV             DXCH     MPAC                          	# WE NEED A AND B ONLY FOR FIRST DV.
051239,001986: 00,2571           00006                 +1        EXTEND                                 	# (SPECIAL UNIT PROLOGUE ENTERS HERE).
051240,001987: 00,2572           10130                           DV       BUF                           	# A NOW CONTAINS Q AND L, R.
051241,001988: 00,2573           52155                           DXCH     MPAC                          	#
051242,001989: 
051243,001990: 00,2574           40154                           CS       MPAC                          	# FORM DIVIDEND FOR MINOR PART OF RESULT.
051244,001991: 00,2575           00006                           EXTEND                                 	#
051245,001992: 00,2576           70131                           MP       BUF        +1                 	#
051246,001993: 00,2577           60155                           AD       MPAC       +1                 	# OVERFLOW AT THIS POINT IS POSITIVE SINCE
051247,001994: 00,2600           54000                           OVSK                                   	# R IS POSITIVE IN EVERY CASE.
051248,001995: 00,2601           12606                           TCF      +5                            	#
051249,001996: 
051250,001997: 00,2602           00006                           EXTEND                                 	# OVERFLOW CAN BE REMOVED BY SUBTRACTING C
051251,001998: 00,2603           60130                           SU       BUF                           	# (BUF) ONCE SINCE R IS ALWAYS LESS THAN C
051252,001999: 00,2604           24154                           INCR     MPAC                          	# IN THIS CASE.  INCR COMPENSATES SUBTRACT.
051253,002000: 00,2605           12610                           TCF      +DOWN                         	# (SINCE C(A) IS STILL POSITIVE).
051254,002001: 
051255,002002: 00,2606           00006                 +5        EXTEND                                 	# C(A) CAN BE MADE LESS THAN C IN MAGNI-
051256,002003: 00,2607           62620                           BZMF     -UP                           	# TUDE BY DIMINISHING IT BY C (SINCE C IS
051257,002004:                                                                                          	# NOT LESS THAN .5) UNLESS C(A) = 0.
051258,002005: 
051259,002006:                                                                                          	# Page 1168
051260,002007: 00,2610           00006        +DOWN              EXTEND                                 	#
051261,002008: 00,2611           60130                           SU       BUF                           	# IF POSITIVE, REDUCE ONLY IF NECESSARY
051262,002009: 00,2612           00006                           EXTEND                                 	# SINCE THE COMPENSATING INCR MIGHT CAUSE
051263,002010: 00,2613           12616                           BZF      +3                            	# OVERFLOW.
051264,002011: 00,2614           00006                           EXTEND                                 	# DON'T SUBTRACT UNLESS RESULT IS POSITIVE
051265,002012: 00,2615           62624                           BZMF     ENDMAXDV                      	# OR ZERO.
051266,002013: 
051267,002014: 00,2616           24154                 +3        INCR     MPAC                          	# KEEP SUBTRACT HERE AND COMPENSATE.
051268,002015: 00,2617           12625                           TCF      FINALDV                       	#
051269,002016: 
051270,002017: 00,2620           00006        -UP                EXTEND                                 	# IF ZERO, SET MINOR PART OF RESULT TO
051271,002018: 00,2621           12630                           BZF      FINALDV    +3                 	# ZERO.
051272,002019: 
051273,002020: 00,2622           00006                           EXTEND                                 	# IF NEGATIVE, ADD C TO A, SUBTRACTING ONE
051274,002021: 00,2623           26154                           DIM      MPAC                          	# TO COMPENSATE.  DIM IS OK HERE SINCE THE
051275,002022: 00,2624           60130        ENDMAXDV           AD       BUF                           	# MAJOR PART NEVER GOES NEGATIVE.
051276,002023: 
051277,002024:                                                                                          	# Page 1169
051278,002025: 00,2625           22007        FINALDV            ZL                                     	# DO DV TO OBTAIN MINOR PART OF RESULT.
051279,002026: 00,2626           00006                           EXTEND                                 	#
051280,002027: 00,2627           10130                           DV       BUF                           	#
051281,002028: 00,2630           54155                 +3        TS       MPAC       +1                 	#
051282,002029: 
051283,002030: 00,2631           10136                           CCS      DVSIGN                        	# LEAVE RESULT POSITIVE UNLESS C(DVSIGN).
051284,002031: 00,2632           00002                           TC       Q                             	#
051285,002032: 00,2633           00002                           TC       Q                             	#
051286,002033: 00,2634           00002                           TC       Q                             	#
051287,002034: 
051288,002035: 00,2635           00006                           EXTEND                                 	#
051289,002036: 00,2636           40155                           DCS      MPAC                          	#
051290,002037: 00,2637           52155                           DXCH     MPAC                          	#
051291,002038: 00,2640           35021                           CAF      ZERO                          	# SO WE ALWAYS RETURN WITH C(A) = 0.
051292,002039: 00,2641           00002                           TC       Q                             	#
051293,002040: 
051294,002041:                                                                                          	# Page 1170
051295,002042:                                                                                          	# IF THE MAJOR PARTS OF THE DIVISOR AND DIVIDEND ARE EQUAL, BUT THE MINOR PARTS ARE SUCH THAT THE
051296,002043:                                                                                          	# DIVIDEND IS STRICTLY LESS THAN THE DIVISOR IN MAGNITUDE, THE FOLLOWING APPROXIMATION IS USED.  THE ASSUMPTIONS
051297,002044:                                                                                          	# ARE THE SAME AS THE GENERAL ROUTINE WITH THE ADDITION THAT SIGN AGREEMENT IS NECESSARY (B, C, & D POSITIVE).
051298,002045: 
051299,002046:                                                                                          	#       C + SB .          (C + B - D)
051300,002047:                                                                                          	#       ------ = 37777 + S(---------)
051301,002048:                                                                                          	#       C + SD            (    C    )
051302,002049: 
051303,002050:                                                                                          	# THE DIVISION MAY BE PERFORMED IMMEDIATELY SINCE B IS STRICTLY LESS THAN D AND C IS NOT LESS THAN .5.
051304,002051: 
051305,002052: 00,2642           40154        MAXDV              CS       MPAC                          	# SEE IF MAXDV CASE STILL HOLDS AFTER
051306,002053: 00,2643           60130                           AD       BUF                           	# NORMALIZATION.
051307,002054: 00,2644           00006                           EXTEND                                 	#
051308,002055: 00,2645           12647                           BZF      +2                            	#
051309,002056: 00,2646           12570                           TCF      GENDDV                        	# MPAC NOW LESS THAN BUFF -- DIVIDE AS USUAL.
051310,002057: 
051311,002058: 00,2647           34777                 +2        CAF      POSMAX                        	# SET MAJOR PART OF RESULT.
051312,002059: 00,2650           54154                           TS       MPAC                          	#
051313,002060: 
051314,002061: 00,2651           40131                           CS       BUF        +1                 	# FORM DIVIDEND OF MINOR PART OF RESULT.
051315,002062: 00,2652           60155                           AD       MPAC       +1                 	#
051316,002063: 00,2653           12624                           TCF      ENDMAXDV                      	# GO ADD C AND DO DIVIDE, ATTACHING SIGN
051317,002064:                                                                                          	# BEFORE EXITING.
051318,002065: 
051319,002066:                                                                                          	# Page 1171
051320,002067:                                                                                          	# VECTOR DIVIDED BY SCALAR, V/SC, IS EXECUTED HERE.  THE VECTOR IS NOW IN MPAC WITH SCALAR IN BUF.
051321,002068: 
051322,002069: 00,2654           45017        V/SC2              CS       ONE                           	# INITIALIZE DIVIDEND NORMALIZATION COUNT
051323,002070: 00,2655           54137                           TS       DVNORMCT                      	# AND DIVISION SIGN REGISTER.
051324,002071: 00,2656           54127                           TS       VBUF       +5                 	#
051325,002072: 
051326,002073: 00,2657           03010                           TC       VECAGREE                      	# FORCE SIGN AGREEMENT IN VECTOR
051327,002074: 
051328,002075: 00,2660           52131                           DXCH     BUF                           	#
051329,002076: 00,2661           07513                           TC       ALSIGNAG                      	# SIGN AGREE BUF
051330,002077: 00,2662           52131                           DXCH     BUF                           	#
051331,002078: 00,2663           10130                           CCS      BUF                           	# FORCE DIVISOR POSITIVE WITH MAJOR PART
051332,002079: 00,2664           12721                           TCF      /BUF+                         	# NON-ZERO (IF POSSIBLE).
051333,002080: 00,2665           12667                           TCF      +2                            	#
051334,002081: 00,2666           12715                           TCF      /BUF-                         	#
051335,002082: 
051336,002083: 00,2667           56131                           XCH      BUF        +1                 	# SHIFT VECTOR AND SCALAR LEFT 14.
051337,002084: 00,2670           56130                           XCH      BUF                           	#

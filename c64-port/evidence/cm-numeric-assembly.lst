064857,000172: 00,3747           54061                           TS       WAITEXIT                      	#
064858,000173: 
064859,000174: 00,3750           30004                           CA       FBANK                         	#
064860,000175: 00,3751           60070                           AD       RUPTREG1                      	# STORE BBANK FOR TASK CALL
064861,000176: 00,3752           54001                           TS       L                             	#
064862,000177: 
064863,000178: 00,3753           33767                           CAF      WAKECAD                       	# STORE CADR FOR TASK CALL
064864,000179: 00,3754           15255                           TCF      DLY2       -1                 	# DLY IS IN WAITLIST ROUTINE
064865,000180: 
064866,000181: 00,3755           04711        TCGETCAD           TC       MAKECADR                      	# GET CALLERS FCADR
064867,000182: 
064868,000183: 00,3756           50070                           INDEX    RUPTREG1                      	#
064869,000184: 00,3757           55141                           TS       DELAYLOC                      	# SAVE DELAY CADRS
064870,000185: 
064871,000186: 00,3760           05175                           TC       JOBSLEEP                      	#
064872,000187: 
064873,000188: 00,3761           35021        WAKER              CAF      ZERO                          	#
064874,000189: 00,3762           50006                           INDEX    BBANK                         	#
064875,000190: 00,3763           57141                           XCH      DELAYLOC                      	# MAKE DELAYLOC AVAILABLE
064877,000192: 00,3764           05201                           TC       JOBWAKE                       	#
064878,000193: 
064879,000194: 00,3765           05324                           TC       TASKOVER                      	#
064880,000195: 
064881,000196: 00,3766           03753        TCSLEEP            GENADR   TCGETCAD   -2                 	#
064882,000197: 00,3767           03761        WAKECAD            GENADR   WAKER                         	#
064883,000198: 
064885,000200:                                                                                          	# GENTRAN, A BLOCK TRANSFER ROUTINE.
064886,000201:                                                                                          	# WRITTEN BY D. EYLES
064887,000202:                                                                                          	# MOD 1 BY KERNAN                               UTILITYM REV 17 11/18/67
064888,000203:                                                                                          	# MOD 2 BY SCHULENBERG  (REMOVE RELINT)  SKIPPER REV 4 2/28/68
064889,000204: 
064890,000205:                                                                                          	# THIS ROUTINE IS USEFULL FOR TRANSFERING N CONSECUTIVE ERASABLE OR FIXED QUANTITIES TO SOME OTHER N
064891,000206:                                                                                          	# CONSECUTIVE ERASABLE LOCATIONS.  IF BOTH BLOCKS OF DATA ARE IN SWITCHABLE EBANKS, THEY MUST BE IN THE SAME ONE.
064892,000207: 
064893,000208:                                                                                          	# GENTRAN IS CALLABLE IN A JOB AS WELL AS A RUPT.  THE CALLING SEQUENCE IS:
064894,000209:                                                                                          	#       I       CA      N-1             # OF QUANTITIES MINUS ONE.
064895,000210:                                                                                          	#       I +1    TC      GENTRAN         IN FIXED-FIXED.
064896,000211:                                                                                          	#       I +2    ADRES   L               STARTING ADRES OF DATA TO BE MOVED.
064897,000212:                                                                                          	#       I +3    ADRES   M               STARTING ADRES OF DUPLICATION BLOCK.
064898,000213:                                                                                          	#       I +4                            RETURNS HERE.
064899,000214: 
064900,000215:                                                                                          	# GENTRAN TAKES 25 MCT'S (300 MICROSECONDS) PER ITEM + 5 MCT'S (60 MICS) FOR ENTERING AND EXITING.
064901,000216:                                                                                          	# A, L AND ITEMP1 ARE NOT PRESERVED.
064902,000217: 
064903,000218:    5606                                           BLOCK    02                            	#
064904,000219:    4000                                           SETLOC   FFTAG4                        	#
064905,000220:    4000                                           BANK                                   	#
064906,000221: 
064907,000222:    5606     0061                                  EBANK=   ITEMP1                        	#
064908,000223: 
064909,000224:    5606                                           COUNT*   $$/TRAN                       	#
064910,000225: 
064911,000226:    5606           00004        GENTRAN            INHINT                                 	#
064912,000227:    5607           54061                           TS       ITEMP1                        	# SAVE N-1.
064913,000228:    5610           50002                           INDEX    Q                             	# C(Q) = ADRES L.
064914,000229:    5611           60000                           AD       0                             	# ADRES (L + N - 1).
064915,000230:    5612           50000                           INDEX    A                             	#
064916,000231:    5613           30000                           CA       0                             	# C(ABOVE).
064917,000232:    5614           54001                           TS       L                             	# SAVE DATA.
064918,000233:    5615           30061                           CA       ITEMP1                        	#
064919,000234:    5616           50002                           INDEX    Q                             	#
064920,000235:    5617           60001                           AD       1                             	# ADRES (M + N - 1).
064921,000236:    5620           50000                           INDEX    A                             	#
064922,000237:    5621           22000                           LXCH     0                             	# STUFF IT.
064923,000238:    5622           10061                           CCS      ITEMP1                        	# LOOP UNTIL N-1 = 0.
064924,000239:    5623           15607                           TCF      GENTRAN    +1                 	#
064925,000240:    5624           16710                           TCF      Q+2                           	# RETURN TO CALLER.
064926,000241: 
064928,000243:                                                                                          	# B5OFF         ZERO BIT 5 OF EXTVBACT, WHICH IS SET BY TESTXACT.
064929,000244:                                                                                          	# MAY BE USED AS NEEDED BY ANY EXTENDED VERB WHICH HAS DONE TESTXACT
064930,000245: 
064931,000246:    5625                                           COUNT*   $$/EXTVB                      	#
064932,000247: 
064933,000248:    5625           45013        B5OFF              CS       BIT5                          	#
064934,000249:    5626           71044                           MASK     EXTVBACT                      	#
064935,000250:    5627           55044                           TS       EXTVBACT                      	#
064936,000251:    5630           05217                           TC       ENDOFJOB                      	#
064937,000252: 
064939,000254:                                                                                          	# SUBROUTINES TO TURN OFF AND TURN ON TRACKER FAIL LIGHT.
064940,000255: 
064941,000256:    5631           00004        TRFAILOF           INHINT                                 	#
064942,000257:    5632           47704                           CS       OCT40200                      	# TURN OFF TRACKER LIGHT
064943,000258:    5633           71036                           MASK     DSPTAB     +11D               	#
064944,000259:    5634           65001                           AD       BIT15                         	#
064945,000260:    5635           55036                           TS       DSPTAB     +11D               	#
064946,000261:    5636           41331                           CS       OPTMODES                      	# TO INSURE THAT OCDU FAIL WILL GO ON
064947,000262:    5637           75011                           MASK     BIT7                          	# AGAIN IF IT WAS ON IN ADDITION TO
064948,000263:    5640           27331                           ADS      OPTMODES                      	# TRACKER FAIL.
064949,000264: 
064950,000265:    5641           00003        REQ                RELINT                                 	#
064951,000266:    5642           00002                           TC       Q                             	#
064952,000267: 
064953,000268:    5643           00004        TRFAILON           INHINT                                 	#
064954,000269:    5644           41036                           CS       DSPTAB     +11D               	# TURN ON
064955,000270:    5645           77704                           MASK     OCT40200                      	#
064956,000271:    5646           27036                           ADS      DSPTAB     +11D               	#
064957,000272:    5647           15641                           TCF      REQ                           	#
064958,000273: 
064959,000274: 
064960,000275: 
064961,000276: 
(End of include-file SERVICE_ROUTINES.agc, resuming MAIN.agc)
064961,000162: 
064962,000163: $ALARM_AND_ABORT.agc				        # pp. 1493-1496
064964,000002:                                                                                          	## Copyright:    Public domain.
064965,000003:                                                                                          	## Filename:     ALARM_AND_ABORT.agc
064966,000004:                                                                                          	## Purpose:      Part of the source code for Comanche, build 055. It
064967,000005:                                                                                          	##               is part of the source code for the Command Module's
064968,000006:                                                                                          	##               (CM) Apollo Guidance Computer (AGC), Apollo 11.
064969,000007:                                                                                          	## Assembler:    yaYUL
064970,000008:                                                                                          	## Reference:    pp. 1493-1496
064971,000009:                                                                                          	## Contact:      Ron Burkey <info@sandroid.org>
064972,000010:                                                                                          	## Website:      http://www.ibiblio.org/apollo.
064973,000011:                                                                                          	## Mod history:  2009-05-07 RSB Adapted from Colossus249 file of the same
064974,000012:                                                                                          	##                              name, and page images. Corrected various 
064975,000013:                                                                                          	##                              typos in the transcription of program 
064976,000014:                                                                                          	##                              comments, and these should be back-ported  
064977,000015:                                                                                          	##                              to Colossus249.
064978,000016:                                                                                          	##              2010-08-24 JL   Fixed page numbers and some indents.
064979,000017:                                                                                          	##              2016-12-22 RSB  Proofed comment text using octopus/ProoferComments
064980,000018:                                                                                          	##                              and corrected the errors found.
064981,000019:                                                                                          	##
064982,000020:                                                                                          	## The contents of the "Comanche055" files, in general, are transcribed 
064983,000021:                                                                                          	## from scanned documents. 
064984,000022:                                                                                          	##
064985,000023:                                                                                          	##       Assemble revision 055 of AGC program Comanche by NASA
064986,000024:                                                                                          	##       2021113-051.  April 1, 1969.  
064987,000025:                                                                                          	##
064988,000026:                                                                                          	##       This AGC program shall also be referred to as Colossus 2A
064989,000027:                                                                                          	##
064990,000028:                                                                                          	##       Prepared by
064991,000029:                                                                                          	##                       Massachusetts Institute of Technology
064992,000030:                                                                                          	##                       75 Cambridge Parkway
064993,000031:                                                                                          	##                       Cambridge, Massachusetts
064994,000032:                                                                                          	##
064995,000033:                                                                                          	##       under NASA contract NAS 9-4065.
064996,000034:                                                                                          	##
064997,000035:                                                                                          	## Refer directly to the online document mentioned above for further
064998,000036:                                                                                          	## information.  Please report any errors to info@sandroid.org.
064999,000037: 
065001,000039:                                                                                          	# THE FOLLOWING SUBROUTINE MAY BE CALLED TO DISPLAY A NON-ABORTIVE ALARM CONDITION.  IT MAY BE CALLED
065002,000040:                                                                                          	# EITHER IN INTERRUPT OR UNDER EXECUTIVE CONTROL.
065003,000041: 
065004,000042:                                                                                          	# CALLING SEQUENCE IS AS FOLLOWS:
065005,000043:                                                                                          	#               TC      ALARM
065006,000044:                                                                                          	#               OCT     NNNNN
065007,000045:                                                                                          	#                                       (RETURNS HERE)
065008,000046: 
065009,000047:    5650                                           BLOCK    02                            	#
065010,000048:    4000                                           SETLOC   FFTAG7                        	#
065011,000049:    4000                                           BANK                                   	#
065012,000050: 
065013,000051:    5650     0375                                  EBANK=   FAILREG                       	#
065014,000052: 
065015,000053:    5650                                           COUNT    02/ALARM                      	#
065016,000054: 
065017,000055:                                                                                          	# ALARM TURNS ON THE PROGRAM ALARM LIGHT, BUT DOES NOT DISPLAY.
065018,000056: 
065019,000057:    5650           00004        ALARM              INHINT                                 	#
065020,000058: 
065021,000059:    5651           30002                           CA       Q                             	#
065022,000060:    5652           55363        ALARM2             TS       ALMCADR                       	#
065023,000061:    5653           50002                           INDEX    Q                             	#
065024,000062:    5654           30000                           CA       0                             	#
065025,000063:    5655           54001        BORTENT            TS       L                             	#
065026,000064: 
065027,000065:    5656           30006        PRIOENT            CA       BBANK                         	#
065028,000066:    5657           00006                 +1        EXTEND                                 	#
065029,000067:    5660           04007                           ROR      SUPERBNK                      	# ADD SUPER BITS.
065030,000068:    5661           55364                           TS       ALMCADR    +1                 	#
065031,000069: 
065032,000070:    5662           30002        LARMENT            CA       Q                             	# STORE RETURN FOR ALARM
065033,000071:    5663           54061                           TS       ITEMP1                        	#
065034,000072: 
065035,000073:    5664           30164                           CA       LOC                           	#
065036,000074:    5665           54057                           TS       LOCALARM                      	#
065037,000075:    5666           30165                           CA       BANKSET                       	#
065038,000076:    5667           54060                           TS       BANKALRM                      	#
065039,000077: 
065040,000078:    5670           10375        CHKFAIL1           CCS      FAILREG                       	# IS ANYTHING IN FAILREG
065041,000079:    5671           15674                           TCF      CHKFAIL2                      	# YES TRY NEXT REG
065042,000080:    5672           22375                           LXCH     FAILREG                       	#
065043,000081:    5673           15706                           TCF      PROGLARM                      	# TURN ALARM LIGHT ON FOR FIRST ALARM
065044,000082: 
065045,000083:    5674           10376        CHKFAIL2           CCS      FAILREG    +1                 	#
065046,000084:    5675           15700                           TCF      FAIL3                         	#
065047,000085:    5676           22376                           LXCH     FAILREG    +1                 	#
065048,000086:    5677           15711                           TCF      MULTEXIT                      	#
065049,000087: 
065050,000088:    5700           30377        FAIL3              CA       FAILREG    +2                 	#
065052,000090:    5701           74777                           MASK     POSMAX                        	#
065053,000091:    5702           10000                           CCS      A                             	#
065054,000092:    5703           15715                           TCF      MULTFAIL                      	#
065055,000093:    5704           22377                           LXCH     FAILREG    +2                 	#
065056,000094:    5705           15711                           TCF      MULTEXIT                      	#
065057,000095: 
065058,000096:    5706           41036        PROGLARM           CS       DSPTAB     +11D               	#
065059,000097:    5707           77765                           MASK     OCT40400                      	#
065060,000098:    5710           27036                           ADS      DSPTAB     +11D               	#
065061,000099: 
065062,000100:    5711           56061        MULTEXIT           XCH      ITEMP1                        	# OBTAIN RETURN ADDRESS IN A
065063,000101:    5712           00003                           RELINT                                 	#
065064,000102:    5713           50000                           INDEX    A                             	#
065065,000103:    5714           00001                           TC       1                             	#
065066,000104: 
065067,000105:    5715           30001        MULTFAIL           CA       L                             	#
065068,000106:    5716           65001                           AD       BIT15                         	#
065069,000107:    5717           54377                           TS       FAILREG    +2                 	#
065070,000108: 
065071,000109:    5720           15711                           TCF      MULTEXIT                      	#
065072,000110: 
065073,000111:                                                                                          	# PRIOLARM DISPLAYS V05N09 VIA PRIODSPR WITH 3 RETURNS TO THE USER FROM THE ASTRONAUT AT CALL LOC +1,+2,+3 AND
065074,000112:                                                                                          	# AN IMMEDIATE RETURN TO THE USER AT CALL LOC +4.  EXAMPLE FOLLOWS,
065075,000113:                                                                                          	#               CAF     OCTXX           ALARM CODE
065076,000114:                                                                                          	#               TC      BANKCALL
065077,000115:                                                                                          	#               CADR    PRIOLARM
065078,000116: 
065079,000117:                                                                                          	#               ...     ...
065080,000118:                                                                                          	#               ...     ...
065081,000119:                                                                                          	#               ...     ...             ASTRONAUT RETURN
065082,000120:                                                                                          	#               TC      PHASCHNG        IMMEDIATE RETURN TO USER.  RESTART
065083,000121:                                                                                          	#               OCT     X.1             PHASE CHANGE FOR PRIO DISPLAY
065084,000122: 
065085,000123: 10,3766                                           BANK     10                            	#
065086,000124: 10,2000                                           SETLOC   DISPLAYS                      	#
065087,000125: 10,2000                                           BANK                                   	#
065088,000126: 
065089,000127: 10,3766                                           COUNT    10/DSPLA                      	#
065090,000128: 10,3766           00004        PRIOLARM           INHINT                                 	# * * * KEEP IN DISPLAY ROUTINES BANK
065091,000129: 10,3767           54001                           TS       L                             	# SAVE ALARM CODE
065092,000130: 
065093,000131: 10,3770           30133                           CA       BUF2                          	# 2 CADR OF PRIOLARM USER
065094,000132: 10,3771           55363                           TS       ALMCADR                       	#
065095,000133: 10,3772           30134                           CA       BUF2       +1                 	#
065096,000134: 10,3773           05657                           TC       PRIOENT    +1                 	# * LEAVE L ALONE
065097,000135: 10,3774           77467        -2SEC              DEC      -200       B-14               	# *** DONT MOVE
065098,000136: 10,3775           35050                           CAF      V05N09                        	#
065099,000137: 10,3776           12726                           TCF      PRIODSPR                      	#
065100,000138: 
065102,000140: 
065103,000141:    5721                                           BLOCK    02                            	#
065104,000142:    6000                                           SETLOC   FFTAG13                       	#
065105,000143:    6000                                           BANK                                   	#
065106,000144: 
065107,000145:    7755                                           COUNT    02/ALARM                      	#
065108,000146: 
065109,000147:    7755           00004        BAILOUT            INHINT                                 	#
065110,000148:    7756           30002                           CA       Q                             	#
065111,000149:    7757           55363                           TS       ALMCADR                       	#
065112,000150: 
065113,000151:    7760           04662                           TC       BANKCALL                      	#
065114,000152:    7761           40000                           CADR     VAC5STOR                      	#
065115,000153: 
065116,000154:    7762           51363                           INDEX    ALMCADR                       	#
065117,000155:    7763           30000                           CAF      0                             	#
065118,000156:    7764           05655                           TC       BORTENT                       	#
065119,000157:    7765           40400        OCT40400           OCT      40400                         	#
065120,000158: 
065121,000159:    7766           00004                           INHINT                                 	#
065122,000160:    7767           35016        WHIMPER            CA       TWO                           	#
065123,000161:    7770           60005                           AD       Z                             	#
065124,000162:    7771           54017                           TS       BRUPT                         	#
065125,000163:    7772           50017                           RESUME                                 	#
065126,000164:    7773           04701                           TC       POSTJUMP                      	# RESUME SENDS CONTROL HERE
065127,000165:    7774           12651                           CADR     ENEMA                         	#
065128,000166: 
065129,000167:    4000                                           SETLOC   FFTAG7                        	#
065130,000168:    4000                                           BANK                                   	#
065131,000169: 
065132,000170:    5721           00004        POODOO             INHINT                                 	#
065133,000171:    5722           30002                           CA       Q                             	#
065134,000172:    5723           55363                           TS       ALMCADR                       	#
065135,000173: 
065136,000174:    5724           04662                           TC       BANKCALL                      	#
065137,000175:    5725           40000                           CADR     VAC5STOR                      	# STORE ERASABLES FOR DEBUGGING PURPOSES.
065138,000176: 
065139,000177:    5726           51363                           INDEX    ALMCADR                       	#
065140,000178:    5727           30000                           CAF      0                             	#
065141,000179:    5730           05655        ABORT2             TC       BORTENT                       	#
065142,000180:    5731           77770        OCT77770           OCT      77770                         	# DONT MOVE
065143,000181:    5732           35012                           CA       V37FLBIT                      	# IS AVERAGE G ON
065144,000182:    5733           70103                           MASK     FLAGWRD7                      	#
065145,000183:    5734           10000                           CCS      A                             	#
065146,000184:    5735           07766                           TC       WHIMPER    -1                 	# YES.  DONT DO POODOO.  DO BAILOUT.
065147,000185: 
065148,000186:    5736           05560                           TC       DOWNFLAG                      	#
065149,000187:    5737           00067                           ADRES    STATEFLG                      	#
065150,000188: 
065151,000189:    5740           05560                           TC       DOWNFLAG                      	#
065152,000190: 
065154,000192:    5741           00236                           ADRES    REINTFLG                      	#
065155,000193: 
065156,000194:    5742           05560                           TC       DOWNFLAG                      	#
065157,000195:    5743           00054                           ADRES    NODOFLAG                      	#
065158,000196: 
065159,000197:    5744           04662                           TC       BANKCALL                      	#
065160,000198:    5745           12501                           CADR     MR.KLEAN                      	#
065161,000199:    5746           07767                           TC       WHIMPER                       	#
065162,000200: 
065163,000201:    5747           00004        CCSHOLE            INHINT                                 	#
065164,000202:    5750           30002                           CA       Q                             	#
065165,000203:    5751           55363                           TS       ALMCADR                       	#
065166,000204:    5752           04662                           TC       BANKCALL                      	#
065167,000205:    5753           40000                           CADR     VAC5STOR                      	#
065168,000206:    5754           35756                           CA       OCT1103                       	#
065169,000207:    5755           05730                           TC       ABORT2                        	#
065170,000208:    5756           01103        OCT1103            OCT      1103                          	#
065171,000209:    5757           00004        CURTAINS           INHINT                                 	#
065172,000210:    5760           30002                           CA       Q                             	#
065173,000211:    5761           05652                           TC       ALARM2                        	#
065174,000212:    5762           00217        OCT217             OCT      00217                         	#
065175,000213:    5763           01363                           TC       ALMCADR                       	# RETURN TO USER
065176,000214: 
065177,000215:    5764     5217               DOALARM            EQUALS   ENDOFJOB                      	#
065178,000216: 
065179,000217:                                                                                          	# CALLING SEQUENCE FOR VARALARM
065180,000218: 
065181,000219:                                                                                          	#               CAF     (ALARM)
065182,000220:                                                                                          	#               TC      VARALARM
065183,000221: 
065184,000222:                                                                                          	# VARALARM TURNS ON PROGRAM ALARM LIGHT BUT DOES NOT DISPLAY
065185,000223: 
065186,000224:    5764           00004        VARALARM           INHINT                                 	#
065187,000225: 
065188,000226:    5765           54001                           TS       L                             	# SAVE USERS ALARM CODE
065189,000227: 
065190,000228:    5766           30002                           CA       Q                             	# SAVE USERS Q
065191,000229:    5767           55363                           TS       ALMCADR                       	#
065192,000230: 
065193,000231:    5770           05656                           TC       PRIOENT                       	#
065194,000232:    5771           00014        OCT14              OCT      14                            	# DONT MOVE
065195,000233: 
065196,000234:    5772           01363                           TC       ALMCADR                       	# RETURN TO USER
065197,000235: 
065198,000236:    5773     7755               ABORT              EQUALS   BAILOUT                       	# *** TEMPORARY UNTIL ABORT CALLS OUT
(End of include-file ALARM_AND_ABORT.agc, resuming MAIN.agc)
065198,000163: 

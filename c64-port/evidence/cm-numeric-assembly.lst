036075,000755: 26,2663           57067                                    CALCTFF                       	# SAVES MPAC IN RTERM           (18D)
036076,000756: 
036077,000757: 26,2664           77624                           CALL                                   	# CALC SDELF/2, CDELF/2
036078,000758: 26,2665           56631                                    TFF/TRIG                      	# RETURN WITH S(THETA) IN MPAC
036079,000759: 
036080,000760: 26,2666           77624                           CALL                                   	# GET FISCHER RADIUS            (-29) M
036081,000761: 26,2667           55030                                    FISHCALC                      	# ANS IN MPAC AND IN ERADM.
036082,000762: 
036083,000763: 26,2670           45015                           DAD      CALL                          	#
036084,000764: 26,2671           02020                                    EMSALT                        	#
036085,000765: 26,2672           57067                                    CALCTFF                       	# SAVES MPAC IN RTERM           (18D)
036086,000766: 
036087,000767: 26,2673           77676                           DCOMP                                  	# NEGATIVE AS IN COUNTDOWN.
036088,000768: 26,2674           03733                           STORE    TTE1                          	# DECR TTE FROM BASE TTE1.  (RESTART)
036089,000769:                                                                                          	# DNLIST AND DSKY WILL USE TTE.
036090,000770: 26,2675           37727                           STCALL   TTE                           	# LET MISS CONTRL DECR BY ELAPSED TIME
036091,000771:                                                                                          	# TTE= TIME FROM NOW TO EMSALT +FISCHER
036092,000772: 
036093,000773: 26,2676           56631                                    TFF/TRIG                      	# S(THETA) IN MPAC ON RETURNING
036094,000774:                                                                                          	# AND THETA= RANGE FROM NOW TO EMSALT
036095,000775: 
036096,000776: 26,2677           77624                           CALL                                   	#
036097,000777: 26,2700           55030                                    FISHCALC                      	#
036098,000778: 26,2701           77624                           CALL                                   	#
036099,000779: 26,2702           56664                                    VRCALC                        	#
036100,000780: 26,2703           77624                           CALL                                   	#
036101,000781: 26,2704           56651                                    DISPTARG                      	#
036102,000782: 26,2705           77624                           CALL                                   	#
036103,000783: 26,2706           56651                                    DISPTARG                      	#
036104,000784: 26,2707           37714                           STCALL   RTGO                          	#
036106,000786: 26,2710           55051                                    VGAMCALC                      	#
036107,000787: 
036108,000788: 26,2711           77605                           DMP                                    	# MPAC = GAMMA
036109,000789:                                                                                          	# PDL0 HAS VGAM.
036110,000790: 26,2712           43265                           BDDV     DAD                           	#
036111,000791: 26,2713           15027                                    VEMSCON                       	# -HS D 180/PI (-14)
036112,000792: 26,2714           00001                                    0                             	# VGAM FROM PDL0.
036113,000793: 26,2715           17725                           STODL    VIO                           	# PREDICTED VELOCITY AT EMSALT.
036114,000794: 
036115,000795:                                                                                          	# GAMMA AND VGAM AT 300K FT ARE REQUIRED BY GMAX
036116,000796:                                                                                          	# ALGORITHM.
036117,000797: 
036118,000798: 26,2716           02241                                    ERADM                         	# EARTH RADIUS FROM GETERAD (-29) M
036119,000799:                                                                                          	# = FISCHER RADIUS (-29)
036120,000800: 
036121,000801: 26,2717           77615                           DAD                                    	#
036122,000802: 26,2720           06462                                    300KFT                        	# M (-29)
036123,000803: 26,2721           34023                           STCALL   RTERM                         	# TERMINAL RADIUS M (-29)
036124,000804: 
036125,000805: 26,2722           55046                                    PREVGAM                       	# VGAMCALC WITH NEW RTERM
036126,000806: 
036127,000807:                                                                                          	# VBAR = (V(FPS) - 36KF/S) / 20KF/S
036128,000808:                                                                                          	# GMAX = (4/(1 + 4.8 VBARSQ))(GAM - 6.05 - 2.4 VBARSQ) - 10(L/D - .3) + 10      ASSUME L/D = 0.3, BANK =0.
036129,000809: 
036130,000810:                                                                                          	# GMAXCALC
036131,000811: 26,2723           45325                           PDDL     DSU                           	# GAM TO PDL2
036132,000812: 26,2724           00001                                    0                             	# VGAM IS IN PDL0 (-7)
036133,000813: 26,2725           15005                                    36KFT/S                       	# (-7) M/CS
036134,000814: 26,2726           63471                           DDV      DSQ                           	#
036135,000815: 26,2727           15007                                    20KFT/S                       	# (-6) M/CS
036136,000816: 26,2730           00001                           STORE    0                             	# VBARSQ (-2) TO PDL0
036137,000817: 
036138,000818: 26,2731           43205                           DMP      DAD                           	#
036139,000819: 26,2732           15011                                    KR1                           	#
036140,000820:                                                                                          	# GAM, POS DOWN, FROM PDL2
036141,000821: 26,2733           41215                           DAD      DMP                           	#
036142,000822: 26,2734           15013                                    -6.05DEG                      	#
036143,000823: 26,2735           15015                                    KR2                           	#
036144,000824: 26,2736           77725                           PDDL                                   	# XCH PDL+0 FOR VBARSQ (-2)
036145,000825: 26,2737           43271                           DDV      DAD                           	#
036146,000826: 26,2740           15025                                    KR4                           	#
036147,000827: 26,2741           17366                                    DP2(-4)                       	#
036148,000828: 26,2742           77665                           BDDV                                   	#
036149,000829:                                                                                          	# NUM FROM PDL+0
036150,000830: 26,2743           51015                           DAD      BPL                           	#
036151,000831: 26,2744           15017                                    KR3                           	#
036152,000832: 26,2745           54750                                    +3                            	#
036153,000833: 26,2746           77745                           DLOAD                                  	#
036154,000834: 26,2747           15335                                    HI6ZEROS                      	#
036155,000835: 26,2750           17722                           STODL    GMAX                          	# 100 GMAX (-14)
036157,000837:                                                                                          	# DISPLAY USES GMAX AS SP, SO LO WORD IS WRITTEN OVER BY VPRED.
036158,000838: 26,2751           02241                                    ERADM                         	# = FISCHER RADIUS (-29) M
036159,000839: 26,2752           45015                           DAD      CALL                          	# 2 ND ITERATION FOR FISCHER RADIUS
036160,000840: 26,2753           15023                                    400KFT                        	#
036161,000841: 26,2754           57067                                    CALCTFF                       	# ESTABLISH TRANSFER ANGLE DATA.
036162,000842: 26,2755           77624                           CALL                                   	#
036163,000843: 26,2756           56631                                    TFF/TRIG                      	# GET SIN, COS DELF
036164,000844: 26,2757           77624                           CALL                                   	#
036165,000845: 26,2760           55030                                    FISHCALC                      	# GET CORRESPONDING FISCHER RADIUS.
036166,000846: 
036167,000847: 26,2761           73015                           DAD      LXA,2                         	# SAVE HI-WORD FOR DOWNLIST.
036168,000848: 26,2762           15023                                    400KFT                        	# M (-29)
036169,000849: 26,2763           03713                                    RTGO                          	# (RANGE ANGLE FROM EMSALT) / 360
036170,000850: 26,2764           34023                           STCALL   RTERM                         	#
036171,000851: 26,2765           55046                                    PREVGAM                       	# VGAMCALC WITH NEW RTERM
036172,000852: 

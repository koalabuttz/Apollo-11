008991,000039: 
008993,000041:                                                                                          	# RESTART TABLES
008994,000042:                                                                                          	# ------------------
008995,000043: 
008996,000044:                                                                                          	# THERE ARE TWO FORMS OF RESTART TABLES FOR EACH GROUP.  THEY ARE KNOWN AS THE EVEN RESTART TABLES AND THE ODD
008997,000045:                                                                                          	# RESTART TABLES.  THE ODD TABLES HAVE ONLY ONE ENTRY OF THREE LOCATIONS WHILE THE EVEN TABLES HAVE TWO ENTRIES
008998,000046:                                                                                          	# EACH USING THREE LOCATIONS.  THE INFORMATION AS TO WHETHER IT IS A JOB, WAITLIST, OR A LONGCALL IS GIVEN BY THE
008999,000047:                                                                                          	# WAY THINGS ARE PUT IN TO THE TABLES.
009000,000048: 
009001,000049:                                                                                          	# A JOB HAS ITS PRIORITY STORED IN PRDTTAB OF THE CORRECT PHASE SPOT - A POSITIVE PRIORITY INDICATES A
009002,000050:                                                                                          	# FINDVAC JOB, A NEGATIVE PRIORITY A NOVAC.  THE 2CADR OF THE JOB IS STORED IN THE CADRTAB.
009003,000051:                                                                                          	# FOR EXAMPLE,
009004,000052: 
009005,000053:                                                                                          	#               5.7SPOT         OCT     23000
009006,000054:                                                                                          	#                               2CADR   SOMEJOB
009007,000055: 
009008,000056:                                                                                          	# A RESTART OF GROUP 5 WITH PHASE SEVEN WOULD THEN CAUSE SOMEJOB TO BE RESTARTED AS A FINDVAC WITH PRIORITY 23.
009009,000057: 
009010,000058:                                                                                          	#               5.5SPOT         OCT     -23000
009011,000059:                                                                                          	#                               2CADR   ANYJOB
009012,000060: 
009013,000061:                                                                                          	# HERE A RESTART OF GROUP 5 WITH PHASE 7 WOULD CAUSE ANYJOB TO BE RESTARTED AS A NOVAC WITH PRIORITY 23.
009014,000062:                                                                                          	# A LONGCALL HAS ITS GENADR OF ITS 2CADR STORED NEGATIVELY AND ITS BBCON STORED POSITIVELY.  IN ITS PRDTTAB IS
009015,000063:                                                                                          	# PLACED THE LOCATION OF A DP REGISTER THAT CONTAINS THE DELTA TIME THAT LONGCALL HAD BEEN ORIGINALLY STARTED
009016,000064:                                                                                          	# WITH.  EXAMPLE,
009017,000065: 
009018,000066:                                                                                          	#               3.6SPOT         GENADR  DELTAT
009019,000067:                                                                                          	#                               -GENADR LONGTASK
009020,000068:                                                                                          	#                               BBCON   LONGTASK
009021,000069: 
009022,000070:                                                                                          	#                               OCT     31000
009023,000071:                                                                                          	#                               2CADR   JOBAGAIN
009024,000072: 
009025,000073:                                                                                          	# THIS WOULD START UP LONGTASK AT THE APPROPRIATE TIME, OR IMMEDIATELY IF THE TIME HAD ALREADY PASSED.  IT SHOULD
009026,000074:                                                                                          	# BE NOTED THAT IF DELTAT IS IN A SWITCHED E BANK, THIS INFORMATOIN SHOULD BE IN THE BBCON OF THE 2CADR OF THE
009027,000075:                                                                                          	# TASK.  FROM ABOVE, WE SEE THAT THE SECOND PART OF THIS PHASE WOULD BE STARTED AS A JOB WITH A PRIORITY OF 31.
009028,000076: 
009029,000077:                                                                                          	# WAITLIST CALLS ARE IDENTIFIED BY THE FACT THAT THEIR 2CADR IS STORED NEGATIVELY.  IF PRDTTAB OF THE PHASE SPOT
009030,000078:                                                                                          	# IS POSITIVE, THEN IT CONTAINS THE DELTA TIME, IF PRDTTAB IS NEGATIVE THEN IT IS THE -GENADR OF AN ERASABLE
009031,000079:                                                                                          	# LOCATION CONTAINING THE DELTA TIME, THAT IS, THE TIME IS STORED INDIRECTLY. IT SHOULD BE NOTED AS ABOVE, THAT
009032,000080:                                                                                          	# IF THE TIME IS STORED INDIRECTLY, THE BBCON MUST CONTAIN THE NECESSARY E BANK INFORMATION IF APPLICABLE.  WITH
009033,000081:                                                                                          	# WAITLIST WE HAVE ONE FURTHER OPTION, IF -0 IS STORED IN PRDTTAB, IT WILL CAUSE AN IMMEDIATE RESTART OF THE
009034,000082:                                                                                          	# TASK.  EXAMPLES,
009035,000083: 
009036,000084:                                                                                          	#                               OCT     77777           THIS WILL CAUSE AN IMMEDIATE RESTART
009037,000085:                                                                                          	#                               -2CADR  ATASK           OF THE TASK :ATASK:
009038,000086: 
009039,000087:                                                                                          	#                               DEC     200             IF THE TIME OF THE 2 SECONDS SINCE DUMMY
009040,000088:                                                                                          	#                               -2CADR  DUMMY           WAS PUT ON WAITLIST IS UP, IT WILL BEGIN
009041,000089:                                                                                          	#                                                       IN 10 MS, OTHERWISE IT WILL BEGIN WHEN
009042,000090:                                                                                          	#                                                       IT NORMALLY WOULD HAVE BEGUN.
009044,000092:                                                                                          	#                               -GENADR DTIME           WHERE DTIME CONTAINS THE DELTA TIME
009045,000093:                                                                                          	#                               -2CADR  TASKTASK        OTHERWISE THIS IS AS ABOVE
009046,000094: 
009047,000095:                                                                                          	# ***** NOW THE TABLES THEMSELVES *****
009048,000096: 
009049,000097: 01,2000                                           BANK     01                            	#
009050,000098: 01,2000                                           SETLOC   RESTART                       	#
009051,000099: 01,2000                                           BANK                                   	#
009052,000100: 
009053,000101: 01,2000                                           COUNT    01/RSTAB                      	#
009054,000102: 
009055,000103: 01,2000                        PRDTTAB            EQUALS   12000                         	# USED TO FIND THE PRIORITY OR DELTATIME
009056,000104: 01,2000                        CADRTAB            EQUALS   12001                         	# THIS AND THE NEXT RELATIVE LOC CONTAIN
009057,000105:                                                                                          	# RESTART 2CADR

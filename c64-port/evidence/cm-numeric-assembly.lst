040470,000791:                                                                                          	# PRECISION TRAJECTORY COMPUTATION SUBROUTINE
040471,000792: 
040472,000793:                                                                                          	# DESCRIPTION
040473,000794:                                                                                          	#       A NUMERICALLY INTEGRATED TRAJECTORY IS GENERATED WHICH FOR THE RETURN TO EARTH PROBLEM SATISFIES THE REENTRY
040474,000795:                                                                                          	#       CONSTRAINTS (RCON AND X(T2)) ACHIEVED BY THE INITIAL CONIC TRAJECTORY AND MEETS THE DVD REQUIREMENT AS CLOSELY
040475,000796:                                                                                          	#       AS POSSIBLE.
040476,000797: 
040477,000798:                                                                                          	# CALLING SEQUENCE
040478,000799:                                                                                          	#       L       CALL
040479,000800:                                                                                          	#       L+1             PREC100
040480,000801: 
040481,000802:                                                                                          	# NORMAL EXIT MODE
040482,000803:                                                                                          	#       AT L+2 OF CALLING SEQUENCE WITH MPAC = 0
040483,000804: 
040484,000805:                                                                                          	# ALARM EXIT MODE
040485,000806:                                                                                          	#       AT L+2 OF CALLING SEQUENCE WITH MPAC =
040486,000807:                                                                                          	#               OCTAL 605       FOR EXCESS ITERATIONS
040487,000808:                                                                                          	#               OCTAL 613       FOR REENTRY ANGLE OUT OF LIMITS
040488,000809: 
040489,000810:                                                                                          	# SUBROUTINES CALLED
040490,000811:                                                                                          	#       INTSTALL
040491,000812:                                                                                          	#       RTENCK2
040492,000813:                                                                                          	#       RTENCK3
040493,000814:                                                                                          	#       TIMERAD
040494,000815:                                                                                          	#       PARAM
040495,000816:                                                                                          	#       V2T100
040496,000817: 
040497,000818:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
040498,000819:                                                                                          	#    PUSHLIST
040499,000820:                                                                                          	#       NONE
040500,000821:                                                                                          	#    MPAC
040501,000822:                                                                                          	#       NONE
040502,000823:                                                                                          	#    OTHER
040503,000824:                                                                                          	#       R(T1)/          INITIAL POSITION VECTOR                                 VECTOR  B29/B27 METERS
040504,000825:                                                                                          	#       V2(T1)/         POST IMPULSE INITIAL VELOCITY VECTOR                    VECTOR  B7/B5   METERS/CS
040505,000826:                                                                                          	#       V(T1)/          INITIAL VELOCITY VECTOR                                 VECTOR  B7/B5   METERS/CS
040506,000827:                                                                                          	#       T1              INITIAL VECTOR TIME                                     DP      B28     CS
040507,000828:                                                                                          	#       T12             INITIAL TO FINAL POSITION TIME                          DP      B28     CS
040508,000829:                                                                                          	#       RCON            CONIC FINAL RADIUS                                      DP      B29/B27 METERS
040509,000830:                                                                                          	#       R(T1)           MAGNITUDE OF INITIAL POSITION VECTOR                    DP      B29/B27 METERS
040510,000831:                                                                                          	#       X(T2)           COTANGENT OF FINAL FLIGHT PATH ANGLE                    DP      B0
040511,000832:                                                                                          	#       X(T1)           COTANGENT OF INITIAL FLIGHT PATH ANGLE                  DP      B5
040512,000833:                                                                                          	#       RTEDVD          DELTA VELOCITY DESIRED                                  DP      B7/B5   METERS/CS
040513,000834:                                                                                          	#       MAMAX1          MAJOR AXIS LIMIT FOR LOWER BOUND ON GAMDV ITERATOR      DP      B30/B28 METERS
040514,000835:                                                                                          	#       MAMAX2          MAJOR AXIS LIMIT FOR UPPER BOUND ON GAMDV ITERATOR      DP      B30/B28 METERS
040515,000836:                                                                                          	#       UR1/            UNIT INITIAL VECTOR                                     VECTOR  B1
040516,000837:                                                                                          	#       UH/             UNIT HORIZONTAL VECTOR                                  VECTOR  B1
040517,000838:                                                                                          	#       BETA1           1+X(T2)**2                                              DP      B1
040518,000839:                                                                                          	#       PHI2            PERIGEE OR APOGEE INDICATOR                             DP      B2      -1 PERIGEE, +1 APOGEE
040519,000840: 
040521,000842: 
040522,000843:                                                                                          	# OUTPUT

061727,000102: 
061728,000103:                                                                                          	# ***** THIS MUST BE IN FIXED FIXED *****
061729,000104: 
061730,000105:    5500                                           BLOCK    02                            	#
061731,000106:    4000                                           SETLOC   FFTAG2                        	#

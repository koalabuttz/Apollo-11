023002,000026: 
023003,000027:                                                                                          	## This source code has been transcribed or otherwise adapted from digitized
023004,000028:                                                                                          	## images of a hardcopy from the MIT Museum.  The digitization was performed
023005,000029:                                                                                          	## by Paul Fjeld, and arranged for by Deborah Douglas of the Museum.  Many
023006,000030:                                                                                          	## thanks to both.  The images (with suitable reduction in storage size and
023007,000031:                                                                                          	## consequent reduction in image quality as well) are available online at
023008,000032:                                                                                          	## www.ibiblio.org/apollo.  If for some reason you find that the images are
023009,000033:                                                                                          	## illegible, contact me at info@sandroid.org about getting access to the 
023010,000034:                                                                                          	## (much) higher-quality images which Paul actually created.
023011,000035:                                                                                          	##
023012,000036:                                                                                          	## Notations on the hardcopy document read, in part:
023013,000037:                                                                                          	##
023014,000038:                                                                                          	##    Assemble revision 055 of AGC program Comanche by NASA
023015,000039:                                                                                          	##    2021113-051.  10:28 APR. 1, 1969  
023016,000040:                                                                                          	##
023017,000041:                                                                                          	##    This AGC program shall also be referred to as
023018,000042:                                                                                          	##            Colossus 2A
023020,000044:                                                                                          	# STABLE ORBIT RENDEZVOUS PROGRAMS (P38 AND P78)
023021,000045: 
023022,000046:                                                                                          	# MOD NO -1             LOG SECTION - STABLE ORBIT - P38-P39
023023,000047:                                                                                          	# MOD BY RUDNICKI.S     DATE 25JAN68
023024,000048: 
023025,000049:                                                                                          	# FUNCTIONAL DESCRIPTION
023026,000050: 
023027,000051:                                                                                          	#       P38 AND P78 CALCULATE THE REQUIRED DELTA V AND OTHER INITIAL
023028,000052:                                                                                          	#       CONDITIONS REQUIRED BY THE AGC TO (1) PUT THE ACTIVE VEHICLE
023029,000053:                                                                                          	#       ON A TRANSFER TRAJECTORY THAT INTERCEPTS THE PASSIVE VEHICLE
023030,000054:                                                                                          	#       ORBIT A GIVEN DISTANCE, DELTA R, EITHER AHEAD OF OR BEHIND THE
023031,000055:                                                                                          	#       PASSIVE VEHICLE AND (2) ACTUALLY PLACE THE ACTIVE VEHICLE IN THE
023032,000056:                                                                                          	#       PASSIVE VEHICLE ORBIT WITH A DELTA R SEPARATION BETWEEN THE TWO
023033,000057:                                                                                          	#       VEHICLES
023034,000058: 
023035,000059:                                                                                          	# CALLING SEQUENCE
023036,000060: 
023037,000061:                                                                                          	#       ASTRONAUT REQUEST THRU DSKY
023038,000062: 
023039,000063:                                                                                          	#       V37E38E         IF THIS VEHICLE IS ACTIVE VEHICLE
023040,000064:                                                                                          	#       V37E78E         IF OTHER VEHICLE IS ACTIVE VEHICLE
023041,000065: 
023042,000066:                                                                                          	# INPUT
023043,000067: 
023044,000068:                                                                                          	#       (1)     SOI MANEUVER
023045,000069: 
023046,000070:                                                                                          	#               (A)  TIG        TIME OF SOI MANEUVER
023047,000071:                                                                                          	#               (B)  CENTANG    ORBITAL CENTRAL ANGLE OF THE PASSIVE VEHICLE
023048,000072:                                                                                          	#                               DURING TRANSFER FROM TIG TO TIME OF INTERCEPT
023049,000073:                                                                                          	#               (C)  DELTAR     THE DESIRED SEPARATION OF THE TWO VEHICLES
023050,000074:                                                                                          	#                               SPECIFIED AS A DISTANCE ALONG THE PASSIVE VEHICLE
023051,000075:                                                                                          	#                               ORBIT
023052,000076:                                                                                          	#               (D)  OPTION     EQUALS 1 FOR SOI
023053,000077: 
023054,000078:                                                                                          	#       (2)     SOR MANEUVER
023055,000079: 
023056,000080:                                                                                          	#               (A)  TIG        TIME OF SOR MANEUVER
023057,000081:                                                                                          	#               (B)  CENTANG    AN OPTIONAL RESPECIFICATION OF 1 (B) ABOVE
023058,000082:                                                                                          	#               (C)  OPTION     EQUALS 2 FOR SOR
023059,000083:                                                                                          	#               (D)  DELTTIME   THE TIME REQUIRED TO TRAVERSE DELTA R WHEN
023060,000084:                                                                                          	#                               TRAVELING AT A VELOCITY EQUAL TO THE HORIZONTAL
023061,000085:                                                                                          	#                               VELOCITY OF THE PASSIVE VEHICLE - SAVED FROM
023062,000086:                                                                                          	#                               SOI PHASE
023063,000087:                                                                                          	#               (E)  TINT       TIME OF INTERCEPT (SOI) - SAVED FROM SOI PHASE
023064,000088: 
023065,000089:                                                                                          	# OUTPUT
023066,000090: 
023067,000091:                                                                                          	#       (1)  TRKMKCNT   NUMBER OF MARKS
023068,000092:                                                                                          	#       (2)  TTOGO      TIME TO GO
023069,000093:                                                                                          	#       (3)  +MGA       MIDDLE GIMBAL ANGLE
023071,000095:                                                                                          	#       (4)  DSPTEM1    TIME OF INTERCEPT OF PASSIVE VEHICLE ORBIT
023072,000096:                                                                                          	#                       (FOR SOI ONLY)
023073,000097:                                                                                          	#       (5)  POSTTPI    PERIGEE ALTITUDE OF ACTIVE VEHICLE ORBIT AFTER
023074,000098:                                                                                          	#                       THE SOI (SOR) MANEUVER
023075,000099:                                                                                          	#       (6)  DELVTPI    MAGNITUDE OF DELTA V AT SOI (SOR) TIME
023076,000100:                                                                                          	#       (7)  DELVTPF    MAGNITUDE OF DELTA V AT INTERCEPT TIME
023077,000101:                                                                                          	#       (8)  DELVLVC    DELTA VELOCITY AT SOI (AND SOR) - LOCAL VERTICAL
023078,000102:                                                                                          	#                       COORDINATES
023079,000103: 
023080,000104:                                                                                          	# SUBROUTINES USED
023081,000105: 
023082,000106:                                                                                          	#       AVFLAGA
023083,000107:                                                                                          	#       AVFLAGP
023084,000108:                                                                                          	#       VNDSPLY
023085,000109:                                                                                          	#       BANKCALL

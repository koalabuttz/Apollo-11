050020,000767:                                                                                          	# Page 1131
050021,000768:                                                                                          	# SECTION 3 -- ADD/SUBTRACT PACKAGE.
050022,000769: 
050023,000770:                                                                                          	# THE FOLLOWING OPERATIONS ARE PROVIDED FOR ADDING TO AND SUBTRACTING FROM THE MULTI-PURPOSE ACCUMULATOR
050024,000771:                                                                                          	# MPAC:
050025,000772:                                                                                          	#       1.      DAD     DOUBLE PRECISION ADD.
050026,000773:                                                                                          	#       2.      DSU     DOUBLE PRECISION SUBTRACT.
050027,000774:                                                                                          	#       3.      BDSU    DOUBLE PRECISION SUBTRACT FROM.
050028,000775:                                                                                          	#       4.      TAD     TRIPLE PRECISION ADD.
050029,000776:                                                                                          	#       5.      VAD     VECTOR ADD.
050030,000777:                                                                                          	#       6.      VSU     VECTOR SUBTRACT.
050031,000778:                                                                                          	#       7.      BVSU    VECTOR SUBTRACT FROM.
050032,000779:                                                                                          	# THE INTERPRETIVE OVERFLOW INDICATOR OVFIND IS SET NON-ZERO IF OVERFLOW OCCURS IN ANY OF THE ABOVE.
050033,000780: 
050034,000781:    6716           35001        VSU                CAF      BIT15                         	# CHANGES 0 TO DCS.
050035,000782:    6717           16721                           TCF      +2                            	#
050036,000783: 
050037,000784:    6720           34371        VAD                CAF      PRIO30                        	# CHANGES 0 TO DCA.
050038,000785:    6721           26116                           ADS      ADDRWD                        	#
050039,000786:    6722           00006                           EXTEND                                 	#
050040,000787:    6723           50116                           INDEX    ADDRWD                        	#
050041,000788:    6724           00003                           READ     HISCALAR                      	# DCA 2 OR DCS 2
050042,000789:    6725           20160                           DAS      MPAC       +3                 	#
050043,000790:    6726           00006                           EXTEND                                 	# CHECK OVERFLOW.
050044,000791:    6727           16731                           BZF      +2                            	#
050045,000792:    6730           06763                           TC       OVERFLWY                      	#
050046,000793: 
050047,000794:    6731           00006                           EXTEND                                 	#
050048,000795:    6732           50116                           INDEX    ADDRWD                        	#
050049,000796:    6733           00005                           READ     CHAN5                         	# DCA 4 OR DCS 4
050050,000797:    6734           20162                           DAS      MPAC       +5                 	#
050051,000798:    6735           00006                           EXTEND                                 	#
050052,000799:    6736           16740                           BZF      +2                            	#
050053,000800:    6737           06760                           TC       OVERFLWZ                      	#
050054,000801: 
050055,000802:    6740           00006                           EXTEND                                 	#
050056,000803:    6741           50116                           INDEX    ADDRWD                        	#
050057,000804:    6742           00001                           READ     LCHAN                         	# DCA 0 OR DCS 0
050058,000805:    6743           16747                           TCF      ENDVXV                        	#
050059,000806: 
050060,000807:    6744           00006        DAD                EXTEND                                 	#
050061,000808:    6745           50116                           INDEX    ADDRWD                        	#
050062,000809:    6746           30001                           DCA      0                             	#
050063,000810:    6747           20155        ENDVXV             DAS      MPAC                          	# VXV FINISHES HERE.
050064,000811:    6750           00006                           EXTEND                                 	#
050065,000812:    6751           16030                           BZF      DANZIG                        	#
050066,000813: 
050067,000814:                                                                                          	# Page 1132
050068,000815:    6752           06766        SETOVF             TC       OVERFLOW                      	#
050069,000816:    6753           16030                           TCF      DANZIG                        	#
050070,000817: 
050071,000818:                                                                                          	# Page 1133
050072,000819:    6754           00006        DSU                EXTEND                                 	#
050073,000820:    6755           50116                           INDEX    ADDRWD                        	#
050074,000821:    6756           40001                           DCS      0                             	#
050075,000822:    6757           16747                           TCF      ENDVXV                        	#

065239,000040: 
065241,000042:                                                                                          	# PROGRAM NAME:         P27
065242,000043:                                                                                          	# WRITTEN BY:           KILROY/ DE WOLF
065243,000044: 
065244,000045:                                                                                          	# MOD NO:               6
065245,000046:                                                                                          	# MOD BY:               KILROY
065246,000047:                                                                                          	# DATE:                 01DEC67
065247,000048: 
065248,000049:                                                                                          	# LOG SECTION:          UPDATE PROGRAM.
065249,000050: 
065250,000051:                                                                                          	# FUNCT. DESCR: P27 (THE UPDATE PROGRAM) PROCESSES COMMANDS AND DATA
065251,000052:                                                                                          	#                       INSERTIONS REQUESTED BY THE GROUND VIA UPLINK.
065252,000053:                                                                                          	#                       THE P27 PROGRAM WILL ACCEPT UPDATES
065253,000054:                                                                                          	#                       ONLY DURING P00 FOR THE LM, AND ONLY DURING P00,
065254,000055:                                                                                          	#                       P02, AND FRESH START FOR THE CSM
065255,000056: 
065256,000057:                                                                                          	# CALLING SEQ:          PROGRAM IS INITIATED BY UPLINK ENTRY OF VERBS 70, 71, 72 AND 73.
065257,000058: 
065258,000059:                                                                                          	# SUBROUTINES:          TESTXACT, NEWMODEX, NEWMODEX +3, GOXDSPF, BANKCALL, FINDVAC, INTPRET, INTSTALL, TPAGREE,
065259,000060:                                                                                          	#                       INTWAKEU, ENDEXT, POSTJUMP, FALTON, NEWPHASE, PHASCHNG
065260,000061: 
065261,000062:                                                                                          	# NORMAL EXIT:          TC ENDEXT
065262,000063: 
065263,000064:                                                                                          	# ALARM/ABORT:          TC FALTON FOLLOWED BY TC ENDEXT
065264,000065: 
065265,000066:                                                                                          	# RESTARTS:             P27 IS RESTART PROTECTED IN TWO WAYS ...
065266,000067:                                                                                          	#                       1.      PRIOR TO VERIFLAG INVERSION (WHICH IS CAUSED BY THE GROUND/ASTRONAUT'S VERIFICATION OF UPDATE
065267,000068:                                                                                          	#                               DATA BY SENDING A V33E WHEN V21N02 IS FLASHING)---
065268,000069:                                                                                          	#                               NO PROTECTION EXCEPT PRE-P27 MODE IS RESTORED, COAST + ALIGN DOWNLIST IS SELECTED AND UPLINK
065269,000070:                                                                                          	#                               ACTIVITY LIGHT IS TURNED OFF.  (JUST AS IF A V34E WAS SENT DURING P27 DATA LOADS).
065270,000071:                                                                                          	#                               V70,V71,V72 OR V73 WILL HAVE TO BE COMPLETELY RESENT BY USER.
065271,000072:                                                                                          	#                       2.      AFTER VERIFLAG INVERSION (WHEN UPDATE OF THE SPECIFIED ERASABLES IS BEING PERFORMED)---
065272,000073:                                                                                          	#                               PROTECTED AGAINST RESTARTS.
065273,000074: 
065274,000075:                                                                                          	# DEBRIS:               UPBUFF  (20D)   TEMP STORAGE FOR ADDRESSES AND CONTENTS.
065275,000076:                                                                                          	#                       UPVERB  (1)     VERB NUMBER MINUS 70D (E.G. FOR V72, UPVERB = 72D - 70D = 2)
065276,000077:                                                                                          	#                       UPOLDMOD(1)     FOR MAJOR MODE INTERRUPTED BY P27.
065277,000078:                                                                                          	#                       COMPNUMB(1)     TOTAL NUMBER OF COMPONENTS TO BE TRANSMITTED.
065278,000079:                                                                                          	#                       UPCOUNT (1)     ACTUAL NUMBER OF COMPONENTS RECEIVED.
065279,000080:                                                                                          	#                       UPTEMP  (1)     SCRATCH, BUT USUALLY CONTAINS COMPONENT NUMBER TO BE CHANGED DURING VERIFY CYCLE
065280,000081: 
065281,000082:                                                                                          	# INPUT:
065282,000083: 
065283,000084:                                                                                          	#       ENTRY:                  DESCRIPTION
065284,000085:                                                                                          	#       V70EXXXXXEXXXXXE        (LIFTOFF TIME INCREMENT) DOUBLE PRECISION OCTAL TIME INCREMENT, XXXXX XXXXX,
065285,000086:                                                                                          	#                               IS ADDED TO TEPHEM, SUBTRACTED FROM AGC CLOCK(TIME2,TIME1), SUBTRACTED FROM CSM STATE
065286,000087:                                                                                          	#                               VECTOR TIME(TETCSM) AND SUBTRACTED FROM LEM STATE VECTOR TIME(TETLEM).
065287,000088:                                                                                          	#                               THE DP OCTAL TIME INCREMENT IS SCALED AT 2(28).
065289,000090:                                                                                          	#       V71EIIEAAAAE            (CONTIGUOUS BLOCK UPDATE) II-2 OCTAL COMPONENTS, XXXXX,
065290,000091:                                                                                          	#       XXXXXE                  ARE LOADED INTO ERASABLE STARTING AT ECADR, AAAA.
065291,000092:                                                                                          	#       XXXXXE                  IT IS .GE. 3 .AND. .LE. 20D.,
065292,000093:                                                                                          	#                               AND (AAAA + II -3) DOES NOT PRODUCE AN ADDRESS IN THE
065293,000094:                                                                                          	#       9 NEXT BANK
065294,000095:                                                                                          	#         .                     SCALING IS SAME AS INTERNAL REGISTERS.
065295,000096:                                                                                          	#       V72EIIE                 (SCATTER UPDATE) (II-1)/2 OCTAL COMPONENTS, XXXXX, ARE
065296,000097:                                                                                          	#       AAAAEXXXXXE             LOADED INTO ERASABLE LOCATIONS, AAAA.
065297,000098:                                                                                          	#       AAAAEXXXXXE             II IS .GE. 3 .AND. .LE. 19D, AND MUST BE ODD.
065298,000099:                                                                                          	#         .                     SCALING IS SAME AS INTERNAL REGISTERS.
065299,000100: 
065300,000101:                                                                                          	#       V73EXXXXXEXXXXXE        (OCTAL CLOCK INCREMENT) DOUBLE PRECISION OCTAL TIME
065301,000102:                                                                                          	#                               INCREMENT XXXXX XXXXX, IS ADDED TO THE AGC CLOCK, IN
065302,000103:                                                                                          	#                               CENTISECONDS SCALED AT (2)28.
065303,000104:                                                                                          	#                               THIS LOAD IS THE OCTAL EQUIVALENT OF V55.
065304,000105: 
065305,000106:                                                                                          	# OUTPUT:               IN ADDITION TO THE ABOVE REGISTER LOADS, ALL UPDATES
065306,000107:                                                                                          	#                       COMPLEMENT BIT3 OF FLAGWORD7.
065307,000108: 
065308,000109:                                                                                          	# ADDITIONAL NOTES:     VERB 71, JUST DEFINED ABOVE WILL BE USED TO PERFORM BUT NOT LIMITED TO THE FOLLOWING UPDATES --
065309,000110:                                                                                          	#                       1.  CSM/LM STATE VECTOR UPDATE
065310,000111:                                                                                          	#                       2.  REFSMMAT UPDATE
065311,000112: 
065312,000113:                                                                                          	#       THE FOLLOWING COMMENTS DELINEATE EACH SPECIAL UPDATE ----
065313,000114: 
065314,000115:                                                                                          	#       1.  CSM/LM STATE VECTOR UPDATE (ALL DATA ENTRIES IN OCTAL)
065315,000116:                                                                                          	#               ENTRIES:        DATA DEFINITION:                                SCALE FACTORS:
065316,000117:                                                                                          	#               V71E            CONTIGUOUS BLOCK UPDATE VERB
065317,000118:                                                                                          	#                  21E          NUMBER OF COMPONENTS FOR STATE VECTOR UPDATE
065318,000119:                                                                                          	#                AAAAE          ECADR OF 'UPSVFLAG'
065319,000120:                                                                                          	#               XXXXXE          STATE VECTOR IDENTIFIER: 00001 FOR CSM, 77776 FOR LEM - EARTH SPHERE OF INFLUENCE SCALING
065320,000121:                                                                                          	#                                                        00002 FOR CSM, 77775 FOR LEM - LUNAR SPHERE OF INFLUENCE SCALING
065321,000122:                                                                                          	#               XXXXXEXXXXXE    X POSITION
065322,000123:                                                                                          	#               XXXXXEXXXXXE    Y POSITION
065323,000124:                                                                                          	#               XXXXXEXXXXXE    Z POSITION
065324,000125:                                                                                          	#               XXXXXEXXXXXE    X VELOCITY
065325,000126:                                                                                          	#               XXXXXEXXXXXE    Y VELOCITY
065326,000127:                                                                                          	#               XXXXXEXXXXXE    Z VELOCITY
065327,000128:                                                                                          	#               XXXXXEXXXXXE    TIME FROM AGC CLOCK ZERO
065328,000129:                                                                                          	#               V33E            VERB 33 TO SIGNAL THAT THE STATE VECTOR IS READY TO BE STORED.
065329,000130: 
065330,000131:                                                                                          	#       2.  REFSMMAT (ALL DATA ENTRIES IN OCTAL)
065331,000132:                                                                                          	#               ENTRIES:                DATA DEFINITIONS:                               SCALE FACTORS:
065333,000134:                                                                                          	#               V71E            CONTIGUOUS BLOCK UPDATE VERB
065334,000135:                                                                                          	#                  24E          NUMBER OF COMPONENTS FOR REFSMMAT UPDATE
065335,000136:                                                                                          	#                AAAAE          ECADR OF 'REFSMMAT'
065336,000137:                                                                                          	#               XXXXXEXXXXXE    ROW 1 COLUMN 1                                  2(-1)
065337,000138:                                                                                          	#               XXXXXEXXXXXE    ROW 1 COLUMN 2                                  2(-1)
065338,000139:                                                                                          	#               XXXXXEXXXXXE    ROW 1 COLUMN 3                                  2(-1)
065339,000140:                                                                                          	#               XXXXXEXXXXXE    ROW 2 COLUMN 1                                  2(-1)
065340,000141:                                                                                          	#               XXXXXEXXXXXE    ROW 2 COLUMN 2                                  2(-1)
065341,000142:                                                                                          	#               XXXXXEXXXXXE    ROW 2 COLUMN 3                                  2(-1)
065342,000143:                                                                                          	#               XXXXXEXXXXXE    ROW 3 COLUMN 1                                  2(-1)
065343,000144:                                                                                          	#               XXXXXEXXXXXE    ROW 3 COLUMN 2                                  2(-1)
065344,000145:                                                                                          	#               XXXXXEXXXXXE    ROW 3 COLUMN 3                                  2(-1)
065345,000146:                                                                                          	#               V33E            VERB 33 TO SIGNAL THAT REFSMMAT IS READY TO BE STORED.
065346,000147: 
065347,000148: 07,3777                                           BANK     07                            	#
065348,000149: 43,2000                                           SETLOC   EXTVERBS                      	#
065349,000150: 43,2000                                           BANK                                   	#
065350,000151: 
065351,000152: 43,3726  E3,1706                                  EBANK=   TEPHEM                        	#
065352,000153: 
065353,000154: 43,3726                                           COUNT*   $$/P27                        	#
065354,000155: 43,3726           35021        V70UPDAT           CAF      UP70                          	# COMES HERE ON V70E
065355,000156: 43,3727           13735                           TCF      V73UPDAT   +1                 	#
065356,000157: 
065357,000158: 43,3730           35017        V71UPDAT           CAF      UP71                          	# COMES HERE ON V71E
065358,000159: 43,3731           13735                           TCF      V73UPDAT   +1                 	#
065359,000160: 
065360,000161: 43,3732           35016        V72UPDAT           CAF      UP72                          	# COMES HERE ON V72E
065361,000162: 43,3733           13735                           TCF      V73UPDAT   +1                 	#
065362,000163: 
065363,000164: 43,3734           36214        V73UPDAT           CAF      UP73                          	# COMES HERE ON V73E
065364,000165: 
065365,000166: 43,3735           54331                 +1        TS       UPVERBSV                      	# SAVE UPVERB UNTIL IT'S OK TO ENTER P27
065366,000167: 
065367,000168: 43,3736           02076                           TC       TESTXACT                      	# GRAB DISPLAY IF AVAILABLE, OTHERWISE
065368,000169:                                                                                          	# TURN *OPERATOR ERROR* ON AND TERMINATE JOB
065369,000170: 
065370,000171: 43,3737           31011                           CA       MODREG                        	# CHECK IF UPDATE ALLOWED
065371,000172: 43,3740           00006                           EXTEND                                 	# FIRST CHECK FOR MODREG = +0, -0
065372,000173: 43,3741           13743                           BZF      +2                            	# (+0 = P00, -0 = FRESHSTART)
065373,000174: 43,3742           03753                           TC       CKMDMORE                      	# NOW CHECK FOR PROGRAM WHICH CAN BE
065374,000175:                                                                                          	# INTERRUPTED BY P27.
065375,000176: 
065376,000177: 43,3743           31011                           CAE      MODREG                        	# UPDATE ALLOWED.
065377,000178: 43,3744           54301                           TS       UPOLDMOD                      	# SAVE CURRENT MAJOR MODE
065379,000180: 43,3745           30331                           CAE      UPVERBSV                      	# SET UPVERB TO INDICATE TO P27
065380,000181: 43,3746           54302                           TS       UPVERB                        	# WHICH EXTENDED VERB CALLED IT.
065381,000182: 
065382,000183: 43,3747           35017                           CAF      ONE                           	#
065383,000184: 43,3750           54303                           TS       UPCOUNT                       	# INITIALIZE UPCOUNT TO 1
065384,000185: 
065385,000186: 43,3751           04701                           TC       POSTJUMP                      	# LEAVE EXTENDED VERB BANK AND
065386,000187: 43,3752           57373                           CADR     UPPART2                       	# GO TO UPDATE PROGRAM (P27) BANK.
065387,000188: 
065388,000189: 43,3753           40101        CKMDMORE           CS       FLAGWRD5                      	#
065389,000190: 43,3754           75010                           MASK     BIT8                          	# CHECK IF COMPUTER IS LGC
065390,000191: 43,3755           10000                           CCS      A                             	# IS COMPUTER LGC OR AGC
065391,000192: 43,3756           13764        UPERLEM            TCF      UPERROR                       	# ERROR- IT'S THE LEM + MODE IS NOT POO.
065392,000193: 43,3757           45016                           CS       TWO                           	#
065393,000194: 43,3760           71011                           MASK     MODREG                        	#
065394,000195: 43,3761           10000                           CCS      A                             	#
065395,000196: 43,3762           13764        UPERCMC            TCF      UPERROR                       	# ERROR- IT'S THE CMC AND MODE IS NOT
065396,000197:                                                                                          	# P00 OR P02.
065397,000198: 43,3763           00002                           TC       Q                             	# ALLOW UPDATE TO PROCEED
065398,000199: 
065399,000200: 43,3764           04701        UPERROR            TC       POSTJUMP                      	# TURN ON 'OPERATOR ERROR' LIGHT
065400,000201: 43,3765           57754                           CADR     UPERROUT   +2                 	# GO TO COMMON UPDATE PROGRAM EXIT
065401,000202: 
065402,000203: 43,3766  30,2000                                  SBANK=   LOWSUPER                      	#
065403,000204: 43,3766     5021               UP70               EQUALS   ZERO                          	#
065404,000205: 43,3766     5017               UP71               EQUALS   ONE                           	#
065405,000206: 43,3766     5016               UP72               EQUALS   TWO                           	#
065406,000207: 43,3766     6214               UP73               EQUALS   THREE                         	#
065407,000208: 
065408,000209: 04,3757                                           BANK     04                            	#
065409,000210: 27,2000                                           SETLOC   UPDATE2                       	#
065410,000211: 27,2000                                           BANK                                   	#
065411,000212: 
065412,000213: 27,3373                                           COUNT*   $$/P27                        	#
065413,000214: 
065414,000215: 27,3373                        UPPART2            EQUALS                                 	# UPDATE PROGRAM - PART 2
065415,000216: 
065416,000217: 27,3373           05412                           TC       PHASCHNG                      	# SET RESTART GROUP 6 TO RESTORE OLD MODE
065417,000218: 27,3374           07026                           OCT      07026                         	# AND DOWNLIST AND EXIT IF RESTART OCCURS.
065418,000219: 27,3375           30000                           OCT      30000                         	# PRIORITY SAME AS CHRPRIO
065419,000220: 27,3376     0304                                  EBANK=   UPBUFF                        	#
065420,000221: 27,3376           03704 56060                     2CADR    UPOUT      +1                 	#
065421,000222: 
065422,000223: 27,3400           35017                           CAF      ONE                           	#
065423,000224: 27,3401           54332                           TS       DNLSTCOD                      	# DOWNLIST
065424,000225: 
065425,000226: 27,3402           05354                           TC       NEWMODEX                      	# SET MAJOR MODE = 27
065427,000228: 27,3403           00033                           DEC      27         B-14               	#
065428,000229: 
065429,000230: 27,3404           50302                           INDEX    UPVERB                        	# BRANCH DEPENDING ON WHETHER THE UPDATE
065430,000231: 27,3405           13406                           TCF      +1                            	# VERB REQUIRES A FIXED OR VARIABLE NUMBER
065431,000232: 27,3406           13411                           TCF      +3                            	# V70 FIXED.               (OF COMPONENTS.
065432,000233: 27,3407           13414                           TCF      OHWELL1                       	# V71 VARIABLE - GO GET NO. OF COMPONENTS
065433,000234: 27,3410           13414                           TCF      OHWELL1                       	# V72 VARIABLE - GO GET NO. OF COMPONENTS
065434,000235: 27,3411           35016                           CA       TWO                           	# V73 (AND V70) FIXED
065435,000236: 27,3412           54300                           TS       COMPNUMB                      	# SET NUMBER OF COMPONENTS TO 2.
065436,000237: 27,3413           13437                           TCF      OHWELL2                       	# GO GET THE TWO UPDATE COMPONENTS
065437,000238: 
065438,000239: 27,3414           33507        OHWELL1            CAF      ADUPBUFF                      	# * REQUEST USER TO SEND NUMBER  *
065439,000240: 27,3415           54156                           TS       MPAC       +2                 	# * OF COMPONENTS PARAMETER(II). *
065440,000241: 27,3416           33510                 +2        CAF      UPLOADNV                      	# (CK4V32 RETURNS HERE IF V32 ENCOUNTERED)
065441,000242: 27,3417           04662                           TC       BANKCALL                      	# DISPLAY A FLASHING V21N01
065442,000243: 27,3420           20561                           CADR     GOXDSPF                       	# TO REQUEST II.
065443,000244: 27,3421           13704                           TCF      UPOUT4                        	# V34 TERMINATE UPDATE (P27) RETURN
065444,000245: 27,3422           13416                           TCF      OHWELL1    +2                 	#
065445,000246: 27,3423           03500                           TC       CK4V32                        	# DATA OR V32 RETURN
065446,000247: 27,3424           45016                           CS       BIT2                          	#
065447,000248: 27,3425           60304                           AD       UPBUFF                        	# IS II (NUMBER OF COMPONENTS PARAMETER)
065448,000249: 27,3426           00006                           EXTEND                                 	# .GE. 3 AND .LE. 20D.
065449,000250: 27,3427           63416                           BZMF     OHWELL1    +2                 	#
065450,000251: 27,3430           40304                           CS       UPBUFF                        	#
065451,000252: 27,3431           64376                           AD       UP21                          	#
065452,000253: 27,3432           00006                           EXTEND                                 	#
065453,000254: 27,3433           63416                           BZMF     OHWELL1    +2                 	#
065454,000255: 27,3434           30304                           CAE      UPBUFF                        	#
065455,000256: 27,3435           54300                           TS       COMPNUMB                      	# SAVE II IN COMPNUMB
065456,000257: 
065457,000258:                                                                                          	# UPBUFF LOADING SEQUENCE
065458,000259: 
065459,000260: 27,3436           24303                           INCR     UPCOUNT                       	# INCREMENT COUNT OF COMPONENTS RECEIVED.
065460,000261: 27,3437           33654        OHWELL2            CAF      ADUPBFM1                      	# CALCULATE LOCATION (ECADR) IN UPBUFF
065461,000262: 27,3440           60303                           AD       UPCOUNT                       	# WHERE NEXT COMPONENT SHOULD BE STORED.
065462,000263: 27,3441           54156                 +2        TS       MPAC       +2                 	# PLACE ECADR INTO R3.
065463,000264: 27,3442           33510                 +3        CAF      UPLOADNV                      	# (CK4V32 RETURNS HERE IF V32 ENCOUNTERED)
065464,000265: 27,3443           04662                           TC       BANKCALL                      	# DISPLAY A FLASHING V21N01
065465,000266: 27,3444           20561                           CADR     GOXDSPF                       	# TO REQUEST DATA.
065466,000267: 27,3445           13704                           TCF      UPOUT4                        	# V34 TERMINATE UPDATE (P27) RETURN.
065467,000268: 27,3446           13442                           TCF      OHWELL2    +3                 	# V33 PROCEED RETURN
065468,000269: 27,3447           03500                           TC       CK4V32                        	# DATA OR V32 RETURN
065469,000270: 27,3450           40303                           CS       UPCOUNT                       	# HAVE WE FINISHED RECEIVING ALL
065470,000271: 27,3451           60300                           AD       COMPNUMB                      	# THE DATA WE EXPECTED.
065471,000272: 27,3452           00006                           EXTEND                                 	#
065472,000273: 27,3453           63455                           BZMF     UPVERIFY                      	# YES- GO TO VERIFICATION SEQUENCE
065473,000274: 27,3454           13436                           TCF      OHWELL2    -1                 	# NO- REQUEST ADDITIONAL DATA.
065474,000275: 
065476,000277:                                                                                          	# VERIFY SEQUENCE
065477,000278: 27,3455           33506        UPVERIFY           CAF      ADUPTEMP                      	# PLACE ECADR WHERE COMPONENT NO. INDEX
065478,000279: 27,3456           54156                           TS       MPAC       +2                 	# IS TO BE STORED INTO R3.
065479,000280: 27,3457           33511                           CAF      UPVRFYNV                      	# (CK4V32 RETURNS HERE IF V32 ENCOUNTERED)
065480,000281: 27,3460           04662                           TC       BANKCALL                      	# DISPLAY A FLASHING V21N02 TO REQUEST
065481,000282: 27,3461           20561                           CADR     GOXDSPF                       	# DATA CORRECTION OR VERIFICATION.
065482,000283: 27,3462           13704                           TCF      UPOUT4                        	# V34 TERMINATE UPDATE (P27) RETURN
065483,000284: 27,3463           13512                           TCF      UPSTORE                       	# V33 DATA SENT IS GOOD.  GO STORE IT.
065484,000285: 27,3464           03500                           TC       CK4V32                        	# COMPONENT NO. INDEX OR V32 RETURN
065485,000286: 27,3465           30330                           CA       UPTEMP                        	# DOES THE COMPONENT NO. INDEX JUST SENT
065486,000287: 27,3466           00006                           EXTEND                                 	# SPECIFY A LEGAL COMPONENT NUMBER?
065487,000288: 27,3467           63455                           BZMF     UPVERIFY                      	# NO, IT IS NOT POSITIVE NONZERO
065488,000289: 27,3470           40330                           CS       UPTEMP                        	#
065489,000290: 27,3471           60300                           AD       COMPNUMB                      	#
065490,000291: 27,3472           65017                           AD       BIT1                          	#
065491,000292: 27,3473           00006                           EXTEND                                 	#
065492,000293: 27,3474           63455                           BZMF     UPVERIFY                      	# NO
065493,000294: 27,3475           33654                           CAF      ADUPBFM1                      	# YES- BASED ON THE COMPONENT NO. INDEX
065494,000295: 27,3476           60330                           AD       UPTEMP                        	# CALCULATE THE ECADR OF LOCATION IN
065495,000296: 27,3477           13441                           TCF      OHWELL2    +2                 	# UPBUFF WHICH USER WANTS TO CHANGE.
065496,000297: 
065497,000298: 27,3500  27,3704               UPOUT4             EQUALS   UPOUT      +1                 	# COMES HERE ON V34 TO TERMINATE UPDATE
065498,000299: 
065499,000300:                                                                                          	# CHECK FOR VERB 32 SEQUENCE
065500,000301: 
065501,000302: 27,3500           40154        CK4V32             CS       MPAC                          	# ON DATA RETURN FROM 'GOXDSPF'
065502,000303: 27,3501           75012                           MASK     BIT6                          	# ON DATA RETURN FROM "GOXDSP"& THE CON-
065503,000304: 27,3502           10000                           CCS      A                             	# TENTS OF MPAC = VERB.  SO TEST FOR V32.
065504,000305: 27,3503           00002                           TC       Q                             	# IT'S NOT A V32, IT'S DATA.  PROCEED.
065505,000306: 27,3504           50002                           INDEX    Q                             	#
065506,000307: 27,3505           77771                           TC       0          -6                 	# V32 ENCOUNTERED - GO BACK AND GET DATA
065507,000308: 
065508,000309: 27,3506           00330        ADUPTEMP           ADRES    UPTEMP                        	# ADDRESS OF TEMP STORAGE FOR CORRECTIONS
065509,000310: 27,3507           00304        ADUPBUFF           ADRES    UPBUFF                        	# ADDRESS OF UPDATE DATA STORAGE BUFFER
065510,000311: 27,3510           05201        UPLOADNV           VN       2101                          	# VERB 21 NOUN 01
065511,000312: 27,3511           05202        UPVRFYNV           VN       2102                          	# VERB 21 NOUN 02
065512,000313: 27,3512     4376               UP21               =        MD1                           	# DEC 21 = MAX NO OF COMPONENTS +1
065513,000314: 27,3512     5022               UPDTPHAS           EQUALS   FIVE                          	#
065514,000315: 
065515,000316:                                                                                          	# PRE-STORE AND FAN TO APPROPRIATE BRANCH SEQUENCE
065516,000317: 
065517,000318: 27,3512                        UPSTORE            EQUALS                                 	# GROUND HAS VERIFIED UPDATE.  STORE DATA.
065518,000319: 
065519,000320: 27,3512           00004                           INHINT                                 	#
065520,000321: 
065521,000322: 27,3513           30103                           CAE      FLAGWRD7                      	# INVERT VERIFLAG (BIT 3 OF FLAGWRD7) TO
065522,000323: 27,3514           56001                           XCH      L                             	# INDICATE TO THE GROUND (VIA DOWNLINK)
065523,000324: 27,3515           35015                           CAF      BIT3                          	# THAT THE V33 (WHICH THE GROUND SENT TO
065525,000326: 27,3516           00006                           EXTEND                                 	# VERIFY THE UPDATE) HAS BEEN SUCCESSFULLY
065526,000327: 27,3517           06001                           RXOR     LCHAN                         	# RECEIVED BY THE UPDATE PROGRAM
065527,000328: 27,3520           54103                           TS       FLAGWRD7                      	#
065528,000329: 
065529,000330: 27,3521           05412                           TC       PHASCHNG                      	# SET RESTART GROUP 6 TO REDO THE UPDATE
065530,000331: 27,3522           04026                           OCT      04026                         	# DATA STORE IF A RESTART OCCURS.
065531,000332: 27,3523           00004                           INHINT                                 	# (BECAUSE PHASCHNG DID A RELINT)
065532,000333: 
065533,000334: 27,3524           45016                           CS       TWO                           	# GO TO UPFNDVAC IF INSTALL IS REQUIRED,
065534,000335: 27,3525           60302                           AD       UPVERB                        	# THAT IS, IF IT'S A V70 - V72.
065535,000336: 27,3526           00006                           EXTEND                                 	# GO TO UPEND73 IF IT'S A V73.
065536,000337: 27,3527           63536                           BZMF     UPFNDVAC                      	#
065537,000338: 
065538,000339:                                                                                          	# VERB 73 BRANCH
065539,000340: 
065540,000341: 27,3530           00006        UPEND73            EXTEND                                 	# V73-PERFORM DP OCTAL AGC CLOCK INCREMENT
065541,000342: 27,3531           30305                           DCA      UPBUFF                        	#
065542,000343: 27,3532           52315                           DXCH     UPBUFF     +8D                	#
065543,000344: 27,3533           03561                           TC       TIMEDIDL                      	#
065544,000345: 27,3534           04400                           TC       FALTON                        	# ERROR- TURN ON *OPERATOR ERROR* LIGHT
065545,000346: 27,3535           03704                           TC       UPOUT      +1                 	# GO TO COMMON UPDATE PROGRAM EXIT
065546,000347: 
065547,000348: 27,3536           34371        UPFNDVAC           CAF      CHRPRIO                       	# (USE EXTENDED VERB PRIORITY)
065548,000349: 27,3537           05147                           TC       FINDVAC                       	# GET VAC AREA FOR 'CALL INTSTALL'
065549,000350: 27,3540  E3,1706                                  EBANK=   TEPHEM                        	#
065550,000351: 27,3540           03543 56063                     2CADR    UPJOB                         	# (NOTE:  THIS WILL ALSO SET EBANK FOR
065551,000352: 27,3542           05217                           TC       ENDOFJOB                      	# 'TEPHEM' UPDATE BY V70)
065552,000353: 
065553,000354: 27,3543           06006        UPJOB              TC       INTPRET                       	# THIS COULD BE A STATE VECTOR UPDATE -- SO
065554,000355: 27,3544           77624                           CALL                                   	# WAIT (PUT JOB TO SLEEP) IF ORBIT INT(OI)
065555,000356: 27,3545           27442                                    INTSTALL                      	# IS IN PROGRESS -- OR -- GRAB OI AND RETURN
065556,000357:                                                                                          	# TO UPWAKE IF OI IS NOT IN PROGRESS.
065557,000358: 
065558,000359: 27,3546           77776        UPWAKE             EXIT                                   	#
065559,000360: 
065560,000361: 27,3547           05412                           TC       PHASCHNG                      	# RESTART PROTECT (GROUP 6)
065561,000362: 27,3550           04026                           OCT      04026                         	#
065562,000363: 
065563,000364: 27,3551           05546                           TC       UPFLAG                        	# SET INTEGRATION RESTART BIT
065564,000365: 27,3552           00236                           ADRES    REINTFLG                      	#
065565,000366: 27,3553           00004                           INHINT                                 	#
065566,000367: 27,3554                        UPPART3            EQUALS                                 	#
065567,000368: 
065568,000369: 27,3554           50302                           INDEX    UPVERB                        	# BRANCH TO THE APPROPRIATE UPDATE VERB
065569,000370: 27,3555           13556                           TCF      +1                            	# ROUTINE TO ACTUALLY PERFORM THE UPDATE
065570,000371: 27,3556           13715                           TCF      UPEND70                       	# V70
065571,000372: 27,3557           13624                           TCF      UPEND71                       	# V71
065572,000373: 27,3560           13656                           TCF      UPEND72                       	# V72
065573,000374: 
065575,000376:                                                                                          	# ROUTINE TO INCREMENT CLOCK (TIME2,TIME1) WITH CONTENTS OF DP WORD AT UPBUFF.
065576,000377: 27,3561           00006        TIMEDIDL           EXTEND                                 	#
065577,000378: 27,3562           22330                           QXCH     UPTEMP                        	# SAVE Q FOR RETURN
065578,000379: 27,3563           35021                           CAF      ZERO                          	# ZERO AND SAVE TIME2,TIME1
065579,000380: 27,3564           22007                           ZL                                     	#
065580,000381: 27,3565           52025                           DXCH     TIME2                         	#
065581,000382: 27,3566           52327                           DXCH     UPBUFF     +18D               	# STORE IN CASE OF OVERFLOW
065582,000383: 
065583,000384: 27,3567           35022                           CAF      UPDTPHAS                      	# DO
065584,000385: 27,3570           54001                           TS       L                             	# A
065585,000386: 27,3571           40000                           COM                                    	# QUICK
065586,000387: 27,3572           52765                           DXCH     -PHASE6                       	# PHASCHNG
065587,000388: 
065588,000389: 27,3573           00004        TIMEDIDR           INHINT                                 	#
065589,000390: 27,3574           35021                           CAF      ZERO                          	#
065590,000391: 27,3575           22007                           ZL                                     	# PICK UP INCREMENTER(AND ZERO
065591,000392: 27,3576           54156                           TS       MPAC       +2                 	# IT IN CASE OF RESTARTS) AND
065592,000393: 27,3577           52315                           DXCH     UPBUFF     +8D                	# STORE IT
065593,000394: 27,3600           52155                           DXCH     MPAC                          	# INTO MPAC FOR TPAGREE.
065594,000395: 
065595,000396: 27,3601           00006                           EXTEND                                 	#
065596,000397: 27,3602           30327                           DCA      UPBUFF     +18D               	#
065597,000398: 27,3603           20155                           DAS      MPAC                          	# FORM SUM IN MPAC
065598,000399: 27,3604           00006                           EXTEND                                 	#
065599,000400: 27,3605           13614                           BZF      DELTAOK                       	# TEST FOR OVERFLOW
065600,000401: 27,3606           35021                           CAF      ZERO                          	#
065601,000402: 27,3607           52327                           DXCH     UPBUFF     +18D               	# OVERFLOW, RESTORE OLD VALUE OF CLOCK
065602,000403: 27,3610           20025                           DAS      TIME2                         	# AND TURN ON OPERATOR ERROR
065603,000404: 
065604,000405: 27,3611           05412                           TC       PHASCHNG                      	# RESTART PROTECT (GROUP 6)
065605,000406: 27,3612           04026                           OCT      04026                         	#
065606,000407: 
065607,000408: 27,3613           00330                           TC       UPTEMP                        	# GO TO ERROR EXIT
065608,000409: 
065609,000410: 27,3614           07226        DELTAOK            TC       TPAGREE                       	# FORCE SIGN AGREEMENT
065610,000411: 27,3615           52155                           DXCH     MPAC                          	#
065611,000412: 27,3616           20025                           DAS      TIME2                         	# INCREMENT TIME2,TIME1
065612,000413: 
065613,000414: 27,3617           05412                           TC       PHASCHNG                      	# RESTART PROTECT (GROUP 6)
065614,000415: 27,3620           04026                           OCT      04026                         	#
065615,000416: 
065616,000417: 27,3621           00004                           INHINT                                 	#
065617,000418: 27,3622           50330                           INDEX    UPTEMP                        	# (CODED THIS WAY FOR RESTART PROTECTION)
065618,000419: 27,3623           00001                           TC       1                             	# NORMAL RETURN
065619,000420: 
065620,000421:                                                                                          	# VERB 71 BRANCH
065621,000422: 
065622,000423: 27,3624           30305        UPEND71            CAE      UPBUFF     +1                 	# SET EBANK
065623,000424: 27,3625           54003                           TS       EBANK                         	#       AND
065625,000426: 27,3626           74373                           MASK     LOW8                          	# CALCULATE
065626,000427: 27,3627           54330                           TS       UPTEMP                        	# S-REG VALUE OF RECEIVING AREA
065627,000428: 27,3630           67714                           AD       NEG3                          	# IN THE PROCESS OF
065628,000429: 27,3631           60300                           AD       COMPNUMB                      	# PERFORMING
065629,000430: 27,3632           00006                           EXTEND                                 	# THIS UPDATE
065630,000431: 27,3633           13641                           BZF      STORLP71                      	# WILL WE
065631,000432: 27,3634           75007                           MASK     BIT9                          	# OVERFLOW
065632,000433: 27,3635           10000                           CCS      A                             	# INTO THE NEXT EBANK....
065633,000434: 27,3636           13752                           TCF      UPERROUT                      	# YES
065634,000435: 
065635,000436: 27,3637           37714                           CA       NEG3                          	# NO- CALCULATE NUMBER OF
065636,000437: 27,3640           60300                           AD       COMPNUMB                      	# WORDS TO BE STORED MINUS ONE
065637,000438: 27,3641           54154        STORLP71           TS       MPAC                          	# SAVE NO. OF WORDS REMAINING MINUS ONE
065638,000439: 27,3642           50000                           INDEX    A                             	# TAKE NEXT UPDATE WORD FROM
065639,000440: 27,3643           30306                           CA       UPBUFF     +2                 	# UPBUFF AND
065640,000441: 27,3644           54001                           TS       L                             	# SAVE IT IN L
065641,000442: 27,3645           30154                           CA       MPAC                          	# CALCULATE NEXT
065642,000443: 27,3646           60330                           AD       UPTEMP                        	# RECEIVING ADDRESS
065643,000444: 27,3647           50000                           INDEX    A                             	#
065644,000445: 27,3650  E3,1400                                  EBANK=   1400                          	#
065645,000446: 27,3650           23400                           LXCH     1400                          	# UPDATE THE REGISTER BY CONTENTS OF L
065646,000447: 27,3651  E3,1706                                  EBANK=   TEPHEM                        	#
065647,000448: 27,3651           10154                           CCS      MPAC                          	# ARE THERE ANY WORDS LEFT TO BE STORED
065648,000449: 27,3652           13641                           TCF      STORLP71                      	# YES
065649,000450: 27,3653           13703                           TCF      UPOUT                         	# NO- THEN EXIT UPDATE PROGRAM
065650,000451: 27,3654           00303        ADUPBFM1           ADRES    UPBUFF     -1                 	# SAME AS ADUPBUFF BUT LESS 1 (DON'T MOVE)
065651,000452: 27,3655           13703                           TCF      UPOUT                         	# NO- EXIT UPDATE (HERE WHEN COMPNUMB = 3)
065652,000453: 
065653,000454:                                                                                          	# VERB 72 BRANCH
065654,000455: 
065655,000456: 27,3656           35017        UPEND72            CAF      BIT1                          	# HAVE AN ODD NO. OF COMPONENTS
065656,000457: 27,3657           70300                           MASK     COMPNUMB                      	# BEEN SENT FOR A V72 UPDATE ...
065657,000458: 27,3660           10000                           CCS      A                             	#
065658,000459: 27,3661           13663                           TCF      +2                            	# YES
065659,000460: 27,3662           13752                           TCF      UPERROUT                      	# ERROR- SHOULD BE ODD NO. OF COMPONENTS
065660,000461: 27,3663           45016                           CS       BIT2                          	#
065661,000462: 27,3664           60300                           AD       COMPNUMB                      	#
065662,000463: 27,3665           54154        LDLOOP72           TS       MPAC                          	# NOW PERFORM THE UPDATE
065663,000464: 27,3666           50000                           INDEX    A                             	#
065664,000465: 27,3667           30305                           CAE      UPBUFF     +1                 	# PICK UP NEXT UPDATE WORD
065665,000466: 27,3670           22000                           LXCH     A                             	#
065666,000467: 27,3671           10154                           CCS      MPAC                          	# SET POINTER TO ECADR (MUST BE CCS)
065667,000468: 27,3672           54154                           TS       MPAC                          	#
065668,000469: 27,3673           50000                           INDEX    A                             	#
065669,000470: 27,3674           30305                           CAE      UPBUFF     +1                 	# PICK UP NEXT ECADR OF REG TO BE UPDATED
065670,000471: 27,3675           54003                           TS       EBANK                         	# SET EBANK
065671,000472: 27,3676           74373                           MASK     LOW8                          	# ISOLATE RELATIVE ADDRESS
065672,000473: 27,3677           50000                           INDEX    A                             	#
065673,000474: 
065675,000476: 27,3700  E3,1400                                  EBANK=   1400                          	#
065676,000477: 27,3700           23400                           LXCH     1400                          	# UPDATE THE REGISTER BY CONTENTS OF L
065677,000478: 27,3701  E3,1706                                  EBANK=   TEPHEM                        	#
065678,000479: 27,3701           10154                           CCS      MPAC                          	# ARE WE THROUGH THE V72 UPDATE...
065679,000480: 27,3702           13665                           TCF      LDLOOP72                      	# NO
065680,000481: 
065681,000482:                                                                                          	# NORMAL FINISH OF P27
065682,000483: 
065683,000484: 27,3703                        UPOUT              EQUALS                                 	#
065684,000485: 27,3703           02671                           TC       INTWAKEU                      	# RELEASE GRAB OF ORBITAL INTEGRATION
065685,000486: 27,3704           30301                 +1        CAE      UPOLDMOD                      	# RESTORE PRIOR P27 MODE
065686,000487: 27,3705           05357                           TC       NEWMODEX   +3                 	#
065687,000488: 27,3706           35021                           CAF      ZERO                          	#
065688,000489: 27,3707           54332                           TS       DNLSTCOD                      	#
065689,000490: 27,3710           03757                           TC       UPACTOFF                      	# TURN OFF 'UPLINK ACTIVITY' LIGHT
065690,000491: 27,3711           00006                           EXTEND                                 	# KILL GROUP 6.
065691,000492: 27,3712           35021                           DCA      NEG0                          	#
065692,000493: 27,3713           52765                           DXCH     -PHASE6                       	#
065693,000494: 
065694,000495: 27,3714           05534                           TC       ENDEXT                        	# EXTENDED VERB EXIT
065695,000496: 
065696,000497:                                                                                          	# VERB 70 BRANCH
065697,000498: 
065698,000499: 27,3715           00006        UPEND70            EXTEND                                 	# V70 DOES THE FOLLOWING WITH DP DELTA
065699,000500: 27,3716           40305                           DCS      UPBUFF                        	# TIME IN UPBUFF
065700,000501: 27,3717           52315                           DXCH     UPBUFF     +8D                	#
065701,000502: 27,3720           03561                           TC       TIMEDIDL                      	# DECREMENT AGC CLOCK
065702,000503: 
065703,000504: 27,3721           03752                           TC       UPERROUT                      	# ERROR WHILE DECREMENTING CLOCK -- EXIT
065704,000505: 
065705,000506: 27,3722  E3,1706                                  EBANK=   TEPHEM                        	#
065706,000507: 27,3722           00006                           EXTEND                                 	#
065707,000508: 27,3723           40305                           DCS      UPBUFF                        	# COPY DECREMENTERS FOR
065708,000509: 27,3724           52317                           DXCH     UPBUFF     +10D               	# RESTART PROTECTION
065709,000510: 27,3725           00006                           EXTEND                                 	#
065710,000511: 27,3726           40305                           DCS      UPBUFF                        	#
065711,000512: 27,3727           52321                           DXCH     UPBUFF     +12D               	#
065712,000513: 
065713,000514: 27,3730           05412                           TC       PHASCHNG                      	# RESTART PROTECT (GROUP 6)
065714,000515: 27,3731           04026                           OCT      04026                         	#
065715,000516: 
065716,000517: 27,3732           35021                           CAF      ZERO                          	#
065717,000518: 27,3733           22007                           ZL                                     	#
065718,000519: 27,3734           52317                           DXCH     UPBUFF     +10D               	# DECREMENT CSM STATE VECTOR TIME
065719,000520: 27,3735           21571                           DAS      TETCSM                        	#
065720,000521: 
065721,000522: 27,3736           35021                           CAF      ZERO                          	#
065722,000523: 
065724,000525: 27,3737           22007                           ZL                                     	#
065725,000526: 27,3740           52321                           DXCH     UPBUFF     +12D               	# DECREMENT LEM STATE VECTOR TIME
065726,000527: 27,3741           21643                           DAS      TETLEM                        	#
065727,000528: 27,3742           35021                           CAF      ZERO                          	#
065728,000529: 27,3743           22007                           ZL                                     	#
065729,000530: 27,3744           52305                           DXCH     UPBUFF                        	#
065730,000531: 27,3745           21710                           DAS      TEPHEM     +1                 	# INCREMENT TP TEPHEM
065731,000532: 27,3746           27706                           ADS      TEPHEM                        	#
065732,000533: 
065733,000534: 27,3747           05412                           TC       PHASCHNG                      	# RESTART PROTECT (GROUP 6)
065734,000535: 27,3750           04026                           OCT      04026                         	#
065735,000536: 
065736,000537: 27,3751     0304                                  EBANK=   UPBUFF                        	#
065737,000538: 
065738,000539: 27,3751           03703                           TC       UPOUT                         	# GO TO STANDARD UPDATE PROGRAM EXIT
065739,000540: 
065740,000541:                                                                                          	# ERROR SEQUENCE
065741,000542: 
065742,000543: 27,3752           04400        UPERROUT           TC       FALTON                        	# TURN ON *OPERATOR ERROR* LIGHT
065743,000544: 27,3753           13703                           TCF      UPOUT                         	# GO TO COMMON UPDATE PROGRAM EXIT
065744,000545: 
065745,000546: 27,3754           04400                 +2        TC       FALTON                        	# TURN ON 'OPERATOR ERROR' LIGHT
065746,000547: 27,3755           03757                           TC       UPACTOFF                      	# TURN OFF 'UPLINK ACTIVITY' LIGHT
065747,000548: 27,3756           05534                           TC       ENDEXT                        	# EXTENDED VERB EXIT
065748,000549:                                                                                          	# (THE PURPOSE OF UPERROUT +2 EXIT IS
065749,000550:                                                                                          	# TO PROVIDE AN ERROR EXIT WHICH DOES NOT
065750,000551:                                                                                          	# RESET ANY RESTART GROUPS)
065751,000552: 
065752,000553:                                                                                          	# :UPACTOFF: IS A ROUTINE TO TURN OFF UPLINK ACTIVITY LIGHT ON ALL EXITS FROM UPDATE PROGRAM (P27).
065753,000554: 
065754,000555: 27,3757           45015        UPACTOFF           CS       BIT3                          	#
065755,000556: 27,3760           00006                           EXTEND                                 	# TURN OFF UPLINK ACTIVITY LIGHT
065756,000557: 27,3761           03011                           WAND     DSALMOUT                      	# (BIT 3 OF CHANNEL 11)
065757,000558: 27,3762           00002                           TC       Q                             	#
(End of include-file UPDATE_PROGRAM.agc, resuming MAIN.agc)

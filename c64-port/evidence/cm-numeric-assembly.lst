004837,003202: E6,1541  E6,1722               GAMA               EQUALS   JETEM      +2                 	# 1P
004838,003203: E6,1541  E6,1723               GAMDOT             EQUALS   GAMA       +1                 	# 1P
004839,003204: E6,1541  E6,1724               POSEXIT            EQUALS   GAMDOT     +1                 	# 1P
004840,003205: E6,1541  E6,1725               CM/GYMDT           EQUALS   POSEXIT    +1                 	# 1P
004841,003206: E6,1541  E6,1726               HEADSUP            EQUALS   CM/GYMDT   +1                 	# 1P DSP NOUN 61 FOR P62,63,64,67.
004842,003207: E6,1541  E6,1727               P63FLAG            EQUALS   HEADSUP    +1                 	# 1P INTERLOCK FOR WAKEP62
004843,003208: 
004844,003209:                                                                                          	#>> SHARE BELOW WITH RCS RUPT TEMPS (< 15D) <<<

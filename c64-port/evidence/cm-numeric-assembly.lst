049899,000646:                                                                                          	# Page 1128
049900,000647:                                                                                          	# SEQUENCE CHANGING AND SUBROUTINE CALLING OPTIONS.
049901,000648: 
049902,000649:                                                                                          	# THE FOLLOWING OPERATIONS ARE AVAILABLE FOR SEQUENCING CHANGING, BRANCHING, AND CALLING SUBROUTINES:
049903,000650:                                                                                          	#       1.      GOTO            GO TO.
049904,000651:                                                                                          	#       2.      CALL            CALL SUBROUTINE SETTING QPRET.
049905,000652:                                                                                          	#       3.      CGOTO           COMPUTED GO TO.
049906,000653:                                                                                          	#       4.      CCALL           COMPUTED CALL.
049907,000654:                                                                                          	#       7.      BPL             BRANCH IF MPAC POSITIVE OR ZERO.
049908,000655:                                                                                          	#       8.      BZE             BRANCH IF MPAC ZERO.
049909,000656:                                                                                          	#       9.      BMN             BRANCH IF MPAC NEGATIVE NON-ZERO.
049910,000657: 
049911,000658:    6575           24164        CCALL              INCR     LOC                           	# MAINTAIN LOC FOR QPRET COMPUTATION
049912,000659:    6576           50164                           INDEX    LOC                           	#
049913,000660:                                                                                          	# Was CAF --- RSB 2009.
049914,000661:    6577           30000                           CA       0                             	# GET BASE ADDRESS OF CADR LIST.
049915,000662:    6600           50116                           INDEX    ADDRWD                        	#
049916,000663:    6601           60000                           AD       0                             	# ADD INCREMENT.
049917,000664:    6602           54004                           TS       FBANK                         	# SELECT DESIRED CADR.
049918,000665:    6603           75054                           MASK     LOW10                         	#
049919,000666:    6604           50000                           INDEX    A                             	#
049920,000667:    6605           32000                           CAF      10000                         	#
049921,000668:    6606           54117                           TS       POLISH                        	#
049922,000669: 
049923,000670:    6607           30165        CALL               CA       BANKSET                       	# FOR ANY OF THE CALL OPTIONS, MAKE UP THE
049924,000671:    6610           74364                           MASK     BANKMASK                      	# ADDRESS OF THE NEXT OP-CODE PAIR/STORE
049925,000672:    6611           64364                           AD       BANKMASK                      	# CODE AND LEAVE IT IN QPRET.  NOTE THAT
049926,000673:    6612           60164                           AD       LOC                           	# BANKMASK = -(2000 - 1).
049927,000674:    6613           50120                           INDEX    FIXLOC                        	#
049928,000675:    6614           54052                           TS       QPRET                         	#
049929,000676: 
049930,000677:    6615           30117        GOTO               CA       POLISH                        	# BASIC BRANCHING SEQUENCE.
049931,000678:    6616           77711                 +1        MASK     HIGH4                         	#
049932,000679:    6617           00006                           EXTEND                                 	#
049933,000680:    6620           16631                           BZF      GOTOERS                       	# SEE IF ADDRESS POINTS TO FIXED OR ERAS.
049934,000681:    6621           30165                 +4        CA       BANKSET                       	# SET EBANK PART OF BBANK.  NEXT, SET UP
049935,000682:    6622           54006                           TS       BBANK                         	# FBANK.  THE COMBINATION IS PICKED UP &
049936,000683:    6623           30117                           CA       POLISH                        	# PUT INTO BANKSET AT INTPRET +2.
049937,000684:    6624           54004                           TS       FBANK                         	#
049938,000685:    6625           75054                           MASK     LOW10                         	#
049939,000686:    6626           65005                           AD       2K                            	#
049940,000687:    6627           54164                           TS       LOC                           	#
049941,000688:    6630           16011                           TCF      INTPRET    +3                 	#
049942,000689: 
049943,000690:    6631  E3,1400                                  EBANK=   1400                          	# SO YUL DOESN'T CUSS THE "CA 1400" BELOW.
049944,000691: 
049945,000692:    6631           30117        GOTOERS            CA       POLISH                        	# THE GIVEN ADDRESS IS IN ERASABLE -- SEE
049946,000693:    6632           66220                           AD       -ENDVAC                       	# IF RELATIVE TO THE WORK ARA.
049947,000694:    6633           10000                           CCS      A                             	#
049948,000695:    6634           30117                           CA       POLISH                        	# GENERAL ERASABLE.
049949,000696:    6635           16644                           TCF      GOTOGE                        	#
049950,000697: 
049951,000698:                                                                                          	# Page 1129
049952,000699:    6636           30120                           CA       FIXLOC                        	# WORK AREA.
049953,000700:    6637           60117                           AD       POLISH                        	#
049954,000701:    6640           50000                           INDEX    A                             	# USE THE GIVEN ADDRESS AS THE ADDRESS OF
049955,000702:    6641           30000                           CA       0                             	# THE BRANCH ADDRESS.
049956,000703:    6642           54117                           TS       POLISH                        	#
049957,000704:    6643           16616                           TCF      GOTO       +1                 	# ALLOWS ARBITRARY INDIRECTNESS LEVELS.
049958,000705: 
049959,000706:    6644           54003        GOTOGE             TS       EBANK                         	#
049960,000707:    6645           74373                           MASK     LOW8                          	#
049961,000708:    6646           50000                           INDEX    A                             	# USE THE GIVEN ADDRESS AS THE ADDRESS OF
049962,000709:    6647           31400                           CA       1400                          	# THE BRANCH ADDRESS.
049963,000710:    6650           54117                           TS       POLISH                        	#
049964,000711:    6651           16616                           TCF      GOTO       +1                 	#
049965,000712: 

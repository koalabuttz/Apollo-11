016467,003245:                                                                                          	# BIT1=1 BLANKS R1, BIT2=1 BLANKS R2, BIT3=1 BLANKS R3.
016468,003246:                                                                                          	# ANY COMBINATION OF THESE BITS IS ACCEPTED.

052117,002864: 01,2432           16030                           TCF      DANZIG                        	#
052118,002865: 
052119,002866: 01,2433           02466        INCR               TC       TAGSUB                        	# INCREMENT INDEX REGISTER.
052120,002867: 01,2434           30117                           CA       POLISH                        	#
052121,002868: 01,2435           12430                           TCF      XAD2                          	#
052122,002869: 
052123,002870: 01,2436           02454        XSU                TC       15ADRERS                      	# SUBTRACT ERASABLE FROM INDEX REGISTER.
052124,002871: 01,2437           50117                           INDEX    POLISH                        	#

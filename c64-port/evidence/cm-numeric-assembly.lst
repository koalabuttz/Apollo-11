000407,000261:                                                                                          	# IN THE FOLLOWING NOUN LIST THE :NO LOAD: RESTRICTION MEANS THE NOUN
000408,000262:                                                                                          	# CONTAINS AT LEAST ONE COMPONENT WHICH CANNOT BE LOADED, I.E. OF
000409,000263:                                                                                          	# SCALE TYPE L (MIN/SEC) OR PP (2 INTEGERS).
000410,000264: 
000411,000265:                                                                                          	# IN THIS CASE VERBS 24 AND 25 ARE NOT ALLOWED, BUT VERBS 21, 22 OR 23
000412,000266:                                                                                          	# MAY BE USED TO LOAD ANY OF THE NOUN:S COMPONENTS WHICH ARE NOT OF THE
000413,000267:                                                                                          	# ABOVE SCALE TYPES.
000414,000268: 
000415,000269:                                                                                          	# THE :DEC ONLY: RESTRICTION MEANS ONLY DECIMAL OPERATION IS ALLOWED ON
000416,000270:                                                                                          	# EVERY COMPONENT IN THENOUN.  (NOTE THAT :NO LOAD: IMPLIES :DEC ONLY:.)
000417,000271: 
000418,000272:                                                                                          	# NORMAL NOUNS                             COMPONENTS   SCALE AND DECIMAL POINT RESTRICTIONS
000419,000273: 
000420,000274:                                                                                          	# 00    NOT IN USE

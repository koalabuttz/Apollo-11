035366,000046:                                                                                          	# PROGRAM:      P61
035367,000047:                                                                                          	# MOD NO.:      0       MAR. 13, 1967
035368,000048:                                                                                          	# MOD BY:       R. HIRSCHKOP
035369,000049:                                                                                          	# MOD NO: 1     MOD BY:  RR BAIRNSFATHER        DATE: 22 JUN 67         RESTARTS.
035370,000050:                                                                                          	# MOD NO: 2     MOD BY:  RR BAIRNSFATHER        DATE: 17 JAN 68         COLOSSUS GSOP CHANGES.
035371,000051:                                                                                          	# MOD NO: 3     MOD BY:  RR BAIRNSFATHER        DATE:  8 MAY 68         DELETE CMSM MANEUVER (PCR 50)
035372,000052:                                                                                          	# FUNCTION:     TO CALCULATE AND DISPLAY EMS INITIALIZATION DATA
035373,000053:                                                                                          	# CALLING SEQUENCE-  BY V37
035374,000054:                                                                                          	# EXIT-         TO P62
035375,000055:                                                                                          	# SUBROUTINE CALLS-  S61.1, S61.3, GOFLASH, FLAGUP, R02BOTH
035376,000056:                                                                                          	# ERASABLE INITIALIZATION:
035377,000057:                                                                                          	#       EMSALT (-29) M          .05G ALTITUDE ABOVE FISCHER ELLIPSOID   PAD LOADED.
035378,000058:                                                                                          	#       ALFAPAD /180            HYPERSONIC CM TRIM ANGLE OF ATTACK      PAD LOADED
035379,000059:                                                                                          	# OUTPUT:       THE FOLLOWING REGISTERS ARE WRITTEN IN FOR USE BY DISPLAYS
035380,000060:                                                                                          	#               GMAX    100 GMAX (-14) G,S      MAXIMUM ACCELERATION
035381,000061:                                                                                          	#               VPRED   (-7) M/CS               PREDICTED VELOCITY AT 400K FT
035382,000062:                                                                                          	#               GAMMAEI GAMMA/360               PREDICTED GAMMA    AT 400K FT
035383,000063:                                                                                          	#               RTGO    THETAH/360              RANGE ANGLE TO SPLASH FROM EMSALT       EMSALT IS PAD LOADED
035384,000064:                                                                                          	#               VIO     (-7) M/CS               INERTIAL VELOCITY AT       EMSALT       EMSALT IS PAD LOADED
035385,000065:                                                                                          	#               TTE     (-28) CS                TIME TO                    EMSALT       EMSALT IS PAD LOADED
035386,000066:                                                                                          	#               LAT(SPL) /360                   TARGET LOCATION                         LEFT BY DSKY
035387,000067:                                                                                          	#               LNG(SPL) /360                   TARGET LOCATION                         LEFT BY DSKY
035388,000068:                                                                                          	#               HEADSUP (0)                     +1 = LIFT DOWN, -1 = LIFT UP            LEFT BY DSKY
035389,000069:                                                                                          	# DEBRIS:       SEE SUBROUTINES.
035390,000070: 
035391,000071: 26,2217                                           BANK     26                            	#
035392,000072: 26,2000                                           SETLOC   P60S                          	#
035393,000073: 26,2000                                           BANK                                   	#
035394,000074: 
035395,000075: 26,2217  E6,1661                                  EBANK=   AOG                           	#
035396,000076: 
035397,000077: 26,2217                                           COUNT*   $$/P61                        	#
035398,000078: 
035399,000079: 26,2217           35002        P61                CA       BIT14                         	# EXTENDED VERB SHOULD BE FREE THIS CLOSE
035400,000080: 26,2220           55044                           TS       EXTVBACT                      	# TO V37
035401,000081:                                                                                          	# LOCK OUT EXTENDED VERBS SO CAN USE TFF
035402,000082:                                                                                          	# ROUTINES.  EXT VERB ERASE IS USED
035403,000083: 
035404,000084: 26,2221           45017                           CS       ONE                           	# REMOVE IF HEADSUP EVER ON UPLINK DATA
035405,000085: 26,2222           55726                           TS       HEADSUP                       	# PRELOAD
035406,000086: 
035407,000087: 26,2223           02544                           TC       S61.1                         	# CHECK STATE VECTOR AND IMU ORIENTATION
035408,000088:                                                                                          	# RV 60GENRET. DOES PHASCHNG, GROUP 4.
035409,000089: 
035410,000090: 26,2224           32425                           CA       V06N61                        	# LAT(SPL)      LNG(SPL)        HEADSUP
035411,000091:                                                                                          	# XXX.XX DEG    XXX.XX DEG      XXXXX.
035412,000092: 26,2225           04662                           TC       BANKCALL                      	#
035413,000093: 26,2226           21057                           CADR     GOFLASHR                      	#
035414,000094: 26,2227           04106                           TC       GOTOPOOH                      	#
035416,000096: 26,2230           02235                           TC       P61.4                         	#
035417,000097: 26,2231           02224                           TC       -5                            	#
035418,000098: 
035419,000099: 26,2232           05412        P61.3              TC       PHASCHNG                      	#
035420,000100: 26,2233           00014                           OCT      00014                         	#
035421,000101: 
035422,000102: 26,2234           05217                           TC       ENDOFJOB                      	#
035423,000103: 
035424,000104: 26,2235           22007        P61.4              ZL                                     	#
035425,000105: 26,2236           11726                           CCS      HEADSUP                       	# C(HEADSUP)= +1/-1
035426,000106: 26,2237           35002                           CA       BIT14                         	# IF HEADSUP POS,ROLLC =180 DEG.(LIFT DWN)
035427,000107: 26,2240           12241                           NOOP                                   	# IF HEADSUP NEG,ROLLC =0 (LIFT UP)
035428,000108: 26,2241           53716                           DXCH     ROLLC                         	# ROLLC IS USED BY S62.3: GIM ANG AT .05G
035429,000109: 
035430,000110: 26,2242           06006                           TC       INTPRET                       	#
035431,000111: 26,2243           77745        NEWRNVN            DLOAD                                  	#
035432,000112: 26,2244           01205                                    PIPTIME                       	# SAVE TIME OF RN,VN TO DETERMINE IF AN
035433,000113: 26,2245           37651                           STCALL   MM                            	# UPDATE HAS OCCURRED
035434,000114: 26,2246           52063                                    STARTEN1                      	# INITIALIZE
035435,000115: 26,2247           77775                           VLOAD                                  	#
035436,000116: 26,2250           01171                                    RN                            	#
035437,000117: 26,2251           02327                           STORE    RONE                          	#
035438,000118: 26,2252           77656                           UNIT                                   	#
035439,000119: 26,2253           26343                           STOVL    URONE                         	#
035440,000120: 26,2254           01177                                    VN                            	#
035441,000121: 26,2255           02335                           STORE    VONE                          	#
035442,000122: 26,2256           53435                           VXV      UNIT                          	#
035443,000123: 26,2257           02343                                    URONE                         	#
035444,000124: 26,2260           03502                           STORE    UNI                           	#
035445,000125: 26,2261           45345        DUMPP61            DLOAD    DSU                           	#
035446,000126: 26,2262           03651                                    MM                            	# INITIAL VALUE OF PIPTIME
035447,000127: 26,2263           01205                                    PIPTIME                       	#
035448,000128: 26,2264           45040                           BMN      CALRB                         	#
035449,000129: 26,2265           54243                                    NEWRNVN                       	# UPDATED... GO TRY AGAIN
035450,000130: 26,2266           54651                                    S61.2                         	# GET DISPLAY DATA FOR N60 AND N63
035451,000131:                                                                                          	# AND RETURN IN BASIC, BELOW.
035452,000132: 26,2267           05536        P61.1              TC       CLEARMRK                      	#
035453,000133: 26,2270           32424                           CA       V06N60                        	# GMAX          VPRED           GAMMAEI
035454,000134:                                                                                          	# XXX.XX G      XXXXX. FPS      XXX.XX DEG
035455,000135: 26,2271           04662                           TC       BANKCALL                      	#
035456,000136: 26,2272           20720                           CADR     GOFLASH                       	#
035457,000137: 
035458,000138: 26,2273           04106                           TC       GOTOPOOH                      	#
035459,000139: 26,2274           02276                           TC       P61.2                         	# PROCEED
035460,000140: 26,2275           02270                           TC       -5                            	#
035461,000141: 
035462,000142: 26,2276           06006        P61.2              TC       INTPRET                       	# CORRECT TTE FOR TIME LAPSE DURING
035463,000143:                                                                                          	# ABOVE DISPLAY.
035464,000144: 26,2277           45234                           RTB      DSU                           	#
035465,000145: 26,2300           45510                                    LOADTIME                      	# CURRENT TIME.
035467,000147: 26,2301           03651                                    MM                            	# PIPTIME FOR RONE & VONE.
035468,000148: 26,2302           77615                           DAD                                    	#
035469,000149: 26,2303           03733                                    TTE1                          	# NEGATIVE OF FREE FALL TIME.
035470,000150: 26,2304           03727                           STORE    TTE                           	# DECREMENTED
035471,000151: 
035472,000152: 26,2305           77776                           EXIT                                   	#
035473,000153: 
035474,000154: 26,2306           32426                           CA       V06N63                        	# RTGO          VIO             TTE
035475,000155:                                                                                          	# XXXX.X NM     XXXXX. FPS      XXBXX M,S
035476,000156: 26,2307           04662                           TC       BANKCALL                      	#
035477,000157: 26,2310           20720                           CADR     GOFLASH                       	#
035478,000158: 26,2311           04106                           TC       GOTOPOOH                      	#
035479,000159: 26,2312           02314                           TC       +2                            	#
035480,000160: 26,2313           02276                           TC       P61.2                         	# REDO
035481,000161: 
035482,000162:                                                                                          	#               .... THEN FALL INTO P62
035484,000164: 
035485,000165:                                                                                          	# PROGRAM-      P62
035486,000166:                                                                                          	# MOD NO.-      0       MAR. 13, 1967
035487,000167:                                                                                          	# MOD BY-       R. HIRSCHKOP
035488,000168:                                                                                          	# MOD NO:  1    MOD BY:  RR BAIRNSFATHER        DATE: 21 MAR 67
035489,000169:                                                                                          	# MOD NO:  2    MOD BY:  RR BAIRNSFATHER        DATE: 22 JUN 67         RESTARTS.
035490,000170:                                                                                          	# MOD NO:  3    MOD BY:  RR BAIRNSFATHER        DATE: 17 JAN 68         COLOSSUS GSOP CHANGES.
035491,000171:                                                                                          	# MOD NO:  4    MOD BY:  RR BAIRNSFATHER        DATE:  8 MAY 68         MOVE START OF DESIRED GIMBAL CALC.
035492,000172:                                                                                          	# FUNCTION-     1) TO NOTIFY CREW WHEN GNC SYSTEM IS PREPARED FOR CM/SM SEPARATION
035493,000173:                                                                                          	#               2) TO ORIENT THE CM TO THE CORRECT ATTITUDE FOR ATMOSPHERIC ENTRY
035494,000174:                                                                                          	# CALLING SEQUENCE-  BY V37 OR DIRECTLY FROM P61
035495,000175:                                                                                          	# EXIT-         TO P63
035496,000176:                                                                                          	# ERASABLE INITIALIZATION:      
035497,000177:                                                                                          	#       ALFAPAD                                         LEFT BY PAD LOAD
035498,000178:                                                                                          	#       LADPAD                                          LEFT BY PAD LOAD
035499,000179:                                                                                          	#       LODPAD                                          LEFT BY PAD LOAD
035500,000180:                                                                                          	#       LAT(SPL)        (MAY BE CHANGED BELOW)          LEFT BY DSKY, VIA P61
035501,000181:                                                                                          	#       LNG(SPL)        (MAY BE CHANGED BELOW)          LEFT BY DSKY, VIA P61
035502,000182:                                                                                          	#       HEADSUP         (MAY BE CHANGED BELOW)          LEFT BY DSKY, VIA P61
035503,000183:                                                                                          	# SUBROUTINE CALLS:  NEWMODEX, S61.1, CM/DAPIC, CM/DAPON, R02BOTH, GOPERF1, GOFLASH, GODSPR
035504,000184: 
035505,000185: 26,2314                                           COUNT*   $$/P62                        	#
035506,000186: 
035507,000187: 26,2314           05354                           TC       NEWMODEX                      	# MODE CHANGE IF CAME FROM P61.
035508,000188: 26,2315           00076                           MM       62         B-14               	# MODE CHANGE AUTOMATIC VIA V 37.
035509,000189: 26,2316           35017                           CA       ONE                           	#
035510,000190: 26,2317           54332                           TS       DNLSTCOD                      	#
035511,000191: 
035512,000192: 26,2320           02544        P62                TC       S61.1                         	# CHECK STATE VECTOR AND IMU ORIENTATION.
035513,000193: 
035514,000194: 26,2321           06006                           TC       INTPRET                       	#
035515,000195: 26,2322           47131                           SSP      RTB                           	#
035516,000196: 26,2323           03325                                    POSEXIT                       	#
035517,000197: 26,2324           54401                                    P62.3                         	# CALCULATE DESIRED .05G GIMBAL ANGLES,
035518,000198:                                                                                          	# WITHOUT DISPLAY.
035519,000199: 26,2325           41672                                    CM/DAPIC                      	# START CM/POSE AND BODY RATE CALC
035520,000200: 
035521,000201:                                                                                          	# DOES 2PHSCHNG, OCT 40116, OCT 05024, OCT 13000.
035522,000202:                                                                                          	# CM/DAPIC SETS EBANK = EBAOG
035523,000203:                                                                                          	# AND RETURNS IN BASIC TO P62.2.                                
035524,000204: 26,2326           00006        P62.2              EXTEND                                 	#
035525,000205: 26,2327           32432                           DCA      POSECADR                      	# CONTINUE WITH CM/POSE AFTER AV G.
035526,000206: 26,2330           53223                           DXCH     AVEGEXIT                      	#
035527,000207: 
035528,000208: 26,2331           34270                           CAF      OCT41                         	# REQUEST SEPARATION
035529,000209: 26,2332           04662                           TC       BANKCALL                      	#
035530,000210: 26,2333           21125                           CADR     GOPERF1R                      	#
035531,000211: 26,2334           04106                           TC       GOTOPOOH                      	#
035532,000212: 26,2335           02340                           TC       +3                            	# PROCEED
035534,000214:                                                                                          	# NOTE:  NODOFLAG WILL BE SET IN CM/DAPON. <<<
035535,000215: 26,2336           02331                           TC       -5                            	# ENTER
035536,000216: 26,2337           02232                           TC       P61.3                         	# FOR PHASCHNG AND ENDOFJOB.
035537,000217: 
035538,000218: 26,2340           04701                 +3        TC       POSTJUMP                      	#
035539,000219: 26,2341           41612                           CADR     CM/DAPON                      	# DISABLE RCS DAP, ENABLE ENTRY DAP AND
035540,000220:                                                                                          	# DO ATTITUDE HOLD.
035541,000221: 
035542,000222:                                                                                          	# WILL IDLE UNTIL CM/POSE DOES ONE UPDATE.
035543,000223:                                                                                          	# CM/DAPON DOES NO PHASCHNG.
035544,000224: 
035545,000225: 26,2342           32425        P62.1              CA       V06N61                        	# LAT(SPL)      LNG(SPL)        HEADSUP
035546,000226:                                                                                          	# XXX.XX DEG    XXX.XX DEG      0000X.
035547,000227: 
035548,000228:                                                                                          	# TERMINATE ATTITUDE HOLD.  SET UP COMMANDS:
035549,000229:                                                                                          	# ROLLC, ALFACOM, BETACOM.  BEGIN MANUVER TO
035550,000230:                                                                                          	# ENTRY ATTITUDE.
035551,000231: 
035552,000232: 26,2343           04662                           TC       BANKCALL                      	#
035553,000233: 26,2344           20720                           CADR     GOFLASH                       	#
035554,000234: 26,2345           02342                           TC       -3                            	#
035555,000235: 26,2346           02350                           TC       +2                            	#
035556,000236: 26,2347           02342                           TC       -5                            	#
035557,000237: 
035558,000238: 26,2350           05412                           TC       PHASCHNG                      	#
035559,000239: 26,2351           04024                           OCT      04024                         	# USE ENTRYVN FOR DISPLAY BELOW.
035560,000240:                                                                                          	# EBANK WAS SET IN CM/DAPON TO EBAOG
035561,000241: 
035562,000242: 26,2352           11726                           CCS      HEADSUP                       	# C(HEADSUP) = +/- 1
035563,000243: 26,2353           35002                           CA       BIT14                         	# IF HEADSUP POS, ROLLC=180 DEG (LIFT DWN)
035564,000244: 26,2354           12355                           NOOP                                   	# IF HEADSUP NEG, ROLLC=0 DEG (LIFT UP)
035565,000245: 26,2355           55715                           TS       ROLLC                         	#
035566,000246: 26,2356           31411                           CA       ALFAPAD                       	# NOMINAL ALFATRIM PAD LOADED, NEG. NO.
035567,000247: 26,2357           22007                           ZL                                     	#
035568,000248: 26,2360           53604                           DXCH     ALFACOM                       	# SET ALFACOM = ALFA TRIM, BETACOM=0
035569,000249: 
035570,000250: 26,2361           35017                           CA       ONE                           	# PERMITS EXDAP2 TO CHANGE FLAG TO +0
035571,000251: 26,2362           55727                           TS       P63FLAG                       	# AS INDICATOR.  STARTS UP P63.
035572,000252: 
035573,000253: 26,2363           35052                           CA       V06N22                        	# SET UP DISPLAY FOR CDU DESIRED VALUES
035574,000254: 26,2364           55263                           TS       ENTRYVN                       	# FROM ENTRY ATTITUDE CALC, THAT IS
035575,000255:                                                                                          	# ALREADY GOING.
035576,000256: 26,2365           05546                           TC       UPFLAG                        	# TURN ON ENTRY DISPLAY
035577,000257: 26,2366           00134                           ADRES    ENTRYDSP                      	# ENTRYDSP = 92D BIT 13 FLAG 6
035578,000258:                                                                                          	# SKIP
035580,000260: 26,2367           41700                           CS       CMDAPMOD                      	# GO DIRECTLY TO P63 IF BODY ATTITUDE
035581,000261: 26,2370           75017                           MASK     ONE                           	# IS SUCH THAT THE DELAY TASK: WAKEP62
035582,000262: 26,2371           00006                           EXTEND                                 	# WILL BE OMITTED.
035583,000263: 26,2372           12421                           BZF      P63.1                         	# DISABLE GRP 4, GO TO ENDOFJOB.
035584,000264:                                                                                          	# (IE, CONTINUE IF CMDAPMOD = -1, OR +0)
035585,000265: 26,2373           02405                           TC       P63                           	#
035586,000266: 
035587,000267:                                                                                          	# PUT JOB TO SLEEP UNTIL VEHICLE MANUVER HAS
035588,000268:                                                                                          	# REDUCED ALFA TO +/-45 DEG. CONSIDER REMAINING
035589,000269:                                                                                          	# 65 DEG (25 DEG IF ALFA NEG) TO ALFA TRIM TO
035590,000270:                                                                                          	# OCCUR AT 3 DEG/SEC, AND TERMINATE P62 AT THAT
035591,000271:                                                                                          	# TIME.
035592,000272: 
035593,000273:                                                                                          	# TASK WAKEP62 IS CALLED FROM ENTRY DAP.
035594,000274: 26,2374           35065        WAKEP62            CA       PRIO13                        	#
035595,000275: 26,2375           05134                           TC       NOVAC                         	#
035596,000276: 26,2376  E6,1661                                  EBANK=   AOG                           	#
035597,000277: 26,2376           02405 54066                     2CADR    P63                           	#
035598,000278: 
035599,000279: 26,2400           05324                           TC       TASKOVER                      	#
035600,000280: 
035601,000281:                                                                                          	# EACH 2 SEC, CALCULATE GIMBAL ANGLES FOR ENTRY CON-
035602,000282:                                                                                          	# DITIONS THAT WILL HOLD IF REORIENTATION WERE MADE
035603,000283:                                                                                          	# AT PRESENT RN, VN.  COME HERE FROM CM/POSE AND ALSO
035604,000284:                                                                                          	# IN KEPLER PHASE OF ENTRY.
035605,000285: 
035606,000286: 26,2401           52131        P62.3              SSP      GOTO                          	# SET RETURN ADDRESS SO THAT ROUTINE
035607,000287: 26,2402           00053                                    QPRET                         	# GOES DIRECTLY TO ENTRY GUIDANCE EXIT
035608,000288: 26,2403           53576                                    ENDEXIT                       	# THAT DOES ENTRY DISPLAY, GRP 5.

021277,001017:                                                                                          	# ..... INITVEL .....
021278,001018:                                                                                          	# MOD NO -1                     LOG SECTION - P34-P35, P74-P75
021279,001019:                                                                                          	# MOD BY WHITE.P                DATE  21NOV67
021280,001020: 
021281,001021:                                                                                          	# FUNCTIONAL DESCRIPTION
021282,001022:                                                                                          	#       THIS SUBROUTINE COMPUTES THE REQUIRED INITIAL VELOCITY VECTOR FOR
021283,001023:                                                                                          	#       A TRAJECTORY OF SPECIFIED TRANSFER TIME BETWEEN SPECIFIED INITIAL
021284,001024:                                                                                          	#       AND TARGET POSITIONS.  THE TRAJECTORY MAY BE EITHER CONIC OR
021285,001025:                                                                                          	#       PRECISION DEPENDING ON AN INPUT PARAMETER (NAMELY, NUMBER OF
021286,001026:                                                                                          	#       OFFSETS).  IN ADDITION, IN THE PRECISION TRAJECTORY CASE, THE
021287,001027:                                                                                          	#       SUBROUTINE ALSO COMPUTES AN OFFSET TARGET VECTOR, TO BE USED
021288,001028:                                                                                          	#       DURING PURE-CONIC CROSS-PRODUCT STEERING.  THE OFFSET TARGET
021289,001029:                                                                                          	#       VECTOR IS THE TERMINAL POSITION VECTOR OF A CONIC TRAJECTORY WHICH
021290,001030:                                                                                          	#       HAS THE SAME INITIAL STATE AS A PRECISION TRAJECTORY WHOSE
021291,001031:                                                                                          	#       TERMINAL POSITION VECTOR IS THE SPECIFIED TARGET VECTOR.
021292,001032: 
021293,001033:                                                                                          	#       IN ORDER TO AVOID THE INHERENT SINGULARITIES IN THE 180 DEGREE
021294,001034:                                                                                          	#       TRANSFER CASE WHEN THE (TRUE OR OFFSET) TARGET VECTOR MAY BE
021295,001035:                                                                                          	#       SLIGHTLYOUT OF THE ORBITAL PLANE, THIS SUBROUTINE ROTATES THIS
021296,001036:                                                                                          	#       VECTOR INTO A PLANE DEFINED BY THE INPUT INITIAL POSITION VECTOR
021297,001037:                                                                                          	#       AND ANOTHER INPUT VECTOR (USUALLY THE INITIAL VELOCITY VECTOR),
021298,001038:                                                                                          	#       WHENEVER THE INPUT TARGET VECTOR LIES INSIDE A CONE WHOSE VERTEX
021299,001039:                                                                                          	#       IS THE ORIGIN OF COORDINATES, WHOSE AXIS IS THE 180 DEGREE
021300,001040:                                                                                          	#       TRANSFER DIRECTION, AND WHOSE CONE ANGLE IS SPECIFIED BY THE USER.
021301,001041: 
021302,001042:                                                                                          	#       THE LAMBERT SUBROUTINE IS UTILIZED FOR THE CONIC COMPUTATIONS AND
021303,001043:                                                                                          	#       THE COASTING INTEGRATION SUBROUTINE IS UTILIZED FOR THE PRECISION
021304,001044:                                                                                          	#       TRAJECTORY COMPUTATIONS.
021305,001045: 
021306,001046:                                                                                          	# CALLING SEQUENCE
021307,001047:                                                                                          	#       L       CALL
021308,001048:                                                                                          	#       L+1             INITVEL
021309,001049:                                                                                          	#       L+2     (RETURN - ALWAYS)
021310,001050: 
021311,001051:                                                                                          	# INPUT
021312,001052:                                                                                          	#       (1)     RINIT           INITIAL POSITION RADIUS VECTOR
021313,001053:                                                                                          	#       (2)     VINIT           INITIAL POSITION VELOCITY VECTOR
021314,001054:                                                                                          	#       (3)     RTARG           TARGET POSITION RADIUS VECTOR
021315,001055:                                                                                          	#       (4)     DELLT4          DESIRED TIME OF FLIGHT FROM RINIT TO RTARG
021316,001056:                                                                                          	#       (5)     INTIME          TIME OF RINIT
021317,001057:                                                                                          	#       (6)     0D              NUMBER OF ITERATIONS OF LAMBERT/INTEGRVS
021318,001058:                                                                                          	#       (7)     2D              ANGLE TO 180 DEGREES WHEN ROTATION STARTS
021319,001059:                                                                                          	#       (8)     RTX1            -2 FOR EARTH, -10D FOR LUNAR
021320,001060:                                                                                          	#       (9)     RTX2            COORDINATE SYSTEM ORIGIN - 0 FOR EARTH, 2 FOR LUNAR
021321,001061:                                                                                          	#       PUSHLOC SET AT 4D
021322,001062: 
021324,001064:                                                                                          	# OUTPUT
021325,001065:                                                                                          	#       (1)     RTARG           OFFSET TARGET POSITION VECTOR
021326,001066:                                                                                          	#       (2)     VIPRIME         MANEUVER VELOCITY REQUIRED
021327,001067:                                                                                          	#       (3)     VTPRIME         VELOCITY AT TARGET AFTER MANEUVER
021328,001068:                                                                                          	#       (4)     DELVEET3        DELTA VELOCITY REQUIRED FOR MANEUVER
021329,001069: 
021330,001070:                                                                                          	# SUBROUTINES USED
021331,001071:                                                                                          	#       LAMBERT
021332,001072:                                                                                          	#       INTSTALL
021333,001073:                                                                                          	#       INTEGRVS
021334,001074: 

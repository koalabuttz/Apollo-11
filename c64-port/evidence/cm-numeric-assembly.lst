005403,003768:                                                                                          	# THE FOLLOWING OVERLAY MEAS. INCORP. AND ARE IN USE ONLY WHEN (32D)
005404,003769: E7,1426  E7,1457               POSTCSI            EQUALS   VG                            	# I(2)
005405,003770: E7,1426  E7,1461               DELVCSI            EQUALS   POSTCSI    +2                 	# I(2)
005406,003771: E7,1426  E7,1463               DELDV              EQUALS   DELVCSI    +2                 	# I(2)
005407,003772: E7,1426  E7,1465               GAMPREV            EQUALS   DELDV      +2                 	# I(2)
005408,003773: E7,1426  E7,1467               DVPREV             EQUALS   GAMPREV    +2                 	# I(2)
005409,003774: E7,1426  E7,1471               POSTCDH            EQUALS   DVPREV     +2                 	# I(2)
005410,003775: E7,1426  E7,1471               HAFPA1             EQUALS   POSTCDH                       	#
005411,003776: E7,1426  E7,1473               VACT4              EQUALS   POSTCDH    +2                 	# I(6)
005412,003777: E7,1426  E7,1501               RDOTV              EQUALS   VACT4      +6                 	# I(2)
005413,003778: E7,1426  E7,1503               VACT1              EQUALS   RDOTV      +2                 	# I(6)
005414,003779: E7,1426  E7,1511               VPASS1             EQUALS   VACT1      +6                 	# I(6) VEL. PASSIVE VEH, AT CSI TIME
005415,003780: 
005416,003781: E7,1426  E7,1545               UNVEC              EQUALS   VACT3                         	#
005417,003782: 
005418,003783: E7,1426  E7,1655               T2TOT3             EQUALS   TPASS4                        	# I(2) TPI - TCDH
005419,003784: 
005420,003785: E7,1426  E7,1664               CSIALRM            EQUALS   TITER                         	# I(2) ALARM INDEX
005421,003786: 
005422,003787: E7,1426  E7,1666               DELVEET2           EQUALS   S22WUNL                       	# I(6) VACT3 - VACT2 = DVCDH REF. COORD.
005423,003788: 
005424,003789:                                                                                          	# ADDITIONAL CSI - CDH STORAGE.         (10D)
005425,003790: E7,1426  E7,1755               RPASS1             EQUALS   CENTANG    +2                 	# I(6) POS. PASSIVE VEH. AT CSI TIME.
005426,003791: E7,1426  E7,1763               LOOPCT             EQUALS   RPASS1     +6                 	# I(2) ITERATION COUNTER
005427,003792: E7,1426  E7,1765               NN                 EQUALS   LOOPCT     +2                 	# I(2)
005428,003793: 
005429,003794:                                                                                          	# P21 STORAGE                           (19D)
005430,003795: E7,1426  E7,1603               P21ORIG            EQUALS   TRUNX                         	# I(1)
005431,003796: E7,1426  E7,1604               P21BASER           EQUALS   P21ORIG    +1                 	# I(6)
005432,003797: E7,1426  E7,1612               P21BASEV           EQUALS   P21BASER   +6                 	# I(6)
005433,003798: E7,1426  E7,1620               P21ALT             EQUALS   P21BASEV   +6                 	# I(2) NOUN 73 R1 ALTITUDE
005434,003799: E7,1426  E7,1622               P21VEL             EQUALS   P21ALT     +2                 	# I(2) NOUN 73 R2 VELOCITY
005435,003800: E7,1426  E7,1624               P21GAM             EQUALS   P21VEL     +2                 	# I(2) NOUN 73 R3 FLIGHT PATH ANGLE
005436,003801: 
005437,003802: E7,1426                        WHOCARES           EQUALS   3777                          	# A DUMMY FOR E-BANK INSENSITIVE 2CADRS.
005438,003803: E7,1426  E7,1777               END-E7             EQUALS   WHOCARES                      	# ****** LAST LOCATION IN E7

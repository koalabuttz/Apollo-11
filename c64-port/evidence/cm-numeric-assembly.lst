009666,000149:                                                                                          	# MOD BY - R. MELANSON TO ADD DOCUMENTATION                     ASSEMBLY SUNDISK REV. 116
009667,000150: 
009668,000151:                                                                                          	# FUNCTIONAL DESCRIPTION-
009669,000152: 
009670,000153:                                                                                          	#       MKRELEAS IS EXECUTED BY INTERNAL ROUTINES TO RELEASE THE MARK SYSTEM TO MAKE IT AVAILABLE TO OTHER INTERNAL
009671,000154:                                                                                          	#       SYSTEM ROUTINES.  IT ALSO CLEARS THE COARSE OPTICS FLAG BIT AND DISABLES THE OPTICS ERROR COUNTER.
009672,000155: 
009673,000156:                                                                                          	# CALLING SEQUENCE-
009674,000157: 
009675,000158:                                                                                          	#       TC      BANKCALL
009676,000159:                                                                                          	#       CADR    MKRELEAS
009677,000160: 
009678,000161:                                                                                          	# NORMAL EXIT MODE-
009679,000162: 
009680,000163:                                                                                          	#       SWRETURN
009681,000164: 
009682,000165:                                                                                          	# ALARM OR ABORT EXIT MODE-  NONE
009683,000166: 
009684,000167:                                                                                          	# OUTPUT-
009685,000168: 
009686,000169:                                                                                          	#       1)      BIT9 OPTMODES SET TO 0
009687,000170:                                                                                          	#       2)      OPTIND SET TO -1
009688,000171:                                                                                          	#       3)      1ST WORD OF VAC AREA SET TO VAC ADDRESS TO SIGNIFY AVAILABILITY.
009689,000172:                                                                                          	#       4)      MARKSTAT CLEARED
009690,000173:                                                                                          	#       5)      BIT2 CHANNEL 12 SET TO 0
009691,000174: 
009692,000175:                                                                                          	# ERASABLE INITIALIZATION-  NONE
009693,000176: 
009694,000177:                                                                                          	# DEBRIS-
009695,000178: 
009696,000179:                                                                                          	#       A,MARKSTAT,BIT9 OPTMODES,OPTIND,BIT2 CHANNEL 12
009697,000180: 
009698,000181: 07,2063           35021        MKRELEAS           CAF      ZERO                          	# SHOW MARK SYSTEM NOW AVAILABLE
009699,000182: 07,2064           57330                           XCH      MARKSTAT                      	#
009700,000183: 07,2065           75046                           MASK     LOW9                          	#
009701,000184: 07,2066           10000                           CCS      A                             	#
009702,000185: 07,2067           50000                           INDEX    A                             	#
009703,000186: 07,2070           54000                           TS       0                             	#
009704,000187: 07,2071           00004        MKRLEES            INHINT                                 	#
009705,000188: 07,2072           45007                           CS       BIT9                          	# COARSE OPTICS RETURN FLAG.
009706,000189: 07,2073           71331                           MASK     OPTMODES                      	#
009707,000190: 07,2074           55331                           TS       OPTMODES                      	#
009708,000191: 
009709,000192: 07,2075           37716                           CA       NEGONE                        	#
009710,000193: 07,2076           55303                           TS       OPTIND                        	# KILL COARS OPTICS
009711,000194: 
009712,000195: 07,2077           45016                           CS       BIT2                          	# DISABLE OPTICS ERROR COUNTER
009713,000196: 07,2100           00006                           EXTEND                                 	#
009714,000197: 07,2101           03012                           WAND     CHAN12                        	#
009715,000198: 
009716,000199: 07,2102           00003                           RELINT                                 	#
009717,000200: 07,2103           04675                           TC       SWRETURN                      	#
009719,000202:                                                                                          	# PROGRAM NAME - MARKRUPT                                       DATE - 5 APRIL 1967
009720,000203:                                                                                          	# PROGRAM MODIFIED BY 258/278 PROGRAMMERS                       LOG SECTION SXTMARK
009721,000204:                                                                                          	# MOD BY - R. MELANSON TO ADD DOCUMENTATION                     ASSEMBLY SUNDISK REV. 116
009722,000205: 
009723,000206:                                                                                          	# FUNCTIONAL DESCRIPTION-
009724,000207:                                                                                          	#       MARKRUPT STORES CDUS,OPTICS AND TIME AND TRANSFERS CONTROL TO THE MARKIT,MARK REJECT OR KEYCOM ROUTINES IF
009725,000208:                                                                                          	#       BITS IN CHANNEL 16 ARE SET AS REQUIRED.
009726,000209: 
009727,000210:                                                                                          	# CALLING SEQUENCE-
009728,000211:                                                                                          	#       ROUTINE ENTERED VIA KEYRUPT2 WHEN MARK,MARK REJECT OR DSKY KEYS DEPRESSED BY THE OPERATOR.
009729,000212: 
009730,000213:                                                                                          	# NORMAL EXIT MODE-
009731,000214:                                                                                          	#       MARKIT, MKREJECT OR POSTJUMP ROUTINES (MARK, MARK REJECT OR DSKY CODE)
009732,000215: 
009733,000216:                                                                                          	# ALARM OR ABORT EXIT MODE-
009734,000217:                                                                                          	#       ALARM AND RESUME
009735,000218: 
009736,000219:                                                                                          	# OUTPUT-
009737,000220:                                                                                          	#       RUPTSTOR+5 = CDUT, RUPTSTOR+3 = CDUS, RUPTSTOR+2 = CDUY,
009738,000221:                                                                                          	#       RUPTREG3 = CDUZ, RUPTSTOR+6 = CDUX, RUPTSTOR+1 AND SAMPTIME+1 = TIME1,
009739,000222:                                                                                          	#       RUPTSTOR AND SAMPTIME = TIME2
009740,000223: 
009741,000224:                                                                                          	# ERASABLE INITIALIZATION-
009742,000225:                                                                                          	#       CDUT,CDUS,CDUY,CDUZ,CDUX,TIME2,TIME1,CHANNEL 16 BITS 6,7 OR 1-5
009743,000226: 
009744,000227:                                                                                          	# DEBRIS-
009745,000228:                                                                                          	#       A,QRUPT,RUPTREG3,SAMPTIME,SAMPTIME+1,RUPTSTOR TO RUPTSTOR+6 EXCEPT RUPTSTOR+4 (LOCATION 67)
009746,000229: 
009747,000230: 07,2104           54016        MARKRUPT           TS       BANKRUPT                      	# STORE CDUS AND OPTICS NOW
009748,000231: 07,2105           30035                           CA       CDUT                          	#
009749,000232: 07,2106           54362                           TS       MKCDUT                        	#
009750,000233: 07,2107           30036                           CA       CDUS                          	#
009751,000234: 07,2110           54360                           TS       MKCDUS                        	#
009752,000235: 07,2111           30033                           CA       CDUY                          	#
009753,000236: 07,2112           54357                           TS       MKCDUY                        	#
009754,000237: 07,2113           30034                           CA       CDUZ                          	#
009755,000238: 07,2114           54361                           TS       MKCDUZ                        	#
009756,000239: 07,2115           30032                           CA       CDUX                          	#
009757,000240: 07,2116           54363                           TS       MKCDUX                        	#
009758,000241: 07,2117           00006                           EXTEND                                 	#
009759,000242: 07,2120           30025                           DCA      TIME2                         	# GET TIME
009760,000243: 07,2121           52356                           DXCH     MKT2T1                        	#
009761,000244: 07,2122           00006                           EXTEND                                 	#
009762,000245: 07,2123           30356                           DCA      MKT2T1                        	#
009763,000246: 07,2124           52014                           DXCH     SAMPTIME                      	# RUPT TIME FOR NOUN 65.
009764,000247: 
009765,000248: 07,2125           56002                           XCH      Q                             	#
009766,000249: 07,2126           54012                           TS       QRUPT                         	#
009767,000250: 
009768,000251: 07,2127           35012                           CAF      BIT6                          	# SEE IF MARK OR MKREJECT
009770,000253: 07,2130           00006                           EXTEND                                 	#
009771,000254: 07,2131           02016                           RAND     NAVKEYIN                      	#
009772,000255: 07,2132           10000                           CCS      A                             	#
009773,000256: 07,2133           02430                           TC       MARKIT                        	# ITS A MARK
009774,000257: 
009775,000258: 07,2134           35011                           CAF      BIT7                          	# NOT A MARK, SEE IF MKREJECT
009776,000259: 07,2135           00006                           EXTEND                                 	#
009777,000260: 07,2136           02016                           RAND     NAVKEYIN                      	#
009778,000261: 07,2137           10000                           CCS      A                             	#
009779,000262: 07,2140           02301                           TC       MKREJECT                      	# ITS A MARK REJECT
009780,000263: 
009781,000264: 07,2141           34362        KEYCALL            CAF      OCT37                         	# NOT MARK OR MKREJECT, SEE IF KEYCODE
009782,000265: 07,2142           00006                           EXTEND                                 	#
009783,000266: 07,2143           02016                           RAND     NAVKEYIN                      	#
009784,000267: 07,2144           00006                           EXTEND                                 	#
009785,000268: 07,2145           12150                           BZF      +3                            	# IF NO INBITS
009786,000269: 07,2146           04701                           TC       POSTJUMP                      	#
009787,000270: 07,2147           17702                           CADR     KEYCOM                        	# IT,S A KEY CODE, NOT A MARK.
009788,000271: 
009789,000272: 07,2150           05650                 +3        TC       ALARM                         	# ALARM IF NO INBITS
009790,000273: 07,2151           00113                           OCT      113                           	#
009791,000274: 07,2152           05333                           TC       RESUME                        	#
009792,000275: 
009794,000277:                                                                                          	# PROGRAM NAME - MARKCONT                               DATE - 19 SEPT 1967
009795,000278:                                                                                          	# PROGRAM MODIFIED BY 258/278 PROGRAMMERS               LOG SECTION SXTMARK
009796,000279:                                                                                          	# MOD BY - R. MELANSON TO ADD DOCUMENTATION             ASSEMBLY SUNDISK REV. 116
009797,000280: 
009798,000281:                                                                                          	# FUNCTIONAL DESCRIPTION-
009799,000282:                                                                                          	#       MARKCONT IS USED TO PERFORM A SPECIAL MARK FUNCTION FOR R21, TO EXECUTE A SPECIAL DISPLAY OF OPTICS AND TIME OR
009800,000283:                                                                                          	#       TO PERFORM A MARK OF A STAR OR LAND SIGHTING BASED UPON FLASHING V-N.
009801,000284: 
009802,000285:                                                                                          	# CALLING SEQUENCE-
009803,000286: 
009804,000287:                                                                                          	#       FROM MARKDIF
009805,000288: 
009806,000289:                                                                                          	# NORMAL EXIT MODE-
009807,000290:                                                                                          	#       TASKOVER
009808,000291: 
009809,000292:                                                                                          	# ALARM OR ABORT EXIT MODE-
009810,000293:                                                                                          	#       ALARM AND TASKOVER
009811,000294: 
009812,000295:                                                                                          	# OUTPUT-
009813,000296:                                                                                          	#       1)      FOR R21-
009814,000297:                                                                                          	#               EBANK=EBANK7
009815,000298:                                                                                          	#               MRKBUF1 TO MRKBUF1+6 = TIME2,TIME1,CDUY,OPTICX,CDUZ,OPTICSY,CDUX OF CURRENT R21 MARK FUNCTION.
009816,000299:                                                                                          	#               MRKBUF2 TO MRKBUF2+6 CONTAINS PREVIOUS R21 MARK VALUES.
009817,000300:                                                                                          	#       2)      FOR SPECIAL DISPLAY JOB-
009818,000301:                                                                                          	#               RUPTREG1 AND MRKBUF1 = CDUS,RUPTREG2 AND MRKBUF1+1 = CDUT.
009819,000302:                                                                                          	#               RUPTREG3 AND MRKBUF1+2 = TIME2,RUPTREG4 AND MRKBUF1+3 = TIME1
009820,000303:                                                                                          	#       3)      FOR NORMAL MARKING-
009821,000304:                                                                                          	#               DECREMENT BITS14-12 OF MARKSTAT BY 1,
009822,000305:                                                                                          	#               BIT10 MARKSTAT SET TO 1, INCREMENT QPRET BY 7,
009823,000306:                                                                                          	#               STORE TIME2,TIME1,CDUY,CDUS,CDUZ,CDUT AND CDUX IN VAC+1 TO VAC+7
009824,000307: 
009825,000308:                                                                                          	# ERASABLE INITIALIZATION-
009826,000309:                                                                                          	#       1)      FOR R21-
009827,000310:                                                                                          	#               BIT14 OF STATE+2 =1, MRKBUF1 TO MRKBUF1+6, ITEMP1, RUPTREG3,
009828,000311:                                                                                          	#               RUPTSTOR TO RUPTSTOR+6 EXCEPT RUPTSTOR+4
009829,000312:                                                                                          	#       2)      FOR SPECIAL DISPLAY JOB-
009830,000313:                                                                                          	#               BIT14 OF STATE+2 =0, MARKSTAT =+0, RUPTREG1,RUPTREG2,RUPTREG3
009831,000314:                                                                                          	#               RUPTREG4,RUPTSTOR,RUPTSTOR+1,RUPTSTOR+3,RUPTSTOR+5,
009832,000315:                                                                                          	#               BIT12 OF STATE+5 (V59 FLAG), MRKBUF1 THRU MRKBUF1+3
009833,000316:                                                                                          	#       3)      FOR NORMAL MARKING-
009834,000317:                                                                                          	#               BIT14 OF STATE+2 =0, MARKSTAT =VAC ADDRESS,A REG,ITEMP1,RUPTREG3,
009835,000318:                                                                                          	#               RUPTSTOR TO RUPTSTOR+6 EXCEPT RUPTSTOR+4
009836,000319: 
009837,000320:                                                                                          	# DEBRIS-
009838,000321:                                                                                          	#       1)      FOR R21-
009839,000322:                                                                                          	#               A, ITEMP1, MRKBUF1, MRKBUF2
009840,000323:                                                                                          	#       2)      FOR SPECIAL DISPLAY JOB-
009841,000324:                                                                                          	#               A,RUPTREG1,RUPTREG2,RUPTREG3,RUPTREG4,MPAC TO MPAC+3
009842,000325:                                                                                          	#       3)      FOR NORMAL MARKING-
009843,000326:                                                                                          	#               A,MARKSTAT,ITEMP1,QPRET,VAC+1 TO VAC+7 OF VAC AREA IN USE
009844,000327: 
009846,000329: 07,2153           35002        MARKCONT           CAF      BIT14                         	#
009847,000330: 07,2154           70076                           MASK     STATE      +2                 	# R21 MARK (SPECIAL MARKING FOR R21)
009848,000331: 07,2155           00006                           EXTEND                                 	#
009849,000332: 07,2156           12170                           BZF      MARKET                        	# NOT SET THEREFORE REGULAR MARKING
009850,000333: 07,2157           36211        MARKIT1            CAF      SIX                           	# SPECIAL FOR R21
009851,000334: 07,2160           05606                           TC       GENTRAN                       	# TRANSFER MRKBUF1 TO MRKBUF2
009852,000335: 07,2161           01725                           ADRES    MRKBUF1                       	#
009853,000336: 07,2162           01734                           ADRES    MRKBUF2                       	#
009854,000337: 
009855,000338: 07,2163           36211                           CAF      SIX                           	# TRANSFER CURRENT MARK DATA TO MARKBUF1
009856,000339: 07,2164           05606                           TC       GENTRAN                       	#
009857,000340: 07,2165           00355                           ADRES    MKT2T1                        	#
009858,000341: 07,2166           01725                           ADRES    MRKBUF1                       	#
009859,000342: 
009860,000343: 07,2167           15324                           TCF      TASKOVER                      	#
009861,000344: 
009862,000345: 07,2170           11330        MARKET             CCS      MARKSTAT                      	# SEE IF MARKS CALLED FOR
009863,000346: 07,2171           02225                           TC       MARK2                         	# COLLECT MARKS
009864,000347: 
009865,000348: 07,2172           35016                           CAF      TWO                           	# IS MARKING SYSTEM IN USE (BIT2)
009866,000349: 07,2173           71044                           MASK     EXTVBACT                      	#
009867,000350: 07,2174           00006                           EXTEND                                 	#
009868,000351: 07,2175           12217                           BZF      MARKET3                       	# MARKING NOT CALLED FOR
009869,000352: 07,2176           35004                           CAF      BIT12                         	#
009870,000353: 07,2177           70101                           MASK     STATE      +5                 	# V59FLAG
009871,000354: 07,2200           00006                           EXTEND                                 	#
009872,000355: 07,2201           12217                           BZF      MARKET3                       	# IF V59FLAG NOT SET-MARK UNCALLED FOR
009873,000356: 07,2202           35061                           CAF      PRIO5                         	# CALIBRATION MARK (SET) FOR P23
009874,000357: 07,2203           05134                           TC       NOVAC                         	# SPECIAL DISPLAY JOB
009875,000358: 07,2204  E7,1725                                  EBANK=   MRKBUF1                       	#
009876,000359: 07,2204           02426 76067                     2CADR    MARKDISP                      	#
009877,000360: 
009878,000361: 07,2206           36211                           CAF      SIX                           	#
009879,000362: 07,2207           05606                           TC       GENTRAN                       	# TRANSFER MARK DATA TO MARKDOWN
009880,000363: 07,2210           00355                           ADRES    MKT2T1                        	#
009881,000364: 07,2211           01674                           ADRES    MARKDOWN                      	#
009882,000365: 07,2212           36211                           CAF      SIX                           	#
009883,000366: 07,2213           05606                           TC       GENTRAN                       	# TRANSFER MARK DATA TO MRKBUF1 FOR
009884,000367: 07,2214           00355                           ADRES    MKT2T1                        	# SPECIAL DISPLAY OF SHAFT AND TRUNNION
009885,000368: 07,2215           01725                           ADRES    MRKBUF1                       	# IF V59 ACTING
009886,000369: 07,2216           15324                           TCF      TASKOVER                      	#
009887,000370: 07,2217           05650        MARKET3            TC       ALARM                         	#
009888,000371: 07,2220           00122                           OCT      122                           	# MARKING NOT CALLED FOR
009889,000372: 07,2221           15324                           TCF      TASKOVER                      	#
009890,000373: 07,2222           05650        114ALM             TC       ALARM                         	# MARK NOT WANTED
009891,000374: 07,2223           00114                           OCT      114                           	#
009892,000375: 07,2224           15324                           TCF      TASKOVER                      	#
009893,000376: 
009895,000378:                                                                                          	# STORE MARK DATA IN MKVAC AND INCREMENT POINTER
009896,000379: 
009897,000380: 07,2225           67711        MARK2              AD       74K                           	# SEE IF MARKS WANTED-REDUCE MARKS WANTED
009898,000381: 07,2226           00006                           EXTEND                                 	#
009899,000382: 07,2227           62222                           BZMF     114ALM                        	# MARK NOT WANTED-ALARM
009900,000383: 07,2230           55330                           TS       MARKSTAT                      	#
009901,000384: 07,2231           40000                           COM                                    	#
009902,000385: 07,2232           75006                           MASK     BIT10                         	# SET BIT10 TO ENABLE REJECT
009903,000386: 07,2233           27330                           ADS      MARKSTAT                      	#
009904,000387: 
009905,000388: 07,2234           75046                           MASK     LOW9                          	#
009906,000389: 07,2235           54061                           TS       ITEMP1                        	#
009907,000390: 07,2236           50000                           INDEX    A                             	#
009908,000391: 07,2237           56052                           XCH      QPRET                         	# PICK UP MARK SLOT-POINTER
009909,000392: 07,2240           54062                           TS       ITEMP2                        	# SAVE CURRENT POINTER
009910,000393: 07,2241           65023                           AD       SEVEN                         	# INCREMENT POINTER
009911,000394: 07,2242           50061                           INDEX    ITEMP1                        	#
009912,000395: 07,2243           54052                           TS       QPRET                         	# STORE ADVANCED POINTER
009913,000396: 
009914,000397: 07,2244           00006        VACSTOR            EXTEND                                 	#
009915,000398: 07,2245           30356                           DCA      MKT2T1                        	#
009916,000399: 07,2246           50062                           INDEX    ITEMP2                        	#
009917,000400: 07,2247           52001                           DXCH     0                             	#
009918,000401: 07,2250           30357                           CA       MKCDUY                        	#
009919,000402: 07,2251           50062                           INDEX    ITEMP2                        	#
009920,000403: 07,2252           54002                           TS       2                             	#
009921,000404: 07,2253           30360                           CA       MKCDUS                        	#
009922,000405: 07,2254           50062                           INDEX    ITEMP2                        	#
009923,000406: 07,2255           54003                           TS       3                             	#
009924,000407: 07,2256           30361                           CA       MKCDUZ                        	#
009925,000408: 07,2257           50062                           INDEX    ITEMP2                        	#
009926,000409: 07,2260           54004                           TS       4                             	#
009927,000410: 07,2261           30362                           CA       MKCDUT                        	#
009928,000411: 07,2262           50062                           INDEX    ITEMP2                        	#
009929,000412: 07,2263           54005                           TS       5                             	#
009930,000413: 07,2264           30363                           CA       MKCDUX                        	#
009931,000414: 07,2265           50062                           INDEX    ITEMP2                        	#
009932,000415: 07,2266           54006                           TS       6                             	#
009933,000416: 
009934,000417: 07,2267           37671                           CAF      PRIO34                        	# IF ALL MARKS MADE FLASH VB50
009935,000418: 07,2270           71330                           MASK     MARKSTAT                      	#
009936,000419: 07,2271           00006                           EXTEND                                 	#
009937,000420: 07,2272           12274                           BZF      +2                            	#
009938,000421: 07,2273           15324                           TCF      TASKOVER                      	#
009939,000422: 07,2274           37667                           CAF      PRIO32                        	#
009940,000423: 07,2275           05134                           TC       NOVAC                         	#
009941,000424: 07,2276     1330                                  EBANK=   MARKSTAT                      	#
009942,000425: 07,2276           02422 16062                     2CADR    MKVB50                        	#
009943,000426: 
009944,000427: 07,2300           15324                           TCF      TASKOVER                      	#
009945,000428: 
009947,000430:                                                                                          	# PROGRAM NAME - MKREJECT                                       DATE - 5 APRIL 1967
009948,000431:                                                                                          	# PROGRAM MODIFIED BY 258/278 PROGRAMMERS                       LOG SECTION SXTMARK
009949,000432:                                                                                          	# MOD BY - R. MELANSON TO ADD DOCUMENTATION                     ASSEMBLY SUNDISK REV. 116
009950,000433: 
009951,000434:                                                                                          	# FUNCTIONAL DESCRIPTION-
009952,000435:                                                                                          	#       ROUTINE ALLOWS OPERATOR TO REJECT MARK MADE PRIOR TO ACCEPTANCE AND ALLOWS A NEW MARK TO BE MADE BY ASTRONAUT
009953,000436: 
009954,000437:                                                                                          	# CALLING SEQUENCE-
009955,000438:                                                                                          	#       FROM MARKRUPT IF BIT7 OF CHANNEL 16 IS 1.
009956,000439: 
009957,000440:                                                                                          	# NORMAL EXIT MODE-
009958,000441:                                                                                          	#       RESUME
009959,000442: 
009960,000443:                                                                                          	# ALARM OR ABORT EXIT MODE-
009961,000444:                                                                                          	#       ALARM AND RESUME
009962,000445: 
009963,000446:                                                                                          	# OUTPUT-
009964,000447:                                                                                          	#       1)      FOR R21-
009965,000448:                                                                                          	#               MRKBUF1 SET TO -1
009966,000449:                                                                                          	#       2)      FOR NORMAL MARKING-
009967,000450:                                                                                          	#               BIT10 MARKSTAT =0, INCREMENT NO. MARKS BY 1, DECREMENT QPRET BY 7
009968,000451: 
009969,000452:                                                                                          	# ERASABLE INITIALIZATION-
009970,000453:                                                                                          	#       1)      FOR R21-
009971,000454:                                                                                          	#               BIT14 OF STATE+2 SET TO 1
009972,000455:                                                                                          	#       2)      FOR NORMAL MARKING-
009973,000456:                                                                                          	#               BIT14 OF STATE+2 SET TO 0, MARKSTAT,QPRET
009974,000457: 
009975,000458:                                                                                          	# DEBRIS-
009976,000459:                                                                                          	#       1)      FOR R21-
009977,000460:                                                                                          	#               A,MARKSTAT,EBANK
009978,000461:                                                                                          	#       2)      FOR NORMAL MARKING-
009979,000462:                                                                                          	#               A,MARKSTAT,ITEMP1,QPRET
009980,000463: 
009981,000464: 07,2301           35002        MKREJECT           CAF      BIT14                         	#
009982,000465: 07,2302           70076                           MASK     STATE      +2                 	# R21 MARK (SPECIAL MARKING FOR R21)
009983,000466: 07,2303           00006                           EXTEND                                 	#
009984,000467: 07,2304           12310                           BZF      MRKREJCT                      	# NOT SET THEREFORE REGULAR REJECT
009985,000468: 07,2305           37716                           CA       NEGONE                        	# -1 (FOR R22)
009986,000469: 07,2306           55725                           TS       MRKBUF1                       	# -0 IN TIME IS FLAG TO R22 SIGNIFYING A
009987,000470: 07,2307           05333                           TC       RESUME                        	# REJECTED MARK
009988,000471: 07,2310           11330        MRKREJCT           CCS      MARKSTAT                      	# SEE IF MARKS BEING ACCEPTED
009989,000472: 07,2311           02315                           TC       REJECT2                       	#
009990,000473: 07,2312           05650                           TC       ALARM                         	# MARKS NOT BEING ACCEPTED
009991,000474: 07,2313           00112                           OCT      112                           	#

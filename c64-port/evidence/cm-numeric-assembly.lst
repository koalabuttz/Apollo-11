022160,000149: 
022162,000151:                                                                                          	# STATEXTP DOES AN INITIAL PRECISION EXTRAPOLATION OF THE
022163,000152:                                                                                          	# LEM STATE VECTOR TO PRESENT TIME OR TO PIPTIME IF AV G
022164,000153:                                                                                          	# IS ON AND SAVES AS BASE VECTOR. IF AV G IS ON RN + VN
022165,000154:                                                                                          	# ARE USED AS THE CM STATE VECTOR AND THE INITIAL R RDOT
022166,000155:                                                                                          	# RTHETA ARE COMPUTED WITH NO FURTHER INTEGRATION. IF AV
022167,000156:                                                                                          	# G IS OFF A PRECISION EXTRAPOLATION IS MADE OF THE CM
022168,000157:                                                                                          	# STATE VECTOR TO PRESENT TIME AND.....
022169,000158: 
022170,000159:                                                                                          	#   THE CM + LM STATE VECTORS ARE INTEGRATED TO PRES TIME
022171,000160:                                                                                          	#   USING PRECISION OR CONIC AS SURFFLAG IS SET OR CLEAR.
022172,000161: 
022173,000162:                                                                                          	#   IF AV G IS ON THEN SUBSEQUENT PASSES WILL PROVIDE
022174,000163:                                                                                          	#     USE OF RN + VN AS CM STATE VECTOR AND THE LM STATE
022175,000164:                                                                                          	#     VECTOR WILL BE PRECISION INTEGRATED USING LEMPREC
022176,000165: 
022177,000166:                                                                                          	#   IF SURFFLAG IS SET.
022178,000167:                                                                                          	#     CM STATE VECTOR RONE VONE + LM STATE VECTOR RATT
022179,000168:                                                                                          	#     VATT ARE USED IN COMPUTING R RDOT RTHETA.
022180,000169: 
022181,000170: 
022182,000171: 31,2140           43034        STATEXTP           RTB      BOF                           	# INITIAL INTEGRATION
022183,000172: 31,2141           45510                                    LOADTIME                      	#
022184,000173: 31,2142           03751                                    V37FLAG                       	#
022185,000174: 31,2143           62146                                    +3                            	# AV G OFF, USE PRES TIME
022186,000175: 31,2144           77624                           CALL                                   	#
022187,000176: 31,2145           62273                                    GETRVN                        	#      ON,  USE RN VN PIPTIME
022188,000177: 31,2146           02343                           STORE    BASETIME                      	# PRES TIME OR PIPTIME
022189,000178: 31,2147           34041                           STCALL   TDEC1                         	#

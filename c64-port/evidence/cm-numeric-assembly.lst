046882,000501: 17,3211           33310                           CAF      =+.1SEC                       	# LIMIT THE LENGTH OF PITCH ROTATION
046883,000502: 17,3212           55461                           TS       BLAST1                        	# COMMANDS TO 0.1 SEC SO THAT ONLY
046884,000503: 17,3213           13357                           TCF      ASMBLWP                       	# X-TRANSLATIONS WILL CONTINUE ON SWITCH
046885,000504:                                                                                          	# OVER TO TVC
046886,000505: 17,3214           41461        AD14MSP            CS       BLAST1                        	# SEE IF JET ON TIME LESS THAN
046887,000506: 17,3215           63313                           AD       =14MS                         	# MINIMUM IMPULSE TIME
046888,000507: 17,3216           00006                           EXTEND                                 	#
046889,000508: 17,3217           63222                           BZMF     PBLASTOK                      	# IF SO LIMIT MINIMUM ON TIME TO 14 MS
046890,000509: 17,3220           33313                           CAF      =14MS                         	#
046892,000511: 17,3221           55461                           TS       BLAST1                        	#
046893,000512: 17,3222           31461        PBLASTOK           CA       BLAST1                        	#
046894,000513: 17,3223           00006                           EXTEND                                 	# THE PITCH COMMANDS WILL BE COMPLETED
046895,000514: 17,3224           71523                           MP       NPJETS                        	# WITHIN THE TS-CYCLE TIME
046896,000515: 17,3225           23550                           LXCH     DFT1                          	# FOR USE IN UPDATING RATE FILTER
046897,000516: 17,3226           55562                           TS       TAU1                          	# ZERO TAU1 (ACC CONTAINS ZERO)
046898,000517: 17,3227           13357                           TCF      ASMBLWP                       	#

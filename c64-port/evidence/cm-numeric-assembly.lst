004846,003211: E6,1541  E6,1507               SALFA              EQUALS   CALFA      +1                 	# 1P
004847,003212: 
004848,003213: E6,1541  E6,1510               SINM               EQUALS   SALFA      +1                 	# 1P
004849,003214: E6,1541  E6,1511               COSM               EQUALS   SINM       +1                 	# 1P
004850,003215: E6,1541  E6,1512               SINO               EQUALS   COSM       +1                 	# 1P
004851,003216: E6,1541  E6,1513               COSO               EQUALS   SINO       +1                 	# 1P
004852,003217: E6,1541  E6,1514               SINOCOSM           EQUALS   COSO       +1                 	# 1P
004853,003218: E6,1541  E6,1515               COSOCOSM           EQUALS   SINOCOSM   +1                 	# 1P
004854,003219:                                                                                          	#>> SHARE ABOVE WITH RCS RUPT TEMPS <<<
004855,003220: 
004856,003221:                                                                                          	# THE FOLLOWING FEW REGISTERS USED ONCE EACH 2 SEC.
004857,003222: E6,1541  E6,1613               -VT/180            EQUALS   NUJET      +1                 	# 1P
004858,003223: E6,1541  E6,1614               LCX/360            EQUALS   -VT/180    +1                 	# 1P
004859,003224: E6,1541  E6,1615               XD/360             EQUALS   LCX/360    +1                 	# 1P
004860,003225: E6,1541  E6,1616               VSQ/4API           EQUALS   XD/360     +1                 	# 1P
004861,003226: E6,1541  E6,1617               JNDX               EQUALS   VSQ/4API   +1                 	# 1P
004862,003227: E6,1541  E6,1620               JNDX1              EQUALS   JNDX       +1                 	# 1P
004864,003229: E6,1541  E6,1621               TON1               EQUALS   JNDX1      +1                 	# 1P DP PAIR
004865,003230: E6,1541  E6,1622               T1BITS             EQUALS   TON1       +1                 	# 1P
004866,003231: 
004867,003232:                                                                                          	# MISCELLANEOUS REGISTERS USED EACH UPDATE.
004868,003233: E6,1541  E6,1623               CM/SAVE            EQUALS   T1BITS     +1                 	# 1P
004869,003234: E6,1541  E6,1624               JETEM2             EQUALS   CM/SAVE    +1                 	# 1P TEMPORARY STORAGE
004870,003235: 
004871,003236:                                                                                          	# DAP QUANTITIES SHARED WITH RCS DAP FOR TM & FLIGHT RECORDER.
004872,003237: E6,1541  E6,1567               VDT/180            =        ERRORX                        	# 1P (EDIT)
004873,003238: E6,1541  E6,1570               -VT/180E           =        ERRORY                        	# 1P (EDIT)
004874,003239: 
004875,003240: E6,1541  E6,1476               PAXERR             EQUALS   AK                            	# 1P ROLL ERROR FOR NEEDLES
004876,003241: E6,1541  E6,1572               QAXERR             =        THETADX                       	# 1P SINCE AK1 IS ZEROED IN ATM DAP.
004877,003242: E6,1541  E6,1573               RAXERR             =        QAXERR     +1                 	# 1P SINCE AK2 IS ZEROED IN TM DAP.
004878,003243: 
004879,003244:                                                                                          	# **** COLMANU (R60,R62) ****
004880,003245: E6,1541  E6,1710               VECQTEMP           EQUALS   COFSKEW                       	#
004881,003246: 
004883,003248:                                                                                          	# ******** KALCMANU VARIABLES. (71D) *************************************
004884,003249: E6,1541  E6,1661               BCDU               EQUALS   YMANNDX    +1                 	# B(3)TMP
004885,003250: E6,1541  E6,1664               KSPNDX             EQUALS   BCDU       +3                 	# B(1)TMP
004886,003251: E6,1541  E6,1665               KDPNDX             EQUALS   KSPNDX     +1                 	# B(1)TMP
004887,003252: 
004888,003253: E6,1541  E6,1666               TMIS               EQUALS   KDPNDX     +1                 	# I(18) MUST BE IN SAME BANK AS RCS DAP
004889,003254: E6,1541  E6,1710               COFSKEW            EQUALS   TMIS       +18D               	# I(6)  MUST BE IN SAME BANK AS RCS DAP
004890,003255: E6,1541  E6,1716               CAM                EQUALS   COFSKEW    +6                 	# I(2)  MUST BE IN SAME BANK AS RCS DAP
004891,003256: 
004892,003257: E6,1541  E6,1720               MIS                EQUALS   CAM        +2                 	# I(18) (THE REST MAY GO ANYWHERE)
004893,003258: E6,1541  E6,1742               COF                EQUALS   MIS        +18D               	# I(6)TMP
004894,003259: E6,1541  E6,1750               SCAXIS             EQUALS   COF        +6                 	# I(6)TMP
004895,003260: E6,1541  E6,1756               POINTVSM           EQUALS   SCAXIS     +6                 	# I(6)TMP
004896,003261: E6,1541  E6,1764               AM                 EQUALS   POINTVSM   +6                 	# I(2)TMP
004897,003262: E6,1541  E6,1766               RAD                EQUALS   AM         +2                 	# I(2)TMP
004898,003263: 
004899,003264:                                                                                          	# FIRST-ORDER OVERLAYS IN KALCMANU
004900,003265: E6,1541  E6,1666               KV1                EQUALS   TMIS                          	# I(6)TMP

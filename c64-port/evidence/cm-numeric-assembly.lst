033971,001088:                                                                                          	# ROUTINE NAME - CHKSDATA               DATE - JAN 9, 1967
033972,001089:                                                                                          	# MOD NO - 0                            LOG SECTION - P51-P53
033973,001090:                                                                                          	# MODIFICATION BY - LONSKE              ASSEMBLY -
033974,001091: 
033975,001092:                                                                                          	# FUNCTIONAL DESCRIPTION - CHECKS THE VALIDITY OF A PAIR OF STAR SIGHTINGS.  WHEN A PAIR OF STAR SIGHTINGS ARE MADE
033976,001093:                                                                                          	# BY THE ASTRONAUT THIS ROUTINE OPERATES AND CHECKS THE OBSERVED SIGHTINGS AGAINST STORED STAR VECTORS IN THE
033977,001094:                                                                                          	# COMPUTER TO INSURE A PROPER SIGHTING WAS MADE.  THE FOLLOWING COMPUTATIONS ARE PERFORMED_
033978,001095:                                                                                          	#       OS1     =       OBSERVED STAR 1 VECTOR
033979,001096:                                                                                          	#       OS2     =       OBSERVED STAR 2 VECTOR
033980,001097:                                                                                          	#       SS1     =       STORED STAR 1 VECTOR
033981,001098:                                                                                          	#       SS2     =       STORED STAR 2 VECTOR
033982,001099:                                                                                          	#        A1     =       ARCCOS(OS1 - OS2)
033984,001101:                                                                                          	#        A2     =       ARCCOS(SS1 - SS2)
033985,001102:                                                                                          	#         A     =       ABS(2(A1 - A2))
033986,001103: 
033987,001104:                                                                                          	# THE ANGULAR DIFFERENCE IS DISPLAYED FOR ASTRONAUT ACCEPTENCE
033988,001105: 
033989,001106:                                                                                          	# EXIT MODE     1. FREEFLAG SET IMPLIES ASTRONAUT WANTS TO PROCEED
033990,001107:                                                                                          	#               2. FREEFLAG RESET IMPLIES ASTRONAUT WANTS TO RECYCLE             ERANCE)
033991,001108: 
033992,001109:                                                                                          	# OUTPUT -      1. VERB 6,NOUN 3 - DISPLAYS ANGULAR DIFFERENCE BETWEEN 2 SETS OF STARS.
033993,001110:                                                                                          	#               2. STAR VECTORS FROM STAR CATALOG ARE LEFT IN 6D AND 12D.
033994,001111: 
033995,001112:                                                                                          	# ERASABLE INITIALIZATION REQUIRED -
033996,001113:                                                                                          	#               1. MARK VECTORS ARE STORED IN STARAD AND STARAD +6.
033997,001114:                                                                                          	#               2. CATALOG VECTORS ARE STORED IN 6D AND 12D.
033998,001115: 

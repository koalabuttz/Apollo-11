012617,000197: 
012619,000199:                                                                                          	# THESE TWO ROUTINES COMPUTE THE ACTUAL STATE VECTOR FOR LM, CSM BY ADDING
012620,000200:                                                                                          	# THE CONIC R,V AND THE DEVIATIONS R,V.  THE STATE VECTORS ARE CONVERTED TO
012621,000201:                                                                                          	# METERS B-29 AND METERS/CSEC B-7 AND STORED APPROPRIATELY IN RN,VN OR
012622,000202:                                                                                          	# R-OTHER, V-OTHER FOR DOWNLINK.  THE ROUTINES NAMES ARE SWITCHED IN THE
012623,000203:                                                                                          	# OTHER VEHICLES COMPUTER.
012624,000204: 
012625,000205:                                                                                          	# INPUT
012626,000206:                                                                                          	#       STATE VECTOR IN TEMPORARY STORAGE AREA
012627,000207:                                                                                          	#       IF STATE VECTOR IS SCALED POS B27 AND VEL B5
012628,000208:                                                                                          	#               SET X2 TO +2
012629,000209:                                                                                          	#       IF STATE VECTOR IS SCALED POS B29 AND VEL B7
012630,000210:                                                                                          	#               SET X2 TO 0
012631,000211: 
012632,000212:                                                                                          	# OUTPUT
012633,000213:                                                                                          	#       R(T) IN RN, V(T) IN VN, T IN PIPTIME
012634,000214:                                                                                          	#               OR
012635,000215:                                                                                          	#       R(T) IN R-OTHER, V(T) IN V-OTHER        (T IS DEFINED BY T-OTHER)
012636,000216: 

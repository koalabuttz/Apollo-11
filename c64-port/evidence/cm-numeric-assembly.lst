037927,000176: 25,2124           03645                                    GOTOADDR                      	#
037928,000177: 
037929,000178:                                                                                          	#          GOTOADDR CONTAINS THE ADDRESS OF THE ROLL COMMAND EQUATIONS APPROPRIATE TO THE CURRENT PHASE OF
037930,000179:                                                                                          	# RE-ENTRY.  SEQUENCING IS AS FOLLOWS:
037931,000180: 
037932,000181:                                                                                          	# INITROLL      ADDRESS IS SET HERE INITIALLY.  HOLDS INITIAL ROLL ATTITUDE UNTIL  KAT  IS EXCEEDED.  THEN HOLDS NEW ROLL
037933,000182:                                                                                          	#               ATTITUDE UNTIL  VRTHRESH  IS EXCEEDED.  THEN BRANCHES TO
037934,000183: 
037935,000184:                                                                                          	# HUNTEST       THIS SECTION CHECKS TO SEE IF THE PREDICTED RANGE AT NOMINAL   L/D FROM PRESENT CONDITIONS IS LESS
037936,000185:                                                                                          	#               THAN THE DESIRED RANGE.
037937,000186:                                                                                          	#                       IF NOT - A ROLL COMMAND IS GENERATED BY THE CONSTANT DRAG CONTROLLER.
037938,000187:                                                                                          	#                       IF SO  - CONTROL AND GOTOADDR ARE SET TO UPCONTRL.
037939,000188:                                                                                          	#               USUALLY NO ITERATION IS INVOLVED EXCEPT IF THE RANGE DESIRED IS TOO LONG ON THE FIRST PASS THROUGH
037940,000189:                                                                                          	#               HUNTEST.
037941,000190: 
037942,000191:                                                                                          	# UPCONTRL      CONTROLS ROLL DURING THE SUPER-CIRCULAR PHASE.  UPCONTRL IS TERMINATED EITHER
037943,000192:                                                                                          	#                       (A) WHEN THE DRAG (AS MEASURED BY THE PIPAS) FALLS BELOW Q7, OR
037944,000193:                                                                                          	#                       (B) IF RDOT IS NEGATIVE AND REFERENCE VL EXCEEDS V.
037945,000194:                                                                                          	#               IN CASE (A),  GOTOADDR  IS SET TO  KEP2  AND IN CASE (B), TO  PREDICT3  SKIPPING THE KEPLER PHASE OF
037946,000195:                                                                                          	#               ENTRY.
037947,000196: 
037948,000197:                                                                                          	# KEP2          GOTOADDR IS SET HERE DURING THE KEPLER PHASE TO MONITOR DRAG.  THE SPACECRAFT IS INSTANTANEOUSLY
037949,000198:                                                                                          	#               TRIMMED IN PITCH AND YAW TO THE COMPUTED RELATIVE VELOCITY.  THE LAST COMPUTED ROLL ANGLE IS MAINTAINED.
037950,000199:                                                                                          	#               WHEN THE MEASURED DRAG EXCEEDS Q7 +0.5,  GOTOADDR  IS SET TO
037951,000200: 
037952,000201:                                                                                          	# PREDICT3      THIS CONTROLS THE FINAL SUB-ORBITAL PHASE. ROLL COMMANDS CEASE
037953,000202:                                                                                          	#               WHEN  V  IS LESS THAN  VQUIT .  AN EXIT IS MADE TO
037954,000203: 
037955,000204:                                                                                          	# P67.1         THE LAST COMPUTED ROLL ANGLE IS MAINTAINED.  RATE DAMPING IS DONE IN PITCH AND YAW.  PRESENT LATITUDE
037956,000205:                                                                                          	#               AND LONGITUDE ARE COMPUTED FOR DISPLAY.
037957,000206:                                                                                          	#               ENTRY IS TERMINATED WHEN DISKY RESPONSE IS MADE TO TO THIS FINAL FLASHING DISPLAY.
037958,000207: 
037960,000209:                                                                                          	# PROCESS AVERAGE G OUTPUT...SCALE IT AND GET INPUT DATA
037961,000210: 

022837,000358:                                                                                          	# SUBROUTINE NAME: SR30.1
022838,000359:                                                                                          	# MOD NO: 0                                                             DATE: 16 FEB 67
022839,000360:                                                                                          	# MOD BY: RR BAIRNSFATHER                                               LOG SECTION: R32
022840,000361:                                                                                          	# MOD NO: 1     MOD BY: RR BAIRNSFATHER         DATE: 11 APR 67         SR30.1 CHANGED TO ALLOW MONITOR OPERN
022841,000362:                                                                                          	# MOD NO: 2     MOD BY: RR BAIRNSFATHER         DATE: 14 APR 67         ADD OVFL CK FOR RAPO
022842,000363:                                                                                          	# MOD NO: 3     MOD BY ALONSO                   DATE: 11 DEC 67         SUBROUTINE REWRITTEN
022843,000364:                                                                                          	# MOD NO: 4     MOD BY ALONSO                   DATE: 26 MAR 68         PROG MOD TO HANDLE DIF EARTH/MOON SCALE
022844,000365:                                                                                          	# MOD NO: 5     MOD BY: RR BAIRNSFATHER         DATE: 6 AUG 68          OVFL CK FOR HAPO & HPER. VOIDS MOD #2.
022845,000366: 
022846,000367:                                                                                          	# NEW FUNCTIONAL DESCRIPTION:  ORBITAL PARAMETERS DISPLAY FOR NOUNS 32 AND 44.
022847,000368:                                                                                          	# SR30.1 CALLS TFFCONMU AND TFFRP/RA TO CALCULATE RPER (PERIGEE RADIUS),
022848,000369:                                                                                          	# RAPO (APOGEE RADIUS), HPER (PERIGEE HEIGHT ABOVE LAUNCH PAD OR LUNAR
022849,000370:                                                                                          	# LANDING SITE), HAPO (APOGEE HEIGHT AS ABOVE), TPER (TIME TO PERIGEE),
022850,000371:                                                                                          	# TFF (TIME TO INTERSECT 300 KFT ABOVE PAD OR 35KFT ABOVE LANDING SITE).
022851,000372:                                                                                          	# IF HPER IS GREATER THAN OR EQUAL TO HPERMIN, CALCULATES TPER AND STORES
022852,000373:                                                                                          	# NEGATIVE    IN -TPER. OTHERWISE STORES +0 IN -TPER. WHENEVER TPER IS
022853,000374:                                                                                          	# CALCULATED, TFF IS NOT COMPUTABLE AND DEFAULTS TO -59MIN 59SEC.  IF HAPO
022854,000375:                                                                                          	# WOULD EXCEED 9999.9 NM, IT IS LIMITED TO THAT VALUE FOR DISPLAY.
022855,000376: 
022856,000377:                                                                                          	# ADDENDUM:     HAPO AND HPER SHOULD BE CHANGED TO READ HAPOX AND HPERX IN THE
022857,000378:                                                                                          	#               ABOVE REMARKS.
022858,000379: 
022859,000380:                                                                                          	# CALLING SEQUENCE:     CALL
022860,000381:                                                                                          	#                               SR30.1
022861,000382: 
022862,000383:                                                                                          	# SUBROUTINES CALLED:   TFFCONMU, TFFRP/RA, CALCTPER, CALCTFF
022863,000384: 
022864,000385:                                                                                          	# NORMAL EXIT MODE:     CALLING LINE +1 (STILL IN INTERPRETIVE MODE)
022865,000386: 
022866,000387:                                                                                          	# ALARMS:       NONE
022867,000388: 
022868,000389:                                                                                          	# OUTPUT:       RAPO    (-29) M EARTH   APOGEE RADIUS   EARTH CENTERED COORD.
022869,000390:                                                                                          	#                       (-27) M MOON                    MOON CENTERED COORD.
022870,000391:                                                                                          	#               RPER    (-29) M EARTH   PERIGEE RADIUS  EARTH CENTERED COORD.
022871,000392:                                                                                          	#                       (-27) M MOON                    MOON CENTERED COORD.
022872,000393:                                                                                          	#               HAPOX   (-29) M         APOGEE ALTITUDE ABOVE PAD OR LAND. SITE MAX VALUE LIMITED TO 9999.9 NM.
022873,000394:                                                                                          	#               HPERX   (-29) M         PERIGEE ALT. ABOVE PAD OR LAND. SITE    MAX VALUE LIMITED TO 9999.9 NM.
022874,000395:                                                                                          	#               TFF     (-28) CS        TIME TO 300KFT OR 35KFT ALTITUDE
022875,000396:                                                                                          	#               -TPER   (-28) CS        TIME TO PERIGEE
022876,000397: 
022877,000398:                                                                                          	# ERASABLE INITIALIZATION REQUIRED -
022878,000399:                                                                                          	#       TFF/RTMU        (+17) EARTH     RECIPROCAL OF PROPER GRAV CONSTANT FOR
022879,000400:                                                                                          	#                       (+14) MOON      EARTH OR MOON = 1/SQRT(MU).
022880,000401:                                                                                          	#       RONE            (-29) M         STATE VECTOR
022881,000402:                                                                                          	#       VONE            (-7)  M/CS      STATE VECTOR
022882,000403:                                                                                          	#       RPADTEM         (-29) M EARTH   RADIUS OF LAUNCH PAD OR LUNAR LANDING
022883,000404:                                                                                          	#                       (-27) M MOON    SITE.
022884,000405:                                                                                          	#       HPERMIN         (-29) M EARTH   (300 OR 35) KFT MINIMUM PERIGEE ALTITUDE
022885,000406:                                                                                          	#                       (-27) M MOON    ABOVE LAUNCH PAD OR LUNAR LANDING SITE.
022886,000407:                                                                                          	#       V82EMFLG        (INT SW BIT)    RESET FOR EARTH, SET FOR MOON.
022887,000408: 
022888,000409:                                                                                          	# DEBRIS:       QPRET, PDL, S2
022889,000410: 
022891,000412: 23,2667                                           COUNT*   $$/SR30S                      	#
022892,000413: 
022893,000414: 23,2667           44001        SR30.1             SETPD    STQ                           	# INITIALIZE PUSHDOWN LIST.
022894,000415: 23,2670           00001                                    0                             	#
022895,000416: 23,2671           00051                                    S2                            	#
022896,000417:                                                                                          	# SR30.1 INPUT: RONE AT (-29)M EARTH/MOON
022897,000418:                                                                                          	#               VONE AT (-7)M/CS
022898,000419:                                                                                          	# TFFCONMU, TFFRP/RA, CALCTPER AND CALCTFF
022899,000420:                                                                                          	# CALLS REQUIRE:
022900,000421:                                                                                          	# EARTH CENTERED (NO RESCALING REQUIRED)
022901,000422:                                                                                          	#       RONE SCALED TO B-29 M
022902,000423:                                                                                          	#       VONE SCALED TO B-7 M/CS
022903,000424:                                                                                          	# MOON CENTERED (RESCALING REQUIRED)
022904,000425:                                                                                          	#       RONE SCALED TO B-27 M
022905,000426:                                                                                          	#       VONE SCALED TO B-5 M/CS
022906,000427: 23,2672           77214                           BOFF     VLOAD                         	#
022907,000428: 23,2673           04742                                    V82EMFLG                      	# OFF FOR EARTH, ON FOR MOON.
022908,000429: 23,2674           46703                                    TFFCALLS                      	#
022909,000430: 23,2675           02327                                    RONE                          	#
022910,000431: 23,2676           77752                           VSL2                                   	#
022911,000432: 23,2677           26327                           STOVL    RONE                          	#
022912,000433: 23,2700           02335                                    VONE                          	#
022913,000434: 23,2701           77752                           VSL2                                   	#
022914,000435: 23,2702           02335                           STORE    VONE                          	#
022915,000436: 23,2703           77624        TFFCALLS           CALL                                   	#
022916,000437: 23,2704           56760                                    TFFCONMU                      	#
022917,000438: 23,2705           77624                           CALL                                   	# TFFRP/RA COMPUTES RAPO,RPER.
022918,000439: 23,2706           57026                                    TFFRP/RA                      	#
022919,000440:                                                                                          	# RETURNS WITH RAPO IN D(MPAC).
022920,000441: 23,2707           77625                           DSU                                    	#
022921,000442: 23,2710           02323                                    RPADTEM                       	#
022922,000443: 23,2711           64414                           BOFF     SR2R                          	# NEED HAPO AT (-29)M FOR DISPLAY.
022923,000444:                                                                                          	# IF MOON CENTERED, RESCALE FROM (-27)M.
022924,000445:                                                                                          	# IF EARTH CENTERED ALREADY AT (-29)M.
022925,000446: 23,2712           04742                                    V82EMFLG                      	# OFF FOR EARTH, ON FOR MOON.
022926,000447: 23,2713           46714                                    +1                            	#
022927,000448: 23,2714           77624                           CALL                                   	# IF HAPO > MAXNM, SET HAPO =9999.9 NM.
022928,000449: 23,2715           46754                                    MAXCHK                        	# OTHERWISE STORE (RAPO-RPADTEM) IN HAPO.
022929,000450: 23,2716           16352        STORHAPO           STODL    HAPOX                         	#
022930,000451: 23,2717           00017                                    RPER                          	#
022931,000452: 23,2720           77625                           DSU                                    	#
022932,000453: 23,2721           02323                                    RPADTEM                       	# GIVES HPER AT (-29)M EARTH, (-27)M MOON.
022933,000454: 23,2722           00161                           STORE    MPAC       +4                 	# SAVE THIS FOR COMPARISON TO HPERMIN.
022934,000455: 23,2723           64414                           BOFF     SR2R                          	# NEED HPER AT (-29)M FOR DISPLAY.
022935,000456:                                                                                          	# IF MOON CENTERED, RESCALE FROM (-27)M.
022936,000457:                                                                                          	# IF EARTH CENTERED ALREADY AT (-29)M.
022937,000458: 23,2724           04742                                    V82EMFLG                      	# OFF FOR EARTH, ON FOR MOON.
022938,000459: 23,2725           46726                                    +1                            	#
022939,000460: 23,2726           77624                           CALL                                   	# IF HPER > MAXNM, SET HPER = 9999.9 NM.
022940,000461: 23,2727           46754                                    MAXCHK                        	#
022942,000463: 23,2730           16354        STORHPER           STODL    HPERX                         	# STORE (RPER - RPADTEM) INTO HPERX.
022943,000464: 23,2731           00161                                    MPAC       +4                 	#
022944,000465: 23,2732           51025                           DSU      BPL                           	# HPERMIN AT (-29)M FOR EARTH, (-27)M MOON
022945,000466: 23,2733           02321                                    HPERMIN                       	# IF HPER L/ HPERMIN (300 OR 35) KFT,
022946,000467: 23,2734           46740                                    DOTPER                        	# THEN ZERO INTO -TPER.
022947,000468: 23,2735           52145                           DLOAD    GOTO                          	# OTHERWISE CALCULATE TPER.
022948,000469: 23,2736           15335                                    HI6ZEROS                      	#
022949,000470: 23,2737           46744                                    SKIPTPER                      	#
022950,000471: 23,2740           45145        DOTPER             DLOAD    CALL                          	#
022951,000472: 23,2741           00017                                    RPER                          	#
022952,000473: 23,2742           57064                                    CALCTPER                      	#
022953,000474: 23,2743           77676                           DCOMP                                  	# TPER IS PUT NEG INTO -TPER.
022954,000475: 23,2744           16346        SKIPTPER           STODL    -TPER                         	#
022955,000476: 23,2745           02321                                    HPERMIN                       	# HPERMIN AT (-29)M FOR EARTH, (-27)M MOON
022956,000477: 23,2746           45015                           DAD      CALL                          	#
022957,000478: 23,2747           02323                                    RPADTEM                       	# RPADTEM AT (-29)M FOR EARTH, (-27)M MOON
022958,000479: 23,2750           57067                                    CALCTFF                       	# GIVES 59M59S FOR TFF IF RPER G/
022959,000480: 23,2751           77676                           DCOMP                                  	# HPERMIN + RPADTEM.  (TPER WAS NON ZERO)
022960,000481: 23,2752           36344                           STCALL   TFF                           	# OTHERWISE COMPUTES TFF.       (GOTO)
022961,000482: 23,2753           00051                                    S2                            	#
022962,000483: 
022963,000484: 23,2754           51025        MAXCHK             DSU      BPL                           	# IF C(MPAC) > 9999.9 NM, MPAC = 9999.9 NM
022964,000485: 23,2755           06764                                    MAXNM                         	#
022965,000486: 23,2756           46761                                    +3                            	# OTHERWISE C(MPAC) = B(MPAC).
022966,000487: 23,2757           43415                           DAD      RVQ                           	#
022967,000488: 23,2760           06764                                    MAXNM                         	#
022968,000489: 23,2761           43545                 +3        DLOAD    RVQ                           	# (USED BY P30 - P37 ALSO)
022969,000490: 23,2762           06764                                    MAXNM                         	#
022970,000491: 
022971,000492: 23,2763           01065 05603  MAXNM              2OCT     0106505603                    	#
022972,000493: 

046013,000227: 21,3430           00114        WLH/SLOP           DEC      .00463                        	# = WL+H/SLOPE = .83333 DEG     $180
046014,000228: 21,3431           00055        WL-H/SLP           DEC      .00277                        	# = WL-H/SLOPE = .5 DEG         $180
046015,000229: 21,3432           00022 06426  WLH                2DEC     .0011111111                    	# = WL+H = 0.5 DEG/SEC          $450
046016,000230: 
046017,000231: 21,3434           00012 35415  WLMH               2DEC     .0006666666                    	# = WL-H = 0.3 DEG/SEC          $450
046018,000232: 

008790,001319: 04,2466           27110                           OCT      27110                         	# MM 72         EBANK 4         PRIO 13
008791,001320: 04,2467           27476                           OCT      27476                         	# MM 62         EBANK 6         PRIO 13
008792,001321: 04,2470           27475                           OCT      27475                         	# MM 61         EBANK 6         PRIO 13
008793,001322: 04,2471           27266                           OCT      27266                         	# MM 54         EBANK 5         PRIO 13
008794,001323: 04,2472           27265                           OCT      27265                         	# MM 53         EBANK 5         PRIO 13
008795,001324: 04,2473           27264                           OCT      27264                         	# MM 52         EBANK 5         PRIO 13
008796,001325: 04,2474           27263                           OCT      27263                         	# MM 51         EBANK 5         PRIO 13

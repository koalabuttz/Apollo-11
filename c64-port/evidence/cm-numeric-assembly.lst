031829,001384:                                                                                          	# PROGRAM DESCRIPTION S40.2,3           DATE 15,NOV,66
031830,001385:                                                                                          	# MOD NO 2                              LOG SECTION P40-P47
031831,001386:                                                                                          	# MOD BY ZELDIN
031832,001387: 
031833,001388:                                                                                          	# FUNCTIONAL DESCRIPTION
031834,001389:                                                                                          	#       
031835,001390:                                                                                          	#       COMPUTE GIMBAL ANGLES IF THRUSTING OCCURRED WITH PRESENT IMU
031836,001391:                                                                                          	#       ORIENTATION, WINGS LEVEL SPACECRAFT, HEADS UP
031837,001392:                                                                                          	#       COMPUTE X AXIS OF ENGINE BELL
031838,001393:                                                                                          	#       COMPUTE PREFERRED IMU ORIENTATION (XSCREF)
031839,001394:                                                                                          	#       FOR THIS CALCULATION, ASSUME X AXIS OF SC ALONG UT INITIALLY,
031840,001395:                                                                                          	#       YSC=UNIT(XXR), ZSC=UNIT(XX(XXR)) AND ROTATE ENGINE BELL ALONG UT
031841,001396:                                                                                          	#       NEW SC AXES WILL BE APPROX. WINGS LEVEL AND NEW SC AXES IN REF.
031842,001397:                                                                                          	#       COORDS. WILL BE PREFERRED IMU ORIENTATION.
031843,001398:                                                                                          	#       COMPUTE DESIRED THRUST DIRECTION IN SM COORDS.
031844,001399: 
031845,001400:                                                                                          	# CALLING SEQUENCE
031846,001401:                                                                                          	#       L       CALL
031847,001402:                                                                                          	#       L+1             S40.2,3
031848,001403: 
031849,001404:                                                                                          	# NORMAL EXIT MODE
031850,001405:                                                                                          	#       AT L+2 OF CALLING SEQUENCE (GOTO L+2)
031851,001406: 
031852,001407:                                                                                          	# SUBROUTINES CALLED
031853,001408:                                                                                          	#       CALCGA
031854,001409: 
031855,001410:                                                                                          	# ALARM OR ABORT MODES
031856,001411:                                                                                          	#       NONE
031857,001412: 
031858,001413:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
031859,001414:                                                                                          	#       PACTOFF         TOTAL PITCH TRIM ANGLE          SP AT 1.0795111 REV.
031860,001415:                                                                                          	#       YACTOFF         TOTAL YAW   TRIM ANGLE          SP AT 1.0795111 REV.
031861,001416:                                                                                          	#       UT              DESIRED THRUST DIRECTION        VECT. B2 M/(CS.CS)
031862,001417:                                                                                          	#       RTIG            POSITION AT TIME OF IGNITION    VECT. B29 M
031863,001418:                                                                                          	#       ENG2FLAG        ON=RCS  OFF=SPS
031864,001419: 
031865,001420:                                                                                          	# OUTPUT
031866,001421:                                                                                          	#       SCAXIS          UNIT VECT. ALIGNED WITH ENG BELL IN SC COOR     B1
031867,001422:                                                                                          	#       XSCREF          UNIT VECTORS ALIGNED WITH PREFERRED IMU         B1
031868,001423:                                                                                          	#       YSCREF
031869,001424:                                                                                          	#       ZSCREF
031870,001425:                                                                                          	#       GIMBAL ANGLES IN THETAD
031871,001426:                                                                                          	#       POINTVSM        UNIT VECT ALONG DESIRED THRUST DIRECTION IN SM  B1
031872,001427: 
031873,001428:                                                                                          	# DEBRIS
031874,001429:                                                                                          	#       PUSHLIST, QPRET, MPAC
031875,001430:                                                                                          	#       QTEMP   TEMP. ERASABLE
031876,001431: 

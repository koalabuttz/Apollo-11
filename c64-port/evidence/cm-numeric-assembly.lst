012536,000116:                                                                                          	# SXTANG COMPUTES THE SEXTANT SHAFT AND TRUNNION ANGLES REQUIRED TO POSITION THE OPTICS SUCH THAT A STAR LINE-OF-
012537,000117:                                                                                          	# SIGHT LIES ALONG THE STAR VECTOR.
012538,000118: 
012539,000119:                                                                                          	# THE INPUTS ARE  1) THE STAR VECTOR REFERRED TO ANY COORDINATE SYSTEM STORED AT STAR.  2) THE NAVIGATION BASE
012540,000120:                                                                                          	# COORDINATES REFERRED TO THE SAME COORDINATE SYSTEM.  THESE THREE HALF-UNIT VECTORS ARE STORED AT XNB, YNB,AND
012541,000121:                                                                                          	# ZNB.

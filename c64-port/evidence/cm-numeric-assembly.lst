063141,000099: 07,3752           13760                           BZF      CLUPLOCK                      	# CODE ONLY IF UPLOCKFL IS CLEAR (=0).
063142,000100: 
063143,000101: 07,3753           35014                           CAF      BIT4                          	# TEST UPLOCKFL FOR 0 OR 1.
063144,000102: 07,3754           70103                           MASK     FLAGWRD7                      	#
063145,000103: 07,3755           10000                           CCS      A                             	#
063146,000104: 07,3756           05333                           TC       RESUME                        	# UPLOCKFL = 1
063147,000105: 07,3757           03706                           TC       ACCEPTUP                      	# UPLOCKFL = 0
063148,000106: 
063149,000107: 07,3760           45014        CLUPLOCK           CS       BIT4                          	# CLEAR UPLOCKFL (I.E., SET BIT 4 OF
063150,000108: 07,3761           70103                           MASK     FLAGWRD7                      	# FLAGWRD7 = 0)
063151,000109: 07,3762           54103                           TS       FLAGWRD7                      	#
063152,000110: 07,3763           03706                           TC       ACCEPTUP                      	#
063153,000111: 
063154,000112:                                                                                          	# CODE IS BAD
063155,000113: 07,3764           40103        TMFAIL2            CS       FLAGWRD7                      	# LOCK OUT FURTHER UPLINK ACTIVITY
063156,000114: 07,3765           75014                           MASK     BIT4                          	# (BY SETTING UPLOCKFL = 1) UNTIL
063157,000115: 07,3766           26103                           ADS      FLAGWRD7                      	# 'ERROR RESET' IS SENT VIA UPLINK.
063158,000116: 07,3767           05333                           TC       RESUME                        	#
063159,000117: 07,3770           60073        UPTEST             AD       KEYTEMP1                      	#
063161,000119: 07,3771           10000                           CCS      A                             	#
063162,000120: 07,3772           03764                           TC       TMFAIL2                       	#
063163,000121: 07,3773           77740        HI10               OCT      77740                         	#
063164,000122: 07,3774           03764                           TC       TMFAIL2                       	#
063165,000123: 07,3775           00002                           TC       Q                             	#
063166,000124: 
063167,000125: 07,3776           00022        ELRCODE            OCT      22                            	#
063168,000126: 
063169,000127:                                                                                          	# 'UPLINK ACTIVITY LIGHT' IS TURNED OFF BY .....
063170,000128:                                                                                          	#       1.      VBRELDSP
063171,000129:                                                                                          	#       2.      ERROR RESET
063172,000130:                                                                                          	#       3.      UPDATE PROGRAM (P27) ENTERED BY V70,V71,V72, AND V73.
063173,000131: 
063174,000132:                                                                                          	#                                    -
063175,000133:                                                                                          	# THE RECEPTION OF A BAD CODE (I.E  CCC FAILURE) LOCKS OUT FURTHER UPLINK ACTIVITY BY SETTING BIT4 OF FLAGWRD7 = 1.
063176,000134:                                                                                          	# THIS INDICATION WILL BE TRANSFERRED TO THE GROUND BY THE DOWNLINK WHICH DOWNLINKS ALL FLAGWORDS.
063177,000135:                                                                                          	# WHEN UPLINK ACTIVITY IS LOCKED OUT, IT CAN BE ALLOWED WHEN THE GROUND UPLINKS AND 'ERROR RESET' CODE.
063178,000136:                                                                                          	# (IT IS RECOMMENDED THAT THE 'ERROR LIGHT RESET' CODE IS PRECEEDED BY 16 BITS THE FIRST OF WHICH IS 1 FOLLOWED
063179,000137:                                                                                          	# BY 15 ZEROES.  THIS WILL ELIMINATE EXTRANEOUS BITS FROM INLINK WHICH MAY HAVE BEEN LEFT OVER FROM THE ORIGINAL
063180,000138:                                                                                          	# FAILURE)
063181,000139: 
063182,000140:                                                                                          	# UPLINK ACTIVITY IS ALSO ALLOWED (UNLOCKED) DURING FRESH START WHEN FRESH START SETS BIT4 OF FLAGWRD7 = 0.
063183,000141: 
063184,000142: 
(End of include-file KEYRUPT,_UPRUPT.agc, resuming MAIN.agc)

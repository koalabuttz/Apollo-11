053147,000396: 01,3152           03206                           TC       EJ1                           	#
053148,000397: 01,3153           67610        -CCSPR             -CCS     PRIORITY                      	#
053149,000398: 01,3154           13155                           TCF      +1                            	#
053150,000399: 
053151,000400: 01,3155           10247                           CCS      PRIORITY   +48D               	#
053152,000401: 01,3156           03206                           TC       EJ1                           	#
053153,000402: 01,3157           05747                           TC       CCSHOLE                       	#
053154,000403: 01,3160           13161                           TCF      +1                            	#
053155,000404: 
053156,000405: 01,3161           10263                           CCS      PRIORITY   +60D               	#
053157,000406: 01,3162           03206                           TC       EJ1                           	#
053158,000407: 01,3163           05747                           TC       CCSHOLE                       	#
053159,000408: 01,3164           13165                           TCF      +1                            	#
053160,000409: 
053161,000410: 01,3165           10277                           CCS      PRIORITY   +72D               	#
053162,000411: 01,3166           03206                           TC       EJ1                           	#
053163,000412: 01,3167           05747                           TC       CCSHOLE                       	#
053164,000413: 01,3170           13171                           TCF      +1                            	#
053165,000414: 
053166,000415:                                                                                          	# Page 1219
053167,000416:                                                                                          	# EVALUATE THE RESULTS OF THE SCAN.
053168,000417: 
053169,000418: 01,3171           10131                           CCS      BUF        +1                 	# SEE IF THERE ARE ANY ACTIVE JOBS WAITING
053170,000419: 01,3172           05747                           TC       CCSHOLE                       	#
053171,000420: 01,3173           05747                           TC       CCSHOLE                       	#
053172,000421: 
053173,000422: 01,3174           13176                           TCF      +2                            	#
053174,000423: 01,3175           13223                           TCF      DUMMYJOB                      	#
053175,000424: 01,3176           10130                           CCS      BUF                           	# BUF IS ZERO IF THIS IS A PRIOCHNG AND
053176,000425: 01,3177           13201                           TCF      +2                            	# CHANGED PRIORITY IS STILL HIGHEST.
053177,000426: 01,3200           13005                           TCF      ENDPRCHG   -1                 	#
053178,000427: 
053179,000428: 01,3201           50000                           INDEX    A                             	# OTHERWISE, SET NEWJOB TO THE RELATIVE
053180,000429: 01,3202           27777                           CAF      0          -1                 	# ADDRESS OF THE NEW JOB'S CORE SET.
053181,000430: 01,3203           63153                           AD       -CCSPR                        	#
053182,000431: 01,3204           54067                           TS       NEWJOB                        	#
053183,000432: 01,3205           12725                           TCF      CHANJOB    -2                 	#
053184,000433: 
053185,000434: 01,3206           54132        EJ1                TS       BUF        +2                 	#
053186,000435: 01,3207           60131                           AD       BUF        +1                 	# - OLD HIGH PRIORITY.
053187,000436: 01,3210           10000                           CCS      A                             	#
053188,000437: 01,3211           40132                           CS       BUF        +2                 	#
053189,000438: 01,3212           13216                           TCF      EJ2                           	# NEW HIGH PRIORITY.
053190,000439: 01,3213           13214                           NOOP                                   	#
053191,000440: 01,3214           50002                           INDEX    Q                             	#
053192,000441: 01,3215           00002                           TC       2                             	# PROCEED WITH SEARCH.
053193,000442: 
053194,000443: 01,3216           54131        EJ2                TS       BUF        +1                 	#
053195,000444: 01,3217           00006                           EXTEND                                 	#
053196,000445: 01,3220           22130                           QXCH     BUF                           	# FOR LOCATING CCS PRIORITY + X INSTR.
053197,000446: 01,3221           50130                           INDEX    BUF                           	#
053198,000447: 01,3222           00002                           TC       2                             	#
053199,000448: 
053200,000449:                                                                                          	# Page 1220
053201,000450:                                                                                          	# IDLING AND COMPUTER ACTIVITY (GREEN) LIGHT MAINTENANCE. THE IDLING ROUTINE IS NOT A JOB IN ITSELF,
053202,000451:                                                                                          	# BUT RATHER A SUBROUTINE OF THE EXECUTIVE.
053203,000452: 
053204,000453: 01,3223     1361                                  EBANK=   SELFRET                       	# SELF-CHECK STORAGE IN EBANK.
053205,000454: 
053206,000455: 01,3223           45021        DUMMYJOB           CS       ZERO                          	# SET NEWJOB TO -0 FOR IDLING.
053207,000456: 01,3224           54067                           TS       NEWJOB                        	#
053208,000457: 01,3225           00003                           RELINT                                 	#
053209,000458: 01,3226           45016                           CS       TWO                           	# TURN OFF THE ACTIVITY LIGHT.
053210,000459: 01,3227           00006                           EXTEND                                 	#
053211,000460: 01,3230           03011                           WAND     DSALMOUT                      	#
053212,000461: 01,3231           10067        ADVAN              CCS      NEWJOB                        	# IS A NEWJOB ACTIVE ?
053213,000462: 01,3232           13032                           TCF      NUCHANG2                      	# YES... ONE REQUIRING A CHANGE JOB.
053214,000463: 01,3233           35016                           CAF      TWO                           	# NEW JOB ALREADY IN POSITION FOR
053215,000464: 01,3234           13242                           TCF      NUDIRECT                      	# EXECUTION.
053216,000465: 
053217,000466: 01,3235           31361                           CA       SELFRET                       	#
053218,000467: 01,3236           54001                           TS       L                             	# PUT RETURN ADDRESS IN L.
053219,000468: 01,3237           33241                           CAF      SELFBANK                      	#
053220,000469: 01,3240           15230                           TCF      SUPDXCHZ   +          1       	# AND DISPATCH JOB.
053221,000470: 
053222,000471: 01,3241     1361                                  EBANK=   SELFRET                       	#
053223,000472: 01,3241           66102        SELFBANK           BBCON    SELFCHK                       	#
053224,000473: 
053225,000474: 01,3242           00006        NUDIRECT           EXTEND                                 	# TURN THE GREEN LIGHT BACK ON.
053226,000475: 01,3243           05011                           WOR      DSALMOUT                      	#
053227,000476: 01,3244           52165                           DXCH     LOC                           	# JOBS STARTED IN THIS FASHION MUST BE
053228,000477: 01,3245           15227                           TCF      SUPDXCHZ                      	#
053229,000478: 
053230,000479:    5227                                           BLOCK    2                             	# IN FIXED-FIXED SO OTHERS MAY USE.
053231,000480: 
053232,000481:    5227                                           COUNT    02/EXEC                       	#
053233,000482: 
053234,000483:                                                                                          	# SUPDXCHZ - ROUTINE TO TRANSFER TO SUPERBANK.
053235,000484:                                                                                          	# CALLING SEQUENCE
053236,000485:                                                                                          	#               TCF     SUPDXCHZ        # WITH 2CADR OF DESIRED LOCATION IN A + L.
053237,000486: 
053238,000487:    5227           56001        SUPDXCHZ           XCH      L                             	# BASIC.
053239,000488:    5230           00006                 +1        EXTEND                                 	#
053240,000489:    5231           01007                           WRITE    SUPERBNK                      	#
053241,000490:    5232           54006                           TS       BBANK                         	#
053242,000491:    5233           00001                           TC       L                             	#
053243,000492: 
053244,000493:    5234           77677        NEG100             OCT      77677                         	#
053245,000494: 
053246,000495: 
053247,000496: 
(End of include-file EXECUTIVE.agc, resuming MAIN.agc)
053247,000144: 
053248,000145: $WAITLIST.agc					        # pp. 1221-1235
053249,000001:                                                                                          	# Copyright:    Public domain.
053250,000002:                                                                                          	# Filename:     WAITLIST.agc
053251,000003:                                                                                          	# Purpose:      Part of the source code for Colossus 2A, AKA Comanche 055.
053252,000004:                                                                                          	#               It is part of the source code for the Command Module's (CM)
053253,000005:                                                                                          	#               Apollo Guidance Computer (AGC), for Apollo 11.
053254,000006:                                                                                          	# Assembler:    yaYUL
053255,000007:                                                                                          	# Contact:      Ron Burkey <info@sandroid.org>.
053256,000008:                                                                                          	# Website:      www.ibiblio.org/apollo.
053257,000009:                                                                                          	# Pages:        1221-1235
053258,000010:                                                                                          	# Mod history:  2009-05-14 RSB  Adapted from the Colossus249/ file of the
053259,000011:                                                                                          	#                               same name, using Comanche055 page images.
053260,000012: 
053261,000013:                                                                                          	# This source code has been transcribed or otherwise adapted from digitized
053262,000014:                                                                                          	# images of a hardcopy from the MIT Museum.  The digitization was performed
053263,000015:                                                                                          	# by Paul Fjeld, and arranged for by Deborah Douglas of the Museum.  Many
053264,000016:                                                                                          	# thanks to both.  The images (with suitable reduction in storage size and
053265,000017:                                                                                          	# consequent reduction in image quality as well) are available online at
053266,000018:                                                                                          	# www.ibiblio.org/apollo.  If for some reason you find that the images are
053267,000019:                                                                                          	# illegible, contact me at info@sandroid.org about getting access to the
053268,000020:                                                                                          	# (much) higher-quality images which Paul actually created.
053269,000021: 
053270,000022:                                                                                          	# Notations on the hardcopy document read, in part:
053271,000023: 
053272,000024:                                                                                          	#       Assemble revision 055 of AGC program Comanche by NASA
053273,000025:                                                                                          	#       2021113-051.  10:28 APR. 1, 1969
053274,000026: 
053275,000027:                                                                                          	#       This AGC program shall also be referred to as
053276,000028:                                                                                          	#                       Colossus 2A
053277,000029: 
053278,000030:                                                                                          	# Page 1221
053279,000031:                                                                                          	# PROGRAM DESCRIPTION                                           DATE - 10 OCTOBER 1966
053280,000032:                                                                                          	# MOD NO - 2                                                    LOG SECTION - WAITLIST
053281,000033:                                                                                          	# MOD BY - MILLER       (DTMAX INCREASED TO 162.5 SEC)          ASSEMBLY SUNBURST REV 5
053282,000034:                                                                                          	# MOD 3 BY KERNAN       (INHINT INSERTED AT WAITLIST) 2/28/68 SKIPPER REV 4
053283,000035:                                                                                          	# MOD 4BY KERNAN        (TWIDDLE IN 54) 3/28/68 SKIPPER REV 13.
053284,000036: 
053285,000037:                                                                                          	# FUNCTIONAL DESCRIPTION-
053286,000038:                                                                                          	#       PART OF A SECTION OF PROGRAMS,-WAITLIST, TASKOVER, T3RUPT, USED TO CALL A PROGRAM, (CALLED A TASK),
053287,000039:                                                                                          	#       WHICH IS TO BEGIN IN C(A) CENTISECONDS.  WAITLIST UPDATES TIME3, LST1 AND LST2. THE MEANING OF THESE LISTS
053288,000040:                                                                                          	#       FOLLOW.
053289,000041: 
053290,000042:                                                                                          	#               C(TIME3) = 16384 -(T1-T) CENTISECONDS, (T=PRESENT TIME, T1-TIME FOR TASK1)
053291,000043: 
053292,000044:                                                                                          	#                       C(LST1)         =       -(T2-T1)+1
053293,000045:                                                                                          	#                       C(LST1 +1)      =       -(T3-T2)+1
053294,000046:                                                                                          	#                       C(LST1 +2)      =       -(T4-T3)+1
053295,000047:                                                                                          	#                                      ...
053296,000048:                                                                                          	#                       C(LST1 +6)      =       -(T8-T7)+1
053297,000049:                                                                                          	#                       C(LST1 +7)      =       -(T9-T8)+1
053298,000050: 
053299,000051:                                                                                          	#                       C(LST2)         =       2CADR OF TASK1
053300,000052:                                                                                          	#                       C(LST2 +2)      =       2CADR OF TASK2
053301,000053:                                                                                          	#                                      ...
053302,000054:                                                                                          	#                       C(LST2 +14)     =       2CADR OF TASK8
053303,000055:                                                                                          	#                       C(LST2 +16)     =       2CADR OF TASK9
053304,000056: 
053305,000057:                                                                                          	# WARNINGS-
053306,000058:                                                                                          	# --------
053307,000059:                                                                                          	#       1)      1 <= C(A) <= 16250D (1 CENTISECOND TO 162.5 SEC)
053308,000060:                                                                                          	#       2)      9 TASKS MAXIMUM
053309,000061:                                                                                          	#       3)      TASKS CALLED UNDER INTERRUPT INHIBITED
053310,000062:                                                                                          	#       4)      TASKS END BY TC TASKOVER
053311,000063: 
053312,000064:                                                                                          	# CALLING SEQUENCE-
053313,000065: 
053314,000066:                                                                                          	#       L-1     CA      DELTAT  (TIME IN CENTISECONDS TO TASK START)
053315,000067:                                                                                          	#       L       TC      WAITLIST
053316,000068:                                                                                          	#       L+1     2CADR   DESIRED TASK
053317,000069:                                                                                          	#       L+2     (MINOR OF 2CADR)
053318,000070:                                                                                          	#       L+3     RELINT          (RETURNS HERE)
053319,000071: 
053320,000072:                                                                                          	# TWIDDLE-
053321,000073:                                                                                          	# -------
053322,000074:                                                                                          	#       TWIDDLE IS FOR USE WHEN THE TASK BEING SET UP IS IN THE SAME EBANK AND FBANK AS THE USER.  IN
053323,000075:                                                                                          	#       SUCH CASES, IT IMPROVES UPON WAITLIST BY ELIMINATING THE NEED FOR THE BBCON HALF OF THE 2CADR,
053324,000076:                                                                                          	# Page 1222
053325,000077:                                                                                          	#       SAVING A WORD.  TWIDDLE IS LIKE WAITLIST IN EVERY RESPECT EXCEPT CALLING SEQUENCE, TO WIT-
053326,000078: 
053327,000079:                                                                                          	#               L-1     CA      DELTAT
053328,000080:                                                                                          	#               L       TC      TWIDDLE
053329,000081:                                                                                          	#               L+1     ADRES   DESIRED TASK
053330,000082:                                                                                          	#               L+2     RELINT          (RETURNS HERE)
053331,000083: 
053332,000084:                                                                                          	# NORMAL EXIT MODES-
053333,000085: 
053334,000086:                                                                                          	#       AT L+3 OF CALLING SEQUENCE
053335,000087: 
053336,000088:                                                                                          	# ALARM OR ABORT EXIT MODES-
053337,000089: 
053338,000090:                                                                                          	#       TC      ABORT
053339,000091:                                                                                          	#       OCT     1203    (WAITLIST OVERFLOW - TOO MANY TASKS)
053340,000092: 
053341,000093:                                                                                          	# ERASABLE INITIALIZATION REQUIRED-
053342,000094: 
053343,000095:                                                                                          	#       ACCOMPLISHED BY FRESH START,--  LST2,..., LST2 +16 =ENDTASK
053344,000096:                                                                                          	#                                       LST1,..., LST1 +7  =NEG1/2
053345,000097: 
053346,000098:                                                                                          	# OUTPUT--
053347,000099: 
053348,000100:                                                                                          	#       LST1 AND LST2 UPDATED WITH NEW TASK AND ASSOCIATED TIME.
053349,000101:                                                                                          	# DEBRIS-
053350,000102:                                                                                          	#       CENTRALS- A,Q,L
053351,000103:                                                                                          	#       OTHER   - WAITEXIT, WAITADR, WAITTEMP, WAITBANK
053352,000104:                                                                                          	# DETAILED ANALYSIS OF TIMING-
053353,000105: 
053354,000106:                                                                                          	#       CONTROL WILL NOT BE RETURNED TO THE SPECIFIED ADDRESS (2CADR) IN EXACTLY DELTA T CENTISECONDS.
053355,000107:                                                                                          	#       THE APPROXIMATE TIME MAY BE CALCULATED AS FOLLOWS
053356,000108: 
053357,000109:                                                                                          	#               LET T0 = THE TIME OF THE TC WAITLIST
053358,000110:                                                                                          	#               LET TS = T0 +147U + COUNTER INCREMENTS (SET UP TIME)
053359,000111:                                                                                          	#               LET X  = TS -(100TS)/100  (VARIANCE FROM COUNTERS)
053360,000112:                                                                                          	#               LET Y  = LENGTH OF TIME OF INHIBIT INTERRUPT AFTER T3RUPT
053361,000113:                                                                                          	#               LET Z  = LENGTH OF TIME TO PROCESS TASKS WHICH ARE DUE THIS T3RUPT BUT DISPATCHED EARLIER.
053362,000114:                                                                                          	#       (Z=0, USUALLY)
053363,000115:                                                                                          	#               LET DELTD = THE ACTUAL TIME TAKEN TO GIVE CONTROL TO 2CADR
053364,000116:                                                                                          	#              THEN DELTD = TS+DELTA T -X +Y +Z +1.05MS* +COUNTERS*
053365,000117:                                                                                          	#       *THE TIME TAKEN BY WAITLIST ITSELF AND THE COUNTER TICKING DURING THIS WAITLIST TIME.
053366,000118: 
053367,000119:                                                                                          	#       IN SHORT, THE ACTUAL TIME TO RETURN CONTROL TO A 2CADR IS AUGMENTED BY THE TIME TO SET UP THE TASK'S
053368,000120:                                                                                          	#       INTERRUPT, ALL COUNTERS TICKING, THE T3RUPT PROCESSING TIME, THE WAITLIST PROCESSING TIME AND THE POSSIBILITY
053369,000121:                                                                                          	#       OF OTHER TASKS INHIBITING THE INTERRUPT.
053370,000122: 
053371,000123:    5235                                           BLOCK    02                            	#
053372,000124:                                                                                          	# Page 1223
053373,000125:    5235  E3,1400                                  EBANK=   LST1                          	# TASK LISTS IN SWITCHED E BANK.
053374,000126: 
053375,000127:    5235                                           COUNT    02/WAIT                       	#
053376,000128: 
053377,000129:    5235           00004        TWIDDLE            INHINT                                 	#
053378,000130:    5236           54001                           TS       L                             	# SAVE DELAY TIME IN L
053379,000131:    5237           34777                           CA       POSMAX                        	#
053380,000132:    5240           26002                           ADS      Q                             	# CREATING OVERFLOW AND Q-1 IN Q
053381,000133:    5241           30006                           CA       BBANK                         	#
053382,000134:    5242           00006                           EXTEND                                 	#
053383,000135:    5243           04007                           ROR      SUPERBNK                      	#
053384,000136:    5244           56001                           XCH      L                             	#
053385,000137: 
053386,000138:    5245           00004        WAITLIST           INHINT                                 	#
053387,000139:    5246           00006                           EXTEND                                 	#
053388,000140:    5247           65261                           BZMF     WATLST0-                      	#
053389,000141:    5250           56002                           XCH      Q                             	# SAVE DELTA T IN Q AND RETURN IN
053390,000142:    5251           54061                           TS       WAITEXIT                      	# WAITEXIT.
053391,000143:    5252           00006                           EXTEND                                 	#
053392,000144:    5253           50061                           INDEX    WAITEXIT                      	# IF TWIDDLING, THE TS SKIPS TO HERE
053393,000145:    5254           30001                           DCA      0                             	# PICK UP 2CADR OF TASK.
053394,000146:    5255           54063                 -1        TS       WAITADR                       	# BBCON WILL REMAIN IN L
053395,000147:    5256           35266        DLY2               CAF      WAITBB                        	# ENTRY FROM FIXDELAY AND VARDELAY.
053396,000148:    5257           56006                           XCH      BBANK                         	#
053397,000149:    5260           13246                           TCF      WAIT2                         	#
053398,000150: 
053399,000151:    5261           05721        WATLST0-           TC       POODOO                        	#
053400,000152:    5262           01204                           OCT      1204                          	# WAITLIST CALL WITH ZERO OR NEG DT
053401,000153: 
053402,000154:                                                                                          	# RETURN TO CALLER AFTER TASK INSERTION:
053403,000155: 
053404,000156:    5263           52062        LVWTLIST           DXCH     WAITEXIT                      	#
053405,000157:    5264           65016                           AD       TWO                           	#
053406,000158:    5265           52006                           DTCB                                   	#
053407,000159: 
053408,000160:    5266  E3,1400                                  EBANK=   LST1                          	#
053409,000161:    5266           02063        WAITBB             BBCON    WAIT2                         	#
053410,000162: 
053411,000163:                                                                                          	# RETURN TO CALLER +2 AFTER WAITING DT SPECIFIED AT CALLER +1.
053412,000164: 
053413,000165:    5267           50002        FIXDELAY           INDEX    Q                             	# BOTH ROUTINES MUST BE CALLED UNDER
053414,000166:    5270           30000                           CAF      0                             	# WAITLIST CONTROL AND TERMINATE THE TASK
053415,000167:    5271           24002                           INCR     Q                             	# IN WHICH THEY WERE CALLED.
053416,000168: 
053417,000169:                                                                                          	# RETURN TO CALLER +1 AFTER WAITING THE DT AS ARRIVING IN A.
053418,000170: 
053419,000171:    5272           56002        VARDELAY           XCH      Q                             	# DT TO Q.  TASK ADRES TO WAITADR.
053420,000172:    5273           54063                           TS       WAITADR                       	#
053421,000173:    5274           30006                           CA       BBANK                         	# BBANK IS SAVED DURING DELAY.
053422,000174:    5275           00006                           EXTEND                                 	#
053423,000175:                                                                                          	# Page 1224
053424,000176:    5276           04007                           ROR      SUPERBNK                      	# ADD SBANK TO BBCON.
053425,000177:    5277           54001                           TS       L                             	#
053426,000178:    5300           35303                           CAF      DELAYEX                       	#
053427,000179:    5301           54061                           TS       WAITEXIT                      	# GO TO TASKOVER AFTER TASK ENTRY.
053428,000180:    5302           15256                           TCF      DLY2                          	#
053429,000181: 
053430,000182:    5303           15322        DELAYEX            TCF      TASKOVER   -2                 	# RETURNS TO TASKOVER
053431,000183: 
053432,000184:                                                                                          	# Page 1225
053433,000185:                                                                                          	# ENDTASK MUST ENTERED IN FIXED-FIXED SO IT IS DISTINGUISHABLE BY ITS ADRES ALONE.
053434,000186: 
053435,000187:    5304  E3,1400                                  EBANK=   LST1                          	#
053436,000188:    5304           72471 73714  ENDTASK            -2CADR   SVCT3                         	#
053437,000189: 
053438,000190: 
053439,000191:    5306           10076        SVCT3              CCS      FLAGWRD2                      	# DRIFT FLAG
053440,000192:    5307           15324                           TCF      TASKOVER                      	#
053441,000193:    5310           15324                           TCF      TASKOVER                      	#
053442,000194:    5311           15312                           TCF      +1                            	#
053443,000195: 
053444,000196:    5312           11322                           CCS      IMUCADR                       	# DON'T DO NBDONLY IF SOMEONE ELSE IS IN
053445,000197:    5313           17717                           TCF      SVCT3X                        	#
053446,000198:    5314           15317                           TCF      +3                            	#
053447,000199:    5315           17717                           TCF      SVCT3X                        	#
053448,000200:    5316           17717                           TCF      SVCT3X                        	#
053449,000201:    5317           37672                 +3        CAF      PRIO35                        	# COMPENSATE FOR NBD COEFFICIENTS ONLY.
053450,000202:    5320           05134                           TC       NOVAC                         	#       ENABLE EVERY 81.93 SECONDS
053451,000203:    5321  E3,1460                                  EBANK=   NBDX                          	#
053452,000204:    5321           03542 14063                     2CADR    NBDONLY                       	#
053453,000205: 
053454,000206:    5323           15324                           TCF      TASKOVER                      	#
053455,000207: 
053456,000208:    6000                                           SETLOC   FFTAG6                        	#
053457,000209:    6000                                           BANK                                   	#
053458,000210: 
053459,000211:    7717           05267        SVCT3X             TC       FIXDELAY                      	# DELAY MAX OF 2 TIMES FOR IMU ZERO
053460,000212:    7720           00764                           DEC      500        B-14               	#
053461,000213:    7721           05306                           TC       SVCT3                         	# CHECK DRIFT FLAG AGAIN
053462,000214: 
053463,000215:                                                                                          	# Page 1226
053464,000216:                                                                                          	# BEGIN TASK INSERTION.
053465,000217: 
053466,000218: 01,3246                                           BANK     01                            	#
053467,000219: 01,3246                                           COUNT    01/WAIT                       	#
053468,000220: 
053469,000221: 01,3246           54062        WAIT2              TS       WAITBANK                      	# BBANK OF CALLING PROGRAM.
053470,000222: 01,3247           40026                           CS       TIME3                         	#
053471,000223: 01,3250           65010                           AD       BIT8                          	# BIT 8 = OCT 200
053472,000224: 01,3251           10000                           CCS      A                             	# TEST 200 - C(TIME3).  IF POSITIVE,
053473,000225:                                                                                          	# IT MEANS THAT TIME3 OVERFLOW HAS OCCURRED PRIOR TO CS TIME3 AND THAT
053474,000226:                                                                                          	# C(TIME3) = T - T1, INSTEAD OF 1.0 - (T1 - T).  THE FOLLOWING FOUR
053475,000227:                                                                                          	# ORDERS SET C(A) = TD - T1 + 1 IN EITHER CASE.
053476,000228: 
053477,000229: 01,3252           66056                           AD       OCT40001                      	# OVERFLOW HAS OCCURRED.  SET C(A) =
053478,000230: 01,3253           40000                           CS       A                             	# T - T1 + 1.0 - 201
053479,000231: 
053480,000232:                                                                                          	# NORMAL CASE (C(A) NNZ) YIELDS SAME C(A):  -( -(1.0-(T1-T)) + 200) - 1
053481,000233: 
053482,000234: 01,3254           63402                           AD       OCT40201                      	#
053483,000235: 01,3255           60002                           AD       Q                             	# RESULT = TD - T1 + 1.
053484,000236: 
053485,000237: 01,3256           10000                           CCS      A                             	# TEST TD - T1 + 1
053486,000238: 
053487,000239: 01,3257           61400                           AD       LST1                          	# IF TD - T1 POS, GO TO WTLST5 WITH
053488,000240: 01,3260           13322                           TCF      WTLST5                        	# C(A) = (TD - T1) + C(LST1) = TD-T2+1
053489,000241: 
053490,000242: 01,3261           13262                           NOOP                                   	#
053491,000243: 01,3262           40002                           CS       Q                             	#
053492,000244: 
053493,000245:                                                                                          	# NOTE THAT THIS PROGRAM SECTION IS NEVER ENTERED WHEN T-T1 G/E -1,
053494,000246:                                                                                          	# SINCE TD-T1+1 = (TD-T) + (T-T1+1), AND DELTA T = TD-T G/E +1.  (G/E
053495,000247:                                                                                          	# SYMBOL MEANS GREATER THAN OR EQUAL TO).  THUS THERE NEED BE NO CON-
053496,000248:                                                                                          	# CERN OVER A PREVIOUS OR IMMINENT OVERFLOW OF TIME3 HERE.
053497,000249: 
053498,000250: 01,3263           65002                           AD       POS1/2                        	# WHEN TD IS NEXT, FORM QUANTITY
053499,000251: 01,3264           65002                           AD       POS1/2                        	#       1.0 - DELTA T = 1.0 - (TD - T)
053500,000252: 01,3265           56026                           XCH      TIME3                         	#
053501,000253: 01,3266           65001                           AD       NEGMAX                        	#
053502,000254: 01,3267           60002                           AD       Q                             	# 1.0 - DELTAT T NOW COMPLETE.
053503,000255: 01,3270           00006                           EXTEND                                 	# ZERO INDEX Q.
053504,000256: 01,3271           22007                           QXCH     7                             	# (ZQ)
053505,000257: 
053506,000258:                                                                                          	# Page 1227
053507,000259: 01,3272           57400        WTLST4             XCH      LST1                          	#

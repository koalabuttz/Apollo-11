061855,000230:    5510           22006                           LXCH     BB                            	#
061856,000231:    5511           22706                           LXCH     GOLOC      +1                 	# AND PRESERVE OUR E AND F BANKS
061857,000232: 
061858,000233:    5512           00006                           EXTEND                                 	# GET THE DELTA TIME
061859,000234:    5513           50000                           NDX      A                             	#
061860,000235:    5514           30001                           DCA      0                             	#
061861,000236:                                                                                          	# Page 1418
061862,000237:    5515           22706                           LXCH     GOLOC      +1                 	# RESTORE OUR E AND F BANK
061863,000238:    5516           22006                           LXCH     BB                            	# RESTORE THE TASKS E AND F BANKS
061864,000239:    5517           22706                           LXCH     GOLOC      +1                 	# AND PRESERVE OUR L
061865,000240: 
061866,000241:    5520           13701                           TCF      ITSLGCL2                      	# NOW LET:S PROCESS THIS LONGCALL
061867,000242: 

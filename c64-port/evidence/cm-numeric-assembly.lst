005006,003371: E7,1425  E7,1414               RTARG              EQUALS   TIG        +2                 	# I(6)IN DESIRED VEHICHE RADIUS VECTOR
005007,003372: E7,1425  E7,1422               DELLT4             EQUALS   RTARG      +6                 	# I(2)IN TIME DIFFERENCE FOR INITVEL
005008,003373: E7,1425  E7,1424               ECSTEER            EQUALS   DELLT4     +2                 	# I(1)PL FOR P40 S
005009,003374: E7,1425  E7,1404               DELVLVC            =        DELVSLV                       	#

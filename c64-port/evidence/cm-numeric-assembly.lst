001144,000998:                                                                                          	# CHECKLIST CODES FOR 504
001145,000999: 
001146,001000:                                                                                          	# PLEASE REPORT ANY DEFICIENCIES IN THIS LIST TO JOHN SUTHERLAND
001147,001001: 
001148,001002:                                                                                          	# *9            *17             *26  COLUMN
001149,001003: 
001150,001004:                                                                                          	# R1 CODE          ACTION TO BE EFFECTED
001151,001005: 
001152,001006:                                                                                          	# 00014         KEY IN          FINE ALIGNMENT OPTION
001153,001007:                                                                                          	# 00015         PERFORM         CELESTIAL BODY ACQUISITION
001154,001008:                                                                                          	# 00016         KEY IN          TERMINATE MARK SEQUENCE
001155,001009:                                                                                          	# 00041         SWITCH          CM/SM SEPARATION TO UP
001156,001010:                                                                                          	# 00062         SWITCH          AGC POWER DOWN
001157,001011:                                                                                          	# 00202         PERFORM         GNCS AUTOMATIC MANEUVER
001158,001012:                                                                                          	# 00203         SWITCH          TO CMC-AUTO
001159,001013:                                                                                          	# 00204         PERFORM         SPS GIMBAL TRIM
001160,001014:                                                                                          	# 00403         SWITCH          OPTICS TO MANUAL OR ZERO
001161,001015: 
001162,001016:                                                                                          	#               SWITCH DENOTES CHANGE POSITION OF A CONSOLE SWITCH
001163,001017:                                                                                          	#               PERFORM DENOTES START OR END OF A TASK
001164,001018:                                                                                          	#               KEY IN DENOTES KEY IN OF DATA THRU THE DSKY
001165,001019: 
001167,001021: 
001168,001022:                                                                                          	# OPTION CODES FOR 504
001169,001023: 
001170,001024:                                                                                          	# PLEASE REPORT ANY DEFICIENCIES IN THIS LIST TO JOHN SUTHERLAND
001171,001025: 
001172,001026:                                                                                          	# THE SPECIFIED OPTION CODES WILL BE FLASHED IN COMPONENT R1 IN 
001173,001027:                                                                                          	# CONJUNCTION WITH VERB04NOUN06 TO REQUEST THE ASTRONAUT TO LOAD INTO
001174,001028:                                                                                          	# COMPONENT R2 THE OPTION HE DESIRES.
001175,001029: 
001176,001030:                                                                                          	# *9            *17                                     *52                             *11             *25  COLUMN
001177,001031: 
001178,001032:                                                                                          	# OPTION        
001179,001033:                                                                                          	# CODE          PURPOSE                                 INPUT FOR COMPONENT 2           PROGRAM(S)      APPLICABILITY
001180,001034: 
001181,001035:                                                                                          	# 00001         SPECIFY IMU ORIENTATION                 1=PREF 2=NOM 3=REFSMMAT         P50'S           ALL
001182,001036:                                                                                          	# 00002         SPECIFY VEHICLE                         1=THIS 2=OTHER                  P21,R30         ALL
001183,001037:                                                                                          	# 00003         SPECIFY TRACKING ATTITUDE               1=PREFERRED 2=OTHER             R63             ALL
001184,001038:                                                                                          	# 00004         SPECIFY RADAR                           1=RR 2=LR                       R04             SUNDANCE + LUMINARY
001185,001039:                                                                                          	# 00005         SPECIFY SOR PHASE                       1=FIRST 2=SECOND                P38             COLOSSUS + LUMINARY
001186,001040:                                                                                          	# 00006         SPECIFY RR COARSE ALIGN OPTION          1=LOCKON 2=CONTINUOUS DESIG.    V41N72          SUNDANCE + LUMINARY
001187,001041:                                                                                          	# 00007         SPECIFY PROPULSION SYSTEM               1=SPS 2=RCS                     P37             COLOSSUS
001188,001042:                                                                                          	# 00010         SPECIFY ALIGNMENT MODE                  0=ANY TIME 1=REFSMMAT +G        P57             LUMINARY        
001189,001043:                                                                                          	#                                                       2=TWO BODIES 3=ONE BODY + G
001190,001044:                                                                                          	# 00011         SPECIFY SEPARATION MONITOR PHASE        1=DELTAV 2=STATE VECTOR UPDATE  P46             LUMINARY
001191,001045:                                                                                          	# 00012         SPECIFY CSM ORBIT OPTION                1=NO ORBIT CHANGE 2=CHANGE      P22             LUMINARY
001192,001046:                                                                                          	#                                                       ORBIT TO PASS OVER LM
001193,001047: 
(End of include-file ASSEMBLY_AND_OPERATION_INFORMATION.agc, resuming MAIN.agc)

035671,000351:                                                                                          	# PROGRAM-      P64
035672,000352:                                                                                          	# MOD NO.-      1       SEPT. 19, 1967
035673,000353:                                                                                          	# MOD BY-       R. HIRSCHKOP
035674,000354:                                                                                          	# MOD NO: 2     MOD BY: RR BAIRNSFATHER         DATE: 8 MAY 68          REVISED COMMENTS FOR COLOSSUS
035675,000355:                                                                                          	# MOD NO: 3     MOD BY: RR BAIRNSFATHER         DATE: 1 MAR '69  N74
035676,000356:                                                                                          	# FUNCTION-     1.  TO START ENTRY GUIDANCE AT .05G SELECTING ROLL ATTITUDE, CONSTANT DRAG LEVEL, AND
035677,000357:                                                                                          	#                   DRAG THRESHOLD, KA, WHICH ARE KEYED TO THE .05G POINT.
035678,000358:                                                                                          	#               2.  SELECT FINAL PHASE P67 IF V < 27000 FPS WHEN .2G OCCURS.
035679,000359:                                                                                          	#               3.  ITERATE FOR UP-CONTROL SOLUTION P65 IF V > 27000 FPS AND IF ALTITUDE RATE AND DRAG
035680,000360:                                                                                          	#                   LEVEL CONDITIONS ARE SATISFIED.  ENTER P65 WHEN CONSTANT DRAG CONTROLLER HAS BROUGHT RANGE
035681,000361:                                                                                          	#                   AS PREDICTED TO WITHIN 25 NM OF DESIRED RANGE.
035682,000362:                                                                                          	#               4.  SELECT FINAL PHASE  P67  IF NO UP-CONTROL SOLUTION EXISTS WITH VL > 18000 FPS.
035683,000363:                                                                                          	# CALLING SEQUENCE-  BY RTB FROM REENTRY CONTROL
035684,000364:                                                                                          	# EXIT-         BACK TO REENTRY CONTROL
035685,000365:                                                                                          	# SUBROUTINE CALLS-  NEWMODEX
035686,000366: 
035687,000367: 25,2000                                           BANK     25                            	#
035688,000368: 26,2000                                           SETLOC   P60S1                         	#
035689,000369: 26,2000                                           BANK                                   	#
035690,000370: 
035691,000371:                                                                                          	# THIS DISPLAY IS CALLED EACH PASS THROUGH STEERING.  RESTART PROTECTION IS VIA STEERING.
035692,000372: 
035693,000373: 26,2433                                           COUNT*   $$/P64                        	#
035694,000374: 
035695,000375: 26,2433           05354        P64                TC       NEWMODEX                      	# ENTER VIA RTB WHEN .05G IS EXCEEDED.
035696,000376: 26,2434           00100                           MM       64         B-14               	#
035697,000377: 26,2435           32440                           CA       V06N74                        	# ROLLC         VI              D
035698,000378:                                                                                          	# XXX.XX DEG    XXXXX. FPS      XXX.XX G
035699,000379: 26,2436           55263                           TS       ENTRYVN                       	# DISPLAY VIA OVERNOUT.
035700,000380: 
035701,000381: 26,2437           06030                           TC       DANZIG                        	# ... AND CONTINUE IN INITROLL ...
035702,000382: 
035703,000383: 26,2440           01512        V06N74             VN       0674                          	#
035704,000384: 
035706,000386:                                                                                          	# PROGRAM:      P65
035707,000387:                                                                                          	# MOD NO:  0    MOD BY:  RR BAIRNSFATHER        DATE:  17 JAN 68        COLOSSUS GSOP ADDITION.
035708,000388:                                                                                          	# FUNCTION:     TO CONTINUE ENTRY GUIDANCE, USING THE UP-CONTROL PHASE TO STEER TO A CONTROLLED EXIT
035709,000389:                                                                                          	#               CONDITION.  THIS PHASE TERMINATES  A) IF D < Q7 FPSS, GO TO P66   ,
035710,000390:                                                                                          	#                                                  B) IF RDOT NEG, AND IF V < VL +500 FPS, GO TO P67.
035711,000391:                                                                                          	# CALLING SEQUENCE:  BY RTB FROM REENTRY CONTROL
035712,000392:                                                                                          	# EXIT:         BACK TO REENTRY CONTROL, OR TO ENDOFJOB.
035713,000393:                                                                                          	# SUBROUTINE CALLS:  NEWMODEX

001600,000406: 
001601,000407:                                                                                          	# THE FOLLOWING ECADRS ARE DEFINED TO FACILITATE EBANK SWITCHING.  THEY ALSO MAKE IT EASIER FOR
001602,000408:                                                                                          	# ERASABLE CONTROL TO REARRANGE ERASABLE MEMORY WITHOUT DISRUPTING THE PROGRAMS WHICH SET EBANKS.
001603,000409:                                                                                          	# PRIOR TO ROPE RELEASE FIXED MEMORY CAN BE SAVED BY SETTING EACH EBXXXX =EBANKX (X=4,5,6,7).  EBANKX OF COURSE
001604,000410:                                                                                          	# WILL BE THE BANK WHERE THE ERASABLES REFERENCED IN EBXXXX WILL BE STORED.
001605,000411: 
001606,000412: 07,2000                                           BANK     7                             	#
001607,000413: 07,2000  E7,1674                                  EBANK=   MARKDOWN                      	#
001608,000414: 07,2000           03674        EBMARKDO           ECADR    MARKDOWN                      	#
001609,000415: 07,2001  E7,1725                                  EBANK=   MRKBUF1                       	#
001610,000416: 07,2001           03725        EBMRKBUF           ECADR    MRKBUF1                       	#
001611,000417: 
001612,000418: 24,2000                                           BANK     24                            	#
001613,000419: 24,2000  E7,1431                                  EBANK=   DVCNTR                        	#
001614,000420: 24,2000           03431        EBDVCNTR           ECADR    DVCNTR                        	#
001615,000421: 24,2001  E7,1672                                  EBANK=   P40TMP                        	#
001616,000422: 24,2001           03672        EBP40TMP           ECADR    P40TMP                        	#
001617,000423: 
001618,000424: 34,2000                                           BANK     34                            	#
001619,000425: 34,2000  E7,1431                                  EBANK=   DVCNTR                        	#
001620,000426: 34,2000           03431        EBDVCNT            ECADR    DVCNTR                        	#
001621,000427: 34,2001  E5,1426                                  EBANK=   QPLACES                       	#
001622,000428: 34,2001           02426        EBQPLACE           ECADR    QPLACES                       	#
001623,000429: 
001624,000430: 37,2000                                           BANK     37                            	#
001625,000431: 37,2000     1231                                  EBANK=   RN1                           	#
001626,000432: 37,2000           01231        EBRN1              ECADR    RN1                           	#

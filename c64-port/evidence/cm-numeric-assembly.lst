011433,001236: 43,3106           05217                           TC       ENDOFJOB                      	#
011434,001237: 
011435,001238: 43,3107           06006        LMTOCM             TC       INTPRET                       	#
011436,001239: 43,3110           77624                           CALL                                   	#
011437,001240: 43,3111           27442                                    INTSTALL                      	#
011438,001241: 43,3112           43014                           SET      BON                           	#
011439,001242: 43,3113           04063                                    MOONTHIS                      	#
011440,001243: 43,3114           04304                                    MOONOTH                       	#

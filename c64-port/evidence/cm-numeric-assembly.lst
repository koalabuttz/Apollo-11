037142,000581: 
037144,000583:                                                                                          	# *****  PIPA READER *****
037145,000584:                                                                                          	# MOD NO. 00 BY D. LICKLY DEC. 9 1966
037146,000585: 
037147,000586:                                                                                          	# FUNCTIONAL DESCRIPTION
037148,000587: 
037149,000588:                                                                                          	# SUBROUTINE TO READ PIPA COUNTERS, TRYING TO BE VERY CAREFUL SO THAT IT WILL BE RESTARTABLE.
037150,000589:                                                                                          	# PIPA READINGS ARE STORED IN THE VECTOR DELV.  THE HIGH ORDER PART OF EACH COMPONENT CONTAINS THE PIPA READING,
037151,000590:                                                                                          	# RESTARTS BEGIN AT REREADAC.
037152,000591: 
037153,000592:                                                                                          	# AT THE END OF THE PIPA READER THE CDUS ARE READ AND STORED AS A
037154,000593:                                                                                          	# VECTOR IN CDUTEMP.  THE HIGH ORDER PART OF EACH COMPONENT CONTAINS
037155,000594:                                                                                          	# THE CDU READING IN 2S COMP IN THE ORDER CDUX,Y,Z.  THE THRUST
037156,000595:                                                                                          	# VECTOR ESTIMATOR IN FINDCDUD REQUIRES THE CDUS BE READ AT PIPTIME.
037157,000596: 
037158,000597:                                                                                          	# CALLING SEQUENCE AND EXIT
037159,000598: 
037160,000599:                                                                                          	#       CALL VIA TC, ISWCALL, ETC.
037161,000600: 
037162,000601:                                                                                          	#       EXIT IS VIA Q.
037163,000602: 
037164,000603:                                                                                          	# INPUT
037165,000604: 
037166,000605:                                                                                          	#       INPUT IS THROUGH THE COUNTERS PIPAX, PIPAY, PIPAZ, AND TIME2.
037167,000606: 
037168,000607:                                                                                          	# OUTPUT
037169,000608: 
037170,000609:                                                                                          	#       HIGH ORDER COMPONENTS OF THE VECTOR DELV CONTAIN THE PIPA READINGS.
037171,000610: 
037172,000611:                                                                                          	#       PIPTIME CONTAINS TIME OF PIPA READING.
037173,000612: 
037174,000613:                                                                                          	# DEBRIS (ERASABLE LOCATIONS DESTROYED BY PROGRAM)
037175,000614: 
037176,000615:                                                                                          	#       LOW ORDER DELV'S ARE ZEROED FOR TM INDICATION.
037177,000616:                                                                                          	#       TEMX    TEMY    TEMZ    PIPAGE
037178,000617: 
037179,000618: 37,3254           00006        PIPASR             EXTEND                                 	#
037180,000619: 37,3255           30025                           DCA      TIME2                         	#
037181,000620: 37,3256           53246                           DXCH     PIPTIME1                      	# CURRENT TIME  POSITIVE VALUE
037182,000621: 37,3257           45021                           CS       ZERO                          	# INITIALIZE THESE AT NEG ZERO.
037183,000622: 37,3260           55224                           TS       TEMX                          	#
037184,000623: 37,3261           55225                           TS       TEMY                          	#
037185,000624: 37,3262           55226                           TS       TEMZ                          	#
037187,000626: 37,3263           35021                           CA       ZERO                          	#
037188,000627: 37,3264           55166                           TS       DELVZ                         	# OTHER DELVS OK INCLUDING LOW ORDER
037189,000628: 37,3265           55164                           TS       DELVY                         	#
037190,000629: 
037191,000630: 37,3266           55163                           TS       DELVX      +1                 	# LOW ORDER DELV'S ARE ZEROED FOR TM:  THUS
037192,000631: 37,3267           55165                           TS       DELVY      +1                 	# IF DNLNK'D LOW ORDER DELVS ARE NZ, THEY
037193,000632: 37,3270           55167                           TS       DELVZ      +1                 	# CONTAIN PROPER COMPENSATION.  IF=0, THEN
037194,000633:                                                                                          	# THE TM VALUES ARE BEFORE COMPENSATION.
037195,000634: 

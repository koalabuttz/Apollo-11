018409,000201:                                                                                          	# ROUTINE FOR TERMINATING AUTOMATIC MANEUVERS
018410,000202: 
018411,000203: 21,2000                                           SETLOC   KALCMON3                      	#
018412,000204: 21,2000                                           BANK                                   	#
018413,000205: 
018414,000206: 21,2000           04537        MANUSTOP           TC       STOPYZ                        	#
018415,000207: 21,2001           04740                           TC       IBNKCALL                      	#

017012,003790: 40,3520           65001                           AD       BIT15                         	# PROG ALARM, AND TRACKER.
017013,003791: 40,3521           55036                           TS       DSPTAB     +11D               	#
017014,003792: 40,3522           45070                           CS       PRIO16                        	# RESET FAIL BITS WHICH GENERATE PROG
017015,003793: 40,3523           71321                           MASK     IMODES33                      	# ALARM SO THAT IF THE FAILURE STILL
017016,003794: 40,3524           65070                           AD       PRIO16                        	# EXISTS, THE ALARM WILL COME BACK.

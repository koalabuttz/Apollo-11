045972,000186:                                                                                          	# JET SWITCHING LOGIC AND CALCULATION OF REQUIRED ROTATION COMMANDS
045973,000187: 
045974,000188:                                                                                          	# DETERMINE THE LOCATION OF THE RATE ERROR AND THE ATTITUDE ERROR RELATIVE TO THE SWITCHING LOGIC IN THE PHASE
045975,000189:                                                                                          	# PLANE.
045976,000190: 
045977,000191:                                                                                          	# COMPUTE THE CHANGE IN RATE CORRESPONDING TO THE ATTITUDE ERROR NECESSARY TO DRIVE THE THE S/C INTO THE
045978,000192:                                                                                          	# APPROPRIATE DEADZONE.
045979,000193: 
045980,000194:                                                                                          	#                                     .
045981,000195:                                                                                          	#   R22                          RATE . ERROR
045982,000196:                                                                                          	#        WL+H                         .
045983,000197:                                                                                          	# *********************************   .                                 ***** SWITCH LINES ENCLOSING DEADZONES
045984,000198:                                                                                          	#   R23  WL                        *  .
045985,000199:                                                                                          	# --------------------------------- * .                                 ----- DESIRED RATE LINES
045986,000200:                                                                                          	#   R23  WL-H       -                *.
045987,000201:                                                                                          	# ****************** -                .                                 R20, R21, R22, ETC REGIONS IN PHASE
045988,000202:                                                                                          	#                   * -               .* R18      R20       R21         PLANE FOF COMPUTING DESIRED RESPONSE
045989,000203:                                                                                          	#                    *                . *
045990,000204:                                                                                          	#                     *-              .  *
045991,000205:                                                                                          	#   R22             R24*-    R23      .   *
045992,000206:                                                                                          	#                       *-            .    *
045993,000207:                                                                                          	#                        *            .     *
045994,000208:                                                                                          	#                         + -ADB      .      * AF              ATTITUDE
045995,000209:                                                                                          	# .........................+--+---------------+--+........................
045996,000210:                                                                                          	#                           AF *      .     +ADB  +             ERROR
045997,000211:                                                                                          	#                               *     .            *
045998,000212:                                                                                          	#                                *    .            -*
045999,000213:                                                                                          	#                                 *   .             -*
046000,000214:                                                                                          	#                                  *  .              -*
046001,000215:                                                                                          	#                                   * .                *
046002,000216:                                                                                          	#                                    *.               - *
046003,000217:                                                                                          	#                                     .                - *****************
046004,000218:                                                                                          	#                                     .*                -
046005,000219:                                                                                          	#                                     . * --------------------------------
046006,000220:                                                                                          	#                                     .  *
046007,000221:                                                                                          	#                                     .   ********************************
046008,000222:                                                                                          	#                                     .

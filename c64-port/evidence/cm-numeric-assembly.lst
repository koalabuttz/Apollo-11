007093,000044: 
007094,000045:                                                                                          	# SPECIAL DOWNLINK OP CODES
007095,000046:                                                                                          	#       OP CODE         ADDRESS(EXAMPLE)          SENDS..               BIT 15          BITS 14-12      BITS 11
007096,000047:                                                                                          	#                                                                                                            -0
007097,000048:                                                                                          	#       ------         ----------               ----------              ------          ----------      -------
007098,000049:                                                                                          	#                                                                                                            --
007099,000050:                                                                                          	#       1DNADR          TIME2                   (2 AGC WDS)             0               0               ECADR
007100,000051:                                                                                          	#       2DNADR          TEPHEM                  (4 AGC WDS)             0               1               ECADR
007101,000052:                                                                                          	#       3DNADR          VGBODY                  (6 AGC WDS)             0               2               ECADR
007102,000053:                                                                                          	#       4DNADR          STATE                   (8 AGC WDS)             0               3               ECADR
007103,000054:                                                                                          	#       5DNADR          UPBUFF                  (10 AGC WDS)            0               4               ECADR
007104,000055:                                                                                          	#       6DNADR          DSPTAB                  (12 AGC WDS)            0               5               ECADR
007105,000056:                                                                                          	#       DNCHAN          30                      CHANNELS                0               7               CHANNEL
007106,000057:                                                                                          	#                                                                                                       ADDRESS
007107,000058:                                                                                          	#       DNPTR           NEXTLIST                POINTS TO NEXT          0               6               ADRES
007108,000059:                                                                                          	#                                               LIST.
007109,000060: 
007110,000061:                                                                                          	# DOWNLIST FORMAT DEFINITIONS AND RULES-
007111,000062:                                                                                          	# 1. END OF A LIST = -XDNADR (X = 1 TO 6), -DNPTR, OR -DNCHAN.
007112,000063:                                                                                          	# 2. SNAPSHOT SUBLIST = LIST WHICH STARTS WITH A -1DNADR.
007113,000064:                                                                                          	# 3. SNAPSHOT SUBLIST CAN ONLY CONTAIN 1DNADRS.
007114,000065:                                                                                          	# 4. TIME2 1DNADR MUST BE LOCATED IN THE CONTROL LIST OF A DOWNLIST.
007115,000066:                                                                                          	# 5. ERASABLE DOWN TELEMETRY WORDS SHOULD BE GROUPED IN SEQUENTIAL
007116,000067:                                                                                          	#    LOCATIONS AS MUCH AS POSSIBLE TO SAVE STORAGE USED BY DOWNLINK LISTS.
007117,000068:                                                                                          	# 6. THE DOWNLINK LISTS (INCLUDING SUBLISTS) ARE ORGANIZED SUCH THAT THE ITEMS LISTED FIRST (IN FRONT OF FBANK) ARE
007118,000069:                                                                                          	#    SENT FIRST.  EXCEPTION--- SNAPSHOT SUBLISTS.  IN THE SNAPSHOT SUBLISTS THE DATA REPRESENTED BY THE FIRST
007119,000070:                                                                                          	#    11 1DNADRS IS PRESERVED (IN ORDER) IN DNTMBUFF AND SENT BY THE NEXT 11 DOWNRUPTS.  THE DATA REPRESENTED BY THE
007120,000071:                                                                                          	#    LIST IS SENT IMMEDIATELY.
007121,000072: 
007122,000073: 05,2000                                           COUNT    05/DLIST                      	#
007123,000074: 05,2000                        ERASZERO           EQUALS   7                             	#
007124,000075: 05,2000  0000007               SPARE              EQUALS   ERASZERO                      	# USE SPARE TO INDICATE AVAILABLE SPACE
007125,000076: 05,2000           77340        LOWIDCOD           OCT      77340                         	# LOW ID CODE
007126,000077: 
007127,000078: 05,2001  05,2107               NOMDNLST           EQUALS   CMCSTADL                      	# FRESH START AND POST P27 DOWNLIST
007128,000079: 05,2001  05,2207               UPDNLIST           EQUALS   CMENTRDL                      	# UPDATE PROGRAM (P27) DOWNLIST
007129,000080: 
007131,000082:                                                                                          	# CSM POWERED FLIGHT DOWNLIST
007132,000083: 
007133,000084:                                                                                          	# --------------------------CONTROL LIST----------------------------------
007134,000085: 
007135,000086: 05,2001                        CMPOWEDL           EQUALS                                 	#
007136,000087: 05,2001           32043                           DNPTR    CMPOWE01                      	# COLLECT SNAPSHOT
007137,000088: 05,2002           24340                           6DNADR   DNTMBUFF                      	# SEND SNAPSHOT
007138,000089: 05,2003           32052                           DNPTR    CMPOWE02                      	# COLLECT SECOND SNAPSHOT
007139,000090: 05,2004           14340                           4DNADR   DNTMBUFF                      	# SEND SNAPSHOT
007140,000091: 05,2005           32057                           DNPTR    CMPOWE03                      	# COMMON DATA
007141,000092: 05,2006           03412                           1DNADR   TIG                           	# TIG,+1

007471,000081: $FRESH_START_AND_RESTART.agc			        # pp. 181-210
007472,000001:                                                                                          	# Copyright:    Public domain.
007473,000002:                                                                                          	# Filename:     FRESH_START_AND_RESTART.agc
007474,000003:                                                                                          	# Purpose:      Part of the source code for Comanche, build 055. It
007475,000004:                                                                                          	#               is part of the source code for the Command Module's
007476,000005:                                                                                          	#               (CM) Apollo Guidance Computer (AGC), Apollo 11.
007477,000006:                                                                                          	# Assembler:    yaYUL
007478,000007:                                                                                          	# Reference:    pp. 181-210
007479,000008:                                                                                          	# Contact:      Ron Burkey <info@sandroid.org>,
007480,000009:                                                                                          	#               Fabrizio Bernardini <fabrizio@spacecraft.it>
007481,000010:                                                                                          	# Website:      http://www.ibiblio.org/apollo.
007482,000011:                                                                                          	# Mod history:  2009-05-16 FB   Transcription Batch 2 Assignment.
007483,000012:                                                                                          	#               2009-05-20 RSB  Removed an extraneous "TC STARTSUB".
007484,000013:                                                                                          	#               2009-05-21 RSB  Changed a "TC BANKCALL" to "TC STOPRATE"
007485,000014:                                                                                          	#                               in INITSUB.
007486,000015: 
007487,000016:                                                                                          	# The contents of the "Comanche055" files, in general, are transcribed
007488,000017:                                                                                          	# from scanned documents.
007489,000018: 
007490,000019:                                                                                          	#       Assemble revision 055 of AGC program Comanche by NASA
007491,000020:                                                                                          	#       2021113-051.  April 1, 1969.
007492,000021: 
007493,000022:                                                                                          	#       This AGC program shall also be referred to as Colossus 2A
007494,000023: 
007495,000024:                                                                                          	#       Prepared by
007496,000025:                                                                                          	#                       Massachusetts Institute of Technology
007497,000026:                                                                                          	#                       75 Cambridge Parkway
007498,000027:                                                                                          	#                       Cambridge, Massachusetts
007499,000028: 
007500,000029:                                                                                          	#       under NASA contract NAS 9-4065.
007501,000030: 
007502,000031:                                                                                          	# Refer directly to the online document mentioned above for further
007503,000032:                                                                                          	# information.  Please report any errors to info@sandroid.org.
007504,000033: 
007505,000034:                                                                                          	# Page 181
007506,000035:                                                                                          	# PROGRAM DESCRIPTION                                           8 APRIL, 1967
007507,000036:                                                                                          	#                                                               SUNDISK REV 120
007508,000037:                                                                                          	# FUNCTIONAL DESCRIPTION
007509,000038: 
007510,000039:                                                                                          	#     SLAP1     MAN INITIATED FRESH START
007511,000040:                                                                                          	#       1. EXECUTE STARTSUB
007512,000041:                                                                                          	#       2. TURN OFF DSKY DISCRETE-LAMPS
007513,000042:                                                                                          	#       3. CLEAR FAIL REGISTERS,SELF-CHECK ERROR COUNTER AND RESTART
007514,000043:                                                                                          	#          COUNTER
007515,000044:                                                                                          	#       4. EXECUTE DOFSTART
007516,000045: 
007517,000046:                                                                                          	#     DOFSTART  MACHINE INITIATED FRESH START
007518,000047: 
007519,000048:                                                                                          	#       1. CLEAR SELF-CHECK REGISTERS, MODE REGISTER AND CDUZ REGISTER
007520,000049:                                                                                          	#       2. CLEAR PHASE TABLE
007521,000050:                                                                                          	#       3. INITIALIZE IMU FLAGS
007522,000051:                                                                                          	#       4. INITIALIZE FLAGWORDS
007523,000052:                                                                                          	#       5. TRANSFER CONTROL TO IDLE LOOP IN DUMMYJOB
007524,000053: 
007525,000054:                                                                                          	#     GOPROG    HARDWARE RESTART
007526,000055: 
007527,000056:                                                                                          	#       0. EXECUTE STARTSUB
007528,000057:                                                                                          	#       1. TRANSFER CONTROL TO DOFSTART IF ANY OF THE FOLLOWING CONDITIONS
007529,000058:                                                                                          	#          EXIST.
007530,000059:                                                                                          	#          A. RESTART OCCURED DURING EXECUTION OF ERASCHK
007531,000060:                                                                                          	#          B. BOTH OSCILLATOR FAIL AND AGC WARNING ARE ON
007532,000061:                                                                                          	#          C. MARK REJECT AND EITHER NAV OR MAIN DSKY ERROR LIGHT RESET
007533,000062:                                                                                          	#             ARE ON.
007534,000063:                                                                                          	#       2. SCHEDULE A T5RUPT PROGRAM FOR THE DAP
007535,000064:                                                                                          	#       3. SET FLAGWRD5 BITS FOR INTWAKE ROUTINE
007536,000065:                                                                                          	#       4. EXTINGUISH ALL DSKY LAMPS, EXCEPT FOR PROGRAM ALARM,GIMBAL LOCK AND
007537,000066:                                                                                          	#          NO ATT
007538,000067:                                                                                          	#       5. INITIALIZE IMU FLAGS
007539,000068:                                                                                          	#       6. IF ENGINE COMMAND IS ON (FLAGWRD5,BIT 7), SET ENGINE ON (CHAN-
007540,000069:                                                                                          	#          NEL 11, BIT 13)
007541,000070:                                                                                          	#       7. TRANSFER CONTROL TO GOPROG3
007542,000071: 
007543,000072:                                                                                          	#     ENEMA     SOFTWARE RESTART        INITIATED BY MAJOR MODE CHANGE
007544,000073: 
007545,000074:                                                                                          	#       1. EXECUTE STARTSB2
007546,000075:                                                                                          	#       2. KILL PROGRAMS THAT WERE INTEGRATING OR WAITING FOR INTEGRATION
007547,000076:                                                                                          	#          ROUTINE
007548,000077:                                                                                          	#       3. TRANSFER CONTROL TO GOPROG3
007549,000078: 
007550,000079:                                                                                          	#     GOPROG3   SUBROUTINE COMMON TO GOPROG AND ENEMA
007551,000080: 
007552,000081:                                                                                          	#       1. TEST PHASE TABLES - IF INCORRECT, DISPLAY ALARM 1107 AND
007553,000082:                                                                                          	#          TRANSFER CONTROL TO DOFSTART
007554,000083:                                                                                          	#       2. DISPLAY MAJOR MODE
007555,000084:                                                                                          	#       3. IF ANY GROUPS WERE ACTIVE UPON RESTART,TRANSFER CONTROL TO THE
007556,000085:                                                                                          	# Page 182
007557,000086:                                                                                          	#          RESTARTS SUBROUTINE TO RESCHEDULE PENDING TASKS, LONGCALLS, AND
007558,000087:                                                                                          	#          JOBS (P20 IS RESTARTED VIA FINDVAC)
007559,000088:                                                                                          	#       4. IF NO GROUPS WERE ACTIVE UPON RESTART, DISPLAY ALARM CODE
007560,000089:                                                                                          	#          1110 (RESTART WITH NO ACTIVE GROUPS).
007561,000090:                                                                                          	#       5. TRANSFER CONTROL TO IDLE LOOP IN DUMMYJOB
007562,000091: 
007563,000092:                                                                                          	#     STARTSUB  SUBROUTINE COMMON TO SLAP1 AND GOPROG
007564,000093: 
007565,000094:                                                                                          	#       1. CLEAR OUTBIT CHANNELS 5 AND 6
007566,000095:                                                                                          	#       2. INITIALIZE TIME5,TIME4,TIME3
007567,000096:                                                                                          	#       3. TRANSFER CONTROL TO STARTSB2
007568,000097: 
007569,000098:                                                                                          	#     STARTSB2  SUBROUTINE COMMON TO STARTSUB AND ENEMA
007570,000099: 
007571,000100:                                                                                          	#       1. INTIALIZE OUTBIT CHANNELS 11,12,13, AND 14
007572,000101:                                                                                          	#       2. REPLACE ALL TASKS ON WAITLIST WITH ENDTASK
007573,000102:                                                                                          	#       3. MAKE ALL EXECUTIVE REGISTERS AVAILABLE
007574,000103:                                                                                          	#       4. MAKE ALL VAC AREAS AVAILABLE
007575,000104:                                                                                          	#       5. CLEAR DSKY REGISTERS
007576,000105:                                                                                          	#       6. ZERO NUMEROUS SWITCHES
007577,000106:                                                                                          	#       7. INITIALIZE OPTICS FLAGS
007578,000107:                                                                                          	#       8. INITIALIZE PIPA AND TELEMETRY FAIL FLAGS
007579,000108:                                                                                          	#       9. INITIALIZE DOWN TELEMETRY
007580,000109: 
007581,000110: 
007582,000111:                                                                                          	# INPUT/OUTPUT INITIALIZATION
007583,000112: 
007584,000113:                                                                                          	#       A. CALLING SEQUENCE
007585,000114: 
007586,000115:                                                                                          	#               SLAP1 - TC      POSTJUMP        OR      VERB 36,ENTER
007587,000116:                                                                                          	#                       CADR    SLAP1
007588,000117: 
007589,000118:                                                                                          	#               ENEMA - TC      POSTJUMP        *** DO NOT CALL ENEMA WITHOUT ***
007590,000119:                                                                                          	#                       CADR    ENEMA           *** CONSULTING POOH PEOPLE   ***
007591,000120: 
007592,000121:                                                                                          	#       B. OUTPUT
007593,000122: 
007594,000123:                                                                                          	#               ERASABLE MEMORY INITIALIZATION
007595,000124: 
007596,000125:                                                                                          	# PROGRAM ANALYSIS
007597,000126: 
007598,000127:                                                                                          	#       A. SUBROUTINES CALLED
007599,000128: 
007600,000129:                                                                                          	#               MR.KLEAN,WAITLIST,DSPMM,ALARM,RESTARTS,FINDVAC
007601,000130: 
007602,000131:                                                                                          	#       B. ALARMS
007603,000132: 
007604,000133:                                                                                          	#               1107 PHASE TABLE ERROR
007605,000134:                                                                                          	#               1110 RESTART WITH NO ACTIVE GROUPS
007606,000135: 
007607,000136:                                                                                          	# Page 183
007608,000137: 10,2203                                           BANK     10                            	#
007609,000138: 05,2000                                           SETLOC   FRANDRES                      	#
007610,000139: 05,2000                                           BANK                                   	#
007611,000140: 
007612,000141: 05,2342  E3,1400                                  EBANK=   LST1                          	#
007613,000142: 
007614,000143: 05,2342                                           COUNT    05/START                      	#
007615,000144: 
007616,000145: 05,2342           00004        SLAP1              INHINT                                 	# FRESH START.  COMES HERE FROM PINBALL.
007617,000146: 05,2343           02776                           TC       STARTSUB                      	# SUBROUTINE DOES MOST OF THE WORK.
007618,000147: 
007619,000148: 05,2344           12351        STARTSW            TCF      SKIPSIM                       	# PATCH....TCF STARTSIM...FOR SIMULATION
007620,000149: 05,2345           35002        STARTSIM           CAF      BIT14                         	#
007621,000150: 05,2346           05147                           TC       FINDVAC                       	#
007622,000151: 05,2347           77777        SIM2CADR           OCT      77777                         	# PATCH 2CADR (AND EBANK DESIGNATION) OF
007623,000152: 05,2350           77777                           OCT      77777                         	# SIMULATION START ADDRESS.
007624,000153: 

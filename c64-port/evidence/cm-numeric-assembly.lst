062681,000718: 07,3537           75012                           MASK     BIT6                          	# IT IS FOUND THAT THE IMU IS BEING CAGED,
062682,000719: 07,3540           10000                           CCS      A                             	# SET IMUCADR TO -0 TO INDICATE OPERATION
062683,000720: 07,3541           00002                           TC       Q                             	# COMPLETE BUT FAILED.  RETURN IMMEDIATELY
062684,000721: 07,3542           45021                           CS       ZERO                          	# TO SWRETURN.

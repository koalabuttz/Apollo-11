026283,001366: 27,2613           77616                           RVQ                                    	#
026285,001368:                                                                                          	# CRS61.1       4/10/68
026286,001369: 
026287,001370:                                                                                          	# TO COMPUTE THE PREFERRED TRACKING ATTITUDE OF THE CSM WHICH ENABLES
026288,001371:                                                                                          	# OPTICS TRACKING OF THE LM AND LM TRACKING OF THE CSM RADAR TRANSPONDER
026289,001372:                                                                                          	# AND TO COMPUTE THE &X-AXIS TRACKING ATTITUDE OF THE CSM WHICH ENABLES
026290,001373:                                                                                          	# COAS TRACKING OF THE LM.
026291,001374: 
026292,001375:                                                                                          	# TO PERFORM THE MANEUVER TO THE SELECTED TRACKING ATTITUDE IF THE 
026293,001376:                                                                                          	# MANEUVER IS LESS THAN 10 DEGREES BUT TO CALL R60 IF THE MANEUVER IS
026294,001377:                                                                                          	# GREATER THAN 10 DEGREES OR IF THE R60 FLAG IS SET.
026295,001378: 
026296,001379:                                                                                          	#       (1)     EXTRAPOLATE LM AND CSM STATE VECTORS TO PRESENT TIME USING
026297,001380:                                                                                          	#               CONIC EQUATIONS.
026298,001381: 
026299,001382:                                                                                          	#       (2)     CALCULATE LOS FROM CSM TO LM = RL - RC.
026300,001383: 
026301,001384:                                                                                          	#       (3)     THE PREFERRED TRACKING ATTITUDE IS DEFINED AS FOLLOWS:
026302,001385:                                                                                          	#               THE TRACK AXIS (I) IS ALIGNED ALONG THE LOS TO THE LM.  THE
026303,001386:                                                                                          	#               TRACK AXIS (I) IS DEFINED AS:
026304,001387: 
026305,001388:                                                                                          	#               UNIT(I)=UNIT(Z  )COS55  &  UNIT(X  )SIN55
026306,001389:                                                                                          	#                    -       -SC                -SC
026307,001390: 
026308,001391:                                                                                          	#       (4)     COMPUTE DESIRED CDU ANGLES, USING VECPOINT.
026309,001392: 
026311,001394:                                                                                          	#       (7)     FORM DIFFERENCE BETWEEN DESIRED AND ACTUAL CDUS.
026312,001395:                                                                                          	#               IF ANY OF THE THREE ANGLE DIFFERENCES EXCEEDS 10 DEGREES,
026313,001396:                                                                                          	#               GROSS MANEUVER IS REQUIRED.  SIGNAL R61 (SET MPAC=1) TO
026314,001397:                                                                                          	#               OPERATE KALCMANU AND EXIT CRS61.1.
026315,001398:                                                                                          	#               IF ALL DIFFERENCES ARE LESS THAN 10 DEGREES, CONTINUE.
026316,001399: 
026317,001400:                                                                                          	#       (8)     CALCULATE ORTHOGONAL LOS RATE IN REF COORDS AS
026318,001401: 
026319,001402:                                                                                          	#               OMEGATH = (UNITLOS(B1) X UNITDV(B1))(ABSDV(B7)/ABSLOS(B29))
026320,001403: 
026321,001404:                                                                                          	#               CONVERSION FACTOR OF 100/2PI (B4) REV CSEC PER RAD SEC IS
026322,001405:                                                                                          	#               APPLIED TO YIELD UNITS OF REVS/SEC.  SCALE IS CARRIED AS
026323,001406:                                                                                          	#               B+1+1+7-29+4+1 PLUS RESULTS OF NORMALIZING ABSDV, ABSLOS.
026324,001407:                                                                                          	#               THE EXTRA B+1 RESULTS FROM RESCALING ABSDV B8 AFTER NORM
026325,001408:                                                                                          	#               TO AVOID OVFLOW ON DIVIDE.
026326,001409: 
026327,001410:                                                                                          	#               UNITLOS = UNIT( RL - RC ) B1.
026328,001411:                                                                                          	#               UNITDY  = UNIT( VL - VC ) B1.
026329,001412:                                                                                          	#               ABSLOS  = LENGTH OF LOS, METERS B29.
026330,001413:                                                                                          	#               ABSDV   = LENGTH OF DV, METERS/CSEC B7.
026331,001414: 
026332,001415:                                                                                          	#       (9)     OBTAIN RATE IN SM COORDS.
026333,001416: 
026334,001417:                                                                                          	#               OMEGATHSM = (REFSMMAT)(OMEGATH).
026335,001418: 
026336,001419:                                                                                          	#       (10)    OBTAIN GIMBAL ANGLE INCREMENTS FOR 0.1 SECOND.
026337,001420: 
026338,001421:                                                                                          	#               DTHETASM = (0.1)(OMEGATHSM)
026339,001422: 
026340,001423:                                                                                          	#       (11)    OBTAIN DELCDUX,Y,Z USING SUBR SMCDURES.
026342,001425:                                                                                          	#               INPUT CONSISTS OF
026343,001426: 
026344,001427:                                                                                          	#               (A)     VECTOR OF ANGULAR INCREMENTS, DTHETASM, STORED
026345,001428:                                                                                          	#                       IN V(DTHETASM).
026346,001429:                                                                                          	#               (B)     SIN,COS CDUX,Y,Z FROM SUBR CDUTRIG.
026347,001430: 
026348,001431:                                                                                          	#               TRANSFER OUTPUT OF SMCDURES FROM V(DCDU) TO VAC14D.
026349,001432: 
026350,001433:                                                                                          	#       (12)    CALCULATE ANG LOS RATE IN BODY(NB) COORDS USING SUBR SMNB.
026351,001434: 
026352,001435:                                                                                          	#               OMEGANB = (SMNB)(OMEGATHSM)
026353,001436: 
026354,001437:                                                                                          	#               SUBR SMNB REQUIRES OMEGATHSM IN V(VAC32D) AND ACTUAL CDUS
026355,001438:                                                                                          	#               (Y,X,Z ORDER) IN V(VAC20D) WITH S1 OF VAC = BASE ADDRESS
026356,001439:                                                                                          	#               OF CDUS (FIXLOC + 20D).
026357,001440: 
026358,001441:                                                                                          	#       (13)    CALCULATE ANG LOS RATE IN CONTROL COORDS AS FOLLOWS
026359,001442: 
026360,001443:                                                                                          	#               WBODY = (MBDYTCTL)(OMEGANB)     UNITS=REVS/SEC(B0).
026361,001444: 
026362,001445:                                                                                          	#                              ( 0.5       0              0      )   BODY TO
026363,001446:                                                                                          	#               MBDYTCTL(B1) = (  0   COS(7.25)B1   -SIN(7.25)B1 ) = CONTROL
026364,001447:                                                                                          	#                              (  0   SIN(7.25)B1    COS(7.25)B1 )   AXES
026365,001448:                                                                                          	#                                                                    CONVERSION
026366,001449:                                                                                          	#                                                                    MATRIX
026367,001450: 
026368,001451:                                                                                          	#       (14)    RESCALE WBODY TO UNITS OF 450 DEG/SEC BY APPLYING FACTOR
026369,001452:                                                                                          	#               OF 0.8 TO REVS/SEC.
026370,001453: 
026371,001454:                                                                                          	#       (15)    ADDRESS LIVE AUTOPILOT REGISTERS IN BASIC (UNDER INHINT).
026372,001455: 
026373,001456:                                                                                          	#               TRANSFER DESIRED CDUS, SCALED 180 DEGREES, FROM T(SAVEDCDU)
026374,001457:                                                                                          	#               TO V(CDUXD).
026375,001458: 
026376,001459:                                                                                          	#               TRANSFER DELCDUS, SCALED 180 DEG, FROM V(VAC14D)
026377,001460:                                                                                          	#               TO V(DELCDUX).
026378,001461: 
026379,001462:                                                                                          	#               TRANSFER OMEGA CONTROL, SCALED 450 DEG/SEC, FROM V(MPAC)
026380,001463:                                                                                          	#               TO V(WBODY).
026381,001464: 
026382,001465:                                                                                          	#               RELINT, SET MPAC=0, EXIT CRS61.1
026383,001466: 
026384,001467:                                                                                          	# CALL          L       CALL    CRS61.1
026385,001468: 
026386,001469:                                                                                          	# RETURNS       ALL TO L+1.
026387,001470: 
026388,001471:                                                                                          	#               (1)     S(MPAC)=0.  NORMAL EXIT.  3 SETS OF INPUTS FED TO DAP.
026389,001472:                                                                                          	#               (2)     S(MPAC)=1.  CALCULATED DESIRED CDUS,SP, SET IN T(CPHI)
026390,001473:                                                                                          	#                       FOR KALCMANU.  ABS(ACDU - DCDU) EXCEEDS 10 DEGREES.
026391,001474:                                                                                          	#               (3)     S(MPAC)=2.  GNCS AUTO MODE NOT SELECTED (BIT10=1).
026392,001475:                                                                                          	#               (4)     S(MPAC)=3.  DAP HOLD FLAG (HOLDFLAG) NOT EQUAL -1.
026394,001477: 
026395,001478:                                                                                          	# INPUT         (1)     TIME2,TIME1.  COMPUTER CLOCK TIME,DP, CENTISEC B28.
026396,001479:                                                                                          	#               (2)     CDUX,Y,Z.  PRESENT CDU ANGLES,SP,2S COMPL HALF-REVS B0.
026397,001480:                                                                                          	#               (3)     M(REFSMMAT), STABLE MEMBER COORDS B1.
026398,001481: 
026399,001482:                                                                                          	# OUTPUT        NORMAL.  EXIT WITH S(MPAC) = 0.
026400,001483: 
026401,001484:                                                                                          	#               (1)     CDUXD,CDUYD,CDUZD, DESIRED OUTER, INNER, MIDDLE CDU ANGLES,
026402,001485:                                                                                          	#                       DP, 1S COMPL, SCALED 180 DEGREES (HALF-REVS B0).
026403,001486:                                                                                          	#               (2)     DELCDUX,DELCDUY,DELCDUZ.  0.1 SEC DCU ANGULAR INCREMENTS,
026404,001487:                                                                                          	#                       DP, 1S COMPL, SCALED 180 DEG.
026405,001488:                                                                                          	#               (3)     WBODY,WBODY1,WBODY2.  LOS ANGULAR RATE IN CONTROL COORDS,
026406,001489:                                                                                          	#                       DP, 1S COMPL, SCALED 450 DEG/SEC.
026407,001490: 
026408,001491:                                                                                          	#               SPECIAL.  EXIT WITH S(MPAC) = 1.
026409,001492: 

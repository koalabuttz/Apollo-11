047238,000857: 17,3637           61455                           AD       YWORD1                        	#
047239,000858: 17,3640           00006                           EXTEND                                 	#
047240,000859: 17,3641           01005                           WRITE    CHAN5                         	#
047241,000860: 
047242,000861: 17,3642           11457        T6RUPTOR           CCS      BLAST                         	#
047243,000862: 17,3643           13722                           TCF      ZBLAST                        	# ZERO BLAST1
047244,000863: 17,3644           13661                           TCF      REPLACE                       	# REPLACE WORD1
047245,000864: 17,3645           13647                           TCF      +2                            	#
047246,000865: 17,3646           13661                           TCF      REPLACE                       	#
047247,000866: 17,3647           11461        T6L1               CCS      BLAST1                        	#

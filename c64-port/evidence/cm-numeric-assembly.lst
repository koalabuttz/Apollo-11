061772,000147: 01,3613           00704                           TC       GOLOC      -1                 	#
061773,000148: 01,3614           33557        ITSLIKEB           CA       RTRNCADR                      	# TYPE B, SO STORE RETURN IN
061774,000149: 01,3615           54157                           TS       TEMPSWCH                      	# TEMPSWCH IN CASE OF AN EVEN PHASE
061775,000150: 

015987,002765:                                                                                          	# DSPALARM FINDS TC ENDOFJOB IN ENTRET FOR KEYBOARD INITIATED ROUTINES.
015988,002766:                                                                                          	# DO TC ENTRET.
015989,002767: 
015990,002768: 40,3323           44374        PREDSPAL           CS       VD1                           	#
015991,002769: 40,3324           54777                           TS       DSPCOUNT                      	#
015992,002770: 40,3325           43346        DSPALARM           CS       NVSBENDL                      	#
015993,002771: 40,3326           60136                           AD       ENTEXIT                       	#
015994,002772: 40,3327           00006                           EXTEND                                 	#
015995,002773: 40,3330           13343                           BZF      CHARALRM   +2                 	#
015996,002774: 40,3331           43345                           CS       MONADR                        	# IF THIS IS A MONITOR, KILL IT
015997,002775: 40,3332           60136                           AD       ENTEXIT                       	#
015998,002776: 40,3333           00006                           EXTEND                                 	#
015999,002777: 40,3334           13336                           BZF      +2                            	#
016000,002778: 40,3335           03341                           TC       CHARALRM                      	#
016001,002779: 40,3336           04220                           TC       KILMONON                      	#
016002,002780: 40,3337           04400                           TC       FALTON                        	#
016003,002781: 40,3340           04140                           TC       PASTEVB                       	# PUT MONITOR VERB BACK IN VERBREG
016004,002782: 40,3341           04400        CHARALRM           TC       FALTON                        	# NOT NVSUB INITIATED. TURN ON OPR ERROR
016005,002783: 40,3342           05217                           TC       ENDOFJOB                      	#
016006,002784: 40,3343           05721                           TC       POODOO                        	#
016007,002785: 40,3344           01501                           OCT      01501                         	#
016008,002786: 40,3345           04140        MONADR             GENADR   PASTEVB                       	#
016009,002787: 40,3346           04216        NVSBENDL           TC       NVSUBEND                      	#
016010,002788: 
016011,002789:                                                                                          	# ALMCYCLE TURNS ON CHECK FAIL LIGHT, REDISPLAYS THE ORIGINAL VERB THAT
016012,002790:                                                                                          	# WAS EXECUTED, AND RECYCLES TO EXECUTE THE ORIGINAL VERB/NOUN COMBINATION
016013,002791:                                                                                          	# THAT WAS LAST EXECUTED.  USED FOR BAD DATA DURING LOAD VERBS AND BY
016014,002792:                                                                                          	# MCTBS.  ALSO BY MMCHANG IF 2 NUMERICAL CHARACTERS WERE NOT PUNCHED IN
016015,002793:                                                                                          	# FOR MM CODE.
016016,002794: 
016017,002795:    4161                                           SETLOC   MID7       +1                 	#
016018,002796:    4161                                           COUNT    02/PIN                        	#
016019,002797: 
016020,002798:    4161           04400        ALMCYCLE           TC       FALTON                        	# TURN ON CHECK FAIL LIGHT.
016021,002799:    4162           41041                           CS       VERBSAVE                      	# GET ORIGINAL VERB THAT WAS EXECUTED
016022,002800:    4163           55013                           TS       REQRET                        	# SET FOR ENTPAS0
016023,002801:    4164           04662                           TC       BANKCALL                      	# PUTS ORIGINAL VERB INTO VERBREG AND
016024,002802:    4165           62337                           CADR     UPDATVB    -1                 	# DISPLAYS IT IN VERB LIGHTS.
016025,002803:    4166           04701                           TC       POSTJUMP                      	#
016026,002804:    4167           62002        ENDALM             CADR     ENTER                         	#
016027,002805: 
016028,002806:                                                                                          	# MMCHANG USES NOUN DISPLAY UNTIL ENTER.  THEN IT USES MODE DISP.
016029,002807:                                                                                          	# IT GOES TO MODROUT WITH THE NEW M M CODE IN A, BUT NOT DISPLAYED IN
016031,002809:                                                                                          	# MM LIGHTS.
016032,002810: 
016033,002811:                                                                                          	# IT DEMANDS 2 NUMERICAL CHARACTERS BE PUNCHED IN FOR NEW MM CODE.
016034,002812:                                                                                          	# IF NOT, IT RECYCLES.
016035,002813: 
016036,002814: 41,3430                                           SETLOC   DSP2BIT    +10D               	#
016037,002815: 
016038,002816: 41,3430                                           COUNT    41/PIN                        	#
016039,002817: 
016040,002818: 41,3430           03452        MMCHANG            TC       REQMM                         	# ENTPASHI ASSUMES THE TC REQMM AT MMCHANG
016041,002819:                                                                                          	# IF THIS MOVES AT ALL, MUST CHANGE
016042,002820:                                                                                          	# MMADREF AT ENTPASHI.
016043,002821: 41,3431           35013                           CAF      BIT5                          	# OCT20 = ND2.
016044,002822: 41,3432           60777                           AD       DSPCOUNT                      	# DSPCOUNT MUST = -ND2.
016045,002823: 41,3433           00006                           EXTEND                                 	# DEMAND THAT 2 NUM CHAR WERE PUNCHED IN.
016046,002824: 41,3434           13436                           BZF      +2                            	#
016047,002825: 41,3435           04161                           TC       ALMCYCLE                      	# DSPCOUNT NOT= -ND2.  ALARM AND RECYCLE.
016048,002826: 41,3436           35021                           CAF      ZERO                          	# DSPCOUNT = -ND2.
016049,002827: 41,3437           57002                           XCH      NOUNREG                       	#
016050,002828: 41,3440           54154                           TS       MPAC                          	#
016051,002829: 41,3441           34375                           CAF      ND1                           	#
016052,002830: 41,3442           54777                           TS       DSPCOUNT                      	#
016053,002831: 41,3443           04662                           TC       BANKCALL                      	#
016054,002832: 41,3444           60502                           CADR     2BLANK                        	#
016055,002833: 41,3445           44374                           CS       VD1                           	# BLOCK NUM CHAR IN
016056,002834: 41,3446           54777                           TS       DSPCOUNT                      	#
016057,002835: 41,3447           30154                           CA       MPAC                          	#
016058,002836: 41,3450           04701                           TC       POSTJUMP                      	#
016059,002837: 41,3451           10011                           CADR     MODROUTB                      	# GO THRU STANDARD LOC.
016060,002838: 
016061,002839: 41,3452  04,2011               MODROUTB           =        V37                           	#
016062,002840: 41,3452           40002        REQMM              CS       Q                             	#
016063,002841: 41,3453           55013                           TS       REQRET                        	#
016064,002842: 41,3454           34375                           CAF      ND1                           	#
016065,002843: 41,3455           54777                           TS       DSPCOUNT                      	#
016066,002844: 41,3456           35021                           CAF      ZERO                          	#
016067,002845: 41,3457           55002                           TS       NOUNREG                       	#
016068,002846: 41,3460           04662                           TC       BANKCALL                      	#
016069,002847: 41,3461           60502                           CADR     2BLANK                        	#
016070,002848: 41,3462           04443                           TC       FLASHON                       	#
016071,002849: 41,3463           35017                           CAF      ONE                           	#
016072,002850: 41,3464           55000                           TS       DECBRNCH                      	# SET FOR DEC
016073,002851: 41,3465           00136                           TC       ENTEXIT                       	#
016074,002852: 
016075,002853:                                                                                          	# VBRQEXEC ENTERS REQUEST TO EXEC FOR ANY ADDRESS WITH ANY PRIORITY.
016076,002854:                                                                                          	# IT DOES ENDOFJOB AFTER ENTERING REQUEST.  DISPLAY SYST IS RELEASED.
016077,002855:                                                                                          	# IT ASSUMES NOUN 26 HAS BEEN PRELOADED WITH
016078,002856:                                                                                          	#       COMPONENT 1     PRIORITY (BITS 10-14) BIT1=0 FOR NOVAC, BIT1=1 FOR FINDVAC.
016079,002857:                                                                                          	#       COMPONENT 2     JOB ADRES (12 BIT)
016081,002859:                                                                                          	#       COMPONENT 3     BBCON
016082,002860: 
016083,002861: 41,3466           35017        VBRQEXEC           CAF      BIT1                          	#
016084,002862: 41,3467           71045                           MASK     DSPTEM1                       	#
016085,002863: 41,3470           10000                           CCS      A                             	#
016086,002864: 41,3471           03510                           TC       SETVAC                        	# IF BIT1 = 1, FINDVAC
016087,002865: 41,3472           34365                           CAF      TCNOVAC                       	# IF BIT1 = 0, NOVAC
016088,002866: 41,3473           54154        REQEX1             TS       MPAC                          	# TC NOVAC OR TC FINDVAC INTO MPAC
016089,002867: 41,3474           45017                           CS       BIT1                          	#
016090,002868: 41,3475           71045                           MASK     DSPTEM1                       	#
016091,002869: 41,3476           54160                           TS       MPAC       +4                 	# PRIO INTO MPAC+4 AS A TEMP
016092,002870: 41,3477           04473        REQUESTC           TC       RELDSP                        	#
016093,002871: 41,3500           34233                           CA       ENDINST                       	#
016094,002872: 41,3501           54157                           TS       MPAC       +3                 	# TC ENDOFJOB INTO MPAC+3
016095,002873: 41,3502           00006                           EXTEND                                 	#
016096,002874: 41,3503           31047                           DCA      DSPTEM1    +1                 	# JOB ADRES INTO MPAC+1
016097,002875: 41,3504           52156                           DXCH     MPAC       +1                 	# BBCON INTO MPAC+2
016098,002876: 41,3505           30160                           CA       MPAC       +4                 	# PRIO IN A
016099,002877: 41,3506           00004                           INHINT                                 	#
016100,002878: 41,3507           00154                           TC       MPAC                          	#
016101,002879: 
016102,002880: 41,3510           34370        SETVAC             CAF      TCFINDVC                      	#
016103,002881: 41,3511           03473                           TC       REQEX1                        	#
016104,002882: 
016105,002883:                                                                                          	# VBRQWAIT ENTERS REQUEST TO WAITLIST FOR ANY ADDRESS WITH ANY DELAY.
016106,002884:                                                                                          	# IT DOES ENDOFJOB AFTER ENTERING REQUEST.  DISPLAY SYST IS RELEASED.
016107,002885:                                                                                          	# IT ASSUMES NOUN 26 HAS BEEN PRELOADED WITH
016108,002886:                                                                                          	#       COMPONENT 1     DELAY (LOW BITS)
016109,002887:                                                                                          	#       COMPONENT 2     TASK ADRES (12 BIT)
016110,002888:                                                                                          	#       COMPONENT 3     BBCON
016111,002889: 
016112,002890: 41,3512           34366        VBRQWAIT           CAF      TCWAIT                        	#
016113,002891: 41,3513           54154                           TS       MPAC                          	# TC WAITLIST INTO MPAC
016114,002892: 41,3514           31045                           CA       DSPTEM1                       	# TIME DELAY
016115,002893: 41,3515           03476        ENDRQWT            TC       REQUESTC   -1                 	#
016116,002894: 
016117,002895:                                                                                          	# REQUESTC WILL PUT TASK ADRES INTO MPAC+1, BBCON INTO MPAC+2,
016118,002896:                                                                                          	# TC ENDOFJOB INTO MPAC+3.  IT WILL TAKE TIME DELAY OUT OF MPAC+4 AND
016119,002897:                                                                                          	# LEAVE IT IN A, INHINT AND TC MPAC.
016120,002898: 
016121,002899: 40,3347                                           SETLOC   NVSBENDL   +1                 	#
016122,002900: 40,3347                                           COUNT    40/PIN                        	#
016123,002901: 
016124,002902: 40,3347           35017        VBPROC             CAF      ONE                           	# PROCEED WITHOUT DATA
016125,002903: 40,3350           55014                           TS       LOADSTAT                      	#
016126,002904: 40,3351           04220                           TC       KILMONON                      	# TURN ON KILL MONITOR BIT
016127,002905: 40,3352           04473                           TC       RELDSP                        	#
016128,002906: 40,3353           04447                           TC       FLASHOFF                      	#
016129,002907: 40,3354           03454                           TC       RECALTST                      	# SEE IF THERE IS ANY RECALL FROM ENDIDLE
016130,002908: 
016132,002910: 40,3355           45017        VBTERM             CS       ONE                           	#
016133,002911: 40,3356           03350                           TC       VBPROC     +1                 	# TERM VERB SETS LOADSTAT NEG
016134,002912: 
016135,002913:                                                                                          	# PROCKEY PERFORMS THE SAME FUNCTION AS VBPROC.  IT MUST BE CALLED UNDER
016136,002914:                                                                                          	# EXECUTIVE CONTROL, WITH CHRPRIO.
016137,002915: 
016138,002916: 40,3357           35021        PROCKEY            CAF      ZERO                          	# SET REQRET FOR ENTER PASS 0.
016139,002917: 40,3360           55013                           TS       REQRET                        	#
016140,002918: 40,3361           44374                           CS       VD1                           	# BLOCK NUMERICAL CHARACTERS, SIGNS, CLEAR
016141,002919: 40,3362           54777                           TS       DSPCOUNT                      	#
016142,002920: 40,3363           03347                           TC       VBPROC                        	#
016143,002921: 
016144,002922:                                                                                          	# VBRESEQ WAKES ENDIDLE AT SAME LINE AS FINAL ENTER OF LOAD (L+3).
016145,002923:                                                                                          	# (MAIN USE IS INTENDED AS RESPONSE TO INTERNALLY INITIATED FLASHING
016146,002924:                                                                                          	# DISPLAYS IN ENDIDLE.  SHOULD NOT BE USED WITH LOAD VERBS, PLEASE PERFORM,
016147,002925:                                                                                          	# OR PLEASE MARK VERBS BECAUSE THEY ALREADY USE L+3 IN ANOTHER CONTEXT.)
016148,002926: 
016149,002927: 40,3364           45021        VBRESEQ            CS       ZERO                          	# MAKE IT LOOK LIKE DATA IN.
016150,002928: 40,3365           03350                           TC       VBPROC     +1                 	#
016151,002929: 
016152,002930:                                                                                          	# FLASH IS TURNED OFF BY PROCEED WITHOUT DATA, TERMINATE, RESEQUENCE,
016153,002931:                                                                                          	# END OF LOAD.
016155,002933: 
016156,002934:                                                                                          	# KEY RELEASE ROUTINE
016157,002935: 
016158,002936:                                                                                          	# THIS ROUTINE ALWAYS TURNS OFF THE UPACT LIGHT AND ALWAYS CLEARS DSPLOCK.
016159,002937: 
016160,002938:                                                                                          	# THE HIGHEST PRIORITY FUNCTION OF THE KEY RELEASE BUTTON IS THE
016161,002939:                                                                                          	# UNSUSPENDING OF A SUSPENDED MONITOR WHICH WAS EXTERNALLY INITIATED.
016162,002940:                                                                                          	# THIS FUNCTION IS ACCOMPLISHED BY CLEARING DSPLOCK AND TURNING OFF
016163,002941:                                                                                          	# THE KEY RELEASE LIGHT IF BOTH DSPLIST AND CADRSTOR ARE EMPTY.
016164,002942: 
016165,002943:                                                                                          	# IF NO SUCH MONITOR EXISTS, THEN RELDSP IS EXECUTED TO CLEAR DSPLOCK
016166,002944:                                                                                          	# AND THE EXTERNAL MONITOR BIT (FREEING THE DISPLAY SYSTEM FOR INTERNAL
016167,002945:                                                                                          	# USE), TURN OFF THE KEY RELEASE LIGHT, AND WAKE UP ANY JOB IN DSPLIST.
016168,002946: 
016169,002947:                                                                                          	# IN ADDITION IF THERE IS A JOB IN ENDIDLE, THEN CONTROL IS TRANSFERRED
016170,002948:                                                                                          	# TO PINBRNCH (IN DISPLAY INTERFACE ROUTINE) TO RE-EXECUTE THE SERIES OF
016171,002949:                                                                                          	# NVSUB CALLS ETC. THAT PRECEDED THE ENDIDLE CALL STILL AWAITING RESPONSE.
016172,002950:                                                                                          	# THIS FEATURE IS INTENDED FOR USE WHEN THE OPERATOR HAS BEEN REQUESTED TO
016173,002951:                                                                                          	# RESPOND TO SOME INTERNAL ACTION THAT USED ENDIDLE, BUT HE HAS WRITTEN
016174,002952:                                                                                          	# OVER THE INFORMATION ON THE DISPLAY PANEL BY SOME DISPLAYS OF HIS OWN
016175,002953:                                                                                          	# INITIATION WHICH DO NOT SERVE AS RESPONSES.  HITTING KEYRLSE WILL
016176,002954:                                                                                          	# RE-ESTABLISH THE DISPLAYS TO THE STATE THEY WERE IN BEFORE HE OBSCURED
016177,002955:                                                                                          	# THEM, SO THAT HE CAN SEE THE WAITING REQUEST.  THIS WORKS ONLY FOR
016178,002956:                                                                                          	# INTERNAL PROGRAMS THAT USED ENDIDLE THROUGH MARGARETS DISPLAY
016179,002957:                                                                                          	# SUBROUTINES.
016180,002958: 
016181,002959: 40,3366           45015        VBRELDSP           CS       BIT3                          	#
016182,002960: 40,3367           00006                           EXTEND                                 	#
016183,002961: 40,3370           03011                           WAND     DSALMOUT                      	# TURN OFF UPACT LITE
016184,002962: 40,3371           10115                           CCS      21/22REG                      	# OLD DSPLOCK
016185,002963: 40,3372           35002                           CAF      BIT14                         	#
016186,002964: 40,3373           71021                           MASK     MONSAVE1                      	# EXTERNAL MONITOR BIT (EMB)
016187,002965: 40,3374           10000                           CCS      A                             	#
016188,002966: 40,3375           03404                           TC       UNSUSPEN                      	# OLD DSPLOCK AND EMB BOTH 1, UNSUSPEND.
016189,002967: 40,3376           04473        TSTLTS4            TC       RELDSP                        	# NOT UNSUSPENDING EXTERNAL MONITOR,
016190,002968: 40,3377           11042                           CCS      CADRSTOR                      	#       RELEASE DISPLAY SYSTEM AND
016191,002969: 40,3400           03402                           TC       +2                            	#       DO RE-ESTABLISH IF CADRSTOR IS FULL.
016192,002970: 40,3401           05217                           TC       ENDOFJOB                      	#
016193,002971: 40,3402           04701                           TC       POSTJUMP                      	#
016194,002972: 40,3403           21272                           CADR     PINBRNCH                      	#
016195,002973: 40,3404           35021        UNSUSPEN           CAF      ZERO                          	# EXTERNAL MONITOR IS SUSPENDED,
016196,002974: 40,3405           55012                           TS       DSPLOCK                       	#       JUST UNSUSPEND IT BY CLEARING DSPLOCK.
016197,002975: 40,3406           11042                           CCS      CADRSTOR                      	#       TURN KEY RELEASE LIGHT OFF IF BOTH
016198,002976: 40,3407           05217                           TC       ENDOFJOB                      	#       CADRSTOR AND DSPLIST ARE EMPTY.
016199,002977: 40,3410           04516                           TC       RELDSP1                       	#
016200,002978: 40,3411           05217                           TC       ENDOFJOB                      	#
016201,002979: 
016202,002980: 40,3412                        ENDRELDS           EQUALS                                 	#
016203,002981: 
016205,002983:                                                                                          	# NVSUB IS USED FOR SUBROUTINE CALLS FROM WITHIN COMPUTER.  IT CAN BE
016206,002984:                                                                                          	# USED TO CALL THE COMBINATION OF ANY DISPLAY, LOAD, OR MONITOR VERB
016207,002985:                                                                                          	# TOGETHER WITH ANY NOUN AVAILABLE TO THE KEYBOARD.
016208,002986:                                                                                          	# PLACE 0VVVVVVVNNNNNNN INTO A.
016209,002987:                                                                                          	# V-S ARE THE 7 BIT VERB CODE.  N-S ARE THE 7 BIT NOUN CODE.
016210,002988: 
016211,002989:                                                                                          	# IF NVSUB IS CALLED WITH THE FOLLOWING NEGATIVE NUMBERS (RATHER THAN THE
016212,002990:                                                                                          	# VERB-NOUN CODE) IN A, THEN THE DISPLAY IS BLANKED AS FOLLOWS-
016213,002991:                                                                                          	# -4 FULL BLANK, -3 LEAVE MODE, -2 LEAVE MODE AND VERB, -1 BLANK R-S ONLY
016214,002992: 
016215,002993:                                                                                          	# NVSUB CAN BE USED WITH MACH CADR TO BE SPEC BY PLACING THE CADR INTO
016216,002994:                                                                                          	# MPAC+2 BEFORE THE STANDARD NVSUB CALL.
016217,002995: 
016218,002996:                                                                                          	# NVSUB RETURNS TO 2+ CALLING LOC AFTER PERFORMING TASK, IF DISPLAY
016219,002997:                                                                                          	# SYSTEM IS AVAILABLE.  THE NEW NOUN AND VERB CODES ARE DISPLAYED.
016220,002998:                                                                                          	# IF V:S =0, THE NEW NOUN CODE IS DISPLAYED ONLY (RETURN WITH NO FURTHER
016221,002999:                                                                                          	# ACTION).  IF N-S =0, THE NEW VERB CODE IS DISPLAYED ONLY (RETURN WITH NO
016222,003000:                                                                                          	# FURTHER ACTION).
016223,003001: 
016224,003002:                                                                                          	# IT RETURNS TO 1+ CALLING LOC WITHOUT PERFORMING TASK, IF DISPLAY
016225,003003:                                                                                          	# SYSTEM IS BLOCKED (NOTHING IS DISPLAYED IN THIS CASE).
016226,003004:                                                                                          	# IT DOES TC ABORT (WITH OCT 01501) IF IT ENCOUNTERS A DISPLAY PROGRAM
016227,003005:                                                                                          	# ALARM CONDITION BEFORE RETURN TO CALLER.
016228,003006: 
016229,003007:                                                                                          	# THE DISPLAY SYSTEM IS BLOCKED BY THE DEPRESSION OF ANY
016230,003008:                                                                                          	# KEY, EXCEPT ERROR LIGHT RESET
016231,003009:                                                                                          	# IT IS RELEASED BY THE KEY RELEASE BUTTON, ALL EXTENDED VERBS,
016232,003010:                                                                                          	# PROCEED WITHOUT DATA, TERMINATE, RESEQUENCE, INITIALIZE EXECUTIVE,
016233,003011:                                                                                          	# RECALL PART OF RECALTST IF ENDIDLE WAS USED,
016234,003012:                                                                                          	# VB = REQUEST EXECUTIVE, VB = REQUEST WAITLIST,
016235,003013:                                                                                          	# MONITOR SET UP.
016236,003014: 
016237,003015:                                                                                          	# THE DISPLAY SYSTEM IS ALSO BLOCKED BY THE EXTERNAL MONITOR BIT, WHICH
016238,003016:                                                                                          	# INDICATES AN EXTERNALLY INITIATED MONITOR IS RUNNING (SEE MONITOR)
016239,003017: 
016240,003018:                                                                                          	# A NVSUB CALL THAT PASSES DSPLOCK AND THE EXTERNAL MONITOR BIT ENDS OLD
016241,003019:                                                                                          	# MONITOR.
016242,003020: 
016243,003021:                                                                                          	# DSPLOCK IS THE INTERLOCK FOR USE OF KEYBOARD AND DISPLAY SYSTEM WHICH
016244,003022:                                                                                          	# LOCKS OUT INTERNAL USE WHENEVER THERE IS EXTERNAL KEYBOARD ACTION.
016245,003023: 
016246,003024:                                                                                          	# NVSUB SHOULD BE USED TWICE IN SUCCESSION FOR :PLEASE PERFORM: SITUATIONS
016247,003025:                                                                                          	# (SIMILARLY FOR PLEASE MARK).  FIRST PLACE THE CODED NUMBER FOR WHAT
016248,003026:                                                                                          	# ACTION IS DESIRED OF OPERATOR INTO THEREGISTERS REFERRED TO BY THE
016249,003027:                                                                                          	# :CHECKLIST: NOUN.  GO TO NVSUB WITH A DISPLAY VERB AND THE :CHECKLIST:
016250,003028:                                                                                          	# NOUN.  GO TO NVSUB AGAIN WITH THE :PLEASE PERFORM: VERB AND ZEROS IN THE
016251,003029:                                                                                          	# LOW 7 BITS.  THIS :PASTES UP: THE :PLEASE PERFORM: VERB INTO THE VERB
016252,003030:                                                                                          	# LIGHTS.
016253,003031: 
016254,003032:                                                                                          	# NVMONOPT IS AN ENTRY SIMILAR TO NVSUB, BUT REQUIRING AN ADDITIONAL
016256,003034:                                                                                          	# PARAMETER IN L.  IT SHOULD BE USED ONLY WITH A MONITOR VERB-NOUN CODE IN
016257,003035:                                                                                          	# A.  AFTER EACH MONITOR DISPLAY A *PLEASE* VERB WILL BE PASTED IN THE VERB
016258,003036:                                                                                          	# LIGHTS OR DATA WILL BE BLANKED (OR BOTH) ACCORDING TO THE OPTIONS
016259,003037:                                                                                          	# SPECIFIED IN L.  IF BITS 8-14 OF L ARE OTHER THAN ZERO, THEN THEY WILL 
016260,003038:                                                                                          	# BE INTERPRETED AS A VERB CODE AND PASTED IN THE VERB LIGHTS.  (THIS VERB
016261,003039:                                                                                          	# CODE SHOULD DESIGNATE ONE OF THE *PLEASE* VERBS.)  IF BITS 1-3 OF L ARE
016262,003040:                                                                                          	# OTHER THAN ZERO, THEN THEY WILL BE USED TO BLANK DATA BY BEING FED TO
016263,003041:                                                                                          	# BLANKSUB.  IF NVMONOPT IS USED WITH A VERB OTHER THAN A MONITOR VERB,
016264,003042:                                                                                          	# THE PARAMETER IN L HAS NO EFFECT.
016265,003043: 
016266,003044:                                                                                          	# NVSUB IN FIXED-FIXED PLACES 2+CALLING LOC INTO NVQTEM, TC NVSUBEND INTO
016267,003045:                                                                                          	# ENTRET.  (THIS WILL RESTORE OLD CALLING BANK BITS)
016268,003046: 
016269,003047:    4170                                           SETLOC   ENDALM     +1                 	#
016270,003048: 
016271,003049:    4170                                           COUNT    02/PIN                        	#
016272,003050: 
016273,003051:    4170           22007        NVSUB              LXCH     7                             	# ZERO NVMONOPT OPTIONS
016274,003052:    4171           54123        NVMONOPT           TS       NVTEMP                        	#
016275,003053:    4172           35002                           CAF      BIT14                         	#
016276,003054:    4173           71021                           MASK     MONSAVE1                      	# EXTERNAL MONITOR BIT
016277,003055:    4174           61012                           AD       DSPLOCK                       	#
016278,003056:    4175           10000                           CCS      A                             	#
016279,003057:    4176           00002                           TC       Q                             	# DSP SYST BLOCKED.  RET TO 1+ CALLING LOC
016280,003058:    4177           35017                           CAF      ONE                           	# DSP SYST AVAILABLE

057452,000483: 
057453,000484:                                                                                          	# SPECIAL PURPOSE ENTRIES TO ORBITAL INTEGRATION.  THESE ROUTINES PROVIDE ENTRANCES TO INTEGRATION WITH
057454,000485:                                                                                          	# APPROPRIATE SWITCHES SET OR CLEARED FOR THE DESIRED INTEGRATION.
057455,000486: 
057456,000487:                                                                                          	# CSMPREC AND LEMPREC PERFORM ORBIT INTEGRATION BY THE ENCKE METHOD TO THE TIME INDICATED IN TDEC1
057457,000488:                                                                                          	# ACCELERATIONS DUE TO OBLATENESS ARE INCLUDED.  NO W-MATRIX INT. IS DONE.
057458,000489:                                                                                          	# THE PERMANENT STATE VECTOR IS NOT UPDATED.
057459,000490:                                                                                          	# CSMCONIC AND LEMCONIC PERFORM ORBIT INTEG. BY KEPLERS METHOD TO THE TIME INDICATED IN TDEC1
057460,000491:                                                                                          	# NO DISTURBING ACCELERATIONS ARE INCLUDED.  IN THE PROGRAM FLOW THE GIVEN
057461,000492:                                                                                          	# STATE VECTOR IS RECTIFIED BEFORE SOLUTION OF KEPLERS EQUATION
057462,000493: 
057463,000494:                                                                                          	# THE ROUTINES ASSUME THAT THE CSM (LEM) STATE VECTOR IN P-MEM IS VALID.
057464,000495:                                                                                          	# SWITCHES SET PRIOR TO ENTRY TO THE MAIN INTEG. PROG ARE AS FOLLOWS
057465,000496:                                                                                          	#                       CSMPREC         CSMCONIC        LEMPREC         LEMCONIC
057466,000497:                                                                                          	#       VINTFLAG        SET             SET             CLEAR           CLEAR
057467,000498:                                                                                          	#       INTYPFLG        CLEAR           SET             CLEAR           SET
057468,000499:                                                                                          	#       DIM0FLAG        CLEAR           CLEAR           CLEAR           CLEAR
057470,000501: 
057471,000502:                                                                                          	# CALLING SEQUENCE
057472,000503:                                                                                          	#       L-X     STORE   TDEC1
057473,000504:                                                                                          	#       L       CALL                    (STCALL TDEC1)
057474,000505:                                                                                          	#       L+1             CSMPREC         (CSMCONIC, LEMPREC, LEMCONIC)
057475,000506: 
057476,000507:                                                                                          	# NORMAL EXIT TO L+2
057477,000508: 

059999,000226:                                                                                          	# SUBROUTINE NAME:  TFFRP/RA                    DATE: 01.17.67
060000,000227:                                                                                          	# MOD NO:  0                                    LOG SECTION:  TIME OF FREE FALL
060001,000228:                                                                                          	# MOD BY:  RR BAIRNSFATHER
060002,000229:                                                                                          	# MOD NO:  1    MOD BY:  RR BAIRNSFATHER        DATE: 11 APR 67
060003,000230:                                                                                          	# MOD NO:  2    MOD BY:  RR BAIRNSFATHER        DATE: 21 MAR 68         ACCEPT DIFFERENT EARTH/MOON SCALES
060004,000231:                                                                                          	#                                                                       ALSO IMPROVE ACCURACY OF RAPO.
060005,000232: 
060006,000233:                                                                                          	# FUNCTIONAL DESCRIPTION:  USED BY CALCTPER AND TFF DISPLAYS TO CALCULATE PERIGEE RADIUS AND ALSO
060007,000234:                                                                                          	#       APOGEE RADIUS FOR A GENERAL CONIC.
060008,000235:                                                                                          	#       PROGRAM GIVES PERIGEE RADIUS AS         APOGEE RADIUS IS GIVEN BY
060009,000236:                                                                                          	#               RP = P/(1+E)                            RA = (1+E) / ALFA
060010,000237:                                                                                          	#       WHERE    2
060011,000238:                                                                                          	#               E  = 1 - P ALFA
060012,000239:                                                                                          	#       IF RA IS NEGATIVE OR SHOWS DIVIDE OVERFLOW, THEN RA = POSMAX BECAUSE
060013,000240:                                                                                          	#               1. APOGEE RADIUS IS NOT MEANINGFUL FOR HYPERBOLA
060014,000241:                                                                                          	#               2. APOGEE RADIUS IS NOT DEFINED FOR PARABOLA
060015,000242:                                                                                          	#               3. APOGEE RADIUS EXCEEDS THE SCALING FOR ELLIPSE.
060016,000243: 
060017,000244:                                                                                          	#       THIS SUBROUTINE REQUIRES THE SIGNED RECIPROCAL SEMI MAJ AXIS, ALFA, AND SEMI LATUS RECTUM AS DATA.
060018,000245: 
060019,000246:                                                                                          	# CALLING SEQUENCE:     CALL
060020,000247:                                                                                          	#                               TFFRP/RA
060021,000248:                                                                                          	#       PUSHLOC = PDL+0, ARBITRARY IF LEQ 10D
060022,000249:                                                                                          	#       C(MPAC) UNSPECIFIED
060023,000250: 
060024,000251:                                                                                          	# SUBROUTINES CALLED:   NONE
060025,000252: 
060026,000253:                                                                                          	# NORMAL EXIT MODE:     RVQ
060027,000254:                                                                                          	#       IF ELLIPSE, WITHIN NORMAL SCALING, RAPO IS CORRECT.
060028,000255:                                                                                          	#       OTHERWISE, RAPO = POSMAX.
060029,000256: 
060030,000257:                                                                                          	# ALARMS:       NONE
060031,000258: 
060032,000259:                                                                                          	# OUTPUT:       STORED IN PUSH LIST AREA.  SCALE OF OUTPUT AGREES WITH DATA SUPPLIED TO TFF/CONIC.
060033,000260:                                                                                          	#       RPER    E:(-29) M:(-27)         M       PERIGEE RADIUS          DESTROYED BY CALCTFF/CALCTPER, TFFTRIG.
060034,000261:                                                                                          	#       RAPO    E:(-29) M:(-27)         M       APOGEE RADIUS           WILL BE DESTROYED BY CALCTFF/CALCTPER
060035,000262:                                                                                          	#       PUSHLOC AT PDL+0
060036,000263: 
060037,000264:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:
060038,000265:                                                                                          	#       TFFALFA E:(26-NR)               M       1/SEMI MAJ AXIS LEFT BY TFFCONIC
060039,000266:                                                                                          	#               M:(24-NR)
060040,000267:                                                                                          	#       TFFNP   E:(-38+2NR)             M       LC P, SEMI LATUS RECTUM LEFT BY TFFCONIC
060041,000268:                                                                                          	#               M:(-36+2NR)
060042,000269:                                                                                          	#       X1                              -NR, NORM COUNT OF RMAG         LEFT BY TFFCONIC
060043,000270:                                                                                          	#       X2                              -NA, NORM COUNT OF ALFA         LEFT BY TFFCONIC
060044,000271: 
060045,000272:                                                                                          	# DEBRIS:       QPRET, PDL+0 ... PDL+1
060046,000273: 
060048,000275: 27,3026                        RAPO               =        16D                           	# APOGEE RADIUS  M  E:(-29) M:(-27)
060049,000276: 27,3026                        RPER               =        14D                           	# PERIGEE RADIUS  M  E:(-29) M:(-27)
060050,000277: 
060051,000278: 27,3026           41345        TFFRP/RA           DLOAD    DMP                           	#
060052,000279: 27,3027           00033                                    TFFALFA                       	# ALFA  1/M  E:(26-NR) M:(24-NR)
060053,000280: 27,3030           00035                                    TFFNP                         	# LC P  M E:(-38+2NR) M:(-36+2NR)
060054,000281: 27,3031           57457                           SR*      DCOMP                         	# ALFA P (-12+NR)
060055,000282: 27,3032           20571                                    0          -8D,1              	# ALFA P (-4)
060056,000283: 27,3033           51415                           DAD      ABS                           	# (DCOMP GIVES VALID TP RESULT FOR SQRT)
060057,000284:                                                                                          	# (ABS PROTECTS SQRT IF E IS VERY NEAR 0)
060058,000285: 27,3034           17366                                    DP2(-4)                       	#
060059,000286: 27,3035           43366                           SQRT     DAD                           	# E SQ = (1- P ALFA) (-4)
060060,000287: 27,3036           15325                                    TFF1/4                        	#
060061,000288: 27,3037           55206                           PUSH     BDDV                          	# (1+E)  (-2)  TO PDL+0
060062,000289: 27,3040           00035                                    TFFNP                         	# LCP  M  E:(-38+2NR) M:(-36+2NR)
060063,000290: 27,3041           53657                           SR*      SR*                           	# (DOES SR THEN SL TO AVOID OVFL)
060064,000291: 27,3042           20601                                    0,1                           	# X1=-NR
060065,000292: 27,3043           20572                                    0          -7,1               	# (EFFECTIVE SL)
060066,000293: 27,3044           14017                           STODL    RPER                          	# PERIGEE RADIUS  M  E:(-29) M:(-27)
060067,000294:                                                                                          	# (1+E)  (-2)  FROM PDL+0
060068,000295: 27,3045           41005                           DMP      BOVB                          	#
060069,000296: 27,3046           00027                                    TFF1/ALF                      	# E:(-22-2NA) M:(-20-2NA)
060070,000297: 27,3047           57352                                    TCDANZIG                      	# CLEAR OVFIND, IF ON.
060071,000298: 27,3050           53654                           BZE      SL*                           	#
060072,000299: 27,3051           57060                                    MAXRA                         	# SET POSMAX, IF ALFA=0
060073,000300: 27,3052           57603                                    0          -5,2               	# -5+NA
060074,000301: 27,3053           40057                           SL*      BOV                           	#
060075,000302: 27,3054           57576                                    0,2                           	#
060076,000303: 27,3055           57060                                    MAXRA                         	# SET POSMAX IF OVFL.
060077,000304: 27,3056           77644                           BPL                                    	# CONTINUE WITH VALID RAPO.
060078,000305: 27,3057           57062                                    +3                            	#
060079,000306: 27,3060           77745        MAXRA              DLOAD                                  	# RAPO CALC IS NOT VALID.  SET RAPO =
060080,000307: 27,3061           17372                                    NEARONE                       	# POSMAX AS A TAG.
060081,000308: 27,3062           00021                 +3        STORE    RAPO                          	# APOGEE RADIUS  M  E:(-29) M:(-27)
060082,000309: 27,3063           77616        DUMPRPRA           RVQ                                    	#
060083,000310:                                                                                          	#                       30 W
060085,000312:                                                                                          	# SUBROUTINE NAME:  CALCTPER / CALCTFF          DATE:  01.29.67
060086,000313:                                                                                          	# MOD NO:  0                                    LOG SECTION:  TIME OF FREE FALL
060087,000314:                                                                                          	# MOD BY:  RR BAIRNSFATHER
060088,000315:                                                                                          	# MOD NO:  1    MOD BY:  RR BAIRNSFATHER        DATE: 21 MAR 67
060089,000316:                                                                                          	# MOD NO:  2    MOD BY:  RR BAIRNSFATHER        DATE: 14 APR 67
060090,000317:                                                                                          	# MOD NO:  3    MOD BY:  RR BAIRNSFATHER        DATE: 8 JUL 67          NEAR EARTH MUE AND NEG TFF (GONEPAST)
060091,000318:                                                                                          	# MOD NO:  4    MOD BY:  RR BAIRNSFATHER        DATE: 21 NOV 67         ADD VARIABLE MU.
060092,000319:                                                                                          	# MOD NO:  5    MOD BY:  RR BAIRNSFATHER        DATE: 21 MAR 68         ACCEPT DIFFERENT EARTH/MOON SCALES
060093,000320: 
060094,000321:                                                                                          	# FUNCTIONAL DESCRIPTION:  PROGRAM CALCULATES THE FREE-FALL TIME OF FLIGHT FROM PRESENT POSITION RN AND
060095,000322:                                                                                          	#       VELOCITY VN TO A RADIUS LENGTH SPECIFIED BY RTERM, SUPPLIED BY THE USER.  THE POSITION VECTOR
060096,000323:                                                                                          	#       RN MAY BE ON EITHER SIDE OF THE CONIC, BUT RTERM IS CONSIDERED ON THE INBOUND SIDE.
060097,000324:                                                                                          	#       THE EQUATIONS ARE
060098,000325: 
060099,000326:                                                                                          	#               Q2 = -SQRT(RTERM (2-RTERM ALFA) - LCP)  (INBOUND SIDE)) LEQ +- LCE/SQRT(ALFA)
060100,000327:                                                                                          	#                    -  -
060101,000328:                                                                                          	#               Q1 = RN.VN / SQRT(MU)                                   LEQ +- LCE/SQRT(ALFA)
060102,000329: 
060103,000330:                                                                                          	#               Z = NUM / DEN                                           LEQ +- 1/SQRT(ALFA)
060104,000331: 
060105,000332:                                                                                          	#       WHERE, IF INBOUND
060106,000333:                                                                                          	#               NUM = RTERM -RN                                         LEQ +- 2 LCE/ALFA
060107,000334:                                                                                          	#               DEN = Q2+Q1                                             LEQ +- 2 LCE/SQRT(ALFA)
060108,000335: 
060109,000336:                                                                                          	#       AND, IF OUTBOUND
060110,000337:                                                                                          	#               NUM = Q2-Q1                                             LEQ +- 2 LCE/SQRT(ALFA)
060111,000338:                                                                                          	#               DEN = 2 - ALFA (RTERM + RN).                            LEQ +- 2 LCE
060112,000339: 
060113,000340:                                                                                          	#       IF      ALFA ZZ < 1.0           (FOR ALL CONICS EXCEPT ELLIPSES HAVING ABS(DEL ECC ANOM) G 90 DEG)
060114,000341:                                                                                          	#       THEN    X = ALFA Z Z
060115,000342:                                                                                          	#       AND     TFF = (RTERM +RN -2 ZZ T(X) ) Z/SQRT(MU)
060116,000343:                                                                                          	#               EXCEPT  IF ALFA PNZ, AND IF TFF NEG,
060117,000344:                                                                                          	#               THEN    TFF = 2 PI /(ALFA SQRT(ALFA)) + TFF
060118,000345:                                                                                          	#       OR      IF ALFA ZZ GEQ 1.0      (FOR ELLIPSES HAVING ABS(DEL ECC ANOM) GEQ 90 DEG)
060119,000346:                                                                                          	#       THEN    X = 1/ALFA Z Z
060120,000347:                                                                                          	#       AND     TFF = (PI/SQRT(ALFA) -Q2 +Q1 +2(X T(X) -1) /ALFA Z) /ALFA SQRT(MU)
060121,000348:                                                                                          	#       WHERE   T(X) IS A POLYNOMIAL APPROXIMATION TO THE SERIES
060122,000349:                                                                                          	#                            2      3             2
060123,000350:                                                                                          	#               1/3 - X/5 + X /7 - X /9 ...     (X  < 1.0)
060124,000351: 
060125,000352:                                                                                          	# CALLING SEQUENCE:     TIME TO RTERM                   TIME TO PERIGEE
060126,000353:                                                                                          	#                       CALL                            CALL
060127,000354:                                                                                          	#                               CALCTFF                         CALCTPER
060128,000355:                                                                                          	#                       C(MPAC) = TERMNL RAD M          C(MPAC) = PERIGEE RAD M
060129,000356:                                                                                          	#       FOR EITHER, E:(-29) M:(-27)
060130,000357:                                                                                          	#       FOR EITHER, PUSHLOC = PDL+0, ARBITRARY IF LEQ 8D.
060132,000359: 
060133,000360:                                                                                          	# SUBROUTINES CALLED:   T(X), VIA RTB
060134,000361: 
060135,000362:                                                                                          	# NORMAL EXIT MODE:     RVQ
060136,000363:                                                                                          	#       HOWEVER, PROGRAM EXITS WITH ONE OF THE FOLLOWING VALUES FOR TFF (-28) CS IN MPAC.  USER MUST STORE.
060137,000364:                                                                                          	#               A. TFF = FLIGHT TIME.  NORMAL CASE FOR POSITIVE FLIGHT TIME LESS THAN ONE ORBITAL PERIOD.
060138,000365:                                                                                          	#               B. (THIS OPTION IS NO LONGER USED.)
060139,000366:                                                                                          	#               C. TFF = POSMAX.  THIS INDICATES THAT THE CONIC FROM THE PRESENT POSITION WILL NOT RETURN TO
060140,000367:                                                                                          	#                  THE SPECIFIED ALTITUDE.  ALSO INDICATES OUTBOUND PARABOLA OR HYPERBOLA.
060141,000368: 
060142,000369:                                                                                          	# OUTPUT:       C(MPAC)         (-28) CS        TIME OF FLIGHT, OR TIME TO PERIGEE
060143,000370:                                                                                          	#               TFFX            (0)             X,                                      LEFT FOR ENTRY DISPLAY TFF ROUTINES
060144,000371:                                                                                          	#               NRTERM          E:(-29+NR) M    RTERM, WEIGHTED BY NR                   LEFT FOR ENTRY DISPLAY TFF ROUTINES
060145,000372:                                                                                          	#                               M:(-27+NR)
060146,000373:                                                                                          	#               TFFTEM          E:(-59+2NR)     LCP Z Z SGN(SDELF)                      LEFT FOR ENTRY DISPLAY TFF ROUTINES
060147,000374:                                                                                          	#                               M:(-55+2NR)     LCP /ALFA SGN(SDELF)                    LEFT FOR ENTRY DISPLAY TFF ROUTINES
060148,000375:                                                                                          	#               NOTE:   TFFTEM = PDL 36D AND WILL BE DESTROYED BY .:UNIT:.
060149,000376:                                                                                          	#               RMAG1           E:(-29) M:(-27) PDL 12 NOT TOUCHED.
060150,000377:                                                                                          	#               TFFQ1           E:(-16) M:(-15) PDL 14D
060151,000378:                                                                                          	#               TFFDELQ         E:(-16) M:(-15) PDL 10D
060152,000379:                                                                                          	#               PUSHLOC AT PDL+0
060153,000380: 
060154,000381:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:
060155,000382:                                                                                          	#               RONE            E:(-29) M:(-27) M  STATE VECTOR                         LEFT BY USER
060156,000383:                                                                                          	#               VONE'           E:(+10) M:(+9)  VN/SQRT(MU)                             LEFT BY TFF/CONIC
060157,000384:                                                                                          	#               RMAG1           E:(-29) M:(-27) PRESENT RADIUS, M                       LEFT BY TFFCONIC
060158,000385:                                                                                          	#               C(MPAC)         E:(-29) M:(-27) RTERM, TERMINAL RADIUS LENGTH, M        LEFT BY USER
060159,000386: 
060160,000387:                                                                                          	#               THE FOLLOWING ARE STORED IN THE PUSH LIST AREA.
060161,000388:                                                                                          	#               TFF/RTMU        E:(17) M:(14)   1/SQRT(MU)                              LEFT BY TFFCONIC.
060162,000389:                                                                                          	#               NRMAG           E:(-29+NR)      M  RMAG, NORMALIZED                     LEFT BY TFFCONIC
060163,000390:                                                                                          	#                               M:(-27+NR)
060164,000391:                                                                                          	#               X1                              -NR, NORM COUNT                         LEFT BY TFFCONIC
060165,000392:                                                                                          	#               TFFNP           E:(-38+2NR)     M  LCP, SEMI LATUS RECTUM, WEIGHT NR    LEFT BY TFFCONIC
060166,000393:                                                                                          	#                               M:(-36+2NR)
060167,000394:                                                                                          	#               TFFALFA         E:(26-NR)       1/M  ALFA, WEIGHT NR                    LEFT BY TFFCONIC
060168,000395:                                                                                          	#                               M:(24-NR)
060169,000396:                                                                                          	#               TFFRTALF        E:(10+NA)       SQRT(ALFA), NORMALIZED                  LEFT BY TFFCONIC
060170,000397:                                                                                          	#                               M:(9+NA)
060171,000398:                                                                                          	#               X2                              -NA, NORM COUNT                         LEFT BY TFFCONIC
060172,000399:                                                                                          	#               TFF1/ALF        E:(-22-2NA)     SIGNED SEMIMAJ AXIS, WEIGHTED BY NA     LEFT BY TFFCONIC
060173,000400:                                                                                          	#                               M:(-20-2NA)
060174,000401: 
060175,000402:                                                                                          	# DEBRIS:       QPRET, PDL+0 ... PDL+3
060176,000403:                                                                                          	#               RTERM           E:(-29) M:(-27) RTERM, TERMINAL RADIUS LENGTH
060177,000404:                                                                                          	#               RAPO            E:(-29) M:(-27) PDL 16D (=NRTERM)
060178,000405:                                                                                          	#               RPER            E:(-29) M:(-27) PDL 14D (=TFFQ1)
060179,000406: 
060181,000408: 27,3064           77614        CALCTPER           SETGO                                  	# ENTER WITH RPER IN MPAC
060182,000409: 27,3065           03436                                    TFFSW                         	#
060183,000410: 27,3066           57071                                    +3                            	#
060184,000411: 27,3067           77614        CALCTFF            CLEAR                                  	# ENTER WITH RTERM IN MPAC
060185,000412: 27,3070           03676                                    TFFSW                         	#
060186,000413: 27,3071           00023                 +3        STORE    RTERM                         	# E:(-29) M:(-27)
060187,000414: 27,3072           77657                           SL*                                    	#
060188,000415: 27,3073           20201                                    0,1                           	# X1=-NR
060189,000416: 27,3074           00021                           STORE    NRTERM                        	# RTERM  E:(-29+NR) M:(-27+NR)
060190,000417: 27,3075           44205                           DMP      BDSU                          	#
060191,000418: 27,3076           00033                                    TFFALFA                       	# ALFA  E:(26-NR) M:(24-NR)
060192,000419: 27,3077           15325                                    TFF1/4                        	#
060193,000420: 27,3100           41206                           PUSH     DMP                           	# (2-ALFA RTERM)  (-3)  TO PDL+0
060194,000421: 27,3101           00021                                    NRTERM                        	# E:(-29+NR) M:(-27+NR)
060195,000422: 27,3102           53725                           PDDL     SR*                           	# RTERM(2-ALFA RTERM) TO PDL+2
060196,000423:                                                                                          	# E:(-32+NR) M:(-30+NR)
060197,000424: 27,3103           00035                                    TFFNP                         	# LC P  E:(-38+2NR) M:(-36+2NR)
060198,000425: 27,3104           20573                                    0          -6,1               	# X1 = -NR
060199,000426: 27,3105           43276                           DCOMP    DAD                           	# DUE TO SHIFTS, KEEP PRECISION FOR SQRT
060200,000427:                                                                                          	# RTERM(2-ALFA RTERM) FROM PDL +2

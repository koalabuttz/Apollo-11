062720,000757: 
062722,000759:                                                                                          	# GENERAL STALLING ROUTINE.  USING PROGRAMS COME HERE TO WAIT FOR I/O COMPLETION.
062723,000760: 
062724,000761:                                                                                          	# PROGRAM DESCRIPTION                           DATE - 21 FEB 1967
062725,000762:                                                                                          	#                                               LOG SECTION IMU MODE SWITCHING
062726,000763:                                                                                          	# MOD BY - R. MELANSON TO ADD DOCUMENTATION     ASSEMBLY SUNDISK REV. 82
062727,000764: 
062728,000765:                                                                                          	# FUNCTIONAL DESCRIPTION -
062729,000766:                                                                                          	#       TO DELAY FURTHER EXECUTION OF THE CALLING ROUTINE UNTIL ITS SELECTED
062730,000767:                                                                                          	#       I/O FUNCTION IS COMPLETE.  THE FOLLOWING CHECKS ON THE CALLING ROUTINE:S
062731,000768:                                                                                          	#       MODECADR ARE MADE AND ACTED UPON.
062732,000769:                                                                                          	#       1) +0 INDICATES INCOMPLETE I/O OPERATION.  CALLING ROUTINE IS PUT TO
062733,000770:                                                                                          	#          SLEEP.
062734,000771:                                                                                          	#       2) -1 INDICATES COMPLETED I/O OPERATION.  STALL BYPASSES JOBSLEEP
062735,000772:                                                                                          	#          CALL AND RETURNS TO CALLING ROUTINE AT L+3
062736,000773:                                                                                          	#       3) -0 INDICATES COMPLETED I/O WITH FAILURE.  STALL CLEARS MODECADR
062737,000774:                                                                                          	#          AND RETURNS TO CALLING ROUTINE AT L+2.
062738,000775:                                                                                          	#       4) VALUE GREATER THAN 0 INDICATES TWO ROUTINES CALLING FOR USE OF
062739,000776:                                                                                          	#          SAME DEVICE.  STALL EXITS TO ABORT WHICH EXECUTES A PROGRAM
062740,000777:                                                                                          	#          RESTART WHICH IN TURN CLEARS ALL MODECADR REGISTERS.
062741,000778: 
062742,000779:                                                                                          	# CALLING SEQUENCE -
062743,000780:                                                                                          	#       L       TC      BANKCALL
062744,000781:                                                                                          	#       L+1     CADR    (ONE OF 5 STALL ADDRESSES  I.E. IMUSTALL, OPTSTALL, RADSTALL,
062745,000782:                                                                                          	#                       AOTSTALL, OR ATTSTALL)
062746,000783: 
062747,000784:                                                                                          	# NORMAL-EXIT MODE -
062748,000785:                                                                                          	#       TCF JOBSLEEP    OR      TCF MODEXIT
062749,000786: 
062750,000787:                                                                                          	# ALARM OR ABORT EXIT MODE -
062751,000788:                                                                                          	#       TC      ABORT
062752,000789: 
062753,000790:                                                                                          	# OUTPUT -
062754,000791:                                                                                          	#       MODECADR=CADR   IF JOBSLEEP
062755,000792:                                                                                          	#       MODECADR=+0     IF I/O COMPLETE
062756,000793:                                                                                          	#       BUF2=L+3        IF I/O COMPLETE AND GOOD.
062757,000794:                                                                                          	#       BUF2=L+2        IF I/O COMPLETE BUT FAILED.
062758,000795: 
062759,000796:                                                                                          	# ERASABLE INITIALIZATION -
062760,000797:                                                                                          	#       BUF2 CONTAINS RETURN ADDRESS PLUS 1,(L+2)
062761,000798:                                                                                          	#       BUF2+1 CONTAINS FBANK VALUE OF CALLING ROUTINE.
062762,000799:                                                                                          	#       MODECADR OF CALLING ROUTINE CONTAINS +0,-1,-0 OR CADR RETURN ADDRESS.
062763,000800: 
062764,000801:                                                                                          	# DEBRIS -
062765,000802:                                                                                          	#       RUPTREG2 AND CALLING ROUTINE MODECADR.
062766,000803: 
062767,000804: 07,3573           35017        AOTSTALL           CAF      ONE                           	# AOT.
062768,000805: 07,3574           03600                           TC       STALL                         	#
062769,000806: 
062770,000807: 07,3575           35016        RADSTALL           CAF      TWO                           	#
062771,000808: 07,3576           13600                           TCF      STALL                         	#
062772,000809: 
062774,000811: 07,3577  07,3573               OPTSTALL           EQUALS   AOTSTALL                      	#
062775,000812: 
062776,000813: 07,3577           35021        IMUSTALL           CAF      ZERO                          	# IMU.
062777,000814: 
062778,000815: 07,3600           00004        STALL              INHINT                                 	#
062779,000816: 07,3601           54071                           TS       RUPTREG2                      	# SAVE DEVICE INDEX.
062780,000817: 07,3602           50000                           INDEX    A                             	# SEE IF OPERATION COMPLETE.
062781,000818: 07,3603           11322                           CCS      MODECADR                      	#
062782,000819: 07,3604           13622                           TCF      MODABORT                      	# ALLOWABLE STATES ARE +0, -1, AND -0.
062783,000820: 07,3605           13616                           TCF      MODESLP                       	# OPERATION INCOMPLETE.
062784,000821: 07,3606           13612                           TCF      MODEGOOD                      	# COMPLETE AND GOOD IF = -1.
062785,000822: 
062786,000823: 07,3607           50071        MG2                INDEX    RUPTREG2                      	# COMPLETE AND FAILED IF -0.  RESET TO +0.
062787,000824: 07,3610           55322                           TS       MODECADR                      	# RETURN TO CALLER.
062788,000825: 07,3611           12640                           TCF      MODEEXIT                      	#
062789,000826: 
062790,000827: 07,3612           10000        MODEGOOD           CCS      A                             	# MAKE SURE INITIAL STATE -1.
062791,000828: 07,3613           13622                           TCF      MODABORT                      	#
062792,000829: 
062793,000830: 07,3614           24133                           INCR     BUF2                          	# IF SO, INCREMENT RETURN ADDRESS AND
062794,000831: 07,3615           13607                           TCF      MG2                           	# RETURN IMMEDIATELY, SETTING CADR = +0.
062795,000832: 
062796,000833: 07,3616           04711        MODESLP            TC       MAKECADR                      	# CALL FROM SWITCHABLE FIXED ONLY.
062797,000834: 07,3617           50071                           INDEX    RUPTREG2                      	#
062798,000835: 07,3620           55322                           TS       MODECADR                      	#
062799,000836: 07,3621           15175                           TCF      JOBSLEEP                      	#
062800,000837: 
062801,000838: 07,3622           05721        MODABORT           TC       POODOO                        	# TWO PROGRAMS USING SAME DEVICE.
062802,000839: 07,3623           01210                           OCT      1210                          	#
062803,000840: 
062805,000842:                                                                                          	# CONSTANTS FOR MODE SWITCHING ROUTINES
062806,000843: 
062807,000844: 07,3624     5771               BITS3&4            =        OCT14                         	#
062808,000845: 07,3624     5033               BITS4&6            =        OCT50                         	#
062809,000846: 07,3624     5027               BITS4-5            EQUALS   BITS4&5                       	#
062810,000847: 07,3624     5010               IMUSEFLG           EQUALS   BIT8                          	# INTERPRETER SWITCH 7.
062811,000848: 07,3624           77500        -COMMAX            DEC      -191       B-14               	#
062812,000849: 07,3625           77477        -COMMAX-           DEC      -192       B-14               	#
062813,000850: 07,3626           00074        600MS              DEC      60         B-14               	#
062814,000851: 07,3627  07,3073               IMUFIN20           =        IMUFINE                       	#
062815,000852: 07,3627           31325        GOMANUR            CA       ATTCADR                       	# IS KALCMANU FREE
062816,000853: 07,3630           00006                           EXTEND                                 	#
062817,000854: 07,3631           13634                           BZF      +3                            	#
062818,000855: 07,3632           05721                           TC       POODOO                        	# NO
062819,000856: 07,3633           01210                           OCT      1210                          	# 2 TRYING TO USE SAME DEVICE
062820,000857: 
062821,000858: 07,3634           00006                 +3        EXTEND                                 	#
062822,000859: 07,3635           30134                           DCA      BUF2                          	#
062823,000860: 07,3636           53326                           DXCH     ATTCADR                       	# SAVE FINAL RETURN FOR KALCMAN3
062824,000861: 
062825,000862: 07,3637           30006                           CA       BBANK                         	#
062826,000863: 07,3640           75023                           MASK     SEVEN                         	#
062827,000864: 07,3641           27326                           ADS      ATTCADR    +1                 	#
062828,000865: 
062829,000866: 07,3642           30167                           CA       PRIORITY                      	#
062830,000867: 07,3643           77674                           MASK     PRIO37                        	#
062831,000868: 07,3644           55327                           TS       ATTPRIO                       	# SAVE USERS PRIO
062832,000869: 
062833,000870: 07,3645           33651                           CAF      KALEBCON                      	# SET EBANK FOR KALCMAN3
062834,000871: 07,3646           54003                           TS       EBANK                         	#
062835,000872: 07,3647           04701                           TC       POSTJUMP                      	#
062836,000873: 07,3650           44000                           CADR     KALCMAN3                      	#
062837,000874: 07,3651           03261        KALEBCON           ECADR    BCDU                          	#
062838,000875: 
062840,000877:                                                                                          	# PROGRAM DESCRIPTION
062841,000878:                                                                                          	# IMU STATUS CHECK ROUTINE R02 (SUBROUTINE UTILITY)
062842,000879:                                                                                          	# MOD NO - 1
062843,000880:                                                                                          	# MOD BY - N.BRODEUR
062844,000881: 
062845,000882:                                                                                          	# FUNCTIONAL DESCRIPTION
062846,000883:                                                                                          	#       TO CHECK WHETHER IMU IS ON AND IF ON WHETHER IT IS ALIGNED TO AN
062847,000884:                                                                                          	#       ORIENTATION KNOWN BY THE CMC.  TO REQUEST SELECTION OF THE APPROPRIATE
062848,000885:                                                                                          	#       PROGRAM IF THE IMU IS OFF OR NOT ALIGNED TO AN ORIENTATION KNOWN BY THE
062849,000886:                                                                                          	#       CMC.  CALLED THROUGH BANKCALL
062850,000887: 
062851,000888:                                                                                          	# CALLING SEQUENCE -
062852,000889:                                                                                          	#       L       TC      BANKCALL
062853,000890:                                                                                          	#       L+1     CADR    R02BOTH
062854,000891: 
062855,000892:                                                                                          	# SUBROUTINES CALLED
062856,000893:                                                                                          	#       VARALARM
062857,000894:                                                                                          	#       FLAGUP
062858,000895: 
062859,000896:                                                                                          	# NORMAL EXIT MODES
062860,000897:                                                                                          	#       AT L+2 OF CALLING SEQUENCE
062861,000898: 
062862,000899:                                                                                          	# ALARM OR ABORT EXIT MODES
062863,000900:                                                                                          	#       GOTOPOOH, WITH ALARM
062864,000901: 
062865,000902:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
062866,000903:                                                                                          	#       NONE
062867,000904: 
062868,000905:                                                                                          	# DEBRIS
062869,000906:                                                                                          	#       CENTRALS - A,Q,L
062870,000907: 
062871,000908: 34,3763                                           BANK     34                            	#
062872,000909: 07,2000                                           SETLOC   R02                           	#
062873,000910: 07,2000                                           BANK                                   	#
062874,000911: 07,3652                                           COUNT    04/R02                        	# COUNT*
062875,000912: 
062876,000913: 07,3652           00063        DEC51              DEC      51         B-14               	#
062877,000914: 07,3653           35003        R02BOTH            CAF      BIT13                         	#
062878,000915: 07,3654           70077                           MASK     STATE      +3                 	# REFSMFLG
062879,000916: 07,3655           10000                           CCS      A                             	#
062880,000917: 07,3656           03667                           TC       R02ZERO                       	# ZERO IMUS
062881,000918: 
062882,000919: 07,3657           31320                           CA       IMODES30                      	#
062883,000920: 07,3660           75007                           MASK     BIT9                          	# IS ISS INITIALIZED
062884,000921: 07,3661           00006                           EXTEND                                 	#
062885,000922: 07,3662           13664                           BZF      +2                            	#
062886,000923: 07,3663           45014                           CS       BIT4                          	# SEND IMU ALARM CODE 210
062887,000924: 07,3664           63672                           AD       OCT220                        	# SEND REFSMM ALARM
062888,000925: 07,3665           05764                           TC       VARALARM                      	#
062889,000926: 
062890,000927: 07,3666           04106                           TC       GOTOPOOH                      	#
062891,000928: 
062893,000930: 07,3667           05546        R02ZERO            TC       UPFLAG                        	#
062894,000931: 07,3670           00007                           ADRES    IMUSE                         	#
062895,000932: 07,3671           14675                           TCF      SWRETURN                      	#
062896,000933: 07,3672           00220        OCT220             OCT      220                           	#
062897,000934: 
062899,000936:                                                                                          	# PROGRAM DESCRIPTION   P06             10FEB67
062900,000937: 
062901,000938:                                                                                          	# TRANSFER THE ISS/CMC FROM THE OPERATE TO THE STANDBY CONDITION.
062902,000939: 
062903,000940:                                                                                          	# THE NORMAL CONDITION OF READINESS OF THE GNCS WHEN NOT IN USE IS STANDBY.  IN THIS CONDITION THE IMU
062904,000941:                                                                                          	# HEATER POWER IS ON.  THE IMU OPERATE POWER IS OFF.  THE COMPUTER POWER IS ON.  THE OPTICS POWER IS OFF.  THE
062905,000942:                                                                                          	# CMC STANDBY ON THE MAIN AND LEB DISKYS IS ON.
062906,000943: 
062907,000944:                                                                                          	# CALLING SEQUENCE:
062908,000945:                                                                                          	#       ASTRONAUT REQUEST THROUGH DSKY  V37E 06E.
062909,000946: 
062910,000947:                                                                                          	# SUBROUTINES CALLED:
062911,000948:                                                                                          	#       GOPERF1
062912,000949:                                                                                          	#       BANKCALL
062913,000950:                                                                                          	#       FLAGDOWN
062914,000951: 
062916,000953:                                                                                          	# PRESTAND PREPARES FOR STANDBY BY SNAPSHOTTING THE SCALER AND TIME1 TIME2
062917,000954:                                                                                          	# THE LOW 5 BITS OF THE SCALER ARE INSPECTED TO INSURE COMPATABILITY
062918,000955:                                                                                          	# BETWEEN THE SCALER READING AND THE TIME1 TIME2 READING.
062919,000956: 
062920,000957: 26,2000                                           SETLOC   P05P06                        	#
062921,000958: 26,2000                                           BANK                                   	#
062922,000959: 
062923,000960: 26,3660     1150                                  EBANK=   TIME2SAV                      	#
062924,000961: 26,3660                                           COUNT*   $$/P06                        	#
062925,000962: 
062926,000963: 26,3660           05546        P06                TC       UPFLAG                        	# SET NODOV37 BIT
062927,000964: 26,3661           00054                           ADRES    NODOFLAG                      	#
062928,000965: 
062929,000966: 26,3662           00004        PRESTAND           INHINT                                 	#
062930,000967: 26,3663           00006                           EXTEND                                 	#
062931,000968: 26,3664           30025                           DCA      TIME2                         	# SNAPSHOT TIME1 TIME2
062932,000969: 26,3665           53151                           DXCH     TIME2SAV                      	#
062933,000970: 26,3666           03717                           TC       SCALPREP                      	#
062934,000971: 26,3667           03662                           TC       PRESTAND                      	# T1,T2,SCALER NOT COMPATIBLE
062935,000972: 26,3670           52155                           DXCH     MPAC                          	# T1,T2 AND SCALER OK
062936,000973: 26,3671           53153                           DXCH     SCALSAVE                      	# STORE SCALER
062937,000974: 26,3672           00004                           INHINT                                 	#
062938,000975: 26,3673           04662                           TC       BANKCALL                      	#
062939,000976: 26,3674           17060                           CADR     RNDREFDR                      	# REFSMM, DRIFT, TRACK FLAGS DOWN
062940,000977: 
062941,000978: 26,3675           05560                           TC       DOWNFLAG                      	#
062942,000979: 26,3676           00007                           ADRES    IMUSE                         	# IMUSE DOWN
062943,000980: 26,3677           05560                           TC       DOWNFLAG                      	#
062944,000981: 26,3700           00010                           ADRES    RNDVZFLG                      	# RNDVZFLG DOWN
062945,000982: 
062946,000983: 26,3701           35005                           CAF      BIT11                         	#
062947,000984: 26,3702           00006                           EXTEND                                 	#
062948,000985: 26,3703           05013                           WOR      CHAN13                        	# SET STANDBY ENABLE BIT
062949,000986: 
062950,000987: 26,3704           05412                           TC       PHASCHNG                      	# SET RESTART TO POSTAND WHEN STANDBY
062951,000988: 26,3705           07024                           OCT      07024                         	#       RECOVERS
062952,000989: 26,3706           20000                           OCT      20000                         	#
062953,000990: 26,3707     1152                                  EBANK=   SCALSAVE                      	#
062954,000991: 26,3707           03737 54062                     2CADR    POSTAND                       	#
062955,000992: 
062956,000993: 26,3711           35036                           CAF      OCT62                         	#
062957,000994: 26,3712           04662                           TC       BANKCALL                      	#
062958,000995: 26,3713           21045                           CADR     GOPERF1                       	#
062959,000996: 26,3714           13711                           TCF      -3                            	#
062960,000997: 26,3715           13711                           TCF      -4                            	#
062961,000998: 26,3716           13711                           TCF      -5                            	#
062962,000999: 
062963,001000: 26,3717     5036               OCT62              EQUALS   .5SEC                         	# DEC 50 = OCT 62
062964,001001: 
062965,001002:                                                                                          	# THE LOW 5 BITS OF THE SCALER READS 10000 FOR THE FIRST INTERVAL AFTER A
062967,001004:                                                                                          	# T1 INCREMENT.  IF SCALPREP DETECTS THIS INTERVAL THE T1,T2 AND SCALER
062968,001005:                                                                                          	# DATA ARE NOT COMPATABLE AND RETURN IS TO L+1 FOR ANOTHER READING OF THE
062969,001006:                                                                                          	# DATA.  OTHERWISE, THE RETURN IS TO L+2 TO PROCEED.  ROUTINE ALSO PREPARES
062970,001007:                                                                                          	# THE SCALER READING FOR COMPUTATION OF THE INCREMENT TO UPDATE T1T2.  (THE
062971,001008:                                                                                          	# 10 MS BIT (BIT 6) OF THE SCALER IS INCREMENTED 5 MS OUT OF PHASE FROM
062972,001009:                                                                                          	# T1.) ADDITION OF 5 MS (BIT 5) TO THE SCALER READING HAS THE EFFECT OF
062973,001010:                                                                                          	# ADJUSTING BIT 6 IN THE SCALER TO BE IN PHASE WITH BIT 1 OF T1.  THE LOW 5
062974,001011:                                                                                          	# BITS OF THE SCALER READING ARE THEN SET TO ZERO, TO TRUNCATE THE SCALER
062975,001012:                                                                                          	# DATA TO 10 MS.  RESULTS ARE STORED IN MPAC, +1.
062976,001013: 
062977,001014: 26,3717           00006        SCALPREP           EXTEND                                 	#
062978,001015: 26,3720           22156                           QXCH     MPAC       +2                 	#
062979,001016: 26,3721           04554                           TC       FINETIME   +1                 	#
062980,001017: 26,3722           00003                           RELINT                                 	#
062981,001018: 26,3723           52155                           DXCH     MPAC                          	#
062982,001019: 26,3724           35013                           CA       BIT5                          	# ADD 5 MS TO THE SCALER READING.
062983,001020: 26,3725           54001                           TS       L                             	#
062984,001021: 26,3726           35021                           CA       ZERO                          	#
062985,001022: 26,3727           20155                           DAS      MPAC                          	#
062986,001023: 26,3730           44362                           CS       LOW5                          	# SET LOW 5 BITS OF (SCALER+5MS) TO ZERO
062987,001024: 26,3731           70155                           MASK     MPAC       +1                 	# AND STORE RESULTS IN MPAC,+1.
062988,001025: 26,3732           56155                           XCH      MPAC       +1                 	#
062989,001026: 26,3733           74362                           MASK     LOW5                          	# TEST LOW 5 BITS OF SCALER FOR THE FIRST
062990,001027:                                                                                          	# INTERVAL AFTER THE T1 INCREMENT
062991,001028:                                                                                          	# (NOW = 00000, SINCE BIT 5 ADDED).
062992,001029: 26,3734           10000                           CCS      A                             	# IS IT 1ST INTERVAL AFTER T1 INCREMENT
062993,001030: 26,3735           24156                           INCR     MPAC       +2                 	# NO
062994,001031: 26,3736           00156                           TC       MPAC       +2                 	# YES
062995,001032: 
062996,001033:                                                                                          	# POSTAND RECOVERS TIME AFTER STANDBY.  THE SCALER IS SNAPSHOTTED AND THE
062997,001034:                                                                                          	# TIME1 TIME2 COUNTER IS SET TO ZERO.  THE LOW 5 BITS OF THE SCALER ARE
062998,001035:                                                                                          	# INSPECTED TO INSURE COMPATABILITY BETWEEN THE SCALER READING AND THE
062999,001036:                                                                                          	# CLEARING OF THE TIME COUNTER.  IT THEN COMPUTES THE DIFFERENCE IN SCALER
063000,001037:                                                                                          	# VALUES (IN DP) AND ADDS THIS TO THE PREVIOUSLY SNAPSHOTTED VALUES OF
063001,001038:                                                                                          	# TIME1 TIME2 AND PLACES THIS NEW TIME INTO THE TIME1 TIME2 COUNTER.
063002,001039: 
063003,001040: 26,3737                                           COUNT*   $$/P05                        	#
063004,001041: 
063005,001042: 26,3737           45005        POSTAND            CS       BIT11                         	# RECOVER TIME AFTER STANDBY.
063006,001043: 26,3740           00006                           EXTEND                                 	#
063007,001044: 26,3741           03013                           WAND     CHAN13                        	# CLEAR STANDBY ENABLE BIT
063008,001045: 26,3742           00004                           INHINT                                 	#
063009,001046: 26,3743           35021                           CA       ZERO                          	#
063010,001047: 26,3744           54001                           TS       L                             	#
063011,001048: 26,3745           52025                           DXCH     TIME2                         	# CLEAR TIME1 TIME2
063012,001049: 26,3746           03717                           TC       SCALPREP                      	# STORE SCALER IN MPAC, MPAC+1
063013,001050: 26,3747           03742                           TC       POSTAND    +3                 	# T1,T2,SCALER NOT COMPATIBLE
063014,001051: 26,3750           00006                           EXTEND                                 	# T1,T2 AND SCALER OK
063015,001052: 26,3751           41153                           DCS      SCALSAVE                      	#
063016,001053: 26,3752           20155                           DAS      MPAC                          	# FORM DP DIFFERENCE OF POSTSTANDBY SCALER
063018,001055: 26,3753           35006                           CAF      BIT10                         	# MINUS PRESTANDBY SCALER AND SHIFT RIGHT
063019,001056: 26,3754           07256                           TC       SHORTMP                       	# 5 TO ALIGN BITS WITH TIME1 TIME2.
063020,001057: 26,3755           35021                           CAF      ZERO                          	#
063021,001058: 26,3756           54156                           TS       MPAC       +2                 	# NEEDED FOR TP AGREE
063022,001059: 26,3757           07226                           TC       TPAGREE                       	# MAKE DP DIFF AGREE
063023,001060: 26,3760           10154                           CCS      MPAC                          	#
063024,001061: 26,3761           03766                           TC       POSTCOM                       	# IF DP DIFF NET +, NO SCALER OVERFLOW
063025,001062: 26,3762           03766                           TC       POSTCOM                       	# BETWEEN PRE AND POST STANDBY.
063026,001063: 26,3763           03764                           TC       +1                            	# IF DP DIFF NET -, SCALER OVERFLOWED.  ADD
063027,001064: 26,3764           35006                           CAF      BIT10                         	# BIT 10 TO HIGH DIFF TO CORRECT.
063028,001065: 26,3765           26154                           ADS      MPAC                          	#
063029,001066: 26,3766           00006        POSTCOM            EXTEND                                 	# C(MPAC,+1) IS MAGNITUDE OF DELTA SCALER.
063030,001067: 26,3767           31151                           DCA      TIME2SAV                      	# PRESTANDBY TIME1 TIME2
063031,001068: 26,3770           20155                           DAS      MPAC                          	#
063032,001069: 26,3771           07226                           TC       TPAGREE                       	# FORCE SIGN AGREEMENT
063033,001070: 26,3772           52155                           DXCH     MPAC                          	# UPDATED VALUE FOR T1,T2.
063034,001071: 26,3773           20025                           DAS      TIME2                         	# LOAD UPDATED VALUE INTO T1,T2, WITH
063035,001072: 26,3774           05560                           TC       DOWNFLAG                      	# CLEAR NODOFLAG
063036,001073: 26,3775           00054                           ADRES    NODOFLAG                      	#
063037,001074: 
063038,001075: 26,3776           04106                           TC       GOTOPOOH                      	#
063039,001076: 
063040,001077: 
063041,001078: 
(End of include-file IMU_MODE_SWITCHING_ROUTINES.agc, resuming MAIN.agc)

012680,000260:                                                                                          	# SUBROUTINE TO COMPUTE THE NATURAL LOG OF C(MPAC, MPAC +1).
012681,000261: 
012682,000262:                                                                                          	#       ENTRY:  CALL
012683,000263:                                                                                          	#                       LOG
012684,000264: 
012685,000265:                                                                                          	# SUBROUTINE RETURNS WITH -LOG IN DP MPAC.
012686,000266: 
012687,000267:                                                                                          	# EBANK IS ARBITRARY..
012688,000268: 
012689,000269: 14,2000                                           BANK     14                            	#
012690,000270: 23,2000                                           SETLOC   POWFLIT2                      	#
012691,000271: 23,2000                                           BANK                                   	#

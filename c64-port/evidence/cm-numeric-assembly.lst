039720,000041: 
039722,000043: 31,3700                                           BANK     31                            	#
039723,000044: 36,2000                                           SETLOC   RTE1                          	#
039724,000045: 36,2000                                           BANK                                   	#
039725,000046: 
039726,000047: 36,2466  E7,1631                                  EBANK=   RTEDVD                        	#
039727,000048: 36,2466                                           COUNT    31/P37                        	#
039728,000049: 
039729,000050:                                                                                          	# PROGRAM DESCRIPTION - P37, RETURN TO EARTH
039730,000051: 
039731,000052:                                                                                          	# DESCRIPTION
039732,000053:                                                                                          	#       A RETURN TO EARTH TRAJECTORY IS COMPUTED PROVIDED THE CSM IS OUTSIDE THE LUNAR SPHERE OF INFLUENCE AT THE
039733,000054:                                                                                          	#       TIME OF IGNITION.  INITIALLY A CONIC TRAJECTORY IS DETERMINED AND RESULTING IGNITION AND REENTRY PARAMETERS ARE
039734,000055:                                                                                          	#       DISPLAYED TO THE ASTRONAUT.  THEN IF THE ASTRONAUT SO DESIRES, A PRECISION TRAJECTORY IS DETERMINED WITH THE
039735,000056:                                                                                          	#       RESULTING IGNITION AND REENTRY PARAMETERS DISPLAYED.  UPON FINAL ACCEPTANCE BY THE ASTRONAUT, THE PROGRAM
039736,000057:                                                                                          	#       COMPUTES AND STORES THE TARGET PARAMETERS FOR RETURN TO EARTH FOR USE BY SPS PROGRAM (P40) OR RCS PROGRAM (P41).
039737,000058: 
039738,000059:                                                                                          	# CALLING SEQUENCE
039739,000060:                                                                                          	#       L       TC      P37
039740,000061: 
039741,000062:                                                                                          	# SUBROUTINES CALLED
039742,000063:                                                                                          	#       PREC100
039743,000064:                                                                                          	#               V2T100
039744,000065:                                                                                          	#               RTENCK2
039745,000066:                                                                                          	#               RTENCK3
039746,000067:                                                                                          	#               TIMERAD
039747,000068:                                                                                          	#               PARAM
039748,000069:                                                                                          	#       V2T100
039749,000070:                                                                                          	#               GAMDV10
039750,000071:                                                                                          	#               XT1LIM
039751,000072:                                                                                          	#               DVCALC
039752,000073:                                                                                          	#       RTENCK1
039753,000074:                                                                                          	#               INTSTALL
039754,000075:                                                                                          	#               INTEGRVS
039755,000076:                                                                                          	#       RTEVN
039756,000077:                                                                                          	#               RTEDISP
039757,000078:                                                                                          	#               TMRAD100
039758,000079:                                                                                          	#               AUGEKUGL
039759,000080:                                                                                          	#               LAT-LONG
039760,000081:                                                                                          	#       TMRAD100
039761,000082:                                                                                          	#               TIMERAD
039762,000083:                                                                                          	#       INVC100
039763,000084:                                                                                          	#               CSMPREC
039764,000085:                                                                                          	#       GETERAD
039765,000086:                                                                                          	#       TIMETHET
039766,000087:                                                                                          	#       P370ALRM
039767,000088:                                                                                          	#       VN1645
039768,000089:                                                                                          	#       POLY
039769,000090: 
039770,000091:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
039771,000092:                                                                                          	#       CSM STATE VECTOR
039773,000094:                                                                                          	#       NJETSFLG        NUMBER OF JETS IF THE RCS PROPULSION SYSTEM SELECTED    STATE FLAG      0=4 JETS  1=2 JETS
039774,000095: 
039775,000096:                                                                                          	# ASTRONAUT INPUT
039776,000097:                                                                                          	#       SPRTETIG        TIME OF IGNITION (OVERLAYS TIG)                         DP      B28     CS
039777,000098:                                                                                          	#       VPRED           DESIRED CHANGE IN VELOCITY AT TIG(PROGRM COMPUTED IF 0) DP      B7      METERS/CS
039778,000099:                                                                                          	#       GAMMAEI         DESIRED FLIGHT PATH ANGLE AT REENTRY (COMPUTED IF 0)    DP      B0      REVS + ABOVE HORIZ.
039779,000100:                                                                                          	#       OPTION2         PROPULSION SYSTEM OPTION                                SP      B14     1=SPS, 2=RCS
039780,000101: 
039781,000102:                                                                                          	# OUTPUT
039782,000103:                                                                                          	#    CONIC OR PRECISION TRAJECTORY DISPLAY
039783,000104:                                                                                          	#       VPRED           VELOCITY MAGNITUDE AT 400,000 FT. ENTRY ALTITUDE        DP      B7      METERS/CS
039784,000105:                                                                                          	#       T3TOT4          TRANSIT TIME TO 400,000 FT. ENTRY ALTITUDE              DP      B28     CS
039785,000106:                                                                                          	#       GAMMAEI         FLIGHT PATH ANGLE AT 400,000 FT. ENTRY ALTITUDE         DP      B0      REVS + ABOVE HORIZON
039786,000107:                                                                                          	#       DELVLVC         INITIAL VELOCITY CHANGE VECTOR IN LOCAL VERTICAL COORD. VECTOR  B7      METERS/CS

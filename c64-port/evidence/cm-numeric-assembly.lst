013024,000179: 06,3413           00006                           EXTEND                                 	# C(MPAC) = (PIPA PULSES) X 2(+14)
013025,000180: 06,3414           70154                           MP       MPAC                          	# (GYRO PULSES)/(PIPA PULSE) X 2(-3)            *
013026,000181: 06,3415           52123                           DXCH     VBUF                          	# NOW = (GYRO PULSES) X 2(+11)                  *

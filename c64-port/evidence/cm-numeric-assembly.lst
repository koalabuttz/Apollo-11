040798,001119:                                                                                          	# INTEGRATION CALLING SUBROUTINE
040799,001120: 
040800,001121:                                                                                          	# DESCRIPTION
040801,001122:                                                                                          	#       PERFORMS CONIC AND PRECISION INTEGRATIONS USING SUBROUTINE INTEGRVS.  THERE ARE THREE ENTRANCES (RTENCK1,
040802,001123:                                                                                          	#       RTENCK2 AND RTENCK3) FOR DIFFERENT SOURCES OF INPUT AND DIFFERENT OPTIONS.  THERE IS A COMMON SET OF OUTPUT
040803,001124:                                                                                          	#       WHICH INCLUDES SET UP OF INPUT FOR THE PARAM SUBROUTINE
040804,001125: 
040805,001126:                                                                                          	# RTENCK1 (CONIC INTEGRATION)
040806,001127: 
040807,001128:                                                                                          	#    CALLING SEQUENCE
040808,001129:                                                                                          	#       L       CALL
040809,001130:                                                                                          	#       L+1             RTENCK1
040810,001131: 
040811,001132:                                                                                          	#    ERASABLE INITIALIZATION REQUIRED
040812,001133:                                                                                          	#       SAME AS FOR THE RTENCK3 ENTRANCE
040813,001134: 
040814,001135:                                                                                          	# RTENCK2 (PRECISION INTEGRATION)
040815,001136: 
040816,001137:                                                                                          	#    CALLING SEQUENCE
040817,001138:                                                                                          	#       L       CALL
040818,001139:                                                                                          	#       L+1             RTENCK2

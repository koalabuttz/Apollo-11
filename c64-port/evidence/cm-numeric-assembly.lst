005013,003378: E7,1426  E7,1425               DVTOTAL            EQUALS   END-DELV                      	# B(2)DSP NOUN 40,99 FOR P30,34,35,40
005014,003379: E7,1426  E7,1427               TGO                EQUALS   DVTOTAL    +2                 	# B(2)
005015,003380: E7,1426  E7,1431               DVCNTR             EQUALS   TGO        +2                 	# B(1)TMP
005016,003381: E7,1426  E7,1432               DELVREF            EQUALS   DVCNTR     +1                 	# I(6)TMP

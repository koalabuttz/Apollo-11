012726,000306: 
012728,000308:                                                                                          	# SUBROUTINE NAME:  EARTH ROTATOR       (EARROT1 OR EARROT2)            DATE:  15 FEB 67
012729,000309:                                                                                          	# MOD NO:  N +1                                                         LOG SECTION:  POWERED FLIGHT SUBROS
012730,000310:                                                                                          	# MOD BY:  ENTRY GROUP (BAIRNSFATHER)
012731,000311: 
012732,000312:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS ROUTINE PROJECTS THE INITIAL EARTH TARGET VECTOR RTINIT AHEAD THROUGH
012733,000313:                                                                                          	#       THE ESTIMATED TIME OF FLIGHT.  INITIAL CALL RESOLVES THE INITIAL TARGET VECTOR RTINIT INTO EASTERLY
012734,000314:                                                                                          	#       AND NORMAL COMPONENTS RTEAST AND RTNORM.  INITIAL AND SUBSEQUENT CALLS ROTATE THIS VECTOR
012735,000315:                                                                                          	#       ABOUT THE (FULL) UNIT POLAR AXIS UNITW THROUGH THE ANGLE  WIE DTEAROT  TO OBTAIN THE ROTATED
012736,000316:                                                                                          	#       TARGET VECTOR RT.  ALL VECTORS EXCEPT UNITW ARE HALF UNIT.
012737,000317:                                                                                          	#       THE EQUATIONS ARE
012738,000318:                                                                                          	#               -    -        -                      -
012739,000319:                                                                                          	#               RT = RTINIT + RTNORM (COS(WT) - 1) + RTEAST SIN(WT)
012740,000320: 
012741,000321:                                                                                          	#       WHERE   WT = WIE DTEAROT
012742,000322: 
012743,000323:                                                                                          	#               RTINIT = INITIAL TARGET VECTOR
012744,000324:                                                                                          	#               -        -       -
012745,000325:                                                                                          	#               RTEAST = UNITW * RTINIT
012746,000326:                                                                                          	#               -        -        -
012747,000327:                                                                                          	#               RTNORM = RTEAST * UNITW
012748,000328: 
012749,000329:                                                                                          	#       FOR CONTINUOUS UPDATING, ONLY ONE ENTRY TO EARROT1 IS REQUIRED, WITH SUBSEQUENT ENTRIES AT EARROT2.
012750,000330:                                                                                          	#       
012751,000331:                                                                                          	# CALLING SEQUENCE:     FIRST CALL                      SUBSEQUENT CALL
012752,000332:                                                                                          	#                       STCALL  DTEAROT                 STCALL  DTEAROT
012753,000333:                                                                                          	#                               EARROT1                         EARROT2
012754,000334:                                                                                          	#                       C(MPAC) UNSPECIFIED             C(MPAC) = DTEAROT
012755,000335:                                                                                          	#       PUSHLOC = PDL+0, ARBITRARY.  6 LOCATIONS USED.
012756,000336: 
012757,000337:                                                                                          	# SUBROUTINES USED:  NONE
012758,000338: 
012759,000339:                                                                                          	# NORMAL EXIT MODES:  RVQ
012760,000340: 
012761,000341:                                                                                          	# ALARMS:  NONE
012762,000342: 
012763,000343:                                                                                          	# OUTPUT:       RTEAST  (-1)            .5 UNIT VECTOR EAST, COMPNT OF RTINIT   LEFT BY FIRST CALL
012764,000344:                                                                                          	#               RTNORM  (-1)            .5 UNIT VECTOR NORML, COMPNT OF RTINIT  LEFT BY FIRST CALL
012765,000345:                                                                                          	#               RT      (-1)            .5 UNIT TARGET VECTOR, ROTATED          LEFT BY ALL CALLS
012766,000346:                                                                                          	#               DTEAROT (-28) CS        MAY BE CHANGED BY EARROT2, IF OVER 1 DAY
012767,000347: 
012768,000348:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:
012769,000349:                                                                                          	#               UNITW   (0)             UNIT POLAR VECTOR                       PAD LOADED
012770,000350:                                                                                          	#               RTINIT  (-1)            .5 UNIT INITIAL TARGET VECTOR           LEFT BY ENTRY
012771,000351:                                                                                          	#               DTEAROT (-28) CS        TIME OF FLIGHT                          LEFT BY CALLER
012772,000352: 
012773,000353:                                                                                          	# DEBRIS:  QPRET, PDL+0 ... PDL+5
012775,000355: 23,2215  E7,1451                                  EBANK=   RTINIT                        	#
012776,000356: 
012777,000357: 23,2215           47375        EARROT1            VLOAD    VXV                           	#
012778,000358: 23,2216           01714                                    UNITW                         	# FULL UNIT VECTOR
012779,000359: 23,2217           03452                                    RTINIT                        	# .5 UNIT
012780,000360: 23,2220           03460                           STORE    RTEAST                        	# .5 UNIT
012781,000361: 
012782,000362: 23,2221           77635                           VXV                                    	#
012783,000363: 23,2222           01714                                    UNITW                         	# FULL UNIT
012784,000364: 23,2223           17466                           STODL    RTNORM                        	# .5 UNIT
012785,000365: 23,2224           03606                                    DTEAROT                       	# (-28) CS
012786,000366: 
012787,000367: 23,2225           56204        EARROT2            BOVB     DDV                           	#
012788,000368: 23,2226           57352                                    TCDANZIG                      	# RESET OVFIND, IF ON
012789,000369: 23,2227           06256                                    1/WIE                         	#
012790,000370: 23,2230           41400                           BOV      PUSH                          	#
012791,000371: 23,2231           46245                                    OVERADAY                      	#
012792,000372: 23,2232           45346                           COS      DSU                           	#
012793,000373: 23,2233           15333                                    HIDPHALF                      	#
012794,000374: 23,2234           65361                           VXSC     PDDL                          	# XCH W PUSH LIST
012795,000375: 23,2235           03466                                    RTNORM                        	# .5 UNIT
012796,000376: 23,2236           74356                           SIN      VXSC                          	#
012797,000377: 23,2237           03460                                    RTEAST                        	# .5 UNIT
012798,000378: 23,2240           76455                           VAD      VSL1                          	#
012799,000379: 23,2241           53455                           VAD      UNIT                          	# INSURE THAT RT IS 'UNIT'.
012800,000380: 23,2242           03452                                    RTINIT                        	# .5 UNIT
012801,000381: 23,2243           03474                           STORE    RT                            	# .5 UNIT TARGET VECTOR
012802,000382: 
012803,000383: 23,2244           77616                           RVQ                                    	#
012804,000384: 
012805,000385: 23,2245           75345        OVERADAY           DLOAD    SIGN                          	#
012806,000386: 23,2246           06256                                    1/WIE                         	#
012807,000387: 23,2247           03606                                    DTEAROT                       	#
012808,000388: 23,2250           77621                           BDSU                                   	#
012809,000389: 23,2251           03606                                    DTEAROT                       	#
012810,000390: 23,2252           03606                           STORE    DTEAROT                       	#
012811,000391: 
012812,000392: 23,2253           77650                           GOTO                                   	#
012813,000393: 23,2254           46225                                    EARROT2                       	#
012814,000394: 

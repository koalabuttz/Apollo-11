023379,000403: 04,3250           02367                                    RTRN                          	#       TDEC1
023380,000404: 04,3251           01352                                    AVFLAG                        	#
023381,000405: 04,3252           11257                                    OTHERV                        	#
023382,000406: 04,3253           77624                           CALL                                   	#
023384,000408: 04,3254           27071                                    CSMPREC                       	#
023385,000409: 04,3255           77650                           GOTO                                   	#
023386,000410: 04,3256           02367                                    RTRN                          	#

024203,000784: 
024204,000785:                                                                                          	# SATURN TAKEOVER FUNCTION
024205,000786:                                                                                          	# ************************
024206,000787:                                                                                          	# 
024207,000788:                                                                                          	# PROGRAM DESCRIPTION
024208,000789: 
024209,000790:                                                                                          	#       MOD NUMBER 1
024210,000791:                                                                                          	#       MOD BY ELIASSEN
024211,000792: 
024212,000793:                                                                                          	# FUNCTIONAL DESCRIPTION
024213,000794: 
024214,000795:                                                                                          	#       DURING THE COASTING PHASE OF SIVB ATTACHED, THE
024215,000796:                                                                                          	#       ASTRONAUT MAY REQUEST SATURN TAKEOVER THROUGH
024216,000797:                                                                                          	#       EXTENDED VERB 46 (BITS 13,14 OF DAPDATR1 SET ).
024217,000798:                                                                                          	#       THE CMC REGARDS RHC COMMANDS AS BODY-AXES RATE
024218,000799:                                                                                          	#       COMMANDS AND IT TRANSMITS THESE TO SATURN AS DC
024220,000801:                                                                                          	#       VOLTAGES.  THE VALUE OF THE CONSTANT RATE COMMAND
024221,000802:                                                                                          	#       IS 0.5 DEG/SEC.  AN ABSENCE OF RHC ACTIVITY RE-
024222,000803:                                                                                          	#       SULTS IN A ZERO RATE COMMAND.
024223,000804: 
024224,000805:                                                                                          	#       THE FDAI ERROR NEEDLES WILL INDICATE THE VALUE
024225,000806:                                                                                          	#       OF THE RATE COMMAND.
024226,000807: 
024227,000808:                                                                                          	# CALLING SEQUENCE
024228,000809: 
024229,000810:                                                                                          	#       DAPFIG +9D      TC      POSTJUMP
024230,000811:                                                                                          	#                       CADR    SATSTKON
024231,000812: 
024232,000813:                                                                                          	# SUBROUTINES CALLED
024233,000814: 
024234,000815:                                                                                          	#       ENDEXT
024235,000816:                                                                                          	#       IBNKCALL
024236,000817:                                                                                          	#       STICKCHK
024237,000818:                                                                                          	#       NEEDLER
024238,000819:                                                                                          	#       T5RUPT
024239,000820:                                                                                          	#       RESUME
024240,000821: 
024241,000822:                                                                                          	# ASTRONAUT REQUESTS
024242,000823: 
024243,000824:                                                                                          	#       ENTRY -  VERB 46 ENTER
024244,000825:                                                                                          	#                (CONDITION - BITS 13, 14 OF DAPDATR1 SET)
024245,000826: 
024246,000827:                                                                                          	#       EXIT -   VERB 48 ENTER  (FLASH V06N46)
024247,000828:                                                                                          	#                VERB 21 ENTER  AXXXX ENTER WHERE A=0 OR 1
024248,000829:                                                                                          	#                VERB 34 ENTER
024249,000830:                                                                                          	#                VERB 46 ENTER
024250,000831: 
024251,000832:                                                                                          	# NORMAL EXIT MODE
024252,000833: 
024253,000834:                                                                                          	#       VERB 46 ENTER   (SEE ASTRONAUT ABOVE)
024254,000835: 
024255,000836:                                                                                          	# ALARM OR ABORT EXIT MODES
024256,000837: 
024257,000838:                                                                                          	#       NONE
024258,000839: 
024259,000840:                                                                                          	# OUTPUT
024260,000841: 
024261,000842:                                                                                          	#       SATURN RATES IN CDUXCMD, CDUYCMD, CDUZCMD
024262,000843: 
024263,000844:                                                                                          	# ERASABLE INITIALIZATION
024264,000845: 
024265,000846:                                                                                          	#       DAPDATR1        (BITS 13, 14 MUST BE SET)
024266,000847: 
024267,000848:                                                                                          	# DEBRIS
024268,000849: 
024269,000850:                                                                                          	#       CENTRALS
024271,000852:                                                                                          	#       CDUXCMD, CDUYCMD, CDUZCMD
024272,000853: 
024273,000854: 43,3215                                           BANK     43                            	#
024274,000855: 43,2000                                           SETLOC   EXTVERBS                      	#
024275,000856: 43,2000                                           BANK                                   	#
024276,000857: 
024277,000858: 43,3215                                           COUNT    23/STTKE                      	#
024278,000859: 43,3215           00006        SATSTKON           EXTEND                                 	#
024279,000860: 43,3216           33233                           DCA      2REDOSAT                      	#
024280,000861: 43,3217           00004                           INHINT                                 	#

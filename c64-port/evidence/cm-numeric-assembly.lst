008206,000735:                                                                                          	# Page 196
008207,000736:                                                                                          	# PROGRAM NAME  V37                     ASSEMBLY        SUNDISK
008208,000737:                                                                                          	# LOG SECTION   FRESH START AND RESTART
008209,000738: 
008210,000739:                                                                                          	# FUNCTIONAL DESCRIPTION
008211,000740: 
008212,000741:                                                                                          	#       1. CHECK IF NEW PROGRAM ALLOWED.  IF BIT 1 OF FLAGWRD2(NODOFLAG) ISSET, AN ALARM 1520 IS CALLED.
008213,000742:                                                                                          	#       2. CHECK FOR VALIDITY OF PROGRAM SELECTED.  IF AN INVALID PROGRAM IS SELECTED, THE OPERATOR ERROR LIGHT IS
008214,000743:                                                                                          	#          SET AND CURRENT ACTIVITY, IF ANY, CONTINUES.
008215,000744:                                                                                          	#       3. SERVICER IS TERMINATED IF IT HAS BEEN RUNNING.
008216,000745:                                                                                          	#       4. INSTALL IS EXECUTED TO AVOID INTERRUPTING INTEGRATION.
008217,000746:                                                                                          	#       5. THE ENGINE IS TURNED OFF AND THE DAP IS INITIALIZED FOR COAST.
008218,000747:                                                                                          	#       6. TRACK, UPDATE AND TARG1 FLAGS ARE SET TO ZERO.
008219,000748:                                                                                          	#       7. DISPLAY SYSTEM IS RELEASED.
008220,000749:                                                                                          	#       8. THE FOLLOWING ARE PERFORMED FOR EACH OF THE THREE CASES.
008221,000750:                                                                                          	#          A. PROGRAM SELECTED IS P00.
008222,000751:                                                                                          	#             1. RENDEZVOUS FLAG IS RESET (KILL P20).
008223,000752:                                                                                          	#             2. STATINT1       IS SCHEDULED BY SETTING RESTART GROUP 2.
008224,000753:                                                                                          	#             3. MAJOR MODE 00 IS STORED IN THE MODE REGISTER(MODREG).
008225,000754:                                                                                          	#             4. SUPERBANK 3 IS SELECTED.
008226,000755:                                                                                          	#             5. NODOFLAG IS RESET.
008227,000756:                                                                                          	#             6. ALL RESTART GROUPS EXCEPT GROUP 2 ARE CLEARED.  CONTROL ISTRANSFERRED TO RESTART PROGRAM (GOPROG2)
008228,000757:                                                                                          	#                WHICH CAUSES ALL CURRENT ACTIVITY TO BE DISCONTINUED AND A 9 MINUTE INTEGRATION CYCLE TO BE
008229,000758:                                                                                          	#                INITIATED.
008230,000759:                                                                                          	#          B. PROGRAM SELECTES IS P20.
008231,000760:                                                                                          	#             1. IF THE CURRENT MAJOR MODE IS THE SAME AS THE SELECTED NEWPROGRAM.  THE PROGRAM IS RE-INITIALIZED
008232,000761:                                                                                          	#                VIA V37XEQ, ALL RESTART GROUPS, EXCEPT GROUP 4 ARE CLEARED.
008233,000762:                                                                                          	#             2. IF THE CURRENT MAJOR MODE IS NOT EQUAL TO THE NEW REQUEST, A CHECK IS MADE TO SEE IF THE REQUEST-
008234,000763:                                                                                          	#                ED MAJOR MODE HAS BEEN RUNNING THE BACKGROUND,
008235,000764:                                                                                          	#                AND IF IT HAS, NO NEW PROGRAM IS SCHEDULED, THE EXISTING
008236,000765:                                                                                          	#                P20 IS RESTARTED TO CONTINUE, AND ITS MAJOR MODE IS SET.
008237,000766:                                                                                          	#             3. CONTROL IS TRANSFERRED TO GOPROG2.
008238,000767:                                                                                          	#          C. PROGRAM SELECTED IS NEITHER P00 NOR P20
008239,000768:                                                                                          	#             1. V37XEQ IS SCHEDULED (AS A JOB) BY SETTING RESTART GROUP 4
008240,000769:                                                                                          	#             2. ALL CURRENT ACTIVITY EXCEPT RENDEZVOUS AND TRACKING IS DISCONTINUED BY CLEARING ALL RESTART
008241,000770:                                                                                          	#                GROUPS.  GROUP 2 IS CLEARED.  IF THE RENDEZVOUS FLAG IS ON P20 IS RESTARTED IN GOPROG2 VIA REDOP20,
008242,000771:                                                                                          	#                TO CONTINUE.
008243,000772: 
008244,000773:                                                                                          	# INPUT/OUTPUT INFORMATION
008245,000774: 
008246,000775:                                                                                          	#          A. CALLING SEQUENCE
008247,000776: 
008248,000777:                                                                                          	#               CONTROL IS DIRECTED TO V37 BY THE VERBFAN ROUTINE.
008249,000778:                                                                                          	#                       VERBFAN GOES TO C(VERBTAB+C(VERBREG)).  VERB 37 = MMCHANG.
008250,000779:                                                                                          	#                       MMCHANG EXECUTES A      TC POSTJUMP, CADR V37.
008251,000780: 
008252,000781:                                                                                          	#          B. ERASABLE INITIALIZATION           NONE
008253,000782: 
008254,000783:                                                                                          	#          C. OUTPUT
008255,000784:                                                                                          	#               MAJOR MODE CHANGE
008256,000785:                                                                                          	# Page 197
008257,000786: 
008258,000787:                                                                                          	#          D. DEBRIS
008259,000788:                                                                                          	#               MMNUMBER, MPAC +1, MINDEX, BASETEMP +C(MINDEX), FLAGWRD0, FLAGWRD1, FLAGWRD2, MODREG, GOLOC -1,
008260,000789:                                                                                          	#               GOLOC, GOLOC +1, GOLOC +2, BASETEMP, -PHASE2, PHASE2, -PHASE4
008261,000790: 

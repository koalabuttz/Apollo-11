053825,000020: 
053826,000021:                                                                                          	## This source code has been transcribed or otherwise adapted from digitized
053827,000022:                                                                                          	## images of a hardcopy from the MIT Museum.  The digitization was performed
053828,000023:                                                                                          	## by Paul Fjeld, and arranged for by Deborah Douglas of the Museum.  Many
053829,000024:                                                                                          	## thanks to both.  The images (with suitable reduction in storage size and
053830,000025:                                                                                          	## consequent reduction in image quality as well) are available online at
053831,000026:                                                                                          	## www.ibiblio.org/apollo.  If for some reason you find that the images are
053832,000027:                                                                                          	## illegible, contact me at info@sandroid.org about getting access to the
053833,000028:                                                                                          	## (much) higher-quality images which Paul actually created.
053834,000029:                                                                                          	##
053835,000030:                                                                                          	## Notations on the hardcopy document read, in part:
053836,000031:                                                                                          	##
053837,000032:                                                                                          	##      Assemble revision 055 of AGC program Comanche by NASA
053838,000033:                                                                                          	##      2021113-051.  10:28 APR. 1, 1969
053839,000034:                                                                                          	##
053840,000035:                                                                                          	##      This AGC program shall also be referred to as
053841,000036:                                                                                          	##                      Colossus 2A
053842,000037: 
053844,000039:                                                                                          	# SUBROUTINE TO CONVERT RAD VECTOR AT GIVEN TIME TO LAT,LONG AND ALT
053845,000040: 
053846,000041:                                                                                          	# CALLING SEQUENCE
053847,000042:                                                                                          	#       L-1     CALL
053848,000043:                                                                                          	#       L               LAT-LONG
053849,000044: 
053850,000045:                                                                                          	# SUBROUTINES USED
053851,000046:                                                                                          	#       R-TO-RP, ARCTAN, SETGAMMA, SETRE
053852,000047: 
053853,000048:                                                                                          	# ERASABLE INIT. REQ.
053854,000049:                                                                                          	#       AXO, -AYO, AZO, TEPHEM (SET AT LAUNCH TIME)
053855,000050:                                                                                          	#       ALPHAV = POSITION VECTOR METERS B-29
053856,000051:                                                                                          	#       MPAC -- TIME (CSECS B-28)
053857,000052:                                                                                          	#       ERADFLAG =1, TO COMPUTE EARTH RADIUS, =0 FOR FIXED EARTH RADIUS
053858,000053:                                                                                          	#       LUNAFLAG=0 FOR EARTH, 1 FOR MOON
053859,000054: 
053860,000055:                                                                                          	# OUTPUT
053861,000056:                                                                                          	#       LATITUDE IN LAT         (REVS. B-0)
053862,000057:                                                                                          	#       LONGITUDE IN LONG       (REVS. B-0)
053863,000058:                                                                                          	#       ALTITUDE IN ALT METERS  B-29
053864,000059: 
053865,000060: 30,3750                                           BANK     30                            	#
053866,000061: 13,2000                                           SETLOC   LATLONG                       	#
053867,000062: 13,2000                                           BANK                                   	#
053868,000063: 
053869,000064: 13,2370                                           COUNT    13/LT-LG                      	#
053870,000065: 
053871,000066: 13,2370  E4,1551                                  EBANK=   ALPHAV                        	#
053872,000067: 13,2370           40220        LAT-LONG           STQ      SETPD                         	#
053873,000068: 13,2371           02242                                    INCORPEX                      	#
053874,000069: 13,2372           00001                                    0D                            	#
053875,000070: 13,2373           24007                           STOVL    6D                            	# SAVE TIME IN 6-7D FOR R-TO-RP
053876,000071: 13,2374           02152                                    ALPHAV                        	#
053877,000072: 13,2375           51406                           PUSH     ABVAL                         	# 0-5D= R FOR R-TO-RP
053878,000073: 13,2376           16310                           STODL    ALPHAM                        	# ABS. VALUE OF R FOR ALT FORMULA BELOW
053879,000074: 13,2377           11566                                    ZEROVEC                       	# SET MPAC=0 FOR EARTH, NON-ZERO FOR MOON
053880,000075: 13,2400           71414                           BOFF     COS                           	# USE COS(0) TO GET NON-ZERO IN MPAC
053881,000076: 13,2401           01743                                    LUNAFLAG                      	# 0=EARTH, 1=MOON
053882,000077: 13,2402           26403                                    CALLRTRP                      	#
053883,000078: 13,2403           77624        CALLRTRP           CALL                                   	#
053884,000079: 13,2404           55371                                    R-TO-RP                       	# RP VECTOR CONVERTED FROM R B-29
053885,000080: 13,2405           77656                           UNIT                                   	# UNIT RP B-1
053886,000081: 13,2406           36152                           STCALL   ALPHAV                        	# U2= 1/2 SINL FOR SETRE SUBR BELOW
053887,000082: 13,2407           26571                                    SETGAMMA                      	#       SET GAMMA=B2/A2 FOR EARTH, =1 FOR MOON
053888,000083: 13,2410           77624                           CALL                                   	#       SCALED B-1
053889,000084: 13,2411           26601                                    SETRE                         	# CALC RE METERS B-29
053890,000085: 13,2412           63545                           DLOAD    DSQ                           	#
053891,000086: 13,2413           02152                                    ALPHAV                        	#
053892,000087: 13,2414           63525                           PDDL     DSQ                           	#
053893,000088: 13,2415           02154                                    ALPHAV     +2                 	#
053895,000090: 13,2416           75415                           DAD      SQRT                          	#
053896,000091: 13,2417           76405                           DMP      SL1R                          	#
053897,000092: 13,2420           00011                                    GAMRP                         	#
053898,000093: 13,2421           14021                           STODL    COSTH                         	# COS(LAT) B-1
053899,000094: 13,2422           02156                                    ALPHAV     +4                 	#
053900,000095: 13,2423           34023                           STCALL   SINTH                         	# SIN(LAT) B-1
053901,000096: 13,2424           26531                                    ARCTAN                        	#
053902,000097: 13,2425           15104                           STODL    LAT                           	# LAT B0
053903,000098: 13,2426           02152                                    ALPHAV                        	#
053904,000099: 13,2427           14021                           STODL    COSTH                         	# COS(LONG) B-1
053905,000100: 13,2430           02154                                    ALPHAV     +2                 	#
053906,000101: 13,2431           34023                           STCALL   SINTH                         	# SIN(LONG) B-1
053907,000102: 13,2432           26531                                    ARCTAN                        	#
053908,000103: 13,2433           15106                           STODL    LONG                          	# LONG. REVS B-0 IN RANGE -1/2 TO 1/2
053909,000104: 13,2434           02310                                    ALPHAM                        	#
053910,000105: 13,2435           77625                           DSU                                    	# ALT= R-RE METERS B-29
053911,000106: 13,2436           02241                                    ERADM                         	#
053912,000107: 13,2437           35110                           STCALL   ALT                           	# EXIT WITH ALT METERS B-29
053913,000108: 13,2440           02242                                    INCORPEX                      	#
053915,000110:                                                                                          	# SUBROUTINE TO CONVERT LAT,LONG,ALT AT GIVEN TIME TO RADIUS VECTOR
053916,000111: 
053917,000112:                                                                                          	# CALLING SEQUENCE
053918,000113:                                                                                          	#       L-1     CALL
053919,000114:                                                                                          	#       L               LALOTORV
053920,000115: 
053921,000116:                                                                                          	# SUBROUTINES USED
053922,000117:                                                                                          	#       SETGAMMA, SETRE, RP-TO-R
053923,000118: 
053924,000119:                                                                                          	# ERASABLE INIT. REQ.
053925,000120:                                                                                          	#       AXO, AYO, AZO, TEPHEM SET AT LAUNCH TIME
053926,000121:                                                                                          	#       LAT -- LATITUDE         (REVS B0)
053927,000122:                                                                                          	#       LONG -- LONGITUDE       (REVS B0)
053928,000123:                                                                                          	#       ALT -- ALTITUDE         (METERS) B-29
053929,000124:                                                                                          	#       MPAC -- TIME            (CSECS B-28)
053930,000125:                                                                                          	#       ERADFLAG =1 TO COMPUTE EARTH RADIUS, =0 FOR FIXED EARTH RADIUS
053931,000126:                                                                                          	#       LUNAFLAG=0 FOR EARTH, 1 FOR MOON
053932,000127: 
053933,000128:                                                                                          	# OUTPUT
053934,000129:                                                                                          	#       R-VECTOR IN ALPHAV      (METERS B-29)
053935,000130: 
053936,000131: 13,2441           40220        LALOTORV           STQ      SETPD                         	# LAT,LONG,ALT TO R VECTOR
053937,000132: 13,2442           02242                                    INCORPEX                      	#
053938,000133: 13,2443           00001                                    0D                            	#
053939,000134: 13,2444           34007                           STCALL   6D                            	#     6-7D = TIME FOR RP-TO-R
053940,000135: 13,2445           26571                                    SETGAMMA                      	#    GAMMA = B2/A2 FOR EARTH, 1 FOR MOON B-1
053941,000136: 13,2446           73545                           DLOAD    SIN                           	#           COS(LONG)COS(LAT) IN MPAC
053942,000137: 13,2447           01104                                    LAT                           	# UNIT  RP = SIN(LONG)COS(LAT)    2-3D
053943,000138: 13,2450           65275                           DMPR     PDDL                          	# PD 2      GAMMA*SIN(LAT)       0-1D
053944,000139: 13,2451           00011                                    GAMRP                         	#
053945,000140: 13,2452           01104                                    LAT                           	#     0-1D = GAMMA*SIN(LAT) B-2
053946,000141: 13,2453           65346                           COS      PDDL                          	# PD4 2-3D= COS(LAT) B-1 TEMPORARILY
053947,000142: 13,2454           01106                                    LONG                          	#
053948,000143: 13,2455           57356                           SIN      DMPR                          	# PD 2
053949,000144: 13,2456           71525                           PDDL     COS                           	# PD 4 2-3D= SIN(LONG)COS(LAT) B-2
053950,000145: 13,2457           01104                                    LAT                           	#
053951,000146: 13,2460           71525                           PDDL     COS                           	# PD 6 4-5D= COS(LAT) B-1 TEMPORARILY
053952,000147: 13,2461           01106                                    LONG                          	#
053953,000148: 13,2462           55475                           DMPR     VDEF                          	# PD4 MPAC = COS(LONG)COS(LAT) B-2
053954,000149: 13,2463           41456                           UNIT     PUSH                          	#     0-5D = UNIT RP FOR RP-TO-R SUBR.
053955,000150: 13,2464           36152                           STCALL   ALPHAV                        	# ALPHAV +4= SINL FOR SETRE SUBR.
053956,000151: 13,2465           26601                                    SETRE                         	# RE METERS B-29
053957,000152: 13,2466           43145                           DLOAD    BOFF                          	# SET MPAC = 0 FOR EARTH, NON-ZERO FOR MOON
053958,000153: 13,2467           11566                                    ZEROVEC                       	#
053959,000154: 13,2470           01743                                    LUNAFLAG                      	#
053960,000155: 13,2471           26473                                    CALLRPRT                      	#
053961,000156: 13,2472           77746                           COS                                    	# USE COS(0) TO GET NON-ZERO IN MPAC
053962,000157: 13,2473           77624        CALLRPRT           CALL                                   	#
053963,000158: 13,2474           55344                                    RP-TO-R                       	# EXIT WITH UNIT R VECTOR IN MPAC
053964,000159: 13,2475           16152                           STODL    ALPHAV                        	#
053965,000160: 13,2476           02241                                    ERADM                         	#
053967,000162: 13,2477           74215                           DAD      VXSC                          	# (RE + ALT)(UNIT R) METERS B-30
053968,000163: 13,2500           01110                                    ALT                           	#
053969,000164: 13,2501           02152                                    ALPHAV                        	#
053970,000165: 13,2502           77772                           VSL1                                   	# R METERS B-29
053971,000166: 13,2503           36152                           STCALL   ALPHAV                        	# EXIT WITH R IN METERS B-29
053972,000167: 13,2504           02242                                    INCORPEX                      	#
053973,000168: 
053974,000169:                                                                                          	# SUBROUTINE TO COMPUTE EARTH RADIUS
053975,000170: 
053976,000171:                                                                                          	# INPUT
053977,000172:                                                                                          	#       1/2 SIN LAT IN ALPHAV +4
053978,000173: 
053979,000174:                                                                                          	# OUTPUT
053980,000175:                                                                                          	#       EARTH RADIUS IN ERADM AND MPAC (METERS B-29)
053981,000176: 
053982,000177: 13,2505           63545        GETERAD            DLOAD    DSQ                           	#
053983,000178: 13,2506           02156                                    ALPHAV     +4                 	# SIN**2(L)
053984,000179: 13,2507           44352                           SL1      BDSU                          	#
053985,000180: 13,2510           11564                                    DP1/2                         	# COS**2(L)
053986,000181: 13,2511           44275                           DMPR     BDSU                          	#
053987,000182: 13,2512           26526                                    EE                            	#
053988,000183: 13,2513           11564                                    DP1/2                         	#
053989,000184: 13,2514           75465                           BDDV     SQRT                          	#
053990,000185: 13,2515           26522                                    B2XSC                         	#
053991,000186: 13,2516           77622                           SR4R                                   	#
053992,000187: 13,2517           02241                           STORE    ERADM                         	#
053993,000188: 13,2520           77616                           RVQ                                    	#
053994,000189: 
053995,000190:                                                                                          	# THE FOLLOWING CONSTANTS WERE COMPUTED WITH A=6378166, B=6356784 METERS
053996,000191:                                                                                          	# B2XSC = B**2 SCALED B-51
053997,000192:                                                                                          	# B2/A2 = B**2/A**2 SCALED B-1
053998,000193:                                                                                          	# EE = (1-B**2/A**2) SCALED B-0
053999,000194: 
054000,000195: 13,2521           00446 00305  B2XSC              2DEC     .0179450689                    	# B**2 SCALED B-51
054001,000196: 
054002,000197: 13,2523  04,3563               DP1/2              =        XUNIT                         	#
054003,000198: 13,2523           17711 05254  B2/A2              2DEC     .9933064884 B-1                	# GAMMA= B**2/A**2 B-1
054004,000199: 
054005,000200: 13,2525           00155 25250  EE                 2DEC     6.6935116  E-3                	# (1-B**2/A**2) B-0
054006,000201: 
054007,000202: 13,2527           00302 17755  ERAD               2DEC     6373338    B-29               	# PAD RADIUS
054008,000203: 
054010,000205:                                                                                          	# ARCTAN SUBROUTINE
054011,000206: 
054012,000207:                                                                                          	# CALLING SEQUENCE
054013,000208:                                                                                          	#       SIN THETA IN SINTH B-1
054014,000209:                                                                                          	#       COS THETA IN COSTH B-1
054015,000210:                                                                                          	#       CALL ARCTAN
054016,000211: 
054017,000212:                                                                                          	# OUTPUT
054018,000213:                                                                                          	#       ARCTAN THETA IN MPAC AND THETA B-0 IN RANGE -1/2 TO +1/2
054019,000214: 
054020,000215: 13,2531           77600        ARCTAN             BOV                                    	#
054021,000216: 13,2532           26533                                    CLROVFLW                      	#
054022,000217: 13,2533           63545        CLROVFLW           DLOAD    DSQ                           	#
054023,000218: 13,2534           00023                                    SINTH                         	#
054024,000219: 13,2535           63525                           PDDL     DSQ                           	#
054025,000220: 13,2536           00021                                    COSTH                         	#
054026,000221: 13,2537           77615                           DAD                                    	#
054027,000222: 13,2540           75454                           BZE      SQRT                          	#
054028,000223: 13,2541           26557                                    ARCTANXX                      	# ATAN=0/0  SET THETA=0
054029,000224: 13,2542           40065                           BDDV     BOV                           	#
054030,000225: 13,2543           00023                                    SINTH                         	#
054031,000226: 13,2544           26564                                    ATAN=90                       	#
054032,000227: 13,2545           67542                           SR1      ASIN                          	#
054033,000228: 13,2546           00025                           STORE    THETA                         	#
054034,000229: 13,2547           50125                           PDDL     BMN                           	#
054035,000230: 13,2550           00021                                    COSTH                         	#
054036,000231: 13,2551           26553                                    NEGCOS                        	#
054037,000232: 13,2552           43545                           DLOAD    RVQ                           	#
054038,000233: 13,2553           57545        NEGCOS             DLOAD    DCOMP                         	#
054039,000234: 13,2554           43244                           BPL      DAD                           	#
054040,000235: 13,2555           26561                                    NEGOUT                        	#
054041,000236: 13,2556           11564                                    DP1/2                         	#
054042,000237: 13,2557           00025        ARCTANXX           STORE    THETA                         	#
054043,000238: 13,2560           77616                           RVQ                                    	#
054044,000239: 
054045,000240: 13,2561           52025        NEGOUT             DSU      GOTO                          	#
054046,000241: 13,2562           11564                                    DP1/2                         	#
054047,000242: 13,2563           26557                                    ARCTANXX                      	#
054048,000243: 13,2564           75345        ATAN=90            DLOAD    SIGN                          	#
054049,000244: 13,2565           11612                                    LODP1/4                       	#
054050,000245: 13,2566           00023                                    SINTH                         	#
054051,000246: 13,2567           00025                           STORE    THETA                         	#
054052,000247: 13,2570           77616                           RVQ                                    	#
054053,000248: 
054054,000249: 13,2571  04,3565               2DZERO             =        DPZERO                        	#
054055,000250: 
054057,000252:                                                                                          	# ..... SETGAMMA SUBROUTINE .....
054058,000253:                                                                                          	# SUBROUTINE TO SET GAMMA FOR THE LAT-LONG AND LALOTORV SUBROUTINES
054059,000254: 
054060,000255:                                                                                          	# GAMMA = B**2/A**2 FOR EARTH (B-1)
054061,000256:                                                                                          	# GAMMA = 1 FOR MOON (B-1)
054062,000257: 
054063,000258:                                                                                          	# CALLING SEQUENCE
054064,000259:                                                                                          	#       L       CALL
054065,000260:                                                                                          	#       L+1             SETGAMMA
054066,000261: 
054067,000262:                                                                                          	# INPUT
054068,000263:                                                                                          	#       LUNAFLAG=0 FOR EARTH, =1 FOR MOON
054069,000264: 
054070,000265:                                                                                          	# OUTPUT
054071,000266:                                                                                          	#       GAMMA IN GAMRP (B-1)
054072,000267: 
054073,000268: 13,2571           43145        SETGAMMA           DLOAD    BOFF                          	# BRANCH FOR EARTH
054074,000269: 13,2572           26524                                    B2/A2                         	# EARTH GAMMA
054075,000270: 13,2573           01743                                    LUNAFLAG                      	#
054076,000271: 13,2574           26577                                    SETGMEX                       	#
054077,000272: 13,2575           77735                           SLOAD                                  	#
054078,000273: 13,2576           11564                                    1B1                           	# MOON GAMMA
054079,000274: 13,2577           00011        SETGMEX            STORE    GAMRP                         	#
054080,000275: 13,2600           77616                           RVQ                                    	#
054081,000276: 13,2601                        GAMRP              =        8D                            	#
054082,000277: 
054084,000279:                                                                                          	# ..... SETRE SUBROUTINE .....
054085,000280:                                                                                          	# SUBROUTINE TO SET RE (EARTH OR MOON RADIUS)
054086,000281: 
054087,000282:                                                                                          	#       RE = RM FOR MOON
054088,000283:                                                                                          	#       RE = RREF FOR FIXED EARTH RADIUS OR COMPUTED RF FOR FISCHER ELLIPSOID
054089,000284: 
054090,000285:                                                                                          	# CALLING SEQUENCE
054091,000286:                                                                                          	#       L       CALL
054092,000287:                                                                                          	#       L+1             SETRE
054093,000288: 
054094,000289:                                                                                          	# SUBROUTINES USED
054095,000290:                                                                                          	#       GETERAD
054096,000291: 
054097,000292:                                                                                          	# INPUT
054098,000293:                                                                                          	#       ERADFLAG = 0 FOR FIXED RE, 1 FOR COMPUTED RE
054099,000294:                                                                                          	#       ALPHAV +4 = 1/2 SINL IF GETERAD IS CALLED
054100,000295:                                                                                          	#       LUNAFLAG = 0 FOR EARTH, =1 FOR MOON
054101,000296: 
054102,000297:                                                                                          	# OUTPUT
054103,000298:                                                                                          	#       ERADM = 504RM FOR MOON (METERS B-29)
054104,000299:                                                                                          	#       ERADM = ERAD OR COMPUTED RF FOR EARTH (METERS B-29)
054105,000300: 
054106,000301: 13,2601           71220        SETRE              STQ      DLOAD                         	#
054107,000302: 13,2602           00051                                    SETREX                        	#
054108,000303: 13,2603           26626                                    504RM                         	#
054109,000304: 13,2604           71214                           BON      DLOAD                         	# BRANCH FOR MOON
054110,000305: 13,2605           01703                                    LUNAFLAG                      	#
054111,000306: 13,2606           26616                                    TSTRLSRM                      	#
054112,000307: 13,2607           26530                                    ERAD                          	#
054113,000308: 13,2610           45014                           BOFF     CALL                          	# ERADFLAG=0 FOR FIXED RE, 1 FOR COMPUTED
054114,000309: 13,2611           00742                                    ERADFLAG                      	#
054115,000310: 13,2612           26614                                    SETRXX                        	#
054116,000311: 13,2613           26505                                    GETERAD                       	#
054117,000312: 13,2614           36241        SETRXX             STCALL   ERADM                         	# EXIT WITH RE OR RM METERS B-29
054118,000313: 13,2615           00051                                    SETREX                        	#
054119,000314: 13,2616           77214        TSTRLSRM           BON      VLOAD                         	# ERADFLAG=0, SET R0=RLS
054120,000315: 13,2617           00702                                    ERADFLAG                      	#         =1      R0=RM
054121,000316: 13,2620           26614                                    SETRXX                        	#
054122,000317: 13,2621           02026                                    RLS                           	#
054123,000318: 13,2622           64446                           ABVAL    SR2R                          	# SCALE FROM B-27 TO B-29
054124,000319: 13,2623           77650                           GOTO                                   	#
054125,000320: 13,2624           26614                                    SETRXX                        	#
054126,000321: 13,2625  0000051               SETREX             =        S2                            	#
054127,000322: 13,2625           00065 01265  504RM              2DEC     1738090    B-29               	# METERS B-29 (MOON RADIUS)
054128,000323: 
054129,000324: 
054130,000325: 
054131,000326: 
(End of include-file LATITUDE_LONGITUDE_SUBROUTINES.agc, resuming MAIN.agc)

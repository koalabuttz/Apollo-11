011448,001251: 43,3123           01626                           ADRES    RRECTOTH                      	# LM STATE VECTOR INTO CM VIA GENTRAN
011449,001252: 43,3124           01554                           ADRES    RRECTHIS                      	#
011450,001253: 
011451,001254: 43,3125           13057                           TCF      TACHEXIT                      	#
011452,001255: 
011453,001256:                                                                                          	# VERB 94   DO R64 VIA ENEMA TO PICK UP IN P23.
011454,001257: 
011455,001258: 43,3126           35005        VERB94             CAF      V94FLBIT                      	#
011456,001259: 43,3127           70105                           MASK     FLAGWRD9                      	# IS V94FLAG SET
011458,001261: 43,3130           00006                           EXTEND                                 	#
011459,001262: 43,3131           12120                           BZF      ALM/END                       	# NO - OPERATOR ERROR
011460,001263: 
011461,001264: 43,3132           05560                           TC       DOWNFLAG                      	#
011462,001265: 43,3133           00213                           ADRES    V94FLAG                       	#
011463,001266: 
011464,001267: 43,3134           05364                           TC       CHECKMM                       	# IS IT P23
011465,001268: 43,3135           00027                           MM       23         B-14               	#
011466,001269: 43,3136           02120                           TC       ALM/END                       	# NO - OPERATOR ERROR
011467,001270: 43,3137           05412                           TC       PHASCHNG                      	#
011468,001271: 43,3140           00112                           OCT      112                           	# SET GROUP 2 TO DO R64
011469,001272: 
011470,001273: 43,3141           02710                           TC       CLEANOUT                      	# CAUSE RESTART
011471,001274: 
011472,001275:                                                                                          	# V90PERF       VERB 90         DESCRIPTION
011473,001276:                                                                                          	#       REQUEST RENDEZVOUS OUT-OF-PLANE DISPLAY (R36)
011474,001277: 
011475,001278:                                                                                          	#       1.      SET EXT VERB DISPLAY BUSY FLAG.
011476,001279:                                                                                          	#       2.      SCHEDULE R36 CALL WITH PRIORITY 10
011477,001280:                                                                                          	#               A.      DISPLAY
011478,001281:                                                                                          	#                       TIME OF EVENT - HOURS, MINUTES, SECONDS
011479,001282:                                                                                          	#                       Y       OUT-OF-PLANE POSITION - NAUTICAL MILES
011480,001283:                                                                                          	#                       YDOT    OUT-OF-PLANE VELOCITY - FEET/SECOND
011481,001284:                                                                                          	#                       PSI     ANGLE BTW LINE OF SIGHT AND FORWARD
011482,001285:                                                                                          	#                               DIRECTION VECTOR IN HORIZONTAL PLANE - DEGREES
011483,001286: 
011484,001287: 43,3142           02076        V90PERF            TC       TESTXACT                      	#
011485,001288: 43,3143           35063                           CAF      PRIO7                         	# R36.V90

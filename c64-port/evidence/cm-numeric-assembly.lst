043058,000033:                                                                                          	## Notations on the hardcopy document read, in part:
043059,000034:                                                                                          	##
043060,000035:                                                                                          	##      Assemble revision 055 of AGC program Comanche by NASA
043061,000036:                                                                                          	##      2021113-051.  10:28 APR. 1, 1969  
043062,000037:                                                                                          	##
043063,000038:                                                                                          	##      This AGC program shall also be referred to as
043064,000039:                                                                                          	##                      Colossus 2A
043065,000040: 
043067,000042:                                                                                          	# PROGRAM NAME....TVCDAP, CONSISTING OF PITCHDAP, YAWDAP, ETC.
043068,000043:                                                                                          	# LOG SECTION...TVCDAPS                 SUBROUTINE...DAPCSM
043069,000044:                                                                                          	# MODIFIED BY SCHLUNDT                          21 OCTOBER 1968
043070,000045: 
043071,000046:                                                                                          	# FUNCTIONAL DESCRIPTION....
043072,000047: 
043073,000048:                                                                                          	#       SELF-PERPETUATING T5 TASKS WHICH GENERATE THE COMMAND SIGNALS
043074,000049:                                                                                          	#       FOR THE PITCH AND YAW SPS GIMBAL ACTUATORS DURING TVC (SPS) BURNS,
043075,000050:                                                                                          	#       IN RESPONSE TO BODY-AXIS RATE COMMANDS FROM CROSS-PRODUCT STEERING
043076,000051:                                                                                          	#       (S40.8).  IF NO STEERING (IMPULSIVE BURNS) MAINTAINS ATTITUDE-HOLD
043077,000052:                                                                                          	#       ABOUT THE REFERENCE (INITIAL) DIRECTIONS (ZERO RATE COMMANDS).
043078,000053: 
043079,000054:                                                                                          	#       THE PITCH AND YAW LOOPS ARE SEPARATE, BUT STRUCTURED IDENTICALLY.
043080,000055:                                                                                          	#       EACH ATTITUDE-RATE LOOP INCLUDES GIMBAL ANGLE RATE DERIVATION,
043081,000056:                                                                                          	#       GIMBAL/BODY AXIS TRANSFORMATION, BODY-AXIS ATTITUDE ERROR
043082,000057:                                                                                          	#       INTEGRATION WITH ERROR LIMITING, THE GENERALIZED 6TH-ORDER FILTER
043083,000058:                                                                                          	#       FOR CSM OR CSM/LM OPERATION, A FILTER OUTPUT LIMITER,
043084,000059:                                                                                          	#       CG-OFFSET TRACKER FILTER, AND THE CG-TRACKER MINOR LOOP.
043085,000060: 
043086,000061:                                                                                          	#       THE DAPS ARE CYCLIC, CALLING EACH OTHER AT 1/2 THE DAP SAMPLE
043087,000062:                                                                                          	#       TIME, AS DETERMINED BY T5TVCDT.  THE ACTUATOR COMMANDS ARE
043088,000063:                                                                                          	#       REGENERATED AS ANALOG VOLTAGES BY THE OPTICS ERROR COUNTERS, WHICH
043089,000064:                                                                                          	#       TRANSMIT THE SIGNAL TO THE ACTUATOR SERVOS WHEN THERE IS PROPER CDU
043090,000065:                                                                                          	#       MODING.
043091,000066: 
043092,000067:                                                                                          	# CALLING SEQUENCE.... (TYPICALLY)
043093,000068: 
043094,000069:                                                                                          	#       T5 CALL OF TVCDAPON (TVCINITIALIZE) BY DOTVCON (P40)
043095,000070:                                                                                          	#       T5 CALL OF DAPINIT (TVCDAPS) BY TVCINIT4 (TVCINITIALIZE)
043096,000071:                                                                                          	#       T5 CALL OF PITCHDAP BY DAPINIT
043097,000072:                                                                                          	#       T5 CALL OF YAWDAP BY PITCHDAP
043098,000073:                                                                                          	#       T5 CALL OF PITCHDAP BY YAWDAP
043099,000074:                                                                                          	#               ETC.
043100,000075:                                                                                          	#       (AUTOMATIC SEQUENCING FROM TVCDAPON)
043101,000076: 
043102,000077:                                                                                          	# NORMAL EXIT MODE....RESUME
043103,000078: 
043104,000079:                                                                                          	# ALARM OR ABORT EXIT MODES....NONE
043105,000080: 
043106,000081:                                                                                          	# SUBROUTINES CALLED....
043107,000082: 
043108,000083:                                                                                          	#       HACK FOR STROKE TEST (V68) WAVEFORM GENERATION
043109,000084:                                                                                          	#       PCOPY, YCOPY FOR COPY-CYCLES (USED ALSO BY TVC RESTART PACKAGE)
043110,000085:                                                                                          	#       DAPINIT FOR INITIAL CDUS FOR RATE MEASUREMENTS
043111,000086:                                                                                          	#       ERRORLIM, ACTLIM FOR INPUT (ATTITUDE-ERROR INTEGRATION) AND
043112,000087:                                                                                          	#               OUTPUT (ACTUATOR COMMAND) LIMITING, COMMON TO PITCH AND
043113,000088:                                                                                          	#               YAW DAPS
043114,000089:                                                                                          	#       FWDFLTR (INCLUDING OPTVARK) AND PRECOMP, TO COMPUTE FILTER
043115,000090:                                                                                          	#               OUTPUTS AND STORAGE VALUES
043116,000091:                                                                                          	#       RESUME
043117,000092: 
043119,000094:                                                                                          	# OTHER INTERFACES....
043120,000095: 
043121,000096:                                                                                          	#       S40.8 CROSS-PRODUCT STEERING FOR BODY AXIS RATE COMMANDS OMEGAY,ZC
043122,000097:                                                                                          	#       S40.15 FOR THE INITIAL DAP GAINS VARK AND 1/CONACC
043123,000098:                                                                                          	#       TVCEXECUTIVE FOR DAP GAIN UPDATES AND TMC LOOP OPERATIONS
043124,000099:                                                                                          	#       TVCRESTART PACKAGE FOR TVC RESTART PROTECTION.
043125,000100: 
043126,000101:                                                                                          	# ERASABLE INITIALIZATION REQUIRED....
043127,000102: 
043128,000103:                                                                                          	#       PAD-LOAD ERASABLES (SEE ERASABLE ASSIGNMENTS)
043129,000104:                                                                                          	#       CONFIGURATION BITS (14, 13) OF DAPDATR1 AS IN R03
043130,000105:                                                                                          	#       ENGINE-ON BIT (11.13) FOR RESTARTS
043131,000106:                                                                                          	#       TVCPHASE FOR RESTARTS (SEE DOTVCON, AND TVCINIT4)
043132,000107:                                                                                          	#       T5 BITS (15,14 OF FLAGWRD6) FOR RESTARTS
043133,000108:                                                                                          	#       MISCELLANEOUS VARIABLES SET UP OR COMPUTED BY TVCDAPON....TVCINIT4,
043134,000109:                                                                                          	#               INCLUDING THE ZEROING OF TEMPORARIES BY MRCLEAN
043135,000110:                                                                                          	#       CDUX,Y,Z AND SINCDUX.... COSCDUZ AS PREPARED BY QUICTRIG (WITH
043136,000111:                                                                                          	#               UPDATES EVERY 1/2 SECOND)
043137,000112:                                                                                          	#       ALSO G+N PRIMARY, TVC ENABLE, AND OPTICS ERROR COUNTER ENABLE
043138,000113:                                                                                          	#               UNLESS BENCH-TESTING.
043139,000114: 
043140,000115:                                                                                          	# OUTPUT....
043141,000116: 
043142,000117:                                                                                          	#       TVCPITCH AND TVCYAW WITH COUNTER RELEASE (11.14 AND 11.13 INCREMEN-
043143,000118:                                                                                          	#               TAL COMMANDS TO OPTICS ERROR COUNTERS), FILTER NODES, BODY-
043144,000119:                                                                                          	#               AXIS ATTITUDE ERROR INTEGRATOR, TOTAL ACTUATOR COMMANDS,
043145,000120:                                                                                          	#               OFFSET-TRACKER-FILTER OUTPUTS, ETC.
043146,000121: 
043147,000122:                                                                                          	# DEBRIS....
043148,000123: 
043149,000124:                                                                                          	#       MUCH, SHAREABLE WITH RCS/ENTRY, IN EBANK6 ONLY
043150,000125: 
043151,000126: 17,2552                                           BANK     17                            	#
043152,000127: 20,2000                                           SETLOC   DAPS2                         	#
043153,000128: 20,2000                                           BANK                                   	#
043154,000129: 
043155,000130: 20,2530  E6,1702                                  EBANK=   BZERO                         	#
043156,000131: 
043157,000132: 20,2530                                           COUNT*   $$/DAPS                       	#
043158,000133: 

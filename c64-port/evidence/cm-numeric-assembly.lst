034523,001640:                                                                                          	# PROGRAM DESCRIPTION - R53 - SIGHTING MARK ROUTINE
034524,001641:                                                                                          	# MOD. NO. 2  21 DEC 66
034525,001642:                                                                                          	# MOD BY STURLAUGSON
034526,001643: 
034527,001644:                                                                                          	# FUNCTIONAL DESCRIPTION
034528,001645: 
034529,001646:                                                                                          	#       TO PERFORM A SATISFACTORY NUMBER OF SIGHTING MARKS FOR THE REQUESTING PROGRAM (OR ROUTINE).  SIGHTINGS
034530,001647:                                                                                          	#       CAN BE MADE ON A STAR OR LANDMARK.  WHEN THE CMC ACCEPTS A MARK IT RECORDS AND STORES 5 ANGLES (3 ICDUS AND 2
034531,001648:                                                                                          	#       OCDUS) AND THE TIME OF THE MARK.
034532,001649: 
034533,001650:                                                                                          	# CALLING SEQUENCE
034534,001651: 
034535,001652:                                                                                          	#       R53 IS CALLED AND RETURNS IN INTERPRETIVE CODE.  RETURN IS VIA QPRET.
034536,001653:                                                                                          	#       THERE IS NO ERROR EXIT IN THIS ROUTINE ITSELF.
034537,001654: 
034538,001655:                                                                                          	# SUBROUTINES CALLED
034539,001656:                                                                                          	#       
034540,001657:                                                                                          	#       SXTMARK
034541,001658:                                                                                          	#       OPTSTALL
034542,001659:                                                                                          	#       GOFLASH
034543,001660: 
034544,001661:                                                                                          	# ERASABLE INITIALIZATION
034545,001662: 
034546,001663:                                                                                          	#       TARGET FLAG - STAR OR LANDMARK
034547,001664:                                                                                          	#       MARKINDX - NUMBER OF MARKS WANTED
034548,001665:                                                                                          	#       STARIND - INDEX TO BESTI OR BESTJ (STAR NUMBER)
034549,001666: 
034550,001667:                                                                                          	# OUTPUT
034551,001668: 
034552,001669:                                                                                          	#       MARKSTAT CONTAINS INDEX TO VACANT AREA WHERE MARK DATA IS STORED
034553,001670:                                                                                          	#       BESTI (INDEXED BY STARIND) CONTAINS STAR NUMBER SIGHTED
034554,001671: 
034555,001672:                                                                                          	# DEBRIS
034556,001673: 
034557,001674:                                                                                          	#       MARKINDX CONTAINS NUMBER OF MARKS DESIRED

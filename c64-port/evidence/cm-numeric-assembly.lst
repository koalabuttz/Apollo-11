024966,000049: 
024968,000051:                                                                                          	# RENDEZVOUS NAVIGATION PROGRAM 20
024969,000052: 
024970,000053:                                                                                          	# PROGRAM DESCRIPTION
024971,000054: 
024972,000055:                                                                                          	#       MOD NO -1
024973,000056:                                                                                          	#       MOD BY - N.BRODEUR
024974,000057: 
024975,000058:                                                                                          	# FUNCTIONAL DESCRIPTION
024976,000059: 
024977,000060:                                                                                          	#       TO CONTROL THE CSM ATTITUDE AND OPTICS TO ACQUIRE THE LEM IN THE S+T
024978,000061:                                                                                          	#       FIELD AND TO POINT THE CSM TRANSPONDER AT THE LEM.  TO UPDATE EITHER THE
024979,000062:                                                                                          	#       LEM OR CSM STATE VECTOR (AS SPECIFIED BY THE ASTRONAUT BY THE DSKY
024980,000063:                                                                                          	#       ENTRY) ON THE BASIS OF OPTICAL TRACKING DATA (REQUESTED BY DSKY)
024981,000064: 
024982,000065:                                                                                          	# CALLING SEQUENCE -
024983,000066: 
024984,000067:                                                                                          	#       ASTRONAUT REQUEST THROUGH DSKY V37E20E
024985,000068: 
024986,000069:                                                                                          	# SUBROUTINES CALLED-
024987,000070: 
024988,000071:                                                                                          	#       R02BOTH (IMU STATUS CHECK)                              BANKCALL
024989,000072:                                                                                          	#       FLAGUP                          2PHSCHNG                LOADTIME
024990,000073:                                                                                          	#       R61CSM (PREFERRED TRACKING ATTITUDE)                    FLAGDOWN
024991,000074:                                                                                          	#       R52 (AUTO OPTICS POSITIONING ROUT)                      SETINTG
024992,000075:                                                                                          	#       R22 (REND TRACK DATA PROC ROUT)                         PRIOCHNG
024993,000076:                                                                                          	#       ENDOFJOB                        INTEGRV                 GRP2PC
024994,000077:                                                                                          	#       INTPRET                         MKRLEES                 FINDVAC
024995,000078: 
024996,000079:                                                                                          	# NORMAL EXIT MODES -
024997,000080: 
024998,000081:                                                                                          	#       P20 MAY BE TERMINATED IN TWO WAYS-ASTRONAUT SELECTION OF IDLING
024999,000082:                                                                                          	#       PROGRAM (P00) BY KEYING V37E00E OR BY KEYING IN V56E
025000,000083: 
025001,000084:                                                                                          	# ALARM OR ABORT EXIT MODES -
025002,000085: 
025003,000086:                                                                                          	#       NONE DIRECTLY FROM P20
025004,000087: 
025005,000088:                                                                                          	# OUTPUT
025006,000089: 
025007,000090:                                                                                          	#       TRKMKCNT = NO OF RENDEZVOUS TRACKING MARKS TAKEN (COUNTER)
025008,000091:                                                                                          	#       VHFCNT = NO OF VHF RANGING MARKS INCORPORATED (COUNTER)
025009,000092: 
025010,000093:                                                                                          	# FLAGS SET + RESET
025011,000094: 
025012,000095:                                                                                          	#       RNDVZFLG,VEHUPFLG,UPDATFLG,TRACKFLG,TARG1FLG
025013,000096:                                                                                          	#       HOLDFLAG,WBODY,WBODY1,WBODY2,DELCDUX,DELCDUY,DELCDUZ
025014,000097:                                                                                          	#       STIKFLAG,PRFTRKAT,VINTFLAG,DIM0FLAG,R60FLAG,R61CNTR

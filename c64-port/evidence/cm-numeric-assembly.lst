011255,001058:                                                                                          	# VERB 89       DESCRIPTION     RENDEZVOUS FINAL ATTITUDE ROUTINE (R63)
011256,001059:                                                                                          	# 
011257,001060:                                                                                          	# CALLED BY VERB 89 ENTER DURING P00.  PRIO 10 USED. CALCULATES AND
011258,001061:                                                                                          	# DISPLAYS FINAL GIMBAL ANGLES TO POINT CSM +X AXIS OR PREFERRED AXIS
011259,001062:                                                                                          	# (UNIT(Z)COS55 DEG + UNIT(X)SIN55 DEG) AT LM.
011260,001063: 
011261,001064:                                                                                          	# 1. KEY IN V 89 E ONLY IF IN PROG 00.  IF NOT IN P00, OPERATOR ERROR AND
011262,001065:                                                                                          	# EXIT R63, OTHERWISE CONTINUE.
011263,001066: 
011264,001067:                                                                                          	# 2. IF IN P00, DO IMU STATUS CHECK (R02BOTH).  IF IMU ON AND ITS
011265,001068:                                                                                          	# ORIENTATION KNOWN TO CGC, CONTINUE.
011266,001069: 
011267,001070:                                                                                          	# 3. FLASH DISPLAY V 04 N 06.  R2 INDICATES WHICH SPACECRAFT AXIS IS TO
011268,001071:                                                                                          	# BE POINTED AT LM.  INITIAL CHOICE IS PREFERRED AXIS. (R2=1).
011269,001072:                                                                                          	# ASTRONAUT CAN CHANGE TO (+X) AXIS (R2 NOT = 1) BY V 22 E 2 E.  CONTINUE
011270,001073:                                                                                          	# AFTER KEYING IN PROCEED.
011271,001074: 
011272,001075:                                                                                          	# 4. SET PREFERRED ATTITUDE FLAG ACCORDING TO OPTION DESIRED.  SET FLAG
011273,001076:                                                                                          	# FOR PREFERRED AXIS.  RESET FLAG FOR X AXIS.
011274,001077: 
011275,001078:                                                                                          	# 5. CURRENT TIME IS STORED AND R63COMP IS CALLED
011276,001079: 
011277,001080:                                                                                          	#       R63COMP JOB:
011278,001081: 
011279,001082:                                                                                          	#               UPDATES CSM AND LM STATE VECTORS USING CONIC EQUATIONS
011280,001083: 
011281,001084:                                                                                          	#               CALCULATES BOTH PREFERRED AND X AXIS TRACKING ATT FROM CSM TO LM.
011282,001085: 
011283,001086:                                                                                          	#               DESIRED GIMBAL ANGLES AS INDICATED BY PREFERRED ATTITUDE FLAG
011284,001087:                                                                                          	#               ARE STORED FOR LATER R60CSM CALL.
011285,001088: 
011286,001089:                                                                                          	# 6.  FLASH DISPLAY V 06 N18 AND AWAIT RESPONSE.
011287,001090: 
011288,001091:                                                                                          	# 7.  RECYCLE-  RETURN TO STEP 5.
011289,001092:                                                                                          	#     TERMINATE-  EXIT R63 ROUTINE
011290,001093:                                                                                          	#     PROCEED-  RESET 3AXISFLG AND CALL R60CSM FOR ATTITUDE MANEUVER.
011291,001094: 
011292,001095: 43,2745           02730        V89PERF            TC       CHKPOOH                       	# DEMAND P00
011293,001096: 43,2746           02076                           TC       TESTXACT                      	#
011294,001097: 43,2747           00004                           INHINT                                 	#
011295,001098: 43,2750           35003                           CAF      PRIO10                        	#
011296,001099: 43,2751           05147                           TC       FINDVAC                       	#
011297,001100: 43,2752  E4,1715                                  EBANK=   P21TIME                       	#
011298,001101: 43,2752           03712 70064                     2CADR    V89CALL                       	#
011299,001102: 
011300,001103: 43,2754           15217                           TCF      ENDOFJOB                      	#
011301,001104: 
011302,001105: 43,2755           05560        WMATRXNG           TC       DOWNFLAG                      	# RESET RENDWFLG
011303,001106: 43,2756           00131                           ADRES    RENDWFLG                      	#
011305,001108: 
011306,001109: 43,2757           05560                           TC       DOWNFLAG                      	# RESET ORBWFLAG
011307,001110: 43,2760           00066                           ADRES    ORBWFLAG                      	#
011308,001111: 43,2761           02121                           TC       GOPIN                         	#
011309,001112: 
011310,001113: 43,2762  43,2762               GOSHOSUM           EQUALS   SHOWSUM                       	#
011311,001114: 
011312,001115: 43,2762           02730        SHOWSUM            TC       CHKPOOH                       	#
011313,001116: 43,2763           02076                           TC       TESTXACT                      	# *
011314,001117: 43,2764           35017                           CAF      S+1                           	# *
011315,001118: 43,2765           55376                           TS       SKEEP6                        	# * SHOWSUM OPTION
011316,001119: 43,2766           35021                           CAF      S+ZERO                        	# *
011317,001120: 43,2767           55362                           TS       SMODE                         	# * TURN OFF SELF-CHECK
011318,001121: 43,2770           33247                           CA       SELFADRS                      	# *
011319,001122: 43,2771           55361                           TS       SELFRET                       	# *
011320,001123: 43,2772           03524                           TC       STSHOSUM                      	# * ENTER ROPECHK
011321,001124: 
011322,001125: 43,2773           23372        SDISPLAY           LXCH     SKEEP2                        	# * BNK NO FOR DSP
011323,001126: 43,2774           23373                           LXCH     SKEEP3                        	# * BUGGER WORD FOR DSP
011324,001127: 43,2775           33246        NOKILL             CA       ADRS1                         	# *
011325,001128: 43,2776           54156                           TS       MPAC       +2                 	# *
011326,001129: 43,2777           33010                           CA       VNCON                         	# * 0501
011327,001130: 43,3000           04662                           TC       BANKCALL                      	# *
011328,001131: 43,3001           20561                           CADR     GOXDSPF                       	# *
011329,001132: 43,3002           03005                           TC       +3                            	# *
011330,001133: 43,3003           03635                           TC       NXTBNK                        	# *
011331,001134: 43,3004           02775                           TC       NOKILL                        	# *
011332,001135: 43,3005           33247                           CA       SELFADRS                      	#
011333,001136: 43,3006           55371                           TS       SKEEP1                        	#
011334,001137: 
011335,001138: 43,3007           05534                           TC       ENDEXT                        	# *
011336,001139: 
011337,001140: 43,3010           01201        VNCON              VN       501                           	# *
011338,001141: 
011339,001142: 43,3011           31376        ENDSUMS            CA       SKEEP6                        	# *
011340,001143: 43,3012           00006                           EXTEND                                 	# *
011341,001144: 43,3013           13340                           BZF      SELFCHK                       	# * ROPECHK, START SELFCHK AGAIN.
011342,001145: 43,3014           03524                           TC       STSHOSUM                      	# * START SHOWSUM AGAIN.
011343,001146: 
011344,001147: 
011345,001148:                                                                                          	# VB 76   SET PREFERRED ATTITUDE FLAG - DRIVE TO PREFERRED.
011346,001149: 
011347,001150: 43,3015           05546        SETPRFLG           TC       UPFLAG                        	#
011348,001151: 43,3016           00120                           ADRES    PRFTRKAT                      	# BIT 10 FLAG 5
011349,001152: 43,3017           02121                           TC       GOPIN                         	#
011350,001153: 
011351,001154:                                                                                          	# VB 77  RESET PREFERRED ATTITUDE FLAG - DRIVE TO +X-AXIS ATT.
011352,001155: 
011353,001156: 43,3020           05560        RESETPRF           TC       DOWNFLAG                      	#
011354,001157: 43,3021           00120                           ADRES    PRFTRKAT                      	# BIT 10 FLAG 5
011355,001158: 43,3022           02121                           TC       GOPIN                         	#
011356,001159: 
011358,001161:                                                                                          	# VB 87   SET VHF RANGE FLAG - ALLOWS R22 TO ACCEPT RANGE DATA.
011359,001162: 
011360,001163: 43,3023           06006        SETVHFLG           TC       INTPRET                       	#
011361,001164: 43,3024           77414                           SET      EXIT                          	#
011362,001165: 43,3025           04466                                    VHFRFLAG                      	#
011363,001166: 43,3026           02121                           TC       GOPIN                         	#
011364,001167: 

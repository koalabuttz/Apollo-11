021553,001293:                                                                                          	# ..... MIDGIM .....
021554,001294:                                                                                          	# MOD NO. 0, BY WILLMAN, SUBROUTINE RENDGUID, LOG P34-P35, P74-P75
021555,001295:                                                                                          	# REVISION 03, 17 FEB 67
021556,001296: 
021557,001297:                                                                                          	# IF THE ACTIVE VEHICLE IS DOING THE COMPUTATION, MIDGIM COMPUTES
021558,001298:                                                                                          	# THE POSITIVE MIDDLE GIMBAL ANGLE OF THE ACTIVE VEHICLE TO THE INPUT
021559,001299:                                                                                          	# DELTA VELOCITY VECTOR (0D IN PUSH LIST), OTHERWISE
021560,001300:                                                                                          	# MIDGIM CONVERTS THE INPUT DELTA VELOCITY VECTOR FROM INERTIAL COORDIN-
021561,001301:                                                                                          	# ATES TO LOCAL VERTICAL COORDINATES OF THE ACTIVE VEHICLE.
021562,001302: 
021563,001303:                                                                                          	# .. INPUTS ..
021564,001304:                                                                                          	#   NAME     MEANING                                            UNITS/SCALING/MODE
021565,001305:                                                                                          	#   AVFLAG   INT FLAG - 0 IS CSM ACTIVE, 1 IS LEM ACTIVE        BIT
021566,001306:                                                                                          	#   COMPUTER INT FLAG - 0 IS LEM COMPUTER, 1 IS CSM COMPUTER    BIT
021567,001307:                                                                                          	#   RINIT    ACTIVE VEHICLE RADIUS VECTOR                       METERS/CSEC (+7) VT
021568,001308:                                                                                          	#   VINIT    ACTIVE VEHICLE VELOCITY VECTOR                     METERS/CSEC (+7) VT
021569,001309:                                                                                          	#   0D(PL)   ACTIVE VEHICLE DELTA VELOCITY VECTOR               METERS/CSEC (+7) VT
021570,001310: 
021571,001311:                                                                                          	# .. OUTPUTS ..
021572,001312:                                                                                          	#   NAME     MEANING                                            UNITS/SCALING/MODE
021573,001313:                                                                                          	#   +MGA     + MIDDLE GIMBAL ANGLE                              REVOLUTIONS (+0) DP
021574,001314:                                                                                          	#   DELVLVC  DELTA VELOCITY VECTOR IN LV COORD.                 METERS/CSEC (+7) VT
021575,001315:                                                                                          	#   MGLVFLAG INT FLAG - 0 IS +MGA COMPUTED, 1 IS DELVLVC COMP.        -         BIT
021576,001316: 
021577,001317:                                                                                          	# .. CALLING SEQUENCE ..
021578,001318:                                                                                          	#       L       CALL
021579,001319:                                                                                          	#       L+1             MIDGIM
021580,001320:                                                                                          	#       L+2     (RETURN - ALWAYS)
021581,001321: 
021582,001322:                                                                                          	# .. NO SUBROUTINES CALLED ..
021583,001323: 
021584,001324:                                                                                          	# .. DEBRIS - ERASEABLE TEMPORARY USAGE 
021585,001325:                                                                                          	#       A,Q,L, PUSH LIST, MPAC.
021586,001326: 
021587,001327:                                                                                          	# .. ALARMS - NONE ..
021588,001328: 
021590,001330:                                                                                          	# MIDDLE GIMBAL ANGLE COMPUTATION.
021591,001331: 04,2000                                           SETLOC   MIDDGIM                       	#
021592,001332: 04,2000                                           BANK                                   	#
021593,001333: 
021594,001334: 04,2645                                           COUNT*   $$/MIDG                       	#
021595,001335: 
021596,001336: 04,2645           20000 00000  HALFREV            2DEC     1          B-1                	#
021597,001337: 
021598,001338: 04,2647           43014        MIDGIM             BON      BOFF                          	#
021599,001339: 04,2650           01312                                    AVFLAG                        	#
021600,001340: 04,2651           10667                                    MIDGIM1                       	#
021601,001341: 04,2652           02747                                    COMPUTER                      	#
021602,001342: 04,2653           10672                                    GET.LVC                       	#
021603,001343: 

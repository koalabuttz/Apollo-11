008751,001280: 04,2445           11303                           FCADR    P32                           	#
008752,001281: 04,2446           73337                           FCADR    P31                           	#
008753,001282: 04,2447           73323                           FCADR    P30                           	#
008754,001283: 04,2450           62403                           FCADR    P23                           	#
008755,001284: 04,2451           60000                           FCADR    PROG22                        	#
008756,001285: 04,2452           76001                           FCADR    PROG21                        	#
008757,001286: 04,2453           76261                           FCADR    PROG20                        	#
008758,001287: 04,2454           73151                           FCADR    P17                           	#
008759,001288: 04,2455           55660                           FCADR    P06                           	#
008760,001289: 04,2456           66001                           FCADR    GTSCPSS1                      	# GYROCOMPASS STANDARD LEAD IN.
008761,001290: 
008762,001291:                                                                                          	# THE PREMM TABLE CONTAINS THE E-BANK,MAJOR MODE, AND PRIORITY
008763,001292:                                                                                          	# INFORMATION, IT IS IN THE FOLLOWING FORM,
008764,001293: 
008765,001294:                                                                                          	#       PPP PPE EEM MMM MMM
008766,001295: 
008767,001296:                                                                                          	# Page 207
008768,001297:                                                                                          	#       WHERE THE 7 M BITS CONTAIN THE MAJOR MODE NUMBER
008769,001298:                                                                                          	#                  3 E BITS CONTAIN THE E-BANK NUMBER
008770,001299:                                                                                          	#                  5 P BITS CONTAIN THE PRIORITY AT WHICH THE JOB IS
008771,001300:                                                                                          	#                       TO BE STARTED
008772,001301: 
008773,001302:                                                                                          	#       FOR EXAMPLE,
008774,001303: 
008775,001304:                                                                                          	#               PREMM1          OCT     67213           # PRIORITY      33
008776,001305:                                                                                          	#                                                       # E-BANK         5
008777,001306:                                                                                          	#                                                       # MAJOR MODE    11
008778,001307:                                                                                          	#                               OCT     25437           # PRIORITY       12
008779,001308:                                                                                          	#                                                       # E-BANK         6
008780,001309:                                                                                          	#                                                       # MAJOR MODE    31
008781,001310: 
008782,001311: 04,2457                        PREMM1             EQUALS                                 	#
008783,001312: 04,2457           27117                           OCT      27117                         	# MM 79         EBANK 4         PRIO 13
008784,001313: 04,2460           27116                           OCT      27116                         	# MM 78         EBANK 4         PR23 13
008785,001314: 04,2461           27115                           OCT      27115                         	# MM 77         EBANK 4         PRIO 13

004916,003281: E6,1541  E6,1670               D21                EQUALS   KV1        +2                 	# I(2)TMP
004917,003282: E6,1541  E6,1672               G21                EQUALS   KV1        +4                 	# I(2)TMP
004918,003283: 
004919,003284:                                                                                          	# SATURN BOOST STORAGE.  SAVE TILL RCS DAP OPERATION.   (17D)
004920,003285: E6,1541  E6,1661               POLYNUM            EQUALS   BCDU                          	# B(15) PAD LOADED
004921,003286: E6,1541  E6,1673               POLYLOC            =        POLYNUM    +10D               	#
004922,003287: E6,1541  E6,1700               SATRLRT            EQUALS   POLYNUM    +15D               	# B(2)  PAD LOADED
004923,003288: 
004924,003289:                                                                                          	# MORE P11 STORAGE -PAD LOADED-         (2D)
004926,003291:                                                                                          	# (NOTE:  THIS PAD LOAD WILL NOT BE PRESERVED THROUGHOUT THE MISSION AS IT SHARES STORAGE WITH KALCMANU,
004927,003292:                                                                                          	# ENTRY DAP AND TVC DAP)
004928,003293: E6,1541  E6,1702               RPSTART            EQUALS   SATRLRT    +2                 	# B(1) PITCH ROLL START TIME
004929,003294: E6,1541  E6,1703               POLYSTOP           EQUALS   RPSTART    +1                 	# B(1) POLYCUT OFF MINUS RPSTART SEC
004930,003295: 
004931,003296:                                                                                          	# STORAGE FOR VHHDOT AND ATTDSP
004932,003297: E6,1541  E6,1704               BODY3              EQUALS   POLYSTOP   +1                 	# B(1)OUT
004933,003298: E6,1541  E6,1705               BODY2              EQUALS   BODY3      +1                 	# B(1)OUT
004934,003299: E6,1541  E6,1706               BODY1              EQUALS   BODY2      +1                 	# B(1)OUT
004935,003300: E6,1541  E6,1707               SPOLYARG           EQUALS   BODY1      +1                 	# B(1)TMP   ARGUEMENT FOR POLLY
004936,003301: 
004937,003302: E6,1541  E6,1503               OLDBODY1           =        EDRIVEX                       	# 1 PULSE = 0.0432 DEGREES

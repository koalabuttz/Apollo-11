059809,000036:                                                                                          	##            Colossus 2A
059810,000037: 
059812,000039:                                                                                          	# THE TFF SUBROUTINES MAY BE USED IN EITHER EARTH OR MOON CENTERED COORDINATES.  THE TFF ROUTINES NEVER
059813,000040:                                                                                          	# KNOW WHICH ORIGIN APPLIES.  IT IS THE USER WHO KNOWS, AND WHO SUPPLIES RONE, VONE AND 1/SQRT(MU) AT THE
059814,000041:                                                                                          	# APPROPRIATE SCALE LEVEL FOR THE PROPER PRIMARY BODY.
059815,000042: 
059816,000043:                                                                                          	#       EARTH ORIGIN    POSITION        -29     METERS
059817,000044:                                                                                          	#                       VELOCITY        -7      METERS/CENTISECOND
059818,000045:                                                                                          	#                       1/SQRT(MU)      +17     SQRT(CS SQ/METERS CUBED)
059819,000046: 
059820,000047:                                                                                          	#       MOON ORIGIN     POSITION        -27     METERS
059821,000048:                                                                                          	#                       VELOCITY        -5      METERS/CENTISECONDS
059822,000049:                                                                                          	#                       1/SQRT(MU)      +14     SQRT(CS SQ/METERS CUBED)
059823,000050: 
059824,000051:                                                                                          	# ALL DATA PROVIDED TO AND RECEIVED FROM ANY TFF SUBROUTINE WILL BE AT ONE OF THE LEVELS ABOVE.  IN ALL CASES,
059825,000052:                                                                                          	# THE FREE FALL TIME IS RETURNED IN CENTISECONDS AT (-28).  PROGRAM TFF/CONIC WILL GENERATE VONE/RTMU AND
059826,000053:                                                                                          	# LEAVE IT IN VONE' AT (+10) IF EARTH ORIGIN AND (+9) IF MOON ORIGIN.
059827,000054: 
059828,000055:                                                                                          	# THE USER MUST STORE THE STATE VECTOR IN RONE, VONE  AND MU IN THE FORM 1/SQRT(MU) IN TFF/RTMU
059829,000056:                                                                                          	# AT THE PROPER SCALE BEFORE CALLING TFF/CONIC.  SINCE RONE, VONE ARE IN THE EXTENDED VERB STORAGE AREA,
059830,000057:                                                                                          	# THE USER MUST ALSO LOCK OUT THE EXTENDED VERBS, AND RELEASE THEM WHEN FINISHED.
059831,000058: 
059832,000059:                                                                                          	# PROGRAMS CALC/TFF AND CALC/TPER ASSUME THAT THE TERMINAL RADIUS IS LESS THAN THE PRESENT
059833,000060:                                                                                          	# RADIUS.  THIS RESTRICTION CAN BE REMOVED BY A 15 W CODING CHANGE, BUT AT PRESENT IT IS NOT DEEMED NECESSARY.
059834,000061: 
059835,000062:                                                                                          	# THE FOLLOWING ERASABLE QUANTITIES ARE USED BY THE TFF ROUTINES, AND ARE LOCATED IN THE PUSH LIST.
059836,000063: 
059837,000064:                                                                                          	#                                       BELOW   E:  IS USED FOR EARTH ORIGIN SCALE
059838,000065:                                                                                          	#                                               M:  IS USED FOR MOON  ORIGIN SCALE
059839,000066: 
059840,000067:                                                                                          	#TFFSW          =       119D            BIT1    0 = CALCTFF             1 = CALCTPER
059841,000068: 23,3772                        TFFDELQ            =        10D                           	#       Q2-Q1                   E: (-16)  M: (-15)
059842,000069: 23,3772                        RMAG1              =        12D                           	#       ABVAL(RN)  M            E: (-29)  M: (-27)
059843,000070:                                                                                          	#RPER           =       14D             PERIGEE RADIUS  M       E: (-29)  M: (-27)
059844,000071: 23,3772                        TFFQ1              =        14D                           	#       R.V / SQRT(MUE)         E: (-16)  M: (-15)
059845,000072:                                                                                          	#SDELF/2                                SIN(THETA) /2
059846,000073: 23,3772                        CDELF/2            =        14D                           	#       COS(THETA) /2
059847,000074:                                                                                          	#RAPO           =       16D             APOGEE RADIUS  M        E: (-29)  M: (-27)
059848,000075: 23,3772                        NRTERM             =        16D                           	#       TERMINAL RADIUS  M      E: (-29+NR)
059849,000076:                                                                                          	#                                         M: (-27+NR)
059850,000077: 23,3772                        RTERM              =        18D                           	#       TERMINAL RADIUS  M      E: (-29)  M: (-27)
059851,000078: 23,3772                        TFFVSQ             =        20D                           	#       -(V SQUARED/MU)  1/M    E: (20)   M: (18)
059852,000079: 23,3772                        TFF1/ALF           =        22D                           	#       SEMI MAJ AXIS  M        E: (-22-2 NA)
059853,000080:                                                                                          	#                                         M: (-20-2 NA)
059854,000081: 23,3772                        TFFRTALF           =        24D                           	#       SQRT(ALFA)              E:(10+NA) M: (9+NA)
059855,000082: 23,3772                        TFFALFA            =        26D                           	#       ALFA  1/M               E:(26-NR) M: (24-NR)
059856,000083: 23,3772                        TFFNP              =        28D                           	#       SEMI LATUS RECTUM  M    E: (-38+2 NR)
059857,000084:                                                                                          	#                                         M: (-36+2 NR)
059858,000085: 23,3772                        TFF/RTMU           =        30D                           	#       1/SQRT(MU)              E: (17)   M: (14)
059859,000086: 23,3772                        NRMAG              =        32D                           	#       PRESENT RADIUS  M       E: (-29+NR)
059860,000087:                                                                                          	#                                         M: (-27+NR)
059861,000088: 23,3772                        TFFX               =        34D                           	#
059862,000089: 23,3772                        TFFTEM             =        36D                           	#       TEMPORARY
059864,000091:                                                                                          	#               REGISTERS S1, S2 ARE UNTOUCHED BY ANY TFF SUBROUTINE
059865,000092:                                                                                          	#               INDEX REGISTERS X1, X2 ARE USED BY ALL TFF SUBROUTINES.  THEY ARE ESTAB-
059866,000093:                                                                                          	#               LISHED IN TFF/CONIC AND MUST BE PRESERVED BETWEEN CALLS TO SUBSEQUENT
059867,000094:                                                                                          	#               SUBROUTINES.
059868,000095:                                                                                          	#               -NR                             C(X1) = NORM COUNT OF RMAG
059869,000096:                                                                                          	#               -NA                             C(X2) = NORM COUNT OF SQRT(ABS(ALFA))
059870,000097: 
059872,000099:                                                                                          	# SUBROUTINE NAME:  TFFCONIC                    DATE:  01.29.67
059873,000100:                                                                                          	# MOD NO:  0                                    LOG SECTION:  TIME OF FREE FALL
059874,000101:                                                                                          	# MOD BY:  RR BAIRNSFATHER
059875,000102:                                                                                          	# MOD NO:  1    MOD BY:  RR BAIRNSFATHER        DATE: 11 APR 67
059876,000103:                                                                                          	# MOD NO:  2    MOD BY:  RR BAIRNSFATHER        DATE: 21 NOV 67         ADD MOON MU.
059877,000104:                                                                                          	# MOD NO:  3    MOD BY:  RR BAIRNSFATHER        DATE: 21 MAR 68         ACCEPT DIFFERENT EARTH/MOON SCALES
059878,000105: 
059879,000106:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS SUBROUTINE IS CALLED TO COMPUTE THOSE CONIC PARAMETERS REQUIRED BY THE TFF
059880,000107:                                                                                          	#       SUBROUTINES AND TO ESTABLISH THEM IN THE PUSH LIST AREA.  THE PARAMETERS ARE LISTED UNDER OUTPUT.
059881,000108:                                                                                          	#       THE EQUATIONS ARE
059882,000109:                                                                                          	#               -   -  -
059883,000110:                                                                                          	#               H = RN*VN                       ANGULAR MOMENTUM
059884,000111:                                                                                          	#                     - -
059885,000112:                                                                                          	#               LCP = H.H / MU                  SEMI LATUS RECTUM
059886,000113:                                                                                          	#                             -  -
059887,000114:                                                                                          	#               ALFA = 2/RN - VN.VN / MU        RECIPROCAL SEMI MAJ AXIS, SIGNED
059888,000115: 
059889,000116:                                                                                          	#       AND ALFA IS POS FOR ELLIPTIC ORBITS
059890,000117:                                                                                          	#                     0 FOR PARABOLIC ORBITS
059891,000118:                                                                                          	#                   NEG FOR HYPERBOLIC ORBITS.
059892,000119:                                                                                          	#       SUBROUTINE ALSO COMPUTES AND SAVES RMAG.
059893,000120: 
059894,000121:                                                                                          	# CALLING SEQUENCE:
059895,000122:                                                                                          	#       TFFCONIC EXPECTS CALLER TO ENTER WITH CORRECT GRAVITATIONAL CONSTANT IN MPAC, IN THE FORM
059896,000123:                                                                                          	#       1/SQRT(MU).  PROGRAM WILL SAVE IN TFF/RTMU.  THE SCALE IS DETERMINED BY WHETHER EARTH OR MOON
059897,000124:                                                                                          	#       ORIGIN IS USED.  THE CALLER MUST LOCK OUT THE EXTENDED VERBS BEFORE PROVIDING STATE VECTOR IN RONE,
059898,000125:                                                                                          	#       VONE AT PROPER SCALE.  THE EXTENDED VERBS MUST BE RESTORED WHEN THE CALLER IS FINISHED USING THE
059899,000126:                                                                                          	#       TFF ROUTINES.
059900,000127: 
059901,000128:                                                                                          	#       ENTRY POINT TFFCONMU EXPECTS THAT TFF/RTMU IS ALREADY LOADED.
059902,000129: 
059903,000130:                                                                                          	#       TO SPECIFY MU:  DLOAD   CALL            IF MU ALREADY STORED:           CALL
059904,000131:                                                                                          	#                               YOURMU          1/RTMU E:(17) M:(14)                    TFFCONMU
059905,000132:                                                                                          	#                               TFFCONIC
059906,000133:                                                                                          	#       PUSHLOC = PDL+0, ARBITRARY IF LEQ 18D
059907,000134: 
059908,000135:                                                                                          	# SUBROUTINES CALLED:  NONE
059909,000136: 
059910,000137:                                                                                          	# NORMAL EXIT MODES:  RVQ
059911,000138: 
059912,000139:                                                                                          	# ALARMS:  NONE
059913,000140: 
059914,000141:                                                                                          	# OUTPUT:       THE FOLLOWING ARE STORED IN THE PUSH LIST AREA.
059915,000142:                                                                                          	#               RMAG1           E:(-29) M:(-27)         M  RN, PRESENT RADIUS LENGTH.
059916,000143:                                                                                          	#               NRMAG           E:(-29+NR)              M  RMAG, NORMALIZED
059917,000144:                                                                                          	#                               M:(-27+NR)
059918,000145:                                                                                          	#               X1                                      -NR, NORM COUNT
059919,000146:                                                                                          	#               TFFNP           E:(-38+2NR)             M  LCP, SEMI LATUS RECTUM, WEIGHTED BY NR.  FOR VGAMCALC
059920,000147:                                                                                          	#                               M:(-36+2NR)
059921,000148:                                                                                          	#               TFF/RTMU        E:(17) M:(14)           1/SQRT(MU)
059922,000149:                                                                                          	#               TFFVSQ          E:(20) M:(18)           1/M  -(V SQ/MU):  PRESENT VELOCITY, NORMLIZED.  FOR VGAMCALC
059923,000150:                                                                                          	#               TFFALFA         E:(26-NR)               1/M  ALFA, WEIGHTED BY NR
059924,000151:                                                                                          	#                               M:(24-NR)
059925,000152:                                                                                          	#               TFFRTALF        E:(10+NA)               SQRT(ALFA), NORMALIZED
059926,000153:                                                                                          	#                               M:(9+NA)
059928,000155:                                                                                          	#               X2                                      -NA, NORM COUNT
059929,000156:                                                                                          	#               TFF1/ALF        E:(-22-2NA)             SIGNED SEMI MAJ AXIS, WEIGHTED BY NA
059930,000157:                                                                                          	#                               M:(-20-2NA)
059931,000158:                                                                                          	#               PUSHLOC AT PDL+0
059932,000159: 
059933,000160:                                                                                          	#       THE FOLLOWING IS STORED IN GENERAL ERASABLE
059934,000161:                                                                                          	#               VONE'           E:(10) M:(9)            V/RT(MU), NORMALIZED VELOCITY
059935,000162: 
059936,000163:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:
059937,000164:                                                                                          	#               RONE            E:(-29) M:(-27)         M  STATE VECTOR         LEFT BY CALLER
059938,000165:                                                                                          	#               VONE            E:(-7) M:(-5)           M/CS  STATE VECTOR      LEFT BY CALLER
059939,000166:                                                                                          	#               TFF/RTMU        E:(17) M:(14)           1/RT(CS SQ/M CUBE)      IF ENTER VIA TFFCONMU.
059940,000167: 
059941,000168:                                                                                          	# DEBRIS:       QPRET,  PDL+0 ... PDL+3
059942,000169: 
059943,000170: 33,3776                                           BANK     33                            	#
059944,000171: 27,2000                                           SETLOC   TOF-FF                        	#

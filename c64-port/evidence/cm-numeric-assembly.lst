043848,000035: 
043850,000037:                                                                                          	# NAME          STROKE TEST PACKAGE             (INCLUDING INITIALIZATION PACKAGE)
043851,000038:                                                                                          	# LOG SECTION...TVCSTROKETEST                   SUBROUTINE...DAPCSM
043852,000039:                                                                                          	# MODIFIED BY SCHLUNDT                          21 OCTOBER 1968
043853,000040: 
043854,000041:                                                                                          	# FUNCTIONAL DESCRIPTION....
043855,000042:                                                                                          	#       STROKE TEST PACKAGE GENERATES A WAVEFORM DESIGNED TO EXCITE BENDING
043856,000043:                                                                                          	#       STRKTSTI (STROKE TEST INITIALIZATION) IS CALLED AS A JOB BY VB68.
043857,000044:                                                                                          	#               IT INITIALIZES ALL ERASABLES REQD FOR A STROKE TEST, AND
043858,000045:                                                                                          	#               THEN TESTS FOR CSM/LM (BIT 13 OF DAPDATR1). IF CSM/LM,
043859,000046:                                                                                          	#               IN EITHER HIGH OR LOW-BANDWIDTH MODE, THE TEST IS STARTED
043860,000047:                                                                                          	#               IMMEDIATELY.  IF NOT CSM/LM, PROGRAM EXITS WITH NO ACTION.
043861,000048:                                                                                          	#       HACK (STROKE TEST) GENERATES THE WAVEFORM BY DUMPING PULSE BURSTS
043862,000049:                                                                                          	#               OF PROPER SIGN AND IN PROPER SEQUENCE DIRECTLY INTO
043863,000050:                                                                                          	#               TVCPITCH, WORKING IN CONJUNCITON WITH BOTH PITCH AND YAW
043864,000051:                                                                                          	#               TVC DAPS, WITH INTERMEDIATE WAITLIST CALLS.  NOTE, HOWEVER
043865,000052:                                                                                          	#               THAT THE STROKE TEST IS PERFORMED ONLY IN THE PITCH AXIS.
043866,000053:                                                                                          	#               AN EXAMPLE WAVEFORM IS GIVEN BELOW, TO DEMONSTRATE STROKE-
043867,000054:                                                                                          	#               TEST PARAMETER SELECTION
043868,000055:                                                                                          	#       RESTARTS CAUSE TEST TO BE TERMINATED.  ANOTHER V68 REQD IF TEST
043869,000056:                                                                                          	#               IS TO BE RE-RUN.
043870,000057:                                                                                          	#       PULSE BURST SIZE IS PAD-LOADED (ESTROKER) SO THAT AMPLITUDE OF
043871,000058:                                                                                          	#               WAVEFORM CAN BE CHANGED.  THERE ARE TEN PULSE BURSTS IN
043872,000059:                                                                                          	#               THE HALF-AMPLITUDE OF THE FIRST FREQUENCY SET IN THE
043873,000060:                                                                                          	#               STANDARD WAVEFORM.  AMPLITUDE IS 10(ESTROKER)(1/42.15),
043874,000061:                                                                                          	#               NOMINALLY 50/42.15 = 1.185 DEG
043875,000062: 
043876,000063:                                                                                          	# CALLING SEQUENCE....
043877,000064:                                                                                          	#       EXTENDED VERB 68 SETS UP STRKTSTI JOB
043878,000065:                                                                                          	#       PITCH AND YAW TVCDAPS, FINDING STROKER NON-ZERO, DO A ..TC HACK..
043879,000066:                                                                                          	#       AN INTERNALLY-GENERATED WAITLIST CALL ENTERS AT ..HACKWLST..
043880,000067: 
043881,000068:                                                                                          	# NORMAL EXIT MODES....
043882,000069:                                                                                          	#       TC BUNKER (..Q.. IF ENTRY FROM DAP, ..TCTSKOVR.. IF FROM WAITLIST) LIST
043883,000070: 
043884,000071:                                                                                          	# SUBROUTINES CALLED....
043885,000072:                                                                                          	#       WAITLIST
043886,000073: 
043887,000074:                                                                                          	# ALARM OR ABORT EXIT MODES....
043888,000075:                                                                                          	#       NONE
043889,000076: 
043890,000077:                                                                                          	# ERASABLE INITIALIZATION REQUIRED....
043891,000078:                                                                                          	#       ESTROKER (PAD-LOAD)
043892,000079:                                                                                          	#       STROKER, CADDY, REVS, CARD, N
043893,000080: 
043894,000081:                                                                                          	# OUTPUT....
043895,000082:                                                                                          	#       STRKTSTI...INITIALIZATION FOR STROKE TEST
043896,000083:                                                                                          	#       HACK, HACKWLST...PULSE BURSTS INTO TVCPITCH VIA ..ADS..
043897,000084:                                                                                          	#                         RESETS STROKER = +0 WHEN TEST COMPLETED
043898,000085: 
043899,000086:                                                                                          	# DEBRIS....
043900,000087:                                                                                          	#       N = CADDY = +0, CARD = -0, REVS = -1
043901,000088:                                                                                          	#       BUNKER
043903,000090: 
043904,000091:                                                                                          	# EXAMPLE STROKE TEST WAVE FORM, DEMONSTRATING PARAMETER SELECTION
043905,000092: 
043906,000093:                                                                                          	# NOTE....THIS IS NOT THE OFFICIAL WAVEFORM....
043907,000094: 
043908,000095:                                                                                          	#        **              **
043909,000096:                                                                                          	#        **              **
043910,000097:                                                                                          	#        **              **             EXAMPLE WAVEFORM (EACH * REPRESENTS
043911,000098:                                                                                          	#       *  *            *  *                 85.41 ARCSEC OF ACTUATOR CMND)
043912,000099:                                                                                          	#       *  *            *  *
043913,000100:                                                                                          	#       *  *            *  *
043914,000101:                                                                                          	#      *    *          *    *          **      **      **      **      **
043915,000102:                                                                                          	#      *    *          *    *          **      **      **      **      **
043916,000103:                                                                                          	#      *    *          *    *          **      **      **      **      **
043917,000104:                                                                                          	#     *      *        *      *        *  *    *  *    *  *    *  *    *  *    **  **  **  **  **
043918,000105:                                                                                          	#     *      *        *      *        *  *    *  *    *  *    *  *    *  *    **  **  **  **  **
043919,000106:                                                                                          	#     *      *        *      *        *  *    *  *    *  *    *  *    *  *    **  **  **  **  **
043920,000107:                                                                                          	# -----------------------------------------------------------------------------------------------------
043921,000108:                                                                                          	#             *      *        *      *    *  *    *  *    *  *    *  *    *  *  **  **  **  **  **
043922,000109:                                                                                          	#             *      *        *      *    *  *    *  *    *  *    *  *    *  *  **  **  **  **  **
043923,000110:                                                                                          	#             *      *        *      *    *  *    *  *    *  *    *  *    *  *  **  **  **  **  **
043924,000111:                                                                                          	#              *    *          *    *      **      **      **      **      **
043925,000112:                                                                                          	#              *    *          *    *      **      **      **      **      **
043926,000113:                                                                                          	#              *    *          *    *      **      **      **      **      **
043927,000114:                                                                                          	#               *  *            *  *
043928,000115:                                                                                          	#               *  *            *  *
043929,000116:                                                                                          	#               *  *            *  *
043930,000117:                                                                                          	#                **              **
043931,000118:                                                                                          	#                **              **
043932,000119:                                                                                          	#                **              **
043933,000120: 
043934,000121:                                                                                          	# FOR THIS (UNOFFICIAL, EXAMPLE) WAVEFORM, THE REQUIRED PARAMETERS ARE AS FOLLOWS....
043935,000122: 
043936,000123:                                                                                          	#       FCARD    = +3           (NUMBER OF SETS)
043937,000124:                                                                                          	#       ESTROKER = +3           (PULSE BURST SIZE, SC.AT 85.41 ARCSEC/BIT)
043938,000125: 
043939,000126:                                                                                          	#       SET1..
043940,000127:                                                                                          	#               FREVS   = +3    (NUMBER REVERSALS MINUS 1)
043941,000128:                                                                                          	#               FCADDY  = +4    (NUMBER OF PULSE BURSTS IN 1/2 AMPLITUDE)
043942,000129:                                                                                          	#       SET2..
043943,000130:                                                                                          	#               FCARD1  = +9    (NUMBER REVERSALS MINUS 1)
043944,000131:                                                                                          	#               FCARD4  = +2    (NUMBER OF PULSE BURSTS IN 1/2 AMPLITUDE)
043945,000132:                                                                                          	#       SET3..
043946,000133:                                                                                          	#               FCARD2  = +9    (NUMBER REVERSALS MINUS 1)
043947,000134:                                                                                          	#               FCARD5  = +1    (NUMBER OF PULSE BURSTS IN 1/2 AMPLITUDE)
043948,000135:                                                                                          	#       SET4..
043949,000136:                                                                                          	#               FCARD3  = +0    (NUMBER REVERSALS MINUS 1)
043950,000137:                                                                                          	#               FCARD6  = +0    (NUMBER OF PULSE BURSTS IN 1/2 AMPLITUDE)
043951,000138: 
043953,000140:                                                                                          	# STROKE TEST INITIALIZATION PACKAGE (AS A JOB, FROM VERB 68)
043954,000141: 
043955,000142: 17,2552                                           BANK     17                            	#
043956,000143: 20,2000                                           SETLOC   DAPS2                         	#
043957,000144: 20,2000                                           BANK                                   	#
043958,000145: 
043959,000146: 20,3501                                           COUNT*   $$/STRK                       	#
043960,000147: 20,3501  E6,1655                                  EBANK=   CADDY                         	#
043961,000148: 
043962,000149: 20,3501           03512        STRKTSTI           TCR      TSTINIT                       	# STROKE TEST INITIALIZATION PKG (CALLED
043963,000150:                                                                                          	# AS A JOB BY VERB68)
043964,000151: 
043965,000152: 20,3502           00004        STRKCHK            INHINT                                 	#
043966,000153: 
043967,000154: 20,3503           31466                           CAE      DAPDATR1                      	# CHECK FOR CSM/LM CONFIGURATION
043968,000155: 20,3504           75002                           MASK     BIT14                         	#
043969,000156: 20,3505           00006                           EXTEND                                 	#
043970,000157: 20,3506           13511                           BZF      +3                            	#
043971,000158: 
043972,000159: 20,3507           31413                           CAE      ESTROKER                      	# BEGIN ON NEXT DAP PASS (PITCH OR YAW)
043973,000160: 20,3510           55574                           TS       STROKER                       	# (STROKING DONE IN PITCH ONLY, HOWEVER)
043974,000161: 
043975,000162: 20,3511           15217                           TCF      ENDOFJOB                      	#
043976,000163: 
043977,000164: 20,3512           43522        TSTINIT            CS       FCADDY                        	# NORMAL ENTRY FROM STRKTSTI
043978,000165: 20,3513           55655                           TS       CADDY                         	#
043979,000166: 20,3514           55656                           TS       N                             	#       NOTE SGN CHNG FCADDY(+) TO CADDY(-)
043980,000167: 
043981,000168: 20,3515           33523                           CAF      FREVS                         	#
043982,000169: 20,3516           55660                           TS       REVS                          	#
043983,000170: 
043984,000171: 20,3517           43524                           CS       FCARD                         	#       NOTE SGN CHNG FCARD(+) TO CARD(-)
043985,000172: 20,3520           55661                           TS       CARD                          	#
043986,000173: 
043987,000174: 20,3521           00002                           TC       Q                             	# RETURN TO STRKTSTI+1 (OR CHKSTRK+2 OR +4)
043988,000175: 
043990,000177:                                                                                          	# THE OFFICIAL STROKE TEST WAVEFORM (3 JAN, 1967) CONSISTS OF FOUR STROKE SETS, AS FOLLOWS....
043991,000178: 
043992,000179:                                                                                          	#       SET 1...10 BURSTS IN 1/2 AMP,   4 REVERSALS
043993,000180:                                                                                          	#       SET 2... 6 BURSTS IN 1/2 AMP,   6 REVERSALS
043994,000181:                                                                                          	#       SET 3... 5 BURSTS IN 1/2 AMP,  10 REVERSALS
043995,000182:                                                                                          	#       SET 4... 4 BURSTS IN 1/2 AMP,  14 REVERSALS
043996,000183: 
043997,000184:                                                                                          	# THE PULSE BURST SIZE (ESTROKER) IS PAD-LOADED (5 BITS AS OF 3 JAN, 1967)
043998,000185:                                                                                          	# THE REMAINING WAVEFORM-GENERATING PARAMETERS ARE AS FOLLOWS....
043999,000186: 
044000,000187: 20,3522           00012        FCADDY             DEC      10         B-14               	# NO. PULSE BURSTS IN 1/2 AMP, SET1..(+10)
044001,000188: 20,3523           00003        FREVS              DEC      3          B-14               	# NO. REVERSALS MINUS 1, SET1........(  3)
044002,000189: 
044003,000190: 20,3524           00004        FCARD              DEC      4          B-14               	# NO. STROKE SETS....................(+ 4)
044004,000191: 
044005,000192: 20,3525           00005        FCARD1             DEC      5          B-14               	# NO. REVERSALS MINUS 1, SET2........(  5)
044006,000193: 
044007,000194: 20,3526           00011        FCARD2             DEC      9          B-14               	#                           3........(  9)
044008,000195: 20,3527           00015        FCARD3             DEC      13         B-14               	#                           4........( 13)
044009,000196: 
044010,000197: 20,3530           00006        FCARD4             DEC      6          B-14               	# NO. PULSE BURSTS IN 1/2 AMP, SET2..(+ 6)
044011,000198: 20,3531           00005        FCARD5             DEC      5          B-14               	#                              SET3..(+ 5)
044012,000199: 20,3532           00004        FCARD6             DEC      4          B-14               	#                              SET4..(+ 4)
044013,000200: 
044014,000201: 20,3533     5016               20MS               =        BIT2                          	#
044015,000202: 
044016,000203:                                                                                          	# STROKE TEST PACKAGE PROPER....
044017,000204: 
044018,000205: 20,3533  E6,1657                                  EBANK=   BUNKER                        	#
044019,000206: 
044020,000207: 20,3533           00006        HACK               EXTEND                                 	# ENTRY (IN T5 RUPT) FROM TVCDAPS
044021,000208: 20,3534           23657                           QXCH     BUNKER                        	# SAVE Q FOR DAP RETURN
044022,000209: 
044023,000210: 20,3535           35016                           CAF      20MS                          	# 2DAPSX2(PASSES/DAP)X2(CS/PASS)=8CS=TVCDT
044024,000211: 20,3536           05245                           TC       WAITLIST                      	#
044025,000212: 20,3537  E6,1657                                  EBANK=   BUNKER                        	#
044026,000213: 20,3537           03542 40066                     2CADR    HACKWLST                      	#
044027,000214: 
044028,000215: 20,3541           13544                           TCF      +3                            	#
044029,000216: 
044030,000217: 20,3542           34367        HACKWLST           CAF      TCTSKOVR                      	# ENTRY FROM WAITLIST
044031,000218: 20,3543           55657                           TS       BUNKER                        	# BUNKER IS TC TASKOVER
044032,000219: 
044033,000220: 20,3544           31574                           CA       STROKER                       	# STROKE
044034,000221: 20,3545           26054                           ADS      TVCPITCH                      	#
044035,000222: 
044036,000223: 20,3546           35005                           CAF      BIT11                         	# RELEASE THE ERROR COUNTERS
044037,000224: 20,3547           00006                           EXTEND                                 	#
044038,000225: 20,3550           05014                           WOR      CHAN14                        	#
044039,000226: 20,3551           25655                           INCR     CADDY                         	# COUNT DOWN THE NO. BURSTS, THIS SLOPE
044041,000228: 20,3552           41655                           CS       CADDY                         	#
044042,000229: 20,3553           00006                           EXTEND                                 	#
044043,000230: 20,3554           63556                           BZMF     +2                            	#
044044,000231: 20,3555           01657                           TC       BUNKER                        	# EXIT, WHILE ON A SLOPE
044045,000232: 
044046,000233: 20,3556           11660                           CCS      REVS                          	#
044047,000234: 20,3557           13577                           TCF      REVUP                         	# POSITIVE REVS
044048,000235: 20,3560           13603                           TCF      REVUP      +4                 	# FINAL REVERSAL, THIS SET
044049,000236: 
044050,000237: 20,3561           25661                           INCR     CARD                          	# NEGATIVE REVS SET LAST PASS, READY FOR
044051,000238: 20,3562           41661                           CS       CARD                          	#       THE NEXT SET.  CHECK IF NO MORE SETS
044052,000239: 20,3563           00006                           EXTEND                                 	#
044053,000240: 20,3564           13575                           BZF      STROKILL                      	# ALL SETS COMPLETED
044054,000241: 
044055,000242: 20,3565           51661                           INDEX    CARD                          	#
044056,000243: 20,3566           33530                           CAF      FCARD      +4                 	# PICK UP NO. REVERSALS (-), NEXT SET
044057,000244: 20,3567           55660                           TS       REVS                          	# REINITIALIZE
044058,000245: 20,3570           51661                           INDEX    CARD                          	#
044059,000246: 20,3571           43533                           CS       FCARD      +7                 	# PICK UP NO. BURSTS IN 1/2AMP, NEXT SET
044060,000247: 20,3572           55656                           TS       N                             	# REINITIALIZE
044061,000248: 20,3573           55655                           TS       CADDY                         	#
044062,000249: 20,3574           01657                           TC       BUNKER                        	# EXIT, AT END OF SET
044063,000250: 
044064,000251: 20,3575           55574        STROKILL           TS       STROKER                       	# RESET (TO +0) TO END TEST
044065,000252: 20,3576           01657                           TC       BUNKER                        	# EXIT, STROKE TEST FINIS
044066,000253: 
044067,000254: 20,3577           55660        REVUP              TS       REVS                          	# ALL REVERSALS EXCEPT LAST OF SET
044068,000255: 20,3600           31656                           CA       N                             	#
044069,000256: 20,3601           60000                           DOUBLE                                 	# 2 X 1/2AMP
044070,000257: 20,3602           13606                           TCF      +4                            	#
044071,000258: 
044072,000259: 20,3603           45017                 +4        CS       ONE                           	# FINAL REVERSAL, THIS SET
044073,000260: 20,3604           55660                           TS       REVS                          	# PREPARE TO BRANCH TO NEW BURST
044074,000261: 20,3605           31656                           CA       N                             	# JUST RETURN TO ZERO, FINAL SLOPE OF SET
044075,000262: 20,3606           55655                           TS       CADDY                         	# CADUP
044076,000263: 
044077,000264: 20,3607           41574                           CS       STROKER                       	# CHANGE SIGN OF SLOPE
044078,000265: 20,3610           55574                           TS       STROKER                       	#
044079,000266: 20,3611           01657                           TC       BUNKER                        	# EXIT AT A REVERSAL (SLOPE CHANGE)
044080,000267: 
(End of include-file TVCSTROKETEST.agc, resuming MAIN.agc)
044080,000128: 
044081,000129: $TVCROLLDAP.agc					        # pp. 984-998

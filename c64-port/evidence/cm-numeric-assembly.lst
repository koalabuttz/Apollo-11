003097,001462: 
003099,001464:                                                                                          	# GENERAL ERASABLE ASSIGNMENTS.
003100,001465: 
003101,001466:    0061                                           SETLOC   61                            	#
003102,001467:                                                                                          	# INTERRUPT TEMPORARY STORAGE POOL.     (11D)
003103,001468: 
003104,001469:                                                                                          	# (ITEMP1 THROUGH RUPTREG4)             
003105,001470: 
003106,001471:                                                                                          	# ANY OF THESE MAY BE USED AS TEMPORARIES DURING INTERRUPT OR WITH INTERRUPT INHIBITED. THE ITEMP SERIES
003107,001472:                                                                                          	# IS USED DURING CALLS TO THE EXECUTIVE AND WAITLIST - THE RUPTREGS ARE NOT.
003108,001473: 
003109,001474:    0061                        ITEMP1             ERASE                                  	#
003110,001475:    0062     0061               WAITEXIT           EQUALS   ITEMP1                        	#
003111,001476:    0062     0061               EXECTEM1           EQUALS   ITEMP1                        	#
003112,001477: 
003113,001478:    0062                        ITEMP2             ERASE                                  	#
003114,001479:    0063     0062               WAITBANK           EQUALS   ITEMP2                        	#
003115,001480:    0063     0062               EXECTEM2           EQUALS   ITEMP2                        	#
003116,001481: 
003117,001482:    0063                        ITEMP3             ERASE                                  	#
003118,001483:    0064     0063               RUPTSTOR           EQUALS   ITEMP3                        	#
003119,001484:    0064     0063               WAITADR            EQUALS   ITEMP3                        	#
003120,001485:    0064     0063               NEWPRIO            EQUALS   ITEMP3                        	#
003121,001486: 
003122,001487:    0064                        ITEMP4             ERASE                                  	#
003123,001488:    0065     0064               LOCCTR             EQUALS   ITEMP4                        	#
003124,001489:    0065     0064               WAITTEMP           EQUALS   ITEMP4                        	#
003125,001490: 
003126,001491:    0065                        ITEMP5             ERASE                                  	#
003127,001492:    0066     0065               NEWLOC             EQUALS   ITEMP5                        	#
003128,001493: 
003129,001494:    0066                        ITEMP6             ERASE                                  	#
003130,001495:                                                                                          	# NEWLOC+1      EQUALS  ITEMP6          DP ADDRESS.
003131,001496: 
003132,001497:    0067                                           SETLOC   67                            	#
003133,001498:    0067                        NEWJOB             ERASE                                  	# MUST BE AT LOC 67 DUE TO WIRING.
003134,001499: 
003135,001500:    0070                        RUPTREG1           ERASE                                  	#
003136,001501:    0071                        RUPTREG2           ERASE                                  	#
003137,001502:    0072                        RUPTREG3           ERASE                                  	#
003138,001503:    0073                        RUPTREG4           ERASE                                  	#
003139,001504:    0074     0073               KEYTEMP1           EQUALS   RUPTREG4                      	#
003140,001505:    0074     0073               DSRUPTEM           EQUALS   RUPTREG4                      	#
003141,001506: 
003142,001507:                                                                                          	# FLAGWORD RESERVATIONS.                (12D)
003143,001508: 
003144,001509:    0074                        STATE              ERASE    +11D                          	#
003145,001510: 
003146,001511:                                                                                          	# PAD LOAD FOR DAPS                     (1)
003147,001512: 
003148,001513:    0110                        EMDOT              ERASE                                  	# I(1)PL SPS FLOW RATE, SC. AT B+3 KG/CS
003149,001514: 
003151,001516: 
003152,001517:                                                                                          	# EXIT FOR V83                          (1D)
003153,001518:    0111                        STATEXIT           ERASE                                  	# I(1) STQ AD RESS F R STATEXP
003154,001519: 
003155,001520:                                                                                          	# UNUSED ERASABLES ********(2)
003156,001521:    0112                        ERASFILL           ERASE    +1                            	#
003157,001522: 
003158,001523:                                                                                          	# EXEC TEMPORARIES WHICH MAY BE USED BETWEEN CCS NEWJOBS.
003159,001524:                                                                                          	# (INTB15+ THROUGH RUPTMXM)             (32D)
003160,001525:    0114                        INTB15+            ERASE                                  	# REFLECTS 15TH BIT OF INDEXABLE ADDRESSES
003161,001526:    0115     0114               DSEXIT             EQUALS   INTB15+                       	# RETURN FOR DSPIN
003162,001527:    0115     0114               EXITEM             EQUALS   INTB15+                       	# RETURN FOR SCALE FACTOR ROUTINE SELECT
003163,001528:    0115     0114               BLANKRET           EQUALS   INTB15+                       	# RETURN FOR 2BLANK
003164,001529: 
003165,001530:    0115                        INTBIT15           ERASE                                  	# SIMILAR TO ABOVE.
003166,001531:    0116     0115               WRDRET             EQUALS   INTBIT15                      	# RETURN FOR 5BLANK
003167,001532:    0116     0115               WDRET              EQUALS   INTBIT15                      	# RETURN FOR DSPWD
003168,001533:    0116     0115               DECRET             EQUALS   INTBIT15                      	# RETURN FOR PUTCOM(DEC LOAD)
003169,001534:    0116     0115               21/22REG           EQUALS   INTBIT15                      	# TEMP FOR CHARIN
003170,001535: 
003171,001536:                                                                                          	# THE REGISTERS BETWEEN ADDRWD AND PRIORITY MUST STAY IN THE FOLLOWING ORDER FOR INTERPRETIVE TRACE.
003172,001537: 
003173,001538:    0116                        ADDRWD             ERASE                                  	# 12 BIT INTERPRETIVE OPERAND SUB-ADDRESS.
003174,001539:    0117                        POLISH             ERASE                                  	# HOLDS CADR MADE FROM POLISH ADDRESS.
003175,001540:    0120     0117               UPDATRET           EQUALS   POLISH                        	# RETURN FOR UPDATNN, UPDATVB
003176,001541:    0120     0117               CHAR               EQUALS   POLISH                        	# TEMP FOR CHARIN
003177,001542:    0120     0117               ERCNT              EQUALS   POLISH                        	# COUNTER FOR ERROR LIGHT RESET
003178,001543:    0120     0117               DECOUNT            EQUALS   POLISH                        	# COUNTER FOR SCALING AND DISPLAY (DEC)
003179,001544: 
003180,001545:    0120                        FIXLOC             ERASE                                  	# WORK AREA ADDRESS.
003181,001546:    0121                        OVFIND             ERASE                                  	# SET NON-ZERO ON OVERFLOW.
003182,001547: 
003183,001548:    0122                        VBUF               ERASE    +5                            	# TEMPORARY STORAGE USED FOR VECTORS.
003184,001549:    0130     0122               SGNON              EQUALS   VBUF                          	# TEMP FOR +,- ON
003185,001550:    0130     0122               NOUNTEM            EQUALS   VBUF                          	# COUNTER FOR MIXNOUN FETCH
003186,001551:    0130     0122               DISTEM             EQUALS   VBUF                          	# COUNTER FOR OCTAL DISPLAY VERBS
003187,001552:    0130     0122               DECTEM             EQUALS   VBUF                          	# COUNTER FOR FETCH (DEC DISPLAY VERBS)
003188,001553: 
003189,001554:    0130     0123               SGNOFF             EQUALS   VBUF       +1                 	# TEMP FOR +,- ON
003190,001555:    0130     0123               NVTEMP             EQUALS   VBUF       +1                 	# TEMP FOR NVSUB
003191,001556:    0130     0123               SFTEMP1            EQUALS   VBUF       +1                 	# STORAGE FOR SF CONST HI PART (=SFTEMP2-1)
003192,001557:    0130     0123               HITEMIN            EQUALS   VBUF       +1                 	# TEMP FOR LOAD OF HRS,MIN,SEC
003193,001558:                                                                                          	# MUST = LOTEMIN-1.
003194,001559: 
003195,001560:    0130     0124               CODE               EQUALS   VBUF       +2                 	# FOR DSPIN
003196,001561:    0130     0124               SFTEMP2            EQUALS   VBUF       +2                 	# STORAGE FOR SF CONST LO PART (=SFTEMP1+1)
003197,001562:    0130     0124               LOTEMIN            EQUALS   VBUF       +2                 	# TEMP FOR LOAD OF HRS,MIN,SEC
003199,001564:                                                                                          	#       MUST = HITEMIN+1.
003200,001565:    0130     0125               MIXTEMP            EQUALS   VBUF       +3                 	# FOR MIXNOUN DATA
003201,001566:    0130     0125               SIGNRET            EQUALS   VBUF       +3                 	# RETURN FOR +,- ON
003202,001567: 
003203,001568:                                                                                          	# ALSO MIXTEMP+1 = VBUF+4, MIXTEMP+2 = VBUF+5.
003204,001569: 
003205,001570:    0130                        BUF                ERASE    +2                            	# TEMPORARY SCALAR STORAGE.
003206,001571:    0133                        BUF2               ERASE    +1                            	#
003207,001572:    0135     0130               INDEXLOC           EQUALS   BUF                           	# CONTAINS ADDRESS OF SPECIFIED INDEX.
003208,001573:    0135     0130               SWWORD             EQUALS   BUF                           	# ADDRESS OF SWITCH WORD.
003209,001574:    0135     0131               SWBIT              EQUALS   BUF        +1                 	# SWITCH BIT WITHIN SWITCH WORD.
003210,001575:    0135                        MPTEMP             ERASE                                  	# TEMPORARY USED IN MULTIPLY AND SHIFT.
003211,001576:    0136     0135               DMPNTEMP           EQUALS   MPTEMP                        	# DMPSUB TEMPORARY
003212,001577:    0136                        DOTINC             ERASE                                  	# COMPONENT INCREMENT FOR DOT SUBROUTINE.
003213,001578:    0137     0136               DVSIGN             EQUALS   DOTINC                        	# DETERMINES SIGN OF DDV RESULT.
003214,001579:    0137     0136               ESCAPE             EQUALS   DOTINC                        	# USED IN ARCSIN/ARCCOS.
003215,001580:    0137     0136               ENTRET             EQUALS   DOTINC                        	# EXIT FROM ENTER
003216,001581: 
003217,001582:    0137                        DOTRET             ERASE                                  	# RETURN FROM DOT SUBROUTINE.
003218,001583:    0140     0137               DVNORMCT           EQUALS   DOTRET                        	# DIVIDEND NORMALIZATION COUNT IN DDV.
003219,001584:    0140     0137               ESCAPE2            EQUALS   DOTRET                        	# ALTERNATE ARCSIN/ARCCOS SWITCH.
003220,001585:    0140     0137               WDCNT              EQUALS   DOTRET                        	# CHAR COUNTER FOR DSPWD
003221,001586:    0140     0137               INREL              EQUALS   DOTRET                        	# INPUT BUFFER SELECTOR ( X,Y,Z, REG )
003222,001587: 
003223,001588:    0140                        MATINC             ERASE                                  	# VECTOR INCREMENT IN MXV AND VXM.
003224,001589:    0141     0140               MAXDVSW            EQUALS   MATINC                        	# +0 IF DP QUOTIENT IS NEAR ONE - ELSE -1.
003225,001590:    0141     0140               POLYCNT            EQUALS   MATINC                        	# POLYNOMIAL LOOP COUNTER
003226,001591:    0141     0140               DSPMMTEM           EQUALS   MATINC                        	# DSPCOUNT SAVE FOR DSPMM

049702,000449:                                                                                          	# STORE CODE ADDRESS PROCESSOR.
049703,000450: 
049704,000451:    6363           50120        STORE,1            INDEX    FIXLOC                        	#
049705,000452:    6364           40046                           CS       X1                            	#
049706,000453:    6365           16370                           TCF      PRESTORE                      	#
049707,000454: 
049708,000455:    6366           50120        STORE,2            INDEX    FIXLOC                        	#

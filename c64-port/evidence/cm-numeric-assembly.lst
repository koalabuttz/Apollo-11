049579,000326:    6271           17005                           TCF      BVSU                          	# 26 -- VECTOR SUBTRACT FROM.
049580,000327:    6272           17300                           TCF      DOT                           	# 27 -- VECTOR DOT PRODUCT.
049581,000328: 
049582,000329:    6273           17427                           TCF      VXV                           	# 30 -- VECTOR CROSS PRODUCT.
049583,000330:    6274           17374                           TCF      VPROJ                         	# 31 -- VECTOR PROJECTION.
049584,000331:    6275           16754                           TCF      DSU                           	# 32 -- DP SUBTRACT.
049585,000332:    6276           17031                           TCF      BDSU                          	# 33 -- DP SUBTRACT FROM.

035985,000665:                                                                                          	# PROGRAM NAME:         S61.2                   DATE:           14 FEB 67
035986,000666:                                                                                          	# MOD NO:       1                               LOG SECTION:    P61-P67
035987,000667:                                                                                          	# MOD BY:       MORTH / BAIRNSFATHER
035988,000668:                                                                                          	# MOD NO: 2     MOD BY: MORTH/BAIRNSFATHER      DATE: 11 MAY 67         ADD 2ND ITER FOR ERAD AT 400K FT.
035989,000669:                                                                                          	# MOD NO: 3     MOD BY: RR BAIRNSFATHER         DATE: 21 NOV 67         VARIABLE MU ADDED.
035990,000670:                                                                                          	# MOD NO: 4     MOD BY: RR BAIRNSFATHER         DATE: 21 MAR 68         DIFFERENT EARTH/MOON SCALES IN TFF'S
035991,000671: 
035992,000672:                                                                                          	# FUNCTIONAL DESCRIPTION:  CALLED BY P61.  PROVIDES DISPLAYS FOR NOUNS  N60  AND  N63 .
035993,000673:                                                                                          	#       PROGRAM CALCULATES ENTRY DISPLAY OF MAXIMUM ACCELERATION EXPECTED  (GMAX)  AND ALSO THE EXPECTED
035994,000674:                                                                                          	#       INERTIAL VELOCITY (VPRED) AND ENTRY ANGLE  (GAMMAEI)  THAT WILL OBTAIN AT 400K FT ABOVE THE FISCHER
035995,000675:                                                                                          	#       ELLIPSOID.  PROGRAM ALSO CALCULATES A SECOND DISPLAY RELATIVE TO THE  EMSALT  ABOVE FISCHER ELLIPSOID
035996,000676:                                                                                          	#       AND CONSISTS OF RANGE TO SPLASH FROM NOW  (RTGO) , PREDICTED INERTIAL VELOCITY  (VIO) , AND THE TIME TO
035997,000677:                                                                                          	#       GO FROM NOW  (TTE) .
035998,000678: 
035999,000679:                                                                                          	# CALLING SEQUENCE:     CALL
036000,000680:                                                                                          	#                               S61.2
036001,000681:                                                                                          	#                       C(MPAC) UNSPECIFIED
036002,000682:                                                                                          	#                       PUSHLOC WILL BE SET TO ZERO.
036003,000683: 
036004,000684:                                                                                          	# SUBROUTINES CALLED:   TFFCONIC, CALCTFF, TFF/TRIG, FISHCALC, GETERAD, VGAMCALC
036005,000685: 
036006,000686:                                                                                          	# NORMAL EXIT MODES:    RTB   P61.1
036007,000687: 
036008,000688:                                                                                          	# ALARMS:       NONE
036009,000689: 
036010,000690:                                                                                          	# OUTPUT:       THE FOLLOWING REGISTERS ARE WRITTEN IN FOR USE BY DISPLAYS
036011,000691:                                                                                          	#               GMAX    100 GMAX (-14) G,S      MAXIMUM ACCELERATION
036012,000692:                                                                                          	#               VPRED   (-7) M/CS               PREDICTED VELOCITY AT 400K FT
036013,000693:                                                                                          	#               GAMMAEI GAMMA/360               PREDICTED GAMMA    AT 400K FT
036014,000694:                                                                                          	#                                               FOR TM, DP(GAMMAEI) = (GAMMAEI, RTGO) / 360
036015,000695:                                                                                          	#               RTGO    THETAH/360              RANGE ANGLE TO SPLASH FROM EMSALT       EMSALT IS PAD LOADED
036016,000696:                                                                                          	#               VIO     (-7) M/CS               INERTIAL VELOCITY AT      EMSALT        EMSALT IS PAD LOADED
036017,000697:                                                                                          	#               TTE     (-28) CS                TIME TO                    EMSALT       EMSALT IS PAD LOADED
036018,000698:                                                                                          	#               PUSHLOC = 0
036019,000699:                                                                                          	#               CONIC PARAMETERS STORED IN VAC AREA (SEE TFF SUBROUTINES)
036020,000700: 
036021,000701:                                                                                          	# ERASABLE INITIALIZATION REQUIRED:
036022,000702:                                                                                          	#               RONE    (-29) M                 STATE VECTOR                            LEFT BY USER
036023,000703:                                                                                          	#               VONE    (-7) M/CS               STATE VECTOR                            LEFT BY USER
036024,000704:                                                                                          	#               URONE   UR/2                                                            LEFT BY USER
036025,000705:                                                                                          	#               UNI     (-1)                    UNIT NORMAL V*R                         LEFT BY ENTRY / P61
036026,000706:                                                                                          	#               THETAH  THETAH/360              RANGE ANGLE                             LEFT BY ENTRY / P61
036027,000707:                                                                                          	#               UNITW   (0)                     UNIT POLAR VECTOR                       LEFT BY PAD LOAD
036028,000708:                                                                                          	#               EMSALT  (-29) M                 EMS INTERFACE ALTITUDE                  LEFT BY PAD LOAD
036029,000709:                                                                                          	#                                               ORBITAL REENTRY: 284643 FT, LUNAR REENTRY: 297431 FT.
036030,000710: 
036031,000711:                                                                                          	# DEBRIS:       QPRET,
036032,000712:                                                                                          	#               ALL PDL LOCATIONS ABOVE 12D, INCLUDING X1,X2,S1,S2
036033,000713:                                                                                          	#               ALSO PDL+0 ... PDL+5, WHERE INITIAL PUSHLOC = PDL
036034,000714: 
036036,000716:                                                                                          	# THE FOLLOWING PUSH LIST LOCATIONS HAVE BEEN RESERVED FOR TFF ROUTINES AND ARE REPEATED HERE FOR CONVENIENCE.
036037,000717:                                                                                          	# OF COURSE FOR S61.2 USAGE, EARTH ORIGIN SCALING IS USED.
036038,000718: 
036039,000719:                                                                                          	#                               BELOW   E:  IS USED FOR EARTH ORIGIN SCALE
036040,000720:                                                                                          	#                                       M:  IS USED FOR MOON ORIGIN SCALE
036041,000721: 
036042,000722:                                                                                          	#       RTERM   =       18D             TERMINAL RADIUS M       E:  (-29)       M:  (-27)
036043,000723:                                                                                          	#       NRTERM  =       16D             TERMINAL RADIUS M       E:  (-29+NR)
036044,000724:                                                                                          	#                                                               M:  (-27+NR)
036045,000725:                                                                                          	#       RMAG1   =       12D             PRESENT RADIUS M        E:  (-29)       M:  (-27)
036046,000726:                                                                                          	#       NRMAG   =       32D             PRESENT RADIUS M        E:  (-29+NR)
036047,000727:                                                                                          	#                                                               M:  (-27+NR)
036048,000728:                                                                                          	#       SDELF/2                         SIN(THETA) / 2
036049,000729:                                                                                          	#       CDELF/2 =       14D             COS(THETA) / 2
036050,000730:                                                                                          	#       TFFX    =       34D             X, ARGUMENT OF SERIES T(X).
036051,000731:                                                                                          	#       TFFTEM  =       36D             ARG FOR TRANSFER ANGLE CALCULATION.
036052,000732:                                                                                          	#       TFFNP   =       28D             LC P M                  E:  (-38+2NR)   M:  (-36+2NR)
036053,000733:                                                                                          	#       TFF/RTMU=       30D             1/SQRT(MU)              E:  (17)        M:  (14)
036054,000734:                                                                                          	#       TFFVSQ  =       20D             -(VN.VN/MU)     1/M     E:  (20)        M:  (18)
036055,000735: 
036057,000737: 34,3763                                           BANK     34                            	#
036058,000738: 26,2000                                           SETLOC   P60S2                         	#
036059,000739: 26,2000                                           BANK                                   	#
036060,000740: 
036061,000741: 26,2651                                           COUNT*   $$/S61.2                      	#
036062,000742:                                                                                          	# PDL LEFT AT ZERO BY TARGETNG

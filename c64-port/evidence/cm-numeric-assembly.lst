032492,002047:                                                                                          	# NAME          S40.6 GIMBAL DRIVE TEST AND/OR GIMBAL TRIM
032493,002048:                                                                                          	# MOD NO 5                              DATE 9 MARCH, 1967
032494,002049:                                                                                          	# MOD BY ENGEL                          LOG SECTION P40-P47
032495,002050: 
032496,002051:                                                                                          	# FUNCTIONAL DESCRIPTION
032497,002052:                                                                                          	#       GIMBAL DRIVE TEST....0,+2,-2,0 DEGREE ENGINE COMMANDS, AT 2 SECOND
032498,002053:                                                                                          	#               INTERVALS, FIRST IN PITCH, THEN IN YAW.  ASTRONAUT VERIFICATION
032499,002054:                                                                                          	#               OF GIMBAL MOTION ON GPI
032500,002055:                                                                                          	#       GIMBAL TRIM....AFTER A 4 SECOND DELAY, ENGINE COMMANDED TO
032501,002056:                                                                                          	#               PRE-COMPUTED TRIM POSITION.  ASTRONAUT VERIFICATION ON GPI.
032502,002057:                                                                                          	#       PRE40.6....RESTART ENTRY TO RE-DO S40.6, ONLY IF RCS IS ON - IF TVC
032503,002058:                                                                                          	#               IS NOT ON - PRIMARILY TO GET ACTUATORS TRIMMED FOR IGNITION.
032504,002059:                                                                                          	#               BYPASS 4 SEC DELAY.  SPEED IS CRITICAL NEAR IGNITION.
032505,002060:                                                                                          	#               IF TVC IS ON (TVCDAPON OR LATER) THEN REDOTVC WILL TAKE CARE
032506,002061:                                                                                          	#               OF RESTARTING ACTUATORS.
032507,002062: 
032508,002063:                                                                                          	# CALLING SEQUENCE....
032509,002064:                                                                                          	#       WAITLIST, WITH 2CADR FOR S40.6 (OR PRE40.6), WITH EBANK= CNTR
032510,002065: 
032511,002066:                                                                                          	# NORMAL EXIT MODE - FIXDELAY, TASKOVER
032512,002067: 
032513,002068:                                                                                          	# SUBROUTINES CALLED....
032514,002069:                                                                                          	#       OUTPUT (INTERNAL)
032515,002070:                                                                                          	#       FIXDELAY
032516,002071: 
032517,002072:                                                                                          	# ALARM OR ABORT EXIT MODES - NONE
032518,002073: 
032519,002074:                                                                                          	# ERASEABLE INITIALIZATION REQUIRED
032520,002075:                                                                                          	#       CNTR = +0, NORMALLY SET BY THE P40 CALL AT TST,TRIM
032521,002076:                                                                                          	#       MRKRTMP...POSITIVE FOR GIMBAL DRIVE TEST AND GIMBAL TRIM (BOTH)
032522,002077:                                                                                          	#                  NEGATIVE FOR GIMBAL TRIM ONLY
032523,002078:                                                                                          	#       PACTOFF, YACTOFF SC.AT 85.41 ARCSEC/BIT (V48N48 P, YTRIM)
032524,002079:                                                                                          	#       ..SC CONT.. SWITCH AT ..CMC.. (A/P CONTROL SWITCH AT ..GNC..)
032525,002080:                                                                                          	#       ACTIVE SPS GIMBAL MOTOR POWER(S), PITCH, YAW
032526,002081: 
032527,002082:                                                                                          	# OUTPUT

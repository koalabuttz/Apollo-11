049766,000513: 
049767,000514:                                                                                          	# Page 1124
049768,000515:                                                                                          	# THE FOLLOWING LOAD INSTRUCTIONS ARE PROVIDED FOR LOADING THE MULTI-PURPOSE ACCUMULATOR MPAC.
049769,000516: 
049770,000517:    6437           50116        TLOAD              INDEX    ADDRWD                        	#
049771,000518:    6440           30002                           CA       2                             	# LOAD A TRIPLE PRECISION ARGUMENT INTO
049772,000519:    6441           54156                           TS       MPAC       +2                 	# THE FIRST THREE MPAC REGISTERS, WITH THE
049773,000520:    6442           00006                           EXTEND                                 	# CONTENTS OF THE OTHER FOUR IRRELEVANT.
049774,000521:    6443           50116                           INDEX    ADDRWD                        	#
049775,000522:    6444           30001                           DCA      0                             	#
049776,000523:    6445           52155                           DXCH     MPAC                          	#
049777,000524:    6446           35017        TMODE              CAF      ONE                           	#
049778,000525:    6447           16027                           TCF      NEWMODE                       	# DECLARE TRIPLE PRECISION MODE.
049779,000526: 
049780,000527:    6450           22007        SLOAD              ZL                                     	# LOAD A SINGLE PRECISION NUMBER INTO
049781,000528:    6451           50116                           INDEX    ADDRWD                        	# MPAC, SETTING MPAC+1,2 TO ZERO.  THE
049782,000529:    6452           30000                           CA       0                             	# CONTENTS OF THE REMAINING MPAC REGISTERS
049783,000530:    6453           16024                           TCF      SLOAD2                        	# ARE IRRELEVANT.
049784,000531: 
049785,000532:    6454           00006        VLOAD              EXTEND                                 	# LOAD A DOUBLE PRECISION VECTOR INTO
049786,000533:    6455           50116                           INDEX    ADDRWD                        	# MPAC,+1, MPAC+3,4, AND MPAC+5,6.  THE
049787,000534:    6456           30001                           DCA      0                             	# CONTENTS OF MPAC +2 ARE IRRELEVANT.
049788,000535:    6457           52155                           DXCH     MPAC                          	#
049789,000536: 
049790,000537:    6460           00006        ENDVLOAD           EXTEND                                 	# PDVL COMES HERE TO FINISH UP FOR DP, TP.
049791,000538:    6461           50116                           INDEX    ADDRWD                        	#
049792,000539:    6462           30003                           DCA      2                             	#
049793,000540:    6463           52160                           DXCH     MPAC       +3                 	#
049794,000541: 
049795,000542:    6464           00006                 +4        EXTEND                                 	# TPDVL FINISHES HERE.
049796,000543:    6465           50116                           INDEX    ADDRWD                        	#
049797,000544:    6466           30005                           DCA      4                             	#
049798,000545:    6467           52162                           DXCH     MPAC       +5                 	#
049799,000546: 
049800,000547:    6470           45017        VMODE              CS       ONE                           	# DECLARE VECTOR MODE.
049801,000548:    6471           16027                           TCF      NEWMODE                       	#
049802,000549: 
049803,000550:                                                                                          	# Page 1125
049804,000551:                                                                                          	# THE FOLLOWING INSTRUCTIONS ARE PROVIDED FOR STORING OPERANDS IN THE PUSHDOWN LIST:
049805,000552:                                                                                          	#       1.      PUSH            PUSHDOWN AND NO LOAD.
049806,000553:                                                                                          	#       2.      PDDL            PUSHDOWN AND DOUBLE PRECISION LOAD.
049807,000554:                                                                                          	#       3.      PDVL            PUSHDOWN AND VECTOR LOAD.
049808,000555: 
049809,000556:    6472           00006        PDDL               EXTEND                                 	#
049810,000557:    6473           50116                           INDEX    ADDRWD                        	# LOAD MPAC,+1, PUSHING THE FORMER
049811,000558:    6474           30001                           DCA      0                             	# CONTENTS DOWN.
049812,000559:    6475           52155                           DXCH     MPAC                          	#
049813,000560:    6476           50166                           INDEX    PUSHLOC                       	#
049814,000561:    6477           52001                           DXCH     0                             	#
049815,000562: 
049816,000563:    6500           50163                           INDEX    MODE                          	# ADVANCE THE PUSHDOWN POINTER APPRO-
049817,000564:    6501           36213                           CAF      NO.WDS                        	# PRIATELY.

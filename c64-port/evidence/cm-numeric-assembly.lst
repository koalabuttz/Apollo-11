016752,003530: 
016754,003532:                                                                                          	# INTERNAL USE OF KEYBOARD AND DISPLAY PROGRAM
016755,003533: 
016756,003534:                                                                                          	# USER MUST SCHEDULE CALLS TO NVSUB SO THAT THERE IS NO CONFLICT OF USE OR
016757,003535:                                                                                          	# CONFUSION TO OPERATOR.  THE OLD GRABLOCK (INTERNAL/INTERNAL INTERLOCK)
016758,003536:                                                                                          	# HAS BEEN REMOVED AND THE INTERNAL USER NO LONGER HAS THE PROTECTION THIS
016759,003537:                                                                                          	# OFFERED.
016760,003538: 
016761,003539:                                                                                          	# THERE ARE TWO WAYS A JOB CAN BE PUT TO SLEEP BY THE KEYBOARD + DISPLAY
016762,003540:                                                                                          	# PROGRAM.      1)      BY ENDIDLE
016763,003541:                                                                                          	#               2)      BY NVSUBUSY
016764,003542:                                                                                          	# THE BASIC CONVENTION IS THAT ONLY ONE JOB WILL BE PERMITTED ASLEEP VIA
016765,003543:                                                                                          	# THE KEYBOARD + DISPLAY PROGRAM AT A TIME.  IF A JOB ATTEMPTS TO GO TO
016766,003544:                                                                                          	# SLEEP BY MEANS OF (1) OR (2) AND THERE IS ALREADY AJOB ASLEEP THAT WAS
016767,003545:                                                                                          	# PUT TO SLEEP BY (1) OR (2), THEN AN ABORT IS CAUSED.
016768,003546: 
016769,003547:                                                                                          	# THE CALLING SEQUENCE FOR NVSUB IS
016770,003548:                                                                                          	#                       CAF             V/N
016771,003549:                                                                                          	#       L               TC              NVSUB
016772,003550:                                                                                          	#       L+1             RETURN HERE IF OPERATOR HAS INTERVENED
016773,003551:                                                                                          	#       L+2             RETURN HERE AFTER EXECUTION
016774,003552: 
016775,003553:                                                                                          	# A ROUTINE CALLED NVSUBUSY IS PROVIDED (USE IS OPTIONAL) TO PUT
016776,003554:                                                                                          	# YOUR JOB TO SLEEP UNTIL THE OPERATOR RELEASES THE KEYBOARD + DISPLAY
016777,003555:                                                                                          	# SYSTEM.  NVSUBUSY ALSO TURNS ON THE KEY RELEASE LIGHT.
016778,003556:                                                                                          	# NVSUBUSY CANNOT BE CALLED FROM ERASABLE OR F/F MEMORY,
016779,003557:                                                                                          	# SINCE JOBSLEEP AND JOBWAKE CAN HANDLE ONLY FIXED BANKS.
016780,003558: 
016781,003559:                                                                                          	# THE CALLING SEQUENCE IS
016782,003560:                                                                                          	#       CAF     WAKEFCADR
016783,003561:                                                                                          	#       TC      NVSUBUSY
016784,003562:                                                                                          	# .
016785,003563: 
016786,003564:                                                                                          	# NVSUBUSY IS INTENDED FOR USE WHEN AN INTERNAL PROGRAM FINDS THE OPERATOR
016787,003565:                                                                                          	# IS USING THE KEYBOARD + DISPLAY PROGRAM (BY HIS OWN INITIATION).  IT IS
016788,003566:                                                                                          	# NOT INTENDED FOR USE WHEN ONE INTERNAL PROGRAM FINDS ANOTHER INTERNAL 
016789,003567:                                                                                          	# PROGRAM USING THE KEYBOARD + DISPLAY PROGRAM.
016790,003568: 
016791,003569:                                                                                          	# NVSUBUSY ABORTS (WITH CODE 01206) IF A SECOND JOB ATTEMPTS TO GO TO
016792,003570:                                                                                          	# SLEEP IN PINBALL.  IN PARTICULAR, IF AN ATTEMPT IS MADE TO GO TO NVSUBUSY
016793,003571:                                                                                          	# WHEN
016794,003572: 
016795,003573:                                                                                          	#       1)      DSPLIST NOT= +0.  THIS IS THE CASE WHERE THE CAPACITY OF THE DSPLIST
016796,003574:                                                                                          	#               IS EXCEEDED.
016797,003575:                                                                                          	#       2)      CADRSTOR NOT= +0.  THIS INDICATES THAT A JOB IS ALREADY USING
016799,003577:                                                                                          	# ENDIDLE.  (+-NZ INDICATE A JOB IS ALREADY ASLEEP DUE TO ENDIDLE.)
016800,003578: 
016801,003579:    4453           44460        PRENVBSY           CS       2K+3                          	# SPECIAL ENTRANCE FOR ROUTINES IN FIXED
016802,003580:    4454           60002                           AD       Q                             	# BANKS ONLY DESIRING THE FCADR OF (LOC
016803,003581:    4455           60004                           AD       FBANK                         	# FROM WHICH THE TC PRENVBSY WAS DONE) -2
016804,003582:    4456           04701        NVSUBUSY           TC       POSTJUMP                      	# TO BE ENTERED.
016805,003583:    4457           10577                           CADR     NVSUBSY1                      	#
016806,003584:    4460           02003        2K+3               OCT      2003                          	#
016807,003585: 
016808,003586:                                                                                          	# NVSUBSY1 MUST BE IN BANK 27 OR LOWER, SO IT WILL PUT CALLER TO SLEEP
016809,003587:                                                                                          	# WITH HIS PROPER SUPERBITS.
016810,003588: 
016811,003589: 04,2577                                           SETLOC   ENDSPMM    +1                 	#
016812,003590: 04,2577                                           COUNT    07/PIN                        	#
016813,003591: 
016814,003592: 04,2577           54001        NVSUBSY1           TS       L                             	#
016815,003593: 04,2600           04234                           TC       ISCADR+0                      	# ABORT IF CADRSTOR NOT= +0.
016816,003594: 04,2601           04240                           TC       ISLIST+0                      	# ABORT IF DSPLIST NOT= +0.
016817,003595: 04,2602           04410                           TC       RELDSPON                      	#
016818,003596: 04,2603           30001                           CA       L                             	#
016819,003597: 04,2604           55043                           TS       DSPLIST                       	#
016820,003598: 04,2605           05175        ENDNVBSY           TC       JOBSLEEP                      	#
016821,003599: 
016822,003600:                                                                                          	# NVSBWAIT IS A SPECIAL ENTRANCE FOR ROUTINES IN FIXED BANKS ONLY. IF
016823,003601:                                                                                          	# SYSTEM IS NOT BUSY, IT EXECUTES V/N AND RETURNS TO L+1 (L= LOC FROM
016824,003602:                                                                                          	# WHICH THE TC NVSBWAIT WAS DONE).  IF SYSTEM IS BUSY, IT PUTS CALLING JOB
016825,003603:                                                                                          	# TO SLEEP WITH L-1 GOING INTO LIST FOR EVENTUAL WAKING UP WHEN SYSTEM
016826,003604:                                                                                          	# IS NOT BUSY.
016827,003605: 
016828,003606:    4461                                           SETLOC   NVSUBUSY   +3                 	#
016829,003607:    4461                                           COUNT    02/PIN                        	#
016830,003608: 
016831,003609:    4461           22007        NVSBWAIT           LXCH     7                             	# ZERO NVMONOPT OPTIONS
016832,003610:    4462           54123                           TS       NVTEMP                        	#
016833,003611:    4463           35002                           CAF      BIT14                         	#
016834,003612:    4464           71021                           MASK     MONSAVE1                      	# EXTERNAL MONITOR BIT
016835,003613:    4465           61012                           AD       DSPLOCK                       	#
016836,003614:    4466           10000                           CCS      A                             	#
016837,003615:    4467           14471                           TCF      NVSBWT1                       	# BUSY
016838,003616:    4470           14200                           TCF      NVSBCOM                       	# FREE. NVSUB WILL SAVE L+1 FOR RETURN
016839,003617:                                                                                          	# AFTER EXECUTION.
016840,003618:    4471           24002        NVSBWT1            INCR     Q                             	# L+2.  PRENVBSY WILL PUT L-1 INTO LIST AND
016841,003619:    4472           14453                           TCF      PRENVBSY                      	# GO TO SLEEP.
016842,003620: 
016843,003621:                                                                                          	# RELDSP IS USED BY VBPROC, VBTERM, VBRQEXEC, VBRQWAIT, VBRELDSP, EXTENDED
016844,003622:                                                                                          	# VERB DISPATCHER, VBRESEQ, RECALTST.
016845,003623: 
016846,003624:                                                                                          	# RELDSP1 IS USED BY MONITOR SET UP, VBRELDSP.
016847,003625: 
016848,003626:    4473           56002        RELDSP             XCH      Q                             	# SET DSPLOCK TO +0, TURN RELDSP LIGHT
016850,003628:    4474           54144                           TS       RELRET                        	# OFF, SEARCH DSPLIST
016851,003629:    4475           45002                           CS       BIT14                         	#
016852,003630:    4476           00004                           INHINT                                 	#
016853,003631:    4477           71021                           MASK     MONSAVE1                      	#
016854,003632:    4500           55021                           TS       MONSAVE1                      	# TURN OFF EXTERNAL MONITOR BIT
016855,003633:    4501           11043                           CCS      DSPLIST                       	#
016856,003634:    4502           04504                           TC       +2                            	#
016857,003635:    4503           04507                           TC       RELDSP2                       	# LIST EMPTY
016858,003636:    4504           35021                           CAF      ZERO                          	#
016859,003637:    4505           57043                           XCH      DSPLIST                       	#
016860,003638:    4506           05201                           TC       JOBWAKE                       	#
016861,003639:    4507           00003        RELDSP2            RELINT                                 	#
016862,003640:    4510           45013                           CS       BIT5                          	# TURN OFF KEY RELEASE LIGHT
016863,003641:    4511           00006                           EXTEND                                 	# (BIT 5 OF CHANNEL 11)
016864,003642:    4512           03011                           WAND     DSALMOUT                      	#
016865,003643:    4513           35021                           CAF      ZERO                          	#
016866,003644:    4514           55012                           TS       DSPLOCK                       	#
016867,003645:    4515           00144                           TC       RELRET                        	#
016868,003646:    4516           56002        RELDSP1            XCH      Q                             	# SET DSPLOCK TO +0.  NO DSPLIST SEARCH.
016869,003647:    4517           54144                           TS       RELRET                        	# TURN KEY RLSE LIGHT OFF IF DSPLIST IS
016870,003648:                                                                                          	# EMPTY.  LEAVE KEY RLSE LIGHT ALONE IF 
016871,003649:                                                                                          	# DSPLIST IS NOT EMPTY.
016872,003650:    4520           11043                           CCS      DSPLIST                       	#
016873,003651:    4521           04523                           TC       +2                            	# +     NOT EMPTY.  LEAVE KEY RLSE LIGHT ALONE
016874,003652:    4522           04507                           TC       RELDSP2                       	# +0    EMPTY.  TURN OFF KEY RLSE LIGHT
016875,003653:    4523           35021                           CAF      ZERO                          	# -     NOT EMPTY.  LEAVE KEY RLSE LIGHT ALONE
016876,003654:    4524           55012                           TS       DSPLOCK                       	#
016877,003655:    4525           00144                           TC       RELRET                        	#
016878,003656: 
016879,003657:    4526                        ENDPINBF           EQUALS                                 	#
016880,003658: 

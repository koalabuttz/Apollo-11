024391,000037: 
024393,000039:                                                                                          	# PROGRAM DESCRIPTION S17.1 AND S17.2
024394,000040: 
024395,000041:                                                                                          	# FUNCTIONAL DESCRIPTION
024396,000042: 
024397,000043:                                                                                          	# THE TPI SEARCH ROUTINE DETERMINES THE MINIMUM TOTAL VELOCITY TRANSFER TRAJECTORY FROM A GIVEN TPI
024398,000044:                                                                                          	# MANEUVER TIME WITHIN THE CONSTRAINT OF A SAFE PERICENTER.  THIS VELOCITY IS THE SUM OF THE IMPULSIVE VELOCITIES
024399,000045:                                                                                          	# FOR THE TPI AND TPF MANEUVERS.
024400,000046: 
024401,000047:                                                                                          	# THE S17.1 ROUTINE EXTRAPOLATES THE STATE VECTORS OF BOTH VEHICLES TO THE TPI TIME AND COMPUTES THE
024402,000048:                                                                                          	# RELATIVE PHASE ANGLE BETWEEN THE VEHICLES, THE ALTITUDE DIFFERENCE (I.E. THE MAGNITUDE DIFFERENCE OF THE 
024403,000049:                                                                                          	# POSITION VECTORS) AND SELECTS A SEARCH SECTOR BASED ON THE SIGN OF THE ALTITUDE DIFFERENCE.
024404,000050: 
024405,000051:                                                                                          	# THE S17.2 ROUTINE FURTHER DEFINES THE SEARCH SECTOR BY COMPUTING ANGULAR LIMITS AND USES THE TIME THETA
024406,000052:                                                                                          	# SUBROUTINE TO COMPUTE THE SEARCH START AND END TIMES.  THE SEARCH IS THEN MADE IN AN ITERATIVE LOOP USING THE
024407,000053:                                                                                          	# LAMBERT SUBROUTINE TO COMPUTE THE VELOCITIES REQUIRED AT TPI TIME AND AT TPF TIME.  EXIT FROM THE SEARCH LOOP
024408,000054:                                                                                          	# IS MADE WHEN SOLUTION CRITERIA ARE MET (NORMAL EXIT) OR AS SOON AS IT IS EVIDENT THAT NO SOLUTION EXISTS IN
024409,000055:                                                                                          	# THE SECTOR SEARCHED.
024410,000056: 
024411,000057:                                                                                          	# CALLING SEQUENCE
024412,000058: 
024413,000059:                                                                                          	#       BOTH ROUTINES ARE CALLED IN INTERPRETIVE CODE AND RETURN VIA QPRET.  S17.1 HAS ONLY A NORMAL EXIT.
024414,000060:                                                                                          	#       S17.2 RETURNS VIA QPRET FOR NORMAL EXIT AND TO ALARUMS FOR ERROR EXIT.
024415,000061: 
024416,000062:                                                                                          	# SUBROUTINES CALLED
024417,000063: 
024418,000064:                                                                                          	#       CSMCONIC
024419,000065:                                                                                          	#       LEMCONIC
024420,000066:                                                                                          	#       TIMETHET
024421,000067:                                                                                          	#       INITVEL

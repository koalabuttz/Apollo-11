023267,000291: 
023268,000292:                                                                                          	# STABLE ORBIT MIDCOURSE PROGRAM (P39 AND P79)
023269,000293: 
023270,000294:                                                                                          	# MOD NO -1             LOG SECTION - STABLE ORBIT - P38-P39
023271,000295:                                                                                          	# MOD BY RUDNICKI.S     DATE 25JAN68
023272,000296: 
023273,000297:                                                                                          	# FUNCTIONAL DESCRIPTION
023274,000298: 
023275,000299:                                                                                          	#       P39 AND P79 CALCULATE THE REQUIRED DELTA V AND OTHER INITIAL
023276,000300:                                                                                          	#       CONDITIONS REQUIRED BY THE AGC TO MAKE A MIDCOURSE CORRECTION
023278,000302:                                                                                          	#       MANEUVER AFTER COMPLETING THE SOI MANEUVER BUT BEFORE MAKING
023279,000303:                                                                                          	#       THE SOR MANEUVER
023280,000304: 
023281,000305:                                                                                          	# CALLING SEQUENCE
023282,000306: 
023283,000307:                                                                                          	#       ASTRONAUT REQUEST THRU DSKY
023284,000308: 
023285,000309:                                                                                          	#       V37E39E         IF THIS VEHICLE IS ACTIVE VEHICLE
023286,000310:                                                                                          	#       V37E79E         IF OTHER VEHICLE IS ACTIVE VEHICLE
023287,000311: 
023288,000312:                                                                                          	# INPUT
023289,000313: 
023290,000314:                                                                                          	#       (1)  TPASS4     TIME OF INTERCEPT - SAVED FROM P38/P78
023291,000315:                                                                                          	#       (2)  TARGTIME   TIME THAT PASSIVE VEHICLE IS AT INTERCEPT POINT -
023292,000316:                                                                                          	#                       SAVED FROM P38/P78
023293,000317: 
023294,000318:                                                                                          	# OUTPUT
023295,000319: 
023296,000320:                                                                                          	#       (1)  TRKMKCNT   NUMBER OF MARKS
023297,000321:                                                                                          	#       (2)  TTOGO      TIME TO GO
023298,000322:                                                                                          	#       (3)  +MGA       MIDDLE GIMBAL ANGLE
023299,000323:                                                                                          	#       (4)  DELVLVC    DELTA VELOCITY AT MID - LOCAL VERTICAL COORDINATES
023300,000324: 
023301,000325:                                                                                          	# SUBROUTINES USED
023302,000326: 
023303,000327:                                                                                          	#       AVFLAGA
023304,000328:                                                                                          	#       AVFLAGP
023305,000329:                                                                                          	#       LOADTIME
023306,000330:                                                                                          	#       SELECTMU
023307,000331:                                                                                          	#       PRECSET
023308,000332:                                                                                          	#       S34/35.1
023309,000333:                                                                                          	#       MAINRTNE
023310,000334: 
023311,000335: 04,3166           04627        P39                TC       AVFLAGA                       	# THIS VEHICLE ACTIVE
023312,000336: 04,3167           00006                           EXTEND                                 	#
023313,000337: 04,3170           31422                           DCA      ATIGINC                       	#
023314,000338: 04,3171           03175                           TC       P39/P79A                      	#
023315,000339: 04,3172           04642        P79                TC       AVFLAGP                       	# OTHER VEHICLE ACTIVE
023316,000340: 04,3173           00006                           EXTEND                                 	#
023317,000341: 04,3174           31424                           DCA      PTIGINC                       	#
023318,000342: 04,3175           53764        P39/P79A           DXCH     KT                            	# TIME TO PREPARE FOR BURN
023319,000343: 04,3176           04647                           TC       P20FLGON                      	# SET UPDATFLG, TRACKFLG
023320,000344: 04,3177           06006                           TC       INTPRET                       	#
023321,000345: 04,3200           45014                           SET      CALL                          	#
023322,000346: 04,3201           04066                                    P39/79SW                      	#
023323,000347: 04,3202           10712                                    SELECTMU                      	# SELECT MU, CLEAR FINALFLG, GO TO VN1645
023324,000348: 04,3203           43234        P39/P79B           RTB      DAD                           	#
023325,000349: 04,3204           45510                                    LOADTIME                      	#
023326,000350: 04,3205           02364                                    KT                            	#
023327,000351: 04,3206           03413                           STORE    TIG                           	# TIG = T (PRESENT) + PREPARATION TIME
023329,000353: 04,3207           34041                           STCALL   TDEC1                         	# PRECISION UPDATE ACTIVE AND PASSIVE
023330,000354: 04,3210           45215                                    PRECSET                       	#       VEHICLES TO TIG
023331,000355: 04,3211           77624                           CALL                                   	#
023332,000356: 04,3212           74000                                    S34/35.1                      	# GET UNIT NORMAL
023333,000357: 04,3213           52145                           DLOAD    GOTO                          	#
023334,000358: 04,3214           02615                                    TARGTIME                      	#
023335,000359: 04,3215           11101                                    MAINRTNE                      	# CALCULATE DELTA V AND DELTA V (LV)
023336,000360: 

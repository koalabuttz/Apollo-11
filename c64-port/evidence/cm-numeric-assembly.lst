023128,000152: 04,2773           35015                           CAF      BIT3                          	# IMMEDIATE RETURN - BLANK R3
023129,000153: 04,2774           05526                           TCR      BLANKET                       	#
023130,000154: 04,2775           15217                           TCF      ENDOFJOB                      	#

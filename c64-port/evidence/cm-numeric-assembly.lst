059093,000002:                                                                                          	## Copyright:   Public domain.
059094,000003:                                                                                          	## Filename:    INFLIGHT_ALIGNMENT_ROUTINES.agc
059095,000004:                                                                                          	## Purpose:     Part of the source code for Colossus 2A, AKA Comanche 055.
059096,000005:                                                                                          	##              It is part of the source code for the Command Module's (CM)
059097,000006:                                                                                          	##              Apollo Guidance Computer (AGC), for Apollo 11.
059098,000007:                                                                                          	## Assembler:   yaYUL
059099,000008:                                                                                          	## Contact:     Ron Burkey <info@sandroid.org>.
059100,000009:                                                                                          	## Website:     www.ibiblio.org/apollo.
059101,000010:                                                                                          	## Pages:       1355-1364
059102,000011:                                                                                          	## Mod history: 2009-05-14 RSB  Adapted from the Colossus249/ file of the
059103,000012:                                                                                          	##                              same name, using Comanche055 page images.
059104,000013:                                                                                          	##              2016-12-22 RSB  Proofed comment text using octopus/ProoferComments
059105,000014:                                                                                          	##                              and corrected the errors found.
059106,000015:                                                                                          	##
059107,000016:                                                                                          	## This source code has been transcribed or otherwise adapted from digitized
059108,000017:                                                                                          	## images of a hardcopy from the MIT Museum.  The digitization was performed
059109,000018:                                                                                          	## by Paul Fjeld, and arranged for by Deborah Douglas of the Museum.  Many
059110,000019:                                                                                          	## thanks to both.  The images (with suitable reduction in storage size and
059111,000020:                                                                                          	## consequent reduction in image quality as well) are available online at
059112,000021:                                                                                          	## www.ibiblio.org/apollo.  If for some reason you find that the images are
059113,000022:                                                                                          	## illegible, contact me at info@sandroid.org about getting access to the 
059114,000023:                                                                                          	## (much) higher-quality images which Paul actually created.
059115,000024:                                                                                          	##
059116,000025:                                                                                          	## Notations on the hardcopy document read, in part:
059117,000026:                                                                                          	##
059118,000027:                                                                                          	##      Assemble revision 055 of AGC program Comanche by NASA
059119,000028:                                                                                          	##      2021113-051.  10:28 APR. 1, 1969  
059120,000029:                                                                                          	##
059121,000030:                                                                                          	##      This AGC program shall also be referred to as
059122,000031:                                                                                          	##                      Colossus 2A
059123,000032: 
059125,000034: 22,3510                                           BANK     22                            	#
059126,000035: 23,2000                                           SETLOC   INFLIGHT                      	#
059127,000036: 23,2000                                           BANK                                   	#
059128,000037: 
059129,000038: 23,3205  E5,1671                                  EBANK=   XSM                           	#
059130,000039: 
059131,000040:                                                                                          	# CALCGTA COMPUTES THE GYRO TORQUE ANGLES REQUIRED TO BRING THE STABLE MEMBER INTO THE DESIRED ORIENTATION.
059132,000041: 
059133,000042:                                                                                          	# THE INPUT IS THE DESIRED STABLE MEMBER COORDINATES REFERRED TO PRESENT STABLE MEMBER COORDINATES.  THE THREE
059134,000043:                                                                                          	# HALF-UNIT VECTORS ARE STORED AT XDC, YDC, AND ZDC.
059135,000044: 
059136,000045:                                                                                          	# THE OUTPUTS ARE THE THREE GYRO TORQUING ANGLES TO BE APPLIED TO THE Y, Z, AND X GYROS AND ARE STORED DP AT IGC,
059137,000046:                                                                                          	# MGC, AND OGC RESPECTIVELY.
059138,000047: 
059139,000048: 23,3205                                           COUNT    23/INFLT                      	#
059140,000049: 
059141,000050: 23,3205           71220        CALCGTA            ITA      DLOAD                         	# PUSHDOWN 00-03, 16D-27D, 34D-37D
059142,000051: 23,3206           00051                                    S2                            	# XDC = (XD1 XD2 XD3)
059143,000052: 23,3207           02714                                    XDC                           	# YDC = (YD1 YD2 YD3)
059144,000053: 23,3210           65325                           PDDL     PDDL                          	# ZDC = (ZD1 ZD2 ZD3)
059145,000054: 23,3211           15335                                    HI6ZEROS                      	#
059146,000055: 23,3212           02720                                    XDC        +4                 	#
059147,000056: 23,3213           55476                           DCOMP    VDEF                          	#
059148,000057: 23,3214           77656                           UNIT                                   	#
059149,000058: 23,3215           14027                           STODL    ZPRIME                        	# ZP = UNIT(-XD3 0 XD1) = (ZP1 ZP2 ZP3)
059150,000059: 23,3216           00027                                    ZPRIME                        	#
059151,000060: 
059152,000061: 23,3217           77742                           SR1                                    	#
059153,000062: 23,3220           14023                           STODL    SINTH                         	# SIN(IGC) = ZP1
059154,000063: 23,3221           00033                                    ZPRIME     +4                 	#
059155,000064: 23,3222           77742                           SR1                                    	#
059156,000065: 23,3223           34021                           STCALL   COSTH                         	# COS(IGC) = ZP3
059157,000066: 23,3224           47256                                    ARCTRIG                       	#
059158,000067: 
059159,000068: 23,3225           16762                           STODL    IGC                           	# Y GYRO TORQUING ANGLE   FRACTION OF REV.
059160,000069: 23,3226           02716                                    XDC        +2                 	#
059161,000070: 23,3227           77742                           SR1                                    	#
059162,000071: 23,3230           14023                           STODL    SINTH                         	# SIN(MGC) = XD2
059163,000072: 23,3231           00027                                    ZPRIME                        	#
059164,000073: 
059165,000074: 23,3232           65205                           DMP      PDDL                          	#
059166,000075: 23,3233           02720                                    XDC        +4                 	# PD00 = (ZP1)(XD3)
059167,000076: 23,3234           00033                                    ZPRIME     +4                 	#
059168,000077: 
059169,000078: 23,3235           45205                           DMP      DSU                           	#
059170,000079: 23,3236           02714                                    XDC                           	# MPAC = (ZP3)(XD1)
059171,000080: 23,3237           77626                           STADR                                  	#
059172,000081: 23,3240           43756                           STCALL   COSTH                         	# COS(MGC) = MPAC - PD00
059173,000082: 23,3241           47256                                    ARCTRIG                       	#
059175,000084: 23,3242           26764                           STOVL    MGC                           	# Z GYRO TORQUING ANGLE   FRACTION OF REV.
059176,000085: 23,3243           00027                                    ZPRIME                        	#
059177,000086: 23,3244           77641                           DOT                                    	#
059178,000087: 23,3245           02730                                    ZDC                           	#
059179,000088: 23,3246           24021                           STOVL    COSTH                         	# COS(OGC) = ZP . ZDC
059180,000089: 23,3247           00027                                    ZPRIME                        	#
059181,000090: 23,3250           77641                           DOT                                    	#
059182,000091: 23,3251           02722                                    YDC                           	#
059183,000092: 23,3252           34023                           STCALL   SINTH                         	# SIN(OGC) = ZP . YDC
059184,000093: 23,3253           47256                                    ARCTRIG                       	#
059185,000094: 
059186,000095: 23,3254           36760                           STCALL   OGC                           	# X GYRO TORQUING ANGLE   FRACTION OF REV.
059187,000096: 23,3255           00051                                    S2                            	#
059188,000097: 
059190,000099:                                                                                          	# ARCTRIG COMPUTES AN ANGLE GIVEN THE SINE AND COSINE OF THIS ANGLE.
059191,000100: 
059192,000101:                                                                                          	# THE INPUTS ARE SIN/4 AND COS/4 STORED DP AT SINTH AND COSTH.
059193,000102: 
059194,000103:                                                                                          	# THE OUTPUT IS THE CALCULATED ANGLE BETWEEN +.5 AND -.5 REVOLUTIONS AND STORED AT THETA.  THE OUTPUT IS ALSO
059195,000104:                                                                                          	# AVAILABLE AT MPAC.
059196,000105: 
059197,000106: 23,3256           51545        ARCTRIG            DLOAD    ABS                           	# PUSHDOWN  16D-21D
059198,000107: 23,3257           00023                                    SINTH                         	#
059199,000108: 23,3260           50025                           DSU      BMN                           	#
059200,000109: 23,3261           07474                                    QTSN45                        	# ABS(SIN/4) - SIN(45)/4
059201,000110: 23,3262           47271                                    TRIG1                         	# IF (-45,45) OR (135,-135)
059202,000111: 
059203,000112: 23,3263           72545                           DLOAD    SL1                           	# (45,135) OR (-135,-45)
059204,000113: 23,3264           00021                                    COSTH                         	#
059205,000114: 23,3265           75326                           ACOS     SIGN                          	#
059206,000115: 23,3266           00023                                    SINTH                         	#
059207,000116: 23,3267           00025                           STORE    THETA                         	# X = ARCCOS(COS) WITH SIGN(SIN)
059208,000117: 23,3270           77616                           RVQ                                    	#
059209,000118: 
059210,000119: 23,3271           72545        TRIG1              DLOAD    SL1                           	# (-45,45) OR (135,-135)
059211,000120: 23,3272           00023                                    SINTH                         	#
059212,000121: 23,3273           77736                           ASIN                                   	#
059213,000122: 23,3274           14025                           STODL    THETA                         	# X = ARCSIN(SIN) WITH SIGN(SIN)
059214,000123: 23,3275           00021                                    COSTH                         	#
059215,000124: 23,3276           77640                           BMN                                    	#
059216,000125: 23,3277           47302                                    TRIG2                         	# IF (135,-135)
059217,000126: 
059218,000127: 23,3300           43545                           DLOAD    RVQ                           	#
059219,000128: 23,3301           00025                                    THETA                         	# X = ARCSIN(SIN)   (-45,45)
059220,000129: 
059221,000130: 23,3302           75345        TRIG2              DLOAD    SIGN                          	# (135,-135)
059222,000131: 23,3303           15333                                    HIDPHALF                      	#
059223,000132: 23,3304           00023                                    SINTH                         	#
059224,000133: 23,3305           77625                           DSU                                    	#
059225,000134: 23,3306           00025                                    THETA                         	#
059226,000135: 23,3307           00025                           STORE    THETA                         	# X = .5 WITH SIGN(SIN) - ARCSIN(SIN)
059227,000136: 23,3310           77616                           RVQ                                    	#       (+) - (+) OR (-) - (-)
059228,000137: 
059230,000139:                                                                                          	# SMNB, NBSM, AND AXISROT, WHICH USED TO APPEAR HERE, HAVE BEEN
059231,000140:                                                                                          	# COMBINED IN A ROUTINE CALLED AX*SR*T, WHICH APPEARS AMONG THE POWERED
059232,000141:                                                                                          	# FLIGHT SUBROUTINES.
059233,000142: 
059235,000144:                                                                                          	# CALCGA COMPUTES THE CDU DRIVING ANGLES REQUIRED TO BRING THE STABLE MEMBER INTO THE DESIRED ORIENTATION.
059236,000145: 
059237,000146:                                                                                          	# THE INPUTS ARE  1) THE NAVIGATION BASE COORDINATES REFERRED TO ANY COORDINATE SYSTEM.  THE THREE HALF-UNIT
059238,000147:                                                                                          	# VECTORS ARE STORED AT XNB, YNB, AND ZNB.  2) THE DESIRED STABLE MEMBER COORDINATES REFERRED TO THE SAME
059239,000148:                                                                                          	# COORDINATE SYSTEM ARE STORED AT XSM, YSM, AND ZSM.
059240,000149: 
059241,000150:                                                                                          	# THE OUTPUTS ARE THE THREE CDU DRIVING ANGLES AND ARE STORED SP AT THETAD, THETAD +1, AND THETAD +2.
059242,000151: 
059243,000152: 23,3311           77601        CALCGA             SETPD                                  	# PUSHDOWN 00-05, 16D-21D, 34D-37D
059244,000153: 23,3312           00001                                    0                             	#
059245,000154: 23,3313           47375                           VLOAD    VXV                           	#
059246,000155: 23,3314           02714                                    XNB                           	# XNB = OGA (OUTER GIMBAL AXIS)
059247,000156: 23,3315           02700                                    YSM                           	# YSM = IGA (INNER GIMBAL AXIS)
059248,000157: 23,3316           41456                           UNIT     PUSH                          	# PD0 = UNIT(OGA X IGA) = MGA
059249,000158: 
059250,000159: 23,3317           44041                           DOT      ITA                           	#
059251,000160: 23,3320           02730                                    ZNB                           	#
059252,000161: 23,3321           00051                                    S2                            	#
059253,000162: 23,3322           24021                           STOVL    COSTH                         	# COS(OG) = MGA . ZNB
059254,000163: 23,3323           00001                                    0                             	#
059255,000164: 23,3324           77641                           DOT                                    	#
059256,000165: 23,3325           02722                                    YNB                           	#
059257,000166: 23,3326           34023                           STCALL   SINTH                         	# SIN(OG) = MGA . YNB
059258,000167: 23,3327           47256                                    ARCTRIG                       	#
059259,000168: 23,3330           26760                           STOVL    OGC                           	#
059260,000169: 23,3331           00001                                    0                             	#
059261,000170: 
059262,000171: 23,3332           50235                           VXV      DOT                           	# PROVISION FOR MG ANGLE OF 90 DEGREES
059263,000172: 23,3333           02714                                    XNB                           	#
059264,000173: 23,3334           02700                                    YSM                           	#
059265,000174: 23,3335           77752                           SL1                                    	#
059266,000175: 23,3336           24021                           STOVL    COSTH                         	# COS(MG) = IGA . (MGA X OGA)
059267,000176: 23,3337           02700                                    YSM                           	#
059268,000177: 23,3340           77641                           DOT                                    	#
059269,000178: 23,3341           02714                                    XNB                           	#
059270,000179: 23,3342           34023                           STCALL   SINTH                         	# SIN(MG) = IGA . OGA
059271,000180: 23,3343           47256                                    ARCTRIG                       	#
059272,000181: 23,3344           02764                           STORE    MGC                           	#
059273,000182: 
059274,000183: 23,3345           45246                           ABS      DSU                           	#

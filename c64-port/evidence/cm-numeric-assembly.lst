052221,002968: 01,2540           50120                           INDEX    FIXLOC                        	# SLOW IN THIS CASE, BUT SAVES STORAGE.)
052222,002969: 01,2541           30052                           CA       QPRET                         	#
052223,002970: 01,2542           12414                           TCF      MSTORE1                       	#
052224,002971: 
052225,002972:                                                                                          	# Page 1197
052226,002973:                                                                                          	# THE FOLLOWING OPERATIONS ARE AVAILABLE FOR ALTERING AND TESTING INTERPRETATIVE SWITCHES:
052227,002974:                                                                                          	#       00      BONSET          SET A SWITCH AND DO A GOTO IF IT WAS ON.
052228,002975:                                                                                          	#       01      SETGO           SET A SWITCH AND DO A GOTO.
052229,002976:                                                                                          	#       02      BOFSET          SET A SWITCH AND DOA GOTO IF IT WAS OFF
052230,002977:                                                                                          	#       03      SET             SET A SWITCH.
052231,002978:                                                                                          	#       04      BONINV          INVERT A SWITCH AND BRANCH IF IT WAS ON.
052232,002979:                                                                                          	#       05      INVGO           INVERT A SWITCH AND DO A GOTO.
052233,002980:                                                                                          	#       06      BOFINV          INVERT A SWITCH AND BRANCH IF IT WAS OFF
052234,002981:                                                                                          	#       07      INVERT          INVERT A SWITCH.
052235,002982:                                                                                          	#       10      BONCLR          CLEAR A SWITCH AND BRANCH IF IT WAS ON.
052236,002983:                                                                                          	#       11      CLRGO           CLEAR A SWITCH AND DO A GOTO.
052237,002984:                                                                                          	#       12      BOFCLR          CLEAR A SWITCH AND BRANCH IF IT WAS OFF.
052238,002985:                                                                                          	#       13      CLEAR           CLEAR A SWITCH.
052239,002986:                                                                                          	#       14      BON             BRANCH IF A SWITCH WAS ON.
052240,002987:                                                                                          	#       16      BOFF            BRANCH IF A SWITCH WAS OFF.
052241,002988:                                                                                          	# THE ADDRESS SUPPLIED WITH THE SWITCH INSTRUCTION IS INTERPRETED AS FOLLOWS:
052242,002989:                                                                                          	#       BITS 1-4        SWITCH BIT NUMBER (1-15).
052243,002990:                                                                                          	#       BITS 5-8        SWITCH OPERATION NUMBER
052244,002991:                                                                                          	#       BITS 9-         SWITCH WORD NUMBER (UP TO 64 SWITCH WORDS).
052245,002992:                                                                                          	# THE ADDRESS ITSELF IS MADE UP BY THE YUL SYSTEM ASSEMBLER.  THE BRANCH INSTRUCTIONS REQUIRE TWO
052246,002993:                                                                                          	# ADDRESSES, THE SECOND TAKEN AS THE DIRECT (OR INDIRECT IF IN ERASABLE) ADDRESS OF THE BRANCH.
052247,002994: 
052248,002995: 01,2543           35026        SWITCHES           CAF      LOW4                          	# LEAVE THE SWITCH BIT IN SWBIT.
052249,002996: 01,2544           70117                           MASK     POLISH                        	#
052250,002997: 01,2545           50000                           INDEX    A                             	#
052251,002998: 01,2546           35001                           CAF      BIT15                         	# (NUMBER FROM LEFT TO RIGHT.)
052252,002999: 01,2547           54131                           TS       SWBIT                         	#
052253,003000: 
052254,003001: 01,2550           35011                           CAF      BIT7                          	# LEAVE THE SWITCH NUMBER IN SWWORD.
052255,003002: 01,2551           00006                           EXTEND                                 	#
052256,003003: 01,2552           70117                           MP       POLISH                        	#
052257,003004: 01,2553           54130                           TS       SWWORD                        	#
052258,003005: 
052259,003006: 01,2554           00004                           INHINT                                 	# DURING SWITCH CHANGE SO RUPT CAN USE TOO
052260,003007: 01,2555           50000                           INDEX    A                             	# LEAVE THE SWITCH WORD ITSELF IN L.
052261,003008: 01,2556           30074                           CA       STATE                         	#
052262,003009: 01,2557           54002                           TS       Q                             	# Q WILL BE USED AS A CHANNEL.
052263,003010:                                                                                          	# Page 1198
052264,003011: 01,2560           35005                           CAF      BIT11                         	#
052265,003012: 01,2561           00006                           EXTEND                                 	# DISPATCH SWITCH BIT OPERATION AS IN BITS
052266,003013: 01,2562           70117                           MP       POLISH                        	# 7-8 OF POLISH.
052267,003014: 01,2563           72623                           MASK     B3TOB4                        	# GETS 4X2-BIT CODE.
052268,003015: 01,2564           50000                           INDEX    A                             	#
052269,003016: 01,2565           12566                           TCF      +1                            	#
052270,003017: 
052271,003018: 01,2566           30131                 +1        CA       SWBIT                         	# 00 -- SET SWITCH IN QUESTION.
052272,003019: 01,2567           00006                           EXTEND                                 	#
052273,003020: 01,2570           04002                           ROR      QCHAN                         	#
052274,003021: 01,2571           12600                           TCF      SWSTORE                       	#
052275,003022: 
052276,003023: 01,2572           30131                 +5        CA       SWBIT                         	# 01 -- INVERT SWITCH.
052277,003024: 01,2573           00006                           EXTEND                                 	#
052278,003025: 01,2574           06002                           RXOR     QCHAN                         	#
052279,003026: 01,2575           12600                           TCF      SWSTORE                       	#
052280,003027: 
052281,003028: 01,2576           40131                 +9D       CS       SWBIT                         	# 10 -- CLEAR.
052282,003029: 01,2577           70002                           MASK     Q                             	#
052283,003030: 01,2600           50130        SWSTORE            INDEX    SWWORD                        	#
052284,003031: 01,2601           54074                           TS       STATE                         	# NEW SWITCH WORD.
052285,003032: 
052286,003033:                                                                                          	# Page 1199
052287,003034: 01,2602           00003                 +13D      RELINT                                 	# 11 -- NOOP.
052288,003035: 01,2603           35003                           CAF      BIT13                         	#
052289,003036: 01,2604           00006                           EXTEND                                 	# DISPATCH SEQUENCE CHANGING OR BRANCING
052290,003037: 01,2605           70117                           MP       POLISH                        	# CODE.
052291,003038: 01,2606           72623                           MASK     B3TOB4                        	#
052292,003039: 01,2607           50000                           INDEX    A                             	#
052293,003040: 01,2610           12611                           TCF      +1                            	# ORIGINALLY STORED IN BITS 5-6
052294,003041: 
052295,003042: 01,2611           40002                 +1        CS       Q                             	# 00 -- BRANCH IF ON.
052296,003043: 01,2612           70131        TEST               MASK     SWBIT                         	#
052297,003044: 01,2613           10000                           CCS      A                             	#
052298,003045: 01,2614           12624                           TCF      SWSKIP                        	#
052299,003046: 
052300,003047: 01,2615           16664                 +5        TCF      SWBRANCH                      	# 01 -- GO TO.
052301,003048: 
052302,003049: 01,2616           12624                           TCF      SWSKIP                        	# HERE ONLY ON BIT 15.
052303,003050: 
052304,003051: 01,2617           05747                           TC       CCSHOLE                       	#
052305,003052: 01,2620           05747                           TC       CCSHOLE                       	#
052306,003053: 
052307,003054: 01,2621           30002                 +9D       CA       Q                             	# 10 -- BRANCH IF OFF.
052308,003055: 01,2622           12612                           TCF      TEST                          	#
052309,003056: 
052310,003057: 01,2623           00014        B3TOB4             OCT      0014                          	#
052311,003058: 01,2624           24164        SWSKIP             INCR     LOC                           	#
052312,003059: 
052313,003060: 01,2625  01,2543               SW/                EQUALS   SWITCHES                      	#
052314,003061: 
052315,003062: 01,2625           16030                 +13D      TCF      DANZIG                        	# 11 -- NOOP.
052316,003063: 
(End of include-file INTERPRETER.agc, resuming MAIN.agc)

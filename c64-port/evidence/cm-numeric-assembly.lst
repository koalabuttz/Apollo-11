001058,000912:                                                                                          	#                       CGC
001059,000913:                                                                                          	# 00116         OPTICS SWITCH ALTERED BEFORE 15 SEC ZERO        T4RUPT                                  ALARM
001060,000914:                                                                                          	#                       TIME ELAPSED.
001061,000915:                                                                                          	# 00117         OPTICS TORQUE REQUEST WITH OPTICS NOT           EXT VERB OPTICS CDU                     ALARM
001062,000916:                                                                                          	#                       AVAILABLE (OPTIND=-0)
001063,000917:                                                                                          	# 00120         OPTICS TORQUE REQUEST WITH OPTICS               T4RUPT                                  ALARM
001064,000918:                                                                                          	#                       NOT ZEROED
001065,000919:                                                                                          	# 00121         CDUS NO GOOD AT TIME OF MARK                    SXTMARK                                 ALARM
001066,000920:                                                                                          	# 00122         MARKING NOT CALLED FOR                          SXTMARK                                 ALARM
001067,000921:                                                                                          	# 00124         P17 TPI SEARCH - NO SAFE PERICTR HERE.          TPI SEARCH                              ALARM
001068,000922:                                                                                          	# 00205         BAD PIPA READING                                SERVICER                                ALARM
001069,000923:                                                                                          	# 00206         ZERO ENCODE NOT ALLOWED WITH COARSE ALIGN       IMU MODE SWITCHING                      ALARM
001070,000924:                                                                                          	#                       + GIMBAL LOCK
001071,000925:                                                                                          	# 00207         ISS TURNON REQUEST NOT PRESENT FOR 90 SEC       T4RUPT                                  ALARM
001072,000926:                                                                                          	# 00210         IMU NOT OPERATING                               IMU MODE SWITCH, IMU-2, R02, P51        ALARM,VARALARM
001073,000927:                                                                                          	# 00211         COARSE ALIGN ERROR - DRIVE > 2 DEGREES          IMU MODE SWITCH                         ALARM
001074,000928:                                                                                          	# 00212         PIPA FAIL BUT PIPA IS NOT BEING USED            IMU MODE SWITCH, T4RPT                  ALARM
001075,000929:                                                                                          	# 00213         IMU NOT OPERATING WITH TURN-ON REQUEST          T4RUPT                                  ALARM
001076,000930:                                                                                          	# 00214         PROGRAM USING IMU WHEN TURNED OFF               T4RUPT                                  ALARM
001077,000931:                                                                                          	# 00215         PREFERRED ORIENTATION NOT SPECIFIED             P52,P54                                 ALARM
001078,000932:                                                                                          	# 00217         BAD RETURN FROM STALL ROUTINES.                 CURTAINS                                ALARM2
001079,000933:                                                                                          	# 00220         IMU NOT ALIGNED - NO REFSMMAT                   R02,P51                                 VARALARM
001080,000934:                                                                                          	# 00401         DESIRED GIMBAL ANGLES YIELD GIMBAL LOCK         IMF ALIGN, IMU-2                        ALARM
001081,000935:                                                                                          	# 00404         TARGET OUT OF VIEW - TRUN ANGLE > 90 DEG        R52                                     PRIOLARM
001082,000936:                                                                                          	# 00405         TWO STARS NOT AVAILABLE                         P52,P54                                 ALARM
001083,000937:                                                                                          	# 00406         REND NAVIGATION NOT OPERATING                   R21,R23                                 ALARM
001084,000938:                                                                                          	# 00407         AUTO OPTICS REQUEST TRUN ANGLE > 50 DEG.        R52                                     ALARM
001085,000939:                                                                                          	# 00421         W-MATRIX OVERFLOW                               INTEGRV                                 VARALARM

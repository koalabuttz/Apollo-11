041247,001568: 
041249,001570:                                                                                          	# X(T1)-DV ITERATOR SUBROUTINE
041250,001571: 
041251,001572:                                                                                          	# DESCRIPTION
041252,001573:                                                                                          	#       COMPUTES A POST IMPULSE VELOCITY VECTOR (V2(T1)) WHICH REQUIRES A MINIMUM DV.
041253,001574: 
041254,001575:                                                                                          	# CALLING SEQUENCE
041255,001576:                                                                                          	#       L       CALL
041256,001577:                                                                                          	#       L+1             GAMDV10
041257,001578: 
041258,001579:                                                                                          	# NORMAL EXIT MODE
041259,001580:                                                                                          	#       AT L+2 OF CALLING SEQUENCE
041260,001581: 
041261,001582:                                                                                          	# ALARM EXIT MODE
041262,001583:                                                                                          	#       AT V2T1X WITH MPAC = OCTAL 605 FOR EXCESS ITERATIONS
041263,001584: 
041264,001585:                                                                                          	# SUBROUTINES CALLED
041265,001586:                                                                                          	#       DVCALC
041266,001587: 
041267,001588:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
041268,001589:                                                                                          	#    PUSHLIST
041269,001590:                                                                                          	#       02D             THETA1=BETA5*LAMBDA-1                                   TP      B17
041270,001591:                                                                                          	#       05D             THETA2=2*R(T1)*(LAMBDA-1)                               TP      B38/B36
041271,001592:                                                                                          	#       08D             THETA3=MU**.5/R(T1)                                     DP      B-4/B-5
041272,001593:                                                                                          	#       10D             X(T1)MIN=LOWER BOUND ON INDEPENDENT VARIABLE X(T1)      DP      B5
041273,001594:                                                                                          	#       12D             DX(T1)MAX=MAXIMUM DX(T1)                                DP      B5
041274,001595:                                                                                          	#       14D             X(T1)MAX=UPPER BOUND ON INDEPENDENT VARIABLE X(T1)      DP      B5
041275,001596:                                                                                          	#       16D             DX(T1)=ITERATOR INCREMENT                               DP      B5
041276,001597:                                                                                          	#    MPAC
041277,001598:                                                                                          	#       NONE
041278,001599:                                                                                          	#    OTHER
041279,001600:                                                                                          	#       V(T1)/          INITIAL VELOCITY VECTOR                                 VECTOR  B7/B5   METERS/CS
041280,001601:                                                                                          	#       RTEDVD          DELTA VELOCITY DESIRED                                  DP      B7/B5   METERS/CS
041281,001602:                                                                                          	#       UR1/            UNIT INITIAL VECTOR                                     VECTOR  B1
041282,001603:                                                                                          	#       UH/             UNIT HORIZONTAL VECTOR                                  VECTOR  B1
041283,001604:                                                                                          	#       X(T1)           COTANGENT OF INITIAL FLIGHT PATH ANGLE (FROM VERTICAL)  DP      B5
041284,001605:                                                                                          	#       F2RTE           TIME CRITICAL OR MINIMUM FUEL MODE INDICATOR            STATE AREA      0 MIN. FUEL, 1 MIN. TIME
041285,001606: 
041286,001607:                                                                                          	# OUTPUT
041287,001608:                                                                                          	#       V2(T1)/         POST IMPULSE INITIAL VELOCITY VECTOR                    VECTOR  B7/B5   METERS/CS
041288,001609:                                                                                          	#       DV              INITIAL VELOCITY CHANGE                                 DP      B7/B5   METERS/CS
041289,001610:                                                                                          	#       X(T1)           COTANGENT OF INITIAL FPA MEASURED FROM VERTICAL         DP      B5
041290,001611:                                                                                          	#       PCON            SEMI-LATUS RECTUM                                       DP      B28/B26 METERS
041291,001612: 
041292,001613:                                                                                          	# DEBRIS
041293,001614:                                                                                          	#    PUSHLIST
041294,001615:                                                                                          	#       00D             X(T1),,
041295,001616:                                                                                          	#       02D             THETA1
041296,001617:                                                                                          	#       05D             THETA2
041297,001618:                                                                                          	#       08D             THETA3
041298,001619:                                                                                          	#       10D             X(T1)MIN
041299,001620:                                                                                          	#       12D             DX(T1)MAX
041301,001622:                                                                                          	#       14D             X(T1)MAX
041302,001623:                                                                                          	#       16D             DX(T1)
041303,001624:                                                                                          	#       22D             DV,=PREVIOUS DV                                         DP      B7/B5
041304,001625:                                                                                          	#       24D             BETA9=X(T1)+1.1DX(T1)                                   DP      B5
041305,001626:                                                                                          	#       31D             GAMDV10 SUBROUTINE RETURN ADDRESS
041306,001627:                                                                                          	#       32D             DVCALC SUBROUTINE RETURN ADDRESS
041307,001628:                                                                                          	#       33D             V2T100 SUBROUTINE RETURN ADDRESS

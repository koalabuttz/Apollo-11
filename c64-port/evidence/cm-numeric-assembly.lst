017900,000435: 
017901,000436:                                                                                          	# CALCULATION OF THE MATRIX DEL......
017902,000437: 
017903,000438:                                                                                          	#       *      *               --T           *
017904,000439:                                                                                          	#       DEL = (IDMATRIX)COS(A)+UU (1-COS(A))+UX SIN(A)          SCALED 1
017905,000440: 
017906,000441:                                                                                          	#             -
017907,000442:                                                                                          	#       WHERE U IS A UNIT VECTOR (DP SCALED 2) ALONG THE AXIS OF ROTATION.
017908,000443:                                                                                          	#       A IS THE ANGLE OF ROTATION (DP SCALED 2)
017909,000444:                                                                                          	#                                          -
017910,000445:                                                                                          	#       UPON ENTRY THE STARTING ADDRESS OF U IS COF, AND A IS IN MPAC
017911,000446: 
017912,000447: 22,2530                                           COUNT    22/KALC                       	#
017913,000448: 
017914,000449: 22,2530           41401        DELCOMP            SETPD    PUSH                          	# MPAC CONTAINS THE ANGLE A
017915,000450: 22,2531           00001                                    0                             	#
017916,000451: 22,2532           65356                           SIN      PDDL                          	# PD0 = SIN(A)
017917,000452: 22,2533           41546                           COS      PUSH                          	# PD2 = COS(A)
017918,000453: 22,2534           65302                           SR2      PDDL                          	# PD2 = COS(A)                          $8
017919,000454: 22,2535           41021                           BDSU     BOVB                          	# PD4 = 1-COS(A)                        $2
017920,000455: 22,2536           15333                                    DPHALF                        	#
017921,000456: 22,2537           45712                                    SIGNMPAC                      	#
017922,000457: 
017923,000458:                                                                                          	# COMPUTE THE DIAGONAL COMPONENTS OF DEL
017924,000459: 
017925,000460: 22,2540           77725                           PDDL                                   	#
017926,000461: 22,2541           03343                                    COF                           	#
017927,000462: 22,2542           41316                           DSQ      DMP                           	#
017928,000463: 22,2543           00005                                    4                             	#
017929,000464: 22,2544           52415                           DAD      SL3                           	#
017931,000466: 22,2545           00003                                    2                             	#
017932,000467: 22,2546           77604                           BOVB                                   	#
017933,000468: 22,2547           45712                                    SIGNMPAC                      	#
017934,000469: 22,2550           17426                           STODL    DEL                           	# UX UX(U-COS(A)) +COS(A)               $1
017935,000470: 22,2551           03345                                    COF        +2                 	#
017936,000471: 22,2552           41316                           DSQ      DMP                           	#
017937,000472: 22,2553           00005                                    4                             	#
017938,000473: 22,2554           52415                           DAD      SL3                           	#
017939,000474: 22,2555           00003                                    2                             	#
017940,000475: 22,2556           77604                           BOVB                                   	#
017941,000476: 22,2557           45712                                    SIGNMPAC                      	#
017942,000477: 22,2560           17436                           STODL    DEL        +8D                	# UY UY(1-COS(A)) +COS(A)               $1
017943,000478: 22,2561           03347                                    COF        +4                 	#
017944,000479: 22,2562           41316                           DSQ      DMP                           	#
017945,000480: 22,2563           00005                                    4                             	#
017946,000481: 22,2564           52415                           DAD      SL3                           	#
017947,000482: 22,2565           00003                                    2                             	#
017948,000483: 22,2566           77604                           BOVB                                   	#
017949,000484: 22,2567           45712                                    SIGNMPAC                      	#
017950,000485: 22,2570           03446                           STORE    DEL        +16D               	# UZ UZ(1-COS(A)) +COS(A)               $1
017951,000486: 
017952,000487:                                                                                          	# COMPUTE THE OFF DIAGONAL TERMS OF DEL
017953,000488: 
017954,000489: 22,2571           41345                           DLOAD    DMP                           	#
017955,000490: 22,2572           03343                                    COF                           	#
017956,000491: 22,2573           03345                                    COF        +2                 	#
017957,000492: 22,2574           72405                           DMP      SL1                           	#
017958,000493: 22,2575           00005                                    4                             	#
017959,000494: 22,2576           41325                           PDDL     DMP                           	# D6    UX UY (1-COS A)                 $ 4
017960,000495: 22,2577           03347                                    COF        +4                 	#
017961,000496: 22,2600           00001                                    0                             	#
017962,000497: 22,2601           43206                           PUSH     DAD                           	# D8    UZ SIN A                        $ 4
017963,000498: 22,2602           00007                                    6                             	#
017964,000499: 22,2603           41112                           SL2      BOVB                          	#
017965,000500: 22,2604           45712                                    SIGNMPAC                      	#
017966,000501: 22,2605           17434                           STODL    DEL        +6                 	#
017967,000502: 22,2606           62421                           BDSU     SL2                           	#
017968,000503: 22,2607           77604                           BOVB                                   	#
017969,000504: 22,2610           45712                                    SIGNMPAC                      	#
017970,000505: 22,2611           17430                           STODL    DEL        +2                 	#
017971,000506: 22,2612           03343                                    COF                           	#
017972,000507: 22,2613           41205                           DMP      DMP                           	#
017973,000508: 22,2614           03347                                    COF        +4                 	#
017974,000509: 22,2615           00005                                    4                             	#
017975,000510: 22,2616           65352                           SL1      PDDL                          	# D6    UX UZ (1-COS A )                $ 4
017976,000511: 22,2617           03345                                    COF        +2                 	#
017977,000512: 22,2620           41405                           DMP      PUSH                          	# D8    UY SIN(A)
017978,000513: 22,2621           00001                                    0                             	#
017979,000514: 22,2622           62415                           DAD      SL2                           	#
017980,000515: 22,2623           00007                                    6                             	#
017982,000517: 22,2624           77604                           BOVB                                   	#
017983,000518: 22,2625           45712                                    SIGNMPAC                      	#
017984,000519: 22,2626           17432                           STODL    DEL        +4                 	# UX UZ (1-COS(A))+UY SIN(A)
017985,000520: 22,2627           62421                           BDSU     SL2                           	#
017986,000521: 22,2630           77604                           BOVB                                   	#
017987,000522: 22,2631           45712                                    SIGNMPAC                      	#
017988,000523: 22,2632           17442                           STODL    DEL        +12D               	# UX UZ (U-COS(A))-UY SIN(A)
017989,000524: 22,2633           03345                                    COF        +2                 	#
017990,000525: 22,2634           41205                           DMP      DMP                           	#
017991,000526: 22,2635           03347                                    COF        +4                 	#
017992,000527: 22,2636           00005                                    4                             	#
017993,000528: 22,2637           65352                           SL1      PDDL                          	# D6    UY UZ (1-COS(A))                $ 4
017994,000529: 22,2640           03343                                    COF                           	#
017995,000530: 22,2641           41405                           DMP      PUSH                          	# D8    UX SIN(A)
017996,000531: 22,2642           00001                                    0                             	#
017997,000532: 22,2643           62415                           DAD      SL2                           	#
017998,000533: 22,2644           00007                                    6                             	#
017999,000534: 22,2645           77604                           BOVB                                   	#
018000,000535: 22,2646           45712                                    SIGNMPAC                      	#
018001,000536: 22,2647           17444                           STODL    DEL        +14D               	# UY UZ(1-COS(A)) +UX SIN(A)
018002,000537: 22,2650           62421                           BDSU     SL2                           	#
018003,000538: 22,2651           77604                           BOVB                                   	#
018004,000539: 22,2652           45712                                    SIGNMPAC                      	#
018005,000540: 22,2653           03440                           STORE    DEL        +10D               	# UY UZ(1-COS(A)) -UX SIN(A)
018006,000541: 22,2654           77616                           RVQ                                    	#
018007,000542: 
018008,000543:                                                                                          	# DIRECTION COSINE MATRIX TO CDU ANGLE ROUTINE
018009,000544:                                                                                          	# X1 CONTAINS THE COMPLEMENT OF THE STARTING ADDRESS FOR MATRIX (SCALED 2)
018010,000545:                                                                                          	# LEAVES CDU ANGLES SCALED 2PI IN V(MPAC)
018011,000546:                                                                                          	# COS(MGA) WILL BE LEFT IN S1 (SCALED 1)
018012,000547: 
018013,000548:                                                                                          	# THE DIRECTION COSINE MATRIX RELATING S/C AXES TO STABLE MEMBER AXES CAN BE WRITTEN AS ***
018014,000549: 
018015,000550:                                                                                          	#       C =COS(THETA)COS(PSI)
018016,000551:                                                                                          	#        0
018017,000552: 
018018,000553:                                                                                          	#       C =-COS(THETA)SIN(PSI)COS(PHI)+SI (THETA)SIN(PHI)
018019,000554:                                                                                          	#        1
018020,000555: 
018021,000556:                                                                                          	#       C =COS(THETA)SIN(PSI)SIN(PHI)+S N(THETA)COS(PHI)
018022,000557:                                                                                          	#        2
018023,000558: 
018024,000559:                                                                                          	#       C =SIN(PSI)
018025,000560:                                                                                          	#        3
018026,000561: 
018027,000562:                                                                                          	#       C =COS(PSI)COS(PHI)
018028,000563:                                                                                          	#        4
018029,000564: 
018030,000565:                                                                                          	#       C =-COS(PSI)SIN(PHI)
018031,000566:                                                                                          	#        5
018032,000567: 
018033,000568:                                                                                          	#       C =-SIN(THETA)COS(PSI)
018034,000569:                                                                                          	#        6
018035,000570: 
018036,000571:                                                                                          	#       C =SIN(THETA)SIN(PSI)COS(PHI)+COS THETA)SIN(PHI)
018037,000572:                                                                                          	#        7
018039,000574:                                                                                          	#       C =-SIN(THETA)SIN(PSI)SIN(PHI)+CO (THETA)COS(PHI)
018040,000575:                                                                                          	#        8
018041,000576: 
018042,000577:                                                                                          	#       WHERE   PHI = OGA
018043,000578:                                                                                          	#               THETA = IGA
018044,000579:                                                                                          	#               PSI = MGA
018045,000580: 
018046,000581: 22,2655           67543        DCMTOCDU           DLOAD*   ARCSIN                        	#
018047,000582: 22,2656           00007                                    6,1                           	#
018048,000583: 22,2657           71406                           PUSH     COS                           	# PD +0         PSI
018049,000584: 22,2660           41152                           SL1      BOVB                          	#
018050,000585: 22,2661           45712                                    SIGNMPAC                      	#
018051,000586: 22,2662           00051                           STORE    S1                            	#
018052,000587: 22,2663           57543                           DLOAD*   DCOMP                         	#
018053,000588: 22,2664           00015                                    12D,1                         	#
018054,000589: 22,2665           67471                           DDV      ARCSIN                        	#
018055,000590: 22,2666           00051                                    S1                            	#
018056,000591: 22,2667           51123                           PDDL*    BPL                           	# PD +2         THETA
018057,000592: 22,2670           00001                                    0,1                           	# MUST CHECK THE SIGN OF COS(THETA)
018058,000593: 22,2671           44703                                    OKTHETA                       	# TO DETERMINE THE PROPER QUADRANT
018059,000594: 22,2672           57545                           DLOAD    DCOMP                         	#
018060,000595: 22,2673           43244                           BPL      DAD                           	#
018061,000596: 22,2674           44700                                    SUHALFA                       	#
018062,000597: 22,2675           15333                                    DPHALF                        	#
018063,000598: 22,2676           77650                           GOTO                                   	#
018064,000599: 22,2677           44702                                    CALCPHI                       	#
018065,000600: 22,2700           77625        SUHALFA            DSU                                    	#
018066,000601: 22,2701           15333                                    DPHALF                        	#
018067,000602: 22,2702           77606        CALCPHI            PUSH                                   	#
018068,000603: 22,2703           57543        OKTHETA            DLOAD*   DCOMP                         	#
018069,000604: 22,2704           00013                                    10D,1                         	#
018070,000605: 22,2705           67471                           DDV      ARCSIN                        	#
018071,000606: 22,2706           00051                                    S1                            	#
018072,000607: 22,2707           51123                           PDDL*    BPL                           	# PUSH DOWN PHI
018073,000608: 22,2710           00011                                    8D,1                          	#
018074,000609: 22,2711           44723                                    OKPHI                         	#
018075,000610: 22,2712           57545                           DLOAD    DCOMP                         	# PUSH UP PHI
018076,000611: 22,2713           43244                           BPL      DAD                           	#
018077,000612: 22,2714           44720                                    SUHALFAP                      	#
018078,000613: 22,2715           15333                                    DPHALF                        	#
018079,000614: 22,2716           77650                           GOTO                                   	#
018080,000615: 22,2717           44724                                    VECOFANG                      	#
018081,000616: 22,2720           52025        SUHALFAP           DSU      GOTO                          	#
018082,000617: 22,2721           15333                                    DPHALF                        	#
018083,000618: 22,2722           44724                                    VECOFANG                      	#
018084,000619: 22,2723           77745        OKPHI              DLOAD                                  	# PUSH UP PHI
018085,000620: 22,2724           43466        VECOFANG           VDEF     RVQ                           	#
018086,000621: 
018088,000623:                                                                                          	# ROUTINE FOR TERMINATING AUTOMATIC MANEUVERS
018089,000624: 
018090,000625: 22,2725           00004        NOGOM2             INHINT                                 	# THIS LOCATION ACCESSED BY A BZMF NOGO -2
018091,000626: 22,2726           04662                           TC       BANKCALL                      	#
018092,000627: 22,2727           40155                           CADR     ZEROEROR                      	#
018093,000628: 
018094,000629: 22,2730           00004        NOGO               INHINT                                 	#
018095,000630: 22,2731           04526                           TC       STOPRATE                      	#
018096,000631: 
018097,000632:                                                                                          	# TERMINATE MANEUVER
018098,000633: 22,2732           35016                           CAF      TWO                           	# NOTE - ALL RETURNS ARE NOW MADE VIA
018099,000634: 22,2733           05245                           TC       WAITLIST                      	# GOODEND
018100,000635: 22,2734  E6,1661                                  EBANK=   BCDU                          	#
018101,000636: 22,2734           02006 42066                     2CADR    ENDMANU                       	#
018102,000637: 
018103,000638: 22,2736           15217                           TCF      ENDOFJOB                      	#

047138,000757: 
047139,000758: 17,3536           31455        YBYPASS            CA       YWORD1                        	#
047140,000759: 17,3537           55456                           TS       YWORD2                        	#
047141,000760: 17,3540           35021                           CAF      ZERO                          	#
047142,000761: 17,3541           55463                           TS       BLAST2                        	#
047143,000762: 
047145,000764:                                                                                          	#                                       SORT THE JET ON-TIMES
047146,000765: 
047147,000766:                                                                                          	# AT THIS POINT ALL THE CHANNEL COMMANDS AND JET ON-TIMES HAVE BEEN DETERMINED.  IN SUMMARY THESE ARE-
047148,000767: 
047149,000768:                                                                                          	#       RWORD1
047150,000769:                                                                                          	#       RWORD2          BLAST
047151,000770: 
047152,000771:                                                                                          	#       PWORD1
047153,000772:                                                                                          	#       PWORD2          BLAST1
047154,000773: 
047155,000774:                                                                                          	#       YWORD1
047156,000775:                                                                                          	#       YWORD2          BLAST2
047157,000776: 
047158,000777:                                                                                          	# IN THIS SECTION THE JET ON-TIMES ARE SORTED AND THE SEQUENCE OF T6 INTERRUPTS IS DETERMINED.  TO FACILITATE
047159,000778:                                                                                          	# THE SORTING PROCESS AND THE T6 PROGRAM, THE VARIABLES BLAST, BLAST1, BLAST2, ARE RESERVED AS DOUBLE PRECISION
047160,000779:                                                                                          	# WORDS.  THE LOWER PART OF THESE WORDS CONTAIN A BRANCH INDEX ASSOCIATED WITH THE ROTATION AXIS OF THE HIGHER
047161,000780:                                                                                          	# ORDER WORD.
047162,000781: 
047163,000782: 17,3542           35021        T6SETUP            CAF      ZERO                          	# BRANCH INDEX FOR ROLL
047164,000783: 17,3543           55460                           TS       BLAST      +1                 	#
047165,000784: 17,3544           35015                           CAF      FOUR                          	# BRANCH INDEX FOR PITCH
047166,000785: 17,3545           55462                           TS       BLAST1     +1                 	#
047167,000786: 17,3546           35024                           CAF      ELEVEN                        	# BRANCH INDEX FOR YAW
047168,000787: 17,3547           55464                           TS       BLAST2     +1                 	#
047169,000788: 
047170,000789: 17,3550           41457                           CS       BLAST                         	#
047171,000790: 17,3551           61461                           AD       BLAST1                        	#
047172,000791: 17,3552           00006                           EXTEND                                 	#
047173,000792: 17,3553           63577                           BZMF     DXCHT12                       	# T1 GR T2
047174,000793: 17,3554           41461        CHECKT23           CS       BLAST1                        	#
047175,000794: 17,3555           61463                           AD       BLAST2                        	#
047176,000795: 17,3556           00006                           EXTEND                                 	#
047177,000796: 17,3557           63603                           BZMF     DXCHT23                       	#
047178,000797: 17,3560           41461        CALCDT6            CS       BLAST1                        	#
047179,000798: 17,3561           27463                           ADS      BLAST2                        	#
047180,000799: 17,3562           41457                           CS       BLAST                         	#
047181,000800: 17,3563           27461                           ADS      BLAST1                        	# END OF SORTING PROCEDURE
047182,000801: 17,3564           00006                           EXTEND                                 	# RESET T5LOC TO BEGIN PHASE1
047183,000802: 17,3565           33576                           DCA      RCS2CADR                      	#
047184,000803: 17,3566           53313                           DXCH     T5LOC                         	#
047185,000804: 17,3567           45017        ENDJETS            CS       BIT1                          	# RESET BIT1 FOR INITIALIZATION OF
047186,000805: 17,3570           71501                           MASK     RCSFLAGS                      	# T6 PROGRAM
047187,000806: 17,3571           55501                           TS       RCSFLAGS                      	#
047188,000807: 17,3572           45021                           CS       ZERO                          	# RESET T5PHASE FOR PHASE1
047189,000808: 17,3573           55465                           TS       T5PHASE                       	#
047190,000809: 17,3574           15333                           TCF      RESUME                        	# RESUME INTERRUPTED PROGRAM
047191,000810: 
047192,000811: 17,3575  E6,1510                                  EBANK=   KMPAC                         	#
047193,000812: 17,3575           02122 42066  RCS2CADR           2CADR    RCSATT                        	#
047194,000813: 
047196,000815: 17,3577           53460        DXCHT12            DXCH     BLAST                         	#
047197,000816: 17,3600           53462                           DXCH     BLAST1                        	#
047198,000817: 17,3601           53460                           DXCH     BLAST                         	#
047199,000818: 17,3602           13554                           TCF      CHECKT23                      	#
047200,000819: 
047201,000820: 17,3603           53462        DXCHT23            DXCH     BLAST1                        	#
047202,000821: 17,3604           53464                           DXCH     BLAST2                        	#
047203,000822: 17,3605           53462                           DXCH     BLAST1                        	#
047204,000823: 17,3606           41457                           CS       BLAST                         	#
047205,000824: 17,3607           61461                           AD       BLAST1                        	#
047206,000825: 17,3610           00006                           EXTEND                                 	#
047207,000826: 17,3611           63613                           BZMF     +2                            	#
047208,000827: 17,3612           13560                           TCF      CALCDT6                       	#
047209,000828: 17,3613           53460                           DXCH     BLAST                         	#
047210,000829: 17,3614           53462                           DXCH     BLAST1                        	#
047211,000830: 17,3615           53460                           DXCH     BLAST                         	#
047212,000831: 17,3616           13560                           TCF      CALCDT6                       	#
047213,000832: 

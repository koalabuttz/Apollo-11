061938,000313: 01,3756           26156                           ADS      POINTER                       	# THE TABLE
061939,000314: 
061940,000315: 01,3757           33557                           CA       RTRNCADR                      	# THIS WILL BE OUR LAST TIME THROUGH THE
061941,000316: 01,3760           54707                           TS       GOLOC      +2                 	# EVEN TABLE , SO AFTER IT  GET THE NEXT
061942,000317:                                                                                          	# GROUP
061943,000318: 01,3761           13657                           TCF      CONTBL2                       	# SO LET:S GET THE SECOND ENTRY IN THE TBL
061944,000319: 
061945,000320: 01,3762     0154               TEMPPHS            EQUALS   MPAC                          	#
061946,000321: 01,3762     0155               TEMP2G             EQUALS   MPAC       +1                 	#
061947,000322: 01,3762     0156               POINTER            EQUALS   MPAC       +2                 	#
061948,000323: 01,3762     0157               TEMPSWCH           EQUALS   MPAC       +3                 	#
061949,000324: 01,3762     0705               GOLOC              EQUALS   VAC5       +20D               	#
061950,000325: 01,3762     7715               MINUS2             EQUALS   NEG2                          	#
061951,000326: 01,3762     6043               OCT177             EQUALS   LOW7                          	#
061952,000327: 
061953,000328: 01,3762           03755        PHS2CADR           GENADR   PHSPART2                      	#
061954,000329: 01,3763           03533        PRT2CADR           GENADR   GETPART2                      	#

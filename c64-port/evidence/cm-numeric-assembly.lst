032251,001806:                                                                                          	# NAME          S40.9 - VTOGAIN (AIMPOINT MANEUVERS ONLY)
032252,001807:                                                                                          	# FUNCTION      (1) GENERATES REQUIRED VELOCITY AND VELOCITY-TO-BE-GAINED
032253,001808:                                                                                          	#               VECTORS FOR USE DURING AIMPOINT MANEUVERS
032254,001809:                                                                                          	#               (2) UPDATES THE B VECTOR WHICH IS USED IN THE FINAL 
032255,001810:                                                                                          	#               CALCULATION OF EXTRAPOLATING THE VELOCITY-TO-BE-GAINED
032256,001811:                                                                                          	# CALLING SEQ   VIA FINDVAC AS NEW JOB.
032257,001812:                                                                                          	# INPUT         RNIT    -       ACTIVE VEHICLE RADIUS VECTOR IN METERS AT +29.
032258,001813:                                                                                          	#               VNIT    -       ACTIVE VEHICLE VELOCITY VECTOR IN METERS/CS AT +7
032259,001814:                                                                                          	#               VRPREV  -       LAST COMPUTED VELOCITY REQUIRED VECTOR IN
032260,001815:                                                                                          	#                               METERS/CS AT +7.
032261,001816:                                                                                          	#               NOMTIG  -       TIME OF IGN.  USED IN TARGETTING ROUTINES %+28"
032262,001817:                                                                                          	#               DELLT4  -       TRANSFER TIME FROM PIPTIME TO TARGET %+28"
032263,001818:                                                                                          	#               TNIT    -       TIME OF RNIT AND VNIT IN CS AT +28
032264,001819:                                                                                          	#               GDT/2   -       HALF OF VELOCITY GAINED IN DELTA T TIME DUE TO
032265,001820:                                                                                          	#                               ACCERERATION OF GRAVITY IN METERS/CS AT +7.
032266,001821:                                                                                          	#               DELVREF -       CHANGE IN VELOCITY DURING LAST 2 SEC IN
032267,001822:                                                                                          	#                               METERS/CS AT +7.
032268,001823:                                                                                          	#               NORMSW          SET=CENTRAL ANGLE BETWEEN RTARG AND RTIG IS BETWEEN
032269,001824:                                                                                          	#                               165 TO 195 DEGREES
032270,001825:                                                                                          	#                               RESET=CENTRAL ANGLE OUTSIDE CONE DESCRIBED ABOVE
032271,001826:                                                                                          	# OUTPUT        VGTEMP  -       VELOCITY TO BE GAINED VECTOR IN METERS/CS AT +7.
032272,001827:                                                                                          	#               COGA    -       INPUT OF INITIAL GUESS FOR LAMBERT FROM S40.1 O
032273,001828:                                                                                          	#                               OR PREVIOUS PASS THRU S40.9
032274,001829:                                                                                          	#               GOBL/2  -       OBLATENESS TERM IN AVG GRAV CALC-GOBL*RSQ/MU
032275,001830:                                                                                          	#               VRPREV  -       VELOCITY REQUIRED VECTOR IN METERS/CS AT +7.
032276,001831:                                                                                          	#               BDT     -       B VECTOR IN METERS/CS AT +7.

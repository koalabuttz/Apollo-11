000907,000761:                                                                                          	#                       LOADED.
000908,000762: 
000909,000763:                                                                                          	# -K-
000910,000764: 
000912,000766: 
000913,000767:                                                                                          	# TIME (HR, MIN, SEC)   00XXX. HR               DP      BIT 1 OF LOW REGISTER =
000914,000768:                                                                                          	#                       000XX. MIN                        -2
000915,000769:                                                                                          	#                       0XX.XX SEC                      10   SEC
000916,000770:                                                                                          	#                       (DECIMAL ONLY.
000917,000771:                                                                                          	#                       MAX MIN COMP = 59
000918,000772:                                                                                          	#                       MAX SEC COMP = 59.99
000919,000773:                                                                                          	#                       MAX CAPACITY = 745 HRS
000920,000774:                                                                                          	#                                       39 MINS

009554,000037: 
009556,000039:                                                                                          	# PROGRAM NAME - SXTMARK                                        DATE - 5 APRIL 1967
009557,000040:                                                                                          	# PROGRAM MODIFIED BY 258/278 PROGRAMMERS                       LOG SECTION SXTMARK
009558,000041:                                                                                          	# MOD BY - R. MELANSON TO ADD DOCUMENTATION                     ASSEMBLY SUNDISK REV. 116
009559,000042:                                                                                          	# 
009560,000043:                                                                                          	# FUNCTIONAL DESCRIPTION-
009561,000044: 
009562,000045:                                                                                          	#       SXTMARK IS CALLED FROM INTERNAL ROUTINES WHICH MAY REQUIRE STAR OR LANDMARK MARKINGS BY THE ASTRONAUT.  IF
009563,000046:                                                                                          	#       THE MARK SYSTEM IS NOT IN USE, SXTMARK RESERVES A VAC AREA FOR MARKING AND REQUESTS EXECUTION OF THE MKVB51
009564,000047:                                                                                          	#       ROUTINE VIA THE EXECUTIVE JOB PRIORITY LIST.  R21 USES THIS ROUTINE TO DETERMINE IF THE MARK SYSTEM CAN BE
009565,000048:                                                                                          	#       USED.  IF YES, SXTMARK RETURNS TO R21 TO PERFORM ITS OWN MARK REQUESTS VIA THE V51 FLASH.
009566,000049: 
009567,000050:                                                                                          	# CALLING SEQUENCE-
009568,000051: 
009569,000052:                                                                                          	#       CAF     (NO. MARK REQUESTS IN BITS 1-3 OF A)
009570,000053:                                                                                          	#       TC      BANKCALL
009571,000054:                                                                                          	#       CADR    SXTMARK
009572,000055: 
009573,000056:                                                                                          	# NORMAL EXIT MODE-
009574,000057: 
009575,000058:                                                                                          	#       SWRETURN
009576,000059: 
009577,000060:                                                                                          	# ALARM OR ABORT EXIT MODE-
009578,000061: 
009579,000062:                                                                                          	#       ABORT
009580,000063: 
009581,000064:                                                                                          	# OUTPUT-
009582,000065: 
009583,000066:                                                                                          	#       1)      MARKSTAT CONTAINS MARK VALUE (BITS 14-12) AND VAC AREA ADDRESS
009584,000067:                                                                                          	#       2)      QPRET = VAC AREA POINTER VALUE
009585,000068:                                                                                          	#       3)      1ST WORD OF RESERVED VAC AREA SET TO +0
009586,000069:                                                                                          	#       4)      PRIO32 PLACED IN A REGISTER
009587,000070: 
009588,000071:                                                                                          	# ERASABLE INITIALIZATION-
009589,000072: 
009590,000073:                                                                                          	#       1)      BITS 1-3 OF A = NO. MARKS REQUESTED
009591,000074:                                                                                          	#       2)      BITS 2,3 OF EXTVBACT = 0
009592,000075:                                                                                          	#       3)      A VAC AREA MUST BE AVAILABLE (WORD 1 = ADDRESS OF VAC AREA)
009593,000076: 
009594,000077:                                                                                          	# DEBRIS-
009595,000078: 
009596,000079:                                                                                          	#       A,Q,L,RUPTREG1,MARKSTAT,QPRET,BIT2 OF EXTVBACT
009597,000080: 
009598,000081: 13,2036                                           BANK     13                            	#
009599,000082: 07,2000                                           SETLOC   SXTMARKE                      	#
009600,000083: 07,2000                                           BANK                                   	#
009601,000084: 
009602,000085: 07,2002  E7,1725                                  EBANK=   MRKBUF1                       	#
009603,000086: 07,2002                                           COUNT    07/SXTMK                      	#
009604,000087: 
009605,000088: 07,2002           00004        SXTMARK            INHINT                                 	#
009606,000089: 07,2003           54070                           TS       RUPTREG1                      	# NUMBER OF MARKS WANTED
009607,000090: 
009608,000091: 07,2004           36211                           CAF      SIX                           	# BIT2 = MARKING SYSTEM IN USE
009609,000092: 07,2005           71044                           MASK     EXTVBACT                      	# BIT3 = EXTENDED VERB IN PROGRESS
009610,000093: 07,2006           10000                           CCS      A                             	#
009611,000094: 07,2007           02013                           TC       MKABORT                       	# SET THEREFORE ABORT
009613,000096: 07,2010           35016                           CAF      BIT2                          	# NOT SET
009614,000097: 07,2011           27044                           ADS      EXTVBACT                      	# SET IT, RESET IN ENDMARK
009615,000098: 07,2012           02015                           TC       MARKOK                        	# YES, FIND VAC AREA
009616,000099: 
009617,000100: 07,2013           07755        MKABORT            TC       BAILOUT                       	#
009618,000101: 07,2014           01211                           OCT      01211                         	#
009619,000102: 07,2015           10400        MARKOK             CCS      VAC1USE                       	# FIND VAC AREA
009620,000103: 07,2016           02031                           TC       MKVACFND                      	#
009621,000104: 07,2017           10454                           CCS      VAC2USE                       	#
009622,000105: 07,2020           02031                           TC       MKVACFND                      	#
009623,000106: 07,2021           10530                           CCS      VAC3USE                       	#
009624,000107: 07,2022           02031                           TC       MKVACFND                      	#
009625,000108: 07,2023           10604                           CCS      VAC4USE                       	#
009626,000109: 07,2024           02031                           TC       MKVACFND                      	#
009627,000110: 07,2025           10660                           CCS      VAC5USE                       	#
009628,000111: 07,2026           02031                           TC       MKVACFND                      	#
009629,000112: 07,2027           07755                           TC       BAILOUT                       	#
009630,000113: 07,2030           01207                           OCT      01207                         	#
009631,000114: 
009632,000115: 07,2031           65016        MKVACFND           AD       TWO                           	# ADDRESS OF VAC AREA
009633,000116: 07,2032           55330                           TS       MARKSTAT                      	#
009634,000117: 07,2033           50000                           INDEX    A                             	#
009635,000118: 07,2034           54052                           TS       QPRET                         	# STORE NEXT AVAILABLE MARK SLOT
009636,000119: 
009637,000120: 07,2035           35021                           CAF      ZERO                          	# SHOW VAC AREA OCCUPIED
009638,000121: 07,2036           51330                           INDEX    MARKSTAT                      	#
009639,000122: 07,2037           53777                           TS       0          -1                 	#
009640,000123: 
009641,000124: 07,2040           05364                           TC       CHECKMM                       	# BACKUP MARK ROUTINE USES SXTMARK
009642,000125: 07,2041           00065                           MM       53         B-14               	#
009643,000126: 07,2042           12044                           TCF      +2                            	#
009644,000127: 07,2043           14675                           TCF      SWRETURN                      	#
009645,000128: 07,2044           05364                           TC       CHECKMM                       	#
009646,000129: 07,2045           00066                           MM       54         B-14               	#
009647,000130: 07,2046           12050                           TCF      +2                            	#
009648,000131: 07,2047           14675                           TCF      SWRETURN                      	#
009649,000132: 07,2050           35004                           CAF      BIT12                         	# DESIRED NUMBER OF MARKS IN 12-14
009650,000133: 07,2051           00006                           EXTEND                                 	#
009651,000134: 07,2052           70070                           MP       RUPTREG1                      	#
009652,000135: 07,2053           56001                           XCH      L                             	#
009653,000136: 07,2054           27330                           ADS      MARKSTAT                      	#
009654,000137: 
009655,000138: 07,2055           37667                           CAF      PRIO32                        	# ENTER MARK JOB
009656,000139: 07,2056           05134                           TC       NOVAC                         	#
009657,000140: 07,2057     1330                                  EBANK=   MARKSTAT                      	#
009658,000141: 07,2057           02347 16062                     2CADR    MKVB51                        	#
009659,000142: 
009660,000143: 07,2061           00003                           RELINT                                 	#
009661,000144: 07,2062           14675                           TCF      SWRETURN                      	# SAME AS MODEEXIT
009662,000145: 

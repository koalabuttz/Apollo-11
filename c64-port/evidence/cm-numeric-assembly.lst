005778,000210: 06,2133           01010                           WRITE    OUT0                          	#
005779,000211: 
005780,000212: 06,2134           32041                           CAF      120MRUPT                      	# SET FOR NEXT CDRVE
005781,000213: 06,2135           12074                           TCF      SETTIME4                      	#

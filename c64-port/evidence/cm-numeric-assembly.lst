016566,003344: 40,3446           03213                           TC       DSPDECVN                      	# IF MODREG IS + OR +0, DISPLAY MODREG
016567,003345: 40,3447           03451                           TC       +2                            	# IF MODREG IS -NZ, DO NOTHING

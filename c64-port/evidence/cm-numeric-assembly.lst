059328,000237: 23,3411           02760                                    STARAD     +18D,1             	#
059329,000238: 23,3412           77656                           UNIT                                   	# 12D   VA = UNIT(S1 X S2)
059330,000239: 23,3413           06760                           STORE    STARAD     +18D,1             	#       STARAD +06D     VB = UNIT(S1 X S2)
059331,000240: 23,3414           77773                           VLOAD*                                 	#

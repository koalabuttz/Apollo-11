061777,000152: 01,3617           54707                           TS       GOLOC      +2                 	# VARIABLE TYPE OF PHASE
061778,000153: 
061779,000154: 01,3620           30154                           CA       TEMPPHS                       	# MAKE THE PHASE LOOK RIGHT FOR THE TABLE
061780,000155: 01,3621           76043                           MASK     OCT177                        	# PART OF THIS VARIABLE PHASE
061781,000156: 01,3622           54154                           TS       TEMPPHS                       	#
061782,000157: 
061783,000158: 01,3623           00006                           EXTEND                                 	#

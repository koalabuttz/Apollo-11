001033,000887:                                                                                          	#                       (MAX 328.0)                     METERS/CENTI-SEC
001034,000888: 
001035,000889:                                                                                          	# -ZZ-
001036,000890:                                                                                          	# DP FRACTIONAL         .XXXXX                  DP      BIT 1 OF HIGH REGISTER =

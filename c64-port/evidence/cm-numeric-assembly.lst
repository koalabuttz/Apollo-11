051485,002232: 00,3055           13133                           TCF      SMALL                         	# COUNT -15D.
051486,002233: 
051487,002234: 00,3056           13065                           TCF      LARGE                         	# (THIS IS USUALLY THE CASE.)
051488,002235: 
051489,002236: 00,3057           45025                           CS       THIRTEEN                      	# IF THE SHIFT COUNT WAS EXACTLY 14, SET
051490,002237: 00,3060           54135                           TS       MPTEMP                        	# THE PRE-DIVIDE NORM COUNT TO -13D.
051491,002238: 

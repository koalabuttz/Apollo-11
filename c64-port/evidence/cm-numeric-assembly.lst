031591,001146: 
031592,001147:                                                                                          	# MOD NO2                               LOG SECTION P40-P47
031593,001148:                                                                                          	# MOD BY ZELDIN
031594,001149: 
031595,001150:                                                                                          	# FUNCTIONAL DESCRIPTION
031596,001151:                                                                                          	#       COMPUTE INITIAL THRUST DIRECTION(UT) AND INITIAL VALUE OF VG
031597,001152:                                                                                          	#       VECTOR(VGTIG).
031598,001153: 
031599,001154:                                                                                          	# CALLING SEQUENCE
031600,001155:                                                                                          	#       L       CALL
031601,001156:                                                                                          	#       L+1             S40.1
031602,001157: 
031603,001158:                                                                                          	# NORMAL EXIT MODE
031604,001159:                                                                                          	#       AT L+2 OF CALLING SEQUENCE (GOTO L+2) NORMAL RETURN OR
031605,001160:                                                                                          	#       ERROR RETURN IF NOSOFLAG =1
031606,001161: 
031607,001162:                                                                                          	# SUBROUTINES CALLED
031608,001163:                                                                                          	#       CSMPREC
031609,001164:                                                                                          	#       INITVEL
031610,001165:                                                                                          	#       CALCGRAV
031611,001166:                                                                                          	#       MIDGIM
031612,001167: 
031613,001168:                                                                                          	# ALARM OR ABORT EXIT MODES
031614,001169:                                                                                          	#       L+2 OF CALLING SEQUENCE, UNSOLVABLE CONIC IF NOSOFLAG=1
031615,001170: 
031616,001171:                                                                                          	# ERASABLE INITIALIZATION REQUIRED
031617,001172:                                                                                          	#       WEIGHT/G        ANTICIPATED MAG. OF VEHICLE MASS        SP B16 KGM
031618,001173:                                                                                          	#       XDELVFLG        1=DELTA-V MANEUVER, 0=AIMPT STEER
031619,001174:                                                                                          	#   IF DELTA-V MANEUVER
031620,001175:                                                                                          	#       DELVSIN         SPECIFIED DELTA-V REQUIRED IN
031621,001176:                                                                                          	#                       INERTIAL COORDS. OF ACTIVE VEHICLE
031622,001177:                                                                                          	#                       AT TIME OF IGNITION             VECTOR B7 M/CS
031623,001178:                                                                                          	#       DELVSAB         MAG. OF DELVSIN                 DP B7 M/CS
031624,001179:                                                                                          	#       RTIG            POSITION AT TIME OF IGNITION    VECTOR B29 M
031625,001180:                                                                                          	#       VTIG            VELOCITY AT TIME OF IGNITION    VECTOR B7 M/CS
031626,001181:                                                                                          	#       CSTEER = 0                                      DP
031627,001182:                                                                                          	#   IF AIMPOINT STEERING
031628,001183:                                                                                          	#   IF AIMPT STEER
031629,001184:                                                                                          	#       TIG             TIME OF IGNITION                DP B28 CS
031630,001185:                                                                                          	#       RTARG           POSITION TARGET TIME            VECTOR B29 M
031631,001186:                                                                                          	#       CSTEER = ECSTEER (GR 0)                         DP B1
031633,001188:                                                                                          	#       TPASS4 - TIME OF ARRIVAL AT AIMPOINT
031634,001189: 
031635,001190:                                                                                          	# OUTPUT
031636,001191:                                                                                          	#       UT              1/2 UNIT VECTOR ALIGNED WITH THRUST DIRECTION IN REF COOR
031637,001192:                                                                                          	#       VGTIG           INITIAL VALUE OF VELOCITY
031638,001193:                                                                                          	#                       TO BE GAINED (INERT. COORD.)            VECTOR B7 M/CS
031639,001194:                                                                                          	#       DELVLVC         VGTIG IN LOC. VERT. COORDS.             B7 M/CS
031640,001195:                                                                                          	#       F               NOMINAL THRUST FOR ENG USED FOR S40.13  DP B7 M-NEWT
031641,001196:                                                                                          	#       BDT             V REQUIRED AT TIG -V REQUIRED AT (TIG-2SEC)
031642,001197:                                                                                          	#       -GDT            FOR S40.13                              VECT B7 M/CS
031643,001198:                                                                                          	#       RTIG            CALC IN S40.1B (AIMPT) FOR S40.2,3      VECTOR B29M
031644,001199:                                                                                          	#                       POSITION AT TIME OF IGNITION

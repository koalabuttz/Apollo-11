005815,000247: 06,2166           05333                           TC       RESUME                        	#
005816,000248: 
005817,000249: 06,2167           00006        QUIKOFF            EXTEND                                 	#
005818,000250: 06,2170           01010                           WRITE    OUT0                          	#
005819,000251: 06,2171           35002                           CAF      BIT14                         	# RESET DSRUPTSW TO SEND DISPLAY NEXT PASS
005820,000252: 06,2172           12146                           TCF      QUIKRUPT                      	#
005821,000253: 
005822,000254: 06,2173           22400        11,14,9            OCT      22400                         	#
005823,000255: 
005825,000257:                                                                                          	# PROGRAM NAME:  IMUMON
005826,000258: 
005827,000259:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM IS ENTERED EVERY 480 MS.  IT DETECTS CHANGES OF THE IMU STATUS BITS IN
005828,000260:                                                                                          	# CHANNEL 30 AND CALLS THE APPROPRIATE SUBROUTINES.  THE BITS PROCESSED AND THEIR RELEVANT SUBROUTINES ARE:
005829,000261: 
005830,000262:                                                                                          	#       FUNCTION                BIT     SUBROUTINE CALLED
005831,000263:                                                                                          	#       --------                ---     -----------------
005832,000264:                                                                                          	#       TEMP IN LIMITS           15     TLIM
005833,000265:                                                                                          	#       ISS TURN-ON REQUEST      14     ITURNON
005834,000266:                                                                                          	#       IMU FAIL                 13     IMUFAIL (SETISSW)
005835,000267:                                                                                          	#       IMU CDU FAIL             12     ICDUFAIL (SETISSW)
005836,000268:                                                                                          	#       IMU CAGE                 11     IMUCAGE
005837,000269:                                                                                          	#       IMU OPERATE               9     IMUOP
005838,000270: 
005839,000271:                                                                                          	# THE LAST SAMPLED STATE OF THESE BITS IS LEFT IN IMODES30.  ALSO, EACH SUBROUTINE CALLED FINDS THE NEW
005840,000272:                                                                                          	# VALUE OF THE BIT IN A, WITH Q SET TO THE PROPER RETURN LOCATION, NXTIFAIL.
005841,000273: 
005842,000274:                                                                                          	# CALLING SEQUENCE:  T4RUPT EVERY 480 MILLISECONDS.
005843,000275: 
005844,000276:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
005845,000277: 
005846,000278:                                                                                          	# SUBROUTINES CALLED:  TLIM, ITURNON, SETISSW, IMUCAGE, IMUOP.
005847,000279: 
005848,000280:                                                                                          	# ERASABLE INITIALIZATION:
005849,000281:                                                                                          	#       FRESH START OR RESTART WITH NO GROUPS ACTIVE:  C(IMODES30) = OCT 37411.
005850,000282:                                                                                          	#       RESTART WITH ACTIVE GROUPS:     C(IMODES30) = (B(IMODES30)AND(OCT 00035)) PLUS OCT 37400.
005851,000283:                                                                                          	#                                       THIS LEAVES IMU FAIL BITS INTACT.
005852,000284: 
005853,000285:                                                                                          	# ALARMS:  NONE.
005854,000286: 
005855,000287:                                                                                          	# EXIT:  TNONTEST.
005856,000288: 
005857,000289:                                                                                          	# OUTPUT:  UPDATED IMODES30 WITH CHANGES PROCESSED BY APPROPRIATE SUBROUTINE.
005858,000290: 
005859,000291: 06,2174           31320        IMUMON             CA       IMODES30                      	# SEE IF THERE HAS BEEN A CHANGE IN THE
005860,000292: 06,2175           00006                           EXTEND                                 	# RELEVANT BITS OF CHAN 30.
005861,000293: 06,2176           06030                           RXOR     CHAN30                        	# CHECK IF BITS 9,11-15 CHANGED
005862,000294: 06,2177           72743                           MASK     30RDMSK                       	#
005863,000295: 06,2200           00006                           EXTEND                                 	#
005864,000296: 06,2201           12231                           BZF      TNONTEST                      	# NO CHANGE IN STATUS.
005865,000297: 
005866,000298: 06,2202           54070                           TS       RUPTREG1                      	# SAVE BITS WHICH HAVE CHANGED.
005867,000299: 06,2203           23320                           LXCH     IMODES30                      	# UPDATE IMODES30.
005868,000300: 06,2204           00006                           EXTEND                                 	#
005869,000301: 06,2205           06001                           RXOR     LCHAN                         	#
005870,000302: 06,2206           55320                           TS       IMODES30                      	#
005871,000303: 
005872,000304: 06,2207           45017                           CS       ONE                           	#
005873,000305: 06,2210           56070                           XCH      RUPTREG1                      	#
005874,000306: 06,2211           00006                           EXTEND                                 	#
005876,000308: 06,2212           62507                           BZMF     TLIM                          	# CHANGE IN IMU TEMP.
005877,000309: 06,2213           12215                           TCF      NXTIFBIT                      	# BEGIN BIT SCAN.
005878,000310: 
005879,000311: 06,2214           65017                 -1        AD       ONE                           	# (RE-ENTERS HERE FROM NXTIFAIL.)
005880,000312: 06,2215           24070        NXTIFBIT           INCR     RUPTREG1                      	# ADVANCE BIT POSITION NUMBER.
005881,000313: 06,2216           60000                 +1        DOUBLE                                 	#
005882,000314: 06,2217           54000                           TS       A                             	# SKIP IF OVERFLOW.
005883,000315: 06,2220           12215                           TCF      NXTIFBIT                      	# LOOK FOR BIT.
005884,000316: 
005885,000317: 06,2221           56071                           XCH      RUPTREG2                      	# SAVE OVERFLOW-CORRECTED DATA.
005886,000318: 06,2222           50070                           INDEX    RUPTREG1                      	# SELECT NEW VALUE OF THIS BIT.
005887,000319: 06,2223           35002                           CAF      BIT14                         	#
005888,000320: 06,2224           71320                           MASK     IMODES30                      	#
005889,000321: 06,2225           50070                           INDEX    RUPTREG1                      	#
005890,000322: 06,2226           02737                           TC       IFAILJMP                      	#
005891,000323: 
005892,000324: 06,2227           10071        NXTIFAIL           CCS      RUPTREG2                      	# PROCESS ANY ADDITIONAL CHANGES.
005893,000325: 06,2230           12214                           TCF      NXTIFBIT   -1                 	#
005894,000326: 
005896,000328:                                                                                          	# PROGRAM NAME:  TNONTEST.
005897,000329: 
005898,000330:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM HONORS REQUESTS FOR ISS INITIALIZATION.  ISS TURN-ON (CHANNEL 30 BIT 14)
005899,000331:                                                                                          	# AND ISS OPERATE (CHANNEL 30 BIT 9) REQUESTS ARE TREATED AS A PAIR AND PROCESSING TAKES PLACE .480 SECONDS
005900,000332:                                                                                          	# AFTER EITHER ONE APPEARS.  THIS INITIALIZATION TAKES ON ONE OF THE FOLLOWING THREE FORMS:
005901,000333: 
005902,000334:                                                                                          	#       1) ISS TURN-ON:  IN THIS SITUATION THE COMPUTER IS OPERATING WHEN THE ISS IS TURNED ON.  NOMINALLY,
005903,000335:                                                                                          	#       BOTH ISS TURN-ON AND ISS OPERATE APPEAR.  THE PLATFORM IS CAGED FOR 90 SECONDS AND THE ICDU'S ZEROED
005904,000336:                                                                                          	#       SO THAT AT THE END OF THE PROCESS THE GIMBAL LOCK MONITOR WILL FUNCTION PROPERLY.
005905,000337: 
005906,000338:                                                                                          	#       2) ICDU INITIALIZATION:  IN THIS CASE THE COMPUTER WAS PROBABLY TURNED ON WITH THE ISS IN OPERATE OR
005907,000339:                                                                                          	#       A FRESH START WAS DONE WITH THE ISS IN OPERATE.  IN THIS CASE ONLY ISS OPERATE IS ON.  THE ICDU'S ARE
005908,000340:                                                                                          	#       ZEROED SO THE GIMBAL LOCK MONITOR WILL FUNCTION.  AN EXCEPTION IS IF THE ISS IS IN GIMBAL LOCK AFTER
005909,000341:                                                                                          	#       A RESTART, THE ICDU'S WILL NOT BE ZEROED.
005910,000342: 
005911,000343:                                                                                          	#       3) RESTART WITH RESTARTABLE PROGRAM USING THE IMU:  IN THIS CASE, NO INITIALIZATION TAKES PLACE SINCE
005912,000344:                                                                                          	#       IT IS ASSUMED THAT THE USING PROGRAM DID THE INITIALIZATION AND THEREFORE T4RUPT SHOULD NOT INTERFERE.
005913,000345: 
005914,000346:                                                                                          	# IMODES30 BIT 7 IS SET = 1 BY THE FIRST BIT (CHANNEL 30 BIT 14 OR 9) WHICH ARRIVES.  FOLLOWING THIS. TNONTEST IS
005915,000347:                                                                                          	# ENTERED, FINDS BIT 7 = 1 BUT BIT 8 = 0, SO IT SETS BIT 8 = 1 AND EXITS.  THE NEXT TIME IT FINDS BIT 8 = 1 AND
005916,000348:                                                                                          	# PROCEEDS, SETTING BITS 8 AND 7 = 0.  AT PROCTNON, IF ISS TURN-ON REQUEST IS PRESENT, THE ISS IS CAGED (ZERO +
005917,000349:                                                                                          	# COARSE).  IF ISS OPERATE IS NOT PRESENT PROGRAM ALARM 00213 IS ISSUED.  AT THE END OF A 90 SECOND CAGE, BIT 2
005918,000350:                                                                                          	# OF IMODES30 IS TESTED.  IF IT IS = 1, ISS TURN-ON WAS NOT PRESENT FOR THE ENTIRE 90 SECONDS.  IN THAT CASE, IF
005919,000351:                                                                                          	# THE ISS TURN-ON REQUEST IS PRESENT THE 90 SECOND WAIT IS REPEATED,  OTHERWISE NO ACTION OCCURS UNLESS A PROGRAM
005920,000352:                                                                                          	# WAS WAITING FOR THE INITIALIZATION IN WHICH CASE THE PROGRAM IS GIVEN AN IMUSTALL ERROR RETURN.  IF THE DELAY
005921,000353:                                                                                          	# WENT PROPERLY, THE ISS DELAY OUTBIT IS SENT AND THE ICDU'S ZEROED.  A TASK IS INITIATED TO REMOVE THE PIPA FAIL
005922,000354:                                                                                          	# INHIBIT BIT IN 10.24 SECONDS.  IF A MISSION PROGRAM WAS WAITING IT IS INFORMED VIA ENDIMU.
005923,000355: 
005924,000356:                                                                                          	# AT PROCTNON, IF ONLY ISS OPERATE IS PRESENT (OPONLY), THE CDU'S ARE ZEROED UNLESS THE PLATFORM IS IN COARSE
005925,000357:                                                                                          	# ALIGN (= GIMBAL LOCK HERE) OR A MISSION PROGRAM IS USING THE IMU (IMUSEFLG = 1).
005926,000358: 
005927,000359:                                                                                          	# CALLING SEQUENCE:  T4RUPT EVERY 480 MILLISECONDS AFTER IMUMON.
005928,000360: 
005929,000361:                                                                                          	# JOBS OR TASKS INITIATED:  1) ENDTNON, 90 SECONDS AFTER CAGING STARTED.  2) ISSUP, 4 SECONDS AFTER CAGING DONE.
005930,000362:                                                                                          	#       3) PFAILOK, 10.24 SECONDS AFTER INITIALIZATION COMPLETED.  4) UNZ2, 320 MILLISECONDS AFTER ZEROING
005931,000363:                                                                                          	#       STARTED.
005932,000364: 
005933,000365:                                                                                          	# SUBROUTINES CALLED: CAGESUB, CAGESUB2, ZEROICDU, ENDIMU, IMUBAD, NOATTOFF, SETISSW, VARDELAY.
005934,000366: 
005935,000367:                                                                                          	# ERASABLE INITIALIZATION:  SEE IMUMON.
005936,000368: 
005937,000369:                                                                                          	# ALARMS:  PROGRAM ALARM 00213 IF ISS TURN-ON REQUESTED WITHOUT ISS OPERATE.
005938,000370: 
005939,000371:                                                                                          	# EXIT:  ENDTNON EXITS TO C33TEST.  TASKS HAVING TO DO WITH INITIALIZATION EXIT AS FOLLOWS:  MISSION PROGRAM
005940,000372:                                                                                          	# WAITING AND INITIALIZATION COMPLETE, EXIT TO ENDIMU, MISSION PROGRAM WAITING AND INITIALIZATION FAILED, EXIT TO
005941,000373:                                                                                          	# IMUBAD, IMU NOT IN USE, EXIT TO TASKOVER.
005942,000374: 
005943,000375:                                                                                          	# OUTPUT:  ISS INITIALIZED.
005944,000376: 
005945,000377: 06,2231           41320        TNONTEST           CS       IMODES30                      	# AFTER PROCESSING ALL CHANGES, SEE IF IT
005947,000379: 06,2232           75011                           MASK     BIT7                          	# IS TIME TO ACT ON A TURN-ON SEQUENCE.
005948,000380: 06,2233           10000                           CCS      A                             	#
005949,000381: 06,2234           12367                           TCF      C33TEST                       	# NO - EXAMINE CHANNEL 33.
005950,000382: 
005951,000383: 06,2235           35010                           CAF      BIT8                          	# SEE IF FIRST SAMPLE OR SECOND.
005952,000384: 06,2236           71320                           MASK     IMODES30                      	#
005953,000385: 06,2237           10000                           CCS      A                             	#
005954,000386: 06,2240           12244                           TCF      PROCTNON                      	# REACT AFTER SECOND SAMPLE.
005955,000387: 
005956,000388: 06,2241           35010                           CAF      BIT8                          	# IF FIRST SAMPLE, SET BIT TO REACT NEXT
005957,000389: 06,2242           27320                           ADS      IMODES30                      	# TIME.
005958,000390: 06,2243           12367                           TCF      C33TEST                       	#
005959,000391: 
005960,000392:                                                                                          	# PROCESS IMU TURN-ON REQUESTS AFTER WAITING 1 SAMPLE FOR ALL SIGNALS TO ARRIVE.
005961,000393: 
005962,000394: 06,2244           42757        PROCTNON           CS       BITS7&8                       	#
005963,000395: 06,2245           71320                           MASK     IMODES30                      	#
005964,000396: 06,2246           55320                           TS       IMODES30                      	#
005965,000397: 06,2247           75002                           MASK     BIT14                         	# SEE IF TURN-ON REQUEST.
005966,000398: 06,2250           10000                           CCS      A                             	#
005967,000399: 06,2251           12342                           TCF      OPONLY                        	# OPERATE ON ONLY.
005968,000400: 
005969,000401: 06,2252           41320                           CS       IMODES30                      	# IF TURN-ON REQUEST, WE SHOULD HAVE IMU
005970,000402: 06,2253           75007                           MASK     BIT9                          	# OPERATE.
005971,000403: 06,2254           10000                           CCS      A                             	#
005972,000404: 06,2255           12260                           TCF      +3                            	#
005973,000405: 
005974,000406: 06,2256           05650                           TC       ALARM                         	# ALARM IF NOT.
005975,000407: 06,2257           00213                           OCT      213                           	#
005976,000408: 
005977,000409: 06,2260           02717                 +3        TC       CAGESUB                       	#
005978,000410: 
005979,000411: 06,2261           32764                           CAF      90SECS                        	#
005980,000412: 06,2262           05245                           TC       WAITLIST                      	#
005981,000413: 06,2263  E3,1474                                  EBANK=   CDUIND                        	#
005982,000414: 06,2263           02270 14063                     2CADR    ENDTNON                       	#
005983,000415: 
005984,000416: 06,2265           12367                           TCF      C33TEST                       	#
005985,000417: 
005986,000418: 06,2266           32764        RETNON             CAF      90SECS                        	#
005987,000419: 06,2267           05272                           TC       VARDELAY                      	#
005988,000420: 
005989,000421: 06,2270           45016        ENDTNON            CS       BIT2                          	# RESET TURN-ON REQUEST FAIL BIT.
005990,000422: 06,2271           71320                           MASK     IMODES30                      	#
005991,000423: 06,2272           57320                           XCH      IMODES30                      	#
005992,000424: 06,2273           75016                           MASK     BIT2                          	# IF IT WAS OFF, SEND ISS DELAY COMPLETE.
005993,000425: 06,2274           00006                           EXTEND                                 	#
005994,000426: 06,2275           12310                           BZF      ENDTNON2                      	#
005996,000428: 06,2276           35002                           CAF      BIT14                         	# IF IT WAS ON AND TURN-ON REQUEST NOW
005997,000429: 06,2277           71320                           MASK     IMODES30                      	# PRESENT, RE-ENTER 90 SEC DELAY IN WL.
005998,000430: 06,2300           00006                           EXTEND                                 	#
005999,000431: 06,2301           12266                           BZF      RETNON                        	#
006000,000432: 
006001,000433: 06,2302           40074                           CS       STATE                         	# IF IT IS NOT ON NOW, SEE IF A PROG WAS
006002,000434: 06,2303           75010                           MASK     IMUSEFLG                      	# WAITING.
006003,000435: 06,2304           10000                           CCS      A                             	#
006004,000436: 06,2305           15324                           TCF      TASKOVER                      	#
006005,000437: 06,2306           04701                           TC       POSTJUMP                      	#
006006,000438: 06,2307           17522                           CADR     IMUBAD                        	# UNSUCCESSFUL TURN-ON.
006007,000439: 
006008,000440: 06,2310           35001        ENDTNON2           CAF      BIT15                         	# SEND ISS DELAY COMPLETE.
006009,000441: 06,2311           00006                           EXTEND                                 	#
006010,000442: 06,2312           05012                           WOR      CHAN12                        	# TURN OFF ISS DELAY COUNTER
006011,000443: 06,2313           04740                           TC       IBNKCALL                      	# TURN OFF NO ATT LAMP.
006012,000444: 06,2314           17151                           CADR     NOATTOFF                      	#
006013,000445: 
006014,000446: 06,2315           05521        UNZ2               TC       ZEROICDU                      	#
006015,000447: 
006016,000448: 06,2316           45027                           CS       BITS4&5                       	# REMOVE ZERO AND COARSE.
006017,000449: 06,2317           00006                           EXTEND                                 	#
006018,000450: 06,2320           03012                           WAND     CHAN12                        	#
006019,000451: 
006020,000452: 06,2321           35005                           CAF      BIT11                         	# WAIT 10 SECS FOR CTRS TO FIND GIMBALS
006021,000453: 06,2322           05272                           TC       VARDELAY                      	#
006022,000454: 
006023,000455: 06,2323           42754        ISSUP              CS       OCT54                         	# REMOVE CAGING, IMU FAIL INHIBIT, AND
006024,000456: 06,2324           71320                           MASK     IMODES30                      	# ICDUFAIL INHIBIT FLAGS.
006025,000457: 06,2325           55320                           TS       IMODES30                      	#
006026,000458: 
006027,000459: 06,2326           45012                           CS       BIT6                          	# ENABLE DAP
006028,000460: 06,2327           71321                           MASK     IMODES33                      	#
006029,000461: 06,2330           55321                           TS       IMODES33                      	#
006030,000462: 
006031,000463: 06,2331           02665                           TC       SETISSW                       	# ISS WARNING MIGHT HAVE BEEN INHIBITED.
006032,000464: 
006033,000465: 06,2332           45001                           CS       BIT15                         	# REMOVE IMU DELAY COMPLETE DISCRETE.
006034,000466: 06,2333           00006                           EXTEND                                 	#
006035,000467: 06,2334           03012                           WAND     CHAN12                        	#
006036,000468: 
006037,000469: 06,2335           35045                           CAF      4SECS                         	# DONT ENABLE PROG ALARM ON PIP FAIL FOR
006038,000470: 06,2336           05245                           TC       WAITLIST                      	# ANOTHER 4 SECS.
006039,000471: 06,2337  E3,1474                                  EBANK=   CDUIND                        	#
006040,000472: 06,2337           03137 16063                     2CADR    PFAILOK                       	#
006041,000473: 
006042,000474: 06,2341           15324                           TCF      TASKOVER                      	#
006043,000475: 
006044,000476: 06,2342           35014        OPONLY             CAF      BIT4                          	#
006046,000478: 06,2343           00006                           EXTEND                                 	# IF OPERATE ON ONLY AND WE ARE IN COARSE
006047,000479: 06,2344           02012                           RAND     CHAN12                        	# ALIGN, DONT ZERO THE CDUS BECAUSE WE
006048,000480: 06,2345           10000                           CCS      A                             	# MIGHT BE IN GIMBAL LOCK. USE V41N20 TO
006049,000481: 06,2346           12367                           TCF      C33TEST                       	# RECOVER.
006050,000482: 
006051,000483: 06,2347           35010                           CAF      IMUSEFLG                      	# OTHERWISE, ZERO THE COUNTERS
006052,000484: 06,2350           70074                           MASK     STATE                         	# UNLESS SOMEONE IS USING THE IMU.
006053,000485: 06,2351           10000                           CCS      A                             	#
006054,000486: 06,2352           12367                           TCF      C33TEST                       	#
006055,000487: 
006056,000488: 06,2353           02730                           TC       CAGESUB2                      	# SET TURNON FLAGS.
006057,000489: 
006058,000490: 06,2354           04740        ISSZERO            TC       IBNKCALL                      	# TURN OFF NO ATT LAMP
006059,000491: 06,2355           17151                           CADR     NOATTOFF                      	#     IMU CAGE OFF ENTRY
006060,000492: 
006061,000493: 06,2356           35013                           CAF      BIT5                          	# ISS CDU ZERO
006062,000494: 06,2357           00006                           EXTEND                                 	#
006063,000495: 06,2360           05012                           WOR      CHAN12                        	#
006064,000496: 
006065,000497: 06,2361           05521                           TC       ZEROICDU                      	#
006066,000498: 06,2362           35012                           CAF      BIT6                          	# WAIT 300 MS FOR AGS TO RECEIVE SIGNAL.
006067,000499: 06,2363           05245                           TC       WAITLIST                      	#
006068,000500: 06,2364     1331                                  EBANK=   OPTMODES                      	#
006069,000501: 06,2364           02315 14062                     2CADR    UNZ2                          	#
006070,000502: 
006071,000503: 06,2366           12367                           TCF      C33TEST                       	#
006072,000504: 
006074,000506:                                                                                          	# PROGRAM NAME:  C33TEST
006075,000507: 
006076,000508:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM MONITORS THREE FLIP-FLOP INBITS OF CHANNEL 33 AND CALLS THE APPROPRIATE
006077,000509:                                                                                          	# SUBROUTINE TO PROCESS A CHANGE.  IT IS ANALOGOUS TO IMUMON, WHICH MONITORS CHANNEL 30, EXCEPT THAT IT READS
006078,000510:                                                                                          	# CHANNEL 33 WITH A WAND INSTRUCTION BECAUSE A 'WRITE' PULSE IS REQUIRED TO RESET THE FLIP-FLOPS.  THE BITS
006079,000511:                                                                                          	# PROCESSED AND THE SUBROUTINES CALLED ARE:
006080,000512:                                                                                          	#       BIT     FUNCTION                SUBROUTINE
006081,000513:                                                                                          	#       ---     --------                ----------
006082,000514:                                                                                          	#        13     PIPA FAIL               PIPFAIL
006083,000515:                                                                                          	#        12     DOWNLINK TOO FAST       DNTMFAST
006084,000516:                                                                                          	#        11     UPLINK TOO FAST         UPTMFAST
006085,000517: 
006086,000518:                                                                                          	# UPON ENTRY TO THE SUBROUTINE, THE NEW BIT STATE IS IN A.
006087,000519: 
006088,000520:                                                                                          	# CALLING SEQUENCE:  EVERY 480 MILLISECONDS AFTER TNONTEST.
006089,000521: 
006090,000522:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
006091,000523: 
006092,000524:                                                                                          	# SUBROUTINES CALLED:  PIPFAIL, DNTMFAST AND UPTMFAST ON BIT CHANGES.
006093,000525: 
006094,000526:                                                                                          	# ERASABLE INITIALIZATION:  C(IMODES33) = OCT 16000 ON A FRESH START OR RESTART, THEREFORE, THESE ALARMS WILL
006095,000527:                                                                                          	# REAPPEAR IF THE CONDITIONS PERSIST.
006096,000528: 
006097,000529:                                                                                          	# ALARMS:  NONE.
006098,000530: 
006099,000531:                                                                                          	# EXIT:  GLOCKMON.
006100,000532: 
006101,000533:                                                                                          	# OUTPUT:  UPDATED BITS 13, 12 AND 11 OF IMODES33 WITH CHANGES PROCESSED.
006102,000534: 
006103,000535: 06,2367           31321        C33TEST            CA       IMODES33                      	# SEE IF RELEVANT CHAN33 BITS HAVE
006104,000536: 06,2370           75070                           MASK     33RDMSK                       	#
006105,000537: 06,2371           54001                           TS       L                             	# CHANGED.
006106,000538: 06,2372           35070                           CAF      33RDMSK                       	#
006107,000539: 06,2373           00006                           EXTEND                                 	#
006108,000540: 06,2374           03033                           WAND     CHAN33                        	# RESETS FLIP-FLOP INPUTS.
006109,000541: 06,2375           00006                           EXTEND                                 	#
006110,000542: 06,2376           06001                           RXOR     LCHAN                         	#
006111,000543: 06,2377           00006                           EXTEND                                 	#
006112,000544: 06,2400           12427                           BZF      GLOCKMON                      	# ON NO CHANGE.
006113,000545: 
006114,000546: 06,2401           54070                           TS       RUPTREG1                      	# SAVE BITS WHICH HAVE CHANGED.
006115,000547: 06,2402           23321                           LXCH     IMODES33                      	#
006116,000548: 06,2403           00006                           EXTEND                                 	#
006117,000549: 06,2404           06001                           RXOR     LCHAN                         	#
006118,000550: 06,2405           55321                           TS       IMODES33                      	# UPDATED IMODES33.
006119,000551: 
006120,000552: 06,2406           35021                           CAF      ZERO                          	#
006121,000553: 06,2407           56070                           XCH      RUPTREG1                      	#
006122,000554: 06,2410           60000                           DOUBLE                                 	#
006124,000556: 06,2411           12414                           TCF      NXTIBT     +1                 	# SCAN FOR BIT CHANGES.
006125,000557: 
006126,000558: 06,2412           65017                 -1        AD       ONE                           	#
006127,000559: 06,2413           24070        NXTIBT             INCR     RUPTREG1                      	#
006128,000560: 06,2414           60000                 +1        DOUBLE                                 	#
006129,000561: 06,2415           54000                           TS       A                             	# (CODING IDENTICAL TO CHAN 30).
006130,000562: 06,2416           12413                           TCF      NXTIBT                        	#
006131,000563: 
006132,000564: 06,2417           56071                           XCH      RUPTREG2                      	#
006133,000565: 06,2420           50070                           INDEX    RUPTREG1                      	# GET NEW VALUE OF BIT WHICH CHANGED.
006134,000566: 06,2421           35003                           CAF      BIT13                         	#
006135,000567: 06,2422           71321                           MASK     IMODES33                      	#
006136,000568: 06,2423           50070                           INDEX    RUPTREG1                      	#
006137,000569: 06,2424           02745                           TC       C33JMP                        	#
006138,000570: 
006139,000571: 06,2425           10071        NXTFL33            CCS      RUPTREG2                      	# PROCESS POSSIBLE ADDITIONAL CHANGES.
006140,000572: 06,2426           12412                           TCF      NXTIBT     -1                 	#
006141,000573: 
006143,000575:                                                                                          	# PROGRAM NAME:  GLOCKMON
006144,000576: 
006145,000577:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM MONITORS THE CDUZ COUNTER TO DETERMINE WHETHER THE ISS IS IN GIMBAL LOCK
006146,000578:                                                                                          	# AND TAKES ACTION IF IT IS.  THREE REGIONS OF MIDDLE GIMBAL ANGLE (MGA) ARE USED:
006147,000579: 
006148,000580:                                                                                          	#       1) ABS(MGA) LESS THAN OR EQUAL TO 70 DEGREES - NORMAL MODE.
006149,000581:                                                                                          	#       2) ABS(MGA) GREATER THAN 70 DEGREES AND LESS THAN OR EQUAL TO 85 DEGREES - GIMBAL LOCK LAMP TURNED ON.
006150,000582:                                                                                          	#       3) ABS(MGA) GREATER THAN 85 DEGREES - ISS PUT IN COARSE ALIGN AND NO ATT LAMP TURNED ON.
006151,000583: 
006152,000584:                                                                                          	# CALLING SEQUENCE:  EVERY 480 MILLISECONDS AFTER C33TEST.
006153,000585: 
006154,000586:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
006155,000587: 
006156,000588:                                                                                          	# SUBROUTINES CALLED:   1) SETCOARS WHEN ABS(MGA) GREATER THAN 85 DEGREES AND ISS NOT IN COARSE ALIGN.
006157,000589:                                                                                          	#                       2) LAMPTEST BEFORE TURNING OFF GIMBAL LOCK LAMP.
006158,000590: 
006159,000591:                                                                                          	# ERASABLE INITIALIZATION:
006160,000592:                                                                                          	#               1) FRESH START OR RESTART WITH NO GROUPS ACTIVE:  C(CDUZ) = 0, IMODES30 BIT 6 = 0, IMODES33 BIT 1 = 0.
006161,000593:                                                                                          	#               2) RESTART WITH GROUPS ACTIVE:  SAME AS FRESH START EXCEPT C(CDUZ) NOT CHANGED SO GIMBAL MONITOR
006162,000594:                                                                                          	#                                               PROCEEDS AS BEFORE.
006163,000595: 
006164,000596:                                                                                          	# ALARMS:       1) MGA REGION (2) CAUSES GIMBAL LOCK LAMP TO BE LIT.
006165,000597:                                                                                          	#               2) MGA REGION (3) CAUSES THE ISS TO BE PUT IN COARSE ALIGN AND THE NO ATT LAMP TO BE LIT IF EITHER NOT
006166,000598:                                                                                          	#                  SO ALREADY.
006167,000599: 
006168,000600: 06,2427           10034        GLOCKMON           CCS      CDUZ                          	#
006169,000601: 06,2430           12434                           TCF      GLOCKCHK                      	# SEE IF MAGNITUDE OF MGA IS GREATER THAN
006170,000602: 06,2431           12460                           TCF      SETGLOCK                      	# 70 DEGREES.
006171,000603: 06,2432           12434                           TCF      GLOCKCHK                      	#
006172,000604: 06,2433           12460                           TCF      SETGLOCK                      	#
006173,000605: 
006174,000606: 06,2434           62505        GLOCKCHK           AD       -70DEGS                       	#
006175,000607: 06,2435           00006                           EXTEND                                 	#
006176,000608: 06,2436           62457                           BZMF     SETGLOCK   -1                 	# NO LOCK.
006177,000609: 
006178,000610: 06,2437           62506                           AD       -15DEGS                       	# SEE IF ABS(MGA) GREATER THAN 85 DEGS.
006179,000611: 06,2440           00006                           EXTEND                                 	#
006180,000612: 06,2441           62455                           BZMF     NOGIMRUN                      	#
006181,000613: 
006182,000614: 06,2442           35014                           CAF      BIT4                          	# IF SO, SYSTEM SHOULD BE IN COARSE ALIGN
006183,000615: 06,2443           00006                           EXTEND                                 	# TO PREVENT GIMBAL RUN-AWAY.
006184,000616: 06,2444           02012                           RAND     CHAN12                        	#
006185,000617: 06,2445           10000                           CCS      A                             	#
006186,000618: 06,2446           12455                           TCF      NOGIMRUN                      	#
006187,000619: 
006188,000620: 06,2447           04740                           TC       IBNKCALL                      	# GO INTO COARSE ALIGN.
006189,000621: 06,2450           17027                           CADR     SETCOARS                      	#
006190,000622: 
006191,000623: 06,2451           36211                           CAF      SIX                           	# ENABLE ISS ERROR COUNTERS IN 60 MS
006192,000624: 06,2452           05245                           TC       WAITLIST                      	#
006194,000626: 06,2453  E3,1474                                  EBANK=   CDUIND                        	#
006195,000627: 06,2453           03023 16063                     2CADR    CA+ECE                        	#
006196,000628: 
006197,000629: 06,2455           35012        NOGIMRUN           CAF      BIT6                          	# TURN ON GIMBAL LOCK LAMP.
006198,000630: 06,2456           12460                           TCF      SETGLOCK                      	#
006199,000631: 
006200,000632: 06,2457           35021                 -1        CAF      ZERO                          	#
006201,000633: 06,2460           61036        SETGLOCK           AD       DSPTAB     +11D               	# SEE IF PRESENT STATE OF GIMBAL LOCK LAMP
006202,000634: 06,2461           75012                           MASK     BIT6                          	# AGREES WITH DESIRED STATE BY HALF ADDING
006203,000635: 06,2462           00006                           EXTEND                                 	# THE TWO.
006204,000636: 06,2463           15333                           BZF      GLOCKOK                       	# OK AS IS.
006205,000637: 
006206,000638: 06,2464           71036                           MASK     DSPTAB     +11D               	# IF OFF, DONT TURN ON IF IMU BEING CAGED.
006207,000639: 06,2465           10000                           CCS      A                             	#
006208,000640: 06,2466           12502                           TCF      GLAMPTST                      	# TURN OFF UNLESS LAMP TEST IN PROGRESS.
006209,000641: 
006210,000642: 06,2467           35012                           CAF      BIT6                          	#
006211,000643: 06,2470           71320                           MASK     IMODES30                      	#
006212,000644: 06,2471           10000                           CCS      A                             	#
006213,000645: 06,2472           15333                           TCF      GLOCKOK                       	#
006214,000646: 
006215,000647: 06,2473           41036        GLINVERT           CS       DSPTAB     +11D               	# INVERT GIMBAL LOCK LAMP.
006216,000648: 06,2474           75012                           MASK     BIT6                          	#
006217,000649: 06,2475           65001                           AD       BIT15                         	# TO INDICATE CHANGE IN DSPTAB +11D.
006218,000650: 06,2476           57036                           XCH      DSPTAB     +11D               	#
006219,000651: 06,2477           72164                           MASK     OCT37737                      	#
006220,000652: 06,2500           27036                           ADS      DSPTAB     +11D               	#
006221,000653: 06,2501           15333                           TCF      GLOCKOK                       	#
006222,000654: 
006223,000655: 06,2502           02750        GLAMPTST           TC       LAMPTEST                      	# TURN OFF UNLESS LAMP TEST IN PROGRESS.
006224,000656: 06,2503           15333                           TCF      GLOCKOK                       	#
006225,000657: 06,2504           12473                           TCF      GLINVERT                      	#
006226,000658: 
006227,000659: 06,2505           63434        -70DEGS            DEC      -.38888                       	# -70 DEGREES SCALED IN HALF-REVOLUTIONS.
006228,000660: 06,2506           75252        -15DEGS            DEC      -.08333                       	#
006229,000661: 
006231,000663:                                                                                          	# PROGRAM NAME:  TLIM.
006232,000664: 
006233,000665:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM MAINTAINS THE TEMP LAMP (BIT 4 OF CHANNEL 11) ON THE DSKY TO AGREE WITH
006234,000666:                                                                                          	# THE TEMP SIGNAL FROM THE ISS (BIT 15 OF CHANNEL 30).  HOWEVER, THE LIGHT WILL NOT BE TURNED OFF IF A LAMP TEST
006235,000667:                                                                                          	# IS IN PROGRESS.
006236,000668: 
006237,000669:                                                                                          	# CALLING SEQUENCE:  CALLED BY IMUMON ON A CHANGE OF BIT 15 OF CHANNEL 30.
006238,000670: 
006239,000671:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
006240,000672: 
006241,000673:                                                                                          	# SUBROUTINES CALLED:  LAMPTEST.
006242,000674: 
006243,000675:                                                                                          	# ERASABLE INITIALIZATION:  FRESH START AND RESTART TURN THE TEMP LAMP OFF.
006244,000676: 
006245,000677:                                                                                          	# ALARMS:  TEMP LAMP TURNED ON WHEN IMU TEMP GOES OUT OF LIMITS.
006246,000678: 
006247,000679:                                                                                          	# EXIT:  NXTIFAIL.
006248,000680: 
006249,000681:                                                                                          	# OUTPUT:  SERVICE OF TEMP LAMP.                  IN A, EXCEPT FOR TLIM.
006250,000682: 
006251,000683: 06,2507           74777        TLIM               MASK     POSMAX                        	# REMOVE BIT FROM WORD OF CHANGES AND SET
006252,000684: 06,2510           54071                           TS       RUPTREG2                      	# DSKY TEMP LAMP ACCORDINGLY.
006253,000685: 
006254,000686: 06,2511           11320                           CCS      IMODES30                      	#
006255,000687: 06,2512           12520                           TCF      TEMPOK                        	#
006256,000688: 06,2513           12520                           TCF      TEMPOK                        	#
006257,000689: 
006258,000690: 06,2514           35014                           CAF      BIT4                          	# TURN ON LAMP.
006259,000691: 06,2515           00006                           EXTEND                                 	#
006260,000692: 06,2516           05011                           WOR      DSALMOUT                      	#
006261,000693: 06,2517           12227                           TCF      NXTIFAIL                      	#
006262,000694: 
006263,000695: 06,2520           02750        TEMPOK             TC       LAMPTEST                      	# IF TEMP NOW OK, DONT TURN OFF LAMP IF
006264,000696: 06,2521           12227                           TCF      NXTIFAIL                      	# LAMP TEST IN PROGRESS.
006265,000697: 
006266,000698: 06,2522           45014                           CS       BIT4                          	#
006267,000699: 06,2523           00006                           EXTEND                                 	#
006268,000700: 06,2524           03011                           WAND     DSALMOUT                      	# TURN OFF TEMP CAUTION
006269,000701: 06,2525           12227                           TCF      NXTIFAIL                      	#
006270,000702: 
006272,000704:                                                                                          	# PROGRAM NAME:  ITURNON.
006273,000705: 
006274,000706:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM IS CALLED BY IMUMON WHEN A CHANGE OF BIT 14 OF CHANNEL 30 (ISS TURN-ON
006275,000707:                                                                                          	# REQUEST) IS DETECTED.  UPON ENTRY, ITURNON CHECKS IF A TURN-ON DELAY SEQUENCE HAS FAILED, AND IF SO, IT EXITS.
006276,000708:                                                                                          	# IF NOT, IT CHECKS WHETHER THE TURN-ON REQUEST CHANGE IS TO ON OR OFF.  IF ON, IT SETS BIT 7 OF IMODES30 TO 1 SO
006277,000709:                                                                                          	# THAT TNONTEST WILL INITIATE THE ISS INITIALIZATION SEQUENCE.  IF OFF, THE TURN-ON DELAY SIGNAL, CHANNEL 12 BIT
006278,000710:                                                                                          	# 15, IS CHECKED AND IF IT IS ON, ITURNON EXITS.  IF THE DELAY SIGNAL IS OFF, PROGRAM ALARM 00207 IS ISSUED, BIT 2
006279,000711:                                                                                          	# OF IMODES30 IS SET TO 1 AND THE PROGRAM EXITS.
006280,000712: 
006281,000713:                                                                                          	# THE SETTING OF BIT 2 OF IMODES30 (ISS DELAY SEQUENCE FAIL) INHIBITS THIS ROUTINE AND IMUOP FROM
006282,000714:                                                                                          	# PROCESSING ANY CHANGES.  THIS BIT WILL BE RESET BY THE ENDTNON ROUTINE WHEN THE CURRENT 90 SECOND DELAY PERIOD
006283,000715:                                                                                          	# ENDS.
006284,000716: 
006285,000717:                                                                                          	# CALLING SEQUENCE:  FROM IMUMOM WHEN ISS TURN-ON REQUEST CHANGES STATE.
006286,000718: 
006287,000719:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
006288,000720: 
006289,000721:                                                                                          	# SUBROUTINES CALLED:  ALARM, IF THE ISS TURN-ON REQUEST IS NOT PRESENT FOR 90 SECONDS.
006290,000722: 
006291,000723:                                                                                          	# ERASABLE INITIALIZATION:  FRESH START AND RESTART SET BIT 15 OF CHANNEL 12 AND BITS 2 AND 7 OF IMODES30 TO 0,
006292,000724:                                                                                          	# AND BIT 14 OF IMODES30 TO 1.
006293,000725: 
006294,000726:                                                                                          	# ALARMS: PROGRAM ALARM 00207 IS ISSUED IF THE ISS TURN-ON REQUEST SIGNAL IS NOT PRESENT FOR 90 SECONDS.
006295,000727: 
006296,000728:                                                                                          	# EXIT:  NXTIFAIL.
006297,000729: 
006298,000730:                                                                                          	# OUTPUT:  BIT 7 OF IMODES30 TO START ISS INITIALIZATION, OR BIT 2 OF IMODES30 AND PROGRAM ALARM 00207 TO INDICATE
006299,000731:                                                                                          	# A FAILED TURN-ON SEQUENCE.
006300,000732: 
006301,000733: 06,2526           35016        ITURNON            CAF      BIT2                          	# IF DELAY REQUEST HAS GONE OFF
006302,000734: 06,2527           71320                           MASK     IMODES30                      	# PREMATURELY, DO NOT PROCESS ANY CHANGES
006303,000735: 06,2530           10000                           CCS      A                             	# UNTIL THE CURRENT 90 SEC WAIT EXPIRES.
006304,000736: 06,2531           12227                           TCF      NXTIFAIL                      	#
006305,000737: 
006306,000738: 06,2532           35002                           CAF      BIT14                         	# SEE IF JUST ON OR OFF.
006307,000739: 06,2533           71320                           MASK     IMODES30                      	#
006308,000740: 06,2534           00006                           EXTEND                                 	#
006309,000741: 06,2535           12551                           BZF      ITURNON2                      	# IF JUST ON.
006310,000742: 
006311,000743: 06,2536           35001                           CAF      BIT15                         	#
006312,000744: 06,2537           00006                           EXTEND                                 	# SEE IF DELAY PRESENT DISCRETE HAS BEEN
006313,000745: 06,2540           02012                           RAND     CHAN12                        	# SENT.  IF SO, ACTION COMPLETE.
006314,000746: 06,2541           00006                           EXTEND                                 	#
006315,000747: 06,2542           12544                           BZF      +2                            	#
006316,000748: 06,2543           12227                           TCF      NXTIFAIL                      	#
006317,000749: 
006318,000750: 06,2544           35016                           CAF      BIT2                          	# IF NOT, SET BIT TO INDICATE REQUEST NOT
006319,000751: 06,2545           27320                           ADS      IMODES30                      	# PRESENT FOR FULL DURATION.
006320,000752: 06,2546           05650                           TC       ALARM                         	#
006321,000753: 06,2547           00207                           OCT      207                           	#
006322,000754: 06,2550           12227                           TCF      NXTIFAIL                      	#
006323,000755: 
006325,000757: 06,2551           41320        ITURNON2           CS       IMODES30                      	# SET BIT7 TO INDICATE WAIT OF 1 SAMPLE
006326,000758: 06,2552           75011                           MASK     BIT7                          	#
006327,000759: 06,2553           27320                           ADS      IMODES30                      	#
006328,000760: 06,2554           12227                           TCF      NXTIFAIL                      	#
006329,000761: 
006331,000763:                                                                                          	# PROGRAM NAME:  IMUCAGE.
006332,000764: 
006333,000765:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM PROCESSES CHANGES OF THE IMUCAGE INBIT, CHANNEL 30 BIT 11.  IF THE BIT
006334,000766:                                                                                          	# CHANGES TO 0 (CAGE BUTTON PRESSED), THE ISS IS CAGED (ICDU ZERO + COARSE ALIGN + NO ATT LAMP) UNTIL THE
006335,000767:                                                                                          	# ASTRONAUT SELECTS ANOTHER PROGRAM TO ALIGN THE ISS.  ANY PULSE TRAINS TO THE ICDU'S AND GYRO'S ARE TERMINATED,
006336,000768:                                                                                          	# THE ASSOCIATED OUTCOUNTERS ARE ZEROED AND THE GYRO'S ARE DE-SELECTED.  NO ACTION OCCURS WHEN THE BUTTON IS
006337,000769:                                                                                          	# RELEASED (INBIT CHANGES TO 1).
006338,000770: 
006339,000771:                                                                                          	# CALLING SEQUENCE:  BY IMUMON WHEN IMU CAGE BIT CHANGES.
006340,000772: 
006341,000773:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
006342,000774: 
006343,000775:                                                                                          	# SUBROUTINES CALLED:  CAGESUB.
006344,000776: 
006345,000777:                                                                                          	# ERASABLE INITIALIZATION:  FRESH START AND RESTART SET BIT 11 OF IMODES30 TO 1.
006346,000778: 
006347,000779:                                                                                          	# ALARMS: NONE.
006348,000780: 
006349,000781:                                                                                          	# EXIT:  NXTIFAIL.
006350,000782: 
006351,000783:                                                                                          	# OUTPUT:  ISS CAGED, COUNTERS ZEROED, PULSE TRAINS TERMINATED AND NO ATT LAMP LIT.
006352,000784: 
006353,000785: 06,2555           10000        IMUCAGE            CCS      A                             	# NO ACTION IF GOING OFF.
006354,000786: 06,2556           12354                           TCF      ISSZERO                       	#
006355,000787: 06,2557           42762                           CS       OCT77000                      	# TERMINATE ICDU, OPTICS, GYRO PULSE TRAINS
006356,000788: 06,2560           00006                           EXTEND                                 	#
006357,000789: 06,2561           03014                           WAND     CHAN14                        	#
006358,000790: 
006359,000791: 06,2562           42756                           CS       OCT272                        	# KNOCK DOWN TVC ENABLE, IMU ERROR COUNTER
006360,000792: 06,2563           00006                           EXTEND                                 	#   ENABLE, ZERO ICDU, COARSE ALIGN
006361,000793: 06,2564           03012                           WAND     CHAN12                        	#   ENABLE, OPTICS ERR CNTR ENABLE
006362,000794: 
006363,000795: 06,2565           45003                           CS       BIT13                         	# TURN OFF ENGINE
006364,000796: 06,2566           00006                           EXTEND                                 	#
006365,000797: 06,2567           03011                           WAND     DSALMOUT                      	#
006366,000798: 
006367,000799: 06,2570           02725                           TC       CAGESUB1                      	#
006368,000800: 
006369,000801: 06,2571           04740                           TC       IBNKCALL                      	# KNOCK DOWN TRACK, REFSMMAT, DRIFT FLAGS
006370,000802: 06,2572           17060                           CADR     RNDREFDR                      	#
006371,000803: 
006372,000804: 06,2573           45021                           CS       ZERO                          	# ZERO COMMAND OUT-COUNTERS
006373,000805: 06,2574           54050                           TS       CDUXCMD                       	#
006374,000806: 06,2575           54051                           TS       CDUYCMD                       	#
006375,000807: 06,2576           54052                           TS       CDUZCMD                       	#
006376,000808: 06,2577           54047                           TS       GYROCMD                       	#
006377,000809: 
006378,000810: 06,2600           42761                           CS       OCT740                        	# HAVING WAITED AT LEAST 27 MCT FROM
006379,000811: 06,2601           00006                           EXTEND                                 	# GYRO PULSE TRAIN TERMINATION, WE CAN
006380,000812: 06,2602           03014                           WAND     CHAN14                        	# DE-SELECT THE GYROS.
006382,000814: 06,2603           12227                           TCF      NXTIFAIL                      	#
006383,000815: 
006385,000817:                                                                                          	# PROGRAM NAME:  IMUOP.
006386,000818: 
006387,000819:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM PROCESSES CHANGES IN THE ISS OPERATE DISCRETE, BIT 9 OF CHANNEL 30.
006388,000820:                                                                                          	# IF THE INBIT CHANGES TO 0, INDICATING ISS ON, IMUOP GENERALLY SETS BIT 7 OF IMODES30 TO 1 TO REQUEST ISS
006389,000821:                                                                                          	# INITIALIZATION VIA TNONTEST.  AN EXCEPTION IS DURING A FAILED ISS DELAY DURING WHICH BIT 2 OF IMODES30 IS SET
006390,000822:                                                                                          	# TO 1 AND NO FURTHER INITIALIZATION IS REQUIRED.  WHEN THE INBIT CHANGES TO 1, INDICATING ISS OFF, IMUSEFLG IS
006391,000823:                                                                                          	# TESTED TO SEE IF ANY PROGRAM WAS USING THE ISS.  IF SO, PROGRAM ALARM 00214 IS ISSUED.
006392,000824: 
006393,000825:                                                                                          	# CALLING SEQUENCE:  BY IMUMON WHEN BIT 9 OF CHANNEL 30 CHANGES.
006394,000826: 
006395,000827:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
006396,000828: 
006397,000829:                                                                                          	# SUBROUTINES CALLED:  ALARM, IF ISS IS TURNED OFF WHILE IN USE.
006398,000830: 
006399,000831:                                                                                          	# ERASABLE INITIALIZATION:  ON FRESH START AND RESTART, BIT 9 OF IMODES30 IS SET TO 1 EXCEPT WHEN THE GIMBAL LOCK
006400,000832:                                                                                          	# LAMP IS ON, IN WHICH CASE IT IS SET TO 0.  THIS PREVENTS ICDU ZERO BY TNONTEST WITH THE ISS IN GIMBAL LOCK.
006401,000833: 
006402,000834:                                                                                          	# ALARMS:  PROGRAM ALARM 00214 IF THE ISS IS TURNED OFF WHILE IN USE.
006403,000835: 
006404,000836:                                                                                          	# EXIT:  NXTIFAIL.
006405,000837: 
006406,000838:                                                                                          	# OUTPUT:  ISS INITIALIZATION REQUEST (IMODES30 BIT 7) OR PROGRAM ALARM 00214.
006407,000839: 
006408,000840: 06,2604           00006        IMUOP              EXTEND                                 	# IF OPERATE JUST ON, WAIT 1 SAMPLE.
006409,000841: 06,2605           12625                           BZF      IMUOP2                        	#
006410,000842: 
006411,000843: 06,2606           41321                           CS       IMODES33                      	# DISABLE DAP
006412,000844: 06,2607           75012                           MASK     BIT6                          	#
006413,000845: 06,2610           27321                           ADS      IMODES33                      	#
006414,000846: 
006415,000847: 06,2611           04740                           TC       IBNKCALL                      	# KNOCK DOWN TRACK, REFSMMAT, DRIFT FLAGS
006416,000848: 06,2612           17060                           CADR     RNDREFDR                      	#
006417,000849: 
006418,000850: 06,2613           42757                           CS       BITS7&8                       	# KNOCK DOWN RENDEVOUS, IMUUSE FLAGS
006419,000851: 06,2614           70074                           MASK     STATE                         	#
006420,000852: 06,2615           56074                           XCH      STATE                         	# IF GOING OFF, ALARM IF PROG USING IMU
006421,000853: 06,2616           40000                           COM                                    	#
006422,000854: 06,2617           75010                           MASK     IMUSEFLG                      	#
006423,000855: 06,2620           10000                           CCS      A                             	#
006424,000856: 06,2621           12227                           TCF      NXTIFAIL                      	#
006425,000857: 
006426,000858: 06,2622           05650                           TC       ALARM                         	#
006427,000859: 06,2623           00214                           OCT      214                           	#
006428,000860: 06,2624           12227                           TCF      NXTIFAIL                      	#
006429,000861: 
006430,000862: 06,2625           35016        IMUOP2             CAF      BIT2                          	# SEE IF FAILED ISS TURN-ON SEQ IN PROG.
006431,000863: 06,2626           71320                           MASK     IMODES30                      	#
006432,000864: 06,2627           10000                           CCS      A                             	#
006433,000865: 06,2630           12227                           TCF      NXTIFAIL                      	# IF SO, DONT PROCESS UNTIL PRESENT 90
006434,000866: 06,2631           12551                           TCF      ITURNON2                      	# SECONDS EXPIRES.
006435,000867: 
006437,000869:                                                                                          	# PROGRAM NAME:  PIPFAIL
006438,000870: 
006439,000871:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM PROCESSES CHANGES OF BIT 13 OF CHANNEL 33, PIPA FAIL.  IT SETS BIT 10 OF
006440,000872:                                                                                          	# IMODES30 TO AGREE.  IT CALLS SETISSW IN CASE A PIPA FAIL NECESSITATES AN ISS WARNING.  IF NOT, I.E., IMODES30
006441,000873:                                                                                          	# BIT 1 = 1, AND A PIPA FAIL IS PRESENT AND THE ISS IS NOT BEING INITIALIZED, PROGRAM ALARM 00212 IS ISSUED.
006442,000874: 
006443,000875:                                                                                          	# CALLING SEQUENCE:  BY C33TEST ON CHANGES OF CHANNEL 33 BIT 13.
006444,000876: 
006445,000877:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
006446,000878: 
006447,000879:                                                                                          	# SUBROUTINES CALLED:  1) SETISSW, AND 2) ALARM (SEE FUNCTIONAL DESCRIPTION).
006448,000880: 
006449,000881:                                                                                          	# ERASABLE INITIALIZATION:  SEE IMUMON FOR INITIALIZATION OF IMODES30.  THE RELAVANT BITS ARE 5, 7, 8, 9, AND 10.
006450,000882: 
006451,000883:                                                                                          	# ALARMS:  PROGRAM ALARM 00212 IF PIPA FAIL IS PRESENT BUT NEITHER ISS WARNING IS TO BE ISSUED NOR THE ISS IS
006452,000884:                                                                                          	# BEING INITIALIZED.
006453,000885: 
006454,000886:                                                                                          	# EXIT:  NXTFL33.
006455,000887: 
006456,000888:                                                                                          	# OUTPUT:  PROGRAM ALARM 00212 AND ISS WARNING MAINTENANCE.
006457,000889: 
006458,000890: 06,2632           10000        PIPFAIL            CCS      A                             	# SET BIT10 IN IMODES30 SO ALL ISS WARNING
006459,000891: 06,2633           35006                           CAF      BIT10                         	# INFO IS IN ONE REGISTER.
006460,000892: 06,2634           57320                           XCH      IMODES30                      	#
006461,000893: 06,2635           72763                           MASK     -BIT10                        	#
006462,000894: 06,2636           27320                           ADS      IMODES30                      	#
006463,000895: 
006464,000896: 06,2637           02665                           TC       SETISSW                       	#
006465,000897: 
006466,000898: 06,2640           41320                           CS       IMODES30                      	# IF PIP FAIL DOESNT LIGHT ISS WARNING, DO
006467,000899: 06,2641           75017                           MASK     BIT1                          	# A PROGRAM ALARM IF IMU OPERATING BUT NOT
006468,000900: 06,2642           10000                           CCS      A                             	# CAGED OR BEING TURNED ON.
006469,000901: 06,2643           12425                           TCF      NXTFL33                       	#
006470,000902: 
006471,000903: 06,2644           31320                           CA       IMODES30                      	#
006472,000904: 06,2645           72760                           MASK     OCT1720                       	#
006473,000905: 06,2646           10000                           CCS      A                             	#
006474,000906: 06,2647           12425                           TCF      NXTFL33                       	# ABOVE CONDITION NOT MET.
006475,000907: 
006476,000908: 06,2650           05650                           TC       ALARM                         	#
006477,000909: 06,2651           00212                           OCT      212                           	#
006478,000910: 06,2652           12425                           TCF      NXTFL33                       	#
006479,000911: 
006481,000913:                                                                                          	# PROGRAM NAMES:  DNTMFAST, UPTMFAST
006482,000914: 
006483,000915:                                                                                          	# FUNCTIONAL DESCRIPTION:  THESE PROGRAMS PROCESS CHANGES OF BITS 12 AND 11 OF CHANNEL 33.  IF A BIT CHANGES TO A
006484,000916:                                                                                          	# 0, A PROGRAM ALARM IS ISSUED.  THE ALARMS ARE:
006485,000917: 
006486,000918:                                                                                          	#       BIT     ALARM   CAUSE
006487,000919:                                                                                          	#       ---     -----   -----
006488,000920:                                                                                          	#        12     01105   DOWNLINK TOO FAST
006489,000921:                                                                                          	#        11     01106   UPLINK TOO FAST
006490,000922: 
006491,000923:                                                                                          	# CALLING SEQUENCE:  BY C33TEST ON A BIT CHANGE.
006492,000924: 
006493,000925:                                                                                          	# SUBROUTINES CALLED:  ALARM, IF A BIT CHANGES TO A 0.
006494,000926: 
006495,000927:                                                                                          	# ERASABLE INITIALIZATION:  FRESH START OR RESTART, BITS 12 AND 11 OF IMODES33 ARE SET TO 1.
006496,000928: 
006497,000929:                                                                                          	# ALARMS:  SEE FUNCTIONAL DESCRIPTION.
006498,000930: 
006499,000931:                                                                                          	# EXIT:  NXTFL33.
006500,000932: 
006501,000933:                                                                                          	# OUTPUT:  PROGRAM ALARM ON A BIT CHANGE TO 0.
006502,000934: 
006503,000935: 06,2653           10000        DNTMFAST           CCS      A                             	# DO PROG ALARM IF TM TOO FAST.
006504,000936: 06,2654           12425                           TCF      NXTFL33                       	#
006505,000937: 
006506,000938: 06,2655           05650                           TC       ALARM                         	#
006507,000939: 06,2656           01105                           OCT      1105                          	#
006508,000940: 06,2657           12425                           TCF      NXTFL33                       	#
006509,000941: 
006510,000942: 06,2660           10000        UPTMFAST           CCS      A                             	# SAME AS DNLINK TOO FAST WITH DIFFERENT
006511,000943: 06,2661           12425                           TCF      NXTFL33                       	# ALARM CODE.
006512,000944: 
006513,000945: 06,2662           05650                           TC       ALARM                         	#
006514,000946: 06,2663           01106                           OCT      1106                          	#
006515,000947: 06,2664           12425                           TCF      NXTFL33                       	#
006516,000948: 
006518,000950:                                                                                          	# PROGRAM NAME:  SETISSW
006519,000951: 
006520,000952:                                                                                          	# FUNCTIONAL DESCRIPTION:  THIS PROGRAM TURNS THE ISS WARNING LAMP ON AND OFF (CHANNEL 11 BIT 1 = 1 FOR ON,
006521,000953:                                                                                          	# 0 FOR OFF) DEPENDING ON THE STATUS OF IMODES30 BITS 13 (IMU FAIL) AND 4 (INHIBIT IMU FAIL), 12 (ICDU FAIL) AND
006522,000954:                                                                                          	# 3 (INHIBIT ICDU FAIL), AND 10 (PIPA FAIL) AND 1 (INHIBIT PIPA FAIL).  THE LAMP IS LEFT ON IF A LAMP TEST IS IN
006523,000955:                                                                                          	# PROGRESS.
006524,000956: 
006525,000957:                                                                                          	# CALLING SEQUENCE:  CALLED BY IMUMON ON CHANGES TO IMU FAIL AND ICDU FAIL.  CALLED BY IFAILOK AND PFAILOK UPON
006526,000958:                                                                                          	# REMOVAL OF THE FAIL INHIBITS.  CALLED BY PIPFAIL WHEN THE PIPA FAIL DISCRETE CHANGES.  IT IS CALLED BY PIPUSE
006527,000959:                                                                                          	# SINCE THE PIPA FAIL PROGRAM ALARM MAY NECESSITATE AN ISS WARNING, AND LIKEWISE BY PIPFREE WHEN THE ALARM DEPARTS
006528,000960:                                                                                          	# AND IT IS CALLED BY IMUZERO3 AND ISSUP AFTER THE FAIL INHIBITS HAVE BEEN REMOVED.
006529,000961: 
006530,000962:                                                                                          	# JOBS OR TASKS INITIATED:  NONE.
006531,000963: 
006532,000964:                                                                                          	# SUBROUTINES CALLED:  NONE.
006533,000965: 
006534,000966:                                                                                          	# ERASABLE INITIALIZATION:
006535,000967: 
006536,000968:                                                                                          	#       1) IMODES30 - SEE IMUMON.
006537,000969:                                                                                          	#       2) IMODES33 BIT 1 = 0 (LAMP TEST NOT IN PROGRESS).
006538,000970: 
006539,000971:                                                                                          	# ALARMS:  ISS WARNING.
006540,000972: 
006541,000973:                                                                                          	# EXIT: VIA Q.
006542,000974: 
006543,000975:                                                                                          	# OUTPUT: ISS WARNING LAMP SET PROPERLY.
006544,000976: 
006545,000977: 06,2665           35025        SETISSW            CAF      OCT15                         	# SET ISS WARNING USING THE FAIL BITS IN
006546,000978: 06,2666           71320                           MASK     IMODES30                      	# BITS 13, 12, AND 10 OF IMODES30 AND THE
006547,000979: 06,2667           00006                           EXTEND                                 	# FAILURE INHIBIT BITS IN POSITIONS
006548,000980: 06,2670           75006                           MP       BIT10                         	# 4, 3, AND 1.
006549,000981: 06,2671           31320                           CA       IMODES30                      	#
006550,000982: 06,2672           00006                           EXTEND                                 	#
006551,000983: 06,2673           04001                           ROR      LCHAN                         	# 0 INDICATES FAILURE.
006552,000984: 06,2674           40000                           COM                                    	#
006553,000985: 06,2675           75067                           MASK     OCT15000                      	#
006554,000986: 06,2676           10000                           CCS      A                             	#
006555,000987: 06,2677           12710                           TCF      ISSWON                        	# FAILURE.
006556,000988: 
006557,000989: 06,2700           35017        ISSWOFF            CAF      BIT1                          	# DONT TURN OFF ISS WARNING IF LAMP TEST
006558,000990: 06,2701           71321                           MASK     IMODES33                      	# IN PROGRESS.
006559,000991: 06,2702           10000                           CCS      A                             	#
006560,000992: 06,2703           00002                           TC       Q                             	#
006561,000993: 
006562,000994: 06,2704           45017                           CS       BIT1                          	#
006563,000995: 06,2705           00006                           EXTEND                                 	#
006564,000996: 06,2706           03011                           WAND     DSALMOUT                      	# TURN OFF ISS WARNING
006565,000997: 06,2707           00002                           TC       Q                             	#
006566,000998: 
006567,000999: 06,2710           00006        ISSWON             EXTEND                                 	#
006569,001001: 06,2711           22066                           QXCH     ITEMP6                        	#
006570,001002: 06,2712           05764                           TC       VARALARM                      	# TELL EVERYONE WHAT CAUSED THE ISS WARNING
006571,001003: 06,2713           35017                           CAF      BIT1                          	#
006572,001004: 06,2714           00006                           EXTEND                                 	#
006573,001005: 06,2715           05011                           WOR      DSALMOUT                      	# TURN ON ISS WARNING
006574,001006: 06,2716           00066                           TC       ITEMP6                        	#
006575,001007: 
006576,001008: 06,2717           47703        CAGESUB            CS       BIT15+6                       	# SET OUTBITS + INTERNAL FLAGS FOR
006577,001009: 06,2720           00006                           EXTEND                                 	# SYSTEM TURN-ON OR CAGE.  DISABLE THE
006578,001010: 06,2721           03012                           WAND     CHAN12                        	# ERROR COUNTER AND REMOVE IMU DELAY COMP.
006579,001011: 06,2722           35027                           CAF      BITS4&5                       	# SEND ZERO AND COARSE.
006580,001012: 06,2723           00006                           EXTEND                                 	#
006581,001013: 06,2724           05012                           WOR      CHAN12                        	#
006582,001014: 
006583,001015: 06,2725           41036        CAGESUB1           CS       DSPTAB     +11D               	# TURN ON NO ATT LAMP
006584,001016: 06,2726           72753                           MASK     OC40010                       	#
006585,001017: 06,2727           27036                           ADS      DSPTAB     +11D               	#
006586,001018: 
006587,001019: 06,2730           41320        CAGESUB2           CS       IMODES30                      	# SET FLAGS TO INDICATE CAGING OR TURN-ON
006588,001020: 06,2731           72755                           MASK     OCT75                         	# AND INHIBIT ALL ISS WARNING INFO
006589,001021: 06,2732           27320                           ADS      IMODES30                      	#
006590,001022: 
006591,001023: 06,2733           41321                           CS       IMODES33                      	# DISABLE DAP AUTO AND HOLD MODES
006592,001024: 06,2734           75012                           MASK     BIT6                          	#
006593,001025: 06,2735           27321                           ADS      IMODES33                      	#
006594,001026: 
006595,001027: 06,2736           00002                           TC       Q                             	#
006596,001028: 
006597,001029: 06,2737  06,2665               IMUFAIL            EQUALS   SETISSW                       	#
006598,001030: 06,2737  06,2665               ICDUFAIL           EQUALS   SETISSW                       	#
006599,001031: 

052752,000001:                                                                                          	# Copyright:    Public domain.
052753,000002:                                                                                          	# Filename:     EXECUTIVE.agc
052754,000003:                                                                                          	# Purpose:      Part of the source code for Colossus 2A, AKA Comanche 055.
052755,000004:                                                                                          	#               It is part of the source code for the Command Module's (CM)
052756,000005:                                                                                          	#               Apollo Guidance Computer (AGC), for Apollo 11.
052757,000006:                                                                                          	# Assembler:    yaYUL
052758,000007:                                                                                          	# Contact:      Ron Burkey <info@sandroid.org>.
052759,000008:                                                                                          	# Website:      www.ibiblio.org/apollo.
052760,000009:                                                                                          	# Pages:        1208-1220
052761,000010:                                                                                          	# Mod history:  2009-05-14 RSB  Adapted from the Colossus249/ file of the
052762,000011:                                                                                          	#                               same name, using Comanche055 page images.
052763,000012: 
052764,000013:                                                                                          	# This source code has been transcribed or otherwise adapted from digitized
052765,000014:                                                                                          	# images of a hardcopy from the MIT Museum.  The digitization was performed
052766,000015:                                                                                          	# by Paul Fjeld, and arranged for by Deborah Douglas of the Museum.  Many
052767,000016:                                                                                          	# thanks to both.  The images (with suitable reduction in storage size and
052768,000017:                                                                                          	# consequent reduction in image quality as well) are available online at
052769,000018:                                                                                          	# www.ibiblio.org/apollo.  If for some reason you find that the images are
052770,000019:                                                                                          	# illegible, contact me at info@sandroid.org about getting access to the
052771,000020:                                                                                          	# (much) higher-quality images which Paul actually created.
052772,000021: 
052773,000022:                                                                                          	# Notations on the hardcopy document read, in part:
052774,000023: 
052775,000024:                                                                                          	#       Assemble revision 055 of AGC program Comanche by NASA
052776,000025:                                                                                          	#       2021113-051.  10:28 APR. 1, 1969
052777,000026: 
052778,000027:                                                                                          	#       This AGC program shall also be referred to as
052779,000028:                                                                                          	#                       Colossus 2A
052780,000029: 
052781,000030:                                                                                          	# Page 1208
052782,000031:    5134                                           BLOCK    02                            	#
052783,000032: 
052784,000033:                                                                                          	# TO ENTER A JOB REQUEST REQUIRING NO VAC AREA:
052785,000034: 
052786,000035:    5134                                           COUNT    02/EXEC                       	#
052787,000036: 
052788,000037:    5134           00004        NOVAC              INHINT                                 	#
052789,000038:    5135           65226                           AD       FAKEPRET                      	# LOC(MPAC +6) - LOC(QPRET)
052790,000039:    5136           54063                           TS       NEWPRIO                       	# PRIORITY OF NEW JOB + NOVAC C(FIXLOC)
052791,000040: 
052792,000041:    5137           00006                           EXTEND                                 	#
052793,000042:    5140           50002                           INDEX    Q                             	# Q WILL BE UNDISTURBED THROUGHOUT.
052794,000043:    5141           30001                           DCA      0                             	# 2CADR OF JOB ENTERED.
052795,000044:    5142           52066                           DXCH     NEWLOC                        	#
052796,000045:    5143           35225                           CAF      EXECBANK                      	#
052797,000046:    5144           56004                           XCH      FBANK                         	#
052798,000047:    5145           54061                           TS       EXECTEM1                      	#
052799,000048:    5146           12650                           TCF      NOVAC2                        	# ENTER EXECUTIVE BANK.
052800,000049: 
052801,000050:                                                                                          	# TO ENTER A JOB REQUEST REQUIRING A VAC AREA - E.G., ALL (PARTIALLY) INTERPRETIVE JOBS.
052802,000051: 
052803,000052:    5147           00004        FINDVAC            INHINT                                 	#
052804,000053:    5150           54063                           TS       NEWPRIO                       	#
052805,000054:    5151           00006                           EXTEND                                 	#
052806,000055:    5152           50002                           INDEX    Q                             	#
052807,000056:    5153           30001                           DCA      0                             	#
052808,000057:    5154           52066        SPVACIN            DXCH     NEWLOC                        	#
052809,000058:    5155           35225                           CAF      EXECBANK                      	#
052810,000059:    5156           56004                           XCH      FBANK                         	#
052811,000060:    5157           12626                           TCF      FINDVAC2                      	# OFF TO EXECUTIVE SWITCHED-BANK.
052812,000061: 
052813,000062:                                                                                          	# TO ENTER A FINDVAC WITH THE PRIORITY IN NEWPRIO TO THE 2CADR ARRIVING IN A AND L:
052814,000063:                                                                                          	# USERS OF SPVAC MUST INHINT BEFORE STORING IN NEWPRIO.
052815,000064: 
052816,000065:    5160           56002        SPVAC              XCH      Q                             	#
052817,000066:    5161           67715                           AD       NEG2                          	#
052818,000067:    5162           56002                           XCH      Q                             	#
052819,000068:    5163           15154                           TCF      SPVACIN                       	#
052820,000069: 
052821,000070:                                                                                          	# TO SUSPEND A BASIC JOB SO A HIGHER PRIORITY JOB MAY BE SERVICED:
052822,000071: 
052823,000072:    5164           22002        CHANG1             LXCH     Q                             	#
052824,000073:    5165           35225                           CAF      EXECBANK                      	#
052825,000074:    5166           56006                           XCH      BBANK                         	#
052826,000075:    5167           12727                           TCF      CHANJOB                       	#
052827,000076: 
052828,000077:                                                                                          	# TO SUSPEND AN INTERPRETIVE JOB:
052829,000078: 
052830,000079:    5170           40164        CHANG2             CS       LOC                           	# NEGATIVE LOC SHOWS JOB = INTERPRETIVE.
052831,000080:                                                                                          	# ITRACE (4) REFERS TO "CHANG2".
052832,000081:                                                                                          	# Page 1209
052833,000082:    5171           54001                           TS       L                             	#
052834,000083:    5172           35225                 +2        CAF      EXECBANK                      	#
052835,000084:    5173           54006                           TS       BBANK                         	#
052836,000085:    5174           12726                           TCF      CHANJOB    -1                 	#
052837,000086: 
052838,000087:                                                                                          	# Page 1210
052839,000088:                                                                                          	# TO VOLUNTARILY SUSPEND A JOB UNTIL THE COMPLETION OF SOME ANTICIPATED EVENT (I/O EVENT ETC.):
052840,000089: 
052841,000090:    5175           54164        JOBSLEEP           TS       LOC                           	#
052842,000091:    5176           35225                           CAF      EXECBANK                      	#
052843,000092:    5177           54004                           TS       FBANK                         	#
052844,000093:    5200           13017                           TCF      JOBSLP1                       	#
052845,000094: 
052846,000095:                                                                                          	# TO AWAKEN A JOB PUT TO SLEEP IN THE ABOVE FASHION:
052847,000096: 
052848,000097:    5201           00004        JOBWAKE            INHINT                                 	#
052849,000098:    5202           54065                           TS       NEWLOC                        	#
052850,000099:    5203           45016                           CS       TWO                           	# EXIT IS VIA FINDVAC/NOVAC PROCEDURES.
052851,000100:    5204           26002                           ADS      Q                             	#
052852,000101:    5205           35225                           CAF      EXECBANK                      	#

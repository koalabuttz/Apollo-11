036194,000874: 26,3004           33335 05707  36KFT/S            2DEC     109.728    B-7                	# (-7) M/CS = 36 KFT/S (-7)
036195,000875: 
036196,000876: 26,3006           36365 30244  20KFT/S            2DEC     121.92     B-7                	# (-6) M/CS = 2 20KFT/S (-7)

032068,001623:                                                                                          	# NAME          S40.8 - CROSS PRODUCT STEERING
032069,001624:                                                                                          	# FUNCTION      (1) UPDATES THE VELOCITY-TO-BE-GAINED VECTOR.
032070,001625:                                                                                          	#               (2) GENERATES ANGULAR RATE STEERING COMMANDS FOR AUTOPILOT.
032071,001626:                                                                                          	#               (3) ESTABLISHES ENGINE CUT-OFF SIGNALS AT APPROPRIATE TIMES.
032072,001627:                                                                                          	#               (4) INITIATES THRUST-FAIL ROUTINE, R40
032073,001628:                                                                                          	# CALLING SEQ   CALL S40.8
032074,001629:                                                                                          	# INPUT         VGPREV  -       LAST VALUE OF THE VELOCITY-TO-BE-GAINED VECTOR
032075,001630:                                                                                          	#                               PRIOR TO UPDATING IN METERS/CS AT +7.
032076,001631:                                                                                          	#               DELVREF -       CHANGE IN VEHICLE VELOCITY SINCE LAST MEASUMEMENT
032077,001632:                                                                                          	#                               IN METERS/CS AT +7.
032078,001633:                                                                                          	#               BDT     -       EFFECT OF RATE OF CHANGE OF REQUIRED VELOCITY AND
032079,001634:                                                                                          	#                               GRAVITY DURING DT UPON VELOCITY-TO-BE-GAINED IN
032080,001635:                                                                                          	#                               METERS/CS AT +7.
032081,001636:                                                                                          	#               CSTEER  -       A SCALAR OF THE STEERING LAW, SC.AT B+1, USED FOR
032082,001637:                                                                                          	#                               SPS AIMPOINT STEERING MANEUVERS
032083,001638:                                                                                          	#               IDLEFAIL -      A FLAG TO INHIBIT (IDLE) THE THRUST-FAIL ROUTINE
032084,001639:                                                                                          	#               STEERSW -       A SWITCH TO PRECLUDE NEEDLESS CONDUCT OF STEERING
032085,001640:                                                                                          	#               REFSMMAT, DAPDATR1, PIPTIME
032086,001641:                                                                                          	#               EREPFRAC, ETDECAY, KPRIMEDT FOR TVC
032087,001642:                                                                                          	# OUTPUT        TTOGO   -       TIME REMAINING FOR ENGINE BURN IN CS AT +28
032088,001643:                                                                                          	#               OMEGAC  -       DP VECTOR RATE COMMAND, SC.AT 1/(2TVCDT) REVS/SEC
032089,001644:                                                                                          	#               VG, VGPREV, VGDISP, TGO, TIG, SCALED AS NOTED IN CODING
032090,001645:                                                                                          	#               STEERSW, IMPULSW, NVWORD1
032091,001646:                                                                                          	#               REPFRAC, CNTR, VCNTR, VCNTRTMP FOR TVC (R40 INTERFACING)
032092,001647:                                                                                          	# DEBRIS        OMEGAXC, +1

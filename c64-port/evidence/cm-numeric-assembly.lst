007638,000167: 05,2364           55302                           TS       DSRUPTSW                      	#
007639,000168: 
007640,000169: 05,2365           35021        DOFSTART           CAF      ZERO                          	# DO A FRESH START.
007641,000170: 05,2366           55360                           TS       ERESTORE                      	# ***** MUST NOT BE REMOVED FROM DOFSTART
007642,000171: 05,2367           55362                           TS       SMODE                         	# ***** MUST NOT BE REMOVED FROM DOFSTART
007643,000172: 05,2370           55501                           TS       UPSVFLAG                      	# UPDATE STATE VECTOR REQUEST FLAGWORD
007644,000173: 05,2371           00006                           EXTEND                                 	#
007645,000174: 05,2372           01005                           WRITE    CHAN5                         	# TURN OFF RCS JETS

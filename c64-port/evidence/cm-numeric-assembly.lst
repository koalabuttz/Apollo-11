008846,001375: 
008847,001376:                                                                                          	# NOTE,         THE FOLLOWING CONSTANT IS THE NUMBER OF ENTRIES IN EACH OF
008848,001377:                                                                                          	# ----          THE ABOVE LISTS-1(IE, THE NUMBER OF MAJOR MODES(EXCEPT P00)
008849,001378:                                                                                          	#               THAT CAN BE CALLED FROM THE KEYBOARD MINUS ONE)
008850,001379: 
008851,001380: 04,2520                        EPREMM1            EQUALS                                 	# END OF PREMM1 TABLE
008852,001381: 04,2457                                           SETLOC   PREMM1                        	# THIS CODING WILL AUTOMATICALLY CHANGE
008853,001382: 04,2457                        NO.MMS             =MINUS   EPREMM1                       	# THE "NOV37MM" CONSTANT AS ENTRIES ARE
008854,001383: 04,2000                                           SETLOC   VERB37                        	# INSERTED(IN) OR DELETED(FROM) THE
008855,001384: 04,2000                                           BANK                                   	# "PREMM1" TABLE.
008856,001385: 
008857,001386: 04,2520           00040        NOV37MM            ADRES    NO.MMS     -1                 	# ITEMS IN "PREMM1"TABLE - 1.  *DON'T MOVE*
008858,001387: 

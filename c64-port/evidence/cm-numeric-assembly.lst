034941,002058:                                                                                          	# PROGRAM DESCRIPTION - R56 - ALTERNATE LOS SIGHTING MARK ROUTINE
034942,002059: 
034943,002060:                                                                                          	# FUNCTIONAL DESCRIPTION
034944,002061: 
034945,002062:                                                                                          	#       TO PERFORM SIGHTING MARKS FOR THE BACK-UP ALIGNMENT PROGRAMS (P53,P54).  THE ASTRONAUT KNOWS THE
034946,002063:                                                                                          	#       COORDINATES (OPTICS) OF THE ALTERNATE LINE OF SIGHT HE MUST USE FOR THIS ROUTINE.  WHEN THE ASTRONAUT KEYS IN
034947,002064:                                                                                          	#       ENTER IN RESPONSE TO THE FLASHING V50 N25 R1-XXXXX THE CMC STORES THE THREE ICDU ANGLES AND TWO ANGLES DISPLAYED
034948,002065:                                                                                          	#       IN N92.
034949,002066: 
034950,002067:                                                                                          	# CALLING SEQUENCE
034951,002068: 
034952,002069:                                                                                          	#       CALL
034953,002070:                                                                                          	#               R56
034954,002071: 
034955,002072:                                                                                          	# SUBROUTINES CALLED
034956,002073: 
034957,002074:                                                                                          	#       A PORTION OF SXTMARK (VAC.AREA SEARCH)
034958,002075:                                                                                          	#       GOFLASH
034959,002076:                                                                                          	#       GOPERF1
034960,002077: 

018153,000048:                                                                                          	# ABOUT COF
018154,000049: 22,2744           74343                           DLOAD*   VXSC                          	#
018155,000050: 22,2745           04771                                    ARATE,1                       	#
018156,000051: 22,2746           03343                                    COF                           	#

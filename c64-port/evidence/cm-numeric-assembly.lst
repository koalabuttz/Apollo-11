061237,000029:                                                                                          	#            Colossus 2A
061238,000030: 
061239,000031:                                                                                          	# Page 1404
061240,000032:                                                                                          	# SUBROUTINE TO UPDATE THE PROGRAM NUMBER DISPLAY ON THE DSKY.
061241,000033: 
061242,000034: 43,3726                                           COUNT    02/PHASE                      	#

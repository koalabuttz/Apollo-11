032376,001931:                                                                                          	# NAME                  S40.13 - TIMEBURN
032377,001932: 
032378,001933:                                                                                          	# FUNCTION              (1) DETERMINE WHETHER A GIVEN COMBINATION OF VELOCITY-TO-
032379,001934:                                                                                          	#                       BE-GAINED AND ENGINE CHOICE RESULT IN A BURN TIME SUFFICIENT 
032380,001935:                                                                                          	#                       TO ALLOW STEERING AT THE VEHICLE DURING THE BURN, AND
032381,001936:                                                                                          	#                       (2) THE MAGNITUDE OF RESULTING BURN TIME - IF IT IS SHORT -
032382,001937:                                                                                          	#                       AND THE ASSOCIATED TIME OF THE ENGINE-OFF SIGNAL.
032383,001938: 
032384,001939:                                                                                          	# CALLING SEQ           VIA FINDVAC AS NEW JOB.
032385,001940: 
032386,001941:                                                                                          	# INPUT                 VGTIG - VELOCITY TO BE GAINED VECTOR (METERS/C.S.) AT +7
032387,001942:                                                                                          	#                       WEIGHT/G - MASS OF VEHICLE IN KGM AT TIG
032388,001943:                                                                                          	#                       F - ENGINE THRUST IN M.NEWTONS AT +7
032389,001944:                                                                                          	#                       MDOT -  RATE OF DECREASE OF VEHICLE MASS DURING ENGINE BURN
032390,001945:                                                                                          	#                               IN KILOGRAMS/CENTISECOND AT +3.  THIS SCALING MAY
032391,001946:                                                                                          	#                               REQUIRE MODIFICATION FOR SATURN BURNS.
032392,001947: 
032393,001948:                                                                                          	# OUTPUT                IMPULSW -       ZERO FOR STEERING
032394,001949:                                                                                          	#                               -       ONE FOR ATTITUDE HOLD
032395,001950:                                                                                          	#                       TGO     -       TIME TO BURN IN CENTISECONDS AT +14
032396,001951:                                                                                          	#                       THE QUANTITY M.NEWTON SHALL BE USED TO EXPRESS WEIGHT IN TERMS OF
032397,001952:                                                                                          	#                       (KILOGRAM*METER)/(CENTISECOND*CENTISECOND)
032398,001953:                                                                                          	#                       (1) M.NEWTON = (10000) NEWTONS
032399,001954: 
032400,001955: 16,2427  E7,1427                                  EBANK=   TGO                           	#

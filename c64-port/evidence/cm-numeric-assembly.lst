047004,000623:                                                                                          	# WHEN THE ROTATION COMMANDS ARE COMPLETED, IT IS NECESSARY TO REPLACE THESE COMMANDS BY NEW COMMANDS WHICH
047005,000624:                                                                                          	# CONTINUE ON WITH THE TRANSLATIONS IF ANY ARE PRESENT.
047006,000625: 
047007,000626:                                                                                          	# IN THIS SECTION THESE NEW COMMANDS ARE GENERATED AND STORED FOR REPLACEMENT OF THE CHANNEL COMMANDS WHEN THE
047008,000627:                                                                                          	# CORRESPONDING ROTATIONS ARE COMPLETED.

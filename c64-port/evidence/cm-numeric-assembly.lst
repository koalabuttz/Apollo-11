040821,001142:                                                                                          	#       PUSHLIST
040822,001143:                                                                                          	#           PUSHLOC-2   INTEGRATION TIME DT12 (CORRECTION TO T2)                DP      B28     CS
040823,001144:                                                                                          	#       OTHER
040824,001145:                                                                                          	#           R(T2)/      FINAL POSITION VECTOR                                   VECTOR .B29     METERS
040825,001146:                                                                                          	#           V(T2)/      FINAL VELOCITY VECTOR                                   VECTOR  B7      METERS/CS
040826,001147:                                                                                          	#           T2          FINAL TIME                                              DP      B28     CS
040827,001148: 
040828,001149:                                                                                          	# RTENCK3 (PRECISION INTEGRATION)
040829,001150: 
040830,001151:                                                                                          	#    CALLING SEQUENCE
040831,001152:                                                                                          	#       L       CALL
040832,001153:                                                                                          	#       L+1             RTENCK3
040833,001154: 
040834,001155:                                                                                          	#    ERASABLE INITIALIZATION REQUIRED
040835,001156:                                                                                          	#       R(T1)/          INITIAL POSITION VECTOR                                 VECTOR  B29     METERS
040836,001157:                                                                                          	#       V2(T1)/         POST IMPULSE INITIAL VELOCITY VECTOR                    VECTOR  B7      M/CS
040837,001158:                                                                                          	#       T1              INITIAL VECTOR TIME                                     DP      B28     CS
040838,001159:                                                                                          	#       T2              FINAL TIME                                              DP      B28     CS
040839,001160: 
040840,001161:                                                                                          	# EXIT MODE
040841,001162:                                                                                          	#       AT L+2 OF CALLING SEQUENCE
040842,001163: 

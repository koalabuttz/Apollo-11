008150,000679:                                                                                          	# Page 194
008151,000680:                                                                                          	# PROGRAM NAME          GOTOPOOH        ASSEMBLY        SUNDISK
008152,000681:                                                                                          	# LOG SECTION           FRESH START AND RESTART
008153,000682: 
008154,000683:                                                                                          	# FUNCTIONAL DESCRIPTION
008155,000684: 
008156,000685:                                                                                          	#       1. DISPLAY MAJOR MODE NUMBER 00 IN DSKY REGISTER R1 AND R3.  FLASH V50 N07 ON DSKY.  (M M CHANGE REQUEST)
008157,000686:                                                                                          	#       2. PERMIT A CURRENT PENDING REQUEST (FLASH ON DSKY) TO BE REPLACED (WITHOUT AN ABORT) BY THE MAJOR MODE
008158,000687:                                                                                          	#          CHANGE REQUEST.
008159,000688: 
008160,000689:                                                                                          	# INPUT/OUTPUT INFORMATION
008161,000690: 
008162,000691:                                                                                          	#       A. CALLING SEQUENCE             TC GOTOPOOH
008163,000692: 
008164,000693:                                                                                          	#       B. ERASABLE INITIALIZATION              NONE
008165,000694: 
008166,000695:                                                                                          	#       C. OUTPUT               FLASH VERB 50 NOUN 07 ON DSKY
008167,000696: 
008168,000697:                                                                                          	#       D. DEBRIS               L
008169,000698: 
008170,000699:                                                                                          	# PROGRAM ANALYSIS
008171,000700: 
008172,000701:                                                                                          	#       A. SUBROUTINES CALLED           GOPERF3, LINUS
008173,000702: 
008174,000703:                                                                                          	#       B. NORMAL EXIT              TCF ENDOFJOB
008175,000704: 
008176,000705:                                                                                          	#       C. ALARM AND ABORT EXITS                NONE
008177,000706: 
008178,000707:    4106                                           BLOCK    02                            	#
008179,000708:    4000                                           SETLOC   FFTAG10                       	#
008180,000709:    4000                                           BANK                                   	#

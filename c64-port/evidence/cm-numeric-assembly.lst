042772,000022:                                                                                          	##
042773,000023:                                                                                          	## This source code has been transcribed or otherwise adapted from digitized
042774,000024:                                                                                          	## images of a hardcopy from the MIT Museum.  The digitization was performed
042775,000025:                                                                                          	## by Paul Fjeld, and arranged for by Deborah Douglas of the Museum.  Many
042776,000026:                                                                                          	## thanks to both.  The images (with suitable reduction in storage size and
042777,000027:                                                                                          	## consequent reduction in image quality as well) are available online at
042778,000028:                                                                                          	## www.ibiblio.org/apollo.  If for some reason you find that the images are
042779,000029:                                                                                          	## illegible, contact me at info@sandroid.org about getting access to the 
042780,000030:                                                                                          	## (much) higher-quality images which Paul actually created.
042781,000031:                                                                                          	##
042782,000032:                                                                                          	## Notations on the hardcopy document read, in part:
042783,000033:                                                                                          	##
042784,000034:                                                                                          	##      Assemble revision 055 of AGC program Comanche by NASA
042785,000035:                                                                                          	##      2021113-051.  10:28 APR. 1, 1969  
042786,000036:                                                                                          	##
042787,000037:                                                                                          	##      This AGC program shall also be referred to as
042788,000038:                                                                                          	##                      Colossus 2A
042789,000039: 
042791,000041:                                                                                          	# NAME....TVCRESTART PACKAGE, CONSISTING OF REDOTVC, ENABL1, 2, CMDSOUT, PHSCHK2, ETC.
042792,000042:                                                                                          	# LOG SECTION...TVCRESTARTS                     SUBROUTINE...DAPCSM
042793,000043:                                                                                          	# MODIFIED BY SCHLUNDT                          21 OCTOBER 1968
042794,000044: 
042795,000045:                                                                                          	# FUNCTIONAL DESCRIPTION....
042796,000046: 
042797,000047:                                                                                          	#      *RESTART-PROOFS THE TVC DAPS, INCLUDING PITCHDAP, YAWDAP,
042798,000048:                                                                                          	#       TVCEXECUTIVE, ROLLDAP, TVCINIT4, TVCDAPON, AND CSM/.M V46 SWTCHOVR.
042799,000049: 
042800,000050:                                                                                          	#      *TVC RESTARTS DESERVE SPECIAL CONSIDERATION IN SEVERAL AREAS.
042801,000051:                                                                                          	#       RESTART DOWN-TIME IS IMPORTANT BECAUSE OF THE TRANSIENTS INTRODUCED
042802,000052:                                                                                          	#       BY THE THRUST VECTOR RETURN TO THE ACTUATOR MECHANICAL NULLS
042803,000053:                                                                                          	#       FOLLOWING TVC- AND OPTICS-ERROR-COUNTER-DISENABLES (CHANNEL 12).
042804,000054:                                                                                          	#       TVC USES A MIXTURE OF WAITLIST, T5, T6, AND JOB CALLS.  THERE IS
042805,000055:                                                                                          	#       FILTER MEMORY (UP TO 6TH ORDER) TO BE PROTECTED IF WILD TRANSIENTS
042806,000056:                                                                                          	#       ARE TO BE AVOIDED.  COUNTERS ARE INVOLVED FOR ONE-SHOT
042807,000057:                                                                                          	#       CORRECTIONS AND GAIN UPDATES.  THE GIMBAL TRIM ESTIMATORS AND THE
042808,000058:                                                                                          	#       BODY AXIS ATTITUDE ERROR INTEGRATORS INVOLVE DIGITAL SUMMATION.
042809,000059:                                                                                          	#       DIGITAL DIFFERENTIATORS ARE INVOLVED IN THE BODY AXIS RATE ESTIMA-
042810,000060:                                                                                          	#       TIONS AND IN THE OUTPUTTING OF ACTUATOR COMMANDS.  THERE IS AN
042811,000061:                                                                                          	#       OFFSET-TRACKER-FILTER TO PROTECT.  ETC., ETC.
042812,000062: 
042813,000063:                                                                                          	#      *THOSE QUANTITIES WHICH MUST BE PROTECTED ARE STORED IN TEMPORARY
042814,000064:                                                                                          	#       REGISTERS AS THEY ARE COMPUTED, FOR UPDATING THE REAL REGISTERS
042815,000065:                                                                                          	#       DURING COPYCYCLES.
042816,000066: 
042817,000067:                                                                                          	#      *THE SEVERAL COPYCYCLES ARE EACH PROTECTED BY PHASE POINTS AT THEIR
042818,000068:                                                                                          	#       BEGINNING AND AT THEIR TERMINATION.  THE PHASE POINTS ARE SIMPLY
042819,000069:                                                                                          	#       ..INCR.. INSTRUCTIONS, EITHER ..INCR TVCEXPHS.. FOR COPYCYCLES
042820,000070:                                                                                          	#       IN THE TVCEXECUTIVE, OR ..INCR TVCPHASE.. FOR THE PITCH AND YAW
042821,000071:                                                                                          	#       COPYCYCLES.  INDEXING ON EACH OF THESE POINTERS THEN PERMITS A
042822,000072:                                                                                          	#       RETURN TO THE APPROPRIATE RESTART POINTS.
042823,000073: 
042824,000074:                                                                                          	#      *IF A RESTART OCCURS DURING EITHER COPYCYCLE, THAT COPYCYCLE IS
042825,000075:                                                                                          	#       COMPLETED.  THEN THE NORMAL TVCINIT4....DAPINIT....PITCHDAP STARTUP
042826,000076:                                                                                          	#       SEQUENCE IS CALLED UPON TO GET THINGS GOING AGAIN.
042827,000077: 
042828,000078:                                                                                          	#      *TVC-ENABLE AND OPTICS-ERROR-COUNTER ENABLE MUST BE SET ASAP
042829,000079:                                                                                          	#       (ALLOWING FOR PROCEDURAL DELAYS).  THEN THE ENGINES ARE COMMANDED
042830,000080:                                                                                          	#       TO THE P,YACTOFF TRIM VALUES.  THE DAPS ARE THEN READY TO GO ON THE
042831,000081:                                                                                          	#       AIR, WITH THE REGULAR STARTUP SEQUENCE, EITHER AT MRCLEAN FOR A
042832,000082:                                                                                          	#       COMPLETE INITIALIZATION OR AT TVCINIT4 FOR A PARTIAL INITIALIZATION
042833,000083: 
042834,000084:                                                                                          	#      *FOR RESTARTS PRIOR TO THE SETTING OF THE T5 BITS AT DOTVCON THE
042835,000085:                                                                                          	#       PRE40.6 SECTION OF S40.6 TAKES CARE OF RE-ESTABLISHING TRIMS.
042836,000086: 
042837,000087:                                                                                          	#      *IF A RESTART OCCURS DURING THE TVCEXEC....TVCEXFIN SEQUENCE THE
042838,000088:                                                                                          	#       COMPUTATIONS WILL BE COMPLETED, STARTING AT THE APPROPRIATE RESTART
042839,000089:                                                                                          	#       POINT, AFTER THE DAPS ARE READY TO GO ON THE AIR.
042840,000090: 
042841,000091:                                                                                          	#      *IF A RESTART OCCURS PRIOR TO TVCINIT4 (TVCPHASE = -1) E.G. DURING
042842,000092:                                                                                          	#       THE EARLY DAP INITIALIZATION PHASE, THE DAP STARTUP SEQUENCE IS
042843,000093:                                                                                          	#       ENTERED AT MRCLEAN FOR A FULL INITIALIZATION.
042844,000094: 
042845,000095:                                                                                          	#      *FOR RESTARTS DURING CSM/LM V46 SWITCH-OVER, TVCPHASE IS SET TO -2.
042846,000096:                                                                                          	#       AND THE RESTART LOGIC GOES BACK TO REDO SWITCH-OVER (AFTER THE
042847,000097:                                                                                          	#       NORMAL DAP RESTART SEQUENCE IS FOLLOWED).
042848,000098: 
042849,000099:                                                                                          	#      *RESTARTS ARE NOT CRITICAL TO THE ROLL DAP PERFORMANCES HENCE THE
042850,000100:                                                                                          	#       THE ROLL DAP IS MERELY RESTARTED.
042851,000101: 
042852,000102:                                                                                          	#      *RESTARTS DURING A STROKE TEST (STROKER IS NON-ZERO) WILL CAUSE THE
042854,000104:                                                                                          	#       STROKE TEST TO BE TERMINATED.  A NEW V68 ENTRY WILL BE REQUIRED
042855,000105:                                                                                          	#       TO GET IT GOING AGAIN (NO AUTOMATIC RESTART).
042856,000106:                                                                                          	#  
042857,000107:                                                                                          	#      *REDOTVC IS REACHED FOLLOWING ANY RESTART WHICH FINDS THE T5 BITS
042858,000108:                                                                                          	#       (BITS 15,14 OF FLAGWRD6) SET FOR TVC.  DOTVCON SETS TVCPHASE = -1
042859,000109:                                                                                          	#       AND TVC EXPHS = 0 JUST BEFORE SETTING THESE BITS, JUST BEFORE
042860,000110:                                                                                          	#       MAKING THE T5 CALL TO TVCDAPON.  ON A NORMAL SHUTDOWN DOTVCRCS
042861,000111:                                                                                          	#       CALLS RCSDAPON, WHICH RESETS THE T5 BITS FOR RCS.
042862,000112: 
042863,000113:                                                                                          	# CALLING SEQUENCE....T5, IN PARTICULAR BY ELRSKIP OF FRESH START/RESTART
042864,000114: 
042865,000115:                                                                                          	# NORMAL EXIT MODES....RESUME, NOQRSM, POSTJUMP (TO TVCINIT4 OR MRCLEAN)
042866,000116: 
042867,000117:                                                                                          	# ALARM OR ABORT EXIT MODES....NONE
042868,000118: 
042869,000119:                                                                                          	# SUBROUTINES CALLED....
042870,000120: 
042871,000121:                                                                                          	#      *PCOPY+1, YCOPY+1 (PITCH AND YAW COPYCYCLES)
042872,000122:                                                                                          	#      *ENABLE1,2, CMDSOUT (RE-ESTABLISH ACTUATOR TRIMS)
042873,000123:                                                                                          	#      *MRCLEAN OR TVCINIT4 (TVCDAP INITIALIZATIONS)
042874,000124:                                                                                          	#      *SWICHOVR +5 (CSM/LM V46 SWITCH-OVER)
042875,000125:                                                                                          	#      *EXRSTRT AND TVCEXECUTIVE PHASE POINTS 1 THRU 6
042876,000126:                                                                                          	#      *WAITLIST, IBNKCALL, POSTJUMP, ISWCALL
042877,000127: 
042878,000128:                                                                                          	# OTHER INTERFACES....DOTVCON AND RCSDAPON (T5 BITS), ELRSKIP (CALLS IT)
042879,000129: 
042880,000130:                                                                                          	# ERASABLE INITIALIZATION REQUIRED....
042881,000131: 
042882,000132:                                                                                          	#      *T5 BITS (1,0), TVCPHASE (-2,-1,0,1,2,3), TVCEXPHS (1 THRU 6)
042883,000133:                                                                                          	#      *TVC DAP VARIABLES
042884,000134:                                                                                          	#      *OPERATIONS PERFORMED BY REDOTVC ARE BASED ON THE ASSUMPTION THAT
042885,000135:                                                                                          	#       THE TVC DAPS ARE RUNNING NORMALLY
042886,000136: 
042887,000137:                                                                                          	# OUTPUT....
042888,000138: 
042889,000139:                                                                                          	#      *PITCH AND YAW TVC DAP COPYCYCLES COMPLETED IF INTERUPTED
042890,000140:                                                                                          	#      *TVCEXECUTIVE COMPLETED IF INTERUPTED
042891,000141:                                                                                          	#      *STROKE TEST TERMINATED IF INTERRUPTED
042892,000142:                                                                                          	#      *CSM/LM V46 SWITCH-OVER REPEATED IF INTERRUPTED
042893,000143:                                                                                          	#      *ACTUATOR TRIMS RE-ESTABLISHED (ACTUATORS BACK ON THE AIR)
042894,000144:                                                                                          	#      *TVC DAP INITIALIZATION AS REQUIRED
042895,000145:                                                                                          	#      *ALL TVC DAP OPERATIONS ON THE AIR
042896,000146: 
042897,000147:                                                                                          	# DEBRIS....TVC TEMPORARIES IN EBANK6
042898,000148: 
042900,000150: 
042901,000151: 16,3140                                           BANK     16                            	#
042902,000152: 16,2000                                           SETLOC   DAPROLL                       	#
042903,000153: 16,2000                                           BANK                                   	#
042904,000154: 16,3140  E6,1644                                  EBANK=   TVCPHASE                      	#
042905,000155: 16,3140                                           COUNT*   $$/RSRT                       	#
042906,000156: 
042907,000157: 16,3140           22016        REDOTVC            LXCH     BANKRUPT                      	# TVC RESTART PACKAGE
042908,000158: 16,3141           00006                           EXTEND                                 	#
042909,000159: 16,3142           22012                           QXCH     QRUPT                         	# (..TCR.. IN ..FINCOPY..)
042910,000160: 
042911,000161: 16,3143           11651        EXECPHS            CCS      TVCEXPHS                      	# CHECK TVCEXECUTIVE PHASE
042912,000162: 16,3144           13146                           TCF      +2                            	#       MUST RESTART TVCEXECUTIVE
042913,000163: 16,3145           13152                           TCF      TVCDAPHS                      	#       NO NEED TO RESTART TVCEXECUTIVE
042914,000164: 
042915,000165: 16,3146           34334                           CAF      NINE                          	# 9CS DELAY TO FORCE EXRSTRT TO OCCUR
042916,000166: 16,3147           05245                           TC       WAITLIST                      	#       BEFORE PITCHDAP, AFTER CMDSOUT
042917,000167: 16,3150  E6,1651                                  EBANK=   TVCEXPHS                      	#
042918,000168: 16,3150           03253 34066                     2CADR    EXRSTRT                       	#
042919,000169: 
042920,000170: 16,3152           47700        TVCDAPHS           CS       OCT37776                      	# CHECK BITS 15 AND 1 OF TVCPHASE TO SEE
042921,000171: 16,3153           71644                           MASK     TVCPHASE                      	#       DAP RESTART LOCATION (-1,1,2,3)
042922,000172: 16,3154           10000                           CCS      A                             	#
042923,000173: 16,3155           13240                           TCF      FINCOPY                       	#       FINISH THE COPYCYCLE FIRST
042924,000174: 16,3156           13163                           TCF      ENABL1                        	#       JUST PREPARE THE OUTCOUNTERS AND GO
042925,000175: 
042926,000176: 16,3157           41644                           CS       TVCPHASE                      	# TEST FOR TVCPHASE = -2
042927,000177: 16,3160           75016                           MASK     BIT2                          	#       (THIS INDICATES RESTART OCCURRED
042928,000178: 16,3161           00006                           EXTEND                                 	#        DURING CSM/LM V46 SWITCH-OVER)
042929,000179: 16,3162           13244                           BZF      TRIM/CMD                      	# NO, TVCPHASE = -1, RSTRT WAS IN TVCINIT
042930,000180: 
042931,000181: 16,3163           35010        ENABL1             CAF      BIT8                          	# TVC ENABLE, FOLLOWED BY 40 MS (MIN) WAIT
042932,000182: 16,3164           65005                           AD       BIT11                         	#       SET BIT FOR OPTICS-DAC-ENABLE ALSO
042933,000183: 16,3165           00006                           EXTEND                                 	#       (ENABL1 ENTERED FROM TVCDAPHS / FINCOPY)
042934,000184: 16,3166           05012                           WOR      CHAN12                        	#
042935,000185: 16,3167           33257                           CAF      TVCADDR                       	# WAIT, CALLING ENABL2 (BBCON THERE)
042936,000186: 16,3170           55312                           TS       T5LOC                         	#
042937,000187: 16,3171           33263                           CAF      TVCADDR    +4                 	#       60 MS (TVCEXADR)
042938,000188: 16,3172           54030                           TS       TIME5                         	#
042939,000189: 
042940,000190: 16,3173           15333                           TCF      RESUME                        	#
042941,000191: 
042942,000192: 16,3174           22016        ENABL2             LXCH     BANKRUPT                      	# CONTINUE PREPARATION OF OUTCOUNTERS
042943,000193: 
042944,000194: 16,3175           35016                           CAF      BIT2                          	# OPTICS ERROR CNTR ENABLE, 4MS MIN WAIT
042945,000195: 16,3176           00006                           EXTEND                                 	#
042946,000196: 16,3177           05012                           WOR      CHAN12                        	#
042948,000198: 16,3200           33261                           CAF      TVCADDR    +2                 	# WAIT, CALLING CMDSOUT (BBCON THERE)
042949,000199: 16,3201           55312                           TS       T5LOC                         	#
042950,000200: 16,3202           37700                           CAF      OCT37776                      	#       20MS
042951,000201: 16,3203           54030                           TS       TIME5                         	#
042952,000202: 
042953,000203: 16,3204           15335                           TCF      NOQRSM                        	#
042954,000204: 
042955,000205: 16,3205           22016        CMDSOUT            LXCH     BANKRUPT                      	# CONTINUE PREPARATION OF OUTCOUNTERS
042956,000206: 16,3206           00006                           EXTEND                                 	#
042957,000207: 16,3207           22012                           QXCH     QRUPT                         	#
042958,000208: 
042959,000209: 16,3210           45021                           CS       ZERO                          	# MOST RECENT ACTUATOR COMMANDS
042960,000210: 16,3211           61623                           AD       PCMD                          	#       (AVOID +0)
042961,000211: 16,3212           54054                           TS       TVCPITCH                      	#
042962,000212: 16,3213           45021                           CS       ZERO                          	#
042963,000213: 16,3214           61624                           AD       YCMD                          	#
042964,000214: 16,3215           54053                           TS       TVCYAW                        	#
042965,000215: 
042966,000216: 16,3216           35062                           CAF      PRIO6                         	# RELEASE THE COUNTERS (BITS 11,12)
042967,000217: 16,3217           00006                           EXTEND                                 	#
042968,000218: 16,3220           05014                           WOR      CHAN14                        	#
042969,000219: 
042970,000220: 16,3221           11644        PHSCHK2            CCS      TVCPHASE                      	# CHECK TVCPHASE AGAIN
042971,000221: 16,3222           13232                           TCF      CHKSTRK                       	#
042972,000222: 16,3223           13232                           TCF      CHKSTRK                       	#
042973,000223: 16,3224           10000                           CCS      A                             	# A CONTAINS THE DIMINISHED ABSOLUTE OF
042974,000224: 16,3225           03230                           TC       +3                            	# TVCPHASE (-2 BECOMES +1. -1 BECOMES +0)
042975,000225: 
042976,000226: 16,3226           04701                           TC       POSTJUMP                      	#       REPEAT TVC INITIALIZATION
042977,000227: 16,3227           36152                           CADR     MRCLEAN                       	#       (DO NOT RETURN)
042978,000228: 
042979,000229: 16,3230           04740                 +3        TC       IBNKCALL                      	#       REPEAT CSM/LM V46 SWITCH-OVER
042980,000230: 16,3231           36361                           CADR     SWICHOVR   +5                 	#       (RETURN TO CHECK FOR STROKE TEST)
042981,000231: 
042982,000232: 16,3232           11574        CHKSTRK            CCS      STROKER                       	# CHECK FOR STROKE TEST IN PROGRESS
042983,000233: 16,3233           13250                           TCF      TSTINITJ                      	# YES, KILL IT
042984,000234: 16,3234           13236                           TCF      +2                            	# NO, PROCEED
042985,000235: 16,3235           13250                           TCF      TSTINITJ                      	# YES, KILL IT
042986,000236: 
042987,000237: 16,3236           04701                 +4        TC       POSTJUMP                      	#       IF POSITIVE OR ZERO, RESTART AT
042988,000238: 16,3237           36324                           CADR     TVCINIT4                      	#               TVCINIT4 (ZEROS TVCPHASE, AND
042989,000239:                                                                                          	#               CALLS TVC DAPS VIA DAPINIT)
042990,000240: 16,3240           51644        FINCOPY            INDEX    TVCPHASE                      	# PICK UP THE APPROPRIATE COPYCYCLE
042991,000241: 16,3241           33257                           CAF      TVCCADR                       	#
042992,000242: 16,3242           04744                           TCR      ISWCALL                       	# RE-ENTER THE COPYCYCLE, RETURN AT END
042993,000243: 16,3243           13163                           TCF      ENABL1                        	# NOW PREPARE THE OUTCOUNTERS
042994,000244: 
042995,000245: 16,3244           00006        TRIM/CMD           EXTEND                                 	# TVCDAPON INITIALIZATION NOT COMPLETED,
042997,000247: 16,3245           31424                           DCA      PACTOFF                       	#       EG. P,YCMD MAY NOT BE SET.  SET...
042998,000248: 16,3246           53624                           DXCH     PCMD                          	#
042999,000249: 16,3247           13163                           TCF      ENABL1                        	# NOW PREPARE THE OUTCOUNTERS
043000,000250: 
043001,000251: 16,3250           35021        TSTINITJ           CAF      ZERO                          	# DISABLE STROKE TEST (-0 SHOWS PRIOR V68)
043002,000252: 16,3251           55574                           TS       STROKER                       	# (+0 MEANS NEW V68 REQUIRED FOR STARTUP)
043003,000253: 
043004,000254: 16,3252           13236                           TCF      CHKSTRK    +4                 	#
043005,000255: 
043006,000256: 16,3253           51651        EXRSTRT            INDEX    TVCEXPHS                      	# TVCEXECUTIVE RESTARTS....GO TO
043007,000257: 16,3254           33263                           CAF      TVCEXADR                      	#       APPROPRIATE RESTART POINT
043008,000258: 16,3255           50000                           INDEX    A                             	#
043009,000259: 16,3256           10000                           TCF      0                             	#
043010,000260: 
043011,000261:                                                                                          	# TVC RESTART TABLES.... ORDER IS REQUIRED.  HI-ORDER WORDS ONLY, OF 2CADRS, SINCE BBCON IS ALREADY THERE.
043012,000262: 
043013,000263: 16,3257  16,3257               TVCADDR            =        TVCCADR                       	# TABLE OF CADRS, UNUSED LOCS FOR GENADRS
043014,000264: 16,3257           03174        TVCCADR            GENADR   ENABL2                        	# (FOR T5 CALL, UNUSED TABLE LOC)
043015,000265: 16,3260           40675                 +1        CADR     PCOPY      +1                 	# PITCH COPYCYCLE
043016,000266: 16,3261           03205                 +2        GENADR   CMDSOUT                       	# (FOR T5 CALL, UNUSED TABLE LOC)
043017,000267: 16,3262           41051                 +3        CADR     YCOPY      +1                 	# YAW COPYCYCLE
043018,000268: 16,3263           37772        TVCEXADR           OCT      37772                         	# (UNUSED TABLE LOC, FILL WITH 60MS, T5)
043019,000269: 16,3264           03003                 +1        GENADR   EXECCOPY   +1                 	# TVCEXECUTIVE RESTART POINTS (ORDERED)
043020,000270: 16,3265           03011                 +2        GENADR   1SHOTCHK                      	#
043021,000271: 16,3266           03040                 +3        GENADR   TEMPSET                       	#
043022,000272: 16,3267           03043                 +4        GENADR   CORSETUP                      	#
043023,000273: 16,3270           03121                 +5        GENADR   CORCOPY    +1                 	#
043024,000274: 16,3271           03132                 +6        GENADR   CNTRCOPY                      	#
(End of include-file TVCRESTARTS.agc, resuming MAIN.agc)
043024,000126: 

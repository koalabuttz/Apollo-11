054564,000036: 
054566,000038:                                                                                          	#  INCORP1--PERFORMS THE SIX DIMENSIONAL STATE VECTOR DEVIATION FOR POSITI
054567,000039:                                                                                          	# ON AND VELOCITY OR THE NINE DIMENSIONAL DEVIATION OF POSITION,VELOCITY,A
054568,000040:                                                                                          	# ND RADAR OR LANDMARK BIAS.THE OUTPUT OF THE BVECTOR ROUTINE ALONG WITH T
054569,000041:                                                                                          	# HE ERROR TRANSITION MATRIX(W) ARE USED AS INPUT TO THE ROUTINE.THE DEVIA
054570,000042:                                                                                          	# TION IS OBTAINED BY COMPUTING AN ESTIMATED TRACKING MEASUREMENT FROM THE
054571,000043:                                                                                          	# CURRENT STATE VECTOR AND COMPARING IT WITH AN ACTUAL TRACKING MEASUREMEN
054572,000044:                                                                                          	# T AND APPLYING A STATISTICAL WEIGHTING VECTOR.
054573,000045: 
054574,000046:                                                                                          	# INPUT
054575,000047:                                                                                          	#        DMENFLG = 0 6DIMENSIONAL BVECTOR  1= 9DIMENSIONAL
054576,000048:                                                                                          	#              W = ERROR TRANSITION MATRIX 6X6 OR 9X9
054577,000049:                                                                                          	#       VARIANCE = VARIANCE (SCALAR)
054578,000050:                                                                                          	#         DELTAQ = MEASURED DEVIATION (SCALAR)
054579,000051:                                                                                          	#        BVECTOR = 6 OR 9 DIMENSIONAL BVECTOR
054580,000052: 
054581,000053:                                                                                          	# OUTPUT
054582,000054:                                                                                          	#         DELTAX = STATE VECTOR DEVIATIONS 6 OR 9 DIMENSIONAL
054583,000055:                                                                                          	#             ZI = VECTOR USED FOR THE INCORPORATION 6 OR 9 DIMENSIONAL
054584,000056:                                                                                          	#          GAMMA = SCALAR
054585,000057:                                                                                          	#          OMEGA = OMEGA WEIGHTING VECTOR 6 OR 9 DIMENTIONAL
054586,000058: 
054587,000059:                                                                                          	# CALLING SEQUENCE
054588,000060:                                                                                          	#       L       CALL    INCORP1
054589,000061: 
054590,000062:                                                                                          	# NORMAL EXIT
054591,000063:                                                                                          	#       L+1 OF CALLING SEQUENCE
054592,000064: 
054593,000065: 37,3773                                           BANK     37                            	#
054594,000066: 36,2000                                           SETLOC   MEASINC                       	#
054595,000067: 36,2000                                           BANK                                   	#
054596,000068: 
054597,000069: 36,3254                                           COUNT*   $$/INCOR                      	#
054598,000070: 
054599,000071: 36,3254  E5,1400                                  EBANK=   W                             	#

036938,000377:                                                                                          	# ROUTINE NAME: ONMNITOR
036939,000378:                                                                                          	# MOD 04 BY BAIRNSFATHER 30 APR 1968    REDO ONMNITOR TO SAVE PIPS EACH 0.5 SEC FOR TM,ENTRY.
036940,000379:                                                                                          	# MOD 03 BY FISHER DECEMBER 1967
036941,000380:                                                                                          	# MOD 02 BY RYE SEPT 1967
036942,000381:                                                                                          	# MOD 01 BY KOSMALA 23 MAR 1967
036943,000382:                                                                                          	# MOD 00 BY KOSMALA 27 FEB 1967
036944,000383: 
036945,000384:                                                                                          	# FUNCTIONAL DESCRIPTION
036946,000385: 
036947,000386:                                                                                          	#       THE PURPOSE OF ONMONITOR IS TO PROVIDE 1/2 SEC. READING OF PIPAS FOR DOWNLIST DURING ENTRY.
036948,000387:                                                                                          	#       X,Y,ZPIPBUF CONTAIN PRESENT VALUES X,Y,ZOLDBUF CONTAIN VALUES FROM PREVIOUS READING.
036949,000388: 
036950,000389:                                                                                          	# CALLING SEQUENCE
036951,000390: 
036952,000391:                                                                                          	#       CALL AS WAITLIST TASK. TERMINATES ITSELF IN TASKOVER
036953,000392: 
036954,000393:                                                                                          	# INITIALISATION
036955,000394: 
036956,000395:                                                                                          	#       PIPCTR = 2 (FOR DT = 0.5 SEC)
036957,000396:                                                                                          	#       X,Y,ZPIPBUF SET TO PREVIOUS PIPAX,Y,Z
036958,000397: 
036959,000398:                                                                                          	# OUTPUT
036960,000399: 
036961,000400:                                                                                          	#       X,Y,ZPIPBUF, X,Y,ZOLDBUF
036962,000401: 
036963,000402:                                                                                          	# DEBRIS
036964,000403: 
036965,000404:                                                                                          	#       X,Y,ZPIPBUF CONTAIN LAST PIPAX,Y,Z VALUES
036966,000405:                                                                                          	#               X,Y,ZOLDBUF CONTAIN LAST-BUT-ONE PIPAX,Y,Z VALUES
036967,000406:                                                                                          	#       RUPTREG1
036968,000407:                                                                                          	#       PIPCTR
036969,000408: 
036970,000409: 37,3064           55227        ONMNITOR           TS       PIPCTR                        	#
036971,000410: 

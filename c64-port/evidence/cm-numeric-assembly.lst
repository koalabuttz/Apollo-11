039476,000104: 37,3550           17572                           STODL    UBY/2                         	# =(-SMCI, NOISE, SMSI)/2
039477,000105: 37,3551           00003                                    2                             	# CM /2 REPLACES NOISE
039478,000106: 37,3552           17574                           STODL    UBY/2      +2                 	# UBY/2=(-SMCI, CM, SMSI)/2
039479,000107: 37,3553           00031                                    24D                           	# AOG/PIP
039480,000108: 37,3554           41434                           RTB      PUSH                          	# TO PDL 4
039481,000109: 37,3555           45513                                    CDULOGIC                      	#
039482,000110: 37,3556           65356                           SIN      PDDL                          	# XCH PDL 4.  SAVE SO /2
039483,000111: 37,3557           74346                           COS      VXSC                          	# CO /2
039484,000112: 37,3560           03572                                    UBY/2                         	#
039485,000113: 37,3561           17572                           STODL    UBY/2                         	# UBY/2=(-COSMCI, COCM, COSMSI)/4
039486,000114: 37,3562           00005                                    4D                            	# SO /2
039487,000115: 37,3563           57405                           DMP      DCOMP                         	#
039488,000116: 37,3564           03570                                    UBX/2      +4                 	# -SI /2
039489,000117: 37,3565           77615                           DAD                                    	#
039490,000118: 37,3566           03572                                    UBY/2                         	# INCREMENT BY (SOSI /4)
039491,000119: 37,3567           17572                           STODL    UBY/2                         	#
039492,000120:                                                                                          	# SO /2 FROM PDL 4
039493,000121: 37,3570           43205                           DMP      DAD                           	#
039494,000122: 37,3571           03564                                    UBX/2                         	# CI /2
039495,000123: 37,3572           03576                                    UBY/2      +4                 	#
039496,000124: 37,3573           27576                           STOVL    UBY/2      +4                 	# YB/4                          PLATFORM COORDS
039497,000125: 
039498,000126:                                                                                          	# YB = (-COSMCI + SOSI , COCM , COSMSI + SOCI )
039499,000127: 
039500,000128: 37,3574           03572                                    UBY/2                         	#
039501,000129: 37,3575           72505                           VXM      VSL2                          	#
039502,000130: 37,3576           01736                                    REFSMMAT                      	# .5 UNIT
039503,000131: 37,3577           17572                           STODL    UBY/2                         	# YB/2 DONE                     REF COORDS
039505,000133:                                                                                          	# CM /2 FROM PDL 2
039506,000134: 37,3600           76561                           VXSC     VSL1                          	#
039507,000135: 37,3601           03564                                    UBX/2                         	#
039508,000136: 37,3602           17564                           STODL    UBX/2                         	# =( CMCI, NOISE, -CMSI)/2
039509,000137: 37,3603           77626                           STADR                                  	# SM /2 FROM PDL 0
039510,000138: 37,3604           50211                           STOVL    UBX/2      +2                 	# SM /2 REPLACES NOISE
039511,000139: 37,3605           03564                                    UBX/2                         	# XB/2                          PLATFORM COORDS
039512,000140: 
039513,000141:                                                                                          	# XB = ( CMCI , SM , -CMSI )
039514,000142: 
039515,000143: 37,3606           76505                           VXM      VSL1                          	#
039516,000144: 37,3607           01736                                    REFSMMAT                      	# .5 UNIT
039517,000145: 37,3610           03564                           STORE    UBX/2                         	# XB/2 DONE                     REF COORDS
039518,000146: 
039519,000147: 37,3611           76435                           VXV      VSL1                          	#
039520,000148: 37,3612           03572                                    UBY/2                         	#
039521,000149: 37,3613           27600                           STOVL    UBZ/2                         	# ZB/2 DONE                     REF COORDS
039522,000150: 
039523,000151:                                                                                          	# EQUIVALENT TO
039524,000152:                                                                                          	# ZB = ( SOSMCI + COSI , -SOCM , -SOSMSI + COCI )
039525,000153: 
039526,000154: 37,3614           03542                                    UXA/2                         	# -UVREL/2 = -UVA/2
039527,000155: 37,3615           53435                           VXV      UNIT                          	# GET UNIT(-UVREL*UBY)/2 = UL/2
039528,000156: 37,3616           03572                                    UBY/2                         	# YB/2
039529,000157: 37,3617           50206                           PUSH     DOT                           	# UL/2 TO PDL 0,5
039530,000158: 37,3620           03556                                    UZA/2                         	# UNA/2
039531,000159: 37,3621           24021                           STOVL    COSTH                         	# COS(ROLL)/4
039532,000160: 37,3622           00001                                    0                             	# UL/2
039533,000161: 
039534,000162: 37,3623           77641                           DOT                                    	#
039535,000163: 37,3624           03550                                    UYA/2                         	#
039536,000164: 37,3625           34023                           STCALL   SINTH                         	# -SIN(ROLL)/4
039537,000165: 37,3626           47256                                    ARCTRIG                       	#
039538,000166: 37,3627           24007                           STOVL    6D                            	# -(ROLL/180) /2
039539,000167: 37,3630           03572                                    UBY/2                         	#
039540,000168: 37,3631           72441                           DOT      SL1                           	# -UVA.UBY = -SIN(BETA)
039541,000169: 37,3632           03542                                    UXA/2                         	# -UVREL/2

061250,000042: 
061251,000043:    5357           55011        NEWMODEA           TS       MODREG                        	# ENTRY FOR MODE IN A.
061252,000044:    5360           35363        MMDSPLAY           CAF      +3                            	# DISPLAY MAJOR MODE.
061253,000045:    5361           22006        PREBJUMP           LXCH     BBANK                         	# PUTS BBANK IN L

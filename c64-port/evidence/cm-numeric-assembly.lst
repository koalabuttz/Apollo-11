046224,000438: 21,3724           00006                           EXTEND                                 	#
046226,000440: 21,3725           41516                           DCS      EDOT                          	#
046227,000441: 21,3726           21511                           DAS      KMPAC                         	#
046228,000442: 
046230,000444:                                                                                          	# COMPUTE THE JET ON TIME NECESSARY TO ACCOMPLISH THE DESIRED CHANGE IN RATE, IE
046231,000445: 
046232,000446:                                                                                          	#            T  = J/M(DELTA W)
046233,000447:                                                                                          	#             J
046234,000448: 
046235,000449:                                                                                          	#       DELTA W = DESIRED CHANGE IN S/C ANGULAR RATE AS DETERMINED BY THE
046236,000450:                                                                                          	#                 SWITCHING LOGIC, AT THIS POINT STORED IN KMPAC.
046237,000451: 
046238,000452:                                                                                          	#           J/M = S/C INERTIA TO TORQUE 9ATIO SCALED BY
046239,000453:                                                                                          	#                       (57.3/450)(B24/1600)(1/.8)
046240,000454:                                                                                          	#                 FOR 1 JET OPERATION  (M = 700 FT-LB).
046241,000455:                                                                                          	#                 IE J/M = J(SLUG-FTFT) X 0.00000085601606
046242,000456: 
046243,000457:                                                                                          	#                 THE CORRESPONDING COMPUTER VARIABLES ESTABLISHED BY
046244,000458:                                                                                          	#                 KEYBOARD ENTRY ARE
046245,000459:                                                                                          	#                       J/M  (ROLL)
046246,000460:                                                                                          	#                       J/M1 (PITCH)
046247,000461:                                                                                          	#                       J/M2 (YAW)
046248,000462: 
046249,000463:                                                                                          	#            T  = JET ON-TIME    SCALED 16384/1600 SEC
046250,000464:                                                                                          	#             J
046251,000465: 
046252,000466:                                                                                          	#                 THE COMPUTER VARIABLES ARE
046253,000467:                                                                                          	#                       TAU  (ROLL)
046254,000468:                                                                                          	#                       TAU1 (PITCH)
046255,000469:                                                                                          	#                       TAU2 (YAW)
046256,000470: 
046257,000471: 21,3727           51506        JTIME              INDEX    SPNDX                         	# PICK UP S/C INERTIA/TORQUE RATIO
046258,000472: 21,3730           31623                           CA       J/M                           	# SCALED (57.3/450)(B24/1600)
046259,000473: 21,3731           02042                           TC       SMALLMP                       	# FOR 1-JET OPERATION
046260,000474: 21,3732           35005                           CA       BIT11                         	#
046261,000475: 21,3733           02042                           TC       SMALLMP                       	#
046262,000476: 21,3734           11510                           CCS      KMPAC                         	#
046263,000477: 21,3735           13741                           TCF      +4                            	#
046264,000478: 21,3736           13745                           TCF      TAUNORM                       	#
046265,000479: 21,3737           13743                           TCF      +4                            	#
046266,000480: 21,3740           13745                           TCF      TAUNORM                       	#
046267,000481: 21,3741           34777                           CA       POSMAX                        	#
046268,000482: 21,3742           13746                           TCF      DOJET                         	#
046269,000483: 21,3743           35001                           CA       NEGMAX                        	#
046270,000484: 21,3744           13746                           TCF      DOJET                         	#
046271,000485: 
046272,000486: 21,3745           31511        TAUNORM            CA       KMPAC      +1                 	#
046273,000487: 21,3746           51506        DOJET              INDEX    SPNDX                         	#
046274,000488: 21,3747           55561                           TS       TAU                           	#
046275,000489: 21,3750           11506                           CCS      SPNDX                         	#
046276,000490: 21,3751           13445                           TCF      JLOOP                         	#
046277,000491: 21,3752           13757                           TCF      T6PROG                        	#
046278,000492: 
046280,000494: 21,3753           35021        ZEROCMDS           CAF      ZERO                          	#
046281,000495: 21,3754           55561                           TS       TAU                           	#
046282,000496: 21,3755           55562                           TS       TAU1                          	#
046283,000497: 21,3756           55563                           TS       TAU2                          	#
046284,000498: 21,3757           00006        T6PROG             EXTEND                                 	# WHEN THE ROTATION COMMANDS (TAUS)
046285,000499: 21,3760           33764                           DCA      JETADDR                       	# HAVE BEEN DETERMINED
046286,000500: 21,3761           53313                           DXCH     T5LOC                         	# RESET T5LOC FOR PHASE3
046287,000501: 21,3762           15333                           TCF      RESUME                        	#
046288,000502: 
046289,000503: 21,3763  E6,1510                                  EBANK=   KMPAC                         	#
046290,000504: 21,3763           02552 36066  JETADDR            2CADR    JETSLECT                      	#
046291,000505: 
(End of include-file AUTOMATIC_MANEUVERS.agc, resuming MAIN.agc)

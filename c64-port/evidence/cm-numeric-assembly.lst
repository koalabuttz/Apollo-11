007629,000158: 
007630,000159: 05,2355           35021                           CA       ZERO                          	# SAME STORY ON ZEROING FAILREG.
007631,000160: 05,2356           55365                           TS       ERCOUNT                       	#
007632,000161: 05,2357           54375                           TS       FAILREG                       	#
007633,000162: 05,2360           54376                           TS       FAILREG    +1                 	#
007634,000163: 05,2361           54377                           TS       FAILREG    +2                 	#
007635,000164: 05,2362           55154                           TS       REDOCTR                       	#
007636,000165: 

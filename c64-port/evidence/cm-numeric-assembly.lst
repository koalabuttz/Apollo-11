048335,001019: 
048337,001021:                                                                                          	# TIMETEST SECTION FOR RCS
048338,001022: 
048339,001023:                                                                                          	# ENTER WITH THREE TIME INTERVALS AND THE CORRESPONDING JET CODE INDEXES IN ERASEABLE LOCS TON1, TOFF, TON2, JNDX
048340,001024:                                                                                          	# JNDX1.  SECTION PROCESSES TIME INTERVALS FOR WTLST CALLS AND ASSURES THAT WTLST CALLS ARE MADE ONLY
048341,001025:                                                                                          	# (1) FOR POS INTERVALS GREATER THAN A SPECIFIED MINIMUM (HERE CHOSEN AS 2 CS) AND
048342,001026:                                                                                          	# (2) FOR THE INTERVALS THAT WILL BE EXECUTED WITHIN THE TIME REMAINING IN THE SAMPLE INTERVAL T (2 SEC).
048343,001027:                                                                                          	# TIMETST ESTABLISHES 6 LOCS CONTAINING JET CODES AND CORRESPONDING TIME INTERVALS.  THUS:  TON1, T1BITS,
048344,001028:                                                                                          	# TOFF, TBITS, TON2, T2BITS.  OF THESE THE FIRST 2 LOCS ARE TEMPORARY, FOR IMMEDIATE ACTION, IN GENERAL.
048345,001029:                                                                                          	# SECTION JETCALL BELOW PROCESSES THIS LIST.
048346,001030: 
048347,001031: 15,3525           30025        TIMETST            CA       TIME1                         	# CORRECT FOR POSSIBLE TIME1 OVFL.
048348,001032: 15,3526           65002                           AD       POS1/2                        	#
048349,001033: 15,3527           65002                           AD       POS1/2                        	# OVFL GUARANTEED.
048350,001034: 15,3530           27712                           ADS      TUSED                         	# B(TUSED) =-TUSED =-OLTIME1
048351,001035: 
048352,001036: 15,3531           33746                           CA       -T-3                          	# =-T +2 -5 (SEE SETJTAG)
048353,001037:                                                                                          	# THE +2 REQUIRED FOR PROPER BRANCH.
048354,001038: 15,3532           27712                           ADS      TUSED                         	# TUSED = TIME(K)-TIME(K-1)-T+2
048355,001039: 
048356,001040: 15,3533           45016                           CS       TWO                           	# USE 2 SINCE TIME3 UNCERTAIN TO 1
048357,001041: 15,3534           61621                           AD       TON1                          	#
048358,001042: 15,3535           00006                           EXTEND                                 	#
048359,001043: 15,3536           63550                           BZMF     TIMETST1                      	#

/* SPDX-License-Identifier: MIT
 * Thin resident Executive and Waitlist: EXECUTIVE.agc and WAITLIST.agc
 * (Luminary099 and Comanche055) translated instruction by instruction onto
 * the canonical erasable image, with no gather/commit view. Included by
 * src/lm_kernel.c and src/cm_kernel.c, which define the mission's labels
 * (K_*, generated by tools/resident_kernel_labels.py), its device record
 * (KIO, K_SUPER, K_IE) and KERNEL_LM or KERNEL_CM.
 *
 * Each basic instruction is one agc_image_ops call (src/agc_image_ops.c),
 * so the registers, the editing and bank registers and every scratch word
 * end as the original leaves them. Control flow is the source's: a CCS
 * outcome, BZF/BZMF, a TC (Q = the word after it) or an indexed jump goes
 * to the C label of its target. Every outcome the source can take is
 * followed; one that lands on data or outside these files (CCSHOLE, the
 * constant words after NO.CORES, COREINC, -CCSPR and DPBIT14, an erasable
 * word) stops there with Z at it, as a transfer to code nothing native
 * implements. Nothing is refused for being out of a domain: a routine
 * returns EXEC_OUT_OF_SCOPE only when an inline operand at Q has no
 * compiled site word or a device record it needs is missing.
 *
 * A routine ends where the certified service routine of the same entry
 * ends (src/lm_exec_*.c, src/cm_exec_*.c), so the two are interchangeable
 * in a program: at the selected job (its DTCB, or NEWOPS after INTRSM), at
 * the caller's return, at BAILOUT/POODOO with the alarm code at Q, at
 * ADVAN when a job switch finds nothing ready (DUMMYJOB itself runs on
 * through ADVAN), at a Waitlist task, at TASKOVER, NOVAC or FIXDELAY from
 * SVCT3, at LONGCYCL or WAITLIST in the LONGCALL chain, or where RESUME
 * ends the interrupt. */
#include "agc_image_ops.h"
/* The C64 flight resident's night watchman, on the work clock (the kernel
 * marks its NEWJOB accesses); no other build has its byte. */
#if defined(__mos__) && RK_FIXED_IMAGE && RK_SEAMS && !defined(RK_RUNS_ONLY) && !defined(RK_WALL_CLOCK)
#include "flight_watchman.h"
#define K_WATCHMAN 1
#else
#define K_WATCHMAN 0
#endif
#define W ks->words
/* Overlay ABI 2 seams follow their job (include/resident_kernel.h): with
 * RK_SEAMS the kernel reports CHANJOB's core-set exchange (NEWJOB names
 * the set exchanged with set 0) and ENDOFJOB's end of the job in set 0.
 * The reports change nothing in the image. */
#if RK_SEAMS
#define SEAMS_EXCHANGE() rk_seams_exchange(W[K_NEWJOB])
#define SEAMS_RELEASE() rk_seams_release()
#else
#define SEAMS_EXCHANGE() ((void)0)
#define SEAMS_RELEASE() ((void)0)
#endif
/* Basic instructions. Erasable operands are as the instruction names them
 * (01400-01777 under EB); f forms take a fixed word by value. */
/* The image every kernel instruction works on (the one canonical image);
 * one-argument wrappers keep each 6502 call site to an address load and a
 * JSR. */
static KIO *kio;
static agc_word *kch11;
#if RK_FIXED_IMAGE
#define ks ((agc_image *)APOLLO_SHARED_ADDRESS)
#else
static agc_image *ks;
#endif
/* With the fixed image (one mission's resident) these are not static: the
 * flight resident exports them as ABI 2 services
 * (docs/overlay-v2-services.json), so flight modules share them. The
 * check programs (RK_RUNS_ONLY) export none of them. */
#if RK_FIXED_IMAGE && !defined(RK_RUNS_ONLY)
#define K_EXPORT
#else
#define K_EXPORT static
#endif
#define K_OP(n,T) K_EXPORT __attribute__((noinline)) void k_##n(T a){ai_##n(ks,a);}
#define K_OPS(n,T) K_EXPORT __attribute__((noinline)) uint8_t k_##n(T a){return ai_##n(ks,a);}
K_OP(ca,unsigned) K_OP(caf,agc_word) K_OP(cs,unsigned) K_OP(csf,agc_word) K_OP(ad,unsigned) K_OP(adf,agc_word)
K_OP(mask,unsigned) K_OP(maskf,agc_word) K_OPS(ts,unsigned) K_OP(xch,unsigned) K_OP(lxch,unsigned)
K_OP(qxch,unsigned) K_OP(ads,unsigned) K_OP(incr,unsigned) K_OP(dxch,unsigned) K_OP(das,unsigned)
K_OPS(ccs,unsigned) K_OP(tc,agc_word) K_OP(dcaf,const agc_word *) K_OP(dcsf,const agc_word *)
static __attribute__((noinline)) enum exec_status k_go(agc_word z){ks->words[5]=z;return EXEC_OK;}
static __attribute__((noinline)) enum exec_status k_resume(void){ks->words[5]=(agc_word)(ks->words[K_ZRUPT]-1u);ks->words[7]=0;return EXEC_OK;}
K_EXPORT __attribute__((noinline)) uint8_t k_bzf(void){return ai_bzf(ks);}
K_EXPORT __attribute__((noinline)) uint8_t k_bzmf(void){return ai_bzmf(ks);}
/* An erasable operand below 0400 (most of them) is passed in one byte. */
#define K_OP8(n) static __attribute__((noinline)) void k_##n##8(uint8_t a){k_##n(a);}
#define K_OPS8(n) static __attribute__((noinline)) uint8_t k_##n##8(uint8_t a){return k_##n(a);}
/* The night watchman (include/flight_watchman.h): the kernel's CCS NEWJOB
 * and TS NEWJOB access NEWJOB, as on the AGC, so they clear its armed bit
 * (in 6502: 27 bytes, the C's 38). */
#if K_WATCHMAN
_Static_assert(K_NEWJOB == 067u && FLIGHT_WATCHMAN_ARMED == 1u, "k_newjob8's NEWJOB and bit");
uint8_t k_ccs8(uint8_t a);
uint8_t k_ts8(uint8_t a);
__asm__(".section .text.k_newjob8,\"ax\",@progbits\n"
        ".globl k_ccs8\n.globl k_ts8\n"
        "k_ccs8:\n  jsr k_newjob8\n  ldx #0\n  jmp k_ccs\n"
        "k_ts8:\n  jsr k_newjob8\n  ldx #0\n  jmp k_ts\n"
        "k_newjob8:\n  cmp #$37\n  bne 1f\n  lsr rk_nw\n  asl rk_nw\n1:\n  rts\n"
        ".text\n");
#define K_OPS8_NEWJOB(n)
#else
#define K_OPS8_NEWJOB(n) K_OPS8(n)
#endif
K_OP8(ca) K_OP8(cs) K_OP8(ad) K_OP8(mask) K_OPS8_NEWJOB(ts) K_OP8(xch) K_OP8(lxch) K_OP8(qxch) K_OP8(ads) K_OP8(dxch) K_OPS8_NEWJOB(ccs)
K_OP8(caf) K_OP8(adf) K_OP8(csf)
#define K_SMALL(n,a) (__builtin_constant_p(a)&&(unsigned)(a)<0400u?k_##n##8((uint8_t)(a)):k_##n(a))
#define CA(a) K_SMALL(ca,a)
#define CAF(k) K_SMALL(caf,k)
#define CS(a) K_SMALL(cs,a)
#define CSF(k) K_SMALL(csf,k)
#define AD(a) K_SMALL(ad,a)
#define ADF(k) K_SMALL(adf,k)
#define MASK(a) K_SMALL(mask,a)
#define MASKF(k) k_maskf(k)
#define TS(a) K_SMALL(ts,a)
#define XCH(a) K_SMALL(xch,a)
#define LXCH(a) K_SMALL(lxch,a)
#define QXCH(a) K_SMALL(qxch,a)
#define ADS(a) K_SMALL(ads,a)
#define INCR(a) k_incr(a)
#define DXCH(k) K_SMALL(dxch,k)
#define DAS(k) k_das(k)
#define CCS(a) K_SMALL(ccs,a)
#define COM() k_cs(0u)
#define TC(r) k_tc((agc_word)(r))
#define BZF() k_bzf()
#define BZMF() k_bzmf()
#define DCAF(w) k_dcaf(w)
#define DCSF(w) k_dcsf(w)
#define ZL() k_lxch(7u)
#define ZQ() k_qxch(7u)
static __attribute__((noinline)) void k_inhint(void){kio->interrupt_enabled=0u;}
static __attribute__((noinline)) void k_relint(void){kio->interrupt_enabled=1u;}
#define INHINT() k_inhint()
#define RELINT() k_relint()
/* Leave at Z (logical, under the current FB). */
#define GO(z) return k_go((agc_word)(z))
#define A_ 0u
#define L_ 1u
#define Q_ 2u
#define FB_ 4u
#define BB_ 6u
#define POS1_2 020000u
#define NEGMAX 040000u
#define FBANKMSK 076000u
#define K2 02000u
#define BANK01 02000u
#if KERNEL_LM
#define NCORES 8u
#else
#define NCORES 7u
#endif

/* INDEX K: the next instruction's address plus C(K), in one's complement
 * (C(K) = -0 indexes by nothing). */
static __attribute__((noinline)) unsigned ix(unsigned base,unsigned k){return agc_add_word((agc_word)base,ai_word(ks,k));}
/* Channel 7 (SUPERBNK) and 11 (DSALMOUT) instructions. */
static __attribute__((noinline)) void ror7(void){ks->words[0]=(agc_register)(ks->words[0]|kio->superbank);}
static __attribute__((noinline)) void write7(void){kio->superbank=(agc_word)(agc_correct(ks->words[0])&0160u);}
static __attribute__((noinline)) void wor11(void){*kch11=(agc_word)((agc_correct(ks->words[0])|*kch11)&AGC_MASK);ks->words[0]=agc_extend(*kch11);}
static __attribute__((noinline)) void wand11(void){*kch11=(agc_word)(agc_correct(ks->words[0])&*kch11&AGC_MASK);ks->words[0]=agc_extend(*kch11);}
/* DTCB (DXCH Z) at `at`: Z,BB <-> A,L. */
static __attribute__((noinline)) enum exec_status dtcb(agc_word at){agc_image *s=ks;agc_word z=agc_correct(W[0]),bb=agc_correct(W[1]);
 W[0]=(agc_word)(at+1u);W[1]=agc_extend(W[6]);W[5]=(agc_word)(z&07777u);ai_put(s,BB_,bb);return EXEC_OK;
}
/* INTRSM (LXCH BBANK; TCF INTPRET +3) to the NEWOPS fetch: the interpreter
 * rebuilds BANKSET, INTBIT15 and EDOP from the new BB and fetches nothing. */
static __attribute__((noinline)) enum exec_status intrsm(void){
 LXCH(BB_);W[K_BANKSET]=W[6];W[K_INTBIT15]=(agc_word)(W[6]&040000u);W[K_EDOP]=0;W[0]=agc_extend(W[K_INTBIT15]);W[5]=K_NEWOPS;return EXEC_OK;
}
/* The word at Q (or erasable) a TC passes inline. */
static agc_word op[2];
static __attribute__((noinline)) int inline_word(const agc_native_program *p,agc_word q,agc_word *w){
 return agc_transfer_operand(p,ks,kio->superbank,q,w);
}

static enum exec_status kernel(const agc_native_program *p,apollo_overlay_state *s,void *v){
 KIO *io=v;agc_hardware *hw;agc_word *ch11,z;uint8_t c,i,idle=0;
 if(!p||!s||!io)return EXEC_OUT_OF_SCOPE;
 hw=p->hardware;
#if KERNEL_LM
 ch11=hw?&hw->channel11:0;
#else
 ch11=&io->channel11;
#endif
#if RK_FIXED_IMAGE
 if(s!=ks)return EXEC_OUT_OF_SCOPE;
#else
 ks=s;
#endif
 kio=io;kch11=ch11;
 z=W[5];op[0]=op[1]=0;
 /* Inline operands first, so a call from an unknown site changes nothing. */
 if(z==K_NOVAC||z==K_FINDVAC||z==K_WAITLIST||z==K_LONGCALL){
  if(!inline_word(p,W[2],&op[0])||!inline_word(p,(agc_word)(W[2]+1u),&op[1]))return EXEC_OUT_OF_SCOPE;
 }else if(z==K_TWIDDLE||z==K_FIXDELAY){
  if(!inline_word(p,W[2],&op[0]))return EXEC_OUT_OF_SCOPE;
 }
 /* The job switches and the idle loop write COMP ACTY in channel 11. */
 if(!ch11&&(z==K_JOBSLEEP||z==K_ENDOFJOB||z==K_PRIOCHNG||(W[4]==BANK01&&z>=K_NUCHANG2&&z<=K_NUDIRECT)))return EXEC_OUT_OF_SCOPE;
 if(!hw&&(z==K_TASKOVER||z==04014u))return EXEC_OUT_OF_SCOPE;
 switch(z){
 case K_NOVAC:goto NOVAC;
 case K_FINDVAC:goto FINDVAC;
 case K_SPVACIN:goto SPVACIN;
 case K_SPVAC:goto SPVAC;
 case K_CHANG1:goto CHANG1;
 case K_CHANG2:goto CHANG2;
 case K_JOBSLEEP:goto JOBSLEEP;
 case K_JOBWAKE:goto JOBWAKE;
 case K_PRIOCHNG:goto PRIOCHNG;
 case K_ENDOFJOB:goto ENDOFJOB;
 case K_SUPDXCHZ:goto SUPDXCHZ;
 case K_SUPDXCHZ+1u:goto SUPDXCHZ1;
 case K_TWIDDLE:goto TWIDDLE;
 case K_DLY2-1u:TS(K_WAITADR);goto DLY2;             /* DELAYJOB's TCF DLY2 -1: TS WAITADR */
 case K_WAITLIST:goto WAITLIST;
 case K_FIXDELAY:goto FIXDELAY;
 case K_VARDELAY:goto VARDELAY;
 case K_TASKOVER:goto TASKOVER;
 case K_LONGCALL:goto LONGCALL;
 case K_SVCT3:goto SVCT3;
 case K_SVCT3+015u:GO(K_TASKOVER);                  /* TCF TASKOVER after NOVAC */
 case K_SVCT3X+2u:TC(K_SVCT3X+3u);goto SVCT3;        /* TC SVCT3 after FIXDELAY */
 case 04014u:                                         /* T3RUPT lead-in */
  DXCH(K_ARUPT);CAF(KW_T3RPTBB);XCH(BB_);goto T3RUPT;
 case K_DUMMYJOB:idle=1;goto DUMMYJOB;
 case K_DUMMYJOB+2u:idle=1;goto DUMMYJOB2;
 case K_ADVAN:idle=1;goto ADVAN;
 case K_NUCHANG2:idle=1;goto NUCHANG2;
 case K_LNGCALL2:goto LNGCALL2;
 case K_LONGCYCL:goto LONGCYCL;
 case K_LONGRTRN:case K_MUCHTIME+4u:goto LONGRTRN;
 case K_GETCADR:goto GETCADR;
 default:return EXEC_OUT_OF_SCOPE;
 }

 /* ---- EXECUTIVE: job admission ---- */
NOVAC:
 INHINT();ADF(KW_FAKEPRET);TS(K_NEWPRIO);DCAF(op);DXCH(K_NEWLOC);
 CAF(KW_EXECBANK);XCH(FB_);TS(K_EXECTEM1);goto NOVAC2;
FINDVAC:
 INHINT();TS(K_NEWPRIO);DCAF(op);
SPVACIN:
 DXCH(K_NEWLOC);CAF(KW_EXECBANK);XCH(FB_);
 /* FINDVAC2: CCS VACnUSE; TCF VACFOUND, five times from FINDVAC2 +1. A
  * CCS outcome c lands c+1 words on: an odd offset is the next CCS, an
  * even one a TCF VACFOUND, and from offset 013 the 1201 bailout. */
 TS(K_EXECTEM1);
 for(i=1;;){
  c=CCS(K_VAC1USE+054u*(i/2u));
  i=(uint8_t)(i+1u+c);
  if(i>=013u)break;
  if(!(i&1u))goto VACFOUND;
 }
#if KERNEL_LM
 /* LXCH EXECTEM1; CA Q; TC BAILOUT1; OCT 1201 */
 if(i==016u){TC(K_FINDVAC2+017u);GO(01201u);}       /* OCT 1201 runs as TC 1201 */
 if(i==013u)LXCH(K_EXECTEM1);
 if(i<=014u)CA(Q_);
 TC(K_FINDVAC2+016u);GO(K_BAILOUT1);
#else
 /* TC BAILOUT; OCT 1201 (run as TC 1201); VACFOUND */
 if(i==013u){TC(K_FINDVAC2+014u);GO(K_BAILOUT);}
 if(i==014u){TC(K_FINDVAC2+015u);GO(01201u);}
#endif
VACFOUND:
 ADF(2u);ZL();LXCH(W[0]-1u);ADS(K_NEWPRIO);
NOVAC2:
 CAF(0u);TS(K_LOCCTR);CAF(KW_NO_CORES);
NOVAC3:
 TS(K_EXECTEM2);
 switch(CCS(ix(K_PRIORITY,K_LOCCTR))){
 case 0:case 2:goto NEXTCORE;
#if KERNEL_LM
 case 1:TC(K_NOVAC3+5u);GO(KW_NO_CORES);             /* DEC 7 runs as TC 7 */
#else
 case 1:goto NEXTCORE;                /* DEC 6 runs as EXTEND: BZF NEXTCORE on A=+0 */
#endif
 default:break;
 }
 /* CORFOUND */
 CA(K_NEWPRIO);TS(ix(K_PRIORITY,K_LOCCTR));MASKF(KW_LOW9);TS(ix(K_PUSHLOC,K_LOCCTR));
 switch(CCS(K_LOCCTR)){
 case 0:goto SETLOC;
 case 1:TS(K_OVFIND);/* fall through */
 case 2:CA(K_PUSHLOC);/* fall through */
 default:TS(K_FIXLOC);
 }
SPECTEST:
 switch(CCS(K_NEWJOB)){
 case 0:goto SETLOC;
 case 1:TC(K_SPECTEST+3u);GO(K_CCSHOLE);
 case 2:TC(K_SPECTEST+4u);GO(K_CCSHOLE);
 default:break;
 }
 TS(K_NEWJOB);DXCH(K_NEWLOC);DXCH(K_LOC);goto ENDFIND;
SETLOC:
 DXCH(K_NEWLOC);DXCH(ix(K_LOC,K_LOCCTR));CS(ix(K_PRIORITY,K_NEWJOB));AD(K_NEWPRIO);
 if(BZMF())goto ENDFIND;
 CA(K_LOCCTR);TS(K_NEWJOB);
ENDFIND:
 /* TCF Q+2: NEG's INDEX Q; TC 2. */
 CA(K_EXECTEM1);TS(FB_);z=(agc_word)(W[2]+2u);TC(K_NEG+2u);GO(z&07777u);
NEXTCORE:
 CAF(KW_COREINC);ADS(K_LOCCTR);
 c=CCS(K_EXECTEM2);
 if(c==0u)goto NOVAC3;
#if KERNEL_LM
 if(c==1u)LXCH(K_EXECTEM1);
 if(c<=2u)CA(Q_);
 TC(K_NEXTCORE+7u);GO(K_BAILOUT1);
#else
 if(c==1u){TC(K_NEXTCORE+5u);GO(K_BAILOUT);}
 if(c==2u){TC(K_NEXTCORE+6u);GO(01202u);}           /* OCT 1202 runs as TC 1202 */
 goto CHANJOB_2;
#endif

 /* ---- EXECUTIVE: job changes ---- */
SPVAC:
 XCH(Q_);ADF(KW_NEG2);XCH(Q_);goto SPVACIN;
CHANG1:
 LXCH(Q_);CAF(KW_EXECBANK);XCH(BB_);goto CHANJOB;
CHANG2:
 CS(K_LOC);TS(L_);CAF(KW_EXECBANK);TS(BB_);goto CHANJOB_1;
CHANJOB_2:
 LXCH(K_LOC);
CHANJOB_1:
 CA(K_BANKSET);
CHANJOB:
 INHINT();ror7();XCH(L_);
CHANJOB4:
 SEAMS_EXCHANGE();
 DXCH(ix(K_LOC,K_NEWJOB));DXCH(K_LOC);CA(K_BANKSET);write7();
 for(i=0;i<8u;i=(uint8_t)(i+2u)){DXCH(K_MPAC+i);DXCH(ix(K_MPAC+i,K_NEWJOB));DXCH(K_MPAC+i);}
 CAF(0u);XCH(K_OVFIND);
 if(!BZF()){CS(K_PUSHLOC);TS(K_PUSHLOC);}
 DXCH(K_PUSHLOC);DXCH(ix(K_PUSHLOC,K_NEWJOB));DXCH(K_PUSHLOC);
 CAF(KW_LOW9);MASK(K_PRIORITY);TS(K_FIXLOC);
 switch(CCS(K_PUSHLOC)){
 case 0:CAF(0u);/* fall through */
 case 1:goto ENDPRCHG_1;
 case 2:CS(K_PUSHLOC);/* fall through */
 default:TS(K_PUSHLOC);CAF(1u);XCH(K_OVFIND);
 }
ENDPRCHG_1:
 TS(K_NEWJOB);
 /* ENDPRCHG */
 RELINT();DXCH(K_LOC);
 if(!BZMF()){return dtcb(K_ENDPRCHG+4u);}
 COM();ADF(1u);TS(K_LOC);return intrsm();
JOBSLEEP:
 TS(K_LOC);CAF(KW_EXECBANK);TS(FB_);
 INHINT();CS(K_PRIORITY);TS(K_PRIORITY);CAF(KW_LOW7);MASK(BB_);ror7();TS(K_BANKSET);CSF(0u);
JOBSLP2:
 TS(K_BUF+1u);
EJSCAN:
 /* CCS PRIORITY +12k; TC EJ1; TC CCSHOLE; TCF +1 for each other core set
  * (the third's +0 word is the constant -CCSPR). */
 for(i=1;i<NCORES;++i){agc_word at=(agc_word)(K_EJSCAN+4u*(i-1u));
  c=CCS(K_PRIORITY+12u*i);
  if(c==1u){if(i==3u)GO(at+2u);TC(at+3u);GO(K_CCSHOLE);}
  if(c!=0u)continue;
  TC(at+2u);
  /* EJ1: TS BUF+2; AD BUF+1; CCS A; CS BUF+2; TCF EJ2; NOOP; INDEX Q; TC 2. */
  TS(K_BUF+2u);AD(K_BUF+1u);c=CCS(A_);
  if(c>=2u){TC(K_EJ1+8u);continue;}
  if(c==0u)CS(K_BUF+2u);
  /* EJ2: TS BUF+1; EXTEND; QXCH BUF; INDEX BUF; TC 2. */
  TS(K_BUF+1u);QXCH(K_BUF);TC(K_EJ2+5u);
 }
 {agc_word at=(agc_word)(K_EJSCAN+4u*(NCORES-1u));
  switch(CCS(K_BUF+1u)){
  case 0:TC(at+2u);GO(K_CCSHOLE);
  case 1:TC(at+3u);GO(K_CCSHOLE);
  case 3:goto DUMMYJOB;
  default:break;
  }
  switch(CCS(K_BUF)){
  case 1:goto ENDPRCHG_1;
  case 3:GO(at+9u);                                   /* unindexed CAF 0 -1 */
  default:break;
  }
  /* INDEX A; CAF 0 -1: the CCS word before the winner's TC EJ1. */
  z=(agc_word)(W[0]-1u-K_EJSCAN);
  if(W[0]<K_EJSCAN+1u||z%4u||z/4u>NCORES-2u)GO(at+8u);
  CAF((agc_word)(010000u|(K_PRIORITY+12u*(z/4u+1u))));ADF(KW_MCCSPR);TS(K_NEWJOB);goto CHANJOB_2;
 }
JOBWAKE:
 INHINT();TS(K_NEWLOC);CSF(2u);ADS(Q_);CAF(KW_EXECBANK);XCH(FB_);
 TS(K_EXECTEM1);CAF(0u);TS(K_LOCCTR);CAF(KW_NO_CORES);
JOBWAKE4:
 TS(K_EXECTEM2);
 switch(CCS(ix(K_PRIORITY,K_LOCCTR))){
 case 0:goto JOBWAKE3;
 case 1:TC(K_JOBWAKE4+5u);GO(KW_COREINC);            /* DEC 12 runs as TC 14 */
 case 2:break;
 default:goto JOBWAKE3;
 }
 /* WAKETEST */
 CS(K_NEWLOC);AD(ix(K_LOC,K_LOCCTR));
 if(!BZF())goto JOBWAKE3;
 CS(ix(K_PRIORITY,K_LOCCTR));TS(K_NEWPRIO);TS(ix(K_PRIORITY,K_LOCCTR));
 CSF(FBANKMSK);MASK(K_NEWLOC);ADF(K2);XCH(K_NEWLOC);MASKF(FBANKMSK);AD(ix(K_BANKSET,K_LOCCTR));TS(K_NEWLOC+1u);
 switch(CCS(K_LOCCTR)){
 case 0:goto SETLOC;
 case 1:goto SPECTEST;
 case 2:goto PRIOCH2;
 default:goto PRIOCH2_1;
 }
JOBWAKE3:
 CAF(KW_COREINC);ADS(K_LOCCTR);
 switch(CCS(K_EXECTEM2)){
 case 0:goto JOBWAKE4;
 case 1:CSF(1u);/* fall through */
 case 2:TS(K_LOCCTR);/* fall through */
 default:goto ENDFIND;
 }
PRIOCHNG:
 INHINT();TS(K_NEWPRIO);CAF(KW_EXECBANK);XCH(BB_);TS(K_BANKSET);CA(Q_);
PRIOCH2:
 TS(K_LOC);
PRIOCH2_1:
 CAF(0u);TS(K_BUF);CAF(KW_LOW9);MASK(K_PRIORITY);AD(K_NEWPRIO);TS(K_PRIORITY);COM();goto JOBSLP2;
ENDOFJOB:
 SEAMS_RELEASE();
 CAF(KW_EXECBANK);TS(FB_);
 INHINT();CSF(0u);TS(K_BUF+1u);XCH(K_PRIORITY);MASKF(KW_LOW9);TS(L_);CSF(KW_FAKEPRET);AD(L_);
 if(BZMF())goto EJSCAN;
 switch(CCS(L_)){
 case 0:TS(W[0]);goto EJSCAN;                          /* INDEX A; TS 0 */
 case 1:TS(A_);goto EJSCAN;
 case 2:goto EJSCAN;
 default:GO(K_EJSCAN+1u);
 }

 /* ---- EXECUTIVE: the idle loop ---- */
DUMMYJOB:
 CSF(0u);TS(K_NEWJOB);
DUMMYJOB2:
 RELINT();CSF(2u);wand11();
 if(!idle)GO(K_ADVAN);
ADVAN:
 switch(CCS(K_NEWJOB)){
 case 0:goto NUCHANG2;
 case 1:CAF(2u);/* fall through */
 case 2:goto NUDIRECT;
 default:CA(K_SELFRET);TS(L_);CAF(KW_SELFBANK);goto SUPDXCHZ1;
 }
NUDIRECT:
 wor11();DXCH(K_LOC);
SUPDXCHZ:
 XCH(L_);
SUPDXCHZ1:
 write7();TS(BB_);
 /* TC L: L's word runs as an instruction (TC target, Q = 2). */
 TC(K_SUPDXCHZ+5u);z=agc_correct(W[1]);
 if(z&070000u)GO(1u);
 TC(2u);GO(z);
NUCHANG2:
 INHINT();
 switch(CCS(K_NEWJOB)){
 case 1:RELINT();/* fall through */
 case 2:CAF(2u);goto NUDIRECT;
 default:CAF(2u);wor11();DXCH(K_LOC);goto CHANJOB4;
 }

 /* ---- WAITLIST ---- */
TWIDDLE:
 INHINT();TS(L_);CAF(KW_POSMAX);ADS(Q_);CA(BB_);ror7();XCH(L_);
WAITLIST:
 INHINT();
#if KERNEL_CM
 if(BZMF()){TC(K_WATLST0M+1u);GO(K_POODOO);}
#endif
 XCH(Q_);
 /* TWIDDLE's overflow skips the EXTEND: INDEX WAITEXIT; CA 1. */
 if(TS(K_WAITEXIT))CAF(op[0]);
 else DCAF(op);
 TS(K_WAITADR);
DLY2:
 CAF(KW_WAITBB);XCH(BB_);
 /* WAIT2 */
 TS(K_WAITBANK);
#if KERNEL_LM
 CA(Q_);
 if(BZMF()){DXCH(K_WAITEXIT);TC(K_WAITPOOH+2u);GO(K_POODOO1);}
#endif
 CS(K_TIME3);ADF(KW_BIT8);
 switch(CCS(A_)){
 case 0:ADF(KW_OCT40001);/* fall through */
 case 1:CS(A_);/* fall through */
 case 2:ADF(KW_OCT40201);/* fall through */
 default:AD(Q_);
 }
 switch(CCS(A_)){
 case 0:AD(K_LST1);/* fall through */
 case 1:goto WTLST5;
 default:break;
 }
 CS(Q_);ADF(POS1_2);ADF(POS1_2);XCH(K_TIME3);ADF(NEGMAX);AD(Q_);ZQ();goto WTLST4;
WTLST5:
 /* CCS A; AD LST1 +k; TCF +4; AD ONE; TC WTLST2; OCT k, for k = 1-7. */
 for(i=1;i<8u;++i){
  c=CCS(A_);
  if(c==0u)AD(K_LST1+i);
  if(c<2u)continue;
  if(c==2u)ADF(1u);
  TC((agc_word)(K_WTLST5+6u*i-1u));
  goto WTLST2;
 }
 /* CCS A; WTABORT ...; AD ONE; TC WTLST2; OCT 10. */
 c=CCS(A_);
 if(c==0u)goto WTABORT;
#if KERNEL_CM
 if(c==1u){TC(K_WTABORT+2u);GO(01203u);}               /* OCT 1203: TC 1203 */
#endif
 if(c<=2u)ADF(1u);
 TC(K_WTABORT+4u);i=8u;
WTLST2:
 /* CAF 0 at Q: the OCT k after the TC (k = i). A positive overflow in
  * TS WAITTEMP skips the INDEX Q, so CAF 0 reads A, the +1 the TS left:
  * the new task goes in first (A is a CCS magnitude, never negative). */
 if(!TS(K_WAITTEMP))k_caf8(i);
 TS(Q_);
 CAF(1u);AD(K_WAITTEMP);ADS(K_LST1-1u+W[2]);CS(K_WAITTEMP);
WTLST4:
 /* INDEX Q; TCF WTLST4 (or Q = 0): XCH LST1 +Q...+7, CA WAITADR,
  * INDEX Q; TCF +1: DXCH LST2 +2Q...+16. */
 for(i=(uint8_t)W[2];i<8u;++i)XCH(K_LST1+i);
 CA(K_WAITADR);
 for(i=(uint8_t)W[2];i<9u;++i)DXCH(K_LST2+2u*i);
 {static const agc_word endtask[2]=KW_ENDTASK;ADF(endtask[0]);}
 if(BZF()){DXCH(K_WAITEXIT);ADF(2u);return dtcb(K_LVWTLIST+2u);}
WTABORT:
#if KERNEL_LM
 TC(K_WTABORT+1u);DXCH(K_WAITEXIT);TC(K_FILLED+2u);GO(K_BAILOUT1);
#else
 TC(K_WTABORT+1u);GO(K_BAILOUT);
#endif
FIXDELAY:
 CAF(op[0]);INCR(Q_);
VARDELAY:
 XCH(Q_);TS(K_WAITADR);CA(BB_);ror7();TS(L_);CAF(KW_DELAYEX);TS(K_WAITEXIT);goto DLY2;
SVCT3:
 c=CCS(K_FLAGWRD2);
 if(c<2u)GO(K_TASKOVER);
 c=CCS(K_IMUCADR);
 if(c!=1u){TC(K_SVCT3X+1u);GO(K_FIXDELAY);}
 CAF(KW_PRIO35);TC(K_SVCT3+013u);GO(K_NOVAC);

 /* ---- WAITLIST: T3RUPT and TASKOVER ---- */
T3RUPT:
 ror7();TS(K_BANKRUPT);QXCH(K_QRUPT);
T3RUPT2:
 CAF(KW_NEG1_2);
 for(i=8u;i>0u;--i)XCH(K_LST1+i-1u);
 ADF(KW_POSMAX);ADS(K_TIME3);
 /* TS RUPTAGN; CS ZERO; TS RUPTAGN: overflow skips the CS ZERO. */
 if(!TS(K_RUPTAGN))CSF(0u);
 TS(K_RUPTAGN);
 {static const agc_word endtask[2]=KW_ENDTASK;DCSF(endtask);}
 for(i=9u;i>0u;--i)DXCH(K_LST2+2u*(i-1u));
 XCH(L_);write7();XCH(L_);W[7]=0;return dtcb(K_T3RUPT2+035u);
TASKOVER:
 switch(CCS(K_RUPTAGN)){
 case 0:CAF(KW_WAITBB);/* fall through */
 case 1:TS(BB_);/* fall through */
 case 2:if(W[4]!=BANK01)GO(K_T3RUPT2);goto T3RUPT2;
 default:break;
 }
 CA(K_BANKRUPT);write7();QXCH(K_QRUPT);CA(K_BANKRUPT);XCH(BB_);DXCH(K_ARUPT);RELINT();
 /* RESUME: the instruction saved in BRUPT runs next, at ZRUPT -1. */
 hw->in_interrupt=0;return k_resume();

 /* ---- WAITLIST: LONGCALL ---- */
LONGCALL:
 DXCH(K_LONGTIME);DCAF(op);DXCH(K_LONGCADR);
 {static const agc_word lgcl2cdr[2]=KW_LGCL2CDR;DCAF(lgcl2cdr);}
 return dtcb(K_LONGCALL+7u);
LNGCALL2:
 LXCH(K_LONGEXIT+1u);CAF(2u);ADS(Q_);TS(K_LONGEXIT);
#if KERNEL_LM
 CA(K_LONGTIME);
 switch(CCS(A_)){
 case 0:GO(K_LONGCYCL);
 case 2:goto LONGPOOH;
 default:break;
 }
 CA(K_LONGTIME+1u);
 if(!BZMF())GO(K_LONGCYCL);
LONGPOOH:
 DXCH(K_LONGEXIT);TC(K_LONGPOOH+4u);GO(K_POODOO1);
#else
 GO(K_LONGCYCL);
#endif
LONGCYCL:
 {static const agc_word dpbit14[2]=KW_DPBIT14;DCSF(dpbit14);}
 DAS(K_LONGTIME);
 if(CCS(K_LONGTIME+1u)!=0u){
  switch(CCS(K_LONGTIME)){
  case 0:break;
  case 1:GO(K_DPBIT14);                               /* OCT 00000 */
  case 2:GO(K_DPBIT14+1u);                            /* OCT 20000 */
  default:CAF(KW_BIT14);ADS(K_LONGTIME+1u);TC(K_LASTTIME+3u);GO(K_WAITLIST);
  }
 }
 CAF(KW_BIT14);TC(K_MUCHTIME+2u);GO(K_WAITLIST);
LONGRTRN:
 CAF(KW_TSKOVCDR);DXCH(K_LONGEXIT);return dtcb(K_LONGRTRN+2u);
GETCADR:
 DXCH(K_LONGCADR);return dtcb(K_GETCADR+1u);
}
